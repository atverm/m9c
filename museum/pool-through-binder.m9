(* EXPECT-ERROR: is bound from the value parameter root *)
(* Observed 2026-10-04 building exported variables, understood
   2026-10-10.  The checker's CheckFile took the file's root BY VALUE,
   bound u to each unit (`IF root.kids[i] IS SOME u'), and handed u to
   a walk taking `VAR n: PTR Node', which rewrote a name with
   `NEW (n, CHAR, ...)' -- in n's pool, the hidden one a VAR pointer
   brings.  A binder's pool is its origin's, and the origin was a value
   parameter's component, whose pool nobody named: the generator fell
   back to the calling frame, the name was freed when CheckFile
   returned, and the compiler read `unknown name: const voi' where a
   name had been.  The checker refused a value parameter's component
   as such a root, but not a binder on one.  It does now; the walk's
   holder takes the root VAR, so the pool comes with it. *)
MODULE PoolThroughBinder ;

TYPE
  Kid = OPT PTR Node ;
  Node = RECORD name : STR ; kids : SLICE OF Kid END ;

PROCEDURE Rename (VAR n: PTR Node) =
VAR s : SLICE OF CHAR ;
BEGIN
  s := NEW (n, CHAR, 3) ;
  s[0] := 'a' ; s[1] := '.' ; s[2] := 'b' ;
  n.name := s
END Rename ;

PROCEDURE CheckFile (root: PTR Node) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (root.kids) - 1 DO
    IF root.kids[i] IS SOME u THEN Rename (u) END
  END
END CheckFile ;

BEGIN
END PoolThroughBinder.
