MODULE RealPastF64 ;
(* a real literal may not round to infinity as an F64: held exactly at
   2^1024 - 2^970, which rounds to infinity, one below it to the largest
   double; 1.0e400 became an infinity in C (2026-10-21, the compiler
   review's F1) *)
VAR f : F64 ;
BEGIN
  f := 1.7976931348623158e308 ;
  f := .0 ;
  f := .0
END RealPastF64.
