(* A hole is one expression.  Two values take two holes.  A hole
   that is not closed before the literal ends is refused where the
   literal opens. *)
MODULE m ;
PROCEDURE Fine (a, b: I64) : STR =
BEGIN
  RETURN $'${a} ${b} ${a + b}'
END Fine ;
PROCEDURE Bad (a, b: I64) : STR =
BEGIN
  RETURN $'${a, b}'
END Bad ;
PROCEDURE Open (a: I64) : STR =
BEGIN
  RETURN $'${a'
END Open ;
BEGIN
END m.
