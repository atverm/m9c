DEFINITION MODULE Hash ;

(* SHA-256, fed in pieces; HMAC-SHA-256; PBKDF2-HMAC-SHA256; and a
   comparison that takes the same time whatever differs
   (docs/library-plan-2.md, item 1).

   THE BLOCK FUNCTION IS OPENSSL'S since 2026-10-11 (runtime/
   sha256shim.c; a portable C loop on Windows, where m9c links no
   OpenSSL).  It was written in M9 until then, every rotation and mask a
   call into Bits, and ran at 140 MB/s where OpenSSL ran at 1,984 (the
   M4) -- cp-kernel measured the cost, and the ICOS work hashes whole
   data objects.  What the M9 version was for stays: a 40 MB response
   is hashed as it streams, in pieces, never whole in memory; HMAC and
   PBKDF2 are built on it here.

   Sha256 is a value: a record the caller holds, Init'ed, Update'd with
   any number of slices, and Final'ed once -- a copy of it before Final
   is a fork of the stream, which is how PBKDF2 keeps its keyed states
   (OpenSSL's SHA256_CTX is a plain struct, so a copy is a fork there
   too; EVP's context would not be).  Every digest is answered as fresh
   octets in the caller's frame.  Held to Python's hashlib by HashTest:
   the FIPS vectors, random lengths across every block boundary, a
   million a's, a 64 KB message fed in pieces of every size from 1 to
   200, RFC 4231's HMAC cases and the PBKDF2 vectors.                *)

IMPORT Faults ;

TYPE
  Sha256 = RECORD
    st : ARRAY 16 OF I64 ;     (* the C state, 128 octets, 8-aligned:
                                  OpenSSL's SHA256_CTX; opaque here *)
  END ;

  Hmac = RECORD
    inner, outer : Sha256 ;    (* after the padded key: the stream goes
                                  through inner, its digest through outer *)
  END ;

CONST
  DigestLen = 32 ;
  BlockLen = 64 ;

PROCEDURE Init (VAR h: Sha256) ;
PROCEDURE Update (VAR h: Sha256 ; RO b: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE Final (VAR h: Sha256) : SLICE OF BYTE RAISES ValueRange ;
  (* the 32-octet digest of everything Update was given; h is spent *)

PROCEDURE Sha256Of (RO b: SLICE OF BYTE) : SLICE OF BYTE RAISES ValueRange ;
  (* the digest of b in one call *)

PROCEDURE Hex (RO digest: SLICE OF BYTE) : STR RAISES ValueRange ;
  (* the octets as lower-case hex, two characters each: hashlib's
     hexdigest *)

PROCEDURE HmacInit (VAR m: Hmac ; RO key: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE HmacUpdate (VAR m: Hmac ; RO b: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE HmacFinal (VAR m: Hmac) : SLICE OF BYTE RAISES ValueRange ;
  (* RFC 2104 over SHA-256: a key longer than a block is hashed first *)

PROCEDURE HmacOf (RO key: SLICE OF BYTE ; RO b: SLICE OF BYTE) : SLICE OF BYTE
  RAISES ValueRange ;

PROCEDURE Pbkdf2 (RO password: SLICE OF BYTE ; RO salt: SLICE OF BYTE ;
                  iterations: I64 ; length: I64) : SLICE OF BYTE
  RAISES ValueRange, Faults.BadArg ;
  (* RFC 8018's PBKDF2 with HMAC-SHA-256: length octets of key material
     (hashlib.pbkdf2_hmac ('sha256', ...)); iterations and length below
     1 are BadArg.  A stored password is a salt and this with 600,000
     iterations, compared with Equal.  Measured in HashTest *)

PROCEDURE Equal (RO a: SLICE OF BYTE ; RO b: SLICE OF BYTE) : BOOL ;
  (* a = b, reading EVERY octet whatever the first difference, so the
     time says nothing about where two digests or tokens differ; two
     lengths that differ are unequal at once (a length is no secret) *)

END Hash.

UNSAFE IMPLEMENTATION MODULE Hash ;

(* UNSAFE for ADR: the state and the octets go to the C unit by
   address *)

IMPORT Bits ;
IMPORT Faults ;
FROM csha IMPORT CInit, CUpdate, CFinal ;

PROCEDURE Init (VAR h: Sha256) =
BEGIN
  CInit (ADR (h.st))
END Init ;

PROCEDURE Update (VAR h: Sha256 ; RO b: SLICE OF BYTE) RAISES ValueRange =
BEGIN
  IF LEN (b) > 0 THEN CUpdate (ADR (h.st), ADR (b), C.SSizeT (LEN (b))) END
END Update ;

PROCEDURE Final (VAR h: Sha256) : SLICE OF BYTE RAISES ValueRange =
VAR d : SLICE OF BYTE ;
BEGIN
  d := NEW (BYTE, DigestLen) ;
  CFinal (ADR (h.st), ADR (d)) ;
  RETURN d
END Final ;

PROCEDURE Sha256Of (RO b: SLICE OF BYTE) : SLICE OF BYTE RAISES ValueRange =
VAR h : Sha256 ;
BEGIN
  Init (h) ;
  Update (h, b) ;
  RETURN Final (h)
END Sha256Of ;

PROCEDURE Hex (RO digest: SLICE OF BYTE) : STR RAISES ValueRange =
VAR
  s, digits : STR ;
  i, v : I64 ;
BEGIN
  digits := '0123456789abcdef' ;
  s := NEW (CHAR, 2 * LEN (digest)) ;
  FOR i := 0 TO LEN (digest) - 1 DO
    v := I64 (digest[i]) ;
    s[2 * i] := digits[v DIV 16] ;
    s[2 * i + 1] := digits[v MOD 16]
  END ;
  RETURN s
END Hex ;

PROCEDURE HmacInit (VAR m: Hmac ; RO key: SLICE OF BYTE) RAISES ValueRange =
VAR
  k, pad : ARRAY 64 OF BYTE ;
  kd : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  FOR i := 0 TO BlockLen - 1 DO k[i] := 0 END ;
  IF LEN (key) > BlockLen THEN
    kd := Sha256Of (key) ;
    n := DigestLen ;
    FOR i := 0 TO n - 1 DO k[i] := kd[i] END
  ELSE
    FOR i := 0 TO LEN (key) - 1 DO k[i] := key[i] END
  END ;
  Init (m.inner) ;
  FOR i := 0 TO BlockLen - 1 DO pad[i] := BYTE (Bits.Xor (I64 (k[i]), 0x36)) END ;
  Update (m.inner, pad) ;
  Init (m.outer) ;
  FOR i := 0 TO BlockLen - 1 DO pad[i] := BYTE (Bits.Xor (I64 (k[i]), 0x5c)) END ;
  Update (m.outer, pad)
END HmacInit ;

PROCEDURE HmacUpdate (VAR m: Hmac ; RO b: SLICE OF BYTE) RAISES ValueRange =
BEGIN
  Update (m.inner, b)
END HmacUpdate ;

PROCEDURE HmacFinal (VAR m: Hmac) : SLICE OF BYTE RAISES ValueRange =
VAR d : SLICE OF BYTE ;
BEGIN
  d := Final (m.inner) ;
  Update (m.outer, d) ;
  RETURN Final (m.outer)
END HmacFinal ;

PROCEDURE HmacOf (RO key: SLICE OF BYTE ; RO b: SLICE OF BYTE) : SLICE OF BYTE
  RAISES ValueRange =
VAR m : Hmac ;
BEGIN
  HmacInit (m, key) ;
  HmacUpdate (m, b) ;
  RETURN HmacFinal (m)
END HmacOf ;

PROCEDURE Pbkdf2 (RO password: SLICE OF BYTE ; RO salt: SLICE OF BYTE ;
                  iterations: I64 ; length: I64) : SLICE OF BYTE
  RAISES ValueRange, Faults.BadArg =
  (* the keyed states are made once and COPIED for each HMAC: a record
     assignment, which is what makes 600,000 iterations two
     compressions each and not four *)
VAR
  tmpl, m : Hmac ;
  out, u, t : SLICE OF BYTE ;
  ctr : ARRAY 4 OF BYTE ;
  block, i, j, have, take : I64 ;
BEGIN
  IF iterations < 1 THEN RAISE Faults.BadArg ('Pbkdf2: iterations below 1') END ;
  IF length < 1 THEN RAISE Faults.BadArg ('Pbkdf2: length below 1') END ;
  HmacInit (tmpl, password) ;
  out := NEW (BYTE, length) ;
  t := NEW (BYTE, DigestLen) ;
  have := 0 ;
  block := 1 ;
  WHILE have < length DO
    ctr[0] := BYTE (Bits.And (Bits.Shr (block, 24), 0xFF)) ;
    ctr[1] := BYTE (Bits.And (Bits.Shr (block, 16), 0xFF)) ;
    ctr[2] := BYTE (Bits.And (Bits.Shr (block, 8), 0xFF)) ;
    ctr[3] := BYTE (Bits.And (block, 0xFF)) ;
    m := tmpl ;
    HmacUpdate (m, salt) ;
    HmacUpdate (m, ctr) ;
    u := HmacFinal (m) ;
    FOR j := 0 TO DigestLen - 1 DO t[j] := u[j] END ;
    FOR i := 2 TO iterations DO
      m := tmpl ;
      HmacUpdate (m, u) ;
      u := HmacFinal (m) ;
      FOR j := 0 TO DigestLen - 1 DO t[j] := BYTE (Bits.Xor (I64 (t[j]), I64 (u[j]))) END
    END ;
    take := length - have ;
    IF take > DigestLen THEN take := DigestLen END ;
    FOR j := 0 TO take - 1 DO out[have + j] := t[j] END ;
    have := have + take ;
    block := block + 1
  END ;
  RETURN out
END Pbkdf2 ;

PROCEDURE Equal (RO a: SLICE OF BYTE ; RO b: SLICE OF BYTE) : BOOL =
VAR diff, i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  diff := 0 ;
  FOR i := 0 TO LEN (a) - 1 DO
    diff := Bits.Or (diff, Bits.Xor (I64 (a[i]), I64 (b[i])))
  END ;
  RETURN diff = 0
END Equal ;

END Hash.


UNSAFE DEFINITION MODULE FOR "C" csha LINK "sha256shim.c" ;

(* runtime/sha256shim.c: SHA256_CTX through OpenSSL, a portable loop
   on Windows.  REENTRANT: every state is the caller's. *)

PROCEDURE CInit = "m9_sha256_init" (st: C.MutPtr) [REENTRANT] ;
PROCEDURE CUpdate = "m9_sha256_update" (st: C.MutPtr ; p: C.ConstPtr ; n: C.SSizeT)
  [REENTRANT] ;
PROCEDURE CFinal = "m9_sha256_final" (st: C.MutPtr ; out: C.MutPtr) [REENTRANT] ;

END csha.
