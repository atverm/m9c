DEFINITION MODULE Hash ;

(* SHA-256, fed in pieces; HMAC-SHA-256; PBKDF2-HMAC-SHA256; and a
   comparison that takes the same time whatever differs
   (docs/library-plan-2.md, item 1).

   WRITTEN IN M9, bit for bit FIPS 180-4, so that a 40 MB response
   streaming through HttpServer or a file the zip writer adds is hashed
   as it passes and never whole in memory -- the runtime's
   `m9_sha256_hex' is a one-shot over a buffer -- and so that it runs
   wherever M9 does.  The words are 32-bit patterns held in I64 and
   masked after every sum; the rotations are Bits.  Held to Python's
   hashlib by HashTest: the FIPS vectors, random lengths across every
   block boundary, a million a's, a 64 KB message fed in pieces of
   every size from 1 to 200 (the digest must not depend on the
   pieces), RFC 4231's HMAC cases and the PBKDF2 vectors.

   Sha256 is a value: a record the caller holds, Init'ed, Update'd
   with any number of slices, and Final'ed once -- a copy of it before
   Final is a fork of the stream, which is how PBKDF2 keeps its keyed
   states.  Every digest is answered as fresh octets in the caller's
   frame.                                                              *)

IMPORT Faults ;

TYPE
  Sha256 = RECORD
    h : ARRAY 8 OF I64 ;       (* the eight 32-bit words of the state *)
    buf : ARRAY 64 OF BYTE ;   (* the block being filled *)
    n : I64 ;                  (* octets in buf, 0 .. 63 *)
    total : I64 ;              (* octets fed so far *)
  END ;

  Hmac = RECORD
    inner, outer : Sha256 ;    (* after the padded key: the stream goes
                                  through inner, its digest through outer *)
  END ;

CONST
  DigestLen = 32 ;
  BlockLen = 64 ;

PROCEDURE Init (VAR h: Sha256) ;
PROCEDURE Update (VAR h: Sha256 ; RO b: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE Final (VAR h: Sha256) : SLICE OF BYTE RAISES ValueRange ;
  (* the 32-octet digest of everything Update was given; h is spent *)

PROCEDURE Sha256Of (RO b: SLICE OF BYTE) : SLICE OF BYTE RAISES ValueRange ;
  (* the digest of b in one call *)

PROCEDURE Hex (RO digest: SLICE OF BYTE) : STR RAISES ValueRange ;
  (* the octets as lower-case hex, two characters each: hashlib's
     hexdigest *)

PROCEDURE HmacInit (VAR m: Hmac ; RO key: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE HmacUpdate (VAR m: Hmac ; RO b: SLICE OF BYTE) RAISES ValueRange ;
PROCEDURE HmacFinal (VAR m: Hmac) : SLICE OF BYTE RAISES ValueRange ;
  (* RFC 2104 over SHA-256: a key longer than a block is hashed first *)

PROCEDURE HmacOf (RO key: SLICE OF BYTE ; RO b: SLICE OF BYTE) : SLICE OF BYTE
  RAISES ValueRange ;

PROCEDURE Pbkdf2 (RO password: SLICE OF BYTE ; RO salt: SLICE OF BYTE ;
                  iterations: I64 ; length: I64) : SLICE OF BYTE
  RAISES ValueRange, Faults.BadArg ;
  (* RFC 8018's PBKDF2 with HMAC-SHA-256: length octets of key material
     (hashlib.pbkdf2_hmac ('sha256', ...)); iterations and length below
     1 are BadArg.  A stored password is a salt and this with 600,000
     iterations, compared with Equal.  Measured in HashTest *)

PROCEDURE Equal (RO a: SLICE OF BYTE ; RO b: SLICE OF BYTE) : BOOL ;
  (* a = b, reading EVERY octet whatever the first difference, so the
     time says nothing about where two digests or tokens differ; two
     lengths that differ are unequal at once (a length is no secret) *)

END Hash.

IMPLEMENTATION MODULE Hash ;

IMPORT Bits ;
IMPORT Faults ;

CONST
  Mask32 = 0xFFFFFFFF ;

  (* FIPS 180-4 par 4.2.2: the first 32 bits of the fractional parts
     of the cube roots of the first 64 primes *)
  K = [ 0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2 ] ;

  (* the square roots of the first 8 primes, the same way *)
  H0 = [ 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 ] ;

PROCEDURE Rotr (x: I64 ; n: I64) : I64 RAISES ValueRange =
  (* x, a 32-bit pattern, rotated right by n *)
BEGIN
  RETURN Bits.Or (Bits.Shr (x, n), Bits.And (Bits.Shl (x, 32 - n), Mask32))
END Rotr ;

PROCEDURE Compress (VAR h: Sha256 ; RO blk: SLICE OF BYTE ; at: I64)
  RAISES ValueRange =
  (* one 64-octet block at blk[at ..] into the state *)
VAR
  w : ARRAY 64 OF I64 ;
  a, b, c, d, e, f, g, hh, s0, s1, t1, t2, ch, maj, i : I64 ;
BEGIN
  FOR i := 0 TO 15 DO
    w[i] := Bits.Or (Bits.Or (Bits.Shl (I64 (blk[at + 4 * i]), 24),
                              Bits.Shl (I64 (blk[at + 4 * i + 1]), 16)),
                     Bits.Or (Bits.Shl (I64 (blk[at + 4 * i + 2]), 8),
                              I64 (blk[at + 4 * i + 3])))
  END ;
  FOR i := 16 TO 63 DO
    s0 := Bits.Xor (Bits.Xor (Rotr (w[i - 15], 7), Rotr (w[i - 15], 18)), Bits.Shr (w[i - 15], 3)) ;
    s1 := Bits.Xor (Bits.Xor (Rotr (w[i - 2], 17), Rotr (w[i - 2], 19)), Bits.Shr (w[i - 2], 10)) ;
    w[i] := Bits.And (w[i - 16] + s0 + w[i - 7] + s1, Mask32)
  END ;
  a := h.h[0] ; b := h.h[1] ; c := h.h[2] ; d := h.h[3] ;
  e := h.h[4] ; f := h.h[5] ; g := h.h[6] ; hh := h.h[7] ;
  FOR i := 0 TO 63 DO
    s1 := Bits.Xor (Bits.Xor (Rotr (e, 6), Rotr (e, 11)), Rotr (e, 25)) ;
    ch := Bits.Xor (Bits.And (e, f), Bits.And (Bits.And (Bits.Not (e), Mask32), g)) ;
    t1 := Bits.And (hh + s1 + ch + K[i] + w[i], Mask32) ;
    s0 := Bits.Xor (Bits.Xor (Rotr (a, 2), Rotr (a, 13)), Rotr (a, 22)) ;
    maj := Bits.Xor (Bits.Xor (Bits.And (a, b), Bits.And (a, c)), Bits.And (b, c)) ;
    t2 := Bits.And (s0 + maj, Mask32) ;
    hh := g ; g := f ; f := e ;
    e := Bits.And (d + t1, Mask32) ;
    d := c ; c := b ; b := a ;
    a := Bits.And (t1 + t2, Mask32)
  END ;
  h.h[0] := Bits.And (h.h[0] + a, Mask32) ;
  h.h[1] := Bits.And (h.h[1] + b, Mask32) ;
  h.h[2] := Bits.And (h.h[2] + c, Mask32) ;
  h.h[3] := Bits.And (h.h[3] + d, Mask32) ;
  h.h[4] := Bits.And (h.h[4] + e, Mask32) ;
  h.h[5] := Bits.And (h.h[5] + f, Mask32) ;
  h.h[6] := Bits.And (h.h[6] + g, Mask32) ;
  h.h[7] := Bits.And (h.h[7] + hh, Mask32)
END Compress ;

PROCEDURE Init (VAR h: Sha256) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO 7 DO h.h[i] := H0[i] END ;
  h.n := 0 ;
  h.total := 0
END Init ;

PROCEDURE Update (VAR h: Sha256 ; RO b: SLICE OF BYTE) RAISES ValueRange =
VAR i, k : I64 ;
BEGIN
  i := 0 ;
  h.total := h.total + LEN (b) ;
  (* a part block in hand is completed first *)
  IF h.n > 0 THEN
    WHILE i < LEN (b) AND h.n < BlockLen DO
      h.buf[h.n] := b[i] ;
      h.n := h.n + 1 ;
      i := i + 1
    END ;
    IF h.n = BlockLen THEN
      Compress (h, h.buf, 0) ;
      h.n := 0
    END
  END ;
  (* whole blocks straight from b *)
  WHILE i + BlockLen <= LEN (b) DO
    Compress (h, b, i) ;
    i := i + BlockLen
  END ;
  (* the rest waits *)
  k := 0 ;
  WHILE i < LEN (b) DO
    h.buf[h.n + k] := b[i] ;
    k := k + 1 ;
    i := i + 1
  END ;
  h.n := h.n + k
END Update ;

PROCEDURE Final (VAR h: Sha256) : SLICE OF BYTE RAISES ValueRange =
VAR
  d : SLICE OF BYTE ;
  bits, i : I64 ;
BEGIN
  bits := h.total * 8 ;
  (* 0x80, zeros to 56 mod 64, the bit length big-endian *)
  h.buf[h.n] := 0x80 ;
  h.n := h.n + 1 ;
  IF h.n > 56 THEN
    WHILE h.n < BlockLen DO h.buf[h.n] := 0 ; h.n := h.n + 1 END ;
    Compress (h, h.buf, 0) ;
    h.n := 0
  END ;
  WHILE h.n < 56 DO h.buf[h.n] := 0 ; h.n := h.n + 1 END ;
  FOR i := 0 TO 7 DO
    h.buf[56 + i] := BYTE (Bits.And (Bits.Shr (bits, 8 * (7 - i)), 0xFF))
  END ;
  Compress (h, h.buf, 0) ;
  d := NEW (BYTE, DigestLen) ;
  FOR i := 0 TO 7 DO
    d[4 * i] := BYTE (Bits.And (Bits.Shr (h.h[i], 24), 0xFF)) ;
    d[4 * i + 1] := BYTE (Bits.And (Bits.Shr (h.h[i], 16), 0xFF)) ;
    d[4 * i + 2] := BYTE (Bits.And (Bits.Shr (h.h[i], 8), 0xFF)) ;
    d[4 * i + 3] := BYTE (Bits.And (h.h[i], 0xFF))
  END ;
  h.n := 0 ;
  RETURN d
END Final ;

PROCEDURE Sha256Of (RO b: SLICE OF BYTE) : SLICE OF BYTE RAISES ValueRange =
VAR h : Sha256 ;
BEGIN
  Init (h) ;
  Update (h, b) ;
  RETURN Final (h)
END Sha256Of ;

PROCEDURE Hex (RO digest: SLICE OF BYTE) : STR RAISES ValueRange =
VAR
  s, digits : STR ;
  i, v : I64 ;
BEGIN
  digits := '0123456789abcdef' ;
  s := NEW (CHAR, 2 * LEN (digest)) ;
  FOR i := 0 TO LEN (digest) - 1 DO
    v := I64 (digest[i]) ;
    s[2 * i] := digits[v DIV 16] ;
    s[2 * i + 1] := digits[v MOD 16]
  END ;
  RETURN s
END Hex ;

PROCEDURE HmacInit (VAR m: Hmac ; RO key: SLICE OF BYTE) RAISES ValueRange =
VAR
  k, pad : ARRAY 64 OF BYTE ;
  kd : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  FOR i := 0 TO BlockLen - 1 DO k[i] := 0 END ;
  IF LEN (key) > BlockLen THEN
    kd := Sha256Of (key) ;
    n := DigestLen ;
    FOR i := 0 TO n - 1 DO k[i] := kd[i] END
  ELSE
    FOR i := 0 TO LEN (key) - 1 DO k[i] := key[i] END
  END ;
  Init (m.inner) ;
  FOR i := 0 TO BlockLen - 1 DO pad[i] := BYTE (Bits.Xor (I64 (k[i]), 0x36)) END ;
  Update (m.inner, pad) ;
  Init (m.outer) ;
  FOR i := 0 TO BlockLen - 1 DO pad[i] := BYTE (Bits.Xor (I64 (k[i]), 0x5c)) END ;
  Update (m.outer, pad)
END HmacInit ;

PROCEDURE HmacUpdate (VAR m: Hmac ; RO b: SLICE OF BYTE) RAISES ValueRange =
BEGIN
  Update (m.inner, b)
END HmacUpdate ;

PROCEDURE HmacFinal (VAR m: Hmac) : SLICE OF BYTE RAISES ValueRange =
VAR d : SLICE OF BYTE ;
BEGIN
  d := Final (m.inner) ;
  Update (m.outer, d) ;
  RETURN Final (m.outer)
END HmacFinal ;

PROCEDURE HmacOf (RO key: SLICE OF BYTE ; RO b: SLICE OF BYTE) : SLICE OF BYTE
  RAISES ValueRange =
VAR m : Hmac ;
BEGIN
  HmacInit (m, key) ;
  HmacUpdate (m, b) ;
  RETURN HmacFinal (m)
END HmacOf ;

PROCEDURE Pbkdf2 (RO password: SLICE OF BYTE ; RO salt: SLICE OF BYTE ;
                  iterations: I64 ; length: I64) : SLICE OF BYTE
  RAISES ValueRange, Faults.BadArg =
  (* the keyed states are made once and COPIED for each HMAC: a record
     assignment, which is what makes 600,000 iterations two
     compressions each and not four *)
VAR
  tmpl, m : Hmac ;
  out, u, t : SLICE OF BYTE ;
  ctr : ARRAY 4 OF BYTE ;
  block, i, j, have, take : I64 ;
BEGIN
  IF iterations < 1 THEN RAISE Faults.BadArg ('Pbkdf2: iterations below 1') END ;
  IF length < 1 THEN RAISE Faults.BadArg ('Pbkdf2: length below 1') END ;
  HmacInit (tmpl, password) ;
  out := NEW (BYTE, length) ;
  t := NEW (BYTE, DigestLen) ;
  have := 0 ;
  block := 1 ;
  WHILE have < length DO
    ctr[0] := BYTE (Bits.And (Bits.Shr (block, 24), 0xFF)) ;
    ctr[1] := BYTE (Bits.And (Bits.Shr (block, 16), 0xFF)) ;
    ctr[2] := BYTE (Bits.And (Bits.Shr (block, 8), 0xFF)) ;
    ctr[3] := BYTE (Bits.And (block, 0xFF)) ;
    m := tmpl ;
    HmacUpdate (m, salt) ;
    HmacUpdate (m, ctr) ;
    u := HmacFinal (m) ;
    FOR j := 0 TO DigestLen - 1 DO t[j] := u[j] END ;
    FOR i := 2 TO iterations DO
      m := tmpl ;
      HmacUpdate (m, u) ;
      u := HmacFinal (m) ;
      FOR j := 0 TO DigestLen - 1 DO t[j] := BYTE (Bits.Xor (I64 (t[j]), I64 (u[j]))) END
    END ;
    take := length - have ;
    IF take > DigestLen THEN take := DigestLen END ;
    FOR j := 0 TO take - 1 DO out[have + j] := t[j] END ;
    have := have + take ;
    block := block + 1
  END ;
  RETURN out
END Pbkdf2 ;

PROCEDURE Equal (RO a: SLICE OF BYTE ; RO b: SLICE OF BYTE) : BOOL =
VAR diff, i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  diff := 0 ;
  FOR i := 0 TO LEN (a) - 1 DO
    diff := Bits.Or (diff, Bits.Xor (I64 (a[i]), I64 (b[i])))
  END ;
  RETURN diff = 0
END Equal ;

END Hash.
