(* SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0 *)
DEFINITION MODULE Pg ;

(* Pg speaks PostgreSQL over libpq: it connects, runs parameterised
   statements, and reads the answer as text cells or as typed values.
   It was lifted from the download statistics (m9downloadstats/Pg.m9,
   in production since 2026-09-12) into the library,
   docs/datalib-plan.md par 1.

   TEXT FIRST.  Every parameter goes out as text and the SQL casts it
   (`$1::text[]`, `$2::timestamptz`); every cell comes back as the
   text Postgres prints for it.  The typed reads (I64Cell, F64Cell,
   BoolCell, TimeCell) parse that text and RAISE ValueRange when it
   is not what they read: a NULL included, which IsNull tells
   apart beforehand.  Nothing is converted silently.

   THREADS.  libpq is safe per connection: two threads must not use
   one Conn at the same time, and two connections are independent.
   A server gives every worker its own Conn, opened on the main
   thread before any THREAD starts (HttpServer's Request.worker
   indexes them), so the foreign unit is [REENTRANT] throughout and a
   query never waits on another worker's.

   LINKING.  The binding is libpq.so.5, which is on every machine
   that has psql, plus runtime/pgshim.c for the one call a FOR "C"
   unit cannot express (PQexecParams takes a table of C pointers;
   pgshim rebuilds it from one NUL-separated block, the System.Exec
   convention).  The foreign unit below NAMES both (LINK, par 7), so
   m9c's flagless link, --run and --cell carry them; a program that
   takes the C line over with -- names them itself.                   *)

IMPORT Time ;

TYPE
  Conn ;                          (* one libpq connection; lives in a POOL *)
  Result ;                        (* one query's rows, as text *)

EXCEPTION
  PgError (RO msg: STR) ;
    (* PgError carries libpq's own message: a refused connection, a
       syntax error, a missing relation.  The text is what
       PQerrorMessage or PQresultErrorMessage said, trimmed of its
       trailing newline. *)

CONST
  MaxParams = 64 ;                (* pgshim.c's pointer table *)

PROCEDURE Connect (VAR pool: POOL ; RO conninfo: STR) : PTR Conn IN pool
  RAISES PgError, ValueRange ;
  (* conninfo -- a libpq connection string ('host=... dbname=...'),
                 or EMPTY to let libpq read PGHOST, PGPORT,
                 PGDATABASE, PGUSER and PGPASSWORD from the
                 environment.  KEPT: Reconnect needs it again.      *)

PROCEDURE Reconnect (VAR c: PTR Conn) RAISES PgError, ValueRange ;
  (* Reconnect closes and opens again with the same conninfo.  A
     worker does that once after a query fails with the connection
     gone (a server restart, an idle timeout).                     *)

PROCEDURE Alive (c: PTR Conn) : BOOL RAISES ValueRange ;
  (* Alive answers PQstatus = CONNECTION_OK.  It answers FALSE after
     the server went away: the answer to "should I Reconnect before
     retrying". *)

PROCEDURE Close (VAR c: PTR Conn) ;

PROCEDURE Query (VAR pool: POOL ; c: PTR Conn ; RO sql: STR ;
                 RO params: SLICE OF STR) : PTR Result IN pool
  RAISES PgError, ValueRange, IndexError ;
  (* Query runs one statement, `$1`..`$n` bound to params as text.
     It copies the rows out of libpq into pool before the PGresult is
     freed, so the Result owes libpq nothing.

       params -- at most MaxParams; an empty slice is fine.  Every
                 CHAR goes out as UTF-8 (the database's encoding).
       raises PgError for anything that is not PGRES_TUPLES_OK or
                 PGRES_COMMAND_OK, with the server's message.      *)

PROCEDURE Exec (c: PTR Conn ; RO sql: STR ; RO params: SLICE OF STR)
  : I64 RAISES PgError, ValueRange, IndexError ;
  (* Exec runs one statement that answers no rows (INSERT, UPDATE,
     DELETE, CREATE), bound as Query binds.  It answers how many rows
     it affected (PQcmdTuples), 0 for a command that does not say.  *)

PROCEDURE ArrayLiteral (RO items: SLICE OF STR) : STR ;
  (* ArrayLiteral answers the text of a one-dimensional array for a
     `$n::text[]' parameter: every item double-quoted, a backslash or
     a quote in it escaped with a backslash, the empty slice `{}'.
     That is the form the server reads back element for element
     (PgTest asks it).
     cp-kernel's issue 8, 2026-10-09.                                *)

PROCEDURE Script (c: PTR Conn ; RO sql: STR) RAISES PgError, ValueRange ;
  (* Script runs several statements separated by semicolons, no
     parameters (PQexec): a schema, a fixture, a migration.  It stops
     at the first statement that fails and raises with its message;
     the statements before it stand unless the script is in a
     transaction.                                                  *)

PROCEDURE Begin (c: PTR Conn) RAISES PgError, ValueRange ;
PROCEDURE Commit (c: PTR Conn) RAISES PgError, ValueRange ;
PROCEDURE Rollback (c: PTR Conn) RAISES PgError, ValueRange ;
  (* These run BEGIN, COMMIT and ROLLBACK, named so a reader sees
     them.                                                          *)

PROCEDURE Rows (r: PTR Result) : I64 ;
PROCEDURE Cols (r: PTR Result) : I64 ;

PROCEDURE Cell (r: PTR Result ; row, col: I64) : STR RAISES IndexError ;
  (* Cell answers the text of one cell, EMPTY for SQL NULL.  Ask
     IsNull when the two must be told apart.  row and col are each
     checked against their own extent: Cell (r, 0, Cols (r)) is an
     IndexError, never the first cell of row 1 (the lifted module
     answered that until 2026-10-06). *)

PROCEDURE IsNull (r: PTR Result ; row, col: I64) : BOOL RAISES IndexError ;

PROCEDURE Name (r: PTR Result ; col: I64) : STR RAISES IndexError ;
  (* Name answers the column's name as the SELECT spelled it. *)

PROCEDURE Column (r: PTR Result ; RO name: STR) : I64 ;
  (* Column answers the index of the first column named name, or
     -1. *)

PROCEDURE I64Cell (r: PTR Result ; row, col: I64) : I64
  RAISES IndexError, ValueRange ;
  (* I64Cell reads an integer cell (int2, int4, int8, or numeric with
     no fraction).  It raises ValueRange for NULL, for a fraction, and
     for anything else.                                             *)

PROCEDURE F64Cell (r: PTR Result ; row, col: I64) : F64
  RAISES IndexError, ValueRange ;
  (* F64Cell reads a float4, float8, numeric or integer cell;
     Postgres's NaN, Infinity and -Infinity are read as themselves.
     It raises ValueRange for NULL and for anything that is not a
     number.                                                       *)

PROCEDURE BoolCell (r: PTR Result ; row, col: I64) : BOOL
  RAISES IndexError, ValueRange ;
  (* BoolCell reads a boolean cell: Postgres prints t or f.  It raises
     ValueRange otherwise. *)

PROCEDURE TimeCell (r: PTR Result ; row, col: I64) : Time.Instant
  RAISES IndexError, ValueRange ;
  (* TimeCell reads a timestamptz cell, `2026-10-06 21:26:48.123+02`
     in whatever zone the session prints, converted to UTC by the
     offset it carries.  A timestamp WITHOUT time zone has no offset
     and is refused (ValueRange): this module will not claim which
     instant it means, as Time.ParseIso will not.  Infinity and dates
     BC are refused too.                                            *)

END Pg.


UNSAFE DEFINITION MODULE FOR "C" cpq LINK "pgshim.c", "-l:libpq.so.5" ;

(* This unit binds libpq, verbatim, plus the shim and two runtime
   calls.  All are [REENTRANT]: see THREADS in the definition above.
   No call here touches state shared between two connections, and the
   one process-wide thing libpq does (initialising OpenSSL) happens
   inside the first connect, which the main thread makes alone.    *)

PROCEDURE ConnectDb = "PQconnectdb" (info: C.ConstPtr) : C.MutPtr
  [REENTRANT] ;
PROCEDURE Status = "PQstatus" (c: C.MutPtr) : C.Int  [REENTRANT] ;
PROCEDURE Finish = "PQfinish" (c: C.MutPtr)  [REENTRANT] ;
PROCEDURE ErrMsg = "PQerrorMessage" (c: C.MutPtr) : C.ConstPtr
  [REENTRANT] ;
PROCEDURE ExecBlock = "m9_pq_exec"
  (c: C.MutPtr ; sql: C.ConstPtr ; block: C.ConstPtr ; n: C.Int)
  : C.MutPtr  [REENTRANT] ;
PROCEDURE ExecPlain = "PQexec" (c: C.MutPtr ; sql: C.ConstPtr) : C.MutPtr
  [REENTRANT] ;
PROCEDURE ResStatus = "PQresultStatus" (r: C.MutPtr) : C.Int
  [REENTRANT] ;
PROCEDURE ResErr = "PQresultErrorMessage" (r: C.MutPtr) : C.ConstPtr
  [REENTRANT] ;
PROCEDURE CmdTuples = "PQcmdTuples" (r: C.MutPtr) : C.ConstPtr
  [REENTRANT] ;
PROCEDURE NTuples = "PQntuples" (r: C.MutPtr) : C.Int  [REENTRANT] ;
PROCEDURE NFields = "PQnfields" (r: C.MutPtr) : C.Int  [REENTRANT] ;
PROCEDURE FName = "PQfname" (r: C.MutPtr ; col: C.Int) : C.ConstPtr
  [REENTRANT] ;
PROCEDURE GetValue = "PQgetvalue" (r: C.MutPtr ; row: C.Int ; col: C.Int)
  : C.ConstPtr  [REENTRANT] ;
PROCEDURE GetLength = "PQgetlength" (r: C.MutPtr ; row: C.Int ; col: C.Int)
  : C.Int  [REENTRANT] ;
PROCEDURE GetIsNull = "PQgetisnull" (r: C.MutPtr ; row: C.Int ; col: C.Int)
  : C.Int  [REENTRANT] ;
PROCEDURE Clear = "PQclear" (r: C.MutPtr)  [REENTRANT] ;
PROCEDURE CLen = "m9_cstrlen" (s: C.ConstPtr) : C.SSizeT  [REENTRANT] ;
  (* This is the runtime's shim, as Grib explains: string.h has
     declared strlen with `const char *` and the foreign declaration
     would collide. *)
PROCEDURE CCopy = "memcpy" (d: C.MutPtr ; s: C.ConstPtr ; n: C.SizeT)
  : C.MutPtr  [REENTRANT] ;

END cpq.


UNSAFE IMPLEMENTATION MODULE Pg ;

IMPORT Text ;

(* Pg is UNSAFE for one reason: ADR at the C boundary. *)

IMPORT DynStr ;
IMPORT Fmt ;
IMPORT Time ;
FROM cpq IMPORT ConnectDb, Status, Finish, ErrMsg, ExecBlock, ExecPlain,
                ResStatus, ResErr, CmdTuples, NTuples, NFields, FName,
                GetValue, GetLength, GetIsNull, Clear, CLen, CCopy ;

CONST
  Nowhere = 0 ;                   (* the null pointer, as Grib spells it *)
  MaxMsg = 4096 ;                 (* a server message longer than this is cut *)
  ConnOk = 0 ;                    (* CONNECTION_OK *)
  CommandOk = 1 ;                 (* PGRES_COMMAND_OK *)
  TuplesOk = 2 ;                  (* PGRES_TUPLES_OK *)

TYPE
  Conn = RECORD
    h : C.MutPtr ;
    info : STR ;
    open : BOOL ;
  END ;

  Result = RECORD
    rows, cols : I64 ;
    cell : SLICE OF STR ;         (* row-major, rows * cols *)
    isNull : SLICE OF BOOL ;
    name : SLICE OF STR ;         (* cols *)
  END ;

PROCEDURE Null () : C.MutPtr =
BEGIN
  RETURN C.MutPtr (Nowhere)
END Null ;

PROCEDURE IsNil (p: C.MutPtr) : BOOL =
BEGIN
  RETURN C.SSizeT (p) = C.SSizeT (Null ())
END IsNil ;

(* CText copies a C string into pool, capped, as text: a server
   message, a column name, a command tag.  It decodes the octets as
   UTF-8 when they are valid, else one character per octet, so it
   cannot raise on what libpq sends.  The server sends its text in
   client_encoding, which is UTF-8 for a UTF-8 database.  A message
   quotes the identifiers it names.  Until 2026-10-31 CText
   read every message as Latin-1, so `relation "größe"' read as
   mojibake. *)
PROCEDURE CText (VAR pool: POOL ; p: C.ConstPtr) : STR RAISES ValueRange =
VAR
  n, k : I64 ;
  b : SLICE OF BYTE ;
  q : C.MutPtr ;
BEGIN
  IF C.SSizeT (p) = C.SSizeT (Null ()) THEN RETURN '' END ;
  n := I64 (CLen (p)) ;
  IF n = 0 THEN RETURN '' END ;
  k := n ;
  IF k > MaxMsg THEN k := MaxMsg + 1 END ;
  b := NEW (pool, BYTE, k + 1) ;
  q := CCopy (ADR (b), p, C.SizeT (k)) ;
  IF n > MaxMsg THEN
    (* The cap keeps whole characters.  An octet 80..BF continues a
       character, so the cut steps back over them.  A message cut
       inside a character would otherwise fail UTF-8 and read whole
       as Latin-1. *)
    n := MaxMsg ;
    WHILE n > 0 AND I64 (b[n]) >= 128 AND I64 (b[n]) < 192 DO
      n := n - 1
    END
  END ;
  IF n = 0 THEN RETURN '' END ;
  (* libpq ends its messages with a newline; the caller composes *)
  IF b[n - 1] = 10 THEN n := n - 1 END ;
  RETURN DynStr.Decoded (pool, SLICE (b, 0, n))
END CText ;

(* CStr answers s as UTF-8 octets with a terminator.  Pool storage is
   zero, so the extra byte is the terminator.  This is DynStr.Wire's
   contract. *)
PROCEDURE CStr (VAR pool: POOL ; RO s: STR) : SLICE OF BYTE
  RAISES ValueRange, IndexError =
VAR
  u, b : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  u := OCTETS (s) ;
  b := NEW (pool, BYTE, LEN (u) + 1) ;
  FOR i := 0 TO LEN (u) - 1 DO b[i] := u[i] END ;
  RETURN b
END CStr ;

PROCEDURE Open (VAR scratch: POOL ; RO info: STR ; VAR msg: STR) : C.MutPtr
  RAISES ValueRange =
  (* Open answers a connection, or the null pointer with msg saying
     why. *)
VAR
  cb : SLICE OF BYTE ;
  h : C.MutPtr ;
BEGIN
  BEGIN
    cb := CStr (scratch, info)
  EXCEPT
  | IndexError :
      msg := 'conninfo could not be encoded' ;
      RETURN Null ()
  END ;
  h := ConnectDb (ADR (cb)) ;
  IF IsNil (h) THEN
    msg := 'libpq could not allocate a connection' ;
    RETURN Null ()
  END ;
  IF I64 (Status (h)) # ConnOk THEN
    msg := CText (scratch, ErrMsg (h)) ;
    Finish (h) ;
    RETURN Null ()
  END ;
  RETURN h
END Open ;

PROCEDURE Connect (VAR pool: POOL ; RO conninfo: STR) : PTR Conn IN pool
  RAISES PgError, ValueRange =
VAR
  scratch : POOL ;
  h : C.MutPtr ;
  c : PTR Conn IN pool ;
  msg : STR ;
BEGIN
  msg := '' ;
  h := Open (scratch, conninfo, msg) ;
  IF IsNil (h) THEN RAISE PgError (msg) END ;    (* copied at the raise, par 5 *)
  c := NEW (pool, Conn) ;
  c.h := h ;
  c.info := conninfo ;
  c.open := TRUE ;
  RETURN c
END Connect ;

PROCEDURE Reconnect (VAR c: PTR Conn) RAISES PgError, ValueRange =
VAR
  scratch : POOL ;
  h : C.MutPtr ;
  msg : STR ;
BEGIN
  IF c.open THEN
    c.open := FALSE ;
    Finish (c.h)
  END ;
  msg := '' ;
  h := Open (scratch, c.info, msg) ;
  IF IsNil (h) THEN RAISE PgError (msg) END ;
  c.h := h ;
  c.open := TRUE
END Reconnect ;

PROCEDURE Alive (c: PTR Conn) : BOOL RAISES ValueRange =
BEGIN
  IF NOT c.open THEN RETURN FALSE END ;
  RETURN I64 (Status (c.h)) = ConnOk
END Alive ;

PROCEDURE Close (VAR c: PTR Conn) =
BEGIN
  IF NOT c.open THEN RETURN END ;
  c.open := FALSE ;
  Finish (c.h)
END Close ;

(* ParamBlock answers the parameters as ONE block: each as UTF-8,
   each followed by the zero the pool already holds; a trailing zero
   for the empty case. *)
PROCEDURE ParamBlock (VAR pool: POOL ; RO params: SLICE OF STR)
  : SLICE OF BYTE RAISES ValueRange, IndexError =
VAR
  u, blk : SLICE OF BYTE ;
  i, j, total, pos : I64 ;
BEGIN
  total := 1 ;
  FOR i := 0 TO LEN (params) - 1 DO
    u := OCTETS (params[i]) ;
    total := total + LEN (u) + 1
  END ;
  blk := NEW (pool, BYTE, total) ;
  pos := 0 ;
  FOR i := 0 TO LEN (params) - 1 DO
    u := OCTETS (params[i]) ;
    FOR j := 0 TO LEN (u) - 1 DO
      blk[pos] := u[j] ;
      pos := pos + 1
    END ;
    pos := pos + 1
  END ;
  RETURN blk
END ParamBlock ;

PROCEDURE Run (VAR scratch: POOL ; c: PTR Conn ; RO sql: STR ;
               RO params: SLICE OF STR) : C.MutPtr
  RAISES PgError, ValueRange, IndexError =
  (* Run sends the statement and answers its PGresult; the caller clears
     it.  A status other than TUPLES_OK or COMMAND_OK is cleared here
     and raised with the server's message. *)
VAR
  sb, blk : SLICE OF BYTE ;
  res : C.MutPtr ;
  st : I64 ;
  msg : STR ;
BEGIN
  IF NOT c.open THEN RAISE PgError ('the connection is closed') END ;
  IF LEN (params) > MaxParams THEN RAISE PgError ('too many parameters') END ;
  sb := CStr (scratch, sql) ;
  blk := ParamBlock (scratch, params) ;
  res := ExecBlock (c.h, ADR (sb), ADR (blk), C.Int (LEN (params))) ;
  IF IsNil (res) THEN
    msg := CText (scratch, ErrMsg (c.h)) ;
    RAISE PgError (msg)
  END ;
  st := I64 (ResStatus (res)) ;
  IF (st # TuplesOk) AND (st # CommandOk) THEN
    msg := CText (scratch, ResErr (res)) ;
    Clear (res) ;
    RAISE PgError (msg)
  END ;
  RETURN res
END Run ;

PROCEDURE Query (VAR pool: POOL ; c: PTR Conn ; RO sql: STR ;
                 RO params: SLICE OF STR) : PTR Result IN pool
  RAISES PgError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  b : SLICE OF BYTE ;
  res : C.MutPtr ;
  q : C.MutPtr ;
  i, j, k, n, total : I64 ;
  r : PTR Result IN pool ;
BEGIN
  res := Run (scratch, c, sql, params) ;
  BEGIN
    r := NEW (pool, Result) ;
    r.rows := I64 (NTuples (res)) ;
    r.cols := I64 (NFields (res)) ;
    total := r.rows * r.cols ;
    IF total < 1 THEN total := 1 END ;
    r.cell := NEW (pool, STR, total) ;
    r.isNull := NEW (pool, BOOL, total) ;
    IF r.cols > 0 THEN
      r.name := NEW (pool, STR, r.cols)
    ELSE
      r.name := NEW (pool, STR, 1)
    END ;
    FOR j := 0 TO r.cols - 1 DO
      r.name[j] := CText (pool, FName (res, C.Int (j)))
    END ;
    k := 0 ;
    FOR i := 0 TO r.rows - 1 DO
      FOR j := 0 TO r.cols - 1 DO
        IF I64 (GetIsNull (res, C.Int (i), C.Int (j))) # 0 THEN
          r.cell[k] := '' ;
          r.isNull[k] := TRUE
        ELSE
          n := I64 (GetLength (res, C.Int (i), C.Int (j))) ;
          IF n = 0 THEN
            r.cell[k] := ''
          ELSE
            b := NEW (pool, BYTE, n) ;
            q := CCopy (ADR (b), GetValue (res, C.Int (i), C.Int (j)), C.SizeT (n)) ;
            (* A cell is UTF-8 text, or one character per octet when a
               server in another encoding sends what is not. *)
            r.cell[k] := DynStr.Decoded (pool, b)
          END ;
          r.isNull[k] := FALSE
        END ;
        k := k + 1
      END
    END
  FINALLY
    Clear (res)
  END ;
  RETURN r
END Query ;

PROCEDURE Count (RO s: STR) : I64 =
  (* Count reads PQcmdTuples' text as a count: '' (a command that
     reports none) is 0; it is digits otherwise. *)
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF I64 (Text.BAt (s, i)) >= ORD ('0') AND I64 (Text.BAt (s, i)) <= ORD ('9') THEN
      v := v * 10 + I64 (Text.BAt (s, i)) - ORD ('0')
    END
  END ;
  RETURN v
END Count ;

PROCEDURE Exec (c: PTR Conn ; RO sql: STR ; RO params: SLICE OF STR)
  : I64 RAISES PgError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  res : C.MutPtr ;
  n : I64 ;
BEGIN
  res := Run (scratch, c, sql, params) ;
  BEGIN
    n := Count (CText (scratch, CmdTuples (res)))
  FINALLY
    Clear (res)
  END ;
  RETURN n
END Exec ;

PROCEDURE Script (c: PTR Conn ; RO sql: STR) RAISES PgError, ValueRange =
VAR
  scratch : POOL ;
  sb : SLICE OF BYTE ;
  res : C.MutPtr ;
  st : I64 ;
  msg : STR ;
BEGIN
  IF NOT c.open THEN RAISE PgError ('the connection is closed') END ;
  BEGIN
    sb := CStr (scratch, sql)
  EXCEPT
  | IndexError :
      RAISE PgError ('the script could not be encoded')
  END ;
  res := ExecPlain (c.h, ADR (sb)) ;
  IF IsNil (res) THEN
    msg := CText (scratch, ErrMsg (c.h)) ;
    RAISE PgError (msg)
  END ;
  st := I64 (ResStatus (res)) ;
  IF (st # TuplesOk) AND (st # CommandOk) THEN
    msg := CText (scratch, ResErr (res)) ;
    Clear (res) ;
    RAISE PgError (msg)
  END ;
  Clear (res)
END Script ;

PROCEDURE Begin (c: PTR Conn) RAISES PgError, ValueRange =
BEGIN
  Script (c, 'BEGIN')
END Begin ;

PROCEDURE Commit (c: PTR Conn) RAISES PgError, ValueRange =
BEGIN
  Script (c, 'COMMIT')
END Commit ;

PROCEDURE Rollback (c: PTR Conn) RAISES PgError, ValueRange =
BEGIN
  Script (c, 'ROLLBACK')
END Rollback ;

PROCEDURE Rows (r: PTR Result) : I64 =
BEGIN
  RETURN r.rows
END Rows ;

PROCEDURE Cols (r: PTR Result) : I64 =
BEGIN
  RETURN r.cols
END Cols ;

PROCEDURE At (r: PTR Result ; row, col: I64) : I64 RAISES IndexError =
  (* At answers the index of a cell, each coordinate held to its own
     extent. *)
BEGIN
  IF row < 0 OR row >= r.rows THEN RAISE IndexError (row, r.rows) END ;
  IF col < 0 OR col >= r.cols THEN RAISE IndexError (col, r.cols) END ;
  RETURN row * r.cols + col
END At ;

PROCEDURE ArrayLiteral (RO items: SLICE OF STR) : STR =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  i : I64 ;
  c : CHAR ;
BEGIN
  d := DynStr.New (scratch) ;
  DynStr.AppendChar (d, '{') ;
  FOR i := 0 TO LEN (items) - 1 DO
    IF i > 0 THEN DynStr.AppendChar (d, ',') END ;
    DynStr.AppendChar (d, '"') ;
    (* FOR c IN: over characters, the same both sides of the UTF switch *)
    FOR c IN items[i] DO
      IF c = '"' OR c = 5CC THEN DynStr.AppendChar (d, 5CC) END ;
      DynStr.AppendChar (d, c)
    END ;
    DynStr.AppendChar (d, '"')
  END ;
  DynStr.AppendChar (d, '}') ;
  RETURN DynStr.View (d)
END ArrayLiteral ;

PROCEDURE Cell (r: PTR Result ; row, col: I64) : STR RAISES IndexError =
BEGIN
  RETURN r.cell[At (r, row, col)]
END Cell ;

PROCEDURE IsNull (r: PTR Result ; row, col: I64) : BOOL RAISES IndexError =
BEGIN
  RETURN r.isNull[At (r, row, col)]
END IsNull ;

PROCEDURE Name (r: PTR Result ; col: I64) : STR RAISES IndexError =
BEGIN
  IF col < 0 OR col >= r.cols THEN RAISE IndexError (col, r.cols) END ;
  RETURN r.name[col]
END Name ;

PROCEDURE Column (r: PTR Result ; RO name: STR) : I64 =
VAR j : I64 ;
BEGIN
  FOR j := 0 TO r.cols - 1 DO
    IF Text.Eq (r.name[j], name) THEN RETURN j END
  END ;
  RETURN -1
END Column ;

PROCEDURE Present (r: PTR Result ; row, col: I64) : STR
  RAISES IndexError, ValueRange =
  (* Present answers the cell's text, NULL refused. *)
VAR k : I64 ;
BEGIN
  k := At (r, row, col) ;
  IF r.isNull[k] THEN RAISE ValueRange END ;
  RETURN r.cell[k]
END Present ;

PROCEDURE I64Cell (r: PTR Result ; row, col: I64) : I64
  RAISES IndexError, ValueRange =
VAR
  s : STR ;
  i, v, d : I64 ;
  neg : BOOL ;
BEGIN
  s := Present (r, row, col) ;
  IF Text.BLen (s) = 0 THEN RAISE ValueRange END ;
  i := 0 ;
  neg := FALSE ;
  IF Text.BIs (s, 0, '-') THEN neg := TRUE ; i := 1
  ELSIF Text.BIs (s, 0, '+') THEN i := 1
  END ;
  IF i = Text.BLen (s) THEN RAISE ValueRange END ;
  v := 0 ;
  WHILE i < Text.BLen (s) DO
    IF I64 (Text.BAt (s, i)) < ORD ('0') OR I64 (Text.BAt (s, i)) > ORD ('9') THEN RAISE ValueRange END ;
    d := I64 (Text.BAt (s, i)) - ORD ('0') ;
    (* The value is accumulated negative, so the most negative int8
       fits. *)
    v := v * 10 - d ;
    i := i + 1
  END ;
  IF neg THEN RETURN v END ;
  RETURN -v
END I64Cell ;

PROCEDURE F64Cell (r: PTR Result ; row, col: I64) : F64
  RAISES IndexError, ValueRange =
  (* Fmt.ParseF64 reads the number, correctly rounded since 0.20.0, and
     refuses what is not one.  F64Cell parsed it a second time through
     libc's strtod until 2026-10-31.  The two gave the same double, and
     a sabotage that dropped strtod stayed green. *)
VAR s : STR ;
BEGIN
  s := Present (r, row, col) ;
  IF Text.Eq (s, 'NaN') THEN RETURN NaN END ;
  IF Text.Eq (s, 'Infinity') THEN RETURN 1.0E308 * 10.0 END ;
  IF Text.Eq (s, '-Infinity') THEN RETURN -1.0E308 * 10.0 END ;
  RETURN Fmt.ParseF64 (s)
END F64Cell ;

PROCEDURE BoolCell (r: PTR Result ; row, col: I64) : BOOL
  RAISES IndexError, ValueRange =
VAR s : STR ;
BEGIN
  s := Present (r, row, col) ;
  IF Text.Eq (s, 't') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'f') THEN RETURN FALSE END ;
  RAISE ValueRange
END BoolCell ;

PROCEDURE Num (RO s: STR ; at, n: I64) : I64 RAISES ValueRange =
  (* Num reads n digits of s from at, as a count.  It raises
     ValueRange for anything else. *)
VAR i, v : I64 ;
BEGIN
  IF at + n > Text.BLen (s) THEN RAISE ValueRange END ;
  v := 0 ;
  FOR i := at TO at + n - 1 DO
    IF I64 (Text.BAt (s, i)) < ORD ('0') OR I64 (Text.BAt (s, i)) > ORD ('9') THEN RAISE ValueRange END ;
    v := v * 10 + I64 (Text.BAt (s, i)) - ORD ('0')
  END ;
  RETURN v
END Num ;

PROCEDURE TimeCell (r: PTR Result ; row, col: I64) : Time.Instant
  RAISES IndexError, ValueRange =
  (* TimeCell reads `YYYY-MM-DD HH:MM:SS[.ffffff](+|-)HH[:MM[:SS]]`,
     ISO DateStyle, Postgres's default and the one it prints when
     nothing says otherwise. *)
VAR
  s : STR ;
  cv : Time.Civil ;
  t : Time.Instant ;
  i, frac, scale, sign, off : I64 ;
BEGIN
  s := Present (r, row, col) ;
  IF Text.BLen (s) < 22 OR NOT Text.BIs (s, 4, '-') OR NOT Text.BIs (s, 7, '-') OR NOT Text.BIs (s, 10, ' ') OR
     NOT Text.BIs (s, 13, ':') OR NOT Text.BIs (s, 16, ':') THEN
    RAISE ValueRange
  END ;
  cv.year := Num (s, 0, 4) ;
  cv.month := Num (s, 5, 2) ;
  cv.day := Num (s, 8, 2) ;
  cv.hour := Num (s, 11, 2) ;
  cv.minute := Num (s, 14, 2) ;
  cv.second := F64 (Num (s, 17, 2)) ;
  i := 19 ;
  IF Text.BIs (s, i, '.') THEN
    i := i + 1 ;
    frac := 0 ;
    scale := 1 ;
    WHILE i < Text.BLen (s) AND I64 (Text.BAt (s, i)) >= ORD ('0') AND I64 (Text.BAt (s, i)) <= ORD ('9') DO
      frac := frac * 10 + I64 (Text.BAt (s, i)) - ORD ('0') ;
      scale := scale * 10 ;
      i := i + 1
    END ;
    IF scale = 1 THEN RAISE ValueRange END ;
    cv.second := cv.second + F64 (frac) / F64 (scale)
  END ;
  IF i >= Text.BLen (s) THEN RAISE ValueRange END ;
  IF Text.BIs (s, i, '+') THEN sign := 1
  ELSIF Text.BIs (s, i, '-') THEN sign := -1
  ELSE RAISE ValueRange
  END ;
  off := Num (s, i + 1, 2) * 3600 ;
  i := i + 3 ;
  IF i < Text.BLen (s) THEN
    IF NOT Text.BIs (s, i, ':') THEN RAISE ValueRange END ;
    off := off + Num (s, i + 1, 2) * 60 ;
    i := i + 3 ;
    IF i < Text.BLen (s) THEN
      IF NOT Text.BIs (s, i, ':') THEN RAISE ValueRange END ;
      off := off + Num (s, i + 1, 2) ;
      i := i + 3
    END
  END ;
  IF i # Text.BLen (s) THEN RAISE ValueRange END ;
  t := Time.FromCivil (cv) ;
  RETURN Time.AddSeconds (t, F64 (-sign * off))
END TimeCell ;

END Pg.
