(* v as four bytes at b[at], the highest first: PNG's order *)
PROCEDURE Put4 (VAR b: SLICE OF BYTE ; at, v: I64) RAISES ValueRange =
VAR k : I64 ;
BEGIN
  FOR k := 3 TO 0 BY -1 DO
    b[at + k] := BYTE (v MOD 256) ;
    v := v DIV 256
  END
END Put4 ;

(* one chunk at out[at]: the length of its data, four letters, the
   data, and the CRC of the letters and the data.  Answers where the
   next chunk goes. *)
PROCEDURE Chunk (VAR out: SLICE OF BYTE ; at: I64 ; RO kind: STR ;
                 RO data: SLICE OF BYTE) : I64
  RAISES ValueRange =
VAR k, n, crc : I64 ;
BEGIN
  n := LEN (data) ;
  Put4 (out, at, n) ;
  FOR k := 0 TO 3 DO out[at + 4 + k] := BYTE (ORD (kind[k])) END ;
  FOR k := 0 TO n - 1 DO out[at + 8 + k] := data[k] END ;
  crc := Zip.Crc32 (SLICE (out, at + 4, 4 + n)) ;
  Put4 (out, at + 8 + n, crc) ;
  RETURN at + 12 + n
END Chunk ;

(* a byte of a filtered row counts as its distance from zero either
   way round: 255 is one away *)
PROCEDURE Weight (v: I64) : I64 =
BEGIN
  IF v > 127 THEN RETURN 256 - v END ;
  RETURN v
END Weight ;

(* the rows as PNG stores them: each behind one byte that says how it
   was filtered -- as it is (0), each byte less the byte one pixel to
   its left (1), or less the byte above (2), whichever leaves the
   least: flat colour then becomes rows of zeros, which is what the
   compressor is good at *)
PROCEDURE Filtered (VAR pool: POOL ; RO rgb: SLICE OF BYTE ;
                    width, height: I64) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  out : SLICE OF BYTE ;
  row, y, x, at, src, v, left, up, s0, s1, s2, pick : I64 ;
BEGIN
  row := 3 * width ;
  out := NEW (pool, BYTE, height * (row + 1)) ;
  FOR y := 0 TO height - 1 DO
    src := y * row ;
    s0 := 0 ;
    s1 := 0 ;
    s2 := 0 ;
    FOR x := 0 TO row - 1 DO
      v := I64 (rgb[src + x]) ;
      left := 0 ;
      IF x >= 3 THEN left := I64 (rgb[src + x - 3]) END ;
      up := 0 ;
      IF y > 0 THEN up := I64 (rgb[src + x - row]) END ;
      s0 := s0 + Weight (v) ;
      s1 := s1 + Weight ((v - left + 256) MOD 256) ;
      s2 := s2 + Weight ((v - up + 256) MOD 256)
    END ;
    pick := 0 ;
    IF s1 < s0 THEN pick := 1 END ;
    IF s2 < s0 AND s2 < s1 THEN pick := 2 END ;
    at := y * (row + 1) ;
    out[at] := BYTE (pick) ;
    FOR x := 0 TO row - 1 DO
      v := I64 (rgb[src + x]) ;
      IF pick = 1 AND x >= 3 THEN
        v := (v - I64 (rgb[src + x - 3]) + 256) MOD 256
      ELSIF pick = 2 AND y > 0 THEN
        v := (v - I64 (rgb[src + x - row]) + 256) MOD 256
      END ;
      out[at + 1 + x] := BYTE (v)
    END
  END ;
  RETURN out
END Filtered ;

PROCEDURE Encode (VAR pool: POOL ; RO rgb: SLICE OF BYTE ;
                  width, height: I64 ; dpi: F64) : SLICE OF BYTE
  RAISES Faults.SizeError, Faults.BadArg, ValueRange =
VAR
  scratch : POOL ;
  head, phys, rows, idat, none, out : SLICE OF BYTE ;
  at, perMetre, size : I64 ;
BEGIN
  IF width < 1 OR height < 1 THEN
    RAISE Faults.BadArg ('Png.Encode: an image has a width and a height')
  END ;
  IF NOT (dpi >= 0.0 AND dpi < 1.0e6) THEN
    RAISE Faults.BadArg ('Png.Encode: a resolution is no dots an inch, or some')
  END ;
  IF LEN (rgb) # 3 * width * height THEN
    RAISE Faults.SizeError (LEN (rgb), 3 * width * height)
  END ;
  head := NEW (scratch, BYTE, 13) ;
  Put4 (head, 0, width) ;
  Put4 (head, 4, height) ;
  head[8] := BYTE (8) ;                 (* bits a channel *)
  head[9] := BYTE (2) ;                 (* red, green, blue *)
  (* deflate, the one filter method, not interlaced: 10 to 12 stay 0 *)
  rows := Filtered (scratch, rgb, width, height) ;
  idat := Zip.Compress (scratch, rows) ;
  size := 8 + 25 + 12 + LEN (idat) + 12 ;
  perMetre := 0 ;
  IF dpi > 0.0 THEN
    (* an inch is 0.0254 m *)
    perMetre := I64 (dpi / 0.0254 + 0.5) ;
    size := size + 21
  END ;
  out := NEW (pool, BYTE, size) ;
  out[0] := BYTE (137) ; out[1] := BYTE (80) ; out[2] := BYTE (78) ;
  out[3] := BYTE (71) ; out[4] := BYTE (13) ; out[5] := BYTE (10) ;
  out[6] := BYTE (26) ; out[7] := BYTE (10) ;
  at := Chunk (out, 8, 'IHDR', head) ;
  IF dpi > 0.0 THEN
    phys := NEW (scratch, BYTE, 9) ;
    Put4 (phys, 0, perMetre) ;
    Put4 (phys, 4, perMetre) ;
    phys[8] := BYTE (1) ;               (* the unit is the metre *)
    at := Chunk (out, at, 'pHYs', phys)
  END ;
  at := Chunk (out, at, 'IDAT', idat) ;
  none := NEW (scratch, BYTE, 0) ;
  at := Chunk (out, at, 'IEND', none) ;
  RETURN out
END Encode ;


(* ---- reading a PNG: for a test that compares pictures -------------- *)

PROCEDURE Get4 (RO b: SLICE OF BYTE ; at: I64) : I64 =
BEGIN
  RETURN ((I64 (b[at]) * 256 + I64 (b[at + 1])) * 256 + I64 (b[at + 2])) * 256
         + I64 (b[at + 3])
END Get4 ;

PROCEDURE IsKind (RO b: SLICE OF BYTE ; at: I64 ; RO kind: STR) : BOOL =
VAR k : I64 ;
BEGIN
  FOR k := 0 TO 3 DO
    IF I64 (b[at + k]) # ORD (kind[k]) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END IsKind ;

(* Paeth's predictor: the neighbour nearest to a + b - c *)
PROCEDURE Paeth (a, b, c: I64) : I64 =
VAR p, pa, pb, pc : I64 ;
BEGIN
  p := a + b - c ;
  pa := p - a ; IF pa < 0 THEN pa := -pa END ;
  pb := p - b ; IF pb < 0 THEN pb := -pb END ;
  pc := p - c ; IF pc < 0 THEN pc := -pc END ;
  IF pa <= pb AND pa <= pc THEN RETURN a END ;
  IF pb <= pc THEN RETURN b END ;
  RETURN c
END Paeth ;

PROCEDURE Decode (VAR pool: POOL ; RO file: SLICE OF BYTE ;
                  VAR width, height: I64) : SLICE OF BYTE
  RAISES Error, Zip.Error, ValueRange =
VAR
  scratch : POOL ;
  idat, rows, out : SLICE OF BYTE ;
  at, n, total, w, k, depth, ctype, bpp, row, y, x, kind, v, a, b, c, alpha : I64 ;
  seenHead : BOOL ;
BEGIN
  IF LEN (file) < 8 OR I64 (file[0]) # 137 OR I64 (file[1]) # 80
     OR I64 (file[2]) # 78 OR I64 (file[3]) # 71 THEN
    RAISE Error ('not a PNG file: it does not begin with the signature')
  END ;
  (* the image data may be in several chunks: first their size *)
  at := 8 ;
  total := 0 ;
  seenHead := FALSE ;
  width := 0 ; height := 0 ; depth := 0 ; ctype := 0 ;
  WHILE at + 12 <= LEN (file) DO
    n := Get4 (file, at) ;
    IF at + 12 + n > LEN (file) THEN
      RAISE Error ('a PNG chunk runs past the end of the file')
    END ;
    IF Zip.Crc32 (SLICE (file, at + 4, 4 + n)) # Get4 (file, at + 8 + n) THEN
      RAISE Error ('a PNG chunk does not match its CRC')
    END ;
    IF IsKind (file, at + 4, 'IHDR') THEN
      width := Get4 (file, at + 8) ;
      height := Get4 (file, at + 12) ;
      depth := I64 (file[at + 16]) ;
      ctype := I64 (file[at + 17]) ;
      IF I64 (file[at + 20]) # 0 THEN
        RAISE Error ('an interlaced PNG, which this does not read')
      END ;
      seenHead := TRUE
    ELSIF IsKind (file, at + 4, 'IDAT') THEN
      total := total + n
    END ;
    at := at + 12 + n
  END ;
  IF NOT seenHead THEN RAISE Error ('a PNG without a header chunk') END ;
  IF depth # 8 OR (ctype # 2 AND ctype # 6) THEN
    RAISE Error ('a PNG that is not 8-bit RGB or RGBA, which this does not read')
  END ;
  idat := NEW (scratch, BYTE, total) ;
  at := 8 ;
  w := 0 ;
  WHILE at + 12 <= LEN (file) DO
    n := Get4 (file, at) ;
    IF IsKind (file, at + 4, 'IDAT') THEN
      FOR k := 0 TO n - 1 DO idat[w + k] := file[at + 8 + k] END ;
      w := w + n
    END ;
    at := at + 12 + n
  END ;
  rows := Zip.Decompress (scratch, idat) ;
  bpp := 3 ;
  IF ctype = 6 THEN bpp := 4 END ;
  row := bpp * width ;
  IF LEN (rows) # height * (row + 1) THEN
    RAISE Error ('the PNG image data is not as long as its rows')
  END ;
  (* the filters undone in place, then the pixels taken out *)
  FOR y := 0 TO height - 1 DO
    kind := I64 (rows[y * (row + 1)]) ;
    FOR x := 0 TO row - 1 DO
      v := I64 (rows[y * (row + 1) + 1 + x]) ;
      a := 0 ; b := 0 ; c := 0 ;
      IF x >= bpp THEN a := I64 (rows[y * (row + 1) + 1 + x - bpp]) END ;
      IF y > 0 THEN
        b := I64 (rows[(y - 1) * (row + 1) + 1 + x]) ;
        IF x >= bpp THEN c := I64 (rows[(y - 1) * (row + 1) + 1 + x - bpp]) END
      END ;
      IF kind = 1 THEN v := v + a
      ELSIF kind = 2 THEN v := v + b
      ELSIF kind = 3 THEN v := v + (a + b) DIV 2
      ELSIF kind = 4 THEN v := v + Paeth (a, b, c)
      ELSIF kind # 0 THEN RAISE Error ('a PNG row filter this does not know')
      END ;
      rows[y * (row + 1) + 1 + x] := BYTE (v MOD 256)
    END
  END ;
  out := NEW (pool, BYTE, 3 * width * height) ;
  FOR y := 0 TO height - 1 DO
    FOR x := 0 TO width - 1 DO
      at := y * (row + 1) + 1 + bpp * x ;
      alpha := 255 ;
      IF bpp = 4 THEN alpha := I64 (rows[at + 3]) END ;
      FOR k := 0 TO 2 DO
        (* transparency laid on white *)
        v := (I64 (rows[at + k]) * alpha + 255 * (255 - alpha) + 127) DIV 255 ;
        out[3 * (y * width + x) + k] := BYTE (v)
      END
    END
  END ;
  RETURN out
END Decode ;

(* ---- the rasteriser ----------------------------------------------------

   A canvas of pixels, a mask the shape being drawn is gathered into,
   and the shape itself as polygons: every mark -- a line of some
   width, a disc, a glyph, an arc flattened to pieces -- is a polygon
   or several, filled by the nonzero rule so that the pieces of one
   stroke cover each other without doubling, with Sub rows of
   coverage to a pixel for the edges.  Paint lays the mask on the
   pixels in one colour and clears it. *)

CONST
  Sub = 8 ;
  MaxPts = 262144 ;
  MaxContours = 65536 ;
  MaxAttrs = 48 ;
  MaxGroups = 64 ;

TYPE
  Canvas = RECORD
    w, h : I64 ;
    sc : F64 ;                            (* pixels to a user unit *)
    pix : SLICE OF BYTE ;                 (* 3 w h: the caller's *)
    mask : SLICE OF BYTE ;                (* w h *)
    cover : SLICE OF F64 ;                (* one row *)
    cx : SLICE OF F64 ;                   (* a sub-row's crossings *)
    cd : SLICE OF I64 ;
    px, py : SLICE OF F64 ;               (* the shape's points *)
    cend : SLICE OF I64 ;                 (* where each contour ends *)
    npts, ncont : I64 ;
    cmin, cmax : SLICE OF I64 ;           (* each contour's first and last row *)
    order, active : SLICE OF I64 ;        (* contours by first row; the ones a row meets *)
    count : SLICE OF I64 ;                (* a counting sort's buckets, h + 2 *)
    lx, ly : SLICE OF F64 ;               (* a path's current subpath *)
    tx, ty : SLICE OF F64 ;               (* an outline's points, duplicates dropped *)
    rx, ry : SLICE OF F64 ;               (* a dash's run of ink *)
    nl : I64 ;
    bx0, by0, bx1, by1 : I64 ;            (* the mask's rows and columns in use *)
    clipped : BOOL ;                      (* a clipPath is in force: *)
    kx0, ky0, kx1, ky1 : F64 ;            (* this rectangle, pixels *)
    ox, oy : F64 ;                        (* where user (0, 0) is, in pixels *)
    gdepth : I64 ;                        (* open groups *)
    gox, goy, gsc : SLICE OF F64 ;        (* the transform each group found *)
  END ;

(* the pixels in `pool`, which is the caller's -- they are the answer
   -- and everything else in `scratch`, which is not *)
PROCEDURE NewCanvas (VAR pool: POOL ; VAR scratch: POOL ; w, h: I64 ;
                     sc: F64 ; VAR c: Canvas)
  RAISES ValueRange =
VAR k : I64 ;
BEGIN
  c.w := w ;
  c.h := h ;
  c.sc := sc ;
  c.pix := NEW (pool, BYTE, 3 * w * h) ;
  FOR k := 0 TO 3 * w * h - 1 DO c.pix[k] := BYTE (255) END ;
  c.mask := NEW (scratch, BYTE, w * h) ;
  c.cover := NEW (scratch, F64, w + 2) ;
  c.cx := NEW (scratch, F64, MaxPts) ;
  c.cd := NEW (scratch, I64, MaxPts) ;
  c.px := NEW (scratch, F64, MaxPts) ;
  c.py := NEW (scratch, F64, MaxPts) ;
  c.cend := NEW (scratch, I64, MaxContours) ;
  c.cmin := NEW (scratch, I64, MaxContours) ;
  c.cmax := NEW (scratch, I64, MaxContours) ;
  c.order := NEW (scratch, I64, MaxContours) ;
  c.active := NEW (scratch, I64, MaxContours) ;
  c.count := NEW (scratch, I64, h + 2) ;
  c.lx := NEW (scratch, F64, MaxPts) ;
  c.tx := NEW (scratch, F64, MaxPts) ;
  c.ty := NEW (scratch, F64, MaxPts) ;
  c.rx := NEW (scratch, F64, MaxPts) ;
  c.ry := NEW (scratch, F64, MaxPts) ;
  c.ly := NEW (scratch, F64, MaxPts) ;
  c.npts := 0 ;
  c.ncont := 0 ;
  c.nl := 0 ;
  c.bx0 := w ; c.by0 := h ; c.bx1 := -1 ; c.by1 := -1 ;
  c.clipped := FALSE ;
  c.kx0 := 0.0 ; c.ky0 := 0.0 ; c.kx1 := F64 (w) ; c.ky1 := F64 (h) ;
  c.ox := 0.0 ;
  c.oy := 0.0 ;
  c.gdepth := 0 ;
  c.gox := NEW (scratch, F64, MaxGroups) ;
  c.goy := NEW (scratch, F64, MaxGroups) ;
  c.gsc := NEW (scratch, F64, MaxGroups)
END NewCanvas ;

(* a user coordinate as a pixel: through the groups' translate and
   scale, then the figure's *)
PROCEDURE PX (RO c: Canvas ; x: F64) : F64 =
BEGIN
  RETURN c.ox + x * c.sc
END PX ;

PROCEDURE PY (RO c: Canvas ; y: F64) : F64 =
BEGIN
  RETURN c.oy + y * c.sc
END PY ;

PROCEDURE Pt (VAR c: Canvas ; x, y: F64) RAISES Faults.BadArg =
BEGIN
  IF c.npts >= MaxPts THEN
    RAISE Faults.BadArg ('Png: a shape of more than 262144 points')
  END ;
  c.px[c.npts] := x ;
  c.py[c.npts] := y ;
  c.npts := c.npts + 1
END Pt ;

PROCEDURE CloseContour (VAR c: Canvas) RAISES Faults.BadArg =
BEGIN
  IF c.ncont >= MaxContours THEN
    RAISE Faults.BadArg ('Png: a shape of more than 65536 contours')
  END ;
  IF c.ncont = 0 OR c.cend[c.ncont - 1] < c.npts THEN
    c.cend[c.ncont] := c.npts ;
    c.ncont := c.ncont + 1
  END
END CloseContour ;

(* coverage w for the span [xa, xb) of one sub-row, into cover *)
PROCEDURE Span (VAR c: Canvas ; xa, xb, w: F64) RAISES ValueRange =
VAR
  i0, i1, i : I64 ;
  lo, hi : F64 ;
BEGIN
  IF xb <= 0.0 OR xa >= F64 (c.w) THEN RETURN END ;
  IF xa < 0.0 THEN xa := 0.0 END ;
  IF xb > F64 (c.w) THEN xb := F64 (c.w) END ;
  IF c.clipped THEN
    IF xa < c.kx0 THEN xa := c.kx0 END ;
    IF xb > c.kx1 THEN xb := c.kx1 END
  END ;
  IF xb <= xa THEN RETURN END ;
  i0 := I64 (xa) ;
  i1 := I64 (xb) ;
  IF i1 >= c.w THEN i1 := c.w - 1 END ;
  IF i0 = i1 THEN
    c.cover[i0] := c.cover[i0] + w * (xb - xa) ;
    RETURN
  END ;
  c.cover[i0] := c.cover[i0] + w * (F64 (i0 + 1) - xa) ;
  FOR i := i0 + 1 TO i1 - 1 DO c.cover[i] := c.cover[i] + w END ;
  lo := F64 (i1) ;
  hi := xb ;
  IF hi > lo THEN c.cover[i1] := c.cover[i1] + w * (hi - lo) END
END Span ;

(* the shape gathered so far, into the mask by the nonzero rule, and
   the shape forgotten.  The contours are sorted by their first row
   (a counting sort over the rows) and a row meets only the ones that
   reach it: a dashed arc at 600 dpi is thousands of small pieces,
   and every row looking at every piece was the cost. *)
PROCEDURE Flush (VAR c: Canvas) RAISES Faults.BadArg, ValueRange =
VAR
  y, x, s, k, i, j, e, first, last, ncross, wind, from, m, d, nact,
  next, r, lo, hi, q : I64 ;
  miny, maxy, minx, maxx, ys, x1, y1, x2, y2, xc, t, v : F64 ;
BEGIN
  IF c.ncont = 0 OR c.npts = 0 THEN RETURN END ;
  CloseContour (c) ;
  (* each contour's rows, clipped to the canvas; its columns widen
     the row's range *)
  minx := F64 (c.w) ; maxx := 0.0 ;
  FOR k := 0 TO c.h + 1 DO c.count[k] := 0 END ;
  first := 0 ;
  FOR i := 0 TO c.ncont - 1 DO
    last := c.cend[i] - 1 ;
    miny := c.py[first] ; maxy := miny ;
    FOR k := first TO last DO
      IF c.py[k] < miny THEN miny := c.py[k] END ;
      IF c.py[k] > maxy THEN maxy := c.py[k] END ;
      IF c.px[k] < minx THEN minx := c.px[k] END ;
      IF c.px[k] > maxx THEN maxx := c.px[k] END
    END ;
    IF c.clipped THEN
      IF miny < c.ky0 THEN miny := c.ky0 END ;
      IF maxy > c.ky1 THEN maxy := c.ky1 - 0.001 END
    END ;
    lo := I64 (miny) ;
    IF miny < 0.0 THEN lo := 0 END ;
    hi := I64 (maxy) ;
    IF maxy < 0.0 THEN hi := -1 END ;
    IF hi >= c.h THEN hi := c.h - 1 END ;
    IF lo > c.h THEN lo := c.h END ;
    c.cmin[i] := lo ;
    c.cmax[i] := hi ;
    IF hi >= lo THEN c.count[lo] := c.count[lo] + 1 END ;
    first := c.cend[i]
  END ;
  (* the contours in order of their first row *)
  q := 0 ;
  FOR k := 0 TO c.h + 1 DO
    r := c.count[k] ;
    c.count[k] := q ;
    q := q + r
  END ;
  FOR i := 0 TO c.ncont - 1 DO
    IF c.cmax[i] >= c.cmin[i] THEN
      c.order[c.count[c.cmin[i]]] := i ;
      c.count[c.cmin[i]] := c.count[c.cmin[i]] + 1
    END
  END ;
  IF minx < 0.0 THEN minx := 0.0 END ;
  IF maxx > F64 (c.w) THEN maxx := F64 (c.w) END ;
  IF q = 0 OR maxx <= minx THEN
    c.npts := 0 ; c.ncont := 0 ;
    RETURN
  END ;
  nact := 0 ;
  next := 0 ;
  y := c.cmin[c.order[0]] ;
  WHILE y < c.h AND (next < q OR nact > 0) DO
    (* the contours that begin on this row join the active ones; the
       ones that ended leave *)
    WHILE next < q AND c.cmin[c.order[next]] <= y DO
      c.active[nact] := c.order[next] ;
      nact := nact + 1 ;
      next := next + 1
    END ;
    k := 0 ;
    WHILE k < nact DO
      IF c.cmax[c.active[k]] < y THEN
        c.active[k] := c.active[nact - 1] ;
        nact := nact - 1
      ELSE
        k := k + 1
      END
    END ;
    IF nact = 0 THEN
      IF next < q THEN y := c.cmin[c.order[next]] ELSE y := c.h END
    ELSE
      FOR x := I64 (minx) TO I64 (maxx) + 1 DO c.cover[x] := 0.0 END ;
      FOR s := 0 TO Sub - 1 DO
        ys := F64 (y) + (F64 (s) + 0.5) / F64 (Sub) ;
        ncross := 0 ;
        FOR m := 0 TO nact - 1 DO
          i := c.active[m] ;
          IF i = 0 THEN first := 0 ELSE first := c.cend[i - 1] END ;
          last := c.cend[i] - 1 ;
          FOR k := first TO last DO
            x1 := c.px[k] ; y1 := c.py[k] ;
            IF k = last THEN j := first ELSE j := k + 1 END ;
            x2 := c.px[j] ; y2 := c.py[j] ;
            IF (y1 <= ys AND ys < y2) OR (y2 <= ys AND ys < y1) THEN
              t := (ys - y1) / (y2 - y1) ;
              xc := x1 + t * (x2 - x1) ;
              IF y2 > y1 THEN d := 1 ELSE d := -1 END ;
              (* in order of x: a few crossings, so the simple sort *)
              e := ncross ;
              WHILE e > 0 AND c.cx[e - 1] > xc DO
                c.cx[e] := c.cx[e - 1] ;
                c.cd[e] := c.cd[e - 1] ;
                e := e - 1
              END ;
              c.cx[e] := xc ;
              c.cd[e] := d ;
              ncross := ncross + 1
            END
          END
        END ;
        wind := 0 ;
        from := 0 ;
        FOR e := 0 TO ncross - 1 DO
          IF wind # 0 THEN Span (c, c.cx[from], c.cx[e], 1.0 / F64 (Sub)) END ;
          wind := wind + c.cd[e] ;
          from := e
        END
      END ;
      FOR x := I64 (minx) TO I64 (maxx) DO
        IF x < c.w THEN
          v := c.cover[x] ;
          IF v > 0.0 THEN
            IF v > 1.0 THEN v := 1.0 END ;
            m := I64 (v * 255.0 + 0.5) ;
            IF m > I64 (c.mask[y * c.w + x]) THEN
              c.mask[y * c.w + x] := BYTE (m)
            END ;
            IF x < c.bx0 THEN c.bx0 := x END ;
            IF x > c.bx1 THEN c.bx1 := x END ;
            IF y < c.by0 THEN c.by0 := y END ;
            IF y > c.by1 THEN c.by1 := y END
          END
        END
      END ;
      y := y + 1
    END
  END ;
  c.npts := 0 ;
  c.ncont := 0
END Flush ;

(* the mask laid on the pixels in one colour, and cleared *)
PROCEDURE Paint (VAR c: Canvas ; r, g, b: I64 ; alpha: F64)
  RAISES Faults.BadArg, ValueRange =
VAR
  x, y, k, at, m : I64 ;
  a : F64 ;
BEGIN
  Flush (c) ;
  IF c.bx1 < c.bx0 THEN RETURN END ;
  FOR y := c.by0 TO c.by1 DO
    FOR x := c.bx0 TO c.bx1 DO
      m := I64 (c.mask[y * c.w + x]) ;
      IF m > 0 THEN
        a := alpha * F64 (m) / 255.0 ;
        at := 3 * (y * c.w + x) ;
        k := I64 (c.pix[at]) ;
        c.pix[at] := BYTE (I64 (F64 (k) + (F64 (r) - F64 (k)) * a + 0.5)) ;
        k := I64 (c.pix[at + 1]) ;
        c.pix[at + 1] := BYTE (I64 (F64 (k) + (F64 (g) - F64 (k)) * a + 0.5)) ;
        k := I64 (c.pix[at + 2]) ;
        c.pix[at + 2] := BYTE (I64 (F64 (k) + (F64 (b) - F64 (k)) * a + 0.5)) ;
        c.mask[y * c.w + x] := BYTE (0)
      END
    END
  END ;
  c.bx0 := c.w ; c.by0 := c.h ; c.bx1 := -1 ; c.by1 := -1
END Paint ;

(* an axis-aligned rectangle, in pixels, straight onto the pixels:
   each pixel covered as much as the two overlap -- the background of
   a 600 dpi figure is 36 million of them, and a polygon would cost
   Sub rows for each *)
PROCEDURE RectFill (VAR c: Canvas ; x0, y0, x1, y1: F64 ; r, g, b: I64 ;
                    alpha: F64)
  RAISES ValueRange =
VAR
  x, y, at, k : I64 ;
  ox, oy, a : F64 ;
BEGIN
  IF x1 < x0 THEN ox := x0 ; x0 := x1 ; x1 := ox END ;
  IF y1 < y0 THEN oy := y0 ; y0 := y1 ; y1 := oy END ;
  IF x0 < 0.0 THEN x0 := 0.0 END ;
  IF y0 < 0.0 THEN y0 := 0.0 END ;
  IF x1 > F64 (c.w) THEN x1 := F64 (c.w) END ;
  IF y1 > F64 (c.h) THEN y1 := F64 (c.h) END ;
  IF c.clipped THEN
    IF x0 < c.kx0 THEN x0 := c.kx0 END ;
    IF y0 < c.ky0 THEN y0 := c.ky0 END ;
    IF x1 > c.kx1 THEN x1 := c.kx1 END ;
    IF y1 > c.ky1 THEN y1 := c.ky1 END
  END ;
  IF x1 <= x0 OR y1 <= y0 THEN RETURN END ;
  FOR y := I64 (y0) TO I64 (y1) DO
    IF y < c.h THEN
      oy := y1 ;
      IF F64 (y + 1) < oy THEN oy := F64 (y + 1) END ;
      IF F64 (y) > y0 THEN oy := oy - F64 (y) ELSE oy := oy - y0 END ;
      IF oy > 0.0 THEN
        FOR x := I64 (x0) TO I64 (x1) DO
          IF x < c.w THEN
            ox := x1 ;
            IF F64 (x + 1) < ox THEN ox := F64 (x + 1) END ;
            IF F64 (x) > x0 THEN ox := ox - F64 (x) ELSE ox := ox - x0 END ;
            IF ox > 0.0 THEN
              a := alpha * ox * oy ;
              at := 3 * (y * c.w + x) ;
              k := I64 (c.pix[at]) ;
              c.pix[at] := BYTE (I64 (F64 (k) + (F64 (r) - F64 (k)) * a + 0.5)) ;
              k := I64 (c.pix[at + 1]) ;
              c.pix[at + 1] := BYTE (I64 (F64 (k) + (F64 (g) - F64 (k)) * a + 0.5)) ;
              k := I64 (c.pix[at + 2]) ;
              c.pix[at + 2] := BYTE (I64 (F64 (k) + (F64 (b) - F64 (k)) * a + 0.5))
            END
          END
        END
      END
    END
  END
END RectFill ;

(* a line of some width as a quadrilateral, butt ends, pixels *)
PROCEDURE Quad (VAR c: Canvas ; x1, y1, x2, y2, wid: F64)
  RAISES Faults.BadArg, ValueRange =
VAR dx, dy, len, nx, ny : F64 ;
BEGIN
  dx := x2 - x1 ;
  dy := y2 - y1 ;
  len := Math.Sqrt (dx * dx + dy * dy) ;
  IF len <= 0.0 THEN RETURN END ;
  nx := -dy / len * wid / 2.0 ;
  ny := dx / len * wid / 2.0 ;
  Pt (c, x1 + nx, y1 + ny) ;
  Pt (c, x2 + nx, y2 + ny) ;
  Pt (c, x2 - nx, y2 - ny) ;
  Pt (c, x1 - nx, y1 - ny) ;
  CloseContour (c)
END Quad ;

(* a disc, as a polygon of as many sides as its size asks for; r < 0
   turns it the other way round, which is how a ring gets its hole *)
PROCEDURE Disc (VAR c: Canvas ; cx, cy, r: F64)
  RAISES Faults.BadArg, ValueRange =
VAR
  n, k : I64 ;
  ang, rr : F64 ;
BEGIN
  rr := r ;
  IF rr < 0.0 THEN rr := -rr END ;
  IF rr <= 0.0 THEN RETURN END ;
  n := I64 (rr * 4.2) + 12 ;
  FOR k := 0 TO n - 1 DO
    ang := 2.0 * Math.Pi * F64 (k) / F64 (n) ;
    IF r < 0.0 THEN ang := -ang END ;
    Pt (c, cx + rr * Math.Cos (ang), cy + rr * Math.Sin (ang))
  END ;
  CloseContour (c)
END Disc ;

(* a polyline stroked as ONE outline: its left side forward and its
   right side back, each corner the point where the two offset lines
   meet (a mitre), or two points when the corner is so sharp the mitre
   would run away.  One polygon, so that the pieces of a curve meet
   without a seam -- as separate quads they left a gap of coverage at
   every joint, and a quarter arc came out at sixty percent of its
   area.  A closed polyline is two loops, the inner one the other way
   round, which the nonzero rule reads as a ring.  Butt ends. *)
PROCEDURE Outline (VAR c: Canvas ; RO xs, ys: SLICE OF F64 ; n: I64 ;
                   hw: F64 ; closed: BOOL)
  RAISES Faults.BadArg, ValueRange =
VAR
  i, m, k, prev, next, pass : I64 ;
  ux, uy, vx, vy, len, nix, niy, nox, noy, dot, f, side : F64 ;
BEGIN
  (* the points, a repeated one dropped: a corner between equal points
     has no direction *)
  m := 0 ;
  FOR i := 0 TO n - 1 DO
    IF m = 0 OR xs[i] # c.tx[m - 1] OR ys[i] # c.ty[m - 1] THEN
      c.tx[m] := xs[i] ;
      c.ty[m] := ys[i] ;
      m := m + 1
    END
  END ;
  IF closed AND m > 1 AND c.tx[0] = c.tx[m - 1] AND c.ty[0] = c.ty[m - 1] THEN
    m := m - 1
  END ;
  IF m < 2 THEN RETURN END ;
  FOR pass := 0 TO 1 DO
    side := 1.0 - 2.0 * F64 (pass) ;
    FOR k := 0 TO m - 1 DO
      (* the left side runs forward, the right side back *)
      IF side > 0.0 THEN i := k ELSE i := m - 1 - k END ;
      prev := i - 1 ;
      next := i + 1 ;
      IF closed THEN
        IF prev < 0 THEN prev := m - 1 END ;
        IF next >= m THEN next := 0 END
      END ;
      (* the normals of the piece in and the piece out *)
      nix := 0.0 ; niy := 0.0 ; nox := 0.0 ; noy := 0.0 ;
      IF prev >= 0 THEN
        ux := c.tx[i] - c.tx[prev] ;
        uy := c.ty[i] - c.ty[prev] ;
        len := Math.Sqrt (ux * ux + uy * uy) ;
        nix := -uy / len ;
        niy := ux / len
      END ;
      IF next < m THEN
        vx := c.tx[next] - c.tx[i] ;
        vy := c.ty[next] - c.ty[i] ;
        len := Math.Sqrt (vx * vx + vy * vy) ;
        nox := -vy / len ;
        noy := vx / len
      END ;
      IF prev < 0 THEN
        Pt (c, c.tx[i] + side * hw * nox, c.ty[i] + side * hw * noy)
      ELSIF next >= m THEN
        Pt (c, c.tx[i] + side * hw * nix, c.ty[i] + side * hw * niy)
      ELSE
        dot := nix * nox + niy * noy ;
        IF dot > -0.9 THEN
          (* the mitre: where the two offset lines meet *)
          f := hw / (1.0 + dot) ;
          Pt (c, c.tx[i] + side * f * (nix + nox), c.ty[i] + side * f * (niy + noy))
        ELSE
          (* too sharp: one point on each piece's own offset line *)
          IF side > 0.0 THEN
            Pt (c, c.tx[i] + hw * nix, c.ty[i] + hw * niy) ;
            Pt (c, c.tx[i] + hw * nox, c.ty[i] + hw * noy)
          ELSE
            Pt (c, c.tx[i] - hw * nox, c.ty[i] - hw * noy) ;
            Pt (c, c.tx[i] - hw * nix, c.ty[i] - hw * niy)
          END
        END
      END
    END ;
    IF closed THEN CloseContour (c) END
  END ;
  IF NOT closed THEN CloseContour (c) END
END Outline ;

(* the polyline in c.lx, c.ly stroked, the dashes walked along it
   (dash in pixels, on and off in turn; the phase carried from piece
   to piece): each run of ink is an outline of its own *)
PROCEDURE StrokeLine (VAR c: Canvas ; wid: F64 ; RO dash: SLICE OF F64 ;
                      closed: BOOL)
  RAISES Faults.BadArg, ValueRange =
VAR
  i, n, m, di, nr : I64 ;
  x1, y1, x2, y2, len, left, step, t0, t1, ux, uy : F64 ;
  on : BOOL ;
BEGIN
  n := c.nl ;
  IF n < 2 THEN RETURN END ;
  IF LEN (dash) = 0 THEN
    Outline (c, c.lx, c.ly, n, wid / 2.0, closed) ;
    RETURN
  END ;
  m := n - 1 ;
  IF closed THEN m := n END ;
  di := 0 ;
  on := TRUE ;
  left := dash[0] ;
  nr := 0 ;
  FOR i := 0 TO m - 1 DO
    x1 := c.lx[i] ; y1 := c.ly[i] ;
    IF i + 1 < n THEN x2 := c.lx[i + 1] ; y2 := c.ly[i + 1]
    ELSE x2 := c.lx[0] ; y2 := c.ly[0] END ;
    len := Math.Sqrt ((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1)) ;
    IF len > 0.0 THEN
      ux := (x2 - x1) / len ;
      uy := (y2 - y1) / len ;
      IF on AND nr = 0 THEN
        c.rx[0] := x1 ; c.ry[0] := y1 ; nr := 1
      END ;
      t0 := 0.0 ;
      WHILE t0 < len DO
        step := left ;
        IF t0 + step > len THEN step := len - t0 END ;
        t1 := t0 + step ;
        IF on THEN
          c.rx[nr] := x1 + ux * t1 ;
          c.ry[nr] := y1 + uy * t1 ;
          nr := nr + 1
        END ;
        left := left - step ;
        IF left <= 0.0 THEN
          di := (di + 1) MOD LEN (dash) ;
          left := dash[di] ;
          IF left <= 0.0 THEN left := 0.01 END ;
          IF on THEN
            (* a run of ink ends here: drawn *)
            Outline (c, c.rx, c.ry, nr, wid / 2.0, FALSE) ;
            nr := 0
          ELSIF t1 < len THEN
            c.rx[0] := x1 + ux * t1 ;
            c.ry[0] := y1 + uy * t1 ;
            nr := 1
          END ;
          on := NOT on
        END ;
        t0 := t1
      END
    END
  END ;
  IF on AND nr > 1 THEN Outline (c, c.rx, c.ry, nr, wid / 2.0, FALSE) END
END StrokeLine ;

(* the subpath in c.lx, c.ly as one contour of the shape *)
PROCEDURE FillLine (VAR c: Canvas) RAISES Faults.BadArg =
VAR i : I64 ;
BEGIN
  IF c.nl < 3 THEN RETURN END ;
  FOR i := 0 TO c.nl - 1 DO Pt (c, c.lx[i], c.ly[i]) END ;
  CloseContour (c)
END FillLine ;

PROCEDURE LinePt (VAR c: Canvas ; x, y: F64) RAISES Faults.BadArg =
BEGIN
  IF c.nl >= MaxPts THEN
    RAISE Faults.BadArg ('Png: a path of more than 262144 points')
  END ;
  c.lx[c.nl] := x ;
  c.ly[c.nl] := y ;
  c.nl := c.nl + 1
END LinePt ;

(* an SVG arc from the current point to (x2, y2), in user units, as
   pieces of the current subpath: the centre from the ends as the
   specification's appendix F.6.5 has it, the radii grown when they
   are too small for the ends, and about 1.5 pixels to a piece *)
PROCEDURE ArcTo (VAR c: Canvas ; rx, ry, rotDeg: F64 ; large, sweep: BOOL ;
                 x2, y2: F64)
  RAISES Faults.BadArg, ValueRange =
VAR
  x1, y1, phi, cp, sp, dx, dy, x1p, y1p, lam, num, den, root, cxp, cyp,
  cx, cy, th1, dth, ux, uy, vx, vy, dot, ang, t, ex, ey : F64 ;
  n, k : I64 ;
BEGIN
  IF c.nl = 0 THEN RAISE Faults.BadArg ('Png: an arc before any point of its path') END ;
  x1 := (c.lx[c.nl - 1] - c.ox) / c.sc ;
  y1 := (c.ly[c.nl - 1] - c.oy) / c.sc ;
  IF rx < 0.0 THEN rx := -rx END ;
  IF ry < 0.0 THEN ry := -ry END ;
  IF rx = 0.0 OR ry = 0.0 OR (x1 = x2 AND y1 = y2) THEN
    LinePt (c, PX (c, x2), PY (c, y2)) ;
    RETURN
  END ;
  phi := rotDeg * Math.Pi / 180.0 ;
  cp := Math.Cos (phi) ;
  sp := Math.Sin (phi) ;
  dx := (x1 - x2) / 2.0 ;
  dy := (y1 - y2) / 2.0 ;
  x1p := cp * dx + sp * dy ;
  y1p := -sp * dx + cp * dy ;
  lam := (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry) ;
  IF lam > 1.0 THEN
    root := Math.Sqrt (lam) ;
    rx := rx * root ;
    ry := ry * root
  END ;
  num := rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p ;
  den := rx * rx * y1p * y1p + ry * ry * x1p * x1p ;
  IF num < 0.0 THEN num := 0.0 END ;
  root := Math.Sqrt (num / den) ;
  IF large = sweep THEN root := -root END ;
  cxp := root * rx * y1p / ry ;
  cyp := -root * ry * x1p / rx ;
  cx := cp * cxp - sp * cyp + (x1 + x2) / 2.0 ;
  cy := sp * cxp + cp * cyp + (y1 + y2) / 2.0 ;
  ux := (x1p - cxp) / rx ;
  uy := (y1p - cyp) / ry ;
  vx := (-x1p - cxp) / rx ;
  vy := (-y1p - cyp) / ry ;
  th1 := Math.Atan2 (uy, ux) ;
  dot := ux * vx + uy * vy ;
  t := Math.Sqrt ((ux * ux + uy * uy) * (vx * vx + vy * vy)) ;
  IF t > 0.0 THEN dot := dot / t END ;
  IF dot > 1.0 THEN dot := 1.0 END ;
  IF dot < -1.0 THEN dot := -1.0 END ;
  dth := Math.Acos (dot) ;
  IF ux * vy - uy * vx < 0.0 THEN dth := -dth END ;
  IF sweep AND dth < 0.0 THEN dth := dth + 2.0 * Math.Pi END ;
  IF NOT sweep AND dth > 0.0 THEN dth := dth - 2.0 * Math.Pi END ;
  t := rx ;
  IF ry > t THEN t := ry END ;
  n := I64 (dth * t * c.sc / 2.5) ;
  IF n < 0 THEN n := -n END ;
  IF n < 4 THEN n := 4 END ;
  FOR k := 1 TO n DO
    ang := th1 + dth * F64 (k) / F64 (n) ;
    ex := rx * Math.Cos (ang) ;
    ey := ry * Math.Sin (ang) ;
    LinePt (c, PX (c, cx + cp * ex - sp * ey), PY (c, cy + sp * ex + cp * ey))
  END
END ArcTo ;

(* ---- the font ---- *)

PROCEDURE Glyph (code: I64) : I64 =
VAR lo, hi, mid : I64 ;
BEGIN
  IF code >= FontFirst AND code < FontFirst + LEN (FontAt) THEN
    RETURN FontAt[code - FontFirst]
  END ;
  lo := 0 ;
  hi := LEN (FontMore) ;
  WHILE lo < hi DO
    mid := (lo + hi) DIV 2 ;
    IF FontMore[mid] < code THEN lo := mid + 1 ELSE hi := mid END
  END ;
  IF lo < LEN (FontMore) AND FontMore[lo] = code THEN RETURN FontMoreAt[lo] END ;
  RETURN -1
END Glyph ;

(* the glyph of a code, or the question mark's for one the face has
   not *)
PROCEDURE GlyphOrAsk (code: I64) : I64 =
VAR g : I64 ;
BEGIN
  g := Glyph (code) ;
  IF g < 0 THEN g := Glyph (63) END ;
  RETURN g
END GlyphOrAsk ;

(* the width of a text in font units *)
PROCEDURE TextWidth (RO s: STR) : I64 RAISES ValueRange =
VAR i, w : I64 ;
BEGIN
  w := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    w := w + FontData[GlyphOrAsk (I64 (s[i]))]
  END ;
  RETURN w
END TextWidth ;

(* the text as polygons: its origin at (x, y) in pixels, `size` pixels
   to the em, the pen moved left by `anchor` -- 0, half or all of the
   width -- then the whole turned by deg degrees about (rx, ry) *)
PROCEDURE DrawText (VAR c: Canvas ; RO s: STR ; x, y, size, anchor, deg,
                    rx, ry: F64)
  RAISES Faults.BadArg, ValueRange =
VAR
  i, g, nc, k, np, q, at : I64 ;
  scale, pen, gx, gy, lx, ly, ca, sa, ddx, ddy : F64 ;
BEGIN
  scale := size / F64 (FontEm) ;
  pen := x - anchor * F64 (TextWidth (s)) * scale ;
  ca := Math.Cos (deg * Math.Pi / 180.0) ;
  sa := Math.Sin (deg * Math.Pi / 180.0) ;
  FOR i := 0 TO LEN (s) - 1 DO
    g := GlyphOrAsk (I64 (s[i])) ;
    nc := FontData[g + 1] ;
    at := g + 2 ;
    FOR k := 0 TO nc - 1 DO
      np := FontData[at] ;
      at := at + 1 ;
      FOR q := 0 TO np - 1 DO
        gx := F64 (FontData[at]) ;
        gy := F64 (FontData[at + 1]) ;
        at := at + 2 ;
        lx := pen + gx * scale ;
        ly := y - gy * scale ;
        IF deg # 0.0 THEN
          ddx := lx - rx ;
          ddy := ly - ry ;
          lx := rx + ddx * ca - ddy * sa ;
          ly := ry + ddx * sa + ddy * ca
        END ;
        Pt (c, lx, ly)
      END ;
      CloseContour (c)
    END ;
    pen := pen + F64 (FontData[g]) * scale
  END
END DrawText ;

(* ---- reading the SVG ---- *)

TYPE
  Tag = RECORD
    name : STR ;
    an, av : ARRAY 48 OF STR ;
    nattr : I64 ;
    closing, selfClosing : BOOL ;
    endAt : I64 ;                         (* just after the '>' *)
  END ;

PROCEDURE IsBlank (ch: CHAR) : BOOL RAISES ValueRange =
BEGIN
  RETURN ch = ' ' OR I64 (ch) = 10 OR I64 (ch) = 13 OR I64 (ch) = 9
END IsBlank ;

PROCEDURE IsNameCh (ch: CHAR) : BOOL =
BEGIN
  RETURN (ch >= 'a' AND ch <= 'z') OR (ch >= 'A' AND ch <= 'Z')
         OR (ch >= '0' AND ch <= '9') OR ch = '-' OR ch = ':' OR ch = '_'
END IsNameCh ;

PROCEDURE Same (RO a: STR ; RO b: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF a[i] # b[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END Same ;

(* the next tag from position i: FALSE at the end of the document.
   Comments, the XML declaration and a DOCTYPE are passed over. *)
PROCEDURE NextTag (RO s: STR ; VAR i: I64 ; VAR tg: Tag) : BOOL
  RAISES Faults.BadArg, ValueRange =
VAR
  n, a, b : I64 ;
  quote : CHAR ;
BEGIN
  n := LEN (s) ;
  LOOP
    WHILE i < n AND s[i] # '<' DO i := i + 1 END ;
    IF i >= n THEN RETURN FALSE END ;
    IF i + 3 < n AND s[i + 1] = '!' AND s[i + 2] = '-' AND s[i + 3] = '-' THEN
      i := i + 4 ;
      WHILE i + 2 < n AND NOT (s[i] = '-' AND s[i + 1] = '-' AND s[i + 2] = '>') DO
        i := i + 1
      END ;
      i := i + 3
    ELSIF i + 1 < n AND (s[i + 1] = '?' OR s[i + 1] = '!') THEN
      WHILE i < n AND s[i] # '>' DO i := i + 1 END ;
      i := i + 1
    ELSE
      EXIT
    END
  END ;
  i := i + 1 ;
  tg.closing := FALSE ;
  tg.selfClosing := FALSE ;
  tg.nattr := 0 ;
  IF i < n AND s[i] = '/' THEN
    tg.closing := TRUE ;
    i := i + 1
  END ;
  a := i ;
  WHILE i < n AND IsNameCh (s[i]) DO i := i + 1 END ;
  tg.name := SLICE (s, a, i - a) ;
  LOOP
    WHILE i < n AND IsBlank (s[i]) DO i := i + 1 END ;
    IF i >= n THEN RAISE Faults.BadArg ('Png.FromSvg: the SVG ends inside a tag') END ;
    IF s[i] = '>' THEN
      i := i + 1 ;
      EXIT
    END ;
    IF s[i] = '/' THEN
      tg.selfClosing := TRUE ;
      i := i + 1
    ELSE
      a := i ;
      WHILE i < n AND IsNameCh (s[i]) DO i := i + 1 END ;
      IF i = a THEN RAISE Faults.BadArg ('Png.FromSvg: a tag this cannot read') END ;
      IF tg.nattr >= MaxAttrs THEN
        RAISE Faults.BadArg ('Png.FromSvg: a tag of more than 48 attributes')
      END ;
      tg.an[tg.nattr] := SLICE (s, a, i - a) ;
      tg.av[tg.nattr] := '' ;
      WHILE i < n AND IsBlank (s[i]) DO i := i + 1 END ;
      IF i < n AND s[i] = '=' THEN
        i := i + 1 ;
        WHILE i < n AND IsBlank (s[i]) DO i := i + 1 END ;
        IF i >= n OR (s[i] # '"' AND s[i] # "'") THEN
          RAISE Faults.BadArg ('Png.FromSvg: an attribute value without quotes')
        END ;
        quote := s[i] ;
        i := i + 1 ;
        b := i ;
        WHILE i < n AND s[i] # quote DO i := i + 1 END ;
        IF i >= n THEN RAISE Faults.BadArg ('Png.FromSvg: an attribute value without its closing quote') END ;
        tg.av[tg.nattr] := SLICE (s, b, i - b) ;
        i := i + 1
      END ;
      tg.nattr := tg.nattr + 1
    END
  END ;
  tg.endAt := i ;
  RETURN TRUE
END NextTag ;

PROCEDURE Has (RO tg: Tag ; RO name: STR) : BOOL =
VAR k : I64 ;
BEGIN
  FOR k := 0 TO tg.nattr - 1 DO
    IF Same (tg.an[k], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Has ;

PROCEDURE Attr (RO tg: Tag ; RO name: STR) : STR =
VAR k : I64 ;
BEGIN
  FOR k := 0 TO tg.nattr - 1 DO
    IF Same (tg.an[k], name) THEN RETURN tg.av[k] END
  END ;
  RETURN ''
END Attr ;

(* a number at s[i], after blanks and one comma; FALSE when there is
   none.  Digits, a point, an exponent -- what SVG writes; a unit
   after it (px, pt) is passed over. *)
PROCEDURE Num (RO s: STR ; VAR i: I64 ; VAR v: F64) : BOOL RAISES ValueRange =
VAR
  n, digits, k : I64 ;
  neg, eneg : BOOL ;
  f, frac, e : F64 ;
BEGIN
  n := LEN (s) ;
  WHILE i < n AND (IsBlank (s[i]) OR s[i] = ',') DO i := i + 1 END ;
  IF i >= n THEN RETURN FALSE END ;
  neg := FALSE ;
  IF s[i] = '-' THEN neg := TRUE ; i := i + 1
  ELSIF s[i] = '+' THEN i := i + 1 END ;
  f := 0.0 ;
  digits := 0 ;
  WHILE i < n AND s[i] >= '0' AND s[i] <= '9' DO
    f := f * 10.0 + F64 (I64 (s[i]) - 48) ;
    i := i + 1 ;
    digits := digits + 1
  END ;
  IF i < n AND s[i] = '.' THEN
    i := i + 1 ;
    frac := 0.1 ;
    WHILE i < n AND s[i] >= '0' AND s[i] <= '9' DO
      f := f + frac * F64 (I64 (s[i]) - 48) ;
      frac := frac / 10.0 ;
      i := i + 1 ;
      digits := digits + 1
    END
  END ;
  IF digits = 0 THEN RETURN FALSE END ;
  IF i < n AND (s[i] = 'e' OR s[i] = 'E') THEN
    k := i + 1 ;
    eneg := FALSE ;
    IF k < n AND s[k] = '-' THEN eneg := TRUE ; k := k + 1
    ELSIF k < n AND s[k] = '+' THEN k := k + 1 END ;
    IF k < n AND s[k] >= '0' AND s[k] <= '9' THEN
      e := 0.0 ;
      WHILE k < n AND s[k] >= '0' AND s[k] <= '9' DO
        e := e * 10.0 + F64 (I64 (s[k]) - 48) ;
        k := k + 1
      END ;
      IF eneg THEN e := -e END ;
      f := f * Math.Pow (10.0, e) ;
      i := k
    END
  END ;
  IF i + 1 < n AND ((s[i] = 'p' AND (s[i + 1] = 'x' OR s[i + 1] = 't'))) THEN
    i := i + 2
  END ;
  IF neg THEN f := -f END ;
  v := f ;
  RETURN TRUE
END Num ;

(* an attribute as a number, or dflt when it is not there *)
PROCEDURE NumAttr (RO tg: Tag ; RO name: STR ; dflt: F64) : F64
  RAISES Faults.BadArg, ValueRange =
VAR
  s : STR ;
  i : I64 ;
  v : F64 ;
BEGIN
  IF NOT Has (tg, name) THEN RETURN dflt END ;
  s := Attr (tg, name) ;
  i := 0 ;
  v := 0.0 ;
  IF NOT Num (s, i, v) THEN
    RAISE Faults.BadArg ('Png.FromSvg: an attribute that is not a number: ' + name)
  END ;
  RETURN v
END NumAttr ;

PROCEDURE HexDigit (ch: CHAR) : I64 RAISES ValueRange =
BEGIN
  IF ch >= '0' AND ch <= '9' THEN RETURN I64 (ch) - 48 END ;
  IF ch >= 'a' AND ch <= 'f' THEN RETURN I64 (ch) - 87 END ;
  IF ch >= 'A' AND ch <= 'F' THEN RETURN I64 (ch) - 55 END ;
  RETURN -1
END HexDigit ;

CONST
  ColourNames = ['black', 'white', 'red', 'green', 'blue', 'gray', 'grey',
                 'silver', 'orange', 'yellow', 'purple', 'brown',
                 'darkgreen', 'darkblue', 'darkred', 'cyan', 'magenta',
                 'lightgray', 'lightgrey', 'navy', 'teal', 'maroon',
                 'olive', 'lime', 'gold', 'pink', 'darkgray', 'darkgrey',
                 'steelblue', 'crimson'] ;
  ColourValues = [0, 16777215, 16711680, 32768, 255, 8421504, 8421504,
                  12632256, 16753920, 16776960, 8388736, 10824234,
                  25600, 139, 9109504, 65535, 16711935,
                  13882323, 13882323, 128, 32896, 8388608,
                  8421376, 65280, 16766720, 16761035, 11119017, 11119017,
                  4620980, 14423100] ;

(* a colour as SVG writes one: #rgb, #rrggbb, or a name; FALSE for
   `none' and for nothing *)
PROCEDURE Colour (RO s: STR ; VAR r, g, b: I64) : BOOL RAISES Faults.BadArg, ValueRange =
VAR k, v, d : I64 ;
BEGIN
  IF LEN (s) = 0 OR Same (s, 'none') OR Same (s, 'transparent') THEN RETURN FALSE END ;
  IF s[0] = '#' THEN
    v := 0 ;
    FOR k := 1 TO LEN (s) - 1 DO
      d := HexDigit (s[k]) ;
      IF d < 0 THEN RAISE Faults.BadArg ('Png.FromSvg: a colour this cannot read: ' + s) END ;
      v := v * 16 + d
    END ;
    IF LEN (s) = 4 THEN
      r := (v DIV 256) * 17 ;
      g := ((v DIV 16) MOD 16) * 17 ;
      b := (v MOD 16) * 17 ;
      RETURN TRUE
    END ;
    IF LEN (s) = 7 THEN
      r := v DIV 65536 ;
      g := (v DIV 256) MOD 256 ;
      b := v MOD 256 ;
      RETURN TRUE
    END ;
    RAISE Faults.BadArg ('Png.FromSvg: a colour this cannot read: ' + s)
  END ;
  FOR k := 0 TO LEN (ColourNames) - 1 DO
    IF Same (s, ColourNames[k]) THEN
      v := ColourValues[k] ;
      r := v DIV 65536 ;
      g := (v DIV 256) MOD 256 ;
      b := v MOD 256 ;
      RETURN TRUE
    END
  END ;
  RAISE Faults.BadArg ('Png.FromSvg: a colour this does not know: ' + s)
END Colour ;

(* the dashes of a stroke, in pixels: the attribute's numbers, each
   times the scale; an odd count is written twice, as SVG reads it *)
PROCEDURE Dashes (VAR pool: POOL ; RO s: STR ; sc: F64) : SLICE OF F64
  RAISES ValueRange =
VAR
  out : SLICE OF F64 ;
  i, n, k : I64 ;
  v : F64 ;
BEGIN
  n := 0 ;
  i := 0 ;
  v := 0.0 ;
  WHILE Num (s, i, v) DO n := n + 1 END ;
  IF n = 0 OR Same (s, 'none') THEN RETURN NEW (pool, F64, 0) END ;
  IF n MOD 2 = 1 THEN out := NEW (pool, F64, 2 * n) ELSE out := NEW (pool, F64, n) END ;
  i := 0 ;
  k := 0 ;
  WHILE Num (s, i, v) DO
    out[k] := v * sc ;
    IF n MOD 2 = 1 THEN out[k + n] := v * sc END ;
    k := k + 1
  END ;
  RETURN out
END Dashes ;

(* the text between a <text> tag and its </text>, its entities read:
   the five named ones and the numbered form *)
PROCEDURE Content (VAR pool: POOL ; RO s: STR ; from: I64 ; VAR after: I64) : STR
  RAISES Faults.BadArg, ValueRange =
VAR
  d : PTR DynStr.DString IN pool ;
  i, n, j, k, code : I64 ;
  ent : STR ;
BEGIN
  d := DynStr.New (pool) ;
  n := LEN (s) ;
  i := from ;
  WHILE i < n AND s[i] # '<' DO
    IF s[i] = '&' THEN
      j := i + 1 ;
      WHILE j < n AND s[j] # ';' AND j < i + 12 DO j := j + 1 END ;
      IF j >= n OR s[j] # ';' THEN RAISE Faults.BadArg ('Png.FromSvg: an & that is not an entity') END ;
      ent := SLICE (s, i + 1, j - i - 1) ;
      IF Same (ent, 'amp') THEN DynStr.AppendChar (d, '&')
      ELSIF Same (ent, 'lt') THEN DynStr.AppendChar (d, '<')
      ELSIF Same (ent, 'gt') THEN DynStr.AppendChar (d, '>')
      ELSIF Same (ent, 'quot') THEN DynStr.AppendChar (d, '"')
      ELSIF Same (ent, 'apos') THEN DynStr.AppendChar (d, "'")
      ELSIF LEN (ent) > 1 AND ent[0] = '#' THEN
        code := 0 ;
        IF ent[1] = 'x' THEN
          FOR k := 2 TO LEN (ent) - 1 DO code := code * 16 + HexDigit (ent[k]) END
        ELSE
          FOR k := 1 TO LEN (ent) - 1 DO code := code * 10 + I64 (ent[k]) - 48 END
        END ;
        IF code <= 0 OR code > 1114111 THEN
          RAISE Faults.BadArg ('Png.FromSvg: a character reference out of range')
        END ;
        DynStr.AppendChar (d, CHR (code))
      ELSE
        RAISE Faults.BadArg ('Png.FromSvg: an entity this does not know: &' + ent + ';')
      END ;
      i := j + 1
    ELSE
      DynStr.AppendChar (d, s[i]) ;
      i := i + 1
    END
  END ;
  after := i ;
  RETURN DynStr.View (d)
END Content ;

(* the attributes every drawn element may carry, read once *)
TYPE
  Style = RECORD
    fill, stroke : BOOL ;
    fr, fg, fb, sr, sg, sb : I64 ;
    width, opacity, fillOpacity, strokeOpacity : F64 ;
    dash : SLICE OF F64 ;
  END ;

PROCEDURE Hidden (RO tg: Tag) : BOOL =
BEGIN
  RETURN Same (Attr (tg, 'visibility'), 'hidden') OR Same (Attr (tg, 'display'), 'none')
END Hidden ;

PROCEDURE ReadStyle (VAR pool: POOL ; RO tg: Tag ; sc: F64 ;
                     fillByDefault: BOOL ; VAR st: Style)
  RAISES Faults.BadArg, ValueRange =
VAR k : I64 ;
BEGIN
  FOR k := 0 TO tg.nattr - 1 DO
    IF Same (tg.an[k], 'style') THEN
      RAISE Faults.BadArg ('Png.FromSvg: CSS (a style attribute) is not read; write the attributes themselves')
    END
  END ;
  st.fr := 0 ; st.fg := 0 ; st.fb := 0 ;
  st.sr := 0 ; st.sg := 0 ; st.sb := 0 ;
  IF Has (tg, 'fill') THEN
    st.fill := Colour (Attr (tg, 'fill'), st.fr, st.fg, st.fb)
  ELSE
    st.fill := fillByDefault
  END ;
  st.stroke := Colour (Attr (tg, 'stroke'), st.sr, st.sg, st.sb) ;
  st.width := NumAttr (tg, 'stroke-width', 1.0) * sc ;
  st.opacity := NumAttr (tg, 'opacity', 1.0) ;
  st.fillOpacity := NumAttr (tg, 'fill-opacity', 1.0) * st.opacity ;
  st.strokeOpacity := NumAttr (tg, 'stroke-opacity', 1.0) * st.opacity ;
  st.dash := Dashes (pool, Attr (tg, 'stroke-dasharray'), sc)
END ReadStyle ;

(* the shape gathered in the canvas, filled and stroked as the style
   says; the stroke is the subpath in lx, ly *)
PROCEDURE PaintFill (VAR c: Canvas ; RO st: Style) RAISES Faults.BadArg, ValueRange =
BEGIN
  IF st.fill THEN
    Paint (c, st.fr, st.fg, st.fb, st.fillOpacity)
  ELSE
    Flush (c) ;
    c.bx0 := c.w ; c.by0 := c.h ; c.bx1 := -1 ; c.by1 := -1 ;
    Paint (c, 0, 0, 0, 0.0)
  END
END PaintFill ;

(* `rotate(a)' or `rotate(a x y)': the angle and its centre, which is
   (x0, y0) when none is written.  Anything else is refused. *)
PROCEDURE Rotation (RO s: STR ; x0, y0: F64 ; VAR deg, rx, ry: F64)
  RAISES Faults.BadArg, ValueRange =
VAR i : I64 ;
BEGIN
  deg := 0.0 ; rx := x0 ; ry := y0 ;
  IF LEN (s) = 0 THEN RETURN END ;
  i := 0 ;
  WHILE i < LEN (s) AND IsBlank (s[i]) DO i := i + 1 END ;
  IF LEN (s) - i < 8 OR NOT Same (SLICE (s, i, 7), 'rotate(') THEN
    RAISE Faults.BadArg ('Png.FromSvg: a transform other than rotate(...): ' + s)
  END ;
  i := i + 7 ;
  IF NOT Num (s, i, deg) THEN RAISE Faults.BadArg ('Png.FromSvg: rotate without an angle') END ;
  IF Num (s, i, rx) THEN
    IF NOT Num (s, i, ry) THEN RAISE Faults.BadArg ('Png.FromSvg: rotate with a centre of one number') END
  END
END Rotation ;

(* a path's d attribute, drawn: M L H V Z and A, absolute and
   relative; a curve (C S Q T) is refused by its letter *)
PROCEDURE DrawPath (VAR c: Canvas ; RO d: STR ; RO st: Style)
  RAISES Faults.BadArg, ValueRange =
VAR
  i, n : I64 ;
  cmd : CHAR ;
  x, y, sx, sy, a, b, rx, ry, rot, fa, fs : F64 ;
  rel, closed, haveCmd : BOOL ;
BEGIN
  n := LEN (d) ;
  i := 0 ;
  x := 0.0 ; y := 0.0 ; sx := 0.0 ; sy := 0.0 ;
  a := 0.0 ; b := 0.0 ; rx := 0.0 ; ry := 0.0 ; rot := 0.0 ; fa := 0.0 ; fs := 0.0 ;
  cmd := 'M' ;
  rel := FALSE ;
  closed := FALSE ;
  haveCmd := FALSE ;
  c.nl := 0 ;
  LOOP
    WHILE i < n AND (IsBlank (d[i]) OR d[i] = ',') DO i := i + 1 END ;
    IF i >= n THEN EXIT END ;
    IF (d[i] >= 'A' AND d[i] <= 'Z') OR (d[i] >= 'a' AND d[i] <= 'z') THEN
      cmd := d[i] ;
      rel := d[i] >= 'a' ;
      IF rel THEN cmd := CHR (I64 (cmd) - 32) END ;
      IF cmd # 'M' AND cmd # 'L' AND cmd # 'H' AND cmd # 'V' AND cmd # 'Z' AND cmd # 'A' THEN
        RAISE Faults.BadArg ('Png.FromSvg: a path command this does not draw: ' + SLICE (d, i, 1))
      END ;
      i := i + 1 ;
      haveCmd := TRUE ;
      IF cmd = 'Z' THEN
        IF c.nl > 0 THEN
          IF st.fill THEN FillLine (c) END ;
          IF st.stroke THEN StrokeLine (c, st.width, st.dash, TRUE) END ;
          c.nl := 0 ;
          x := sx ; y := sy ;
          LinePt (c, PX (c, x), PY (c, y))
        END ;
        closed := TRUE
      END
    ELSIF NOT haveCmd THEN
      RAISE Faults.BadArg ('Png.FromSvg: a path that begins without a command')
    ELSE
      IF cmd = 'M' THEN
        IF NOT Num (d, i, a) OR NOT Num (d, i, b) THEN RAISE Faults.BadArg ('Png.FromSvg: M wants two numbers') END ;
        IF rel THEN a := a + x ; b := b + y END ;
        (* a new subpath: the one before is drawn *)
        IF c.nl > 1 THEN
          IF st.fill THEN FillLine (c) END ;
          IF st.stroke THEN StrokeLine (c, st.width, st.dash, FALSE) END
        END ;
        c.nl := 0 ;
        x := a ; y := b ; sx := a ; sy := b ;
        LinePt (c, PX (c, x), PY (c, y)) ;
        cmd := 'L'                      (* numbers that follow are lines *)
      ELSIF cmd = 'L' THEN
        IF NOT Num (d, i, a) OR NOT Num (d, i, b) THEN RAISE Faults.BadArg ('Png.FromSvg: L wants two numbers') END ;
        IF rel THEN a := a + x ; b := b + y END ;
        x := a ; y := b ;
        LinePt (c, PX (c, x), PY (c, y))
      ELSIF cmd = 'H' THEN
        IF NOT Num (d, i, a) THEN RAISE Faults.BadArg ('Png.FromSvg: H wants a number') END ;
        IF rel THEN a := a + x END ;
        x := a ;
        LinePt (c, PX (c, x), PY (c, y))
      ELSIF cmd = 'V' THEN
        IF NOT Num (d, i, b) THEN RAISE Faults.BadArg ('Png.FromSvg: V wants a number') END ;
        IF rel THEN b := b + y END ;
        y := b ;
        LinePt (c, PX (c, x), PY (c, y))
      ELSIF cmd = 'A' THEN
        IF NOT (Num (d, i, rx) AND Num (d, i, ry) AND Num (d, i, rot)
                AND Num (d, i, fa) AND Num (d, i, fs) AND Num (d, i, a)
                AND Num (d, i, b)) THEN
          RAISE Faults.BadArg ('Png.FromSvg: A wants seven numbers')
        END ;
        IF rel THEN a := a + x ; b := b + y END ;
        ArcTo (c, rx, ry, rot, fa # 0.0, fs # 0.0, a, b) ;
        x := a ; y := b
      END
    END
  END ;
  IF c.nl > 1 THEN
    IF st.fill THEN FillLine (c) END ;
    IF st.stroke THEN StrokeLine (c, st.width, st.dash, FALSE) END
  END ;
  c.nl := 0
END DrawPath ;

(* a polyline's or polygon's points attribute *)
PROCEDURE DrawPoints (VAR c: Canvas ; RO pts: STR ; RO st: Style ; closed: BOOL)
  RAISES Faults.BadArg, ValueRange =
VAR
  i : I64 ;
  a, b : F64 ;
BEGIN
  c.nl := 0 ;
  i := 0 ;
  a := 0.0 ; b := 0.0 ;
  WHILE Num (pts, i, a) DO
    IF NOT Num (pts, i, b) THEN RAISE Faults.BadArg ('Png.FromSvg: points with an odd count') END ;
    LinePt (c, PX (c, a), PY (c, b))
  END ;
  IF st.fill THEN FillLine (c) END ;
  IF st.stroke THEN StrokeLine (c, st.width, st.dash, closed) END ;
  c.nl := 0
END DrawPoints ;

(* the stroke gathered, painted; then the shape is empty again *)
PROCEDURE PaintStroke (VAR c: Canvas ; RO st: Style) RAISES Faults.BadArg, ValueRange =
BEGIN
  IF st.stroke THEN Paint (c, st.sr, st.sg, st.sb, st.strokeOpacity) ELSE Flush (c) END
END PaintStroke ;

(* a group's transform: translate(a b) and scale(k), any number of
   them in a row, applied in the order written -- the first named is
   the outermost.  Anything else is refused. *)
PROCEDURE Transform (RO s: STR ; VAR c: Canvas)
  RAISES Faults.BadArg, ValueRange =
VAR
  i, n : I64 ;
  a, b : F64 ;
BEGIN
  n := LEN (s) ;
  i := 0 ;
  LOOP
    WHILE i < n AND (IsBlank (s[i]) OR s[i] = ',') DO i := i + 1 END ;
    IF i >= n THEN EXIT END ;
    IF n - i >= 10 AND Same (SLICE (s, i, 10), 'translate(') THEN
      i := i + 10 ;
      IF NOT Num (s, i, a) THEN RAISE Faults.BadArg ('Png.FromSvg: translate without a number') END ;
      b := 0.0 ;
      IF NOT Num (s, i, b) THEN b := 0.0 END ;
      c.ox := c.ox + a * c.sc ;
      c.oy := c.oy + b * c.sc
    ELSIF n - i >= 6 AND Same (SLICE (s, i, 6), 'scale(') THEN
      i := i + 6 ;
      IF NOT Num (s, i, a) THEN RAISE Faults.BadArg ('Png.FromSvg: scale without a number') END ;
      b := a ;
      IF Num (s, i, b) AND b # a THEN
        RAISE Faults.BadArg ('Png.FromSvg: a scale that differs by axis')
      END ;
      IF NOT (a > 0.0) THEN RAISE Faults.BadArg ('Png.FromSvg: a scale that is not positive') END ;
      c.sc := c.sc * a
    ELSE
      RAISE Faults.BadArg ('Png.FromSvg: a transform on a group other than translate and scale: ' + s)
    END ;
    WHILE i < n AND IsBlank (s[i]) DO i := i + 1 END ;
    IF i < n AND s[i] = ')' THEN i := i + 1 ELSE RAISE Faults.BadArg ('Png.FromSvg: a transform without its closing parenthesis') END
  END
END Transform ;

PROCEDURE Raster (VAR pool: POOL ; RO svg: STR ; dpi: F64 ;
                  VAR width, height: I64) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange =
VAR
  scratch : POOL ;
  c : Canvas ;
  tg : Tag ;
  st : Style ;
  i, after, k, depth, clipDepth, nclip : I64 ;
  sc, vw, vh, x, y, w, h, r, size, anchor, deg, rx, ry, dy, v : F64 ;
  vb, txt, clipId, want : STR ;
  seenSvg, inClip : BOOL ;
  clipIds : ARRAY 8 OF STR ;
  clipBox : ARRAY 32 OF F64 ;
BEGIN
  IF NOT (dpi > 0.0 AND dpi <= 2400.0) THEN
    RAISE Faults.BadArg ('Png.FromSvg: dots an inch between 1 and 2400')
  END ;
  sc := dpi / 72.0 ;
  i := 0 ;
  seenSvg := FALSE ;
  inClip := FALSE ;
  depth := 0 ;
  clipDepth := -1 ;
  nclip := 0 ;
  clipId := '' ;
  width := 0 ; height := 0 ;
  WHILE NextTag (svg, i, tg) DO
    i := tg.endAt ;
    IF tg.closing THEN
      (* what a closing tag ends was drawn when it opened; a group
         that set the clip takes it with it *)
      IF Same (tg.name, 'g') THEN
        IF depth = clipDepth THEN
          c.clipped := FALSE ;
          clipDepth := -1
        END ;
        depth := depth - 1 ;
        IF c.gdepth > 0 THEN
          c.gdepth := c.gdepth - 1 ;
          c.ox := c.gox[c.gdepth] ;
          c.oy := c.goy[c.gdepth] ;
          c.sc := c.gsc[c.gdepth]
        END
      ELSIF Same (tg.name, 'clipPath') THEN
        inClip := FALSE
      END
    ELSIF inClip THEN
      (* the rectangle a clipPath holds is its region, not a mark *)
      IF Same (tg.name, 'rect') THEN
        IF nclip >= 8 THEN RAISE Faults.BadArg ('Png.FromSvg: more than eight clipPaths') END ;
        clipIds[nclip] := clipId ;
        clipBox[4 * nclip] := PX (c, NumAttr (tg, 'x', 0.0)) ;
        clipBox[4 * nclip + 1] := PY (c, NumAttr (tg, 'y', 0.0)) ;
        clipBox[4 * nclip + 2] := PX (c, NumAttr (tg, 'x', 0.0) + NumAttr (tg, 'width', 0.0)) ;
        clipBox[4 * nclip + 3] := PY (c, NumAttr (tg, 'y', 0.0) + NumAttr (tg, 'height', 0.0)) ;
        nclip := nclip + 1
      ELSE
        RAISE Faults.BadArg ('Png.FromSvg: a clipPath that is not one rectangle')
      END
    ELSIF Same (tg.name, 'svg') THEN
      IF seenSvg THEN RAISE Faults.BadArg ('Png.FromSvg: a second <svg>') END ;
      seenSvg := TRUE ;
      vb := Attr (tg, 'viewBox') ;
      k := 0 ;
      vw := 0.0 ; vh := 0.0 ; x := 0.0 ; y := 0.0 ;
      IF LEN (vb) > 0 THEN
        IF NOT (Num (vb, k, x) AND Num (vb, k, y) AND Num (vb, k, vw) AND Num (vb, k, vh)) THEN
          RAISE Faults.BadArg ('Png.FromSvg: a viewBox that is not four numbers')
        END ;
        IF x # 0.0 OR y # 0.0 THEN
          RAISE Faults.BadArg ('Png.FromSvg: a viewBox that does not begin at 0 0')
        END
      ELSE
        vw := NumAttr (tg, 'width', 0.0) ;
        vh := NumAttr (tg, 'height', 0.0)
      END ;
      IF NOT (vw > 0.0 AND vh > 0.0) THEN
        RAISE Faults.BadArg ('Png.FromSvg: an <svg> without a size (viewBox, or width and height)')
      END ;
      width := I64 (vw * sc + 0.5) ;
      height := I64 (vh * sc + 0.5) ;
      IF width < 1 THEN width := 1 END ;
      IF height < 1 THEN height := 1 END ;
      IF width * height > 100000000 THEN
        RAISE Faults.BadArg ('Png.FromSvg: more than a hundred million pixels')
      END ;
      NewCanvas (pool, scratch, width, height, sc, c)
    ELSIF NOT seenSvg THEN
      RAISE Faults.BadArg ('Png.FromSvg: an element before <svg>: ' + tg.name)
    ELSIF Hidden (tg) THEN
      (* visibility="hidden" or display="none": not drawn, but its
         text, if any, is passed over too *)
      IF Same (tg.name, 'text') AND NOT tg.selfClosing THEN
        after := i ;
        txt := Content (scratch, svg, i, after) ;
        i := after
      END
    ELSIF Same (tg.name, 'clipPath') THEN
      inClip := NOT tg.selfClosing ;
      clipId := Attr (tg, 'id')
    ELSIF Same (tg.name, 'rect') THEN
      ReadStyle (scratch, tg, c.sc, TRUE, st) ;
      x := PX (c, NumAttr (tg, 'x', 0.0)) ;
      y := PY (c, NumAttr (tg, 'y', 0.0)) ;
      w := NumAttr (tg, 'width', 0.0) * c.sc ;
      h := NumAttr (tg, 'height', 0.0) * c.sc ;
      IF st.fill THEN RectFill (c, x, y, x + w, y + h, st.fr, st.fg, st.fb, st.fillOpacity) END ;
      IF st.stroke THEN
        c.nl := 0 ;
        LinePt (c, x, y) ; LinePt (c, x + w, y) ; LinePt (c, x + w, y + h) ; LinePt (c, x, y + h) ;
        StrokeLine (c, st.width, st.dash, TRUE) ;
        c.nl := 0 ;
        PaintStroke (c, st)
      END
    ELSIF Same (tg.name, 'line') THEN
      ReadStyle (scratch, tg, c.sc, FALSE, st) ;
      IF st.stroke THEN
        c.nl := 0 ;
        LinePt (c, PX (c, NumAttr (tg, 'x1', 0.0)), PY (c, NumAttr (tg, 'y1', 0.0))) ;
        LinePt (c, PX (c, NumAttr (tg, 'x2', 0.0)), PY (c, NumAttr (tg, 'y2', 0.0))) ;
        StrokeLine (c, st.width, st.dash, FALSE) ;
        c.nl := 0 ;
        PaintStroke (c, st)
      END
    ELSIF Same (tg.name, 'circle') THEN
      ReadStyle (scratch, tg, c.sc, TRUE, st) ;
      x := PX (c, NumAttr (tg, 'cx', 0.0)) ;
      y := PY (c, NumAttr (tg, 'cy', 0.0)) ;
      r := NumAttr (tg, 'r', 0.0) * c.sc ;
      IF st.fill THEN
        Disc (c, x, y, r) ;
        PaintFill (c, st)
      END ;
      IF st.stroke AND r > 0.0 THEN
        Disc (c, x, y, r + st.width / 2.0) ;
        IF r - st.width / 2.0 > 0.0 THEN Disc (c, x, y, -(r - st.width / 2.0)) END ;
        PaintStroke (c, st)
      END
    ELSIF Same (tg.name, 'path') THEN
      ReadStyle (scratch, tg, c.sc, TRUE, st) ;
      IF st.fill THEN
        (* the fill first, gathered from the whole d; then the stroke *)
        DrawPath (c, Attr (tg, 'd'), st) ;
        (* DrawPath gathered fill contours and stroke quads into one
           shape; with both wanted they are painted in the fill's
           colour, then the stroke alone again on top *)
        PaintFill (c, st) ;
        IF st.stroke THEN
          st.fill := FALSE ;
          DrawPath (c, Attr (tg, 'd'), st) ;
          PaintStroke (c, st)
        END
      ELSE
        DrawPath (c, Attr (tg, 'd'), st) ;
        PaintStroke (c, st)
      END
    ELSIF Same (tg.name, 'polyline') OR Same (tg.name, 'polygon') THEN
      ReadStyle (scratch, tg, c.sc, Same (tg.name, 'polygon'), st) ;
      IF st.fill THEN
        DrawPoints (c, Attr (tg, 'points'), st, Same (tg.name, 'polygon')) ;
        PaintFill (c, st) ;
        IF st.stroke THEN
          st.fill := FALSE ;
          DrawPoints (c, Attr (tg, 'points'), st, Same (tg.name, 'polygon')) ;
          PaintStroke (c, st)
        END
      ELSE
        DrawPoints (c, Attr (tg, 'points'), st, Same (tg.name, 'polygon')) ;
        PaintStroke (c, st)
      END
    ELSIF Same (tg.name, 'text') THEN
      ReadStyle (scratch, tg, c.sc, TRUE, st) ;
      IF tg.selfClosing THEN
        txt := ''
      ELSE
        after := i ;
        txt := Content (scratch, svg, i, after) ;
        i := after
      END ;
      x := NumAttr (tg, 'x', 0.0) ;
      y := NumAttr (tg, 'y', 0.0) ;
      dy := NumAttr (tg, 'dy', 0.0) ;
      size := NumAttr (tg, 'font-size', 16.0) ;
      anchor := 0.0 ;
      IF Same (Attr (tg, 'text-anchor'), 'middle') THEN anchor := 0.5
      ELSIF Same (Attr (tg, 'text-anchor'), 'end') THEN anchor := 1.0 END ;
      Rotation (Attr (tg, 'transform'), x, y, deg, rx, ry) ;
      IF st.fill AND LEN (txt) > 0 THEN
        DrawText (c, txt, PX (c, x), PY (c, y + dy), size * c.sc, anchor, deg, PX (c, rx), PY (c, ry)) ;
        PaintFill (c, st)
      END
    ELSIF Same (tg.name, 'g') THEN
      FOR k := 0 TO tg.nattr - 1 DO
        IF NOT (Same (tg.an[k], 'class') OR Same (tg.an[k], 'clip-path')
                OR Same (tg.an[k], 'transform')) THEN
          RAISE Faults.BadArg ('Png.FromSvg: a <g> with attributes, which this does not apply to what it holds')
        END
      END ;
      IF tg.selfClosing THEN
        (* an empty group: nothing to hold *)
      ELSE
        depth := depth + 1 ;
        (* the transform in force is kept, and the group's own put
           on top of it *)
        IF c.gdepth >= MaxGroups THEN RAISE Faults.BadArg ('Png.FromSvg: groups nested more than 64 deep') END ;
        c.gox[c.gdepth] := c.ox ;
        c.goy[c.gdepth] := c.oy ;
        c.gsc[c.gdepth] := c.sc ;
        c.gdepth := c.gdepth + 1 ;
        Transform (Attr (tg, 'transform'), c)
      END ;
      want := Attr (tg, 'clip-path') ;
      IF LEN (want) > 0 THEN
        (* url(#id): the rectangle of that clipPath, while the group lasts *)
        IF LEN (want) < 6 OR NOT Same (SLICE (want, 0, 5), 'url(#') OR tg.selfClosing THEN
          RAISE Faults.BadArg ('Png.FromSvg: a clip-path that is not url(#id): ' + want)
        END ;
        want := SLICE (want, 5, LEN (want) - 6) ;
        k := 0 ;
        WHILE k < nclip AND NOT Same (clipIds[k], want) DO k := k + 1 END ;
        IF k >= nclip THEN RAISE Faults.BadArg ('Png.FromSvg: a clip-path naming no clipPath: ' + want) END ;
        IF c.clipped THEN RAISE Faults.BadArg ('Png.FromSvg: a clipPath inside another') END ;
        c.clipped := TRUE ;
        c.kx0 := clipBox[4 * k] ; c.ky0 := clipBox[4 * k + 1] ;
        c.kx1 := clipBox[4 * k + 2] ; c.ky1 := clipBox[4 * k + 3] ;
        clipDepth := depth
      END
    ELSIF Same (tg.name, 'title') OR Same (tg.name, 'desc') THEN
      (* passed over with its text *)
    ELSE
      RAISE Faults.BadArg ('Png.FromSvg: an element this does not draw: <' + tg.name + '>')
    END
  END ;
  IF NOT seenSvg THEN RAISE Faults.BadArg ('Png.FromSvg: no <svg> in the text') END ;
  v := 0.0 ;
  RETURN c.pix
END Raster ;

PROCEDURE FromSvg (VAR pool: POOL ; RO svg: STR ; dpi: F64) : SLICE OF BYTE
  RAISES Faults.SizeError, Faults.BadArg, ValueRange =
VAR
  scratch : POOL ;
  pix : SLICE OF BYTE ;
  w, h : I64 ;
BEGIN
  w := 0 ; h := 0 ;
  pix := Raster (scratch, svg, dpi, w, h) ;
  RETURN Encode (pool, pix, w, h, dpi)
END FromSvg ;

END Png.
