(* SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0 *)
DEFINITION MODULE Arrow ;

(* An Apache Arrow IPC STREAM, written.

   One schema message, one record batch, one end-of-stream marker --
   the shape `pyarrow.ipc.open_stream` reads and the shape a service
   answers `format=arrow` with.  Deliberately a SUBSET, and the parts
   outside it are refused BY NAME rather than half-written, because a
   columnar file that decodes into the wrong cells is a numbers-shaped
   lie: Parquet.m9's rule, and the reason pyarrow is the oracle in
   runtime/test/arrow_driver.c.

   IN THE SUBSET: flat schemas; int8/16/32/64, float32/64, UTF-8
   strings, and timestamps in nanoseconds; one record batch; schema
   custom_metadata.  Uncompressed (Stream), or every body buffer
   compressed with ZSTD (StreamCodec): the record batch's
   BodyCompression says so, and each buffer is its uncompressed
   length as 8 little-endian bytes and then one zstd frame -- or the
   length -1 and the bytes as they were, for a buffer zstd would not
   make smaller, which the format allows for exactly that.  An empty
   buffer stays empty.  libzstd is the system's (LINK below), as
   Parquet's ZSTD pages are; lz4, the format's other codec, is not
   written.

   OUT OF THE SUBSET, and refused: nulls.  Every column here is
   written with an EMPTY validity buffer and a null_count of zero,
   which is what a numpy array with no mask becomes, and it is what
   these callers have.  A column that needs nulls must say so, and
   this module would have to grow a bitmap rather than guess.  The
   missing-value convention in the data -- NaN, a sentinel -- is the
   caller's, unchanged, exactly as Parquet.m9 leaves it.

   THE FORMAT, so a reader of this file need not have the spec open.
   A stream is a sequence of encapsulated messages:

     <0xFFFFFFFF> <int32 metadata length> <flatbuffer> <pad to 8> [body]

   and ends with a length of zero.  The metadata length COUNTS its own
   padding, so every body starts 8-aligned.  Inside the body each
   buffer is padded to 8 as well, and the record batch names every
   buffer by (offset, length) so a reader never has to guess.  The
   flatbuffer field numbers are the interesting part and they are
   written down at each table below; they were read off a stream
   pyarrow produced rather than remembered.                          *)

IMPORT Faults ;

IMPORT DynStr ;

TYPE
  Table ;                                (* opaque; lives in a POOL *)

CONST
  (* the column types this subset writes.  Names, not widths, because
     a wire format fixes the width and the host must not have a say --
     par 2.1's rule, and SizeOf is deliberately not used here. *)
  TyI8   = 0 ;
  TyI16  = 1 ;
  TyI32  = 2 ;
  TyI64  = 3 ;
  TyF32  = 4 ;
  TyF64  = 5 ;
  TyStr  = 6 ;
  TyTsNs = 7 ;                           (* timestamp, nanoseconds,
                                            NO timezone: naive, as a
                                            numpy datetime64 lands *)

  CodecNone = 0 ;
  CodecZstd = 1 ;                        (* StreamCodec's codec.  The
                                            numbers are this module's:
                                            the format spells LZ4_FRAME
                                            0 and ZSTD 1, and 0 here
                                            must mean "nothing asked" *)

PROCEDURE New (VAR pool: POOL ; rows: I64) : PTR Table IN pool ;
  (* an empty table of `rows` rows.  Columns are added in order and
     that is the order the schema and the batch carry.               *)

PROCEDURE Meta (VAR t: PTR Table ;
                RO KEPT key: STR ; RO KEPT value: STR) ;
  (* a schema custom_metadata entry -- where a data passport rides.
     KEPT: the table holds VIEWS of the caller's strings, as
     HttpServer.AddRoute holds its own, so they must outlive it.     *)

PROCEDURE AddInt (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; ty: I64 ; RO KEPT v: SLICE OF I64)
  RAISES Faults.BadArg ;
  (* an integer or timestamp column, values carried as I64 and
     narrowed to the declared width.  A value that will not fit
     RAISES rather than wrapping: the width is the wire's, and a
     silent truncation here is a wrong number in someone's dataframe. *)

PROCEDURE AddF32 (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF F32)
  RAISES Faults.BadArg ;

PROCEDURE AddF64 (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF F64)
  RAISES Faults.BadArg ;

PROCEDURE AddStr (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF STR)
  RAISES Faults.BadArg, ValueRange ;
  (* UTF-8 on the wire, encoded here from the caller's CHARs. *)

PROCEDURE Stream (VAR pool: POOL ; t: PTR Table) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange ;
  (* the whole stream, in pool. *)

PROCEDURE StreamCodec (VAR pool: POOL ; t: PTR Table ; codec, level: I64)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange ;
  (* the same stream with its body buffers compressed: CodecNone is
     Stream's bytes exactly, CodecZstd is libzstd at `level' (1 is
     pyarrow's own default for ZSTD, 3 is libzstd's).  Another codec
     is BadArg by name.  The schema and every cell read back the same
     either way; only the wire shrinks.                              *)

PROCEDURE NBytes (t: PTR Table) : I64 ;
  (* what pyarrow's `table.nbytes` answers for this table, which is
     NOT the stream length: it is Arrow's in-memory buffer
     accounting, and a caller reporting a size in a passport must use
     this rather than measuring the wire.  A string column counts
     4n + data, NOT 4(n+1) -- the offsets buffer is one longer on the
     wire than nbytes admits -- and a column with no nulls carries no
     validity bytes at all.  Both were measured against pyarrow, and
     the first cost an 8-byte passport error on two string columns
     the last time this was written.                                 *)

(* ---- READING a stream (2026-10-30; zarrm9's mcpd reads zpd's
   `format=arrow' answers, Alex: "pyarrow readers as well") ----

   Any number of record batches after the schema, each read when Next
   is asked, uncompressed or ZSTD (the BodyCompression above, the -1
   length included).  The columns read are the subset written: int8 to
   int64, float32 and float64, UTF-8 strings and timestamps in
   nanoseconds -- WITH a time zone too, which FieldTz answers ('' for
   a naive one).  NULLS ARE READ: a column's validity bitmap answers
   IsNull, a null float reads as NaN, a null integer as 0 and a null
   string as ''.  Refused by name, never half-read: a big-endian
   stream, a dictionary batch or a dictionary-encoded column, a nested
   column, an unsigned integer, a half float, a timestamp in another
   unit, large strings, and LZ4.  pyarrow is the oracle
   (runtime/test/arrowread.py), as it is for the writer.

   Each batch's buffers are copied, or decompressed, into the reader's
   own pool and stay there: a reader of a long stream holds every batch
   it has read.  What the getters answer is the caller's, in its pool. *)

TYPE
  Reader ;                               (* opaque; lives in a POOL *)

PROCEDURE Open (VAR pool: POOL ; RO KEPT src: SLICE OF BYTE)
  : PTR Reader IN pool
  RAISES Faults.BadArg, ValueRange ;
  (* the schema: the stream's first message.  `src' is the whole
     stream, read where it lies until the last batch is read. *)

PROCEDURE NFields (r: PTR Reader) : I64 ;
PROCEDURE FieldName (r: PTR Reader ; i: I64) : STR RAISES IndexError ;
PROCEDURE FieldType (r: PTR Reader ; i: I64) : I64 RAISES IndexError ;
  (* one of the Ty constants above *)
PROCEDURE FieldTz (r: PTR Reader ; i: I64) : STR RAISES IndexError ;
  (* a timestamp column's time zone as the schema spells it, 'UTC' or
     '+01:00'; '' for a naive timestamp and for any other column *)
PROCEDURE MetaOf (r: PTR Reader ; RO key: STR) : STR ;
  (* the schema's custom_metadata value for key, '' when absent *)

PROCEDURE Next (VAR r: PTR Reader) : BOOL
  RAISES Faults.BadArg, ValueRange ;
  (* the next record batch, FALSE at the end of the stream (its
     zero-length marker, or the bytes running out where a message
     would start) *)

PROCEDURE Rows (r: PTR Reader) : I64 ;
  (* the current batch's row count; 0 before the first Next *)
PROCEDURE Nulls (r: PTR Reader ; i: I64) : I64 RAISES IndexError ;
  (* column i's null count in the current batch *)
PROCEDURE IsNull (r: PTR Reader ; i, row: I64) : BOOL RAISES IndexError ;

PROCEDURE GetF64 (VAR pool: POOL ; r: PTR Reader ; i: I64) : SLICE OF F64
  RAISES Faults.BadArg, IndexError ;
  (* a float32 or float64 column of the current batch, float32 widened
     exactly; a null is NaN.  Any other column is BadArg. *)
PROCEDURE GetI64 (VAR pool: POOL ; r: PTR Reader ; i: I64) : SLICE OF I64
  RAISES Faults.BadArg, IndexError ;
  (* an integer or timestamp column (nanoseconds since the epoch); a
     null is 0 -- ask IsNull.  Any other column is BadArg. *)
PROCEDURE GetStr (VAR pool: POOL ; r: PTR Reader ; i, row: I64) : STR
  RAISES Faults.BadArg, IndexError, ValueRange ;
  (* one cell of a string column, decoded from UTF-8 (ValueRange for
     bytes that are not UTF-8); a null is ''.  Any other column is
     BadArg. *)

END Arrow.


UNSAFE DEFINITION MODULE FOR "C" carrowz LINK "-l:libzstd.so.1" ;

(* libzstd's one-shot compressor, as Parquet's czstd binds it: each
   call makes and frees its own context, so any number of threads may
   call it at once.  An error is a size_t near 2 ** 64, which I64 ()
   refuses with ValueRange.  Its own unit, not Parquet's, so that
   Arrow does not import Parquet and a program linking both has two
   units of distinct names over the same two symbols. *)

PROCEDURE ZstdCompress = "ZSTD_compress"
  (dst: C.MutPtr ; cap: C.SizeT ; src: C.ConstPtr ; n: C.SizeT ;
   level: C.Int) : C.SizeT  [REENTRANT] ;

PROCEDURE ZstdBound = "ZSTD_compressBound" (n: C.SizeT) : C.SizeT
  [REENTRANT] ;

PROCEDURE ZstdDecompress = "ZSTD_decompress"
  (dst: C.MutPtr ; cap: C.SizeT ; src: C.ConstPtr ; n: C.SizeT) : C.SizeT
  [REENTRANT] ;

END carrowz.


UNSAFE IMPLEMENTATION MODULE Arrow ;

(* UNSAFE for one reason: ADR at the libzstd boundary.  Grep ADR. *)

FROM carrowz IMPORT ZstdCompress, ZstdBound, ZstdDecompress ;

IMPORT Faults ;

IMPORT DynStr ;

CONST
  (* flatbuffer builder room for the two metadata messages.  The body
     never passes through it. *)
  FbFixed = 8192 ;
  FbPerCol = 512 ;

TYPE
  Col = RECORD
    RO name : STR ;
    ty : I64 ;
    RO iv : SLICE OF I64 ;
    RO f4 : SLICE OF F32 ;
    RO f8 : SLICE OF F64 ;
    (* a string column is encoded ONCE, at Add: the offsets and the
       concatenated UTF-8, which is what the wire wants anyway.  The
       alternative -- encoding per row at Stream -- would walk every
       string twice and leave a pool full of throwaway copies. *)
    sdata : SLICE OF BYTE ;
    soff : SLICE OF I64 ;
    dlen : I64 ;
    next : OPT PTR Col ;
  END ;

  Kv = RECORD
    RO k, v : STR ;
    next : OPT PTR Kv ;
  END ;

  Table = RECORD
    rows, ncol, nmeta : I64 ;
    firstC, lastC : OPT PTR Col ;
    firstM, lastM : OPT PTR Kv ;
  END ;

  (* THE FLATBUFFER BUILDER, WHICH FILLS ITS BUFFER FROM THE END.
     That is not a flourish: an offset in this format points forward
     from where it is written, so an object must be complete before
     anything can refer to it, and building backwards is what makes
     that possible in one pass.  Every offset below is measured from
     the END of the buffer, the only frame in which they stay put
     while the front keeps moving. *)
  Fb = RECORD
    b : SLICE OF BYTE ;
    head : I64 ;
    minAlign : I64 ;
    vt : ARRAY 16 OF I64 ;
    nvt : I64 ;
    objStart : I64 ;
  END ;

PROCEDURE Pow256 (k: I64) : I64 =
VAR i, p : I64 ;
BEGIN
  p := 1 ;
  FOR i := 1 TO k DO p := p * 256 END ;
  RETURN p
END Pow256 ;

PROCEDURE PutLE (VAR u: SLICE OF BYTE ; at, v, k: I64)
  RAISES ValueRange, IndexError =
  (* k little-endian bytes of v's TWO'S COMPLEMENT pattern.  The
     shift stays inside checked I64: m is the non-negative low byte
     and (v - m) is an exact multiple of 256, so DIV truncating or
     flooring makes no difference. *)
VAR i, x, m : I64 ;
BEGIN
  x := v ;
  FOR i := 0 TO k - 1 DO
    m := x MOD 256 ;
    IF m < 0 THEN m := m + 256 END ;
    u[at + i] := BYTE (m) ;
    x := (x - m) DIV 256
  END
END PutLE ;

PROCEDURE Pad8 (n: I64) : I64 =
VAR r : I64 ;
BEGIN
  r := n MOD 8 ;
  IF r = 0 THEN RETURN n END ;
  RETURN n + 8 - r
END Pad8 ;

PROCEDURE Width (ty: I64) : I64 =
BEGIN
  IF ty = TyI8 THEN RETURN 1 END ;
  IF ty = TyI16 THEN RETURN 2 END ;
  IF ty = TyI32 OR ty = TyF32 THEN RETURN 4 END ;
  RETURN 8
END Width ;

(* ---- the builder ---- *)

PROCEDURE Used (RO f: Fb) : I64 =
BEGIN
  RETURN LEN (f.b) - f.head
END Used ;

PROCEDURE Room (VAR f: Fb ; n: I64) RAISES Faults.BadArg =
BEGIN
  IF f.head - n < 0 THEN
    RAISE Faults.BadArg ('arrow: metadata outgrew the builder room')
  END
END Room ;

PROCEDURE Pad (VAR f: Fb ; n: I64) RAISES Faults.BadArg, ValueRange =
VAR i : I64 ;
BEGIN
  Room (f, n) ;
  FOR i := 1 TO n DO
    f.head := f.head - 1 ;
    f.b[f.head] := BYTE (0)
  END
END Pad ;

PROCEDURE Prep (VAR f: Fb ; size, add: I64) RAISES Faults.BadArg, ValueRange =
VAR r : I64 ;
BEGIN
  IF size > f.minAlign THEN f.minAlign := size END ;
  r := (Used (f) + add) MOD size ;
  IF r # 0 THEN Pad (f, size - r) END
END Prep ;

PROCEDURE Raw (VAR f: Fb ; v: I64 ; k: I64) RAISES Faults.BadArg, ValueRange =
VAR i, x, m : I64 ;
BEGIN
  Room (f, k) ;
  x := v ;
  f.head := f.head - k ;
  FOR i := 0 TO k - 1 DO
    m := x MOD 256 ;
    IF m < 0 THEN m := m + 256 END ;
    f.b[f.head + i] := BYTE (m) ;
    x := (x - m) DIV 256
  END
END Raw ;

PROCEDURE Put8 (VAR f: Fb ; v: I64) RAISES Faults.BadArg, ValueRange =
BEGIN
  Prep (f, 1, 0) ; Raw (f, v, 1)
END Put8 ;

PROCEDURE Put16 (VAR f: Fb ; v: I64) RAISES Faults.BadArg, ValueRange =
BEGIN
  Prep (f, 2, 0) ; Raw (f, v, 2)
END Put16 ;

PROCEDURE Put32 (VAR f: Fb ; v: I64) RAISES Faults.BadArg, ValueRange =
BEGIN
  Prep (f, 4, 0) ; Raw (f, v, 4)
END Put32 ;

PROCEDURE Put64 (VAR f: Fb ; v: I64) RAISES Faults.BadArg, ValueRange =
BEGIN
  Prep (f, 8, 0) ; Raw (f, v, 8)
END Put64 ;

PROCEDURE Ref (VAR f: Fb ; off: I64) RAISES Faults.BadArg, ValueRange =
  (* an offset to an object already written: forward from here *)
BEGIN
  Prep (f, 4, 0) ;
  Raw (f, Used (f) - off + 4, 4)
END Ref ;

PROCEDURE Str (VAR pool: POOL ; VAR f: Fb ; RO s: STR) : I64
  RAISES Faults.BadArg, ValueRange =
  (* length, bytes, NUL -- written backwards, terminator first *)
VAR i, n : I64 ; u : SLICE OF BYTE ;
BEGIN
  u := DynStr.Utf8 (pool, s) ;
  n := LEN (u) ;
  Prep (f, 4, n + 1) ;
  Pad (f, 1) ;
  Room (f, n) ;
  f.head := f.head - n ;
  FOR i := 0 TO n - 1 DO
    f.b[f.head + i] := u[i]
  END ;
  Put32 (f, n) ;
  RETURN Used (f)
END Str ;

PROCEDURE Start (VAR f: Fb ; nfields: I64) RAISES IndexError =
VAR i : I64 ;
BEGIN
  f.nvt := nfields ;
  FOR i := 0 TO nfields - 1 DO f.vt[i] := 0 END ;
  f.objStart := Used (f)
END Start ;

PROCEDURE Slot (VAR f: Fb ; i: I64) RAISES IndexError =
  (* CALLED AFTER THE VALUE, never before.  Building backwards, the
     field's offset is where the buffer stands once the value is
     down; recording it first points the vtable at the PREVIOUS
     field and every scalar comes out misaligned -- which is what
     "Invalid flatbuffers message" meant the first time. *)
BEGIN
  f.vt[i] := Used (f)
END Slot ;

PROCEDURE End (VAR f: Fb) : I64 RAISES Faults.BadArg, ValueRange, IndexError =
  (* close the table: a placeholder, the vtable behind it, then the
     placeholder patched to point at it.  The reader computes
     table_position - soffset = vtable, which is why the patched
     value is vloc - tloc and not the other way round. *)
VAR i, tloc, vloc, d : I64 ;
BEGIN
  Put32 (f, 0) ;
  tloc := Used (f) ;
  FOR i := f.nvt - 1 TO 0 BY -1 DO
    IF f.vt[i] = 0 THEN Put16 (f, 0)
    ELSE Put16 (f, tloc - f.vt[i]) END
  END ;
  Put16 (f, tloc - f.objStart) ;
  Put16 (f, (f.nvt + 2) * 2) ;
  vloc := Used (f) ;
  d := vloc - tloc ;
  FOR i := 0 TO 3 DO
    f.b[LEN (f.b) - tloc + i] := BYTE ((d DIV Pow256 (i)) MOD 256)
  END ;
  RETURN tloc
END End ;

PROCEDURE Finish (VAR f: Fb ; root: I64) RAISES Faults.BadArg, ValueRange =
BEGIN
  Prep (f, f.minAlign, 4) ;
  Ref (f, root)
END Finish ;

(* ---- the Arrow tables.  Field numbers were read off a stream
   pyarrow produced, not remembered. ---- *)

PROCEDURE TypeTag (ty: I64) : I64 =
  (* Type union tags from Schema.fbs: Int 2, FloatingPoint 3,
     Utf8 5, Timestamp 10 *)
BEGIN
  IF ty = TyF32 OR ty = TyF64 THEN RETURN 3 END ;
  IF ty = TyStr THEN RETURN 5 END ;
  IF ty = TyTsNs THEN RETURN 10 END ;
  RETURN 2
END TypeTag ;

PROCEDURE TypeTable (VAR f: Fb ; ty: I64) : I64
  RAISES Faults.BadArg, ValueRange, IndexError =
BEGIN
  IF ty = TyStr THEN
    Start (f, 0) ;                       (* Utf8: an empty table *)
    RETURN End (f)
  END ;
  IF ty = TyF32 OR ty = TyF64 THEN
    Start (f, 1) ;                       (* FloatingPoint: 0 precision *)
    IF ty = TyF32 THEN Put16 (f, 1) ELSE Put16 (f, 2) END ;
    Slot (f, 0) ;
    RETURN End (f)
  END ;
  IF ty = TyTsNs THEN
    Start (f, 2) ;                       (* Timestamp: 0 unit, 1 zone *)
    Put16 (f, 3) ;                         (* NANOSECOND, and NO
                                            timezone, so the stamp is
                                            naive exactly as a numpy
                                            datetime64[ns] lands *)
    Slot (f, 0) ;
    RETURN End (f)
  END ;
  Start (f, 2) ;                         (* Int: 0 bitWidth, 1 signed *)
  Put8 (f, 1) ; Slot (f, 1) ;
  Put32 (f, Width (ty) * 8) ; Slot (f, 0) ;
  RETURN End (f)
END TypeTable ;

PROCEDURE FieldTable (VAR pool: POOL ; VAR f: Fb ; RO name: STR ;
                      ty: I64) : I64
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* Field: 0 name, 1 nullable, 2 type_type, 3 type, 4 dictionary,
     5 children, 6 custom_metadata *)
VAR nm, tt, kids : I64 ;
BEGIN
  nm := Str (pool, f, name) ;
  tt := TypeTable (f, ty) ;
  Prep (f, 4, 0) ;
  Put32 (f, 0) ;                           (* an empty children vector,
                                            which pyarrow emits too *)
  kids := Used (f) ;
  Start (f, 6) ;
  Ref (f, kids) ; Slot (f, 5) ;
  Ref (f, tt) ; Slot (f, 3) ;
  Put8 (f, TypeTag (ty)) ; Slot (f, 2) ;
  Put8 (f, 1) ; Slot (f, 1) ;              (* nullable, as pyarrow marks
                                            every field even when the
                                            batch carries no nulls *)
  Ref (f, nm) ; Slot (f, 0) ;
  RETURN End (f)
END FieldTable ;

PROCEDURE KvTable (VAR pool: POOL ; VAR f: Fb ; RO k: STR ; RO v: STR)
  : I64 RAISES Faults.BadArg, ValueRange, IndexError =
VAR ko, vo : I64 ;
BEGIN
  ko := Str (pool, f, k) ;
  vo := Str (pool, f, v) ;
  Start (f, 2) ;
  Ref (f, vo) ; Slot (f, 1) ;
  Ref (f, ko) ; Slot (f, 0) ;
  RETURN End (f)
END KvTable ;

PROCEDURE Vector (VAR f: Fb ; RO offs: SLICE OF I64 ; n: I64) : I64
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* a vector of offsets, last element first *)
VAR i : I64 ;
BEGIN
  Prep (f, 4, 4 * n) ;
  FOR i := n - 1 TO 0 BY -1 DO
    Ref (f, offs[i])
  END ;
  Put32 (f, n) ;
  RETURN Used (f)
END Vector ;

PROCEDURE SchemaMsg (VAR pool: POOL ; VAR f: Fb ; t: PTR Table) : I64
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* Schema: 0 endianness (Little is the default, so omitted),
     1 fields, 2 custom_metadata.  Message: 0 version, 1 header_type,
     2 header, 3 bodyLength (zero here, so omitted). *)
VAR
  offs : SLICE OF I64 ;
  c : OPT PTR Col ; m : OPT PTR Kv ;
  i, fv, mv, sc : I64 ;
BEGIN
  offs := NEW (pool, I64, t.ncol + t.nmeta + 1) ;
  i := 0 ; c := t.firstC ;
  WHILE c IS SOME cc DO
    offs[i] := FieldTable (pool, f, cc.name, cc.ty) ;
    i := i + 1 ; c := cc.next
  END ;
  fv := Vector (f, offs, t.ncol) ;
  mv := 0 ;
  IF t.nmeta > 0 THEN
    i := 0 ; m := t.firstM ;
    WHILE m IS SOME mm DO
      offs[i] := KvTable (pool, f, mm.k, mm.v) ;
      i := i + 1 ; m := mm.next
    END ;
    mv := Vector (f, offs, t.nmeta)
  END ;
  Start (f, 3) ;
  IF t.nmeta > 0 THEN Ref (f, mv) END ; Slot (f, 2) ;
  Ref (f, fv) ; Slot (f, 1) ;
  sc := End (f) ;
  Start (f, 4) ;
  Ref (f, sc) ; Slot (f, 2) ;
  Put8 (f, 1) ; Slot (f, 1) ;              (* header_type = Schema *)
  Put16 (f, 4) ; Slot (f, 0) ;             (* MetadataVersion V5 *)
  RETURN End (f)
END SchemaMsg ;

PROCEDURE BatchMsg (VAR f: Fb ; t: PTR Table ;
                    RO bufOff: SLICE OF I64 ; RO bufLen: SLICE OF I64 ;
                    nbuf, bodyLen, codec: I64) : I64
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* RecordBatch: 0 length, 1 nodes, 2 buffers, 3 compression.
     FieldNode and Buffer are STRUCTS -- inline, no vtable, sixteen
     bytes each -- so their fields go down in reverse to come out in
     order.  BodyCompression: 0 codec (LZ4_FRAME 0, ZSTD 1 -- LZ4 is
     the DEFAULT, so ZSTD must be written), 1 method (BUFFER 0, the
     default and the only one, so omitted).  With no codec the batch
     has three fields, exactly the table Stream always wrote. *)
VAR i, nodes, bufs, rb, bc : I64 ;
BEGIN
  bc := 0 ;
  IF codec = CodecZstd THEN
    Start (f, 2) ;
    Put8 (f, 1) ; Slot (f, 0) ;
    bc := End (f)
  END ;
  Prep (f, 4, 16 * t.ncol) ;
  Prep (f, 8, 16 * t.ncol) ;
  FOR i := t.ncol - 1 TO 0 BY -1 DO
    Put64 (f, 0) ;                        (* null_count *)
    Put64 (f, t.rows)                     (* length *)
  END ;
  Put32 (f, t.ncol) ;
  nodes := Used (f) ;
  Prep (f, 4, 16 * nbuf) ;
  Prep (f, 8, 16 * nbuf) ;
  FOR i := nbuf - 1 TO 0 BY -1 DO
    Put64 (f, bufLen[i]) ;
    Put64 (f, bufOff[i])
  END ;
  Put32 (f, nbuf) ;
  bufs := Used (f) ;
  IF codec = CodecZstd THEN
    Start (f, 4) ;
    Ref (f, bc) ; Slot (f, 3)
  ELSE
    Start (f, 3)
  END ;
  Ref (f, bufs) ; Slot (f, 2) ;
  Ref (f, nodes) ; Slot (f, 1) ;
  Put64 (f, t.rows) ; Slot (f, 0) ;
  rb := End (f) ;
  Start (f, 4) ;
  Put64 (f, bodyLen) ; Slot (f, 3) ;
  Ref (f, rb) ; Slot (f, 2) ;
  Put8 (f, 3) ; Slot (f, 1) ;              (* header_type = RecordBatch *)
  Put16 (f, 4) ; Slot (f, 0) ;
  RETURN End (f)
END BatchMsg ;

(* ---- the public surface ---- *)

PROCEDURE New (VAR pool: POOL ; rows: I64) : PTR Table IN pool =
VAR t : PTR Table IN pool ;
BEGIN
  t := NEW (pool, Table) ;
  t.rows := rows ;
  t.ncol := 0 ;
  t.nmeta := 0 ;
  t.firstC := NONE ; t.lastC := NONE ;
  t.firstM := NONE ; t.lastM := NONE ;
  RETURN t
END New ;

PROCEDURE Meta (VAR t: PTR Table ;
                RO KEPT key: STR ; RO KEPT value: STR) =
VAR m : PTR Kv ;
BEGIN
  m := NEW (t, Kv) ;
  m.k := key ; m.v := value ; m.next := NONE ;
  IF t.lastM IS SOME p THEN p.next := SOME (m)
  ELSE t.firstM := SOME (m) END ;
  t.lastM := SOME (m) ;
  t.nmeta := t.nmeta + 1
END Meta ;

PROCEDURE Add (VAR pool: POOL ; VAR t: PTR Table ;
               RO KEPT name: STR ; ty: I64 ; n: I64) : PTR Col IN pool
  RAISES Faults.BadArg =
VAR c : PTR Col IN pool ;
BEGIN
  IF n # t.rows THEN
    RAISE Faults.BadArg ('arrow: column length disagrees with the table')
  END ;
  c := NEW (pool, Col) ;
  c.name := name ; c.ty := ty ; c.dlen := 0 ; c.next := NONE ;
  IF t.lastC IS SOME p THEN p.next := SOME (c)
  ELSE t.firstC := SOME (c) END ;
  t.lastC := SOME (c) ;
  t.ncol := t.ncol + 1 ;
  RETURN c
END Add ;

PROCEDURE AddInt (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; ty: I64 ; RO KEPT v: SLICE OF I64)
  RAISES Faults.BadArg =
VAR c : PTR Col ; i, w, lim : I64 ;
BEGIN
  IF ty = TyF32 OR ty = TyF64 OR ty = TyStr THEN
    RAISE Faults.BadArg ('arrow: AddInt given a non-integer type')
  END ;
  w := Width (ty) ;
  IF w < 8 THEN
    (* the width belongs to the WIRE; a value that will not fit is
       refused rather than wrapped, because a silent truncation here
       is a wrong number in someone's dataframe *)
    lim := Pow256 (w) DIV 2 ;
    FOR i := 0 TO LEN (v) - 1 DO
      IF v[i] >= lim OR v[i] < -lim THEN
        RAISE Faults.BadArg ('arrow: value does not fit the declared width')
      END
    END
  END ;
  c := Add (pool, t, name, ty, LEN (v)) ;
  c.iv := v
END AddInt ;

PROCEDURE AddF32 (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF F32)
  RAISES Faults.BadArg =
VAR c : PTR Col ;
BEGIN
  c := Add (pool, t, name, TyF32, LEN (v)) ;
  c.f4 := v
END AddF32 ;

PROCEDURE AddF64 (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF F64)
  RAISES Faults.BadArg =
VAR c : PTR Col ;
BEGIN
  c := Add (pool, t, name, TyF64, LEN (v)) ;
  c.f8 := v
END AddF64 ;

PROCEDURE AddStr (VAR pool: POOL ; VAR t: PTR Table ;
                  RO KEPT name: STR ; RO KEPT v: SLICE OF STR)
  RAISES Faults.BadArg, ValueRange =
VAR
  c : PTR Col ;
  parts : SLICE OF BYTE ;
  i, j, m, n : I64 ;
BEGIN
  c := Add (pool, t, name, TyStr, LEN (v)) ;
  c.soff := NEW (pool, I64, LEN (v) + 1) ;
  n := 0 ;
  FOR i := 0 TO LEN (v) - 1 DO
    c.soff[i] := n ;
    n := n + LEN (DynStr.Utf8 (pool, v[i]))
  END ;
  c.soff[LEN (v)] := n ;
  c.dlen := n ;
  c.sdata := NEW (pool, BYTE, n) ;
  j := 0 ;
  FOR i := 0 TO LEN (v) - 1 DO
    parts := DynStr.Utf8 (pool, v[i]) ;
    FOR m := 0 TO LEN (parts) - 1 DO
      c.sdata[j] := parts[m] ; j := j + 1
    END
  END
END AddStr ;

PROCEDURE NBytes (t: PTR Table) : I64 =
VAR c : OPT PTR Col ; n : I64 ;
BEGIN
  n := 0 ;
  c := t.firstC ;
  WHILE c IS SOME cc DO
    IF cc.ty = TyStr THEN
      (* 4n, NOT 4(n+1): pyarrow's own accounting, measured.  The
         offsets buffer is one entry longer on the wire than nbytes
         admits, and that difference is an 8-byte passport error on
         two string columns if it is assumed instead. *)
      n := n + 4 * t.rows + cc.dlen
    ELSE
      n := n + Width (cc.ty) * t.rows
    END ;
    c := cc.next
  END ;
  RETURN n
END NBytes ;

PROCEDURE MetaBytes (t: PTR Table) : I64 =
VAR m : OPT PTR Kv ; n : I64 ;
BEGIN
  n := 0 ; m := t.firstM ;
  WHILE m IS SOME mm DO
    n := n + 4 * LEN (mm.k) + 4 * LEN (mm.v) + 64 ;
    m := mm.next
  END ;
  RETURN n
END MetaBytes ;

PROCEDURE NameBytes (t: PTR Table) : I64 =
VAR c : OPT PTR Col ; n : I64 ;
BEGIN
  n := 0 ; c := t.firstC ;
  WHILE c IS SOME cc DO
    n := n + 4 * LEN (cc.name) + 32 ;
    c := cc.next
  END ;
  RETURN n
END NameBytes ;

PROCEDURE PutMark (VAR u: SLICE OF BYTE ; at, len: I64)
  RAISES ValueRange, IndexError =
BEGIN
  PutLE (u, at, 4294967295, 4) ;
  PutLE (u, at + 4, len, 4)
END PutMark ;

PROCEDURE NBuf (t: PTR Table) : I64 =
  (* every column's validity buffer, then its values -- or a string's
     offsets and data *)
VAR c : OPT PTR Col ; n : I64 ;
BEGIN
  n := 0 ;
  c := t.firstC ;
  WHILE c IS SOME cc DO
    IF cc.ty = TyStr THEN n := n + 3 ELSE n := n + 2 END ;
    c := cc.next
  END ;
  RETURN n
END NBuf ;

PROCEDURE Framed (VAR pool: POOL ; t: PTR Table ;
                  RO bufOff: SLICE OF I64 ; RO bufLen: SLICE OF I64 ;
                  nbuf, bodyLen, codec: I64 ; VAR pos: I64)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange =
  (* the whole stream but its body: the schema message, the record
     batch's metadata naming the buffers as laid out, and the end
     marker.  The body is left zero for the caller to fill, starting
     at `pos'. *)
VAR
  f : Fb ;
  sb, u : SLICE OF BYTE ;
  i, sRoot, bRoot, sLen, bLen, sPad, bPad : I64 ;
BEGIN
  (* ---- the schema message ---- *)
  f.b := NEW (pool, BYTE, FbFixed + FbPerCol * (t.ncol + 1) +
                          MetaBytes (t) + NameBytes (t)) ;
  f.head := LEN (f.b) ; f.minAlign := 1 ; f.nvt := 0 ; f.objStart := 0 ;
  sRoot := SchemaMsg (pool, f, t) ;
  Finish (f, sRoot) ;
  sLen := Used (f) ;
  sPad := Pad8 (sLen) ;
  sb := NEW (pool, BYTE, sLen) ;
  FOR i := 0 TO sLen - 1 DO sb[i] := f.b[f.head + i] END ;

  (* ---- the record batch, in the same builder rewound ---- *)
  f.head := LEN (f.b) ; f.minAlign := 1 ; f.nvt := 0 ; f.objStart := 0 ;
  bRoot := BatchMsg (f, t, bufOff, bufLen, nbuf, bodyLen, codec) ;
  Finish (f, bRoot) ;
  bLen := Used (f) ;
  bPad := Pad8 (bLen) ;

  (* ---- the stream.  A message's declared metadata length COUNTS
     its padding, which is what leaves every body 8-aligned ---- *)
  u := NEW (pool, BYTE, 8 + sPad + 8 + bPad + bodyLen + 8) ;
  PutMark (u, 0, sPad) ;
  FOR i := 0 TO sLen - 1 DO u[8 + i] := sb[i] END ;
  pos := 8 + sPad ;
  PutMark (u, pos, bPad) ;
  FOR i := 0 TO bLen - 1 DO u[pos + 8 + i] := f.b[f.head + i] END ;
  pos := pos + 8 + bPad ;
  PutMark (u, pos + bodyLen, 0) ;        (* end of stream *)
  RETURN u
END Framed ;

PROCEDURE Stream (VAR pool: POOL ; t: PTR Table) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange =
VAR
  bufOff, bufLen : SLICE OF I64 ;
  u : SLICE OF BYTE ;
  c : OPT PTR Col ;
  i, k, nbuf, at, bodyLen, pos, w : I64 ;
BEGIN
  (* ---- the body is laid out FIRST: the batch must name every
     buffer by (offset, length), so the layout has to exist before
     the metadata that describes it ---- *)
  nbuf := NBuf (t) ;
  bufOff := NEW (pool, I64, nbuf + 1) ;
  bufLen := NEW (pool, I64, nbuf + 1) ;
  at := 0 ; k := 0 ;
  c := t.firstC ;
  WHILE c IS SOME cc DO
    (* the validity buffer: present, EMPTY, null_count zero *)
    bufOff[k] := at ; bufLen[k] := 0 ; k := k + 1 ;
    IF cc.ty = TyStr THEN
      bufOff[k] := at ; bufLen[k] := 4 * (t.rows + 1) ; k := k + 1 ;
      at := at + Pad8 (4 * (t.rows + 1)) ;
      bufOff[k] := at ; bufLen[k] := cc.dlen ; k := k + 1 ;
      at := at + Pad8 (cc.dlen)
    ELSE
      bufOff[k] := at ; bufLen[k] := Width (cc.ty) * t.rows ; k := k + 1 ;
      at := at + Pad8 (Width (cc.ty) * t.rows)
    END ;
    c := cc.next
  END ;
  bodyLen := at ;
  u := Framed (pool, t, bufOff, bufLen, nbuf, bodyLen, CodecNone, pos) ;

  (* ---- the body ---- *)
  k := 0 ;
  c := t.firstC ;
  WHILE c IS SOME cc DO
    k := k + 1 ;                         (* past the empty validity *)
    IF cc.ty = TyStr THEN
      at := pos + bufOff[k] ;
      FOR i := 0 TO t.rows DO
        PutLE (u, at + 4 * i, cc.soff[i], 4)
      END ;
      k := k + 1 ;
      at := pos + bufOff[k] ;
      FOR i := 0 TO cc.dlen - 1 DO
        u[at + i] := cc.sdata[i]
      END ;
      k := k + 1
    ELSE
      at := pos + bufOff[k] ;
      w := Width (cc.ty) ;
      IF cc.ty = TyF32 THEN
        FOR i := 0 TO t.rows - 1 DO
          F32.ToBytesLE (cc.f4[i], SLICE (u, at + 4 * i, 4))
        END
      ELSIF cc.ty = TyF64 THEN
        FOR i := 0 TO t.rows - 1 DO
          F64.ToBytesLE (cc.f8[i], SLICE (u, at + 8 * i, 8))
        END
      ELSE
        FOR i := 0 TO t.rows - 1 DO
          PutLE (u, at + w * i, cc.iv[i], w)
        END
      END ;
      k := k + 1
    END ;
    c := cc.next
  END ;
  RETURN u
END Stream ;

(* ---- the compressed body ---- *)

TYPE
  Packed = RECORD
    b : SLICE OF BYTE ;                  (* one buffer, as the wire has it *)
  END ;

PROCEDURE RawOf (VAR pool: POOL ; cc: PTR Col ; rows, part: I64)
  : SLICE OF BYTE
  RAISES ValueRange, IndexError =
  (* a column's buffer as Stream writes it into the body: part 1 is
     the values (or a string's offsets), part 2 a string's data.  The
     data is the column's own bytes, answered as they are. *)
VAR u : SLICE OF BYTE ; i, w : I64 ;
BEGIN
  IF cc.ty = TyStr THEN
    IF part = 2 THEN RETURN cc.sdata END ;
    u := NEW (pool, BYTE, 4 * (rows + 1)) ;
    FOR i := 0 TO rows DO PutLE (u, 4 * i, cc.soff[i], 4) END ;
    RETURN u
  END ;
  w := Width (cc.ty) ;
  u := NEW (pool, BYTE, w * rows) ;
  IF cc.ty = TyF32 THEN
    FOR i := 0 TO rows - 1 DO F32.ToBytesLE (cc.f4[i], SLICE (u, 4 * i, 4)) END
  ELSIF cc.ty = TyF64 THEN
    FOR i := 0 TO rows - 1 DO F64.ToBytesLE (cc.f8[i], SLICE (u, 8 * i, 8)) END
  ELSE
    FOR i := 0 TO rows - 1 DO PutLE (u, w * i, cc.iv[i], w) END
  END ;
  RETURN u
END RawOf ;

PROCEDURE Pack (VAR pool: POOL ; cc: PTR Col ; rows, part, level: I64)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* one buffer compressed: its uncompressed length as 8 little-endian
     bytes, then the zstd frame -- or -1 and the raw bytes, for a
     buffer zstd does not make smaller.  The raw bytes and zstd's room
     live in this procedure's own pool, so a column costs the caller
     only what goes on the wire. *)
VAR
  sp : POOL ;
  raw, z, out : SLICE OF BYTE ;
  cap, got, i : I64 ;
BEGIN
  raw := RawOf (sp, cc, rows, part) ;
  IF LEN (raw) = 0 THEN RETURN NEW (pool, BYTE, 0) END ;
  cap := ZBound (LEN (raw)) ;
  z := NEW (sp, BYTE, cap) ;
  got := ZCompress (z, raw, level) ;
  IF got < LEN (raw) THEN
    out := NEW (pool, BYTE, 8 + got) ;
    PutLE (out, 0, LEN (raw), 8) ;
    FOR i := 0 TO got - 1 DO out[8 + i] := z[i] END
  ELSE
    out := NEW (pool, BYTE, 8 + LEN (raw)) ;
    PutLE (out, 0, -1, 8) ;
    FOR i := 0 TO LEN (raw) - 1 DO out[8 + i] := raw[i] END
  END ;
  RETURN out
END Pack ;

PROCEDURE ZBound (n: I64) : I64 RAISES Faults.BadArg =
BEGIN
  RETURN I64 (ZstdBound (C.SizeT (n)))
EXCEPT
| ValueRange : RAISE Faults.BadArg ('arrow: libzstd will not bound a buffer')
END ZBound ;

PROCEDURE ZCompress (VAR z: SLICE OF BYTE ; RO raw: SLICE OF BYTE ;
                     level: I64) : I64
  RAISES Faults.BadArg =
  (* libzstd's answer, or BadArg by name: an error is a size_t near
     2 ** 64, which I64 () refuses -- and so is a size past the room *)
VAR got : I64 ;
BEGIN
  got := I64 (ZstdCompress (ADR (z), C.SizeT (LEN (z)), ADR (raw),
                            C.SizeT (LEN (raw)), C.Int (level))) ;
  IF got > LEN (z) THEN RAISE Faults.BadArg ('arrow: libzstd refused a buffer') END ;
  RETURN got
EXCEPT
| ValueRange : RAISE Faults.BadArg ('arrow: libzstd refused a buffer')
END ZCompress ;

PROCEDURE StreamCodec (VAR pool: POOL ; t: PTR Table ; codec, level: I64)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange =
VAR
  bufOff, bufLen : SLICE OF I64 ;
  pk : SLICE OF Packed ;
  u : SLICE OF BYTE ;
  c : OPT PTR Col ;
  i, k, nbuf, at, bodyLen, pos : I64 ;
BEGIN
  IF codec = CodecNone THEN RETURN Stream (pool, t) END ;
  IF codec # CodecZstd THEN
    RAISE Faults.BadArg ('arrow: a codec this writer does not write')
  END ;
  IF level < 1 OR level > 22 THEN
    RAISE Faults.BadArg ('arrow: a zstd level outside 1 .. 22')
  END ;
  (* ---- every buffer packed FIRST: the layout is the packed lengths,
     and the batch must name every buffer by (offset, length) ---- *)
  nbuf := NBuf (t) ;
  bufOff := NEW (pool, I64, nbuf + 1) ;
  bufLen := NEW (pool, I64, nbuf + 1) ;
  pk := NEW (pool, Packed, nbuf + 1) ;
  at := 0 ; k := 0 ;
  c := t.firstC ;
  WHILE c IS SOME cc DO
    (* the validity buffer: present, EMPTY, and an empty buffer is
       not compressed -- there is nothing to say its length with *)
    bufOff[k] := at ; bufLen[k] := 0 ; k := k + 1 ;
    pk[k].b := Pack (pool, cc, t.rows, 1, level) ;
    bufOff[k] := at ; bufLen[k] := LEN (pk[k].b) ;
    at := at + Pad8 (bufLen[k]) ; k := k + 1 ;
    IF cc.ty = TyStr THEN
      pk[k].b := Pack (pool, cc, t.rows, 2, level) ;
      bufOff[k] := at ; bufLen[k] := LEN (pk[k].b) ;
      at := at + Pad8 (bufLen[k]) ; k := k + 1
    END ;
    c := cc.next
  END ;
  bodyLen := at ;
  u := Framed (pool, t, bufOff, bufLen, nbuf, bodyLen, CodecZstd, pos) ;
  FOR k := 0 TO nbuf - 1 DO
    FOR i := 0 TO bufLen[k] - 1 DO u[pos + bufOff[k] + i] := pk[k].b[i] END
  END ;
  RETURN u
EXCEPT
| IndexError : RAISE Faults.BadArg ('arrow: a buffer outgrew its layout')
END StreamCodec ;


(* ---- READING (2026-10-30) ----

   THE FLATBUFFER, READ.  A table starts with a signed 32-bit offset
   BACK to its vtable (table - offset); the vtable is u16 its own size,
   u16 the table's, then one u16 per field: the field's offset in the
   table, 0 when absent.  A string, vector or sub-table field holds a
   u32 offset FORWARD from where it is written.  A vector is u32 its
   length and then its elements; a vector of tables holds offsets, a
   vector of structs the structs themselves.  The field numbers are
   Message.fbs and Schema.fbs's, written at each use. *)

TYPE
  Bytes = SLICE OF BYTE ;
  Bufs = SLICE OF Bytes ;

  Reader = RECORD
    RO src : SLICE OF BYTE ;
    pos, nf, nm, rows : I64 ;
    fname, ftz, mk, mv : SLICE OF STR ;
    fty, nulls : SLICE OF I64 ;
    valid, offs, data : Bufs ;
    ended : BOOL ;
  END ;

CONST
  MsgSchema = 1 ;                        (* MessageHeader union *)
  MsgDict = 2 ;
  MsgBatch = 3 ;

(* k little-endian bytes at `at' as an unsigned number (k <= 7), or as
   a two's complement one when signed -- an 8-byte value is always
   read signed, the negative ones through their complement so the sum
   stays inside I64 *)
PROCEDURE GetLE (RO b: SLICE OF BYTE ; at, k: I64 ; signed: BOOL) : I64
  RAISES IndexError =
VAR i, v : I64 ;
BEGIN
  IF (signed OR k = 8) AND I64 (b[at + k - 1]) >= 128 THEN
    v := 0 ;
    FOR i := k - 1 TO 0 BY -1 DO v := v * 256 + (255 - I64 (b[at + i])) END ;
    RETURN -v - 1
  END ;
  v := 0 ;
  FOR i := k - 1 TO 0 BY -1 DO v := v * 256 + I64 (b[at + i]) END ;
  RETURN v
EXCEPT
| ValueRange : RAISE IndexError
| Overflow : RAISE IndexError
END GetLE ;

(* field `id' of the table at `tbl': its position, or -1 when absent *)
PROCEDURE FbField (RO m: SLICE OF BYTE ; tbl, id: I64) : I64 RAISES IndexError =
VAR vt, vsize, o : I64 ;
BEGIN
  vt := tbl - GetLE (m, tbl, 4, TRUE) ;
  vsize := GetLE (m, vt, 2, FALSE) ;
  IF 4 + 2 * id + 2 > vsize THEN RETURN -1 END ;
  o := GetLE (m, vt + 4 + 2 * id, 2, FALSE) ;
  IF o = 0 THEN RETURN -1 END ;
  RETURN tbl + o
END FbField ;

(* where the offset at `at' points *)
PROCEDURE FbRef (RO m: SLICE OF BYTE ; at: I64) : I64 RAISES IndexError =
BEGIN
  RETURN at + GetLE (m, at, 4, FALSE)
END FbRef ;

(* a scalar field, or dflt when absent *)
PROCEDURE FbInt (RO m: SLICE OF BYTE ; tbl, id, k: I64 ; signed: BOOL ; dflt: I64) : I64
  RAISES IndexError =
VAR at : I64 ;
BEGIN
  at := FbField (m, tbl, id) ;
  IF at < 0 THEN RETURN dflt END ;
  RETURN GetLE (m, at, k, signed)
END FbInt ;

(* a string field, decoded; '' when absent *)
PROCEDURE FbStr (VAR pool: POOL ; RO m: SLICE OF BYTE ; tbl, id: I64) : STR
  RAISES IndexError, ValueRange =
VAR at, n : I64 ;
BEGIN
  at := FbField (m, tbl, id) ;
  IF at < 0 THEN RETURN '' END ;
  at := FbRef (m, at) ;
  n := GetLE (m, at, 4, FALSE) ;
  RETURN DynStr.FromUtf8 (pool, SLICE (m, at + 4, n))
END FbStr ;

(* a vector field: its first element's position, its length in n;
   -1 and 0 when absent *)
PROCEDURE FbVec (RO m: SLICE OF BYTE ; tbl, id: I64 ; VAR n: I64) : I64
  RAISES IndexError =
VAR at : I64 ;
BEGIN
  n := 0 ;
  at := FbField (m, tbl, id) ;
  IF at < 0 THEN RETURN -1 END ;
  at := FbRef (m, at) ;
  n := GetLE (m, at, 4, FALSE) ;
  RETURN at + 4
END FbVec ;

(* the next message: its metadata in meta, its body in body; FALSE at
   the end-of-stream marker or where the bytes run out *)
PROCEDURE NextMsg (VAR r: PTR Reader ; VAR meta: SLICE OF BYTE ;
                   VAR body: SLICE OF BYTE ; VAR kind: I64) : BOOL
  RAISES Faults.BadArg =
VAR len, root, hdr, blen : I64 ;
BEGIN
  IF r.pos + 4 > LEN (r.src) THEN RETURN FALSE END ;
  len := GetLE (r.src, r.pos, 4, TRUE) ;
  r.pos := r.pos + 4 ;
  IF len = -1 THEN                       (* the continuation marker *)
    IF r.pos + 4 > LEN (r.src) THEN RETURN FALSE END ;
    len := GetLE (r.src, r.pos, 4, TRUE) ;
    r.pos := r.pos + 4
  END ;
  IF len = 0 THEN RETURN FALSE END ;
  IF len < 0 OR r.pos + len > LEN (r.src) THEN
    RAISE Faults.BadArg ('arrow: a message runs past the stream')
  END ;
  meta := SLICE (r.src, r.pos, len) ;
  r.pos := r.pos + len ;
  root := GetLE (meta, 0, 4, FALSE) ;
  kind := FbInt (meta, root, 1, 1, FALSE, 0) ;      (* Message.header_type *)
  blen := FbInt (meta, root, 3, 8, TRUE, 0) ;       (* Message.bodyLength *)
  IF blen < 0 OR r.pos + blen > LEN (r.src) THEN
    RAISE Faults.BadArg ('arrow: a message body runs past the stream')
  END ;
  body := SLICE (r.src, r.pos, blen) ;
  r.pos := r.pos + blen ;
  hdr := FbField (meta, root, 2) ;
  IF hdr < 0 THEN RAISE Faults.BadArg ('arrow: a message without its header') END ;
  RETURN TRUE
EXCEPT
| IndexError : RAISE Faults.BadArg ('arrow: a message is cut short')
END NextMsg ;

(* the message header table: Message.header *)
PROCEDURE Header (RO meta: SLICE OF BYTE) : I64 RAISES IndexError =
BEGIN
  RETURN FbRef (meta, FbField (meta, GetLE (meta, 0, 4, FALSE), 2))
END Header ;

(* one Field of the schema into slot i, or BadArg naming what this
   reader does not read *)
PROCEDURE SchemaField (VAR pool: POOL ; VAR r: PTR Reader ; RO m: SLICE OF BYTE ;
                       f, i: I64)
  RAISES Faults.BadArg, IndexError, ValueRange =
VAR
  tt, ty, bits, prec, unit, nkids : I64 ;
  name : STR ;
BEGIN
  name := FbStr (pool, m, f, 0) ;                    (* Field.name *)
  IF FbField (m, f, 4) >= 0 THEN                     (* Field.dictionary *)
    RAISE Faults.BadArg ('arrow: column ' + name + ' is dictionary-encoded, which is not read')
  END ;
  IF FbVec (m, f, 5, nkids) >= 0 AND nkids > 0 THEN  (* Field.children *)
    RAISE Faults.BadArg ('arrow: column ' + name + ' is nested, which is not read')
  END ;
  tt := FbInt (m, f, 2, 1, FALSE, 0) ;               (* Field.type_type *)
  ty := FbRef (m, FbField (m, f, 3)) ;               (* Field.type *)
  r.ftz[i] := '' ;
  IF tt = 2 THEN                                     (* Int *)
    bits := FbInt (m, ty, 0, 4, TRUE, 0) ;
    IF FbInt (m, ty, 1, 1, FALSE, 0) = 0 THEN
      RAISE Faults.BadArg ('arrow: column ' + name + ' is an unsigned integer, which is not read')
    END ;
    IF bits = 8 THEN r.fty[i] := TyI8
    ELSIF bits = 16 THEN r.fty[i] := TyI16
    ELSIF bits = 32 THEN r.fty[i] := TyI32
    ELSIF bits = 64 THEN r.fty[i] := TyI64
    ELSE RAISE Faults.BadArg ('arrow: column ' + name + ' has an integer width this reader does not know')
    END
  ELSIF tt = 3 THEN                                  (* FloatingPoint *)
    prec := FbInt (m, ty, 0, 2, TRUE, 0) ;
    IF prec = 1 THEN r.fty[i] := TyF32
    ELSIF prec = 2 THEN r.fty[i] := TyF64
    ELSE RAISE Faults.BadArg ('arrow: column ' + name + ' is a half float, which is not read')
    END
  ELSIF tt = 5 THEN                                  (* Utf8 *)
    r.fty[i] := TyStr
  ELSIF tt = 10 THEN                                 (* Timestamp *)
    unit := FbInt (m, ty, 0, 2, TRUE, 0) ;
    IF unit # 3 THEN
      RAISE Faults.BadArg ('arrow: column ' + name + ' is a timestamp not in nanoseconds, which is not read')
    END ;
    r.fty[i] := TyTsNs ;
    r.ftz[i] := FbStr (pool, m, ty, 1)
  ELSE
    RAISE Faults.BadArg ('arrow: column ' + name + ' has a type this reader does not read')
  END ;
  r.fname[i] := name
END SchemaField ;

PROCEDURE Open (VAR pool: POOL ; RO KEPT src: SLICE OF BYTE)
  : PTR Reader IN pool
  RAISES Faults.BadArg, ValueRange =
VAR
  r : PTR Reader IN pool ;
  meta, body : SLICE OF BYTE ;
  kind, sc, fv, n, mvec, nmeta, i, kv : I64 ;
BEGIN
  r := NEW (pool, Reader) ;
  r.src := src ;
  r.pos := 0 ;
  r.rows := 0 ;
  r.ended := FALSE ;
  IF NOT NextMsg (r, meta, body, kind) OR kind # MsgSchema THEN
    RAISE Faults.BadArg ('arrow: the stream does not start with a schema')
  END ;
  sc := Header (meta) ;
  IF FbInt (meta, sc, 0, 2, TRUE, 0) # 0 THEN        (* Schema.endianness *)
    RAISE Faults.BadArg ('arrow: a big-endian stream is not read')
  END ;
  fv := FbVec (meta, sc, 1, n) ;                     (* Schema.fields *)
  r.nf := n ;
  r.fname := NEW (pool, STR, n) ;
  r.ftz := NEW (pool, STR, n) ;
  r.fty := NEW (pool, I64, n) ;
  r.nulls := NEW (pool, I64, n) ;
  r.valid := NEW (pool, Bytes, n) ;
  r.offs := NEW (pool, Bytes, n) ;
  r.data := NEW (pool, Bytes, n) ;
  FOR i := 0 TO n - 1 DO
    SchemaField (pool, r, meta, FbRef (meta, fv + 4 * i), i)
  END ;
  mvec := FbVec (meta, sc, 2, nmeta) ;               (* Schema.custom_metadata *)
  r.nm := nmeta ;
  r.mk := NEW (pool, STR, nmeta) ;
  r.mv := NEW (pool, STR, nmeta) ;
  FOR i := 0 TO nmeta - 1 DO
    kv := FbRef (meta, mvec + 4 * i) ;
    r.mk[i] := FbStr (pool, meta, kv, 0) ;           (* KeyValue.key *)
    r.mv[i] := FbStr (pool, meta, kv, 1)             (* KeyValue.value *)
  END ;
  RETURN r
EXCEPT
| IndexError : RAISE Faults.BadArg ('arrow: the schema is cut short')
END Open ;

PROCEDURE NFields (r: PTR Reader) : I64 =
BEGIN
  RETURN r.nf
END NFields ;

PROCEDURE FieldName (r: PTR Reader ; i: I64) : STR RAISES IndexError =
BEGIN
  RETURN r.fname[i]
END FieldName ;

PROCEDURE FieldType (r: PTR Reader ; i: I64) : I64 RAISES IndexError =
BEGIN
  RETURN r.fty[i]
END FieldType ;

PROCEDURE FieldTz (r: PTR Reader ; i: I64) : STR RAISES IndexError =
BEGIN
  RETURN r.ftz[i]
END FieldTz ;

PROCEDURE MetaOf (r: PTR Reader ; RO key: STR) : STR =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO r.nm - 1 DO
    IF DynStr.Eq (r.mk[i], key) THEN RETURN r.mv[i] END
  END ;
  RETURN ''
END MetaOf ;

(* buffer (off, len) of a batch's body, as its own bytes in the
   reader's pool: copied, or -- under ZSTD -- its 8-byte uncompressed
   length and one frame decompressed, or the bytes after a length of
   -1 as they were *)
PROCEDURE Buf (VAR r: PTR Reader ; RO body: SLICE OF BYTE ; off, len: I64 ; zstd: BOOL)
  : SLICE OF BYTE
  RAISES Faults.BadArg, IndexError =
VAR
  out, z : SLICE OF BYTE ;
  ulen, got, i : I64 ;
BEGIN
  IF len = 0 THEN RETURN NEW (r, BYTE, 0) END ;
  IF off < 0 OR len < 0 OR off + len > LEN (body) THEN
    RAISE Faults.BadArg ('arrow: a buffer runs past its batch')
  END ;
  IF NOT zstd THEN
    out := NEW (r, BYTE, len) ;
    FOR i := 0 TO len - 1 DO out[i] := body[off + i] END ;
    RETURN out
  END ;
  ulen := GetLE (body, off, 8, TRUE) ;
  IF ulen = -1 THEN
    out := NEW (r, BYTE, len - 8) ;
    FOR i := 0 TO len - 9 DO out[i] := body[off + 8 + i] END ;
    RETURN out
  END ;
  IF ulen < 0 THEN RAISE Faults.BadArg ('arrow: a buffer says a negative length') END ;
  out := NEW (r, BYTE, ulen) ;
  IF ulen = 0 THEN RETURN out END ;
  z := SLICE (body, off + 8, len - 8) ;
  got := I64 (ZstdDecompress (ADR (out), C.SizeT (ulen), ADR (z), C.SizeT (len - 8))) ;
  IF got # ulen THEN RAISE Faults.BadArg ('arrow: libzstd refused a buffer') END ;
  RETURN out
EXCEPT
| ValueRange : RAISE Faults.BadArg ('arrow: libzstd refused a buffer')
END Buf ;

PROCEDURE Next (VAR r: PTR Reader) : BOOL
  RAISES Faults.BadArg, ValueRange =
VAR
  meta, body : SLICE OF BYTE ;
  kind, rb, nodes, nn, bufs, nb, comp, b, j, k, nbuf, bo, bl : I64 ;
  zstd : BOOL ;
BEGIN
  IF r.ended THEN RETURN FALSE END ;
  IF NOT NextMsg (r, meta, body, kind) THEN
    r.ended := TRUE ;
    r.rows := 0 ;
    RETURN FALSE
  END ;
  IF kind = MsgDict THEN RAISE Faults.BadArg ('arrow: a dictionary batch is not read') END ;
  IF kind # MsgBatch THEN RAISE Faults.BadArg ('arrow: a message that is no record batch') END ;
  rb := Header (meta) ;
  r.rows := FbInt (meta, rb, 0, 8, TRUE, 0) ;        (* RecordBatch.length *)
  nodes := FbVec (meta, rb, 1, nn) ;                 (* RecordBatch.nodes *)
  bufs := FbVec (meta, rb, 2, nb) ;                  (* RecordBatch.buffers *)
  zstd := FALSE ;
  comp := FbField (meta, rb, 3) ;                    (* RecordBatch.compression *)
  IF comp >= 0 THEN
    comp := FbRef (meta, comp) ;
    IF FbInt (meta, comp, 0, 1, TRUE, 0) = 1 THEN zstd := TRUE    (* BodyCompression.codec *)
    ELSE RAISE Faults.BadArg ('arrow: an LZ4 batch is not read')
    END
  END ;
  IF nn # r.nf THEN RAISE Faults.BadArg ("arrow: a batch whose columns are not the schema's") END ;
  nbuf := 0 ;
  FOR j := 0 TO r.nf - 1 DO
    IF r.fty[j] = TyStr THEN nbuf := nbuf + 3 ELSE nbuf := nbuf + 2 END
  END ;
  IF nb # nbuf THEN RAISE Faults.BadArg ("arrow: a batch whose buffers are not the schema's") END ;
  b := 0 ;
  FOR j := 0 TO r.nf - 1 DO
    (* FieldNode: length, null_count, 16 bytes; Buffer: offset, length *)
    IF GetLE (meta, nodes + 16 * j, 8, TRUE) # r.rows THEN
      RAISE Faults.BadArg ("arrow: a column whose length is not the batch's")
    END ;
    r.nulls[j] := GetLE (meta, nodes + 16 * j + 8, 8, TRUE) ;
    FOR k := 0 TO 2 DO
      IF k < 2 OR r.fty[j] = TyStr THEN
        bo := GetLE (meta, bufs + 16 * b, 8, TRUE) ;
        bl := GetLE (meta, bufs + 16 * b + 8, 8, TRUE) ;
        IF k = 0 THEN r.valid[j] := Buf (r, body, bo, bl, zstd)
        ELSIF k = 1 AND r.fty[j] = TyStr THEN r.offs[j] := Buf (r, body, bo, bl, zstd)
        ELSE r.data[j] := Buf (r, body, bo, bl, zstd)
        END ;
        b := b + 1
      END
    END
  END ;
  RETURN TRUE
EXCEPT
| IndexError : RAISE Faults.BadArg ('arrow: a record batch is cut short')
END Next ;

PROCEDURE Rows (r: PTR Reader) : I64 =
BEGIN
  RETURN r.rows
END Rows ;

PROCEDURE Nulls (r: PTR Reader ; i: I64) : I64 RAISES IndexError =
BEGIN
  RETURN r.nulls[i]
END Nulls ;

PROCEDURE IsNull (r: PTR Reader ; i, row: I64) : BOOL RAISES IndexError =
VAR v, k : I64 ;
BEGIN
  IF row < 0 OR row >= r.rows THEN RAISE IndexError END ;
  IF r.nulls[i] = 0 OR LEN (r.valid[i]) = 0 THEN RETURN FALSE END ;
  v := I64 (r.valid[i][row DIV 8]) ;
  FOR k := 1 TO row MOD 8 DO v := v DIV 2 END ;
  RETURN v MOD 2 = 0
EXCEPT
| ValueRange : RAISE IndexError
END IsNull ;

PROCEDURE GetF64 (VAR pool: POOL ; r: PTR Reader ; i: I64) : SLICE OF F64
  RAISES Faults.BadArg, IndexError =
VAR
  out : SLICE OF F64 ;
  k : I64 ;
BEGIN
  IF r.fty[i] # TyF64 AND r.fty[i] # TyF32 THEN
    RAISE Faults.BadArg ('arrow: column ' + r.fname[i] + ' is not a float column')
  END ;
  out := NEW (pool, F64, r.rows) ;
  FOR k := 0 TO r.rows - 1 DO
    IF IsNull (r, i, k) THEN out[k] := NaN
    ELSIF r.fty[i] = TyF64 THEN out[k] := F64.FromBytesLE (SLICE (r.data[i], 8 * k, 8))
    ELSE out[k] := F64 (F32.FromBytesLE (SLICE (r.data[i], 4 * k, 4)))
    END
  END ;
  RETURN out
EXCEPT
| ValueRange : RAISE Faults.BadArg ('arrow: column ' + r.fname[i] + ' holds a value F64 cannot')
END GetF64 ;

(* the width of an integer or timestamp column's cells *)
PROCEDURE IntWidth (ty: I64) : I64 =
BEGIN
  IF ty = TyI8 THEN RETURN 1 END ;
  IF ty = TyI16 THEN RETURN 2 END ;
  IF ty = TyI32 THEN RETURN 4 END ;
  IF ty = TyI64 OR ty = TyTsNs THEN RETURN 8 END ;
  RETURN 0
END IntWidth ;

PROCEDURE GetI64 (VAR pool: POOL ; r: PTR Reader ; i: I64) : SLICE OF I64
  RAISES Faults.BadArg, IndexError =
VAR
  out : SLICE OF I64 ;
  k, w : I64 ;
BEGIN
  w := IntWidth (r.fty[i]) ;
  IF w = 0 THEN RAISE Faults.BadArg ('arrow: column ' + r.fname[i] + ' is not an integer or timestamp column') END ;
  out := NEW (pool, I64, r.rows) ;
  FOR k := 0 TO r.rows - 1 DO
    IF IsNull (r, i, k) THEN out[k] := 0
    ELSE out[k] := GetLE (r.data[i], w * k, w, TRUE)
    END
  END ;
  RETURN out
END GetI64 ;

PROCEDURE GetStr (VAR pool: POOL ; r: PTR Reader ; i, row: I64) : STR
  RAISES Faults.BadArg, IndexError, ValueRange =
VAR a, b : I64 ;
BEGIN
  IF r.fty[i] # TyStr THEN RAISE Faults.BadArg ('arrow: column ' + r.fname[i] + ' is not a string column') END ;
  IF IsNull (r, i, row) THEN RETURN '' END ;
  a := GetLE (r.offs[i], 4 * row, 4, TRUE) ;
  b := GetLE (r.offs[i], 4 * row + 4, 4, TRUE) ;
  IF a < 0 OR b < a OR b > LEN (r.data[i]) THEN
    RAISE Faults.BadArg ('arrow: column ' + r.fname[i] + ' has offsets past its data')
  END ;
  RETURN DynStr.FromUtf8 (pool, SLICE (r.data[i], a, b - a))
END GetStr ;

END Arrow.
