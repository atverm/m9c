STATEFUL DEFINITION MODULE Gen ;

(* The C11 code generator, in M9 -- restated from host/fpc/M9Gen.pas
   for P5 stage 2.  The FPC generator is the differential oracle:
   both must emit byte-identical .h and .c for every corpus module,
   including this one.  Faithfulness outranks taste: the oracle's
   warts are replicated deliberately (TagOfExpr recomputes via DES
   and CallC WITH their side effects -- temp counters, literal pool
   entries -- so those side effects are part of the bytes).
   Errors are counted; the message table is stage-2 driver work.
   One generator instance per process: state is module-level and the
   pool is never reset, exactly one module per run.                  *)

IMPORT Ast ;

PROCEDURE LoadUnit (KEPT u: PTR Ast.Node) ;
PROCEDURE LoadExtern (KEPT u: PTR Ast.Node) ;
  (* a DIRECT import: register its declarations and include its
     header, because this module names things in it *)

PROCEDURE LoadExternDeep (KEPT u: PTR Ast.Node) ;
  (* a dependency of a dependency: register its declarations so a
     callee's signature can be RESOLVED -- Qvsat.Ew answers a
     Kind.FlexFloat and its caller has no business importing Kind --
     but emit no #include, because this module names nothing in it.

     The third closure.  The checker wants the transitive one, the
     generator's INCLUDE list wants the direct one, and between them
     was a hole: a direct dependency's signature may name a type from
     a module this one does not import.  It resolved to nothing and,
     until the guard went in, became integer arithmetic. *)
PROCEDURE SetPrefix (RO KEPT module: STR ; RO KEPT prefix: STR) ;
  (* emit module MODULE's C names -- its procedures, initialiser,
     exceptions, exported variables and types -- under PREFIX instead
     of the module's name: one generation of a notebook state cell,
     run again, beside the generation before it in one process
     (docs/notebook-state-plan.md phase 2).  Without a call, every
     name is the module's own and the C is what it always was. *)

PROCEDURE SetDebugSource (RO KEPT file: STR) ;
  (* Emit `#line` directives naming FILE, so a debugger and a
     backtrace report the M9 source rather than the generated C.
     Call it before Emit; the empty string turns it off, which is
     the default and is what every gate compares.  m9c calls this
     under -g and only under -g: the C emitted without it is
     byte-for-byte what it always was, which is what keeps gendiff
     and the bootstrap fixpoint meaningful.                        *)

PROCEDURE Emit (RO forModule: STR) ;
PROCEDURE HText () : STR ;
PROCEDURE CText () : STR ;
PROCEDURE Errs () : I64 ;
PROCEDURE ErrLineAt (i: I64) : I64 ;
PROCEDURE ErrMsgAt (i: I64) : STR ;
  (* the first eight generator errors, with source lines: a count
     alone cost a bisect every time a module was written outside the
     corpus, and then cost one INSIDE the tutorial.  i in
     0 .. MIN (Errs (), 8) - 1; msgs may be '' where a site has no
     wording yet.                                                    *)

END Gen.


IMPLEMENTATION MODULE Gen ;

IMPORT Ast ;
IMPORT DynStr ;
IMPORT Text ;

CONST
  (* output buffers, selected by number: DynStr.Append takes VAR d and
     may reallocate, so a buffer may never be aliased into a local --
     the module var itself must be the one that is updated.           *)
  KHdr = 0 ;   KSrc = 1 ;   KTdefs = 2 ;   KPbuf = 3 ; KSprotos = 4 ;
  KLit = 5 ;   KHdrRecs = 6 ; KHdrProtos = 7 ; KHdrConsts = 8 ;
  KRec2 = 9 ; KThr = 10 ;   (* THREAD trampolines *)
  KGate = 11 ;              (* one m9_mon per [SERIAL] FOR-C unit *)
  (* an ARRAY OF a record of this module is typedef'd AFTER the struct
     it contains -- in the C file for a private record, the header for
     a transparent one -- and the statics, constant data and exported
     pointers that may use it after that (2026-10-05; until then the
     typedef went to tdefs, ahead of every struct, and an array of
     records did not compile: "incomplete element type") *)
  KArrRec = 12 ; KHdrArrRec = 13 ; KRec3 = 14 ;

TYPE
  AKid = Ast.Kid ;                   (* named so NEW can say it *)

  MEnt = RECORD
    k, t : STR ;
    v : Ast.Kid ;
  END ;

  Map = RECORD
    es : SLICE OF MEnt ;
    n : I64 ;
  END ;

  GP = RECORD
    name : STR ;
    node, body : Ast.Kid ;
    exported : BOOL ;
  END ;

  TY = RECORD
    name : STR ;
    node : Ast.Kid ;
    opq, fdef : BOOL ;
  END ;

  XC = RECORD
    name : STR ;
    fields : Ast.Kid ;
    fdef : BOOL ;
  END ;

VAR
  gpool : POOL ;
  modName : STR ;
  dbgSrc : STR ;           (* SetDebugSource; empty = no #line *)
  pfxMod, pfxC : SLICE OF STR ;  (* SetPrefix: module -> C prefix *)
  npfx : I64 ;
  constsBase : I64 ;       (* consts below this are the module's; at
                              or above it, the procedure's own *)
  inited : BOOL ;
  nerrV, tmpN, inSwitch, finDepth : I64 ;
  dry : I64 ;              (* >0 inside TagOfExpr's recomputation:
                              answering a type must not emit code
                              (dead string literals otherwise)      *)
  litN, tdefN, sprotoN, hdrConstN : I64 ;
  stRaise : BOOL ;
  hoistOk : BOOL ;         (* HoistArg may emit: inside an assignment,
                              a call statement or a RETURN *)
  hoistInd, nhoist, hoistOpen : I64 ;
  curRetTag, exitLbl, raiseLbl, curRetq : STR ;
  hOut, cOut : STR ;

  consts, extProcs, extTypes, extConsts, extMods, extExcs : Map ;
  extVars : Map ;          (* Mod.v -> its type, qualified in Mod: the
                              imported module variables (decision 28) *)
  foreignProcs, arrSeen, thrSeen, gateSeen, scope : Map ;
  gps : SLICE OF GP ;
  ngps : I64 ;
  tys : SLICE OF TY ;
  ntys : I64 ;
  xcs : SLICE OF XC ;
  nxcs : I64 ;
  mvN : SLICE OF STR ;
  mvT : SLICE OF AKid ;
  mvDef : SLICE OF BOOL ;  (* declared in the definition: exported *)
  nmv : I64 ;
  aggT : Map ;             (* constant tables (par 2.2.4): name ->
                              the ARRAY n OF T made for it, *)
  aggV : Map ;             (* and name -> the aggregate itself *)
  lpools : SLICE OF STR ;
  nlp : I64 ;
  outStr : SLICE OF STR ;  (* the VAR/OWN STR parameters, whose
                              targets are re-homed at L_ret *)
  nout : I64 ;
  adoptC : SLICE OF STR ;  (* the VAR/OWN parameters of a pointer-
                              bearing type, whose targets are tested
                              for adoption at L_ret (rule 1) *)
  adoptT : SLICE OF AKid ;
  adoptD : SLICE OF STR ;  (* ... and the pool each is adopted INTO:
                              the caller's arena, or the object's own
                              pool that a VAR parameter carries
                              (rule 2) *)
  nadopt : I64 ;
  mvBase : I64 ;           (* where the module variables start in
                              scope, so a designator's root can be
                              told a module variable from a local *)
  bpool : Map ;            (* binder -> the C expression of the pool
                              its origin lives in (rule 2); the most
                              recent entry of a name is the live one *)
  isProgram : BOOL ;       (* MODULE m -- emit a main () *)
  mainBody : Ast.Kid ;     (* its block *)
  strNode : Ast.Kid ;      (* the STR that STR names *)

  bHdr, bSrc, bTdefs, bPbuf, bSprotos, bLit : PTR DynStr.DString IN gpool ;
  bHdrRecs, bHdrProtos, bHdrConsts, bRec2 : PTR DynStr.DString IN gpool ;
  bArrRec, bHdrArrRec, bRec3 : PTR DynStr.DString IN gpool ;
  bThr, bGate : PTR DynStr.DString IN gpool ;

(* ---- small strings ---- *)

PROCEDURE S2 (RO a: STR ;
              RO b: STR) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  RETURN DynStr.View (d)
END S2 ;

PROCEDURE S3 (RO a: STR ; RO b: STR ;
              RO c: STR) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  RETURN DynStr.View (d)
END S3 ;

PROCEDURE S4 (RO a: STR ; RO b: STR ;
              RO c: STR ; RO e: STR)
  : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  DynStr.Append (d, e) ;
  RETURN DynStr.View (d)
END S4 ;

PROCEDURE S5 (RO a: STR ; RO b: STR ;
              RO c: STR ; RO e: STR ;
              RO f: STR) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  DynStr.Append (d, e) ;
  DynStr.Append (d, f) ;
  RETURN DynStr.View (d)
END S5 ;

PROCEDURE S6 (RO a: STR ; RO b: STR ;
              RO c: STR ; RO e: STR ;
              RO f: STR ; RO g: STR)
  : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  DynStr.Append (d, e) ;
  DynStr.Append (d, f) ;
  DynStr.Append (d, g) ;
  RETURN DynStr.View (d)
END S6 ;

PROCEDURE S7 (RO a: STR ; RO b: STR ;
              RO c: STR ; RO e: STR ;
              RO f: STR ; RO g: STR ;
              RO h: STR) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  DynStr.Append (d, e) ;
  DynStr.Append (d, f) ;
  DynStr.Append (d, g) ;
  DynStr.Append (d, h) ;
  RETURN DynStr.View (d)
END S7 ;

PROCEDURE S9 (RO a: STR ; RO b: STR ;
              RO c: STR ; RO e: STR ;
              RO f: STR ; RO g: STR ;
              RO h: STR ; RO i2: STR ;
              RO j2: STR) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  DynStr.Append (d, e) ;
  DynStr.Append (d, f) ;
  DynStr.Append (d, g) ;
  DynStr.Append (d, h) ;
  DynStr.Append (d, i2) ;
  DynStr.Append (d, j2) ;
  RETURN DynStr.View (d)
END S9 ;

PROCEDURE ItoA (v: I64) : STR =
VAR d : PTR DynStr.DString IN gpool ;
BEGIN
  d := DynStr.New (gpool) ;
  DynStr.AppendI64 (d, v) ;
  RETURN DynStr.View (d)
END ItoA ;

(* register a pool to be freed at L_ret.  Two callers: a local
   `VAR p: POOL`, and the implicit frame arena every procedure gets. *)
PROCEDURE PoolReg (RO KEPT nm: STR) =
VAR nb : SLICE OF STR ;
    k  : I64 ;
BEGIN
  IF nlp = LEN (lpools) THEN
    nb := NEW (gpool, STR, 2 * LEN (lpools)) ;
    FOR k := 0 TO nlp - 1 DO nb[k] := lpools[k] END ;
    lpools := nb
  END ;
  lpools[nlp] := nm ;
  nlp := nlp + 1
END PoolReg ;

(* register a VAR/OWN STR parameter for the exit re-homing *)
PROCEDURE OutReg (RO KEPT nm: STR) =
VAR nb : SLICE OF STR ;
    k  : I64 ;
BEGIN
  IF nout = LEN (outStr) THEN
    nb := NEW (gpool, STR, 2 * LEN (outStr)) ;
    FOR k := 0 TO nout - 1 DO nb[k] := outStr[k] END ;
    outStr := nb
  END ;
  outStr[nout] := nm ;
  nout := nout + 1
END OutReg ;

(* register a VAR/OWN parameter of a pointer-bearing type for the
   exit adoption test (docs/pool-elision-plan.md, rule 1) *)
PROCEDURE AdoptReg (RO KEPT nm: STR ; KEPT t: Ast.Kid ; RO KEPT dst: STR) =
VAR nb, nd : SLICE OF STR ;
    nt : SLICE OF AKid ;
    k  : I64 ;
BEGIN
  IF nadopt = LEN (adoptC) THEN
    nb := NEW (gpool, STR, 2 * LEN (adoptC)) ;
    nd := NEW (gpool, STR, 2 * LEN (adoptC)) ;
    nt := NEW (gpool, AKid, 2 * LEN (adoptC)) ;
    FOR k := 0 TO nadopt - 1 DO
      nb[k] := adoptC[k] ;
      nd[k] := adoptD[k] ;
      nt[k] := adoptT[k]
    END ;
    adoptC := nb ;
    adoptD := nd ;
    adoptT := nt
  END ;
  adoptC[nadopt] := nm ;
  adoptD[nadopt] := dst ;
  adoptT[nadopt] := t ;
  nadopt := nadopt + 1
END AdoptReg ;

PROCEDURE SetPrefix (RO KEPT module: STR ; RO KEPT prefix: STR) =
VAR
  nm, nc : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF npfx = LEN (pfxMod) THEN
    nm := NEW (gpool, STR, 2 * npfx + 4) ;
    nc := NEW (gpool, STR, 2 * npfx + 4) ;
    FOR i := 0 TO npfx - 1 DO nm[i] := pfxMod[i] ; nc[i] := pfxC[i] END ;
    pfxMod := nm ;
    pfxC := nc
  END ;
  pfxMod[npfx] := module ;
  pfxC[npfx] := prefix ;
  npfx := npfx + 1
END SetPrefix ;

(* a module's C prefix: its name, or what SetPrefix gave it *)
PROCEDURE CP (RO m: STR) : STR =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npfx - 1 DO
    IF DynStr.Eq (pfxMod[i], m) THEN RETURN pfxC[i] END
  END ;
  RETURN m
END CP ;

PROCEDURE SetDebugSource (RO KEPT file: STR) =
BEGIN
  dbgSrc := file
END SetDebugSource ;

(* One directive per statement, at column 0 and into the procedure
   buffer, so the C compiler attributes the code that follows to the
   M9 line it came from.  Nothing is emitted when dbgSrc is empty
   (the default) or during TagOfExpr's dry recomputation, which must
   not emit anything at all.                                        *)
PROCEDURE DbgLine (n: PTR Ast.Node) =
BEGIN
  IF dry > 0 THEN RETURN END ;
  IF LEN (dbgSrc) = 0 THEN RETURN END ;
  Line (KPbuf, 0, S5 ('#line ', ItoA (n.line), ' "', dbgSrc, '"')) ;
  (* and record the raise site for an unhandled exception's
     message: one store per statement, under -g only, so hot
     production code (no -g) is untouched and its default C the
     same *)
  Line (KPbuf, 1, S3 ('err->line = ', ItoA (n.line), ';'))
END DbgLine ;

PROCEDURE StartsW (RO s: STR ;
                   RO p: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (s) < LEN (p) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (p) - 1 DO
    IF s[i] # p[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END StartsW ;

PROCEDURE Has (RO s: STR ; c: CHAR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Has ;

PROCEDURE FindCh (RO s: STR ; c: CHAR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN RETURN i END
  END ;
  RETURN -1
END FindCh ;

(* ---- maps and registries ---- *)

PROCEDURE MInit (VAR m: Map) =
BEGIN
  m.es := NEW (gpool, MEnt, 8) ;
  m.n := 0
END MInit ;

PROCEDURE MAdd (VAR m: Map ; RO KEPT k: STR ;
                KEPT v: Ast.Kid ; RO KEPT t: STR) =
VAR
  nb : SLICE OF MEnt ;
  i : I64 ;
BEGIN
  IF m.n = LEN (m.es) THEN
    nb := NEW (gpool, MEnt, 2 * LEN (m.es)) ;
    FOR i := 0 TO m.n - 1 DO nb[i] := m.es[i] END ;
    m.es := nb
  END ;
  m.es[m.n].k := k ;
  m.es[m.n].v := v ;
  m.es[m.n].t := t ;
  m.n := m.n + 1
END MAdd ;

PROCEDURE MFind (VAR m: Map ; RO k: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO m.n - 1 DO
    IF DynStr.Eq (m.es[i].k, k) THEN RETURN i END
  END ;
  RETURN -1
END MFind ;

CONST
  MaxErrs = 8 ;

VAR
  errLines : ARRAY 8 OF I64 ;
  errMsgs  : ARRAY 8 OF STR ;   (* literals or gpool-composed: both
                                   outlive the report *)

PROCEDURE Err2 (line: I64 ; RO KEPT msg: STR) =
BEGIN
  IF nerrV < MaxErrs THEN
    errLines[nerrV] := line ;
    errMsgs[nerrV] := msg
  END ;
  nerrV := nerrV + 1
END Err2 ;

PROCEDURE ErrLineAt (i: I64) : I64 =
BEGIN
  IF i < 0 OR i >= MaxErrs THEN RETURN 0 END ;
  RETURN errLines[i]
END ErrLineAt ;

PROCEDURE ErrMsgAt (i: I64) : STR =
BEGIN
  IF i < 0 OR i >= MaxErrs THEN RETURN '' END ;
  RETURN errMsgs[i]
END ErrMsgAt ;

PROCEDURE Setup () =
VAR
  ch, sn : PTR Ast.Node IN gpool ;
BEGIN
  IF inited THEN RETURN END ;
  inited := TRUE ;
  ch := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
  ch.a := 'CHAR' ;
  sn := Ast.NewNode (gpool, Ast.NSliceType, 0, 0) ;
  Ast.Add (gpool, sn, SOME (ch)) ;
  strNode := SOME (sn) ;
  MInit (consts) ;
  MInit (extProcs) ;
  MInit (extTypes) ;
  MInit (extConsts) ;
  MInit (extVars) ;
  MInit (extMods) ;
  MInit (extExcs) ;
  MInit (foreignProcs) ;
  MInit (bpool) ;
  MInit (arrSeen) ;
  MInit (thrSeen) ;
  MInit (gateSeen) ;
  MInit (aggT) ;
  MInit (aggV) ;
  MInit (scope) ;
  gps := NEW (gpool, GP, 8) ;
  tys := NEW (gpool, TY, 8) ;
  xcs := NEW (gpool, XC, 8) ;
  mvN := NEW (gpool, STR, 8) ;
  mvT := NEW (gpool, AKid, 8) ;
  mvDef := NEW (gpool, BOOL, 8) ;
  lpools := NEW (gpool, STR, 8) ;
  outStr := NEW (gpool, STR, 8) ;
  adoptC := NEW (gpool, STR, 8) ;
  adoptT := NEW (gpool, AKid, 8) ;
  adoptD := NEW (gpool, STR, 8) ;
  bHdr := DynStr.New (gpool) ;
  bSrc := DynStr.New (gpool) ;
  bTdefs := DynStr.New (gpool) ;
  bPbuf := DynStr.New (gpool) ;
  bSprotos := DynStr.New (gpool) ;
  bLit := DynStr.New (gpool) ;
  bHdrRecs := DynStr.New (gpool) ;
  bHdrProtos := DynStr.New (gpool) ;
  bHdrConsts := DynStr.New (gpool) ;
  bRec2 := DynStr.New (gpool) ;
  bArrRec := DynStr.New (gpool) ;
  bHdrArrRec := DynStr.New (gpool) ;
  bRec3 := DynStr.New (gpool) ;
  bThr := DynStr.New (gpool) ;
  bGate := DynStr.New (gpool)
END Setup ;

PROCEDURE Line (buf: I64 ; ind: I64 ; RO s: STR) =
VAR
  d : PTR DynStr.DString IN gpool ;
  i : I64 ;
  t : STR ;
BEGIN
  d := DynStr.New (gpool) ;
  FOR i := 1 TO ind * 2 DO DynStr.AppendChar (d, ' ') END ;
  DynStr.Append (d, s) ;
  DynStr.AppendChar (d, 0AC) ;
  t := DynStr.View (d) ;
  CASE buf OF
  | KHdr : DynStr.Append (bHdr, t)
  | KSrc : DynStr.Append (bSrc, t)
  | KTdefs :
      DynStr.Append (bTdefs, t) ;
      tdefN := tdefN + 1
  | KPbuf : DynStr.Append (bPbuf, t)
  | KSprotos :
      DynStr.Append (bSprotos, t) ;
      sprotoN := sprotoN + 1
  | KLit :
      DynStr.Append (bLit, t) ;
      litN := litN + 1
  | KHdrRecs : DynStr.Append (bHdrRecs, t)
  | KHdrProtos : DynStr.Append (bHdrProtos, t)
  | KHdrConsts :
      DynStr.Append (bHdrConsts, t) ;
      hdrConstN := hdrConstN + 1
  | KRec2 : DynStr.Append (bRec2, t)
  | KArrRec : DynStr.Append (bArrRec, t)
  | KHdrArrRec : DynStr.Append (bHdrArrRec, t)
  | KRec3 : DynStr.Append (bRec3, t)
  | KThr : DynStr.Append (bThr, t)
  | KGate : DynStr.Append (bGate, t)
  ELSE
    Err2 (0, 'internal: unknown output bucket')
  END
END Line ;

PROCEDURE NewTmp () : STR =
BEGIN
  tmpN := tmpN + 1 ;
  RETURN S2 ('m9t', ItoA (tmpN))
END NewTmp ;

(* ---- name and type tables ---- *)

(* Four lists of names, each a constant table (report par 2.2.4) and
   a search.  Until 2026-10-01 each was a chain of `DynStr.Eq (n,
   'a') OR DynStr.Eq (n, 'b') OR ...`, the longest 96 terms: the same
   list, with the names buried in the code that compared them. *)
CONST
  Builtins = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'F32', 'F64',
    'BYTE', 'BOOL', 'CHAR'
  ] ;
  (* the conversions that narrow, each with its own checked helper *)
  WidthConvs = ['I8', 'I16', 'I32', 'U8', 'U16', 'U32', 'U64'] ;

  (* libm functions a FOR-C unit may bind (C99 math.h, double + float):
     a LOCAL named like one shadows the extern -- `float cosf;` beside
     `extern float cosf (float);` makes a call to cosf resolve to the
     variable.  Escaped like the C keywords in CN.  No corpus identifier
     matches one; float-heavy modules with their own math bindings are
     the beneficiaries. *)
  LibM = [
    'acos', 'acosf', 'acosh', 'acoshf', 'asin', 'asinf', 'asinh', 'asinhf',
    'atan', 'atanf', 'atan2', 'atan2f', 'atanh', 'atanhf', 'cbrt', 'cbrtf',
    'ceil', 'ceilf', 'copysign', 'copysignf', 'cos', 'cosf', 'cosh', 'coshf',
    'erf', 'erff', 'erfc', 'erfcf', 'exp', 'expf', 'exp2', 'exp2f', 'expm1',
    'expm1f', 'fabs', 'fabsf', 'fdim', 'fdimf', 'floor', 'floorf', 'fma',
    'fmaf', 'fmax', 'fmaxf', 'fmin', 'fminf', 'fmod', 'fmodf', 'frexp',
    'frexpf', 'hypot', 'hypotf', 'ldexp', 'ldexpf', 'lgamma', 'lgammaf',
    'log', 'logf', 'log10', 'log10f', 'log1p', 'log1pf', 'log2', 'log2f',
    'modf', 'modff', 'nan', 'nanf', 'nearbyint', 'nearbyintf', 'nextafter',
    'nextafterf', 'pow', 'powf', 'remainder', 'remainderf', 'rint', 'rintf',
    'round', 'roundf', 'scalbn', 'scalbnf', 'sin', 'sinf', 'sinh', 'sinhf',
    'sqrt', 'sqrtf', 'tan', 'tanf', 'tanh', 'tanhf', 'tgamma', 'tgammaf',
    'trunc', 'truncf',
    (* POSIX's Bessel functions, in glibc's and macOS's math.h: a
       module variable named y0 was `redeclared as different kind of
       symbol' (m9curve's Basemap.m9, 2026-10-08) *)
    'j0', 'j1', 'jn', 'y0', 'y1', 'yn'
  ] ;

  (* what CN escapes besides: the C keywords, the three stdbool names,
     `err` (the state parameter of every generated procedure) and
     `main` -- not a keyword but reserved at file scope in a hosted
     environment: the gm2 collision in the ledger, met again by M9's
     own compiler *)
  CWords = [
    'signed', 'unsigned', 'int', 'char', 'long', 'short', 'float',
    'double', 'void', 'return', 'if', 'else', 'while', 'for', 'do',
    'switch', 'case', 'default', 'break', 'continue', 'goto', 'struct',
    'union', 'enum', 'typedef', 'static', 'extern', 'const', 'volatile',
    'register', 'auto', 'sizeof', 'inline', 'restrict', 'bool', 'true',
    'false', 'err', 'main'
  ] ;

PROCEDURE IsBuiltin (RO n: STR) : BOOL =
BEGIN
  RETURN Text.OneOf (n, Builtins)
END IsBuiltin ;

PROCEDURE IsLibM (RO n: STR) : BOOL =
BEGIN
  RETURN Text.OneOf (n, LibM)
END IsLibM ;

(* Mod.v as the C name Mod_v, in the generator's pool: CN's answers
   are kept *)
PROCEDURE Undot (RO n: STR) : STR =
VAR i : I64 ;
BEGIN
  i := Text.FindChar (n, '.') ;
  RETURN S3 (CP (SLICE (n, 0, i)), '_', SLICE (n, i + 1, LEN (n) - i - 1))
END Undot ;

PROCEDURE CN (RO n: STR) : STR =
BEGIN
  (* an imported variable is in scope as Mod.v (decision 28); its C
     name is the pointer the exporter defines, Mod_v *)
  IF Text.FindChar (n, '.') >= 0 THEN RETURN Undot (n) END ;
  IF Text.OneOf (n, CWords) THEN RETURN S2 (n, '_') END ;
  IF IsLibM (n) THEN RETURN S2 (n, '_') END ;
  RETURN n
END CN ;

PROCEDURE CMap (RO n: STR) : STR =
BEGIN
  IF DynStr.Eq (n, 'Int') THEN RETURN 'int' END ;
  IF DynStr.Eq (n, 'SizeT') THEN RETURN 'size_t' END ;
  IF DynStr.Eq (n, 'SSizeT') THEN RETURN 'int64_t' END ;
  IF DynStr.Eq (n, 'ConstPtr') THEN RETURN 'const void *' END ;
  IF DynStr.Eq (n, 'MutPtr') THEN RETURN 'void *' END ;
  IF DynStr.Eq (n, 'Double') THEN RETURN 'double' END ;
  IF DynStr.Eq (n, 'Float') THEN RETURN 'float' END ;
  IF DynStr.Eq (n, 'LongDouble') THEN RETURN 'long double' END ;
  RETURN ''
END CMap ;

PROCEDURE BuiltinC (RO n: STR) : STR =
BEGIN
  IF DynStr.Eq (n, 'I8') THEN RETURN 'int8_t' END ;
  IF DynStr.Eq (n, 'I16') THEN RETURN 'int16_t' END ;
  IF DynStr.Eq (n, 'I32') THEN RETURN 'int32_t' END ;
  IF DynStr.Eq (n, 'I64') THEN RETURN 'int64_t' END ;
  IF DynStr.Eq (n, 'U8') THEN RETURN 'uint8_t' END ;
  IF DynStr.Eq (n, 'U16') THEN RETURN 'uint16_t' END ;
  IF DynStr.Eq (n, 'U32') THEN RETURN 'uint32_t' END ;
  IF DynStr.Eq (n, 'U64') THEN RETURN 'uint64_t' END ;
  IF DynStr.Eq (n, 'F32') THEN RETURN 'float' END ;
  IF DynStr.Eq (n, 'F64') THEN RETURN 'double' END ;
  IF DynStr.Eq (n, 'BYTE') THEN RETURN 'uint8_t' END ;
  IF DynStr.Eq (n, 'BOOL') THEN RETURN 'bool' END ;
  IF DynStr.Eq (n, 'CHAR') THEN RETURN 'uint32_t' END ;
  RETURN ''
END BuiltinC ;

PROCEDURE FindTypeN (RO n: STR) : Ast.Kid =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ntys - 1 DO
    IF DynStr.Eq (tys[i].name, n) THEN
      IF tys[i].node IS SOME t THEN RETURN SOME (t) END
    END
  END ;
  RETURN NONE
END FindTypeN ;

PROCEDURE IsOpaque (RO n: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ntys - 1 DO
    IF DynStr.Eq (tys[i].name, n) THEN
      IF tys[i].opq THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END IsOpaque ;

PROCEDURE FindProcN (RO n: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ngps - 1 DO
    IF DynStr.Eq (gps[i].name, n) THEN RETURN i END
  END ;
  RETURN -1
END FindProcN ;

PROCEDURE ExtBare (RO nm: STR) : I64 =
VAR
  i, kl : I64 ;
BEGIN
  FOR i := 0 TO extTypes.n - 1 DO
    kl := LEN (extTypes.es[i].k) ;
    IF kl > LEN (nm) THEN
      IF extTypes.es[i].k[kl - LEN (nm) - 1] = '.' THEN
        IF DynStr.Eq (SLICE (extTypes.es[i].k, kl - LEN (nm), LEN (nm)),
                      nm) THEN
          RETURN i
        END
      END
    END
  END ;
  RETURN -1
END ExtBare ;

PROCEDURE IsPtrK (k: I64) : BOOL =
BEGIN
  RETURN k = Ast.NPtrType OR k = Ast.NSharedType
END IsPtrK ;

PROCEDURE IsRecK (k: I64) : BOOL =
BEGIN
  RETURN k = Ast.NRecordType OR k = Ast.NCaseRecordType OR
         k = Ast.NEnumType OR
         k = Ast.NMonitorType
END IsRecK ;

PROCEDURE Resolve (t: Ast.Kid) : Ast.Kid =
VAR
  cur : Ast.Kid ;
  depth, ei : I64 ;
BEGIN
  cur := t ;
  (* STR expands to the slice it abbreviates (par 2.2), so nothing
     downstream needs a case for it *)
  IF cur IS SOME c0 THEN
    IF c0.kind = Ast.NQualident AND LEN (c0.b) = 0 AND
       DynStr.Eq (c0.a, 'STR') THEN
      cur := strNode
    END
  END ;
  depth := 0 ;
  LOOP
    IF cur IS SOME n THEN
      IF n.kind # Ast.NQualident THEN RETURN cur END ;
      IF IsBuiltin (n.a) OR DynStr.Eq (n.a, 'POOL') OR
         DynStr.Eq (n.a, 'C') THEN
        RETURN cur
      END ;
      IF depth >= 8 THEN RETURN cur END ;
      IF LEN (n.b) > 0 THEN
        ei := MFind (extTypes, S3 (n.a, '.', n.b)) ;
        IF ei < 0 THEN RETURN cur END ;
        cur := extTypes.es[ei].v
      ELSE
        IF FindTypeN (n.a) IS SOME nx THEN
          cur := SOME (nx)
        ELSE
          ei := ExtBare (n.a) ;
          IF ei < 0 THEN RETURN NONE END ;
          cur := extTypes.es[ei].v
        END
      END ;
      depth := depth + 1
    ELSE
      RETURN NONE
    END
  END
END Resolve ;

(* the enumeration or case-record type node an ARRAY bound names, or
   NONE when the bound is an integer.  ARRAY Colour OF T is indexed by
   the type: its length is the variant count and its subscript is a
   member, not an ordinal (docs/enum-plan.md, part 2). *)
PROCEDURE ArrEnumBoundNode (b: Ast.Kid) : Ast.Kid =
VAR ci : I64 ;
BEGIN
  IF b IS SOME bn THEN
    IF bn.kind = Ast.NDesignator THEN
      IF bn.nkids = 0 THEN
        IF FindTypeN (bn.a) IS SOME t THEN
          IF t.kind = Ast.NEnumType OR t.kind = Ast.NCaseRecordType THEN
            RETURN SOME (t)
          END
        END
      ELSIF bn.nkids = 1 THEN
        IF bn.kids[0] IS SOME sf THEN
          IF sf.kind = Ast.NSelField THEN
            ci := MFind (extTypes, S3 (bn.a, '.', sf.a)) ;
            IF ci >= 0 THEN
              IF extTypes.es[ci].v IS SOME xt THEN
                IF xt.kind = Ast.NEnumType OR xt.kind = Ast.NCaseRecordType THEN
                  RETURN SOME (xt)
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ArrEnumBoundNode ;

PROCEDURE ArrCount (e: PTR Ast.Node) : STR =
VAR ci : I64 ;
BEGIN
  IF e.kind = Ast.NInt THEN RETURN e.a END ;
  (* ARRAY Colour OF T: the count is the number of members *)
  IF ArrEnumBoundNode (SOME (e)) IS SOME et THEN RETURN ItoA (et.nkids) END ;
  IF e.kind = Ast.NDesignator THEN
    IF e.nkids = 0 THEN
      ci := MFind (consts, e.a) ;
      IF ci >= 0 THEN
        IF consts.es[ci].v IS SOME cv THEN
          IF cv.kind = Ast.NInt THEN RETURN cv.a END
        END
      END
    END ;
    (* ARRAY Mod.N OF T: an imported CONST, from the extern table --
       refused as `form unsupported' until 2026-10-08 *)
    IF e.nkids = 1 THEN
      IF e.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          ci := MFind (extConsts, S3 (e.a, '.', sf.a)) ;
          IF ci >= 0 THEN
            IF extConsts.es[ci].v IS SOME xv THEN
              IF xv.kind = Ast.NInt THEN RETURN xv.a END
            END
          END
        END
      END
    END
  END ;
  Err2 (e.line, 'array count form unsupported yet') ;
  RETURN '0'
END ArrCount ;

PROCEDURE ArrCount2 (k: Ast.Kid) : STR =
BEGIN
  IF k IS SOME e THEN RETURN ArrCount (e) END ;
  Err2 (0, 'array count missing') ;
  RETURN '0'
END ArrCount2 ;

PROCEDURE ConstValue (k: Ast.Kid) : Ast.Kid =
VAR ci : I64 ;
BEGIN
  (* the value node of a designator naming a CONST, or NONE.  Both
     spellings: a bare name in this module, and Mod.Name imported. *)
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF e.nkids = 0 THEN
        ci := MFind (consts, e.a) ;
        IF ci >= 0 THEN RETURN consts.es[ci].v END ;
        RETURN NONE
      END ;
      IF e.nkids = 1 THEN
        IF e.kids[0] IS SOME sf THEN
          IF sf.kind = Ast.NSelField THEN
            ci := MFind (extConsts, S3 (e.a, '.', sf.a)) ;
            IF ci >= 0 THEN RETURN extConsts.es[ci].v END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ConstValue ;

PROCEDURE IsAdaptive (k: Ast.Kid) : BOOL =
BEGIN
  (* ADAPTIVE: carries no width of its own, so it takes the other
     operand's.  A real or integer literal, arithmetic over such, and
     a CONST whose value is one -- M9's CONST is an untyped literal,
     not a typed constant, which is the whole reason `Satfwb * p` is
     legal at either width. *)
  IF k IS SOME e THEN
    IF e.kind = Ast.NReal OR e.kind = Ast.NInt THEN RETURN TRUE END ;
    IF e.kind = Ast.NParen THEN RETURN IsAdaptive (e.kids[0]) END ;
    IF e.kind = Ast.NUn AND DynStr.Eq (e.a, '-') THEN
      RETURN IsAdaptive (e.kids[0])
    END ;
    IF e.kind = Ast.NBin THEN
      IF DynStr.Eq (e.a, '+') OR DynStr.Eq (e.a, '-') OR
         DynStr.Eq (e.a, '*') OR DynStr.Eq (e.a, '/') THEN
        IF IsAdaptive (e.kids[0]) THEN RETURN IsAdaptive (e.kids[1]) END ;
        RETURN FALSE
      END ;
      RETURN FALSE
    END ;
    IF ConstValue (k) IS SOME cv THEN RETURN IsAdaptive (SOME (cv)) END
  END ;
  RETURN FALSE
END IsAdaptive ;

PROCEDURE IsNegLit (e: PTR Ast.Node ; kind: I64) : BOOL =
BEGIN
  IF e.kind = Ast.NUn AND DynStr.Eq (e.a, '-') THEN
    IF e.kids[0] IS SOME lit THEN RETURN lit.kind = kind END
  END ;
  RETURN FALSE
END IsNegLit ;

PROCEDURE NegLitText (e: PTR Ast.Node) : STR =
BEGIN
  IF e.kids[0] IS SOME lit THEN RETURN lit.a END ;
  RETURN '0'
END NegLitText ;

PROCEDURE HasSub (RO s: STR ;
                  RO p: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - LEN (p) DO
    IF DynStr.Eq (SLICE (s, i, LEN (p)), p) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasSub ;

PROCEDURE SliceTy (elem: Ast.Kid) : STR ;
PROCEDURE TagOfType (t: Ast.Kid) : STR ;

(* where an ARRAY OF elem's typedef goes: after the struct of a record
   of this module -- its C file for a private one, its header for a
   transparent one (KArrRec, KHdrArrRec) -- and with the other
   typedefs otherwise.  A nested array follows its innermost element. *)
PROCEDURE ArrBucket (elem: Ast.Kid) : I64 =
VAR i : I64 ;
BEGIN
  IF elem IS SOME e THEN
    IF e.kind = Ast.NArrayType THEN RETURN ArrBucket (e.kids[1]) END ;
    IF e.kind = Ast.NQualident AND LEN (e.b) = 0 THEN
      FOR i := 0 TO ntys - 1 DO
        IF DynStr.Eq (tys[i].name, e.a) THEN
          IF tys[i].node IS SOME d THEN
            IF d.kind = Ast.NRecordType OR d.kind = Ast.NMonitorType THEN
              IF tys[i].fdef AND NOT IsOpaque (tys[i].name) THEN
                RETURN KHdrArrRec
              END ;
              RETURN KArrRec
            END
          END
        END
      END
    END
  END ;
  RETURN KTdefs
END ArrBucket ;

PROCEDURE TyC (t: Ast.Kid) : STR =
VAR
  s, nm, ec2 : STR ;
  ei, ai : I64 ;
  da : PTR DynStr.DString IN gpool ;
BEGIN
  IF t IS SOME n THEN
    CASE n.kind OF
    | Ast.NQualident :
        IF LEN (n.b) > 0 THEN
          IF DynStr.Eq (n.a, 'C') THEN
            s := CMap (n.b) ;
            IF LEN (s) = 0 THEN
              Err2 (n.line, S2 ('unknown C type: C.', n.b))
            END ;
            RETURN s
          END ;
          ei := MFind (extTypes, S3 (n.a, '.', n.b)) ;
          IF ei >= 0 THEN
            IF extTypes.es[ei].v IS SOME r2 THEN
              IF IsRecK (r2.kind) OR r2.kind = Ast.NProcType THEN
                RETURN S3 (CP (n.a), '_', n.b)
              END ;
              RETURN TyC (extTypes.es[ei].v)
            END
          END ;
          IF MFind (extMods, n.a) >= 0 THEN
            RETURN S3 (CP (n.a), '_', n.b)
          END ;
          Err2 (n.line, S2 ('unknown name: ', S3 (n.a, '.', n.b))) ;
          RETURN 'void'
        END ;
        IF DynStr.Eq (n.a, 'POOL') THEN RETURN 'm9_pool' END ;
        IF DynStr.Eq (n.a, 'STR') THEN
          IF strNode IS SOME sn THEN RETURN SliceTy (sn.kids[0]) END
        END ;
        s := BuiltinC (n.a) ;
        IF LEN (s) > 0 THEN RETURN s END ;
        IF FindTypeN (n.a) IS SOME r3 THEN
          (* a procedure type is a NAMED C typedef like a record's,
             emitted into the header beside the slice typedefs
             (par 2.2.3) *)
          IF IsRecK (r3.kind) OR r3.kind = Ast.NProcType THEN
            RETURN S3 (CP (modName), '_', n.a)
          END ;
          RETURN TyC (SOME (r3))
        END ;
        ei := ExtBare (n.a) ;
        IF ei >= 0 THEN
          IF extTypes.es[ei].v IS SOME r4 THEN
            IF IsRecK (r4.kind) OR r4.kind = Ast.NProcType THEN
              RETURN S3 (CP (SLICE (extTypes.es[ei].k, 0,
                LEN (extTypes.es[ei].k) - LEN (n.a) - 1)), '_', n.a)
            END ;
            RETURN TyC (extTypes.es[ei].v)
          END
        END ;
        RETURN S3 (CP (modName), '_', n.a)
    | Ast.NPtrType :
        RETURN S2 (TyC (n.kids[0]), ' *')
    | Ast.NSharedType :
        RETURN S2 (TyC (n.kids[0]), ' *')
    | Ast.NOptType :
        IF Resolve (n.kids[0]) IS SOME r5 THEN
          (* a procedure value is pointer-shaped too: NONE is NULL *)
          IF IsPtrK (r5.kind) OR r5.kind = Ast.NProcType THEN
            RETURN TyC (n.kids[0])
          END
        END ;
        Err2 (n.line, 'dereference of a non-pointer unsupported yet') ;
        RETURN 'void'
    | Ast.NSliceType :
        RETURN SliceTy (n.kids[0])
    | Ast.NGridType :
        IF n.kids[0] IS SOME rk THEN
          RETURN GridTy (n.kids[1], ArrCount (rk))
        END ;
        RETURN 'void'
    | Ast.NArrayType :
        IF n.kids[0] IS SOME cnt THEN
          (* the element's own typedefs first (idempotent), and the
             NAME derives from the element's C type the way SliceTy's
             does: TagOfType collapsed every nested array to ARR and
             every record to REC, so two same-length arrays of
             different element types shared one typedef and the
             second field was silently laid out as the first --
             found by ASan under the proxy's session registry *)
          ec2 := TyC (n.kids[1]) ;
          da := DynStr.New (gpool) ;
          DynStr.Append (da, 'm9_arr_') ;
          DynStr.Append (da, ArrCount (cnt)) ;
          DynStr.AppendChar (da, '_') ;
          FOR ai := 0 TO LEN (ec2) - 1 DO
            IF ec2[ai] = '*' THEN
              DynStr.AppendChar (da, 'p')
            ELSIF ec2[ai] # ' ' THEN
              DynStr.AppendChar (da, ec2[ai])
            END
          END ;
          s := DynStr.View (da) ;
          IF MFind (arrSeen, s) < 0 AND dry = 0 THEN
            MAdd (arrSeen, s, NONE, '') ;
            (* each typedef defines a fresh anonymous struct, so two
               modules emitting the same name are conflicting types,
               not a legal C11 redefinition: guard every one *)
            ai := ArrBucket (n.kids[1]) ;
            Line (ai, 0, S2 ('#ifndef M9SL_', s)) ;
            Line (ai, 0, S2 ('#define M9SL_', s)) ;
            Line (ai, 0, S7 ('typedef struct { ', ec2,
              ' v[', ArrCount (cnt), ']; } ', s, ';')) ;
            Line (ai, 0, '#endif')
          END ;
          RETURN s
        END ;
        RETURN 'void'
    ELSE
      Err2 (n.line, 'type kind unsupported yet') ;
      RETURN 'void'
    END
  END ;
  RETURN 'void'
END TyC ;

PROCEDURE SliceTy (elem: Ast.Kid) : STR =
VAR
  nm, ec : STR ;
  i : I64 ;
  d : PTR DynStr.DString IN gpool ;
BEGIN
  IF Resolve (elem) IS SOME r THEN
    IF r.kind = Ast.NQualident THEN
      IF LEN (r.b) = 0 THEN
        IF IsBuiltin (r.a) THEN RETURN S2 ('m9_sl_', r.a) END
      END
    END
  END ;
  ec := TyC (elem) ;
  d := DynStr.New (gpool) ;
  DynStr.Append (d, 'm9_sl_') ;
  FOR i := 0 TO LEN (ec) - 1 DO
    IF ec[i] = '*' THEN DynStr.AppendChar (d, 'p')
    ELSIF ec[i] # ' ' THEN DynStr.AppendChar (d, ec[i]) END
  END ;
  nm := DynStr.View (d) ;
  IF MFind (arrSeen, nm) < 0 AND dry = 0 THEN
    MAdd (arrSeen, nm, NONE, '') ;
    Line (KTdefs, 0, S2 ('#ifndef M9SL_', nm)) ;
    Line (KTdefs, 0, S2 ('#define M9SL_', nm)) ;
    Line (KTdefs, 0, S5 ('typedef struct { ', ec,
      ' *p; int64_t len; } ', nm, ';')) ;
    Line (KTdefs, 0, '#endif')
  END ;
  RETURN nm
END SliceTy ;

(* one struct per rank per element type, guarded like the slice
   typedefs: each defines a fresh anonymous struct, so the same name
   from two modules is a conflicting type and not a redefinition *)
PROCEDURE GridTy (elem: Ast.Kid ; RO rank: STR) : STR =
VAR
  nm, ec : STR ;
  i : I64 ;
  d : PTR DynStr.DString IN gpool ;
BEGIN
  ec := TyC (elem) ;
  d := DynStr.New (gpool) ;
  DynStr.Append (d, 'm9_gd') ;
  DynStr.Append (d, rank) ;
  DynStr.AppendChar (d, '_') ;
  FOR i := 0 TO LEN (ec) - 1 DO
    IF ec[i] = '*' THEN DynStr.AppendChar (d, 'p')
    ELSIF ec[i] # ' ' THEN DynStr.AppendChar (d, ec[i]) END
  END ;
  nm := DynStr.View (d) ;
  IF MFind (arrSeen, nm) < 0 AND dry = 0 THEN
    MAdd (arrSeen, nm, NONE, '') ;
    Line (KTdefs, 0, S2 ('#ifndef M9SL_', nm)) ;
    Line (KTdefs, 0, S2 ('#define M9SL_', nm)) ;
    Line (KTdefs, 0, S7 ('M9_GRID_T (', nm, ', ', ec, ', ', rank, ')')) ;
    Line (KTdefs, 0, '#endif')
  END ;
  RETURN nm
END GridTy ;

(* the ALL axis marker: a predeclared identifier, so it is a bare
   designator with that name and no selectors *)
(* the checked helper's width suffix for an integer type tag.  Each
   of the eight exact widths has its own helper since 2026-09-27:
   before that everything went through the I64 one and a narrow
   result was stored unchecked, so `I32 max + 1` wrapped in silence
   (docs/agent-review-2026-09-27.md F1).  A tag that is none of the
   eight -- a C.* value, an enumeration's ordinal -- is a 64-bit
   value to the checker and keeps the I64 helper. *)
PROCEDURE ISuf (RO t: STR) : STR =
BEGIN
  IF DynStr.Eq (t, 'I8') THEN RETURN 'i8' END ;
  IF DynStr.Eq (t, 'I16') THEN RETURN 'i16' END ;
  IF DynStr.Eq (t, 'I32') THEN RETURN 'i32' END ;
  IF DynStr.Eq (t, 'U8') THEN RETURN 'u8' END ;
  IF DynStr.Eq (t, 'U16') THEN RETURN 'u16' END ;
  IF DynStr.Eq (t, 'U32') THEN RETURN 'u32' END ;
  IF DynStr.Eq (t, 'U64') THEN RETURN 'u64' END ;
  RETURN 'i64'
END ISuf ;

PROCEDURE IsWidthConv (RO n: STR) : BOOL =
BEGIN
  RETURN Text.OneOf (n, WidthConvs)
END IsWidthConv ;

(* the runtime's name for each checked narrowing.  A table rather
   than a lowercasing loop: CHR is itself a checked conversion, so
   spelling seven known names with one would put a RAISES ValueRange
   on the generator's name mangling. *)
PROCEDURE LowerName (RO n: STR) : STR =
BEGIN
  IF DynStr.Eq (n, 'I8') THEN RETURN 'i8' END ;
  IF DynStr.Eq (n, 'I16') THEN RETURN 'i16' END ;
  IF DynStr.Eq (n, 'I32') THEN RETURN 'i32' END ;
  IF DynStr.Eq (n, 'U8') THEN RETURN 'u8' END ;
  IF DynStr.Eq (n, 'U16') THEN RETURN 'u16' END ;
  IF DynStr.Eq (n, 'U32') THEN RETURN 'u32' END ;
  IF DynStr.Eq (n, 'U64') THEN RETURN 'u64' END ;
  RETURN ''
END LowerName ;

PROCEDURE IsAllArg (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF e.nkids = 0 THEN RETURN DynStr.Eq (e.a, 'ALL') END
    END
  END ;
  RETURN FALSE
END IsAllArg ;

(* ---- a case record that lives in another module ----

   A CR: tag names the case record type; until 2026-09-15 it named it
   BARE, so every consumer prefixed modName and looked it up locally,
   and a value typed `Shape.Kind' -- a parameter, a variable, a call
   result -- could not be CASEd ("CASE over this selector unsupported
   yet") nor built ("unknown name: Shape").  Csv, Frame and Plot each
   grew an integer face to route around it, in their own comments.

   Now the tag carries the module when there is one -- `CR:Kind' at
   home, `CR:Shape.Kind' abroad -- and these two answer, for either
   spelling, the C prefix and the declaring node.  The header of the
   other module already declares Shape_Kind and its tags; nothing has
   to be re-emitted. *)
PROCEDURE CRPrefix (RO tn: STR) : STR =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (tn) - 1 DO
    IF tn[i] = '.' THEN
      RETURN S3 (CP (SLICE (tn, 0, i)), '_', SLICE (tn, i + 1, LEN (tn) - i - 1))
    END
  END ;
  RETURN S3 (CP (modName), '_', tn)
END CRPrefix ;

PROCEDURE CRNode (RO tn: STR) : Ast.Kid =
VAR i, ei : I64 ;
BEGIN
  FOR i := 0 TO LEN (tn) - 1 DO
    IF tn[i] = '.' THEN
      ei := MFind (extTypes, tn) ;
      IF ei >= 0 THEN RETURN extTypes.es[ei].v END ;
      RETURN NONE
    END
  END ;
  RETURN FindTypeN (tn)
END CRNode ;

PROCEDURE TagOfType (t: Ast.Kid) : STR =
VAR ei : I64 ;
BEGIN
  IF t IS SOME n0 THEN
    IF n0.kind = Ast.NQualident THEN
      IF LEN (n0.b) = 0 THEN
        IF FindTypeN (n0.a) IS SOME cr THEN
          IF cr.kind = Ast.NCaseRecordType OR cr.kind = Ast.NEnumType THEN
            RETURN S2 ('CR:', n0.a)
          END
        END
      ELSE
        ei := MFind (extTypes, S3 (n0.a, '.', n0.b)) ;
        IF ei >= 0 THEN
          IF extTypes.es[ei].v IS SOME cr2 THEN
            IF cr2.kind = Ast.NCaseRecordType OR cr2.kind = Ast.NEnumType THEN
              RETURN S4 ('CR:', n0.a, '.', n0.b)
            END
          END
        END
      END
    END
  END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NQualident :
        IF DynStr.Eq (r.a, 'POOL') THEN RETURN 'POOL' END ;
        IF IsBuiltin (r.a) THEN RETURN r.a END ;
        RETURN '?'
    | Ast.NPtrType : RETURN 'PTR'
    | Ast.NSharedType : RETURN 'SHARED'
    | Ast.NOptType : RETURN 'OPTPTR'
    | Ast.NSliceType : RETURN 'SLICE'
    | Ast.NGridType : RETURN 'GRID'
    | Ast.NArrayType : RETURN 'ARR'
    | Ast.NRecordType : RETURN 'REC'
    | Ast.NMonitorType : RETURN 'REC'
    | Ast.NProcType : RETURN 'PROC'
    ELSE RETURN '?'
    END
  END ;
  RETURN '?'
END TagOfType ;

(* a name in the scope table, by the language's order and not the
   table's: the parameters and locals first (they come before the
   module block); then the BINDERS, pushed on top of the block by the
   statements and popped with them, innermost first; the module
   variables and constant tables last.  Until 2026-10-03 the table
   was searched from its start, so `IF k IS SOME a THEN a.line' in a
   module with `VAR a : STR' found the module variable and failed with
   `selection through a non-record' while the checker accepted it
   (owed ledger, found writing M9elide). *)
PROCEDURE ScopeFind (RO n: STR) : I64 =
VAR i, lo, hi : I64 ;
BEGIN
  lo := mvBase ;
  IF lo > scope.n THEN lo := scope.n END ;
  hi := mvBase + nmv + extVars.n + aggT.n ;
  IF hi > scope.n THEN hi := scope.n END ;
  FOR i := 0 TO lo - 1 DO
    IF DynStr.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  FOR i := scope.n - 1 TO hi BY -1 DO
    IF DynStr.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  FOR i := lo TO hi - 1 DO
    IF DynStr.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  RETURN -1
END ScopeFind ;

PROCEDURE ScopeNode (RO n: STR) : Ast.Kid =
VAR ix : I64 ;
BEGIN
  ix := ScopeFind (n) ;
  IF ix < 0 THEN RETURN NONE END ;
  RETURN scope.es[ix].v
END ScopeNode ;

PROCEDURE ScopeMode (RO n: STR) : STR =
VAR ix : I64 ;
BEGIN
  ix := ScopeFind (n) ;
  IF ix < 0 THEN RETURN '' END ;
  RETURN scope.es[ix].t
END ScopeMode ;

(* the module block of the scope: this module's variables, then every
   imported module's exports as Mod.v in VAR-parameter mode -- the C is
   a pointer to the exporter's storage, so index, LEN, lending and
   assignment take the VAR paths unchanged, as the constant tables'
   do (decision 28).  The constant tables follow (PushAggs). *)
PROCEDURE ModuleScope () =
VAR i : I64 ;
BEGIN
  mvBase := scope.n ;
  FOR i := 0 TO nmv - 1 DO
    MAdd (scope, mvN[i], mvT[i], 'l')
  END ;
  FOR i := 0 TO extVars.n - 1 DO
    MAdd (scope, extVars.es[i].k, extVars.es[i].v, 'v')
  END
END ModuleScope ;

(* a type node from module MODNAME made self-contained: its bare type
   names qualified, as Sem.QualifiedIn does it, so that an importer
   reads an exported variable's type where it was declared *)
PROCEDURE QualIn (KEPT t: Ast.Kid ; RO KEPT modName: STR) : Ast.Kid =
VAR n : PTR Ast.Node IN gpool ;
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident THEN
      IF LEN (tn.b) = 0 AND NOT IsBuiltin (tn.a) AND
         NOT DynStr.Eq (tn.a, 'STR') AND NOT DynStr.Eq (tn.a, 'POOL') THEN
        n := Ast.NewNode (gpool, Ast.NQualident, tn.line, tn.col) ;
        n.a := modName ;
        n.b := tn.a ;
        RETURN SOME (n)
      END
    ELSIF tn.kind = Ast.NPtrType OR tn.kind = Ast.NOptType OR
          tn.kind = Ast.NSharedType OR tn.kind = Ast.NSliceType THEN
      n := Ast.NewNode (gpool, tn.kind, tn.line, tn.col) ;
      IF tn.nkids > 0 THEN
        Ast.Add (gpool, n, QualIn (tn.kids[0], modName))
      END ;
      Ast.Add (gpool, n, NONE) ;
      RETURN SOME (n)
    ELSIF (tn.kind = Ast.NArrayType OR tn.kind = Ast.NGridType) AND
          tn.nkids >= 2 THEN
      n := Ast.NewNode (gpool, tn.kind, tn.line, tn.col) ;
      Ast.Add (gpool, n, tn.kids[0]) ;
      Ast.Add (gpool, n, QualIn (tn.kids[1], modName)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN t
END QualIn ;

(* the module a qualified type name points into, noted while a
   designator walks a foreign aggregate, so that its component types
   are read where they were declared (canonCtx; Sem's NoteMod) *)
PROCEDURE NoteMod (t: Ast.Kid ; VAR m: STR) =
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident AND LEN (tn.b) > 0 THEN m := tn.a END
  END
END NoteMod ;

PROCEDURE InMod (KEPT t: Ast.Kid ; RO KEPT m: STR) : Ast.Kid =
BEGIN
  IF LEN (m) = 0 OR DynStr.Eq (m, modName) THEN RETURN t END ;
  RETURN QualIn (t, m)
END InMod ;

PROCEDURE FieldType (rec: PTR Ast.Node ;
                     RO f: STR) : Ast.Kid =
VAR i, j : I64  ;
  fsk : Ast.Kid ;
BEGIN
  (* NRecordType is kids[0]=base, kids[1]=fields; NMonitorType has no
     base, so its fields are kids[0] *)
  IF rec.kind = Ast.NMonitorType THEN
    fsk := rec.kids[0]
  ELSE
    fsk := rec.kids[1]
  END ;
  IF fsk IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF g.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              IF DynStr.Eq (id.a, f) THEN RETURN g.kids[1] END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END FieldType ;

(* ---- the frame form of NEW, and adoption at exit (rule 1 of
   docs/pool-elision-plan.md) ---- *)

(* a designator with at most one field selector as a fresh qualident
   node, for the type position of a NEW *)
PROCEDURE AsQualG (k: Ast.Kid) : Ast.Kid =
VAR q : PTR Ast.Node IN gpool ;
BEGIN
  IF k IS SOME d THEN
    IF d.kind # Ast.NQualident AND d.kind # Ast.NDesignator THEN
      RETURN NONE
    END ;
    IF d.nkids > 1 THEN RETURN NONE END ;
    q := Ast.NewNode (gpool, Ast.NQualident, d.line, d.col) ;
    q.a := S2 (d.a, '') ;
    q.b := S2 (d.b, '') ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind # Ast.NSelField THEN RETURN NONE END ;
        q.b := S2 (sel.a, '')
      END
    END ;
    RETURN SOME (q)
  END ;
  RETURN NONE
END AsQualG ;

(* the four spellings of NEW, told apart by NAME (par 10, item 6):
   'frame' for NEW (T) and NEW (T, n...), 'pool' for NEW (pool, T...),
   'own' for NEW (OWN, T).  The checker (Sem.NewForm) has already
   refused anything else; this side only has to agree.  ty is the
   type's node and ext0 the index of the first extent, whose kid may
   be NONE. *)
PROCEDURE NewShape (e: PTR Ast.Node ; VAR ty: Ast.Kid ;
                    VAR ext0: I64) : STR =
VAR isVar : BOOL ;
BEGIN
  ty := NONE ;
  ext0 := 2 ;
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 AND DynStr.Eq (d.a, 'OWN') THEN
      ty := e.kids[1] ;
      RETURN 'own'
    END ;
    isVar := TRUE ;
    IF d.nkids = 0 THEN
      IF LEN (ScopeMode (d.a)) = 0 AND NOT DynStr.Eq (d.a, 'HEAP') THEN
        isVar := FALSE
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF LEN (ScopeMode (d.a)) = 0 AND
             MFind (extMods, d.a) >= 0 THEN
            isVar := FALSE
          END
        END
      END
    END ;
    IF isVar THEN
      ty := AsQualG (e.kids[1]) ;
      RETURN 'pool'
    END ;
    ty := AsQualG (e.kids[0]) ;
    ext0 := 1 ;
    RETURN 'frame'
  END ;
  ty := e.kids[1] ;
  RETURN 'frame'
END NewShape ;

(* can a value of this type carry a pointer into the frame?  A PTR,
   an OPT PTR, a slice or a grid can; a record or an array can when a
   component can; a SHARED handle (heap), a procedure value and a
   scalar cannot.  Bounded, since a record may name itself through a
   PTR -- which is where the walk stops anyway. *)
PROCEDURE HasPtr (t: Ast.Kid ; depth: I64) : BOOL =
VAR i, j : I64 ;
  fsk : Ast.Kid ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NPtrType : RETURN TRUE
    | Ast.NOptType : RETURN HasPtr (r.kids[0], depth + 1)
    | Ast.NSliceType : RETURN TRUE
    | Ast.NGridType : RETURN TRUE
    | Ast.NArrayType : RETURN HasPtr (r.kids[1], depth + 1)
    | Ast.NRecordType :
        fsk := r.kids[1] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NMonitorType :
        fsk := r.kids[0] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME v THEN
            IF v.kids[0] IS SOME vfs THEN
              FOR j := 0 TO vfs.nkids - 1 DO
                IF vfs.kids[j] IS SOME fg THEN
                  IF HasPtr (fg.kids[1], depth + 1) THEN RETURN TRUE END
                END
              END
            END
          END
        END ;
        RETURN FALSE
    ELSE RETURN FALSE
    END
  END ;
  RETURN FALSE
END HasPtr ;

(* the exit test, one line per pointer component of the value EXPR
   of type T: adopt the frame's arena into the caller's when the
   component points into it.  An array loops; a record and a variant
   walk their fields (every arm of a variant -- reading an inactive
   arm's pointer bits compares an address and nothing else, and a
   spurious adoption keeps memory where a missed one would free it
   under a live pointer). *)
(* does a VAR parameter of this type carry its object's pool as a
   hidden argument (docs/pool-elision-plan.md, rule 2)?  Written as
   `PTR T` or `OPT PTR T`: yes, by node kind and no lookup.  A record,
   monitor, array or variant that can hold a pointer: yes, since a
   component of it may be handed on.  A bare slice, grid or string:
   no -- those are output slots, re-homed or adopted at exit.
   Sem.PtrParamTy is the twin; gendiff holds the two generators to
   one answer. *)
PROCEDURE PoolParamTy (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME n THEN
    IF n.kind = Ast.NPtrType THEN RETURN TRUE END ;
    IF n.kind = Ast.NOptType THEN
      IF n.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
      RETURN FALSE
    END ;
    IF n.kind = Ast.NSliceType OR n.kind = Ast.NGridType THEN RETURN FALSE END ;
    IF Resolve (t) IS SOME r THEN
      (* a name for a pointer -- `SinkP = PTR Zarr.Sink`, `Ast.Kid =
         OPT PTR Node` -- is the pointer it names (the proxy's P9) *)
      IF r.kind = Ast.NPtrType THEN RETURN TRUE END ;
      IF r.kind = Ast.NOptType THEN
        IF r.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
        RETURN FALSE
      END ;
      IF r.kind = Ast.NRecordType OR r.kind = Ast.NMonitorType OR
         r.kind = Ast.NArrayType OR r.kind = Ast.NCaseRecordType THEN
        RETURN HasPtr (t, 0)
      END
    END
  END ;
  RETURN FALSE
END PoolParamTy ;

(* the exit test, one line per pointer component of EXPR of type T,
   each adopting the frame into DST: the caller's arena for a result,
   the object's own pool for a VAR parameter's target (rule 2) *)
PROCEDURE AdoptEmit (RO expr: STR ; t: Ast.Kid ; RO dst: STR ;
                     ind: I64 ; depth: I64) =
VAR i, j, k : I64 ;
  fsk : Ast.Kid ;
  kv : STR ;
BEGIN
  IF depth > 8 THEN RETURN END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NPtrType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, ');'))
    | Ast.NOptType :
        IF HasPtr (r.kids[0], depth + 1) THEN
          Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, ');'))
        END
    | Ast.NSliceType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, '.p);'))
    | Ast.NGridType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, '.p);'))
    | Ast.NArrayType :
        IF HasPtr (r.kids[1], depth + 1) THEN
          kv := S2 ('m9k', ItoA (depth)) ;
          Line (KPbuf, ind, S9 ('for (int64_t ', kv, ' = 0; ', kv, ' < ',
            ArrCount2 (r.kids[0]), '; ', kv, '++) {')) ;
          AdoptEmit (S4 (expr, '.v[', kv, ']'), r.kids[1], dst, ind + 1,
                     depth + 1) ;
          Line (KPbuf, ind, '}')
        END
    | Ast.NRecordType :
        fsk := r.kids[1] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN
                IF g.kids[0] IS SOME ids THEN
                  FOR j := 0 TO ids.nkids - 1 DO
                    IF ids.kids[j] IS SOME id THEN
                      AdoptEmit (S3 (expr, '.', CN (id.a)), g.kids[1],
                                 dst, ind, depth + 1)
                    END
                  END
                END
              END
            END
          END
        END
    | Ast.NMonitorType :
        fsk := r.kids[0] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN
                IF g.kids[0] IS SOME ids THEN
                  FOR j := 0 TO ids.nkids - 1 DO
                    IF ids.kids[j] IS SOME id THEN
                      AdoptEmit (S3 (expr, '.', CN (id.a)), g.kids[1],
                                 dst, ind, depth + 1)
                    END
                  END
                END
              END
            END
          END
        END
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME v THEN
            IF v.kids[0] IS SOME vfs THEN
              FOR j := 0 TO vfs.nkids - 1 DO
                IF vfs.kids[j] IS SOME fg THEN
                  IF HasPtr (fg.kids[1], depth + 1) THEN
                    IF fg.kids[0] IS SOME fids THEN
                      FOR k := 0 TO fids.nkids - 1 DO
                        IF fids.kids[k] IS SOME fid THEN
                          AdoptEmit (S5 (expr, '.u.', v.a, '.', CN (fid.a)),
                                     fg.kids[1], dst, ind, depth + 1)
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
    ELSE
    END
  END
END AdoptEmit ;

PROCEDURE CharVal (RO lit: STR) : I64 =
VAR
  v, i, dg : I64 ;
  c : CHAR ;
BEGIN
  v := 0 ;
  FOR i := 0 TO LEN (lit) - 2 DO
    c := lit[i] ;
    IF c >= '0' AND c <= '9' THEN dg := ORD (c) - 48
    ELSE dg := ORD (c) - 55 END ;
    v := v * 16 + dg
  END ;
  RETURN v
END CharVal ;

PROCEDURE StrCodes (RO s: STR) : STR =
VAR
  d : PTR DynStr.DString IN gpool ;
  i : I64 ;
BEGIN
  d := DynStr.New (gpool) ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF ORD (s[i]) > 127 THEN
      Err2 (0, 'non-ASCII string literal unsupported yet')
    END ;
    IF i > 0 THEN DynStr.Append (d, ', ') END ;
    DynStr.AppendI64 (d, ORD (s[i])) ;
    DynStr.AppendChar (d, 'u')
  END ;
  RETURN DynStr.View (d)
END StrCodes ;

(* the record a CONST's call names, as a type node -- Row (...) or
   Mod.Row (...), an alias followed -- or NONE *)
PROCEDURE RecordConstQual (k: Ast.Kid) : Ast.Kid =
VAR
  name, ct, m, tn : STR ;
  j : I64 ;
  q : PTR Ast.Node IN gpool ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        name := dn.a ;
        FOR j := 0 TO dn.nkids - 1 DO
          IF dn.kids[j] IS SOME sf THEN
            IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.a) END
          END
        END ;
        IF RecordAt (name, ct, m, tn) IS SOME rn THEN
          q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
          IF DynStr.Eq (m, modName) THEN
            q.a := tn
          ELSE
            q.a := m ;
            q.b := tn
          END ;
          RETURN SOME (q)
        END
      END
    END
  END ;
  RETURN NONE
END RecordConstQual ;

PROCEDURE IsAggregate (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAggregate THEN RETURN TRUE END ;
    IF RecordConstQual (k) IS SOME rq THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsAggregate ;

(* a constant table (par 2.2.4): CONST X = [ e1, ..., en ] is kept as
   an ARRAY n OF T built here, T read off the first element -- the
   checker has held every element to it *)
PROCEDURE AddAgg (RO KEPT nm: STR ; KEPT agk: Ast.Kid) =
VAR
  cnt, at, q : PTR Ast.Node IN gpool ;
  ek : I64 ;
  elt : Ast.Kid ;
BEGIN
  (* a record CONST: its type is the record (par 2.2.4) *)
  IF RecordConstQual (agk) IS SOME rq THEN
    MAdd (aggT, nm, SOME (rq), '') ;
    MAdd (aggV, nm, agk, '') ;
    RETURN
  END ;
  IF agk IS SOME ag THEN
    cnt := Ast.NewNode (gpool, Ast.NInt, 0, 0) ;
    cnt.a := ItoA (ag.nkids) ;
    ek := Ast.NInt ;
    IF ag.kids[0] IS SOME el THEN
      ek := el.kind ;
      IF el.kind = Ast.NUn THEN
        IF el.kids[0] IS SOME o THEN ek := o.kind END
      END
    END ;
    q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
    q.a := 'I64' ;
    IF ek = Ast.NReal THEN q.a := 'F64'
    ELSIF ek = Ast.NChar THEN q.a := 'CHAR'
    ELSIF ek = Ast.NTrue OR ek = Ast.NFalse THEN q.a := 'BOOL'
    END ;
    elt := SOME (q) ;
    IF ek = Ast.NString THEN elt := strNode END ;
    IF RecordConstQual (ag.kids[0]) IS SOME req THEN elt := SOME (req) END ;
    at := Ast.NewNode (gpool, Ast.NArrayType, 0, 0) ;
    Ast.Add (gpool, at, SOME (cnt)) ;
    Ast.Add (gpool, at, elt) ;
    MAdd (aggT, nm, SOME (at), '') ;
    MAdd (aggV, nm, agk, '')
  END
END AddAgg ;

(* ... visible in every body after the module variables, in the mode
   of a VAR parameter: the name is a POINTER to the table, so index,
   LEN and lending take the paths a VAR array parameter takes *)
PROCEDURE PushAggs () =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO aggT.n - 1 DO
    MAdd (scope, aggT.es[i].k, aggT.es[i].v, 'v')
  END
END PushAggs ;

(* ... and emitted as const data -- read-only storage, so a write the
   checker missed is a fault and not a changed constant -- with the
   name a pointer to it.  One element per line: a table is read. *)
(* a literal of a constant table or record CONST as C; a string's
   characters are the static array sname, emitted before by StrsC *)
PROCEDURE LitC (e: PTR Ast.Node ; RO sname: STR ; RO what: STR) : STR =
BEGIN
  IF e.kind = Ast.NInt THEN RETURN S3 ('INT64_C(', e.a, ')') END ;
  IF e.kind = Ast.NReal THEN RETURN S3 ('(', e.a, ')') END ;
  IF e.kind = Ast.NChar THEN RETURN S2 (ItoA (CharVal (e.a)), 'u') END ;
  IF e.kind = Ast.NTrue THEN RETURN 'true' END ;
  IF e.kind = Ast.NFalse THEN RETURN 'false' END ;
  IF e.kind = Ast.NString THEN
    IF LEN (e.a) > 0 THEN
      RETURN S5 ('{ (uint32_t *) ', sname, ', ', ItoA (LEN (e.a)), ' }')
    END ;
    RETURN '{ 0, 0 }'
  END ;
  IF IsNegLit (e, Ast.NInt) THEN RETURN S3 ('INT64_C(-', NegLitText (e), ')') END ;
  IF IsNegLit (e, Ast.NReal) THEN RETURN S3 ('(-', NegLitText (e), ')') END ;
  Err2 (e.line, S2 ('aggregate element unsupported yet: ', what)) ;
  RETURN '0'
END LitC ;

(* the static array a string literal's characters live in *)
PROCEDURE StrC (e: PTR Ast.Node ; RO sname: STR) =
BEGIN
  IF e.kind = Ast.NString AND LEN (e.a) > 0 THEN
    Line (KRec3, 0, S9 ('static const uint32_t ', sname, '[',
      ItoA (LEN (e.a)), '] = { ', StrCodes (e.a), ' };', '', ''))
  END
END StrC ;

(* a record aggregate of literals as a brace initializer, its strings
   emitted first as <base>_<field> *)
PROCEDURE RecStrs (e: PTR Ast.Node ; RO base: STR) =
VAR f : I64 ;
BEGIN
  IF e.kids[1] IS SOME al THEN
    FOR f := 0 TO al.nkids - 1 DO
      IF al.kids[f] IS SOME a THEN StrC (a, S3 (base, '_', ItoA (f))) END
    END
  END
END RecStrs ;

PROCEDURE RecC (e: PTR Ast.Node ; RO base: STR ; RO what: STR) : STR =
VAR
  f : I64 ;
  cs : STR ;
BEGIN
  cs := '{ ' ;
  IF e.kids[1] IS SOME al THEN
    FOR f := 0 TO al.nkids - 1 DO
      IF al.kids[f] IS SOME a THEN
        IF f > 0 THEN cs := S2 (cs, ', ') END ;
        cs := S2 (cs, LitC (a, S3 (base, '_', ItoA (f)), what))
      END
    END
  END ;
  RETURN S2 (cs, ' }')
END RecC ;

PROCEDURE EmitAggs () =
VAR
  i, k : I64 ;
  ty, nm, cs : STR ;
BEGIN
  FOR i := 0 TO aggT.n - 1 DO
    ty := TyC (aggT.es[i].v) ;
    nm := CN (aggT.es[i].k) ;
    IF aggV.es[i].v IS SOME ag THEN
      IF ag.kind = Ast.NCallExpr THEN
        (* a record CONST: one record of const data *)
        RecStrs (ag, S2 (nm, '_s0')) ;
        Line (KRec3, 0, S7 ('static const ', ty, ' ', nm, '_k = ',
          RecC (ag, S2 (nm, '_s0'), aggT.es[i].k), ';')) ;
        Line (KRec3, 0, S9 ('static ', ty, ' * const ', nm, ' = (', ty,
          ' *) &', nm, '_k;'))
      ELSE
        FOR k := 0 TO ag.nkids - 1 DO
          IF ag.kids[k] IS SOME se THEN
            IF se.kind = Ast.NCallExpr THEN
              RecStrs (se, S3 (nm, '_s', ItoA (k)))
            ELSE
              StrC (se, S3 (nm, '_s', ItoA (k)))
            END
          END
        END ;
        Line (KRec3, 0, S5 ('static const ', ty, ' ', nm, '_k = { {')) ;
        FOR k := 0 TO ag.nkids - 1 DO
          cs := '0' ;
          IF ag.kids[k] IS SOME e THEN
            IF e.kind = Ast.NCallExpr THEN
              cs := RecC (e, S3 (nm, '_s', ItoA (k)), aggT.es[i].k)
            ELSE
              cs := LitC (e, S3 (nm, '_s', ItoA (k)), aggT.es[i].k)
            END
          END ;
          IF k < ag.nkids - 1 THEN cs := S2 (cs, ',') END ;
          Line (KRec3, 1, cs)
        END ;
        Line (KRec3, 0, '} };') ;
        Line (KRec3, 0, S9 ('static ', ty, ' * const ', nm, ' = (', ty,
          ' *) &', nm, '_k;'))
      END
    END
  END
END EmitAggs ;

(* ---- registry loading ---- *)

(* Sem.NanWalk's twin: a bare designator NaN becomes the real literal
   NAN (report par 2.1), here too because the generator also runs
   without the checker *)
PROCEDURE NanWalk (VAR n: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND DynStr.Eq (n.a, 'NaN') THEN
    n.kind := Ast.NReal ;
    n.a := 'NAN'
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN NanWalk (c) END
  END
END NanWalk ;

PROCEDURE LoadUnit (KEPT u: PTR Ast.Node) =
VAR
  i, j, k, pi : I64 ;
  nb : SLICE OF GP ;
  tb : SLICE OF TY ;
  xb : SLICE OF XC ;
  sb : SLICE OF STR ;
  kb : SLICE OF AKid ;
  db : SLICE OF BOOL ;
  hasBody : BOOL ;
BEGIN
  Setup () ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME w THEN NanWalk (w) END
  END ;
  IF u.kind = Ast.NDefinition AND LEN (u.b) > 0 THEN
    FOR i := 0 TO u.nkids - 1 DO
      IF u.kids[i] IS SOME d THEN
        IF d.kind = Ast.NProcDecl THEN
          (* the unit goes in the entry's tag: the [SERIAL]
             gate is per LIBRARY, not per procedure *)
          MAdd (foreignProcs, d.a, SOME (d), u.a)
        END
      END
    END ;
    RETURN
  END ;
  IF u.kind = Ast.NProgram THEN isProgram := TRUE END ;
  IF LEN (modName) = 0 THEN modName := u.a END ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcN (d.a) ;
        IF pi < 0 THEN
          IF ngps = LEN (gps) THEN
            nb := NEW (gpool, GP, 2 * LEN (gps)) ;
            FOR k := 0 TO ngps - 1 DO nb[k] := gps[k] END ;
            gps := nb
          END ;
          gps[ngps].name := d.a ;
          gps[ngps].node := SOME (d) ;
          gps[ngps].body := d.kids[4] ;
          gps[ngps].exported := u.kind = Ast.NDefinition ;
          ngps := ngps + 1
        ELSE
          IF d.kids[4] IS SOME bd THEN
            gps[pi].body := SOME (bd) ;
            gps[pi].node := SOME (d)
          END
        END
      ELSIF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF ntys = LEN (tys) THEN
              tb := NEW (gpool, TY, 2 * LEN (tys)) ;
              FOR k := 0 TO ntys - 1 DO tb[k] := tys[k] END ;
              tys := tb
            END ;
            tys[ntys].name := td.a ;
            tys[ntys].node := td.kids[0] ;
            tys[ntys].opq := FALSE ;
            hasBody := FALSE ;
            IF td.kids[0] IS SOME tb0 THEN hasBody := TRUE END ;
            IF u.kind = Ast.NDefinition AND NOT hasBody THEN
              tys[ntys].opq := TRUE
            END ;
            tys[ntys].fdef := u.kind = Ast.NDefinition ;
            ntys := ntys + 1
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd THEN
            IF IsAggregate (cd.kids[0]) THEN
              AddAgg (cd.a, cd.kids[0])
            ELSE
              MAdd (consts, cd.a, cd.kids[0], '')
            END
          END
        END
      ELSIF d.kind = Ast.NExcSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN
            IF nxcs = LEN (xcs) THEN
              xb := NEW (gpool, XC, 2 * LEN (xcs)) ;
              FOR k := 0 TO nxcs - 1 DO xb[k] := xcs[k] END ;
              xcs := xb
            END ;
            xcs[nxcs].name := xd.a ;
            xcs[nxcs].fields := xd.kids[0] ;
            xcs[nxcs].fdef := u.kind = Ast.NDefinition ;
            nxcs := nxcs + 1
          END
        END
      ELSIF d.kind = Ast.NVarSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME ids THEN
              FOR k := 0 TO ids.nkids - 1 DO
                IF ids.kids[k] IS SOME id THEN
                  IF nmv = LEN (mvN) THEN
                    sb := NEW (gpool, STR, 2 * LEN (mvN)) ;
                    kb := NEW (gpool, AKid, 2 * LEN (mvT)) ;
                    db := NEW (gpool, BOOL, 2 * LEN (mvT)) ;
                    FOR pi := 0 TO nmv - 1 DO
                      sb[pi] := mvN[pi] ;
                      kb[pi] := mvT[pi] ;
                      db[pi] := mvDef[pi]
                    END ;
                    mvN := sb ;
                    mvT := kb ;
                    mvDef := db
                  END ;
                  mvN[nmv] := id.a ;
                  mvT[nmv] := vd.kids[1] ;
                  mvDef[nmv] := u.kind = Ast.NDefinition ;
                  nmv := nmv + 1
                END
              END
            END
          END
        END
      ELSIF d.kind = Ast.NModBody THEN
        mainBody := d.kids[0]
      END
    END
  END
END LoadUnit ;

PROCEDURE RegisterExtern (KEPT u: PTR Ast.Node ; addInclude: BOOL) =
VAR i, j, k : I64 ;
BEGIN
  Setup () ;
  IF u.kind # Ast.NDefinition THEN RETURN END ;
  IF LEN (u.b) > 0 THEN
    FOR i := 0 TO u.nkids - 1 DO
      IF u.kids[i] IS SOME d THEN
        IF d.kind = Ast.NProcDecl THEN
          (* the unit goes in the entry's tag: the [SERIAL]
             gate is per LIBRARY, not per procedure *)
          MAdd (foreignProcs, d.a, SOME (d), u.a)
        END
      END
    END ;
    RETURN
  END ;
  (* the include list is the DIRECT imports only; a deep load
     registers the declarations and stops there *)
  IF addInclude THEN
    IF MFind (extMods, u.a) < 0 THEN MAdd (extMods, u.a, NONE, '') END
  END ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        MAdd (extProcs, S3 (u.a, '.', d.a), SOME (d), '')
      ELSIF d.kind = Ast.NExcSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN
            MAdd (extExcs, xd.a, xd.kids[0], u.a)
          END
        END
      ELSIF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF td.kids[0] IS SOME tb THEN
              MAdd (extTypes, S3 (u.a, '.', td.a), SOME (tb), '')
            END
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd THEN
            MAdd (extConsts, S3 (u.a, '.', cd.a), cd.kids[0], '')
          END
        END
      ELSIF d.kind = Ast.NVarSection THEN
        (* the definition's variables: an importer's Mod.v, a pointer
           to the exporter's storage in VAR-parameter mode, whose C
           name is Mod_v (decision 28) *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME vids THEN
              FOR k := 0 TO vids.nkids - 1 DO
                IF vids.kids[k] IS SOME vid THEN
                  MAdd (extVars, S3 (u.a, '.', vid.a), QualIn (vd.kids[1], u.a), '')
                END
              END
            END
          END
        END
      END
    END
  END
END RegisterExtern ;

PROCEDURE LoadExtern (KEPT u: PTR Ast.Node) =
BEGIN
  RegisterExtern (u, TRUE)
END LoadExtern ;

PROCEDURE LoadExternDeep (KEPT u: PTR Ast.Node) =
BEGIN
  RegisterExtern (u, FALSE)
END LoadExternDeep ;

(* ---- mutual recursion heads ---- *)

PROCEDURE DES (d: PTR Ast.Node ; VAR tag: STR) : STR ;
PROCEDURE EX (k: Ast.Kid ; RO want: STR) : STR ;
PROCEDURE CallC (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: STR) : STR ;
PROCEDURE EmitStmt (k: Ast.Kid ; ind: I64) ;
PROCEDURE EmitSeq (k: Ast.Kid ; ind: I64) ;
PROCEDURE VariantCtor (vt: PTR Ast.Node ;
                       RO tn: STR ;
                       RO vn: STR ;
                       argl: Ast.Kid ; nargs: I64 ;
                       VAR tag: STR) : STR ;

(* an integer-constant CASE label: local CONST or imported Mod.CONST *)
PROCEDURE ConstLbl (d: PTR Ast.Node) : STR =
VAR
  ci : I64 ;
  ek : Ast.Kid ;
  res : STR ;
BEGIN
  res := '' ;
  ek := NONE ;
  IF d.nkids = 0 THEN
    ci := MFind (consts, d.a) ;
    IF ci >= 0 THEN ek := consts.es[ci].v END
  ELSIF d.nkids = 1 THEN
    IF d.kids[0] IS SOME sf THEN
      IF sf.kind = Ast.NSelField THEN
        ci := MFind (extConsts, S3 (d.a, '.', sf.a)) ;
        IF ci >= 0 THEN ek := extConsts.es[ci].v END
      END
    END
  END ;
  IF ek IS SOME en THEN
    IF en.kind = Ast.NInt THEN res := S3 ('INT64_C(', en.a, ')') END
  END ;
  RETURN res
END ConstLbl ;

(* the declared type node a designator lands on (no code emitted) *)
PROCEDURE DesigDecl (d: PTR Ast.Node) : Ast.Kid =
VAR
  j : I64 ;
  cur, rk : Ast.Kid ;
  tmod : STR ;
BEGIN
  tmod := '' ;
  cur := ScopeNode (d.a) ;
  FOR j := 0 TO d.nkids - 1 DO
    NoteMod (cur, tmod) ;
    rk := Resolve (cur) ;
    LOOP
      IF rk IS SOME rr THEN
        IF IsPtrK (rr.kind) THEN rk := Resolve (InMod (rr.kids[0], tmod)) ELSE EXIT END
      ELSE
        EXIT
      END
    END ;
    IF rk IS SOME r2 THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r2.kind = Ast.NRecordType OR
             r2.kind = Ast.NMonitorType THEN
            cur := InMod (FieldType (r2, sel.a), tmod)
          ELSE
            RETURN NONE
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r2.kind = Ast.NSliceType THEN cur := InMod (r2.kids[0], tmod)
          ELSIF r2.kind = Ast.NArrayType THEN cur := InMod (r2.kids[1], tmod)
          ELSE RETURN NONE END
        END
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN cur
END DesigDecl ;

(* exception descriptor reference by bare name: this module, the
   predeclared four, then imported definitions *)
(* A QUALIFIED name resolves in exactly the module it states:
   Io.IOError and ZarrStore.IOError (StoreError since 2026-09-27) were two descriptors, and the
   first version dropped the qualifier and answered whichever module
   registered the bare name first -- a handler for ZarrStore.IOError
   compiled to a test against &Io_IOError and matched nothing.
   Found by the tutorial service's no-network zarr cell; the FPC
   twin carried the same defect and both are fixed together.        *)
PROCEDURE ExcRef (RO qual: STR ; RO nm: STR ;
                  VAR fields: Ast.Kid) : STR =
VAR i : I64 ;
BEGIN
  fields := NONE ;
  IF LEN (qual) > 0 AND NOT DynStr.Eq (qual, modName) THEN
    FOR i := 0 TO extExcs.n - 1 DO
      IF DynStr.Eq (extExcs.es[i].k, nm) AND
         DynStr.Eq (extExcs.es[i].t, qual) THEN
        fields := extExcs.es[i].v ;
        RETURN S3 (CP (qual), '_', nm)
      END
    END ;
    RETURN ''
  END ;
  FOR i := 0 TO nxcs - 1 DO
    IF DynStr.Eq (xcs[i].name, nm) THEN
      fields := xcs[i].fields ;
      RETURN S3 (CP (modName), '_', nm)
    END
  END ;
  IF DynStr.Eq (nm, 'Overflow') OR DynStr.Eq (nm, 'IndexError') OR
     DynStr.Eq (nm, 'OutOfMemory') OR DynStr.Eq (nm, 'ValueRange') THEN
    RETURN S2 ('m9_exc_', nm)
  END ;
  i := MFind (extExcs, nm) ;
  IF i >= 0 THEN
    fields := extExcs.es[i].v ;
    RETURN S3 (CP (extExcs.es[i].t), '_', nm)
  END ;
  RETURN ''
END ExcRef ;

(* the OPT payload type of an IS SOME operand: a designator's declared
   type or a call's return type *)
PROCEDURE OptInner (k: Ast.Kid) : Ast.Kid =
VAR
  r, res : Ast.Kid ;
  nm : STR ;
  pi, dot : I64 ;
  q, pn : PTR Ast.Node IN gpool ;
BEGIN
  res := NONE ;
  r := NONE ;
  dot := -1 ;
  nm := '' ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      r := Resolve (DesigDecl (e))
    ELSIF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        nm := dn.a ;
        IF dn.nkids = 1 THEN
          IF dn.kids[0] IS SOME sf THEN
            IF sf.kind = Ast.NSelField THEN nm := S3 (nm, '.', sf.a) END
          END
        END ;
        dot := FindCh (nm, '.') ;
        IF dot >= 0 THEN
          pi := MFind (extProcs, nm) ;
          IF pi >= 0 THEN
            IF extProcs.es[pi].v IS SOME ep THEN
              r := Resolve (ep.kids[1])
            END
          END
        ELSE
          pi := FindProcN (nm) ;
          IF pi >= 0 THEN
            IF gps[pi].node IS SOME lp THEN r := Resolve (lp.kids[1]) END
          END
        END
      END
    END ;
    IF r IS SOME rn THEN
      IF rn.kind = Ast.NOptType THEN res := rn.kids[0] END
    END ;
    (* an extern return type names its OWN module's types bare: qualify *)
    IF e.kind = Ast.NCallExpr AND dot >= 0 THEN
      IF res IS SOME rp THEN
        IF rp.kind = Ast.NPtrType THEN
          IF rp.kids[0] IS SOME rq THEN
            IF rq.kind = Ast.NQualident AND LEN (rq.b) = 0 THEN
              IF NOT IsBuiltin (rq.a) THEN
                q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
                q.a := SLICE (nm, 0, dot) ;
                q.b := rq.a ;
                pn := Ast.NewNode (gpool, Ast.NPtrType, 0, 0) ;
                Ast.Add (gpool, pn, SOME (q)) ;
                Ast.Add (gpool, pn, NONE) ;
                res := SOME (pn)
              END
            END
          END
        END
      END
    END
  END ;
  RETURN res
END OptInner ;

PROCEDURE TagOfExpr (k: Ast.Kid) : STR =
VAR
  t2, u2, res, dc, sh : STR ;
  ci, ext0, nx : I64 ;
  tyk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    res := '?' ;
    CASE e.kind OF
    | Ast.NInt : res := 'I64'
    | Ast.NReal : res := 'F64'
    | Ast.NChar : res := 'CHAR'
    | Ast.NString :
        IF LEN (e.a) = 1 THEN res := 'STR1' ELSE res := 'SLICE' END
    | Ast.NTrue : res := 'BOOL'
    | Ast.NFalse : res := 'BOOL'
    | Ast.NParen : res := TagOfExpr (e.kids[0])
    | Ast.NDesignator :
        t2 := '?' ;
        dry := dry + 1 ;               (* recompute, emit nothing *)
        dc := DES (e, t2) ;
        dry := dry - 1 ;
        res := t2
    | Ast.NCallExpr :
        t2 := '?' ;
        dry := dry + 1 ;
        dc := CallC (e.kids[0], e.kids[1], t2) ;
        dry := dry - 1 ;
        res := t2
    | Ast.NBin :
        IF DynStr.Eq (e.a, 'AND') OR DynStr.Eq (e.a, 'OR') OR
           DynStr.Eq (e.a, '=') OR DynStr.Eq (e.a, '#') OR
           DynStr.Eq (e.a, '<') OR DynStr.Eq (e.a, '<=') OR
           DynStr.Eq (e.a, '>') OR DynStr.Eq (e.a, '>=') THEN
          RETURN 'BOOL'
        END ;
        t2 := TagOfExpr (e.kids[0]) ;
        IF DynStr.Eq (t2, 'I64') THEN t2 := TagOfExpr (e.kids[1]) END ;
        (* and a real literal adapts the same way *)
        IF IsAdaptive (e.kids[0]) THEN t2 := TagOfExpr (e.kids[1]) END ;
        (* a string concatenation is a STRING whatever its left
           operand's own tag: a one-character literal, or a CHAR
           prepended to a string (par 2.3, revised 2026-09-06) *)
        IF DynStr.Eq (e.a, '+') AND
           (DynStr.Eq (t2, 'STR1') OR DynStr.Eq (t2, 'CHAR')) THEN
          u2 := TagOfExpr (e.kids[1]) ;
          IF DynStr.Eq (t2, 'STR1') OR DynStr.Eq (u2, 'SLICE') OR
             DynStr.Eq (u2, 'STR1') THEN
            t2 := 'SLICE'
          END
        END ;
        res := t2
    | Ast.NUn :
        IF DynStr.Eq (e.a, 'NOT') THEN res := 'BOOL'
        ELSE res := TagOfExpr (e.kids[0]) END
    | Ast.NNewExpr :
        sh := NewShape (e, tyk, ext0) ;
        nx := 0 ;
        FOR ci := ext0 TO e.nkids - 1 DO
          IF e.kids[ci] IS SOME dm1 THEN nx := nx + 1 END
        END ;
        IF nx > 1 THEN res := 'GRID'
        ELSIF nx = 1 THEN res := 'SLICE'
        ELSE res := 'PTR' END
    | Ast.NSliceOf3 : res := 'SLICE'
    | Ast.NGridOf : res := 'GRID'
    | Ast.NNoneLit : res := 'OPTPTR'
    ELSE
      res := '?'
    END ;
    IF e.kind = Ast.NDesignator AND DynStr.Eq (res, '?') AND
       e.nkids = 0 THEN
      ci := MFind (consts, e.a) ;
      IF ci >= 0 THEN res := TagOfExpr (consts.es[ci].v) END
    END ;
    RETURN res
  END ;
  RETURN '?'
END TagOfExpr ;

(* ---- designators ---- *)

(* the C address of the pool a NEW's first argument names: a POOL
   variable or HEAP by designator, or a VAR parameter's hidden pool
   (rule 2), which is a pointer already *)
PROCEDURE PoolAddrC (pd: PTR Ast.Node) : STR =
VAR tg : STR ;
BEGIN
  IF pd.nkids = 0 AND DynStr.Eq (ScopeMode (pd.a), 'v') AND
     PoolParamTy (ScopeNode (pd.a)) THEN
    RETURN S2 (CN (pd.a), '_pool')
  END ;
  tg := '?' ;
  RETURN S3 ('&(', DES (pd, tg), ')')
END PoolAddrC ;

(* the pool of the object a designator names, from its ROOT (rule 2
   of docs/pool-elision-plan.md): a VAR parameter's hidden pool; a
   binder's origin's; a local's IN clause, else this frame's arena
   (the result slot, which is the caller's in a pointer-answering
   function); a module variable's IN clause, else the module frame.
   The checker refused every root this cannot name (Sem.ObjPoolIssue),
   so the arena answered for the rest is never reached. *)
PROCEDURE ObjPoolC (a: PTR Ast.Node) : STR =
VAR
  m : STR ;
  ix, i : I64 ;
  t : Ast.Kid ;
BEGIN
  m := ScopeMode (a.a) ;
  IF DynStr.Eq (m, 'v') THEN
    IF PoolParamTy (ScopeNode (a.a)) THEN RETURN S2 (CN (a.a), '_pool') END ;
    RETURN 'err->res'
  END ;
  IF DynStr.Eq (m, 'b') THEN
    i := bpool.n - 1 ;
    WHILE i >= 0 DO
      IF DynStr.Eq (bpool.es[i].k, a.a) THEN RETURN bpool.es[i].t END ;
      i := i - 1
    END ;
    RETURN 'err->res'
  END ;
  IF DynStr.Eq (m, 'l') THEN
    t := ScopeNode (a.a) ;
    IF t IS SOME tn THEN
      IF tn.kind = Ast.NOptType THEN t := tn.kids[0] END
    END ;
    IF Resolve (t) IS SOME r THEN
      IF r.kind = Ast.NPtrType THEN
        IF r.kids[1] IS SOME pn THEN RETURN PoolAddrC (pn) END
      END
    END ;
    ix := ScopeFind (a.a) ;
    IF ix >= mvBase AND ix < mvBase + nmv THEN RETURN '&m9mframe' END ;
    RETURN 'err->res'
  END ;
  RETURN 'err->res'
END ObjPoolC ;

(* a binder's pool is its origin's when the origin is a designator,
   else the arena a call's answer lands in *)
PROCEDURE OriginPool (k: Ast.Kid) : STR =
BEGIN
  IF k IS SOME o THEN
    IF o.kind = Ast.NDesignator THEN RETURN ObjPoolC (o) END
  END ;
  RETURN 'err->res'
END OriginPool ;

PROCEDURE DES (d: PTR Ast.Node ; VAR tag: STR) : STR =
VAR
  ci, j, jj, rk : I64 ;
  tnd, r2 : Ast.Kid ;
  res, base, ix, ec, cnt : STR ;
  dg, dns : PTR DynStr.DString IN gpool ;
  known, fldOk, enumIx : BOOL ;
  tmod : STR ;
BEGIN
  tag := '?' ;
  tmod := '' ;
  tnd := ScopeNode (d.a) ;
  known := FALSE ;
  IF tnd IS SOME t0 THEN known := TRUE END ;
  IF NOT known THEN
    ci := MFind (consts, d.a) ;
    IF ci >= 0 THEN
      (* a MODULE const is a C declaration named Mod_Name; a
         PROCEDURE-LOCAL one has none, so its value is inlined at the
         use.  For a literal that is all a CONST ever was. *)
      IF ci >= constsBase THEN
        res := EX (consts.es[ci].v, '')
      ELSE
        res := S3 (CP (modName), '_', d.a)
      END ;
      tag := TagOfExpr (consts.es[ci].v) ;
      (* const slice indexing *)
      FOR j := 0 TO d.nkids - 1 DO
        IF d.kids[j] IS SOME sel THEN
          IF sel.kind = Ast.NSelIndex THEN
            base := res ;
            ix := EX (sel.kids[0], '') ;
            res := S7 ('(*(uint32_t *) m9_at (', base, '.p, ', ix,
              ', ', base, '.len, sizeof (uint32_t), err))') ;
            stRaise := TRUE ;
            IF DynStr.Eq (tag, 'SLICE') THEN
              tag := 'CHAR'                    (* const strings only *)
            END
          END
        END
      END ;
      RETURN res
    END ;
    (* imported constant: Mod.Name (a #define in Mod.h) *)
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sf1 THEN
        IF sf1.kind = Ast.NSelField THEN
          ci := MFind (extConsts, S3 (d.a, '.', sf1.a)) ;
          IF ci >= 0 THEN
            tag := TagOfExpr (extConsts.es[ci].v) ;
            RETURN S3 (CP (d.a), '_', sf1.a)
          END
        END
      END
    END ;
    (* a top-level procedure named as a VALUE (par 2.2.3): its C
       function, this module's or an imported module's; the checker
       has already held its head to the procedure type it lands in *)
    IF d.nkids = 0 THEN
      IF FindProcN (d.a) >= 0 THEN
        tag := 'PROC' ;
        RETURN S3 (CP (modName), '_', d.a)
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sfp THEN
        IF sfp.kind = Ast.NSelField THEN
          IF MFind (extProcs, S3 (d.a, '.', sfp.a)) >= 0 THEN
            tag := 'PROC' ;
            RETURN S3 (CP (d.a), '_', sfp.a)
          END
        END
      END
    END ;
    (* payload-less variant constructor: Type.Variant *)
    IF FindTypeN (d.a) IS SOME vt THEN
      IF (vt.kind = Ast.NCaseRecordType OR vt.kind = Ast.NEnumType) AND d.nkids = 1 THEN
        IF d.kids[0] IS SOME sf2 THEN
          IF sf2.kind = Ast.NSelField THEN
            tag := S2 ('CR:', d.a) ;
            RETURN S7 ('((', CP (modName), '_', d.a, '){ .tag = ',
              S5 (CP (modName), '_', d.a, '_', sf2.a), ' })')
          END
        END
      END
    END ;
    (* and across a module: Mod.Type.Variant, the checker's spelling
       for an imported variant, refused here until 2026-09-15 *)
    IF MFind (extMods, d.a) >= 0 AND d.nkids = 2 THEN
      IF d.kids[0] IS SOME sfT THEN
        IF d.kids[1] IS SOME sfV THEN
          IF sfT.kind = Ast.NSelField AND sfV.kind = Ast.NSelField THEN
            ci := MFind (extTypes, S3 (d.a, '.', sfT.a)) ;
            IF ci >= 0 THEN
              IF extTypes.es[ci].v IS SOME xvt THEN
                IF xvt.kind = Ast.NCaseRecordType OR xvt.kind = Ast.NEnumType THEN
                  tag := S4 ('CR:', d.a, '.', sfT.a) ;
                  RETURN S7 ('((', CP (d.a), '_', sfT.a, '){ .tag = ',
                    S5 (CP (d.a), '_', sfT.a, '_', sfV.a), ' })')
                END
              END
            END
          END
        END
      END
    END ;
    (* HEAP: the predeclared pool that is never freed (par 4.3).  A
       name in both ends or neither -- the checker types it, so the
       generator emits it. *)
    IF DynStr.Eq (d.a, 'HEAP') AND d.nkids = 0 THEN
      tag := 'POOL' ;
      RETURN 'm9_heap'
    END ;
    Err2 (d.line, S2 ('unknown name: ', d.a)) ;
    RETURN '0'
  END ;
  res := CN (d.a) ;
  IF DynStr.Eq (ScopeMode (d.a), 'v') OR
     DynStr.Eq (ScopeMode (d.a), 'o') THEN
    res := S3 ('(*', CN (d.a), ')')
  END ;
  FOR j := 0 TO d.nkids - 1 DO
    NoteMod (tnd, tmod) ;
    r2 := Resolve (tnd) ;
    IF r2 IS SOME r THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF IsPtrK (r.kind) THEN
            IF Resolve (InMod (r.kids[0], tmod)) IS SOME inner THEN
              IF inner.kind # Ast.NRecordType AND
                 inner.kind # Ast.NMonitorType THEN
                Err2 (d.line,
                  'selection through a non-record unsupported yet') ;
                RETURN '0'
              END ;
              res := S3 (res, '->', CN (sel.a)) ;
              tnd := InMod (FieldType (inner, sel.a), tmod)
            ELSE
              Err2 (d.line, 'field base type unresolvable') ;
              RETURN '0'
            END
          ELSIF r.kind = Ast.NRecordType OR
                r.kind = Ast.NMonitorType THEN
            res := S3 (res, '.', CN (sel.a)) ;
            tnd := InMod (FieldType (r, sel.a), tmod)
          ELSE
            Err2 (d.line,
              'selection through a non-record unsupported yet') ;
            RETURN '0'
          END ;
          fldOk := FALSE ;
          IF tnd IS SOME t1 THEN fldOk := TRUE END ;
          IF NOT fldOk THEN
            Err2 (d.line, S2 ('unknown record field: ', sel.a)) ;
            RETURN '0'
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            (* every axis against its own extent: the check a
               hand-rolled d[r * cols + c] cannot make *)
            base := res ;
            ec := TyC (r.kids[1]) ;
            dg := DynStr.New (gpool) ;
            FOR jj := 0 TO sel.nkids - 1 DO
              IF jj > 0 THEN DynStr.Append (dg, ', ') END ;
              DynStr.Append (dg, EX (sel.kids[jj], ''))
            END ;
            cnt := ArrCount2 (r.kids[0]) ;
            rk := sel.nkids ;
            IF rk >= 1 AND rk <= 4 THEN
              (* ranks 1..4 go to the written-out form: extents and
                 strides by value, no index array, no loop over the
                 rank.  2.60x -> 1.29x on the port's kernel, with
                 the same checks -- see runtime/m9rt.h and
                 the port's gat_cost.c. *)
              dns := DynStr.New (gpool) ;
              DynStr.Append (dns, '(*(') ;
              DynStr.Append (dns, ec) ;
              DynStr.Append (dns, ' *) m9_gat') ;
              DynStr.Append (dns, ItoA (rk)) ;
              DynStr.Append (dns, ' (') ;
              DynStr.Append (dns, base) ;
              DynStr.Append (dns, '.p, sizeof (') ;
              DynStr.Append (dns, ec) ;
              DynStr.Append (dns, '), ') ;
              FOR jj := 0 TO rk - 1 DO
                DynStr.Append (dns, base) ;
                DynStr.Append (dns, '.n[') ;
                DynStr.Append (dns, ItoA (jj)) ;
                DynStr.Append (dns, '], ')
              END ;
              FOR jj := 0 TO rk - 1 DO
                DynStr.Append (dns, base) ;
                DynStr.Append (dns, '.s[') ;
                DynStr.Append (dns, ItoA (jj)) ;
                DynStr.Append (dns, '], ')
              END ;
              DynStr.Append (dns, DynStr.View (dg)) ;
              DynStr.Append (dns, ', err))') ;
              res := DynStr.View (dns)
            ELSE
              res := S9 ('(*(', ec, ' *) m9_gat (', base, '.p, sizeof (',
                ec, '), ', base,
                S9 ('.n, ', base, '.s, (int64_t[]){', DynStr.View (dg),
                    '}, ', cnt, ', err))', '', ''))
            END ;
            stRaise := TRUE ;
            tnd := InMod (r.kids[1], tmod)
          ELSE
          ix := EX (sel.kids[0], '') ;
          IF r.kind = Ast.NSliceType THEN
            base := res ;
            ec := TyC (r.kids[0]) ;
            res := S9 ('(*(', ec, ' *) m9_at (', base, '.p, ', ix,
              ', ', base, S5 ('.len, sizeof (', ec, '), err))', '', '')) ;
            stRaise := TRUE ;
            tnd := InMod (r.kids[0], tmod)
          ELSIF r.kind = Ast.NArrayType THEN
            base := res ;
            ec := TyC (r.kids[1]) ;
            (* ARRAY Colour OF T: the subscript is an enum value, its
               tag 0..n-1 by construction -- no runtime bounds check,
               a.v[(k).tag] directly.  Detect it from the SUBSCRIPT's
               type, not the array's bound: an imported enum indexes an
               imported record's field the same way, where the bound
               name resolves only in its own module (docs/enum-plan.md,
               part 2) *)
            enumIx := FALSE ;
            IF ArrEnumBoundNode (r.kids[0]) IS SOME earr THEN
              enumIx := TRUE
            END ;
            IF NOT enumIx THEN
              IF sel.nkids >= 1 THEN
                enumIx := StartsW (TagOfExpr (sel.kids[0]), 'CR:')
              END
            END ;
            IF enumIx THEN
              res := S5 ('(', base, '.v[(', ix, ').tag])') ;
              tnd := InMod (r.kids[1], tmod)
            ELSE
              cnt := ArrCount2 (r.kids[0]) ;
              res := S9 ('(*(', ec, ' *) m9_at (', base, '.v, ', ix,
                ', INT64_C(', cnt, S5 ('), sizeof (', ec, '), err))',
                '', '')) ;
              stRaise := TRUE ;
              tnd := InMod (r.kids[1], tmod)
            END
          ELSE
            Err2 (d.line, 'index into a non-array unsupported yet') ;
            RETURN '0'
          END
          END
        END
      END
    ELSE
      Err2 (d.line, 'selector form unsupported yet') ;
      RETURN '0'
    END
  END ;
  tag := TagOfType (tnd) ;
  RETURN res
END DES ;

(* ---- expressions ---- *)

PROCEDURE EX (k: Ast.Kid ; RO want: STR) : STR =
VAR
  svHoist : BOOL ;
  l, r, lt, rt, w, tg, cop, a1, a2, cnt, res, sh : STR ;
  d2 : PTR DynStr.DString IN gpool ;
  jj, rk, ext0, nx : I64 ;
  isCat : BOOL ;
  inr, tyk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NInt :
        (* an unsigned context spells the literal UINT64_C: INT64_C of
           a value past 2^63 warned in C (the value was right) *)
        IF DynStr.Eq (want, 'U64') THEN RETURN S3 ('UINT64_C(', e.a, ')') END ;
        RETURN S3 ('INT64_C(', e.a, ')')
    | Ast.NReal :
        (* NaN's NAN is a float already, and the same NaN as a double *)
        IF DynStr.Eq (want, 'F32') AND NOT DynStr.Eq (e.a, 'NAN') THEN
          RETURN S2 (e.a, 'f')
        END ;
        RETURN e.a
    | Ast.NChar : RETURN S2 (ItoA (CharVal (e.a)), 'u')
    | Ast.NString :
        IF DynStr.Eq (want, 'CHAR') AND LEN (e.a) = 1 THEN
          RETURN S2 (ItoA (ORD (e.a[0])), 'u')
        ELSIF LEN (e.a) = 0 THEN
          RETURN '(m9_sl_CHAR){ NULL, 0 }'
        ELSIF dry > 0 THEN
          RETURN 'm9s_dry'             (* a type answer, not code *)
        ELSE
          (* static storage, never a stack compound literal: a returned
             literal (Reason's 'Not Found') must not dangle *)
          l := S2 ('m9s', ItoA (litN)) ;
          Line (KLit, 0, S7 ('static const uint32_t ', l, '[',
            ItoA (LEN (e.a)), '] = { ', StrCodes (e.a), ' };')) ;
          RETURN S5 ('((m9_sl_CHAR){ (uint32_t *) ', l, ', ',
            ItoA (LEN (e.a)), ' })')
        END
    | Ast.NTrue : RETURN 'true'
    | Ast.NFalse : RETURN 'false'
    | Ast.NNoneLit : RETURN 'NULL'
    | Ast.NSomeExpr : RETURN EX (e.kids[0], '')  (* OPT PTR is nullable *)
    | Ast.NSharedExpr :
        (* rc lives in the hidden header: rc := 1 in place (par 11) *)
        l := EX (e.kids[0], '') ;
        RETURN S5 ('((__typeof__(', l, ')) m9_share (', l, '))')
    | Ast.NParen : RETURN S3 ('(', EX (e.kids[0], want), ')')
    | Ast.NDesignator :
        tg := '?' ;
        res := DES (e, tg) ;
        (* a CONST is a C macro holding a double literal, so in an
           F32 context it must be cast or the expression widens
           around it *)
        IF DynStr.Eq (want, 'F32') THEN
          IF ConstValue (k) IS SOME cv2 THEN
            IF IsAdaptive (k) THEN RETURN S3 ('((float) ', res, ')') END
          END
        END ;
        RETURN res
    | Ast.NCallExpr :
        tg := '?' ;
        RETURN CallC (e.kids[0], e.kids[1], tg)
    | Ast.NNewExpr :
        stRaise := TRUE ;
        sh := NewShape (e, tyk, ext0) ;
        IF DynStr.Eq (sh, 'own') THEN
          l := TyC (tyk) ;
          RETURN S5 ('(', l, ' *) m9_new (sizeof (', l, '), err)')
        END ;
        IF DynStr.Eq (sh, 'pool') THEN
          r := 'err->res' ;
          IF e.kids[0] IS SOME pd THEN r := PoolAddrC (pd) END
        ELSE
          (* the frame form: the result slot, which is this frame's
             arena in the body and the caller's while a RETURN
             expression is emitted -- `+`'s rule exactly (par 2.3),
             so `RETURN NEW (T, n)` lands where it is going *)
          r := 'err->res'
        END ;
        nx := 0 ;
        FOR jj := ext0 TO e.nkids - 1 DO
          IF e.kids[jj] IS SOME dm1 THEN nx := nx + 1 END
        END ;
        IF nx > 1 THEN
          (* more than one extent is a GRID.  Row-major: the last
             axis has stride 1, so an innermost loop over the
             rightmost subscript walks memory in order.  The oracle
             computes TyC, then the temp, then the grid typedef,
             then the extents in order -- side effects are part of
             the bytes, so the order is reproduced deliberately. *)
          l := TyC (tyk) ;
          w := NewTmp () ;
          rk := nx ;
          a1 := GridTy (tyk, ItoA (rk)) ;
          d2 := DynStr.New (gpool) ;
          DynStr.Append (d2, S5 ('({ ', a1, ' ', w, '; ')) ;
          FOR jj := ext0 TO e.nkids - 1 DO
            a2 := EX (e.kids[jj], '') ;
            DynStr.Append (d2,
              S7 (w, '.n[', ItoA (jj - ext0), '] = ', a2, '; ', ''))
          END ;
          DynStr.Append (d2,
            S5 (w, '.s[', ItoA (rk - 1), '] = 1; ', '')) ;
          jj := rk - 2 ;
          WHILE jj >= 0 DO
            DynStr.Append (d2,
              S9 (w, '.s[', ItoA (jj), '] = ', w, '.s[',
                  ItoA (jj + 1), '] * ', w)) ;
            DynStr.Append (d2,
              S5 ('.n[', ItoA (jj + 1), ']; ', '', '')) ;
            jj := jj - 1
          END ;
          DynStr.Append (d2,
            S9 (w, '.p = (', l, ' *) m9_pool_alloc (', r,
                ', sizeof (', l, '), m9_gcount (', w)) ;
          DynStr.Append (d2,
            S7 ('.n, ', ItoA (rk), ', err), err); ', w, '; })', '', '')) ;
          RETURN DynStr.View (d2)
        ELSIF nx = 1 THEN
          l := TyC (tyk) ;
          a1 := SliceTy (tyk) ;          (* oracle order: TyC, then *)
          a2 := EX (e.kids[ext0], '') ;  (* SliceTy, then the count *)
          RETURN S9 ('M9_POOL_SL (', a1, ', ', l,
            ', ', r, ', ', a2, ', err)')
        ELSE
          l := TyC (tyk) ;
          RETURN S7 ('(', l, ' *) m9_pool_alloc (', r,
            ', sizeof (', l, '), 1, err)')
        END
    | Ast.NGridOf :
        (* GRID (s, n0, ..., nR): a grid of the slice's element type
           laid over its storage, row-major; m9_gridof holds the
           extents to the length and raises IndexError, answering an
           empty grid (par 2.2.1, 2026-10-08) *)
        stRaise := TRUE ;
        inr := NONE ;
        IF e.kids[0] IS SOME gds THEN
          IF gds.kind = Ast.NDesignator THEN inr := Resolve (DesigDecl (gds)) END
        END ;
        tyk := NONE ;
        IF inr IS SOME gin THEN
          IF gin.kind = Ast.NSliceType THEN tyk := gin.kids[0] END
        END ;
        IF tyk IS SOME gel THEN
          rk := e.nkids - 1 ;
          tg := GridTy (tyk, ItoA (rk)) ;
          l := EX (e.kids[0], '') ;
          w := NewTmp () ;
          d2 := DynStr.New (gpool) ;
          DynStr.Append (d2, S7 ('({ __typeof__(', l, ') ', w, ' = ', l, '; ')) ;
          DynStr.Append (d2, S7 (tg, ' ', w, 'r; int64_t ', w, 'n[', ItoA (rk))) ;
          DynStr.Append (d2, '] = { ') ;
          FOR jj := 1 TO e.nkids - 1 DO
            IF jj > 1 THEN DynStr.Append (d2, ', ') END ;
            a1 := EX (e.kids[jj], '') ;
            DynStr.Append (d2, a1)
          END ;
          DynStr.Append (d2, S9 (' }; m9_gridof (', w, '.len, ', w, 'n, ', ItoA (rk), ', ', w, 'r.n, ')) ;
          DynStr.Append (d2, S7 (w, 'r.s, err); ', w, 'r.p = ', w, '.p; ', '')) ;
          DynStr.Append (d2, S2 (w, 'r; })')) ;
          RETURN DynStr.View (d2)
        END ;
        Err2 (e.line, 'GRID of an expression that is not a slice designator') ;
        RETURN '0'
    | Ast.NSliceOf3 :
        stRaise := TRUE ;
        lt := TagOfExpr (e.kids[0]) ;
        l := EX (e.kids[0], '') ;
        w := NewTmp () ;
        IF DynStr.Eq (lt, 'SLICE') THEN
          a1 := EX (e.kids[1], '') ;
          a2 := EX (e.kids[2], '') ;
          d2 := DynStr.New (gpool) ;
          DynStr.Append (d2, '({ __typeof__(') ;
          DynStr.Append (d2, l) ;
          DynStr.Append (d2, ') ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, ' = ') ;
          DynStr.Append (d2, l) ;
          DynStr.Append (d2, '; int64_t ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, 'a = ') ;
          DynStr.Append (d2, a1) ;
          DynStr.Append (d2, ', ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, 'n = ') ;
          DynStr.Append (d2, a2) ;
          DynStr.Append (d2, '; (__typeof__(') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, ')){ ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, '.p + m9_chk_slice (') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, 'a, ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, 'n, ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, '.len, err), ') ;
          DynStr.Append (d2, w) ;
          DynStr.Append (d2, 'n }; })') ;
          RETURN DynStr.View (d2)
        ELSIF DynStr.Eq (lt, 'ARR') THEN
          (* the view of an array's elements (par 2.2) *)
          inr := NONE ;
          IF e.kids[0] IS SOME desg THEN
            inr := Resolve (DesigDecl (desg))
          END ;
          IF inr IS SOME inn THEN
            IF inn.kind # Ast.NArrayType THEN
              Err2 (e.line, 'SLICE() of non-slice unsupported yet') ;
              RETURN '0'
            END ;
            a1 := EX (e.kids[1], '') ;
            a2 := EX (e.kids[2], '') ;
            cnt := ArrCount2 (inn.kids[0]) ;
            d2 := DynStr.New (gpool) ;
            DynStr.Append (d2, '({ int64_t ') ;
            DynStr.Append (d2, w) ;
            DynStr.Append (d2, 'a = ') ;
            DynStr.Append (d2, a1) ;
            DynStr.Append (d2, ', ') ;
            DynStr.Append (d2, w) ;
            DynStr.Append (d2, 'n = ') ;
            DynStr.Append (d2, a2) ;
            DynStr.Append (d2, '; (') ;
            DynStr.Append (d2, SliceTy (inn.kids[1])) ;
            DynStr.Append (d2, '){ (') ;
            DynStr.Append (d2, l) ;
            DynStr.Append (d2, ').v + m9_chk_slice (') ;
            DynStr.Append (d2, w) ;
            DynStr.Append (d2, 'a, ') ;
            DynStr.Append (d2, w) ;
            DynStr.Append (d2, 'n, INT64_C(') ;
            DynStr.Append (d2, cnt) ;
            DynStr.Append (d2, '), err), ') ;
            DynStr.Append (d2, w) ;
            DynStr.Append (d2, 'n }; })') ;
            RETURN DynStr.View (d2)
          ELSE
            Err2 (e.line, 'SLICE() argument form unsupported yet') ;
            RETURN '0'
          END
        ELSE
          Err2 (e.line, 'SLICE() argument form unsupported yet') ;
          RETURN '0'
        END
    | Ast.NBin :
        lt := TagOfExpr (e.kids[0]) ;
        IF DynStr.Eq (lt, 'I64') THEN lt := TagOfExpr (e.kids[1]) END ;
        IF IsAdaptive (e.kids[0]) THEN lt := TagOfExpr (e.kids[1]) END ;
        (* string concatenation: `+` where either side is a slice.
           The checker has already refused every other slice element
           type, so a SLICE tag here is a string.  Both sides are
           wanted AS SLICES -- a one-character literal is a string in
           this position, not a CHAR. *)
        isCat := FALSE ;
        rt := '' ;
        IF DynStr.Eq (e.a, '+') THEN
          rt := TagOfExpr (e.kids[1]) ;
          IF DynStr.Eq (lt, 'SLICE') OR DynStr.Eq (lt, 'STR1') OR
             DynStr.Eq (rt, 'SLICE') OR DynStr.Eq (rt, 'STR1') THEN
            isCat := TRUE
          END
        END ;
        IF isCat THEN
          (* a CHAR on one side is one code point appended or
             prepended: m9_cat over a one-element view of it (par 2.3,
             revised 2026-09-06).  A one-character LITERAL is STR1,
             not CHAR, and stays on the slice path. *)
          IF DynStr.Eq (lt, 'CHAR') THEN
            l := EX (e.kids[0], 'CHAR') ;
            r := EX (e.kids[1], 'SLICE') ;
            stRaise := TRUE ;
            RETURN S5 ('m9_ch_cat (err->res, ', l, ', ', r, ', err)')
          END ;
          IF DynStr.Eq (rt, 'CHAR') THEN
            l := EX (e.kids[0], 'SLICE') ;
            r := EX (e.kids[1], 'CHAR') ;
            stRaise := TRUE ;
            RETURN S5 ('m9_cat_ch (err->res, ', l, ', ', r, ', err)')
          END ;
          l := EX (e.kids[0], 'SLICE') ;
          r := EX (e.kids[1], 'SLICE') ;
          stRaise := TRUE ;
          (* the slot, not HEAP: this frame normally, the caller's
             arena while a RETURN expression is being emitted *)
          RETURN S5 ('m9_cat (err->res, ', l, ', ', r, ', err)')
        END ;
        w := '' ;
        IF DynStr.Eq (lt, 'CHAR') OR DynStr.Eq (lt, 'STR1') THEN
          w := 'CHAR'
        END ;
        (* at single precision the literals must be single too, or C
           widens the whole expression and narrows once at the end *)
        IF DynStr.Eq (lt, 'F32') THEN w := 'F32' END ;
        IF DynStr.Eq (lt, 'U64') THEN w := 'U64' END ;
        (* and an adaptive node -- `5.02808 * 0.43429`, all literals
           -- has no width of its own, so it takes the context's
           rather than recomputing one from operands that have none *)
        IF LEN (want) > 0 THEN
          IF IsAdaptive (k) THEN w := want END
        END ;
        l := EX (e.kids[0], w) ;
        (* the right operand of AND and OR is evaluated only when the
           left decides nothing (short-circuit, par 2.3): a raising
           argument in it is NOT hoisted ahead of the operator --
           found by gendiff, when the M9-compiled generator evaluated
           TagOfExpr eagerly in `tg = 'SHARED' AND TagOfExpr (..)'
           and numbered its temporaries one ahead of the oracle *)
        IF DynStr.Eq (e.a, 'AND') OR DynStr.Eq (e.a, 'OR') THEN
          svHoist := hoistOk ;
          hoistOk := FALSE ;
          r := EX (e.kids[1], w) ;
          hoistOk := svHoist
        ELSE
          r := EX (e.kids[1], w)
        END ;
        cop := e.a ;
        IF DynStr.Eq (cop, '=') THEN cop := '=='
        ELSIF DynStr.Eq (cop, '#') THEN cop := '!='
        ELSIF DynStr.Eq (cop, 'AND') THEN cop := '&&'
        ELSIF DynStr.Eq (cop, 'OR') THEN cop := '||' END ;
        IF DynStr.Eq (cop, '+') OR DynStr.Eq (cop, '-') OR
           DynStr.Eq (cop, '*') THEN
          (* AN UNKNOWN TYPE MUST NOT BECOME INTEGER ARITHMETIC.  A
             tag of '?' means the generator could not resolve an
             operand's type -- most often a callee whose signature
             names a type from a module this one does not import --
             and the integer arm would emit checked 64-bit adds over
             doubles: a program that runs and answers wrong. *)
          IF DynStr.Eq (lt, '?') THEN
            Err2 (e.line,
              'arithmetic on an operand of unresolved type') ;
            RETURN '0'
          END ;
          IF DynStr.Eq (lt, 'F64') OR DynStr.Eq (lt, 'F32') THEN
            RETURN S5 ('(', l, S3 (' ', cop, ' '), r, ')')
          ELSE
            stRaise := TRUE ;
            IF DynStr.Eq (cop, '+') THEN
              RETURN S5 (S3 ('m9_add_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            ELSIF DynStr.Eq (cop, '-') THEN
              RETURN S5 (S3 ('m9_sub_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            ELSE
              RETURN S5 (S3 ('m9_mul_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            END
          END
        ELSIF DynStr.Eq (cop, '/') THEN
          RETURN S5 ('(', l, ' / ', r, ')')
        ELSIF DynStr.Eq (cop, 'DIV') THEN
          stRaise := TRUE ;
          RETURN S5 (S3 ('m9_div_', ISuf (lt), ' ('), l, ', ', r, ', err)')
        ELSIF DynStr.Eq (cop, 'MOD') THEN
          stRaise := TRUE ;
          RETURN S5 (S3 ('m9_mod_', ISuf (lt), ' ('), l, ', ', r, ', err)')
        ELSIF DynStr.Eq (cop, '+%') THEN
          RETURN S5 ('m9_addw_i64 (', l, ', ', r, ')')
        ELSIF DynStr.Eq (cop, '-%') THEN
          RETURN S5 ('m9_subw_i64 (', l, ', ', r, ')')
        ELSIF DynStr.Eq (cop, '*%') THEN
          RETURN S5 ('m9_mulw_i64 (', l, ', ', r, ')')
        ELSIF (DynStr.Eq (cop, '==') OR DynStr.Eq (cop, '!=')) AND
              StartsW (lt, 'CR:') THEN
          (* two enumeration (or case-record) values compare by tag:
             `k = Kind.Int' is a struct == in C, which gcc refuses --
             the tag is what carries identity (docs/enum-plan.md) *)
          RETURN S7 ('((', l, ').tag ', cop, ' (', r, ').tag)')
        ELSE
          RETURN S5 ('(', l, S3 (' ', cop, ' '), r, ')')
        END
    | Ast.NUn :
        l := EX (e.kids[0], want) ;
        IF DynStr.Eq (e.a, 'NOT') THEN
          RETURN S3 ('(!', l, ')')
        ELSIF DynStr.Eq (e.a, '-') THEN
          lt := TagOfExpr (e.kids[0]) ;
          IF DynStr.Eq (lt, 'F64') OR DynStr.Eq (lt, 'F32') THEN
            RETURN S3 ('(- ', l, ')')
          ELSE
            stRaise := TRUE ;
            RETURN S3 (S3 ('m9_neg_', ISuf (lt), ' ('), l, ', err)')
          END
        ELSE
          RETURN l
        END
    ELSE
      Err2 (e.line, 'expression kind unsupported yet') ;
      RETURN '0'
    END
  END ;
  RETURN '0'
END EX ;

(* ---- calls ---- *)

PROCEDURE EnumConvCount (n: PTR Ast.Node) : I64 =
  (* the member count of a type convertible from an integer -- an
     enumeration, or a case record all of whose variants are
     payload-less -- else -1.  A typed parameter, so the field reads
     do not fall on an IS SOME binder (which the FPC generator types
     as unknown -- `field on non-record'). *)
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NEnumType THEN RETURN n.nkids END ;
  IF n.kind = Ast.NCaseRecordType THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kids[i] IS SOME v THEN
        IF v.kids[0] IS SOME vf THEN RETURN 0 - 1 END
      END
    END ;
    RETURN n.nkids
  END ;
  RETURN 0 - 1
END EnumConvCount ;

PROCEDURE Arg0 (argl: Ast.Kid) : Ast.Kid =
  (* the first argument as a node, without a field read on an IS SOME
     binder at the caller *)
BEGIN
  IF argl IS SOME a THEN RETURN a.kids[0] END ;
  RETURN NONE
END Arg0 ;

(* the RECORD a callee names -- this module's `Row' or an imported
   `Mod.Row' -- and its C type name, or NONE (Sem.RecordNamed) *)
PROCEDURE RecordAt (RO name: STR ; VAR ctype: STR ; VAR m: STR ; VAR tn: STR) : Ast.Kid =
VAR
  dot, ei, depth : I64 ;
  t : Ast.Kid ;
BEGIN
  dot := 0 - 1 ;
  FOR ei := 0 TO LEN (name) - 1 DO
    IF name[ei] = '.' AND dot < 0 THEN dot := ei END
  END ;
  IF dot < 0 THEN
    m := modName ;
    tn := name
  ELSE
    m := SLICE (name, 0, dot) ;
    tn := SLICE (name, dot + 1, LEN (name) - dot - 1)
  END ;
  (* follow an alias BY NAME to the record it stands for: an alias has
     no C type of its own, and the record's is Mod_Name where it was
     declared *)
  FOR depth := 0 TO 7 DO
    IF DynStr.Eq (m, modName) THEN
      t := FindTypeN (tn)
    ELSE
      ei := MFind (extTypes, S3 (m, '.', tn)) ;
      IF ei < 0 THEN RETURN NONE END ;
      t := extTypes.es[ei].v
    END ;
    IF t IS SOME n THEN
      IF n.kind = Ast.NRecordType THEN
        ctype := S3 (CP (m), '_', tn) ;
        RETURN SOME (n)
      ELSIF n.kind = Ast.NQualident THEN
        IF LEN (n.b) > 0 THEN
          m := n.a ;
          tn := n.b
        ELSE
          tn := n.a
        END
      ELSE
        RETURN NONE
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN NONE
END RecordAt ;

(* A RAISING CALL NESTED AS AN ARGUMENT IS GUARDED BEFORE THE
   ENCLOSING CALL RUNS (report par 5, 2026-10-08; the owed item from
   ONEFlux's report 18).  `F (G (x))' was one C expression under one
   guard after the statement, so F ran on whatever G had answered
   when it raised -- a zero, a NULL -- before the handler saw G's
   error.  An argument whose rendering set stRaise goes into a
   temporary with its own guard, in a block the statement closes
   (CloseHoists): `{ __typeof__(G (x)) m9a1 = G (x); if (err->exc)
   goto L;' and F gets m9a1.  Only where the statement is evaluated
   once -- an assignment, a call statement, a RETURN: a hoist out of
   a WHILE's condition or an ELSIF's would evaluate it once where the
   program evaluates it each time or never.  Nothing when answering a
   type (dry). *)
PROCEDURE HoistArg (RO a: STR) : STR =
VAR tmp : STR ;
BEGIN
  IF NOT hoistOk OR dry > 0 THEN RETURN a END ;
  nhoist := nhoist + 1 ;
  tmp := S2 ('m9a', ItoA (nhoist)) ;
  Line (KPbuf, hoistInd, S6 ('{ __typeof__(', a, ') ', tmp, ' = ', S2 (a, ';'))) ;
  Line (KPbuf, hoistInd + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
  hoistOpen := hoistOpen + 1 ;
  RETURN tmp
END HoistArg ;

(* the statement that allowed hoisting closes what HoistArg opened *)
PROCEDURE CloseHoists (ind: I64) =
BEGIN
  WHILE hoistOpen > 0 DO
    Line (KPbuf, ind, '}') ;
    hoistOpen := hoistOpen - 1
  END ;
  hoistOk := FALSE
END CloseHoists ;

PROCEDURE CallC (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: STR) : STR =
VAR
  name, args, at, want2, tn, vn, cfunc, e1, e2, res, cnt : STR ;
  svRaise : BOOL ;
  gname, xtn : STR ;
  pi, g, j, k, k2, nargs, dot, dot2, nf32, nf64, eln : I64 ;
  pnodeK, ak, vgrid, aliasK, enode : Ast.Kid ;
  ser, pv : BOOL ;
  d3 : PTR DynStr.DString IN gpool ;
BEGIN
  tag := '?' ;
  name := '' ;
  nargs := 0 ;
  eln := 0 ;
  IF dn IS SOME d9 THEN eln := d9.line END ;
  IF dn IS SOME dnode THEN
    (* the dotted callee name: every field selector joins, so
       Mod.Type.Variant reaches the constructor branch whole -- the
       two-part cut read it as procedure `Csv' and refused it as
       `callee unsupported yet' until 2026-09-15 *)
    name := dnode.a ;
    FOR j := 0 TO dnode.nkids - 1 DO
      IF dnode.kids[j] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.a) END
      END
    END
  ELSE
    Err2 (eln, 'designator form unsupported yet') ;
    RETURN '0'
  END ;
  IF argl IS SOME al0 THEN nargs := al0.nkids END ;

  (* A RECORD AGGREGATE: Row (a, b), or Mod.Row (a, b) -- a compound
     literal of the record's C type, the fields in declaration order,
     which is the struct's order (report par 2.2.4) *)
  IF RecordAt (name, cfunc, gname, xtn) IS SOME rn THEN
    tag := 'REC' ;
    args := '' ;
    k2 := 0 ;
    IF rn.kids[1] IS SOME rfs THEN
      FOR g := 0 TO rfs.nkids - 1 DO
        IF rfs.kids[g] IS SOME rg THEN
          IF rg.kids[0] IS SOME rids THEN
            FOR j := 0 TO rids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME ral THEN
                  IF LEN (args) > 0 THEN args := S2 (args, ', ') END ;
                  want2 := TagOfType (rg.kids[1]) ;
                  args := S2 (args, EX (ral.kids[k2], want2))
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN Err2 (eln, 'record aggregate arity wrong') END ;
    RETURN S5 ('((', cfunc, '){ ', args, ' })')
  END ;

  (* AN INTEGER TO AN ENUMERATION: Colour (i), or Palette.Hue (i),
     the checked inverse of ORD.  The callee is a type -- an enum or a
     payload-less case record -- and CRNode/CRPrefix already resolve
     it for either spelling.  m9_enum raises ValueRange for a value
     that names no member (docs/enum-plan.md). *)
  IF nargs = 1 THEN
    IF CRNode (name) IS SOME enode THEN
      nf32 := EnumConvCount (enode) ;      (* reuse nf32 as a scratch *)
      IF nf32 >= 0 THEN
        tag := S2 ('CR:', name) ;
        stRaise := TRUE ;
        RETURN S7 ('((', CRPrefix (name), '){ .tag = m9_enum ((int64_t)(',
          EX (Arg0 (argl), ''), '), INT64_C(', ItoA (nf32),
          '), err) })')
      END
    END
  END ;

  (* An ALIAS FOR A SCALAR IS A CONVERSION under its own name.  The
     checker already treats `TYPE Real = F32` as F32 for assignment,
     arguments and RETURN -- aliases chase to structure -- so `Real
     (x)` meaning anything other than `F32 (x)` would be the odd
     case.  Chased here, once, so every conversion below applies
     unchanged.  Forced by a Fortran port, which needs one source
     buildable at both of the original's real kinds. *)
  IF nargs = 1 AND NOT IsBuiltin (name) THEN
    dot := FindCh (name, '.') ;
    IF dot > 0 THEN
      pi := MFind (extTypes, name)
    ELSE
      pi := -1 ;
      IF FindTypeN (name) IS SOME tnx THEN
        aliasK := SOME (tnx)
      ELSE
        pi := ExtBare (name)
      END
    END ;
    IF pi >= 0 THEN aliasK := extTypes.es[pi].v END ;
    IF aliasK IS SOME ak0 THEN
      aliasK := Resolve (SOME (ak0)) ;
      IF aliasK IS SOME ak1 THEN
        IF ak1.kind = Ast.NQualident AND LEN (ak1.b) = 0 THEN
          IF IsBuiltin (ak1.a) THEN name := ak1.a END
        END
      END
    END
  END ;

  (* builtins the milestone needs *)
  IF argl IS SOME al THEN
    IF DynStr.Eq (name, 'LEN') THEN
      at := TagOfExpr (al.kids[0]) ;
      (* a grid has one length per axis, so LEN names the axis *)
      IF DynStr.Eq (at, 'GRID') AND nargs = 2 THEN
        tag := 'I64' ;
        e1 := EX (al.kids[0], '') ;
        e2 := EX (al.kids[1], '') ;
        RETURN S5 ('(', e1, ').n[', e2, ']')
      END ;
      IF DynStr.Eq (at, 'SLICE') THEN
        tag := 'I64' ;
        RETURN S3 ('(', EX (al.kids[0], ''), ').len')
      END ;
      IF DynStr.Eq (at, 'ARR') THEN
        IF al.kids[0] IS SOME a0 THEN
          IF Resolve (ScopeNode (a0.a)) IS SOME arr THEN
            IF arr.kind = Ast.NArrayType THEN
              tag := 'I64' ;
              RETURN S3 ('INT64_C(', ArrCount2 (arr.kids[0]), ')')
            END
          END
        END
      END ;
      tag := 'I64' ;
      RETURN S3 ('(', EX (al.kids[0], ''), ').len')
    END ;
    (* VIEW (g, i, ALL, ...): a borrowed sub-grid.  The axes are
       known here, so the loop is unrolled and the rank of the answer
       is a compile-time fact -- which is what lets a view have a type
       at all.  Dropped axes are CHECKED where the view is taken. *)
    IF DynStr.Eq (name, 'VIEW') THEN
      vgrid := NONE ;
      IF al.kids[0] IS SOME vg0 THEN vgrid := Resolve (DesigDecl (vg0)) END ;
      IF vgrid IS SOME vd THEN
        IF vd.kind # Ast.NGridType THEN
          Err2 (eln, 'VIEW of a non-GRID') ;
          RETURN '0'
        END ;
        k2 := 0 ;
        FOR j := 1 TO nargs - 1 DO
          IF IsAllArg (al.kids[j]) THEN k2 := k2 + 1 END
        END ;
        vn := NewTmp () ;
        tn := TyC (vgrid) ;
        want2 := GridTy (vd.kids[1], ItoA (k2)) ;
        e1 := EX (al.kids[0], '') ;
        d3 := DynStr.New (gpool) ;
        DynStr.Append (d3, S7 ('({ ', tn, ' ', vn, ' = ', e1, '; ')) ;
        DynStr.Append (d3,
          S7 (want2, ' ', vn, 'r; int64_t ', vn, 'o = 0; ', '')) ;
        g := 0 ;
        FOR j := 1 TO nargs - 1 DO
          IF IsAllArg (al.kids[j]) THEN
            DynStr.Append (d3,
              S9 (vn, 'r.n[', ItoA (g), '] = ', vn, '.n[',
                  ItoA (j - 1), ']; ', '')) ;
            DynStr.Append (d3,
              S9 (vn, 'r.s[', ItoA (g), '] = ', vn, '.s[',
                  ItoA (j - 1), ']; ', '')) ;
            g := g + 1
          ELSE
            e2 := EX (al.kids[j], '') ;
            DynStr.Append (d3,
              S9 (vn, 'o += m9_gdrop (', e2, ', ', vn, '.n[',
                  ItoA (j - 1), '], ', vn)) ;
            DynStr.Append (d3,
              S5 ('.s[', ItoA (j - 1), '], err); ', '', ''))
          END
        END ;
        DynStr.Append (d3,
          S9 (vn, 'r.p = ', vn, '.p + ', vn, 'o; ', vn, 'r; })', '')) ;
        stRaise := TRUE ;
        tag := 'GRID' ;
        RETURN DynStr.View (d3)
      END ;
      Err2 (eln, 'VIEW form unsupported yet') ;
      RETURN '0'
    END ;
    IF DynStr.Eq (name, 'ORD') THEN
      tag := 'I64' ;
      (* an enumeration (or any payload-less case record) answers its
         tag; a CHAR answers its code point.  ORD (Colour.Red) is 0,
         ORD (c) is the member's position, 0..n-1 (docs/enum-plan.md) *)
      IF StartsW (TagOfExpr (al.kids[0]), 'CR:') THEN
        RETURN S3 ('(int64_t)((', EX (al.kids[0], ''), ').tag)')
      END ;
      RETURN S3 ('(int64_t)(', EX (al.kids[0], 'CHAR'), ')')
    END ;
    IF DynStr.Eq (name, 'NAME') THEN
      (* the member's identifier as a STR, from the table emitted
         beside the tag #defines: NAME (Colour.Red) is 'Red'.  The
         tag names the type -- CR:Kind at home, CR:Mod.Kind abroad --
         and CRPrefix turns either into the C table name *)
      tag := 'SLICE' ;
      at := TagOfExpr (al.kids[0]) ;
      RETURN S6 ('(', CRPrefix (SLICE (at, 3, LEN (at) - 3)), '_names[(',
        EX (al.kids[0], ''), ').tag])', '')
    END ;
    IF DynStr.Eq (name, 'CHR') THEN
      tag := 'CHAR' ;
      stRaise := TRUE ;
      RETURN S3 ('m9_chr (', EX (al.kids[0], ''), ', err)')
    END ;
    IF DynStr.Eq (name, 'BYTE') THEN
      tag := 'BYTE' ;
      stRaise := TRUE ;
      RETURN S3 ('m9_byte (', EX (al.kids[0], ''), ', err)')
    END ;
    (* the other widths, each a checked narrowing: the museum's
       founding bug is a width that converted itself, so every one of
       these is a call that can raise rather than a cast that cannot *)
    IF IsWidthConv (name) THEN
      tag := name ;
      stRaise := TRUE ;
      RETURN S5 ('m9_', LowerName (name), ' (', EX (al.kids[0], ''),
        ', err)')
    END ;
    IF DynStr.Eq (name, 'I64') THEN
      tag := 'I64' ;
      at := TagOfExpr (al.kids[0]) ;
      IF DynStr.Eq (at, 'F64') OR DynStr.Eq (at, 'F32') THEN
        stRaise := TRUE ;
        RETURN S3 ('m9_i64_f64 ((double)(', EX (al.kids[0], ''),
          '), err)')
      END ;
      RETURN S3 ('(int64_t)(', EX (al.kids[0], ''), ')')
    END ;
    IF DynStr.Eq (name, 'F64') THEN
      tag := 'F64' ;
      RETURN S3 ('(double)(', EX (al.kids[0], ''), ')')
    END ;
    IF DynStr.Eq (name, 'F32') THEN
      tag := 'F32' ;
      (* from a double: checked, a value beyond F32's range raises
         ValueRange where C's cast gives an infinity (2026-10-08) *)
      at := TagOfExpr (al.kids[0]) ;
      IF DynStr.Eq (at, 'F64') THEN
        stRaise := TRUE ;
        RETURN S3 ('m9_f32_f64 (', EX (al.kids[0], ''), ', err)')
      END ;
      RETURN S3 ('(float)(', EX (al.kids[0], ''), ')')
    END ;
    IF DynStr.Eq (name, 'MAX') THEN
      IF al.kids[0] IS SOME m0 THEN
        tag := m0.a ;
        IF DynStr.Eq (m0.a, 'I64') THEN RETURN 'INT64_MAX' END
      END ;
      Err2 (eln, 'MAX of this type unsupported yet') ;
      RETURN '0'
    END ;
    (* SizeOf (x): x's type size, a compile-time C sizeof.  A bare
       builtin or user type name asks the type; else the value's
       type (sizeof does not evaluate).  A slice's SizeOf is its
       descriptor; ByteSize is the data.  In-memory only. *)
    IF DynStr.Eq (name, 'SizeOf') THEN
      tag := 'I64' ;
      IF al.kids[0] IS SOME s0 THEN
        IF s0.kind = Ast.NDesignator AND s0.nkids = 0 THEN
          IF LEN (BuiltinC (s0.a)) > 0 THEN
            RETURN S3 ('((int64_t) sizeof (', BuiltinC (s0.a), '))')
          END ;
          IF FindTypeN (s0.a) IS SOME ft THEN
            RETURN S5 ('((int64_t) sizeof (', CP (modName), '_', s0.a, '))')
          END
        END
      END ;
      RETURN S3 ('((int64_t) sizeof (', EX (al.kids[0], ''), '))')
    END ;
    (* ByteSize (s): LEN times element size; the element size is
       read off the slice's pointer type, unevaluated *)
    IF DynStr.Eq (name, 'ByteSize') THEN
      tag := 'I64' ;
      at := EX (al.kids[0], '') ;
      RETURN S5 ('((int64_t) (', at, ').len * (int64_t) sizeof (*(', at, ').p))')
    END ;
    IF DynStr.Eq (name, 'ADR') THEN
      tag := '?' ;
      at := TagOfExpr (al.kids[0]) ;
      IF DynStr.Eq (at, 'SLICE') THEN
        RETURN S3 ('((void *)(', EX (al.kids[0], ''), ').p)')
      END ;
      IF DynStr.Eq (at, 'ARR') THEN
        RETURN S3 ('((void *)(', EX (al.kids[0], ''), ').v)')
      END ;
      Err2 (eln, 'ADR of non-slice unsupported yet') ;
      RETURN '0'
    END
  END ;

  (* WIDTH DISPATCH BY DECLARED TWIN, the generator half.  The checker
     resolved `Math.Sqrt (x)` on an F32 to Math.SqrtF32 and typed it;
     the call has to be EMITTED to the same procedure or the two ends
     disagree about which program this is.

     HERE, and not before the builtins: up there it would ask
     TagOfExpr for the first argument's type on every call, and
     `MAX (I64)` passes a TYPE NAME rather than an expression.  A
     builtin has no twin by construction, so this is the only place
     the rule can apply. *)
  IF nargs >= 1 AND LEN (name) > 3 THEN
    IF NOT DynStr.Eq (SLICE (name, LEN (name) - 3, 3), 'F32') THEN
      dot := FindCh (name, '.') ;
      IF dot > 0 OR FindProcN (name) >= 0 THEN
        IF argl IS SOME alw THEN
          (* SOME argument is F32 and NONE is F64 -- the checker's
             rule, character for character, because the two ends must
             agree about which procedure this call is.  A literal
             types as neither width, so Math.Pow (10.0, c) dispatches
             on c. *)
          nf32 := 0 ;
          nf64 := 0 ;
          FOR k2 := 0 TO nargs - 1 DO
            (* an adaptive argument is neither width and must not
               vote: Math.Pow (10.0, c) dispatches on c *)
            IF NOT IsAdaptive (alw.kids[k2]) THEN
              at := TagOfExpr (alw.kids[k2]) ;
              IF DynStr.Eq (at, 'F32') THEN nf32 := nf32 + 1 END ;
              IF DynStr.Eq (at, 'F64') THEN nf64 := nf64 + 1 END
            END
          END ;
          IF nf32 > 0 AND nf64 = 0 THEN
            IF dot > 0 THEN
              IF MFind (extProcs, S2 (name, 'F32')) >= 0 THEN
                name := S2 (name, 'F32')
              END
            ELSE
              IF FindProcN (S2 (name, 'F32')) >= 0 THEN
                name := S2 (name, 'F32')
              END
            END
          END
        END
      END
    END
  END ;

  pnodeK := NONE ;
  cfunc := '' ;
  dot := FindCh (name, '.') ;
  IF dot >= 0 THEN
    tn := SLICE (name, 0, dot) ;
    vn := SLICE (name, dot + 1, LEN (name) - dot - 1) ;
    (* C.* conversion: a cast at the foreign boundary *)
    IF DynStr.Eq (tn, 'C') THEN
      at := CMap (vn) ;
      IF LEN (at) = 0 THEN
        Err2 (eln, S2 ('unknown C type: C.', vn)) ;
        RETURN '0'
      END ;
      tag := '?' ;
      IF nargs # 1 THEN
        Err2 (eln, 'a conversion takes one argument')
      END ;
      IF argl IS SOME alc THEN
        RETURN S5 ('((', at, ')(', EX (alc.kids[0], ''), '))')
      END ;
      RETURN '0'
    END ;
    (* the wire boundary: F64/F32 . From/ToBytesLE (par 2.1) *)
    IF (DynStr.Eq (tn, 'F64') OR DynStr.Eq (tn, 'F32')) AND
       DynStr.Eq (vn, 'FromBytesLE') THEN
      IF nargs # 1 THEN
        Err2 (eln, 'FromBytesLE takes one argument')
      END ;
      stRaise := TRUE ;
      tag := tn ;
      IF argl IS SOME alf THEN
        IF DynStr.Eq (tn, 'F64') THEN
          RETURN S3 ('m9_f64_from_le (', EX (alf.kids[0], ''), ', err)')
        END ;
        RETURN S3 ('m9_f32_from_le (', EX (alf.kids[0], ''), ', err)')
      END ;
      RETURN '0'
    END ;
    IF (DynStr.Eq (tn, 'F64') OR DynStr.Eq (tn, 'F32')) AND
       DynStr.Eq (vn, 'ToBytesLE') THEN
      IF nargs # 2 THEN
        Err2 (eln, 'ToBytesLE takes two arguments')
      END ;
      stRaise := TRUE ;
      tag := '?' ;
      IF argl IS SOME alt THEN
        e1 := EX (alt.kids[0], '') ;
        e2 := EX (alt.kids[1], '') ;
        IF DynStr.Eq (tn, 'F64') THEN
          RETURN S5 ('m9_f64_to_le (', e1, ', ', e2, ', err)')
        END ;
        RETURN S5 ('m9_f32_to_le (', e1, ', ', e2, ', err)')
      END ;
      RETURN '0'
    END ;
    (* variant constructor with payload: Type.Variant (args) *)
    IF FindTypeN (tn) IS SOME vt THEN
      IF vt.kind = Ast.NCaseRecordType OR vt.kind = Ast.NEnumType THEN
        RETURN VariantCtor (vt, tn, vn, argl, nargs, tag)
      END
    END ;
    (* and Mod.Type.Variant (args), the type's module named: the
       callee split at its first dot reads as module Mod, procedure
       `Type.Variant', which is no procedure.  CRPrefix and the CR:
       tag both carry `Mod.Type' since 2026-09-15. *)
    dot2 := 0 - 1 ;
    FOR k := 0 TO LEN (vn) - 1 DO
      IF vn[k] = '.' AND dot2 < 0 THEN dot2 := k END
    END ;
    IF dot2 > 0 THEN
      xtn := S3 (tn, '.', SLICE (vn, 0, dot2)) ;
      IF CRNode (xtn) IS SOME xvt THEN
        IF xvt.kind = Ast.NCaseRecordType OR xvt.kind = Ast.NEnumType THEN
          RETURN VariantCtor (xvt, xtn,
                              SLICE (vn, dot2 + 1, LEN (vn) - dot2 - 1),
                              argl, nargs, tag)
        END
      END
    END ;
    (* cross-module call: Mod.Proc against a loaded extern def *)
    g := MFind (extProcs, name) ;
    IF g >= 0 THEN
      pnodeK := extProcs.es[g].v ;
      cfunc := S3 (CP (tn), '_', vn)
    END
  ELSE
    (* a call THROUGH A PROCEDURE VALUE (par 2.2.3): a parameter or
       an IS SOME binder whose type is a procedure type.  Its head
       drives the argument conversion below exactly as a declaration's
       would, and the call is `name (args, err)` on the C pointer. *)
    pv := FALSE ;
    IF Resolve (ScopeNode (name)) IS SOME svt THEN
      IF svt.kind = Ast.NProcType THEN
        pnodeK := SOME (svt) ;
        cfunc := CN (name) ;
        pv := TRUE
      END
    END ;
    IF NOT pv THEN
    (* the module's own procedures shadow foreign imports *)
    pi := FindProcN (name) ;
    IF pi >= 0 THEN
      pnodeK := gps[pi].node ;
      cfunc := S3 (CP (modName), '_', name)
    ELSE
      (* foreign procedure: direct extern call, no err slot (par 11) *)
      pi := MFind (foreignProcs, name) ;
      IF pi >= 0 THEN
        IF foreignProcs.es[pi].v IS SOME fp THEN
          tag := '?' ;
          args := '' ;
          k2 := 0 ;
          IF fp.kids[0] IS SOME fpl THEN
            FOR g := 0 TO fpl.nkids - 1 DO
              IF fpl.kids[g] IS SOME fg THEN
                IF fg.kids[0] IS SOME fids THEN
                  FOR j := 0 TO fids.nkids - 1 DO
                    IF k2 < nargs THEN
                      IF argl IS SOME alx THEN
                        IF LEN (args) > 0 THEN args := S2 (args, ', ') END ;
                        args := S2 (args, EX (alx.kids[k2], ''))
                      END
                    END ;
                    k2 := k2 + 1
                  END
                END
              END
            END
          END ;
          IF k2 # nargs THEN Err2 (eln, 'call arity wrong') END ;

          (* [SERIAL] MEANS SERIALISED, NOT FORBIDDEN.

             The attribute says this foreign procedure may not be
             called concurrently -- ecCodes on a global context,
             blosc on global state, the museum's founding race.  The
             checker's rule was that a THREAD may not REACH one,
             which is unenforceable in practice: its BFS walks a
             per-unit call graph and cannot see a [SERIAL] two
             modules away, which is every realistic case.

             So the generator makes it true instead of checking it.
             One gate per FOR-C unit, because the state these
             procedures share is the LIBRARY's; a caller arriving
             while another thread is inside waits.  Uncontended the
             mutex costs about twenty nanoseconds against a foreign
             call costing microseconds.

             A GNU statement expression, because a call is an
             expression and the lock has to bracket it. *)
          gname := foreignProcs.es[pi].t ;
          ser := FALSE ;
          IF fp.kids[3] IS SOME att THEN
            IF DynStr.Eq (att.a, 'SERIAL') THEN ser := TRUE END
          END ;
          IF ser AND LEN (gname) > 0 THEN
            IF MFind (gateSeen, gname) < 0 THEN
              MAdd (gateSeen, gname, NONE, '') ;
              Line (KGate, 0, S3 ('static m9_mon m9_gate_', gname, ';'))
            END ;
            IF fp.kids[1] IS SOME frt THEN
              RETURN S6 ('({ m9_mon_enter (&m9_gate_', gname,
                '); __typeof__(', S4 (fp.b, ' (', args, ')'),
                S6 (') m9gv = ', fp.b, ' (', args, '); ', ''),
                S4 ('m9_mon_leave (&m9_gate_', gname, '); m9gv; })', ''))
            END ;
            RETURN S6 ('({ m9_mon_enter (&m9_gate_', gname, '); ',
              fp.b, S3 (' (', args, '); '),
              S4 ('m9_mon_leave (&m9_gate_', gname, '); })', ''))
          END ;
          RETURN S4 (fp.b, ' (', args, ')')
        END
      END
    END
    END
  END ;
  IF pnodeK IS SOME pn THEN
    IF pn.kids[1] IS SOME rt THEN tag := TagOfType (pn.kids[1]) END ;
    args := '' ;
    k2 := 0 ;
    IF pn.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME gids THEN
            FOR j := 0 TO gids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME aly THEN
                  ak := aly.kids[k2] ;
                  IF ak IS SOME arg THEN
                    IF LEN (args) > 0 THEN args := S2 (args, ', ') END ;
                    IF grp.f1 OR grp.f2 THEN
                      IF arg.kind = Ast.NDesignator AND arg.nkids = 0 AND
                         (DynStr.Eq (ScopeMode (arg.a), 'v') OR
                          DynStr.Eq (ScopeMode (arg.a), 'o')) THEN
                        args := S2 (args, CN (arg.a))
                             (* pass the pointer along *)
                      ELSIF arg.kind = Ast.NDesignator THEN
                        at := '?' ;
                        args := S4 (args, '&(', DES (arg, at), ')')
                      ELSE
                        Err2 (eln,
                          'VAR argument must be a designator')
                      END ;
                      (* rule 2: the object's pool rides behind it,
                         named from the root of the designator *)
                      IF grp.f1 AND arg.kind = Ast.NDesignator AND
                         PoolParamTy (grp.kids[1]) THEN
                        args := S3 (args, ', ', ObjPoolC (arg))
                      END
                    ELSE
                      want2 := TagOfType (grp.kids[1]) ;
                      (* ARRAY N OF T is the view of all N elements
                         where a SLICE OF T is expected (par 2.2) *)
                      IF DynStr.Eq (want2, 'SLICE') AND
                         arg.kind = Ast.NDesignator AND
                         DynStr.Eq (TagOfExpr (ak), 'ARR') THEN
                        IF Resolve (DesigDecl (arg)) IS SOME av THEN
                          IF av.kind = Ast.NArrayType THEN
                            e1 := TyC (grp.kids[1]) ;   (* order: TyC, *)
                            e2 := EX (ak, '') ;         (* then EX     *)
                            cnt := ArrCount2 (av.kids[0]) ;
                            args := S2 (args, S7 ('((', e1, '){ (', e2,
                              ').v, INT64_C(', cnt, ') })'))
                          ELSE
                            Err2 (eln, 'argument form unsupported yet')
                          END
                        ELSE
                          Err2 (eln, 'argument form unsupported yet')
                        END
                      ELSE
                        (* a raising argument is guarded before this
                           call runs (HoistArg) *)
                        svRaise := stRaise ;
                        stRaise := FALSE ;
                        e2 := EX (ak, want2) ;
                        IF stRaise THEN e2 := HoistArg (e2) END ;
                        stRaise := svRaise OR stRaise ;
                        args := S2 (args, e2)
                      END
                    END
                  END
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN Err2 (eln, 'call arity wrong') END ;
    IF LEN (args) > 0 THEN args := S2 (args, ', ') END ;
    stRaise := TRUE ;              (* every call gets a guard *)
    RETURN S4 (cfunc, ' (', args, 'err)')
  END ;
  Err2 (eln, S2 ('callee unsupported yet: ', name)) ;
  RETURN '0'
END CallC ;

PROCEDURE VariantCtor (vt: PTR Ast.Node ;
                       RO tn: STR ;
                       RO vn: STR ;
                       argl: Ast.Kid ; nargs: I64 ;
                       VAR tag: STR) : STR =
VAR
  vd : Ast.Kid ;
  args, res : STR ;
  g, j, k2, eln : I64 ;
BEGIN
  eln := vt.line ;
  IF argl IS SOME a9 THEN eln := a9.line END ;
  vd := NONE ;
  FOR g := 0 TO vt.nkids - 1 DO
    IF vt.kids[g] IS SOME v0 THEN
      IF DynStr.Eq (v0.a, vn) THEN vd := vt.kids[g] END
    END
  END ;
  IF vd IS SOME vdn THEN
    tag := S2 ('CR:', tn) ;
    args := '' ;
    k2 := 0 ;
    IF vdn.kids[0] IS SOME vfs THEN
      FOR g := 0 TO vfs.nkids - 1 DO
        IF vfs.kids[g] IS SOME vg THEN
          IF vg.kids[0] IS SOME vids THEN
            FOR j := 0 TO vids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME alv THEN
                  IF LEN (args) > 0 THEN args := S2 (args, ', ') END ;
                  args := S2 (args,
                    EX (alv.kids[k2], TagOfType (vg.kids[1])))
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN
      Err2 (eln, 'variant constructor arity wrong')
    END ;
    res := S5 ('((', CRPrefix (tn), '){ .tag = ',
      S3 (CRPrefix (tn), '_', vn), '') ;
    IF LEN (args) > 0 THEN
      res := S6 (res, ', .u.', vn, ' = { ', args, ' }')
    END ;
    RETURN S2 (res, ' })')
  END ;
  Err2 (eln, 'variant constructor form unsupported yet') ;
  RETURN '0'
END VariantCtor ;

(* ---- statements ---- *)

(* one EXCEPT arm: identity match, literal payload guards, binders
   copied out of the slots before the slot is cleared *)
PROCEDURE EmitHandler (h: PTR Ast.Node ; RO dlbl: STR ;
                       ind: I64) =
VAR
  nm, qual, desc, cond, slot, ety, bn, ec : STR ;
  fields : Ast.Kid ;
  savedScope, ii, di, si, k2, g, j, q, nbl : I64 ;
  blines : SLICE OF STR ;
  nb : SLICE OF STR ;
  hasPay : BOOL ;
BEGIN
  nm := '' ;
  qual := '' ;
  IF h.kids[0] IS SOME qn THEN
    nm := qn.a ;
    IF LEN (qn.b) > 0 THEN
      qual := qn.a ;
      nm := qn.b
    END
  END ;
  desc := ExcRef (qual, nm, fields) ;
  IF LEN (desc) = 0 THEN
    Err2 (h.line, S2 ('unknown exception in handler: ', nm)) ;
    RETURN
  END ;
  cond := S2 ('err->exc == &', desc) ;
  blines := NEW (gpool, STR, 8) ;
  nbl := 0 ;
  savedScope := scope.n ;
  k2 := 0 ; ii := 0 ; di := 0 ; si := 0 ;
  hasPay := FALSE ;
  IF h.kids[1] IS SOME pay0 THEN hasPay := TRUE END ;
  IF hasPay THEN
    IF fields IS SOME fs THEN
      FOR g := 0 TO fs.nkids - 1 DO
        IF fs.kids[g] IS SOME fg THEN
          IF fg.kids[0] IS SOME fids THEN
            FOR j := 0 TO fids.nkids - 1 DO
              ety := TagOfType (fg.kids[1]) ;
              slot := '' ;
              IF DynStr.Eq (ety, 'F64') OR DynStr.Eq (ety, 'F32') THEN
                slot := S3 ('err->d[', ItoA (di), ']') ;
                di := di + 1
              ELSIF DynStr.Eq (ety, 'SLICE') THEN
                si := si + 1
              ELSE
                slot := S3 ('err->i[', ItoA (ii), ']') ;
                ii := ii + 1
              END ;
              IF h.kids[1] IS SOME pay THEN
                IF k2 < pay.nkids THEN
                  IF pay.kids[k2] IS SOME arg THEN
                    IF arg.kind = Ast.NIdent THEN
                      bn := CN (arg.a) ;
                      IF nbl = LEN (blines) THEN
                        nb := NEW (gpool, STR, 2 * LEN (blines)) ;
                        FOR q := 0 TO nbl - 1 DO nb[q] := blines[q] END ;
                        blines := nb
                      END ;
                      IF DynStr.Eq (ety, 'SLICE') THEN
                        ec := '' ;
                        IF Resolve (fg.kids[1]) IS SOME sr THEN
                          ec := TyC (sr.kids[0])
                        END ;
                        (* a copy in this procedure's frame: the
                           in-flight one is overwritten by the next
                           raise (m9rt.h, m9_pay_take) *)
                        blines[nbl] := S9 (TyC (fg.kids[1]), ' ', bn,
                          ' = { (', ec, ' *) m9_pay_take (err, ',
                          ItoA (si - 1), ', sizeof (',
                          S9 (ec, ')), err->s[', ItoA (si - 1),
                          '].len }; (void) ', bn, ';', '', '', ''))
                      ELSE
                        blines[nbl] := S7 (TyC (fg.kids[1]), ' ', bn,
                          ' = ', slot, '; (void) ',
                          S2 (bn, ';'))
                      END ;
                      nbl := nbl + 1 ;
                      MAdd (bpool, arg.a, NONE, 'err->res') ;
                      MAdd (scope, arg.a, fg.kids[1], 'b')
                    ELSIF arg.kind = Ast.NInt THEN
                      cond := S5 (cond, ' && ', slot, ' == INT64_C(',
                        S2 (arg.a, ')'))
                    ELSE
                      Err2 (h.line,
                        'handler payload form unsupported yet')
                    END
                  END
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    ELSE
      Err2 (h.line, 'handler payload form unsupported yet')
    END
  END ;
  Line (KPbuf, ind, S3 ('if (', cond, ') {')) ;
  FOR j := 0 TO nbl - 1 DO
    Line (KPbuf, ind + 1, blines[j])
  END ;
  Line (KPbuf, ind + 1, 'err->exc = NULL;') ;
  EmitSeq (h.kids[2], ind + 1) ;
  Line (KPbuf, ind + 1, S2 ('goto ', S2 (dlbl, ';'))) ;
  Line (KPbuf, ind, '}') ;
  scope.n := savedScope
END EmitHandler ;

PROCEDURE EmitSeq (k: Ast.Kid ; ind: I64) =
VAR j : I64 ;
BEGIN
  IF k IS SOME s THEN
    FOR j := 0 TO s.nkids - 1 DO
      EmitStmt (s.kids[j], ind)
    END
  END
END EmitSeq ;

(* IS binding forms are legal only as the whole condition of an
   IF/ELSIF/WHILE (par 10), so absence gets its own predicate *)
PROCEDURE IsNone (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN RETURN FALSE END ;
  RETURN TRUE
END IsNone ;

PROCEDURE IsSomeCond (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME c THEN
    IF c.kind = Ast.NIs THEN
      IF c.kids[1] IS SOME rhs THEN
        RETURN rhs.kind = Ast.NIsSome
      END
    END
  END ;
  RETURN FALSE
END IsSomeCond ;

PROCEDURE EmitCaseCR (st: PTR Ast.Node ; RO w: STR ;
                      RO tg: STR ; ind: I64) ;
PROCEDURE EmitCaseScalar (st: PTR Ast.Node ; RO w: STR ;
                          ind: I64) ;
PROCEDURE EmitBlock (st: PTR Ast.Node ; ind: I64) ;
PROCEDURE EmitDispose (st: PTR Ast.Node ; ind: I64) ;
PROCEDURE EmitRaise (st: PTR Ast.Node ; ind: I64) ;

PROCEDURE EmitStmt (k: Ast.Kid ; ind: I64) =
VAR
  l, r, tg, w, cnd, stp, bname, thrPool : STR ;
  j, j2, savedScope, sv, sf, thrPi : I64 ;
  vtN, vd : Ast.Kid ;
  thrWants, lRaise, shared : BOOL ;
BEGIN
  IF k IS SOME st THEN
    DbgLine (st) ;
    CASE st.kind OF
    | Ast.NAssign :
        stRaise := FALSE ;
        hoistOk := TRUE ;
        hoistInd := ind ;
        tg := '?' ;
        IF st.kids[0] IS SOME lhs THEN l := DES (lhs, tg) ELSE l := '0' END ;
        lRaise := stRaise ;
        stRaise := FALSE ;
        r := EX (st.kids[1], tg) ;
        (* copying a SHARED handle refcounts it (par 4.2); SHARED(x)
           itself already set rc=1 and is not re-counted *)
        shared := DynStr.Eq (tg, 'SHARED') AND
                  DynStr.Eq (TagOfExpr (st.kids[1]), 'SHARED') ;
        IF stRaise THEN
          (* A CALL THAT RAISED ANSWERED NOTHING (report par 5,
             2026-10-03): the right side goes into a temporary, the
             error slot is read, and only then is the target written.
             Until then `b := Make (0)' stored Make's zero -- NULL
             into a pointer that is not OPT -- and went to the
             handler, which read the pointer a later line died on
             (ShareUse); a SHARED answer was share-copied before the
             test as well (ZarrStoreTest).  __typeof__ of the target
             evaluates nothing, so an indexed target is checked once,
             at the store. *)
          Line (KPbuf, ind, S5 ('{ __typeof__(', l, ') m9v = ', r, ';')) ;
          Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
          IF shared THEN
            r := S3 ('((__typeof__(', l, ')) m9_share_copy (m9v))')
          ELSE
            r := 'm9v'
          END ;
          Line (KPbuf, ind + 1, S4 (l, ' = ', r, ';')) ;
          IF lRaise THEN
            Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          Line (KPbuf, ind, '}') ;
          stRaise := FALSE
        ELSE
          IF shared THEN
            r := S5 ('((__typeof__(', r, ')) m9_share_copy (', r, '))')
          END ;
          Line (KPbuf, ind, S4 (l, ' = ', r, ';')) ;
          IF lRaise THEN
            Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END
        END ;
        CloseHoists (ind)
    | Ast.NCallStmt :
        stRaise := FALSE ;
        hoistOk := TRUE ;
        hoistInd := ind ;
        tg := '?' ;
        Line (KPbuf, ind, S2 (CallC (st.kids[0], st.kids[1], tg), ';')) ;
        IF stRaise THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        CloseHoists (ind)
    | Ast.NIf :
        (* IF x IS SOME p THEN: bind the payload, test for NULL *)
        IF IsSomeCond (st.kids[0]) THEN
          IF st.kids[0] IS SOME isn THEN
            vtN := OptInner (isn.kids[0]) ;
            IF vtN IS SOME vt0 THEN
              stRaise := FALSE ;
              cnd := EX (isn.kids[0], '') ;
              bname := '' ;
              IF isn.kids[1] IS SOME bn0 THEN bname := bn0.a END ;
              Line (KPbuf, ind, S6 ('{ ', TyC (vtN), ' ', CN (bname),
                ' = ', S2 (cnd, ';'))) ;
              IF stRaise THEN
                Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
              END ;
              savedScope := scope.n ;
              MAdd (bpool, bname, NONE, OriginPool (isn.kids[0])) ;
              MAdd (scope, bname, vtN, 'b') ;
              Line (KPbuf, ind, S3 ('if (', CN (bname), ' != NULL) {')) ;
              EmitSeq (st.kids[1], ind + 1) ;
              FOR j := 2 TO st.nkids - 1 DO
                IF st.kids[j] IS SOME tail THEN
                  IF tail.kind = Ast.NElsif THEN
                    Err2 (st.line, 'ELSIF after IS SOME unsupported yet')
                  ELSE
                    Line (KPbuf, ind, '} else {') ;
                    EmitSeq (tail.kids[0], ind + 1)
                  END
                END
              END ;
              Line (KPbuf, ind, '} }') ;
              scope.n := savedScope
            ELSE
              Err2 (st.line, 'IS SOME form unsupported yet')
            END
          END ;
          RETURN
        END ;
        stRaise := FALSE ;
        cnd := EX (st.kids[0], '') ;
        IF stRaise THEN
          w := NewTmp () ;
          Line (KPbuf, ind, S4 ('bool ', w, ' = ', S2 (cnd, ';'))) ;
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
          cnd := w
        END ;
        Line (KPbuf, ind, S3 ('if (', cnd, ') {')) ;
        EmitSeq (st.kids[1], ind + 1) ;
        (* ELSIF becomes a nested else-block so a raising condition
           can be hoisted with its guard before the test *)
        j2 := 0 ;
        FOR j := 2 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME tail THEN
            IF tail.kind = Ast.NElsif THEN
              Line (KPbuf, ind, '} else {') ;
              stRaise := FALSE ;
              cnd := EX (tail.kids[0], '') ;
              IF stRaise THEN
                w := NewTmp () ;
                Line (KPbuf, ind + 1, S4 ('bool ', w, ' = ',
                  S2 (cnd, ';'))) ;
                Line (KPbuf, ind + 1,
                  S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
                cnd := w
              END ;
              Line (KPbuf, ind + 1, S3 ('if (', cnd, ') {')) ;
              EmitSeq (tail.kids[1], ind + 2) ;
              j2 := j2 + 1
            ELSE
              Line (KPbuf, ind, '} else {') ;
              EmitSeq (tail.kids[0], ind + 1)
            END
          END
        END ;
        cnd := '}' ;
        FOR j := 1 TO j2 DO cnd := S2 (cnd, ' }') END ;
        Line (KPbuf, ind, cnd)
    | Ast.NWhile :
        (* WHILE x IS SOME p DO: rebind per iteration *)
        IF IsSomeCond (st.kids[0]) THEN
          IF st.kids[0] IS SOME isn THEN
            vtN := OptInner (isn.kids[0]) ;
            IF vtN IS SOME vt1 THEN
              bname := '' ;
              IF isn.kids[1] IS SOME bn1 THEN bname := bn1.a END ;
              Line (KPbuf, ind, 'for (;;) {') ;
              stRaise := FALSE ;
              cnd := EX (isn.kids[0], '') ;
              Line (KPbuf, ind + 1, S5 (TyC (vtN), ' ', CN (bname),
                ' = ', S2 (cnd, ';'))) ;
              IF stRaise THEN
                Line (KPbuf, ind + 1,
                  S3 ('if (err->exc) goto ', raiseLbl, ';'))
              END ;
              Line (KPbuf, ind + 1,
                S3 ('if (!(', CN (bname), ' != NULL)) break;')) ;
              savedScope := scope.n ;
              MAdd (bpool, bname, NONE, OriginPool (isn.kids[0])) ;
              MAdd (scope, bname, vtN, 'b') ;
              sv := inSwitch ; inSwitch := 0 ;
              sf := finDepth ; finDepth := 0 ;
              EmitSeq (st.kids[1], ind + 1) ;
              inSwitch := sv ; finDepth := sf ;
              scope.n := savedScope ;
              Line (KPbuf, ind, '}')
            ELSE
              Err2 (st.line, 'IS SOME form unsupported yet')
            END
          END ;
          RETURN
        END ;
        Line (KPbuf, ind, 'for (;;) {') ;
        stRaise := FALSE ;
        cnd := EX (st.kids[0], '') ;
        IF stRaise THEN
          w := NewTmp () ;
          Line (KPbuf, ind + 1, S4 ('bool ', w, ' = ', S2 (cnd, ';'))) ;
          Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
          cnd := w
        END ;
        Line (KPbuf, ind + 1, S3 ('if (!(', cnd, ')) break;')) ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        EmitSeq (st.kids[1], ind + 1) ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '}')
    | Ast.NFor :
        stRaise := FALSE ;
        (* FOR over an enumeration walks its tags: the variable is a
           struct, so the loop runs on `.tag' -- c.tag = lo.tag;
           c.tag <= hi.tag; c.tag++ (docs/enum-plan.md, part 2) *)
        IF StartsW (TagOfExpr (st.kids[0]), 'CR:') THEN
          w := NewTmp () ;
          Line (KPbuf, ind, S3 ('{ int32_t ', w, 'to;')) ;
          Line (KPbuf, ind, S5 (CN (st.a), '.tag = (', EX (st.kids[0], ''),
            ').tag;', '')) ;
          Line (KPbuf, ind, S5 (w, 'to = (', EX (st.kids[1], ''),
            ').tag;', '')) ;
          Line (KPbuf, ind, S9 ('for (; ', CN (st.a), '.tag <= ', w,
            'to; ', CN (st.a), '.tag++', ') {', '')) ;
          sv := inSwitch ; inSwitch := 0 ;
          sf := finDepth ; finDepth := 0 ;
          EmitSeq (st.kids[3], ind + 1) ;
          inSwitch := sv ; finDepth := sf ;
          Line (KPbuf, ind, '} }') ;
          RETURN
        END ;
        l := EX (st.kids[0], '') ;
        w := NewTmp () ;
        Line (KPbuf, ind, S3 ('{ int64_t ', w, 'to;')) ;
        Line (KPbuf, ind, S4 (CN (st.a), ' = ', l, ';')) ;
        r := EX (st.kids[1], '') ;
        Line (KPbuf, ind, S4 (w, 'to = ', r, ';')) ;
        IF stRaise THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        stp := '1' ;
        IF st.kids[2] IS SOME by THEN
          IF by.kind = Ast.NInt THEN
            stp := by.a
          ELSIF by.kind = Ast.NUn AND DynStr.Eq (by.a, '-') THEN
            IF by.kids[0] IS SOME bl THEN
              IF bl.kind = Ast.NInt THEN stp := S2 ('-', bl.a)
              ELSE Err2 (st.line, 'FOR BY step form unsupported yet') END
            END
          ELSE
            Err2 (st.line, 'FOR BY step form unsupported yet')
          END
        END ;
        IF stp[0] = '-' THEN
          Line (KPbuf, ind, S7 ('for (; ', CN (st.a), ' >= ', w,
            'to; ', CN (st.a), S3 (' += ', stp, ') {')))
        ELSE
          Line (KPbuf, ind, S7 ('for (; ', CN (st.a), ' <= ', w,
            'to; ', CN (st.a), S3 (' += ', stp, ') {')))
        END ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        EmitSeq (st.kids[3], ind + 1) ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '} }')
    | Ast.NLoop :
        Line (KPbuf, ind, 'for (;;) {') ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        EmitSeq (st.kids[0], ind + 1) ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '}')
    | Ast.NExit :
        IF inSwitch > 0 THEN
          Err2 (st.line,
            'EXIT inside a CASE arm refused (it would break the switch)')
        END ;
        IF finDepth > 0 THEN
          Err2 (st.line,
            'EXIT across FINALLY refused (it would skip the cleanup)')
        END ;
        Line (KPbuf, ind, 'break;')
    | Ast.NBlock : EmitBlock (st, ind)
    | Ast.NCase :
        stRaise := FALSE ;
        cnd := EX (st.kids[0], '') ;
        tg := TagOfExpr (st.kids[0]) ;
        w := NewTmp () ;
        Line (KPbuf, ind, S6 ('{ __typeof__(', cnd, ') ', w, ' = ',
          S2 (cnd, ';'))) ;
        IF stRaise THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        IF StartsW (tg, 'CR:') THEN
          EmitCaseCR (st, w, tg, ind)
        ELSIF DynStr.Eq (tg, 'CHAR') OR DynStr.Eq (tg, 'I64') THEN
          EmitCaseScalar (st, w, ind)
        ELSE
          Err2 (st.line, 'CASE over this selector unsupported yet')
        END
    (* ---- par 6: the monitor statements ----

       WAIT and SIGNAL name the MONITOR, not a field of it: there is
       one condition variable per monitor, so the monitor is the
       condition.  A WAIT is written as a loop around its predicate,
       which is why SIGNAL broadcasts -- see m9rt.h. *)
    | Ast.NWait, Ast.NSignal :
        stRaise := FALSE ;
        tg := '?' ;
        l := '0' ;
        vtN := NONE ;
        IF st.kids[0] IS SOME mz THEN
          l := DES (mz, tg) ;
          vtN := Resolve (DesigDecl (mz))
        END ;
        IF vtN IS SOME mn THEN
          IF mn.kind # Ast.NMonitorType THEN
            Err2 (st.line, 'WAIT/SIGNAL needs a monitor designator')
          ELSIF st.kind = Ast.NWait THEN
            Line (KPbuf, ind, S3 ('m9_mon_wait (&(', l, ').m9mon);'))
          ELSE
            Line (KPbuf, ind, S3 ('m9_mon_signal (&(', l, ').m9mon);'))
          END
        ELSE
          Err2 (st.line, 'WAIT/SIGNAL needs a monitor designator')
        END

    (* THREAD (P, arg).  ONE TRAMPOLINE PER PROCEDURE, not per site.
       par 6's SHARABLE argument is a MONITOR or an owned value moved
       in; a MONITOR is shared BY REFERENCE and M9 gives no way to
       take its address outside UNSAFE, so the generator passes it.
       The trampoline carries its own error slot, because a thread
       has no caller to check one. *)
    | Ast.NThread :
        stRaise := TRUE ;
        tg := '?' ;
        IF st.kids[0] IS SOME pn THEN
          IF pn.kind # Ast.NDesignator THEN
            Err2 (st.line, 'THREAD target form unsupported yet')
          ELSE
            bname := pn.a ;
            l := '0' ;
            vd := NONE ;
            vtN := NONE ;
            thrPool := 'NULL' ;
            IF st.kids[1] IS SOME az THEN
              l := DES (az, tg) ;
              vd := DesigDecl (az) ;
              vtN := Resolve (vd) ;
              (* rule 2: the pool the argument lives in crosses with
                 it, since the target's first parameter carries one *)
              thrPool := ObjPoolC (az)
            END ;
            IF vtN IS SOME an THEN
              IF an.kind = Ast.NMonitorType THEN
                l := S3 ('&(', l, ')') ;
                w := S2 (TyC (vd), ' *')
              ELSE
                w := TyC (vd)
              END ;
              (* pointer-shaped means TyC ended with a star; one
                 character beats importing Text for it *)
              IF an.kind # Ast.NMonitorType AND
                 NOT (LEN (w) > 0 AND w[LEN (w) - 1] = '*') THEN
                Err2 (st.line,
                  'THREAD argument must be pointer-shaped or a monitor')
              ELSE
                IF MFind (thrSeen, bname) < 0 THEN
                  MAdd (thrSeen, bname, NONE, '') ;
                  thrWants := FALSE ;
                  thrPi := FindProcN (bname) ;
                  IF thrPi >= 0 THEN
                    IF gps[thrPi].node IS SOME tdn THEN
                      IF tdn.kids[0] IS SOME tpl THEN
                        IF tpl.nkids > 0 THEN
                          IF tpl.kids[0] IS SOME tg0 THEN
                            thrWants := tg0.f1 AND PoolParamTy (tg0.kids[1])
                          END
                        END
                      END
                    END
                  END ;
                  Line (KThr, 0, S4 ('static void *m9_thr_', modName,
                    '_', S2 (bname, ' (void *p, m9_pool *pool)'))) ;
                  Line (KThr, 0, '{') ;
                  Line (KThr, 0, '  m9_state e = { 0 };') ;
                  IF thrWants THEN
                    Line (KThr, 0, S6 ('  ', CP (modName), '_', bname, ' ((',
                      S3 (w, ') p, pool, &e);', '')))
                  ELSE
                    Line (KThr, 0, '  (void) pool;') ;
                    Line (KThr, 0, S6 ('  ', CP (modName), '_', bname, ' ((',
                      S3 (w, ') p, &e);', '')))
                  END ;
                  Line (KThr, 0,
                    '  if (e.exc) m9_thread_died (e.exc->name);') ;
                  Line (KThr, 0, '  return NULL;') ;
                  Line (KThr, 0, '}') ;
                  Line (KThr, 0, '')
                END ;
                Line (KPbuf, ind, S6 ('m9_thread_start2 (m9_thr_',
                  CP (modName), '_', bname, ', (void *) ',
                  S5 (l, ', ', thrPool, ', err);', ''))) ;
                Line (KPbuf, ind,
                  S3 ('if (err->exc) goto ', raiseLbl, ';'))
              END
            ELSE
              Err2 (st.line, 'THREAD form unsupported yet')
            END
          END
        ELSE
          Err2 (st.line, 'THREAD form unsupported yet')
        END

    | Ast.NDispose : EmitDispose (st, ind)
    | Ast.NRaiseStmt : EmitRaise (st, ind)
    | Ast.NReturn :
        IF st.kids[0] IS SOME rv THEN
          stRaise := FALSE ;
          (* the answer outlives this frame, so it is built in the
             caller's arena.  Intermediates within the expression land
             there too -- generous, and the price of not tracking tail
             position through EX. *)
          Line (KPbuf, ind, 'err->res = m9res;') ;
          hoistOk := TRUE ;
          hoistInd := ind ;
          r := EX (st.kids[0], curRetTag) ;
          Line (KPbuf, ind, S3 ('m9ret = ', r, ';')) ;
          IF stRaise THEN
            Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          CloseHoists (ind)
        END ;
        IF LEN (curRetq) > 0 THEN
          Line (KPbuf, ind, S2 (curRetq, ' = true;'))
        END ;
        Line (KPbuf, ind, S3 ('goto ', exitLbl, ';'))
    ELSE
      Err2 (st.line, 'statement kind unsupported yet')
    END
  END
END EmitStmt ;

PROCEDURE EmitBlock (st: PTR Ast.Node ; ind: I64) =
VAR
  w, l, cnd, tg, savedExit, savedRq : STR ;
  j : I64 ;
  fin : Ast.Kid ;
  hasHdl : BOOL ;
BEGIN
  hasHdl := FALSE ;                     (* any handler? *)
  fin := NONE ;                         (* the FINALLY node *)
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME part THEN
      IF part.kind = Ast.NHandler THEN hasHdl := TRUE
      ELSIF part.kind = Ast.NFinally THEN fin := st.kids[j] END
    END
  END ;
  IF hasHdl THEN
    IF fin IS SOME f0 THEN
      Err2 (st.line,
        'EXCEPT and FINALLY on one block unsupported yet') ;
      RETURN
    END ;
    (* handlers: raises inside the sequence jump to the dispatch;
       RETURNs bypass it (returns are not exceptions) *)
    w := S2 ('L_hdl_', NewTmp ()) ;
    cnd := S2 ('L_dn_', NewTmp ()) ;
    tg := raiseLbl ;
    raiseLbl := w ;
    EmitSeq (st.kids[0], ind) ;
    raiseLbl := tg ;
    Line (KPbuf, ind, S3 ('goto ', cnd, ';')) ;
    Line (KPbuf, 0, S2 (w, ': ;')) ;
    FOR j := 1 TO st.nkids - 1 DO
      IF st.kids[j] IS SOME part THEN
        IF part.kind = Ast.NHandler THEN EmitHandler (part, cnd, ind) END
      END
    END ;
    Line (KPbuf, ind, S3 ('goto ', raiseLbl, ';')) ;
    Line (KPbuf, 0, S2 (cnd, ': ;')) ;
    RETURN
  END ;
  IF fin IS SOME fnode THEN
    (* FINALLY as a goto cleanup chain (par 11): raises and RETURNs
       inside the block land on the label; the cleanup runs; then
       whatever was pending continues outward *)
    w := NewTmp () ;
    l := S2 ('L_fin_', NewTmp ()) ;
    Line (KPbuf, ind, S5 ('bool ', w, ' = false; (void) ', w, ';')) ;
    savedExit := exitLbl ; savedRq := curRetq ; tg := raiseLbl ;
    exitLbl := l ; raiseLbl := l ; curRetq := w ;
    finDepth := finDepth + 1 ;
    EmitSeq (st.kids[0], ind) ;
    finDepth := finDepth - 1 ;
    Line (KPbuf, 0, S2 (l, ': ;')) ;
    exitLbl := savedExit ; raiseLbl := tg ; curRetq := savedRq ;
    EmitSeq (fnode.kids[0], ind) ;
    IF LEN (curRetq) > 0 THEN
      Line (KPbuf, ind, S7 ('if (', w, ') { ', curRetq, ' = true; goto ',
        exitLbl, '; }'))
    ELSE
      Line (KPbuf, ind, S5 ('if (', w, ') goto ', exitLbl, ';'))
    END ;
    Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
    RETURN
  END ;
  EmitSeq (st.kids[0], ind)
END EmitBlock ;

PROCEDURE EmitCaseCR (st: PTR Ast.Node ; RO w: STR ;
                      RO tg: STR ; ind: I64) =
VAR
  l, tn, bname, fldn : STR ;
  j, i2, j2, k2, g2, jj, savedScope : I64 ;
  vtN, vd : Ast.Kid ;
  hadElse, opened : BOOL ;
BEGIN
  tn := SLICE (tg, 3, LEN (tg) - 3) ;
  l := S2 (CRPrefix (tn), '_') ;
  vtN := CRNode (tn) ;
  hadElse := FALSE ;
  Line (KPbuf, ind, S3 ('switch (', w, '.tag) {')) ;
  inSwitch := inSwitch + 1 ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        savedScope := scope.n ;
        opened := FALSE ;
        IF arm.kids[0] IS SOME lbls THEN
          FOR i2 := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[i2] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN
                Line (KPbuf, ind, S4 ('case ', l, lbl.a, ': {')) ;
                opened := TRUE ;
                (* positional binders copy the payload fields *)
                vd := NONE ;
                IF vtN IS SOME vtn2 THEN
                  FOR j2 := 0 TO vtn2.nkids - 1 DO
                    IF vtn2.kids[j2] IS SOME v0 THEN
                      IF DynStr.Eq (v0.a, lbl.a) THEN vd := vtn2.kids[j2] END
                    END
                  END
                END ;
                IF vd IS SOME vdn THEN
                  k2 := 0 ;
                  IF vdn.kids[0] IS SOME vfs THEN
                    FOR g2 := 0 TO vfs.nkids - 1 DO
                      IF vfs.kids[g2] IS SOME vg THEN
                        IF vg.kids[0] IS SOME vids THEN
                          FOR jj := 0 TO vids.nkids - 1 DO
                            IF lbl.kids[0] IS SOME bl THEN
                              IF k2 < bl.nkids THEN
                                IF bl.kids[k2] IS SOME bid THEN
                                  IF vids.kids[jj] IS SOME fid THEN
                                    bname := CN (bid.a) ;
                                    fldn := CN (fid.a) ;
                                    Line (KPbuf, ind + 1,
                                      S9 (TyC (vg.kids[1]), ' ', bname,
                                        ' = ', w, '.u.', lbl.a, '.',
                                        S5 (fldn, '; (void) ', bname,
                                            ';', ''))) ;
                                    MAdd (bpool, bid.a, NONE,
                                          OriginPool (st.kids[0])) ;
                                    MAdd (scope, bid.a, vg.kids[1], 'b')
                                  END
                                END
                              END
                            END ;
                            k2 := k2 + 1
                          END
                        END
                      END
                    END
                  END
                ELSE
                  Err2 (st.line, 'CASE label form unsupported yet')
                END
              ELSIF lbl.kind = Ast.NLabelRange THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF lv.kind = Ast.NDesignator AND lv.nkids = 0 AND
                     IsNone (lbl.kids[1]) THEN
                    Line (KPbuf, ind, S4 ('case ', l, lv.a, ':'))
                  ELSE
                    Err2 (st.line, 'CASE label form unsupported yet')
                  END
                END
              ELSE
                Err2 (st.line, 'CASE label form unsupported yet')
              END
            END
          END
        END ;
        IF NOT opened THEN Line (KPbuf, ind, '{') END ;
        EmitSeq (arm.kids[1], ind + 1) ;
        Line (KPbuf, ind, '} break;') ;
        scope.n := savedScope
      ELSE
        hadElse := TRUE ;
        Line (KPbuf, ind, 'default: {') ;
        EmitSeq (arm.kids[0], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      END
    END
  END ;
  IF NOT hadElse THEN
    Line (KPbuf, ind, 'default: m9_trap_tag ();')
  END ;
  inSwitch := inSwitch - 1 ;
  Line (KPbuf, ind, '} }')
END EmitCaseCR ;

PROCEDURE EmitCaseScalar (st: PTR Ast.Node ; RO w: STR ;
                          ind: I64) =
VAR
  r : STR ;
  j, i2 : I64 ;
  hadElse, single : BOOL ;
BEGIN
  hadElse := FALSE ;
  Line (KPbuf, ind, S3 ('switch (', w, ') {')) ;
  inSwitch := inSwitch + 1 ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR i2 := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[i2] IS SOME lbl THEN
              r := '' ;
              single := FALSE ;
              IF lbl.kind = Ast.NLabelRange THEN
                single := IsNone (lbl.kids[1])
              END ;
              IF single THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF lv.kind = Ast.NString AND LEN (lv.a) = 1 THEN
                    r := S2 (ItoA (ORD (lv.a[0])), 'u')
                  ELSIF lv.kind = Ast.NChar THEN
                    r := S2 (ItoA (CharVal (lv.a)), 'u')
                  ELSIF lv.kind = Ast.NInt THEN
                    r := S3 ('INT64_C(', lv.a, ')')
                  ELSIF lv.kind = Ast.NDesignator THEN
                    r := ConstLbl (lv)
                  END
                END
              END ;
              IF LEN (r) = 0 THEN
                Err2 (st.line, 'CASE label form unsupported yet')
              ELSE
                Line (KPbuf, ind, S3 ('case ', r, ':'))
              END
            END
          END
        END ;
        Line (KPbuf, ind, '{') ;
        EmitSeq (arm.kids[1], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      ELSE
        hadElse := TRUE ;
        Line (KPbuf, ind, 'default: {') ;
        EmitSeq (arm.kids[0], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      END
    END
  END ;
  IF NOT hadElse THEN
    Err2 (st.line,
      'scalar CASE without ELSE refused (unmatched-label semantics undecided)')
  END ;
  inSwitch := inSwitch - 1 ;
  Line (KPbuf, ind, '} }')
END EmitCaseScalar ;

PROCEDURE EmitDispose (st: PTR Ast.Node ; ind: I64) =
VAR
  l, tg : STR ;
  j, i2 : I64 ;
  vtN, vd, ft : Ast.Kid ;
  opened : BOOL ;
BEGIN
  stRaise := FALSE ;
  tg := '?' ;
  l := '0' ;
  IF st.kids[0] IS SOME dz THEN l := DES (dz, tg) END ;
  (* interior pools die with their record (par 4.3) and interior
     SHARED handles are released -- but only when THIS is the last
     handle: a shared object's interior outlives any one Close
     (found by the bench driver closing the store first)             *)
  opened := FALSE ;
  vtN := NONE ;
  IF st.kids[0] IS SOME dz2 THEN vtN := Resolve (DesigDecl (dz2)) END ;
  IF vtN IS SOME pt THEN
    IF IsPtrK (pt.kind) THEN
      IF Resolve (pt.kids[0]) IS SOME rec THEN
        IF rec.kind = Ast.NRecordType THEN
          IF rec.kids[1] IS SOME fs THEN
            FOR j := 0 TO fs.nkids - 1 DO
              IF fs.kids[j] IS SOME fg THEN
                ft := Resolve (fg.kids[1]) ;
                IF ft IS SOME ftn THEN
                  IF (ftn.kind = Ast.NQualident AND
                      DynStr.Eq (ftn.a, 'POOL')) OR
                     ftn.kind = Ast.NSharedType THEN
                    IF NOT opened THEN
                      Line (KPbuf, ind,
                        S3 ('if (m9_rc_last (', l, ')) {')) ;
                      opened := TRUE
                    END ;
                    IF fg.kids[0] IS SOME fids THEN
                      FOR i2 := 0 TO fids.nkids - 1 DO
                        IF fids.kids[i2] IS SOME fid THEN
                          IF ftn.kind = Ast.NSharedType THEN
                            Line (KPbuf, ind + 1, S5 ('m9_dispose (', l,
                              '->', CN (fid.a), ');'))
                          ELSE
                            Line (KPbuf, ind + 1, S5 ('m9_pool_free (&',
                              l, '->', CN (fid.a), ');'))
                          END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  IF opened THEN Line (KPbuf, ind, '}') END ;
  Line (KPbuf, ind, S3 ('m9_dispose (', l, ');')) ;
  IF stRaise THEN
    Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
  END
END EmitDispose ;

PROCEDURE EmitRaise (st: PTR Ast.Node ; ind: I64) =
VAR
  l, l2, r, tg, cnd, w : STR ;
  j, i2, j2, k2 : I64 ;
  fields : Ast.Kid ;
BEGIN
  stRaise := FALSE ;
  l := '' ;
  l2 := '' ;
  IF st.kids[0] IS SOME xn THEN
    l := xn.a ;
    IF LEN (xn.b) > 0 THEN
      l2 := xn.a ;
      l := xn.b
    END
  END ;
  r := ExcRef (l2, l, fields) ;
  IF LEN (r) = 0 THEN
    Err2 (st.line, S2 ('RAISE of unknown exception: ', l)) ;
    RETURN
  END ;
  r := S2 ('&', r) ;
  (* payload: I64-class into i[], F64 into d[], slices into s[] *)
  IF st.kids[1] IS SOME pay THEN
    i2 := 0 ; j2 := 0 ; k2 := 0 ;
    FOR j := 0 TO pay.nkids - 1 DO
      tg := TagOfExpr (pay.kids[j]) ;
      cnd := EX (pay.kids[j], '') ;
      IF DynStr.Eq (tg, 'F64') OR DynStr.Eq (tg, 'F32') THEN
        (* THE SLOTS ARE FINITE AND OVERFLOWING THEM IS SILENT.
           m9_state carries i[4], d[2], s[2]; before this check a
           seventh integer or a third real simply wrote past the end
           of the struct, and the generated C compiled.  Found by
           declaring an exception with six F64 fields and reading the
           emitted code. *)
        IF j2 >= 2 THEN
          Err2 (st.line,
            'exception payload: more than 2 real fields') ;
          RETURN
        END ;
        Line (KPbuf, ind, S5 ('err->d[', ItoA (j2), '] = ', cnd, ';')) ;
        j2 := j2 + 1
      ELSIF DynStr.Eq (tg, 'SLICE') THEN
        IF k2 >= 3 THEN
          Err2 (st.line,
            'exception payload: more than 3 slice fields') ;
          RETURN
        END ;
        w := NewTmp () ;
        (* m9_pay_keep copies the octets out of the frame that built
           them, which the raise is about to leave (m9rt.h) *)
        Line (KPbuf, ind, S9 ('{ __typeof__(', cnd, ') ', w, ' = ', cnd,
          '; err->s[', ItoA (k2), S9 ('].p = ', w, '.p; err->s[',
          ItoA (k2), '].len = ', w, '.len; m9_pay_keep (err, ',
          ItoA (k2), S3 (', sizeof (*', w, '.p)); }')))) ;
        k2 := k2 + 1
      ELSE
        IF i2 >= 4 THEN
          Err2 (st.line,
            'exception payload: more than 4 integer fields') ;
          RETURN
        END ;
        Line (KPbuf, ind, S5 ('err->i[', ItoA (i2), '] = ', cnd, ';')) ;
        i2 := i2 + 1
      END
    END
  END ;
  Line (KPbuf, ind, S3 ('m9_raise (err, ', r, ');')) ;
  Line (KPbuf, ind, S3 ('goto ', raiseLbl, ';'))
END EmitRaise ;

(* ---- procedures ---- *)

PROCEDURE ZeroInit (RO cty: STR) : STR =
BEGIN
  IF Has (cty, '*') THEN RETURN ' = NULL' END ;
  IF DynStr.Eq (cty, 'double') OR DynStr.Eq (cty, 'float') THEN
    RETURN ' = 0'
  END ;
  IF DynStr.Eq (cty, 'bool') THEN RETURN ' = false' END ;
  IF HasSub (cty, '_t') THEN RETURN ' = 0' END ;
  RETURN ' = {0}'
END ZeroInit ;

(* the C typedef of a procedure type -- `typedef R ( * Mod_Name) (T1,
   T2 *, m9_state *err);` with the star written apart here because
   the two characters together open a comment -- a value parameter is
   its C type, VAR and OWN are a pointer to it, exactly GenProc's rule
   for a heading, so a procedure of the same head IS a value of the
   type in C *)
PROCEDURE ProcTypedefC (RO name: STR ; ptn: PTR Ast.Node) : STR =
VAR
  retC, ps, cty : STR ;
  g, j : I64 ;
BEGIN
  retC := 'void' ;
  IF ptn.kids[1] IS SOME rt THEN retC := TyC (ptn.kids[1]) END ;
  ps := '' ;
  IF ptn.kids[0] IS SOME pl THEN
    FOR g := 0 TO pl.nkids - 1 DO
      IF pl.kids[g] IS SOME grp THEN
        cty := TyC (grp.kids[1]) ;
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF grp.f1 AND PoolParamTy (grp.kids[1]) THEN
              ps := S3 (ps, cty, ' *, m9_pool *, ')   (* rule 2 *)
            ELSIF grp.f1 OR grp.f2 THEN
              ps := S3 (ps, cty, ' *, ')
            ELSE
              ps := S3 (ps, cty, ', ')
            END
          END
        END
      END
    END
  END ;
  RETURN S7 ('typedef ', retC, ' (*', CP (modName), '_', name,
             S3 (') (', ps, 'm9_state *err);'))
END ProcTypedefC ;

PROCEDURE GenProc (gi: I64) =
VAR
  pl, grp, body, ids : Ast.Kid ;
  g, j, i, k : I64 ;
  ci2, cj2 : I64 ;             (* the procedure's own CONSTs *)
  sig, retC, mode, cty, init, nm, dst : STR ;
  monPar : STR ;   (* the monitor this proc is bound to *)
  nb : SLICE OF STR ;
  rk : Ast.Kid ;
  hasBody : BOOL ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  IF gps[gi].node IS SOME d THEN
    IF d.kids[1] IS SOME rt THEN
      retC := TyC (d.kids[1]) ;
      curRetTag := TagOfType (d.kids[1])
    ELSE
      retC := 'void' ;
      curRetTag := ''
    END ;
    sig := S6 (retC, ' ', CP (modName), '_', gps[gi].name, ' (') ;
    monPar := '' ;
    pl := d.kids[0] ;
    IF pl IS SOME pln THEN
      FOR g := 0 TO pln.nkids - 1 DO
        IF pln.kids[g] IS SOME grpn THEN
          IF grpn.f1 THEN mode := 'v'
          ELSIF grpn.f2 THEN mode := 'o'
          ELSE mode := 'p' END ;
          cty := TyC (grpn.kids[1]) ;
          IF grpn.kids[0] IS SOME pids THEN
            FOR j := 0 TO pids.nkids - 1 DO
              IF pids.kids[j] IS SOME pid THEN
                (* A BOUND PROCEDURE IS ONE WHOSE FIRST PARAMETER
                   IS THE MONITOR TYPE -- M9 has no method syntax, so
                   the parameter is the binding
                   (docs/concurrency.md).  Its body is wrapped in
                   enter/leave, which is how par 6's "all access to
                   the record's fields is implicitly serialized"
                   becomes a property of the emitted code. *)
                IF g = 0 AND j = 0 THEN
                  IF Resolve (grpn.kids[1]) IS SOME mtn THEN
                    IF mtn.kind = Ast.NMonitorType THEN
                      IF DynStr.Eq (mode, 'p') THEN
                        Err2 (grpn.line,
                          'a monitor receiver must be VAR')
                      ELSE
                        monPar := CN (pid.a)
                      END
                    END
                  END
                END ;
                MAdd (scope, pid.a, grpn.kids[1], mode) ;
                IF DynStr.Eq (mode, 'p') THEN
                  sig := S5 (sig, cty, ' ', CN (pid.a), ', ')
                ELSE
                  sig := S5 (sig, cty, ' *', CN (pid.a), ', ') ;
                  (* rule 2 of docs/pool-elision-plan.md: a VAR
                     parameter of a pointer-bearing type carries the
                     pool its object lives in, right behind it, and
                     its target is adopted into THAT pool at exit
                     rather than into the caller's arena *)
                  IF DynStr.Eq (mode, 'v') AND PoolParamTy (grpn.kids[1]) THEN
                    sig := S4 (sig, 'm9_pool *', CN (pid.a), '_pool, ') ;
                    dst := S2 (CN (pid.a), '_pool')
                  ELSE
                    dst := 'm9res'
                  END ;
                  IF DynStr.Eq (cty, 'm9_sl_CHAR') THEN
                    OutReg (CN (pid.a))
                  ELSIF HasPtr (grpn.kids[1], 0) THEN
                    AdoptReg (CN (pid.a), grpn.kids[1], dst)
                  END
                END
              END
            END
          END
        END
      END
    END ;
    sig := S2 (sig, 'm9_state *err)') ;

    IF gps[gi].exported THEN
      Line (KHdrProtos, 0, S2 (sig, ';'))
    ELSE
      sig := S2 ('static ', sig) ;
      Line (KSprotos, 0, S2 (sig, ';'))
    END ;

    hasBody := FALSE ;
    IF gps[gi].body IS SOME b0 THEN hasBody := TRUE END ;
    IF NOT hasBody THEN RETURN END ;

    Line (KPbuf, 0, '') ;
    Line (KPbuf, 0, sig) ;
    Line (KPbuf, 0, '{') ;
    (* THE FRAME ARENA.  Empty costs nothing -- m9_pool is one NULL
       pointer and the first block is created lazily -- so a procedure
       that never concatenates pays for a zeroed word.  Registered like
       any local POOL, which frees it on EVERY exit: par 11 routes
       return, raise and FINALLY through L_ret alike.

       And the result slot: err->res is the CALLER's arena when we are
       entered, so it is captured before our own calls overwrite it,
       and then claimed for them -- a callee's answer lands in OUR
       frame.  Each procedure restores it at L_ret, which is why a
       caller sets it once rather than around every call.  NULL means a
       caller that does not play (a hand-written C driver) and HEAP is
       the fallback, which is what `+` did before this. *)
    Line (KPbuf, 1, 'm9_pool m9frame = {0};') ;
    PoolReg ('m9frame') ;
    Line (KPbuf, 1,
      'm9_pool *m9res = err->res ? err->res : &m9_heap;') ;
    Line (KPbuf, 1, '(void) m9res;') ;
    (* A FUNCTION WHOSE ANSWER CARRIES A POINTER BUILDS IN ITS
       CALLER'S ARENA from the first statement, not only in its
       RETURN expression (rule 1 of docs/pool-elision-plan.md): what
       it allocates is on its way out, and adoption at the exit would
       carry the same bytes up in the frame's own 64 KB blocks, one
       block per level of a recursive builder.  So the slot is left
       as the caller's, the frame stays empty, and the exit's adoption
       test finds nothing to move.  A function answering a scalar or
       a string, and a proper procedure, claim the slot as before:
       their temporaries die here, and a string answer is re-homed. *)
    IF d.kids[1] IS SOME rtn0 THEN
      IF NOT DynStr.Eq (retC, 'm9_sl_CHAR') AND HasPtr (d.kids[1], 0) THEN
        Line (KPbuf, 1, 'err->res = m9res;')
      ELSE
        Line (KPbuf, 1, 'err->res = &m9frame;')
      END
    ELSE
      Line (KPbuf, 1, 'err->res = &m9frame;')
    END ;
    IF LEN (dbgSrc) > 0 THEN
      Line (KPbuf, 1, S3 ('err->file = "', dbgSrc, '";'))
    END ;
    (* PROCEDURE-LOCAL CONSTs.  The grammar always allowed them and
       neither end implemented them: this said `unknown name` and the
       checker said nothing at all.  They register in the same map the
       module's own use, and the map is truncated when the procedure
       ends -- a shadow is refused by the checker, so appending is
       safe even though MFind answers the FIRST hit. *)
    constsBase := consts.n ;
    IF gps[gi].body IS SOME cbd THEN
      FOR ci2 := 0 TO cbd.nkids - 1 DO
        IF cbd.kids[ci2] IS SOME csec THEN
          IF csec.kind = Ast.NConstSection THEN
            FOR cj2 := 0 TO csec.nkids - 1 DO
              IF csec.kids[cj2] IS SOME cdl THEN
                MAdd (consts, cdl.a, cdl.kids[0], '')
              END
            END
          END
        END
      END
    END ;
    IF NOT DynStr.Eq (retC, 'void') THEN
      Line (KPbuf, 1, S4 (retC, ' m9ret', ZeroInit (retC), ';'))
    END ;
    (* the monitor is entered BEFORE the locals are declared -- the
       order the bootstrap generator emits (M9Gen.pas), which gendiff
       holds this one to; a monitor-bound procedure with a local VAR
       first appeared in the corpus with Mat's banded kernels *)
    IF LEN (monPar) > 0 THEN
      Line (KPbuf, 1, S3 ('m9_mon_enter (&(*', monPar, ').m9mon);'))
    END ;

    (* locals: zero-initialized, pools registered for L_ret free *)
    body := gps[gi].body ;
    IF body IS SOME bd THEN
      FOR i := 0 TO bd.nkids - 2 DO
        IF bd.kids[i] IS SOME sect THEN
          IF sect.kind = Ast.NVarSection THEN
            FOR g := 0 TO sect.nkids - 1 DO
              IF sect.kids[g] IS SOME vd THEN
                cty := TyC (vd.kids[1]) ;
                rk := Resolve (vd.kids[1]) ;
                init := ZeroInit (cty) ;
                (* the structural test wins over the name: a GRID of
                   I64 is called m9_gd3_int64_t, which contains _t and
                   is not a scalar -- it emitted `= 0` and gcc refused
                   it.  Found by the port's second kernel; a SLICE
                   OF I64 had the same defect and no corpus module had
                   happened to declare one as a local. *)
                IF rk IS SOME rk0 THEN
                  IF rk0.kind = Ast.NGridType OR
                     rk0.kind = Ast.NSliceType OR
                     rk0.kind = Ast.NArrayType OR
                     rk0.kind = Ast.NRecordType OR
                     rk0.kind = Ast.NCaseRecordType OR
                     rk0.kind = Ast.NEnumType THEN
                    init := ' = {0}'
                  END
                END ;
                IF vd.kids[0] IS SOME vids THEN
                  FOR j := 0 TO vids.nkids - 1 DO
                    IF vids.kids[j] IS SOME vid THEN
                      MAdd (scope, vid.a, vd.kids[1], 'l') ;
                      nm := CN (vid.a) ;
                      Line (KPbuf, 1, S7 (cty, ' ', nm, init,
                        '; (void) ', nm, ';')) ;
                      IF rk IS SOME rkn THEN
                        IF rkn.kind = Ast.NQualident AND
                           DynStr.Eq (rkn.a, 'POOL') THEN
                          IF nlp = LEN (lpools) THEN
                            nb := NEW (gpool, STR, 2 * LEN (lpools)) ;
                            FOR k := 0 TO nlp - 1 DO nb[k] := lpools[k] END ;
                            lpools := nb
                          END ;
                          lpools[nlp] := nm ;
                          nlp := nlp + 1
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END ;

      (* module state, visible after params and locals (first hit wins) *)
      ModuleScope () ;
      PushAggs () ;

      (* the body's block goes through the statement emitter so a
         proc-level EXCEPT/FINALLY gets the full treatment *)
      EmitStmt (bd.kids[bd.nkids - 1], 1)
    END ;

    Line (KPbuf, 0, 'L_ret: ;') ;
    (* every exit passes through L_ret, so a RAISE drops the lock for
       the same reason a RETURN does -- and the result slot goes back
       to the caller's arena for the same reason again, before this
       frame is freed underneath it *)
    Line (KPbuf, 1, 'err->res = m9res;') ;
    (* par 2.3: a string leaving this frame -- the result, or a
       VAR/OWN STR parameter's target -- is copied into the caller's
       arena IF it lives in the frame that is about to be freed.
       Asked of the address, at the exit: a `+`, a callee's re-homed
       answer, a view of either, are all caught; a literal, a borrow,
       or a string in a pool the caller named is not moved.  This is
       what lets a string procedure take no pool. *)
    (* ... and from every LOCAL named pool as well, since 2026-09-30:
       `VAR scratch: POOL` + DynStr + `RETURN DynStr.View (d)` is then
       a string builder that takes no pool, the scratch dying here
       and the answer copied out (docs/pool-elision-plan.md, stage 2).
       The frame is lpools[0]; a pool with no block is one load. *)
    IF DynStr.Eq (retC, 'm9_sl_CHAR') THEN
      FOR i := 0 TO nlp - 1 DO
        Line (KPbuf, 1, S3 ('m9ret = m9_rehome (&', lpools[i],
                            ', m9res, m9ret, err);'))
      END
    END ;
    FOR i := 0 TO nout - 1 DO
      FOR k := 0 TO nlp - 1 DO
        Line (KPbuf, 1, S7 ('*', outStr[i], ' = m9_rehome (&', lpools[k],
                            ', m9res, *', outStr[i], ', err);'))
      END
    END ;
    (* rule 1 of docs/pool-elision-plan.md: a frame allocation that
       leaves -- through the result, or a VAR/OWN parameter's target
       -- takes the whole arena with it into the caller's, which a
       copy could not do for a graph.  One address test per pointer
       component; a frame that never allocated has no blocks. *)
    IF d.kids[1] IS SOME rtn THEN
      IF NOT DynStr.Eq (retC, 'm9_sl_CHAR') THEN
        IF HasPtr (d.kids[1], 0) THEN
          AdoptEmit ('m9ret', d.kids[1], 'm9res', 1, 0)
        END
      END
    END ;
    FOR i := 0 TO nadopt - 1 DO
      AdoptEmit (S3 ('(*', adoptC[i], ')'), adoptT[i], adoptD[i], 1, 0)
    END ;
    IF LEN (monPar) > 0 THEN
      Line (KPbuf, 1, S3 ('m9_mon_leave (&(*', monPar, ').m9mon);'))
    END ;
    FOR i := 0 TO nlp - 1 DO
      Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
    END ;
    IF DynStr.Eq (retC, 'void') THEN
      Line (KPbuf, 1, 'return;')
    ELSE
      Line (KPbuf, 1, 'return m9ret;')
    END ;
    Line (KPbuf, 0, '}') ;
    consts.n := constsBase
  END
END GenProc ;

(* a program module's body becomes main ().  The err slot is declared
   here and nowhere else: it is the root of the ABI, so an exception
   reaching this frame escaped every handler in the program and must
   be REPORTED and exited on, never swallowed -- par 11's flush rule,
   which the museum's HALT piece paid for.                          *)
PROCEDURE GenMain () =
VAR i : I64 ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  curRetTag := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  ModuleScope () ;
  PushAggs () ;
  Line (KPbuf, 0, '') ;
  Line (KPbuf, 0, 'int main (int argc, char **argv)') ;
  Line (KPbuf, 0, '{') ;
  Line (KPbuf, 1, 'm9_state errv = {0};') ;
  Line (KPbuf, 1, 'm9_state *err = &errv;') ;
  PoolReg ('m9mframe') ;
  Line (KPbuf, 1, 'err->res = &m9mframe;') ;
  IF LEN (dbgSrc) > 0 THEN
    Line (KPbuf, 1, S3 ('err->file = "', dbgSrc, '";'))
  END ;
  Line (KPbuf, 1, 'm9_args (argc, argv);') ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KPbuf, 1, S3 (CP (extMods.es[i].k), '_m9init (err);',
      ' if (err->exc) goto L_ret;'))
  END ;
  EmitStmt (mainBody, 1) ;
  Line (KPbuf, 0, 'L_ret: ;') ;
  FOR i := 0 TO nlp - 1 DO
    Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
  END ;
  Line (KPbuf, 1, 'return m9_exit (err);') ;
  Line (KPbuf, 0, '}')
END GenMain ;

(* a NON-program module's body is its INITIALISATION, and it RUNS --
   Modula-2's rule.  Every module emits an idempotent Mod_m9init that
   runs its direct imports' inits first (so a module sees its
   dependencies initialised) and then its own body; a body-less module
   still emits one, a no-op chain, so the ordering reaches through it.
   A program's main calls its imports' inits before its own body.
   Before this a library body was accepted and silently dropped --
   an init nobody ran, the contract broken without a word.          *)
PROCEDURE GenInit (RO forModule: STR) =
VAR i : I64 ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  curRetTag := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  ModuleScope () ;
  PushAggs () ;
  Line (KPbuf, 0, '') ;
  Line (KPbuf, 0, S3 ('void ', CP (forModule), '_m9init (m9_state *err)')) ;
  Line (KPbuf, 0, '{') ;
  Line (KPbuf, 1, 'static int m9done = 0;') ;
  Line (KPbuf, 1, 'if (m9done) return;') ;
  Line (KPbuf, 1, 'm9done = 1;') ;
  (* the init body's frame is the MODULE's lifetime: the checker
     exempts a store into a module variable here (par 2.3) because
     the frame and the module variables share one, so the arena is
     static and never freed -- a frame allocation the body keeps in a
     module variable stays valid for the process (rule 1) *)
  Line (KPbuf, 1, 'm9_pool *m9prev = err->res;') ;
  Line (KPbuf, 1, 'err->res = &m9mframe;') ;
  (* direct imports first, so their state is ready *)
  FOR i := 0 TO extMods.n - 1 DO
    Line (KPbuf, 1, S3 (CP (extMods.es[i].k), '_m9init (err);',
      ' if (err->exc) goto L_ret;'))
  END ;
  EmitStmt (mainBody, 1) ;
  Line (KPbuf, 0, 'L_ret: ;') ;
  FOR i := 0 TO nlp - 1 DO
    Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
  END ;
  Line (KPbuf, 1, 'err->res = m9prev;')
  ;
  Line (KPbuf, 0, '}')
END GenInit ;

(* ---- EXPORTED MODULE VARIABLES (decision 28, 2026-10-04) ----

   The exporter keeps its variable a file-local static, as every
   module variable is, and publishes a constant POINTER to it,
   Mod_v, declared extern in its header -- the constant table's
   shape (decision 20).  An importer has Mod.v in scope in
   VAR-parameter mode (ModuleScope), so every read, write, index,
   LEN and lending goes through the paths a VAR parameter takes.  A
   pointer-bearing variable publishes its pool as well, Mod_v_pool --
   the pool rule 2 says a VAR root carries: its IN clause, else the
   module frame. *)
PROCEDURE ExportVars () =
VAR
  i : I64 ;
  ty, cn, pl : STR ;
  t : Ast.Kid ;
  any : BOOL ;
BEGIN
  any := FALSE ;
  FOR i := 0 TO nmv - 1 DO
    IF mvDef[i] THEN
      any := TRUE ;
      ty := TyC (mvT[i]) ;
      cn := S3 (CP (modName), '_', mvN[i]) ;
      Line (KRec3, 0, S6 (ty, ' * const ', cn, ' = &', CN (mvN[i]), ';')) ;
      Line (KHdrProtos, 0, S5 ('extern ', ty, ' * const ', cn, ';')) ;
      IF PoolParamTy (mvT[i]) THEN
        pl := '&m9mframe' ;
        t := mvT[i] ;
        IF t IS SOME tn THEN
          IF tn.kind = Ast.NOptType THEN t := tn.kids[0] END
        END ;
        IF Resolve (t) IS SOME r THEN
          IF r.kind = Ast.NPtrType THEN
            IF r.kids[1] IS SOME pn THEN
              IF pn.nkids = 0 THEN pl := S2 ('&', CN (pn.a)) END
            END
          END
        END ;
        Line (KRec3, 0, S4 ('m9_pool * const ', cn, '_pool = ', S2 (pl, ';'))) ;
        Line (KHdrProtos, 0, S3 ('extern m9_pool * const ', cn, '_pool;'))
      END
    END
  END ;
  IF any THEN Line (KRec3, 0, '') END
END ExportVars ;

(* is `name' declared under k: a variable, parameter, binder, type,
   constant or exception -- Sem.DeclaresName, for the shadow test *)
PROCEDURE DeclaresName (k: Ast.Kid ; RO name: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NIdent OR n.kind = Ast.NIsSome OR n.kind = Ast.NTypeDecl
       OR n.kind = Ast.NConstDecl OR n.kind = Ast.NExcDecl THEN
      IF DynStr.Eq (n.a, name) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF DeclaresName (n.kids[i], name) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DeclaresName ;

(* a name this module declares at its own level, or the procedure
   `scope' declares: the module of the same spelling is shadowed *)
PROCEDURE NameShadowed (scope: Ast.Kid ; RO name: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF DeclaresName (scope, name) THEN RETURN TRUE END ;
  IF FindProcN (name) >= 0 OR MFind (consts, name) >= 0 THEN RETURN TRUE END ;
  IF FindTypeN (name) IS SOME tn THEN RETURN TRUE END ;
  FOR i := 0 TO nmv - 1 DO
    IF DynStr.Eq (mvN[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END NameShadowed ;

(* `a.b', in the module's own pool and not the node's: the node's
   pool, named through a binder on a module table, was the walk's own
   frame in the generator, and the name dangled once the walk returned
   (`unknown name: const vo', 2026-10-04) *)
PROCEDURE DotJoin (RO a, b: STR) : STR =
VAR
  s : SLICE OF CHAR ;
  i : I64 ;
BEGIN
  s := NEW (gpool, CHAR, LEN (a) + 1 + LEN (b)) ;
  FOR i := 0 TO LEN (a) - 1 DO s[i] := a[i] END ;
  s[LEN (a)] := '.' ;
  FOR i := 0 TO LEN (b) - 1 DO s[LEN (a) + 1 + i] := b[i] END ;
  RETURN s
END DotJoin ;

(* Sem.ExportWalk's twin: the designator Mod.v... of a directly
   imported module's exported variable becomes the designator rooted
   at the one name Mod.v.  Here, and not only in the checker, because
   the generator is also run without it (gendump_m9, the oracle's
   gentest) and both ends must emit the same C. *)
PROCEDURE ExportWalk (VAR n: PTR Ast.Node ; scope: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
    IF n.kids[0] IS SOME s THEN
      IF s.kind = Ast.NSelField AND MFind (extMods, n.a) >= 0 THEN
        IF MFind (extVars, S3 (n.a, '.', s.a)) >= 0 AND
           NOT NameShadowed (scope, n.a) THEN
          n.a := DotJoin (n.a, s.a) ;
          FOR i := 0 TO n.nkids - 2 DO n.kids[i] := n.kids[i + 1] END ;
          n.nkids := n.nkids - 1
        END
      END
    END
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN
      IF n.kind = Ast.NProcDecl THEN
        ExportWalk (c, SOME (n))
      ELSE
        ExportWalk (c, scope)
      END
    END
  END
END ExportWalk ;

PROCEDURE ExportWalks () =
VAR i : I64 ;
BEGIN
  IF extVars.n = 0 THEN RETURN END ;
  FOR i := 0 TO ngps - 1 DO
    IF gps[i].node IS SOME pn THEN ExportWalk (pn, NONE) END
  END ;
  IF mainBody IS SOME mb THEN ExportWalk (mb, NONE) END
END ExportWalks ;

PROCEDURE Emit (RO forModule: STR) =
VAR
  i, ci, j2, i2 : I64 ;
  cs, s, tgt : STR ;
  anyPay : BOOL ;
  fsq : Ast.Kid ;
  d2 : PTR DynStr.DString IN gpool ;
  buf : I64 ;
BEGIN
  Setup () ;
  bHdr := DynStr.New (gpool) ;
  bSrc := DynStr.New (gpool) ;
  bTdefs := DynStr.New (gpool) ;
  bPbuf := DynStr.New (gpool) ;
  bSprotos := DynStr.New (gpool) ;
  bLit := DynStr.New (gpool) ;
  bHdrRecs := DynStr.New (gpool) ;
  bHdrProtos := DynStr.New (gpool) ;
  bHdrConsts := DynStr.New (gpool) ;
  bRec2 := DynStr.New (gpool) ;
  bArrRec := DynStr.New (gpool) ;
  bHdrArrRec := DynStr.New (gpool) ;
  bRec3 := DynStr.New (gpool) ;
  bThr := DynStr.New (gpool) ;
  bGate := DynStr.New (gpool) ;
  tdefN := 0 ; sprotoN := 0 ; litN := 0 ; hdrConstN := 0 ;
  MInit (arrSeen) ;
  ExportWalks () ;
  Line (KHdr, 0, S3 ('/* generated by M9Gen from ', forModule,
    '.m9 -- do not edit */')) ;
  Line (KHdr, 0, S2 ('#ifndef M9G_', S2 (forModule, '_H'))) ;
  Line (KHdr, 0, S2 ('#define M9G_', S2 (forModule, '_H'))) ;
  Line (KHdr, 0, '#include "m9rt.h"') ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KHdr, 0, S3 ('#include "', extMods.es[i].k, '.h"'))
  END ;
  Line (KHdr, 0, '') ;
  (* every library module declares its initialiser, so an importer can
     run it before the module's state is used (docs/enum-plan.md) *)
  IF NOT isProgram THEN
    Line (KHdr, 0, S3 ('void ', CP (forModule), '_m9init (m9_state *err);')) ;
    Line (KHdr, 0, '')
  END ;
  Line (KSrc, 0, S3 ('/* generated by M9Gen from ', forModule,
    '.m9 -- do not edit */')) ;
  Line (KSrc, 0, S3 ('#include "', forModule, '.h"')) ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KSrc, 0, S3 ('#include "', extMods.es[i].k, '.h"'))
  END ;
  Line (KSrc, 0, '') ;

  (* forward typedefs for every record type: slice typedefs and
     mutually recursive fields need the names before the structs
     (typedef redefinition is legal C11, so the transparent structs'
     own typedef lines are harmless duplicates) *)
  FOR i := 0 TO ntys - 1 DO
    anyPay := tys[i].opq ;
    IF tys[i].node IS SOME tn THEN
      IF tn.kind = Ast.NRecordType OR
         tn.kind = Ast.NMonitorType OR
         tn.kind = Ast.NCaseRecordType OR
         tn.kind = Ast.NEnumType THEN anyPay := TRUE END
    END ;
    IF anyPay THEN
      Line (KHdr, 0, S6 ('typedef struct ', CP (modName), '_', tys[i].name,
        ' ', S4 (CP (modName), '_', tys[i].name, ';')))
    END
  END ;
  Line (KHdr, 0, '') ;

  (* procedure types (par 2.2.3): a function-pointer typedef with the
     err slot last, the same C signature GenProc gives a procedure of
     that head.  Into the discovered-typedef stream, AFTER the slice
     typedefs its parameters register on the way and BEFORE the
     record bodies that may hold a field of it. *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        Line (KTdefs, 0, ProcTypedefC (tys[i].name, ptn))
      END
    END
  END ;

  (* case records: tagged structs, tags from 0 in declaration order;
     variants with payload fields become union members named after
     the variant *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME d THEN
      IF d.kind = Ast.NCaseRecordType OR d.kind = Ast.NEnumType THEN
        IF tys[i].fdef THEN buf := KHdr ELSE buf := KSrc END ;
        anyPay := FALSE ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            IF v.kids[0] IS SOME vf THEN anyPay := TRUE END
          END
        END ;
        (* a NAMED struct, like records: an anonymous typedef cannot
           be forward-declared, so a SLICE OF this variant put an
           undeclared name in the header (SliceVar.m9) *)
        IF NOT IsOpaque (tys[i].name) THEN
          Line (buf, 0, S6 ('typedef struct ', CP (modName), '_', tys[i].name,
            ' ', S4 (CP (modName), '_', tys[i].name, ';')))
        END ;
        IF anyPay THEN
          Line (buf, 0, S5 ('struct ', CP (modName), '_', tys[i].name, ' {')) ;
          Line (buf, 0, '  int32_t tag;') ;
          Line (buf, 0, '  union {') ;
          FOR ci := 0 TO d.nkids - 1 DO
            IF d.kids[ci] IS SOME v THEN
              IF v.kids[0] IS SOME vfs THEN
                s := '    struct { ' ;
                FOR j2 := 0 TO vfs.nkids - 1 DO
                  IF vfs.kids[j2] IS SOME fg THEN
                    IF fg.kids[0] IS SOME fids THEN
                      FOR i2 := 0 TO fids.nkids - 1 DO
                        IF fids.kids[i2] IS SOME fid THEN
                          s := S5 (s, TyC (fg.kids[1]), ' ',
                            CN (fid.a), '; ')
                        END
                      END
                    END
                  END
                END ;
                Line (buf, 0, S3 (s, '} ', S2 (v.a, ';')))
              END
            END
          END ;
          Line (buf, 0, '  } u;') ;
          Line (buf, 0, '};')
        ELSE
          Line (buf, 0, S4 ('struct ', CP (modName), '_',
            S2 (tys[i].name, ' { int32_t tag; };')))
        END ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            Line (buf, 0, S7 ('#define ', CP (modName), '_', tys[i].name,
              '_', v.a, S2 (' ', ItoA (ci)))) ;
            (* NAME's food: one code-point array per member *)
            Line (buf, 0, S9 ('static const uint32_t ', CP (modName), '_',
              tys[i].name, '_nm', ItoA (ci), '[] = { ',
              StrCodes (v.a), ' };'))
          END
        END ;
        (* and the table NAME indexes by tag *)
        (* __unused__: the table is dead when nobody calls NAME on
           this type, and -Werror=unused-const-variable would reject
           it; the linker strips it either way *)
        Line (buf, 0, S6 ('static const m9_sl_CHAR __attribute__((__unused__)) ',
          CP (modName), '_', tys[i].name, '_names[] = {', '')) ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            Line (buf, 0, S9 ('  { (uint32_t *) ', CP (modName), '_',
              tys[i].name, '_nm', ItoA (ci), ', ',
              ItoA (LEN (v.a)), ' },'))
          END
        END ;
        Line (buf, 0, '};') ;
        Line (buf, 0, '')
      END
    END
  END ;

  (* exceptions: static descriptors, identity by address (par 11) *)
  FOR i := 0 TO nxcs - 1 DO
    IF xcs[i].fdef THEN
      Line (KHdr, 0, S4 ('extern const m9_exc ', CP (modName), '_',
        S2 (xcs[i].name, ';'))) ;
      Line (KSrc, 0, S7 ('const m9_exc ', CP (modName), '_', xcs[i].name,
        ' = { "', xcs[i].name, '" };'))
    ELSE
      Line (KSrc, 0, S7 ('static const m9_exc ', CP (modName), '_',
        xcs[i].name, ' = { "', xcs[i].name, '" };'))
    END
  END ;
  IF nxcs > 0 THEN
    Line (KHdr, 0, '') ;
    Line (KSrc, 0, '')
  END ;

  (* record bodies -- into rec2 (spliced after the typedefs their
     field types register), except transparent DEFINITION records,
     which callers must see: those go to the header *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME d THEN
      IF d.kind = Ast.NRecordType OR
         d.kind = Ast.NMonitorType THEN
        IF tys[i].fdef AND NOT IsOpaque (tys[i].name) THEN
          buf := KHdrRecs
        ELSE
          buf := KRec2
        END ;
        IF NOT IsOpaque (tys[i].name) THEN
          Line (buf, 0, S6 ('typedef struct ', CP (modName), '_',
            tys[i].name, ' ', S4 (CP (modName), '_', tys[i].name, ';')))
        END ;
        Line (buf, 0, S5 ('struct ', CP (modName), '_', tys[i].name, ' {')) ;
        (* A MONITOR IS A RECORD WITH A LOCK AS ITS FIRST FIELD, so it
           is layout-compatible with the record it is and the lock
           needs no offset arithmetic.  No constructor: M9 records
           arrive zeroed and a zeroed pthread_mutex_t is
           PTHREAD_MUTEX_INITIALIZER on glibc -- measured, see
           m9rt.h. *)
        IF d.kind = Ast.NMonitorType THEN
          Line (buf, 0, '  m9_mon m9mon;')
        END ;
        (* one declarator per line: `T * a, b` is one pointer and one
           struct in C -- the star binds to the declarator, not the
           type *)
        IF d.kind = Ast.NMonitorType THEN
          fsq := d.kids[0]
        ELSE
          fsq := d.kids[1]
        END ;
        IF fsq IS SOME fs THEN
          FOR ci := 0 TO fs.nkids - 1 DO
            IF fs.kids[ci] IS SOME fg THEN
              s := TyC (fg.kids[1]) ;
              IF fg.kids[0] IS SOME fids THEN
                FOR j2 := 0 TO fids.nkids - 1 DO
                  IF fids.kids[j2] IS SOME fid THEN
                    Line (buf, 0, S4 ('  ', s, ' ', S2 (CN (fid.a), ';')))
                  END
                END
              END
            END
          END
        END ;
        Line (buf, 0, '};') ;
        Line (buf, 0, '')
      END
    END
  END ;

  (* module consts -- into the header, so importers see them *)
  FOR ci := 0 TO consts.n - 1 DO
    IF consts.es[ci].v IS SOME e THEN
      IF e.kind = Ast.NInt THEN
        Line (KHdrConsts, 0, S6 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' INT64_C(', S2 (e.a, ')')))
      (* a negated literal is a unary node, not a literal: Dict's
         Empty = -1 is the first const the corpus wrote that way *)
      ELSIF IsNegLit (e, Ast.NInt) THEN
        Line (KHdrConsts, 0, S6 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' INT64_C(-', S2 (NegLitText (e), ')')))
      ELSIF IsNegLit (e, Ast.NReal) THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (-', NegLitText (e), ')'))
      ELSIF e.kind = Ast.NReal THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (', e.a, ')'))
      (* a BOOLEAN constant.  the ported model's parameter module has four of them and
         Fortran calls them parameters, which is what they are: a
         switch a program cannot flip at run time *)
      ELSIF e.kind = Ast.NTrue THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' true'))
      ELSIF e.kind = Ast.NFalse THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' false'))
      ELSIF e.kind = Ast.NString AND LEN (e.a) > 0 THEN
        Line (KHdrConsts, 0, S9 ('static const uint32_t ', CP (modName), '_',
          consts.es[ci].k, '_d[', ItoA (LEN (e.a)), '] = { ',
          StrCodes (e.a), ' };')) ;
        Line (KHdrConsts, 0, S9 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ((m9_sl_CHAR){ (uint32_t *) ', modName,
          '_', consts.es[ci].k, S4 ('_d, ', ItoA (LEN (e.a)), ' })', '')))
      (* a CHAR constant: one code point, emitted like the char
         literal it names -- <cp>u -- so `s + NL` joins it as a code
         point the way `s + 0AC` does (par 2.2) *)
      ELSIF e.kind = Ast.NChar THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (', S2 (ItoA (CharVal (e.a)), 'u'), ')'))
      ELSE
        Err2 (e.line, 'const form unsupported yet')
      END
    END
  END ;

  (* foreign procedures: extern declarations against the C ABI, the
     names passing through verbatim (par 7) *)
  FOR i := 0 TO foreignProcs.n - 1 DO
    IF foreignProcs.es[i].v IS SOME d THEN
      IF d.kids[1] IS SOME rt THEN s := TyC (d.kids[1]) ELSE s := 'void' END ;
      cs := '' ;
      IF d.kids[0] IS SOME pl THEN
        FOR ci := 0 TO pl.nkids - 1 DO
          IF pl.kids[ci] IS SOME grp THEN
            IF grp.kids[0] IS SOME gids THEN
              FOR j2 := 0 TO gids.nkids - 1 DO
                IF LEN (cs) > 0 THEN cs := S2 (cs, ', ') END ;
                cs := S2 (cs, TyC (grp.kids[1]))
              END
            END
          END
        END
      END ;
      IF LEN (cs) = 0 THEN cs := 'void' END ;
      Line (KSrc, 0, S6 ('extern ', s, ' ', d.b, ' (', S2 (cs, ');')))
    END
  END ;
  IF foreignProcs.n > 0 THEN Line (KSrc, 0, '') END ;

  (* STATEFUL module state: statics, zero like every C static --
     which is also M9's defined-zero story.  Emitted into rec2 now so
     their array typedefs register before tdefs is spliced. *)
  FOR i := 0 TO nmv - 1 DO
    Line (KRec3, 0, S5 ('static ', TyC (mvT[i]), ' ', CN (mvN[i]), ';'))
  END ;
  EmitAggs () ;
  (* the MODULE FRAME: the arena of the init body (a program's main),
     static and at file scope since 2026-09-30 so that a module
     variable declared without a pool has one to be grown in (rule 2
     of docs/pool-elision-plan.md) -- a module variable lives as long
     as the module, and so does this *)
  Line (KRec3, 0, 'static m9_pool m9mframe = {0};') ;
  Line (KRec3, 0, '') ;
  ExportVars () ;

  (* procedures emit into pbuf; typedefs, string literals, and static
     prototypes they discover along the way land before them *)
  FOR i := 0 TO ngps - 1 DO
    GenProc (i)
  END ;
  IF isProgram THEN
    IF mainBody IS SOME mb THEN GenMain () END
  ELSE
    GenInit (forModule)
  END ;

  (* header assembly: consts, discovered typedefs, transparent def
     records, prototypes -- in dependency order *)
  DynStr.Append (bHdr, DynStr.View (bHdrConsts)) ;
  IF hdrConstN > 0 THEN Line (KHdr, 0, '') END ;
  DynStr.Append (bHdr, DynStr.View (bTdefs)) ;
  IF tdefN > 0 THEN Line (KHdr, 0, '') END ;
  DynStr.Append (bHdr, DynStr.View (bHdrRecs)) ;
  DynStr.Append (bHdr, DynStr.View (bHdrArrRec)) ;
  DynStr.Append (bHdr, DynStr.View (bHdrProtos)) ;
  Line (KHdr, 0, '') ;
  Line (KHdr, 0, '#endif') ;

  DynStr.Append (bSrc, DynStr.View (bRec2)) ;
  DynStr.Append (bSrc, DynStr.View (bArrRec)) ;
  DynStr.Append (bSrc, DynStr.View (bRec3)) ;
  DynStr.Append (bSrc, DynStr.View (bLit)) ;
  IF litN > 0 THEN Line (KSrc, 0, '') END ;
  DynStr.Append (bSrc, DynStr.View (bGate)) ;
  IF gateSeen.n > 0 THEN Line (KSrc, 0, '') END ;
  DynStr.Append (bSrc, DynStr.View (bSprotos)) ;
  IF sprotoN > 0 THEN Line (KSrc, 0, '') END ;
  (* the trampolines go AFTER the prototypes they call and before the
     bodies, which is the only place both are visible *)
  DynStr.Append (bSrc, DynStr.View (bThr)) ;
  IF thrSeen.n > 0 THEN Line (KSrc, 0, '') END ;
  DynStr.Append (bSrc, DynStr.View (bPbuf)) ;

  hOut := DynStr.View (bHdr) ;
  cOut := DynStr.View (bSrc)
END Emit ;

PROCEDURE HText () : STR =
BEGIN
  RETURN hOut
END HText ;

PROCEDURE CText () : STR =
BEGIN
  RETURN cOut
END CText ;

PROCEDURE Errs () : I64 =
BEGIN
  RETURN nerrV
END Errs ;

END Gen.
