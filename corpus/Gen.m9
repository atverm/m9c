STATEFUL DEFINITION MODULE Gen ;

(* The C11 code generator, in M9 -- restated from host/fpc/M9Gen.pas
   for P5 stage 2.  The FPC generator is the differential oracle:
   both must emit byte-identical .h and .c for every corpus module,
   including this one.  Faithfulness outranks taste: the oracle's
   warts are replicated deliberately.  (TagOfExpr recomputed via DES
   and CallC, side effects and all, until the typed tree's stage 3
   made the checker's recorded type the answer, 2026-10-09.)
   Errors are counted; the message table is stage-2 driver work.
   One generator instance per process: state is module-level and the
   pool is never reset, exactly one module per run.                  *)

IMPORT Ast ;

PROCEDURE LoadUnit (VAR KEPT u: PTR Ast.Node) ;
PROCEDURE LoadExtern (KEPT u: PTR Ast.Node) ;
  (* a DIRECT import: register its declarations and include its
     header, because this module names things in it *)

PROCEDURE LoadExternDeep (KEPT u: PTR Ast.Node) ;
  (* a dependency of a dependency: register its declarations so a
     callee's signature can be RESOLVED -- Qvsat.Ew answers a
     Kind.FlexFloat and its caller has no business importing Kind --
     but emit no #include, because this module names nothing in it.

     The third closure.  The checker wants the transitive one, the
     generator's INCLUDE list wants the direct one, and between them
     was a hole: a direct dependency's signature may name a type from
     a module this one does not import.  It resolved to nothing and,
     until the guard went in, became integer arithmetic. *)
PROCEDURE SetPrefix (RO module: UTF ; RO prefix: UTF) ;
  (* emit module MODULE's C names -- its procedures, initialiser,
     exceptions, exported variables and types -- under PREFIX instead
     of the module's name: one generation of a notebook state cell,
     run again, beside the generation before it in one process
     (docs/notebook-state-plan.md phase 2).  Without a call, every
     name is the module's own and the C is what it always was. *)

PROCEDURE SetDebugSource (RO file: UTF) ;
  (* Emit `#line` directives naming FILE, so a debugger and a
     backtrace report the M9 source rather than the generated C.
     Call it before Emit; the empty string turns it off, which is
     the default and is what every gate compares.  m9c calls this
     under -g and only under -g: the C emitted without it is
     byte-for-byte what it always was, which is what keeps gendiff
     and the bootstrap fixpoint meaningful.                        *)

PROCEDURE Emit (RO forModule: UTF) ;
PROCEDURE HText () : UTF ;
PROCEDURE CText () : UTF ;
PROCEDURE Errs () : I64 ;
PROCEDURE ErrLineAt (i: I64) : I64 ;
PROCEDURE ErrMsgAt (i: I64) : UTF ;
  (* the first eight generator errors, with source lines: a count
     alone cost a bisect every time a module was written outside the
     corpus, and then cost one INSIDE the tutorial.  i in
     0 .. MIN (Errs (), 8) - 1; msgs may be '' where a site has no
     wording yet.                                                    *)
PROCEDURE ErrModAt (i: I64) : UTF ;
  (* the module whose source error i's line is in: '' for the module
     being emitted, else an imported definition's name (2026-10-29) *)

PROCEDURE SetIrCheck (on: BOOL) ;
PROCEDURE SetStrUtf (on: BOOL) ;
  (* the switch, rehearsed (Sem.SetStrUtf): STR is m9_sl_UTF8, a
     literal and a string CONST are octets, STR (u) is u, X whose
     module declares XUtf is not emitted and a call of X calls XUtf *)
  (* the IR lowering's first step (docs/ir-plan.md): with on, Emit
     holds ExprRaises -- whether an expression can raise, read off the
     tree before anything is emitted -- to what the emitter found while
     emitting, at every argument it may hoist, and IrReport lists the
     disagreements.  The C is not changed either way. *)
PROCEDURE IrReport () : UTF ;
  (* one line a disagreement since SetIrCheck: `LINE: tree X, emitter Y:
     C', '' when there was none *)

END Gen.


IMPLEMENTATION MODULE Gen ;

IMPORT Ast ;
IMPORT DynUtf ;
IMPORT Text ;

CONST
  (* output buffers, selected by number: DynStr.Append takes VAR d and
     may reallocate, so a buffer may never be aliased into a local --
     the module var itself must be the one that is updated.           *)
  KHdr = 0 ;   KSrc = 1 ;   KTdefs = 2 ;   KPbuf = 3 ; KSprotos = 4 ;
  KLit = 5 ;   KHdrRecs = 6 ; KHdrProtos = 7 ; KHdrConsts = 8 ;
  KRec2 = 9 ; KThr = 10 ;   (* THREAD trampolines *)
  KGate = 11 ;              (* one m9_mon per [SERIAL] FOR-C unit *)
  (* an ARRAY OF a record of this module is typedef'd AFTER the struct
     it contains -- in the C file for a private record, the header for
     a transparent one -- and the statics, constant data and exported
     pointers that may use it after that (2026-10-05; until then the
     typedef went to tdefs, ahead of every struct, and an array of
     records did not compile: "incomplete element type") *)
  KArrRec = 12 ; KHdrArrRec = 13 ; KRec3 = 14 ;

TYPE
  AKid = Ast.Kid ;                   (* named so NEW can say it *)

  MEnt = RECORD
    k, t : UTF ;
    v : Ast.Kid ;
  END ;

  (* es[0 .. n - 1], the first entry of a key the one MFind answers.
     ixKey/ixAt index them by key (open addressing): a slot counts only
     while its entry is live and still holds the key, so cutting a map
     back (scope.n := saved) needs no bookkeeping.  MFind was a scan,
     n squared in a module's procedures or a procedure's locals (the
     review's F5). *)
  Map = RECORD
    es : SLICE OF MEnt ;
    n : I64 ;
    ixKey : SLICE OF UTF ;
    ixAt : SLICE OF I64 ;      (* entry + 1; 0 is an empty slot *)
    ixLast : SLICE OF I64 ;    (* the key's latest entry + 1 (MLast) *)
    ixOcc : I64 ;
  END ;

  GP = RECORD
    name : UTF ;
    node, body : Ast.Kid ;
    exported : BOOL ;
  END ;

  TY = RECORD
    name : UTF ;
    node : Ast.Kid ;
    opq, fdef : BOOL ;
  END ;

  XC = RECORD
    name : UTF ;
    fields : Ast.Kid ;
    fdef : BOOL ;
  END ;

VAR
  gpool : POOL ;
  modName : UTF ;
  dbgSrc : UTF ;           (* SetDebugSource; empty = no #line *)
  pfxMod, pfxC : SLICE OF UTF ;  (* SetPrefix: module -> C prefix *)
  npfx : I64 ;
  constsBase : I64 ;       (* consts below this are the module's; at
                              or above it, the procedure's own *)
  inited : BOOL ;
  nerrV, tmpN, inSwitch, finDepth : I64 ;
  loopDepth, xitN : I64 ;          (* loops entered; EXIT labels made *)
  xitLbl : UTF ;                   (* the innermost loop's exit label, '' until an EXIT needs it *)
  litN, tdefN, sprotoN, hdrConstN : I64 ;
  nhoist : I64 ;
  curRetTag, exitLbl, raiseLbl, curRetq : UTF ;
  hOut, cOut : UTF ;

  consts, extProcs, extTypes, extConsts, extMods, extExcs : Map ;
  extVars : Map ;          (* Mod.v -> its type, qualified in Mod: the
                              imported module variables (decision 28) *)
  foreignProcs, arrSeen, thrSeen, gateSeen, scope : Map ;
  gps : SLICE OF GP ;
  ngps : I64 ;
  gpIx : Map ;             (* gps by name: entry i is gps[i] *)
  irOn : BOOL ;            (* SetIrCheck: IrArgCheck at every argument *)
  strUtf : BOOL ;          (* SetStrUtf: STR is the UTF type *)
  irReach : Map ;          (* CallC0: the arguments reached as generic, id:k *)
  fieldIx : Map ;          (* FieldType: "record id field" -> the field's type *)
  fieldDone : Map ;        (* FieldType: the records indexed, by id *)
  fieldGrp : SLICE OF I64 ; (* FieldType: fieldIx entry -> its field group *)
  lowered : Map ;          (* LowerHoist: an argument's node -> its temporary *)
  irLeft : BOOL ;          (* LeftRaises: a lowered argument raises no more *)
  irN : I64 ;
  irBuf : PTR DynUtf.DString IN gpool ;
  tyBody, tyOpq : Map ;    (* tys by name: the first with a body; the
                              opaque ones (FindTypeN, IsOpaque) *)
  tys : SLICE OF TY ;
  ntys : I64 ;
  xcs : SLICE OF XC ;
  ixFields : Ast.Kid ;           (* IndexError's (index, length : I64), built once *)
  nxcs : I64 ;
  mvN : SLICE OF UTF ;
  mvT : SLICE OF AKid ;
  mvDef : SLICE OF BOOL ;  (* declared in the definition: exported *)
  nmv : I64 ;
  aggT : Map ;             (* constant tables (par 2.2.4): name ->
                              the ARRAY n OF T made for it, *)
  aggV : Map ;             (* and name -> the aggregate itself *)
  lpools : SLICE OF UTF ;
  nlp : I64 ;
  outFn : SLICE OF UTF ;   (* each one's re-home function: m9_rehome, or m9_rehome_utf *)
  outStr : SLICE OF UTF ;  (* the VAR/OWN STR parameters, whose
                              targets are re-homed at L_ret *)
  nout : I64 ;
  adoptC : SLICE OF UTF ;  (* the VAR/OWN parameters of a pointer-
                              bearing type, whose targets are tested
                              for adoption at L_ret (rule 1) *)
  adoptT : SLICE OF AKid ;
  adoptD : SLICE OF UTF ;  (* ... and the pool each is adopted INTO:
                              the caller's arena, or the object's own
                              pool that a VAR parameter carries
                              (rule 2) *)
  nadopt : I64 ;
  mvBase : I64 ;           (* where the module variables start in
                              scope, so a designator's root can be
                              told a module variable from a local *)
  bpool : Map ;            (* binder -> the C expression of the pool
                              its origin lives in (rule 2); the most
                              recent entry of a name is the live one *)
  isProgram : BOOL ;       (* MODULE m -- emit a main () *)
  mainBody : Ast.Kid ;     (* its block *)
  inMain : BOOL ;          (* emitting it: err->res is &m9mframe there *)
  strNode : Ast.Kid ;      (* the STR that STR names *)
  utfNode : Ast.Kid ;      (* the SLICE OF <u8> that UTF names *)

  (* the output, UTF-8 octets (docs/utf8-stage3-plan.md, step 3): a
     quarter of the CHAR buffers they were, which with their doublings
     were the largest thing a generation kept *)
  bHdr, bSrc, bTdefs, bPbuf, bSprotos, bLit : PTR DynUtf.DString IN gpool ;
  bHdrRecs, bHdrProtos, bHdrConsts, bRec2 : PTR DynUtf.DString IN gpool ;
  bArrRec, bHdrArrRec, bRec3 : PTR DynUtf.DString IN gpool ;
  bThr, bGate : PTR DynUtf.DString IN gpool ;
  (* while a record's field types are computed: the bucket an ARRAY OF
     a record of this module goes to instead of KArrRec/KHdrArrRec --
     the record's own, so the typedef stands between the element's
     struct and the struct that holds the array; 0 otherwise *)
  arrInto : I64 ;

(* ---- small strings ---- *)

(* FRAME strings, built in the caller's arena (decision 6): a text that
   must live is kept by its keeper, Text.Keep (gpool, ...), where the
   checker says so.  Until 2026-10-23 they built a DynStr in gpool, never
   freed (docs/utf8-stage3-plan.md, step 1) *)

PROCEDURE S2 (RO a: UTF ; RO b: UTF) : UTF =
BEGIN
  RETURN a + b
END S2 ;

PROCEDURE S3 (RO a: UTF ; RO b: UTF ; RO c: UTF) : UTF =
BEGIN
  RETURN a + b + c
END S3 ;

PROCEDURE S4 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO e: UTF) : UTF =
BEGIN
  RETURN a + b + c + e
END S4 ;

PROCEDURE S5 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO e: UTF ;
              RO f: UTF) : UTF =
BEGIN
  RETURN a + b + c + e + f
END S5 ;

PROCEDURE S6 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO e: UTF ;
              RO f: UTF ; RO g: UTF) : UTF =
BEGIN
  RETURN a + b + c + e + f + g
END S6 ;

PROCEDURE S7 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO e: UTF ;
              RO f: UTF ; RO g: UTF ; RO h: UTF) : UTF =
BEGIN
  RETURN a + b + c + e + f + g + h
END S7 ;

PROCEDURE S9 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO e: UTF ;
              RO f: UTF ; RO g: UTF ; RO h: UTF ; RO i2: UTF ;
              RO j2: UTF) : UTF =
BEGIN
  RETURN a + b + c + e + f + g + h + i2 + j2
END S9 ;

PROCEDURE ItoA (v: I64) : UTF =
VAR
  scratch : POOL ;
  d : PTR DynUtf.DString IN scratch ;
BEGIN
  d := DynUtf.New (scratch) ;
  DynUtf.AppendI64 (d, v) ;
  RETURN DynUtf.View (d)
END ItoA ;

(* register a pool to be freed at L_ret.  Two callers: a local
   `VAR p: POOL`, and the implicit frame arena every procedure gets. *)
PROCEDURE PoolReg (RO KEPT nm: UTF) =
VAR nb : SLICE OF UTF ;
    k  : I64 ;
BEGIN
  IF nlp = LEN (lpools) THEN
    nb := NEW (gpool, UTF, 2 * LEN (lpools)) ;
    FOR k := 0 TO nlp - 1 DO nb[k] := lpools[k] END ;
    lpools := nb
  END ;
  lpools[nlp] := nm ;
  nlp := nlp + 1
END PoolReg ;

(* is c the C type of the string the exit re-homes out of a local
   pool: the CHAR slice, and under the rehearsed switch the UTF one *)
PROCEDURE StrCIs (RO c: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (c, 'm9_sl_CHAR') OR (strUtf AND Text.Eq (c, 'm9_sl_UTF8'))
END StrCIs ;

PROCEDURE RehomeFn (RO c: UTF) : UTF =
BEGIN
  IF Text.Eq (c, 'm9_sl_UTF8') THEN RETURN 'm9_rehome_utf' END ;
  RETURN 'm9_rehome'
END RehomeFn ;

(* register a VAR/OWN STR parameter for the exit re-homing *)
PROCEDURE OutReg (RO KEPT nm: UTF ; RO KEPT fn: UTF) =
VAR nb : SLICE OF UTF ;
    k  : I64 ;
BEGIN
  IF nout = LEN (outStr) THEN
    nb := NEW (gpool, UTF, 2 * LEN (outStr)) ;
    FOR k := 0 TO nout - 1 DO nb[k] := outStr[k] END ;
    outStr := nb ;
    nb := NEW (gpool, UTF, 2 * LEN (outFn)) ;
    FOR k := 0 TO nout - 1 DO nb[k] := outFn[k] END ;
    outFn := nb
  END ;
  outStr[nout] := nm ;
  outFn[nout] := fn ;
  nout := nout + 1
END OutReg ;

(* register a VAR/OWN parameter of a pointer-bearing type for the
   exit adoption test (docs/pool-elision-plan.md, rule 1) *)
PROCEDURE AdoptReg (RO KEPT nm: UTF ; KEPT t: Ast.Kid ; RO KEPT dst: UTF) =
VAR nb, nd : SLICE OF UTF ;
    nt : SLICE OF AKid ;
    k  : I64 ;
BEGIN
  IF nadopt = LEN (adoptC) THEN
    nb := NEW (gpool, UTF, 2 * LEN (adoptC)) ;
    nd := NEW (gpool, UTF, 2 * LEN (adoptC)) ;
    nt := NEW (gpool, AKid, 2 * LEN (adoptC)) ;
    FOR k := 0 TO nadopt - 1 DO
      nb[k] := adoptC[k] ;
      nd[k] := adoptD[k] ;
      nt[k] := adoptT[k]
    END ;
    adoptC := nb ;
    adoptD := nd ;
    adoptT := nt
  END ;
  adoptC[nadopt] := nm ;
  adoptD[nadopt] := dst ;
  adoptT[nadopt] := t ;
  nadopt := nadopt + 1
END AdoptReg ;

PROCEDURE SetPrefix (RO module: UTF ; RO prefix: UTF) =
VAR
  nm, nc : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF npfx = LEN (pfxMod) THEN
    nm := NEW (gpool, UTF, 2 * npfx + 4) ;
    nc := NEW (gpool, UTF, 2 * npfx + 4) ;
    FOR i := 0 TO npfx - 1 DO nm[i] := pfxMod[i] ; nc[i] := pfxC[i] END ;
    pfxMod := nm ;
    pfxC := nc
  END ;
  pfxMod[npfx] := UTF (gpool, module) ;
  pfxC[npfx] := UTF (gpool, prefix) ;
  npfx := npfx + 1
END SetPrefix ;

(* a module's C prefix: its name, or what SetPrefix gave it *)
PROCEDURE CP (RO m: UTF) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npfx - 1 DO
    IF Text.Eq (pfxMod[i], m) THEN RETURN pfxC[i] END
  END ;
  RETURN m
END CP ;

PROCEDURE SetDebugSource (RO file: UTF) =
BEGIN
  dbgSrc := UTF (gpool, file)
END SetDebugSource ;

(* One directive per statement, at column 0 and into the procedure
   buffer, so the C compiler attributes the code that follows to the
   M9 line it came from.  Nothing is emitted when dbgSrc is empty
   (the default).                                                   *)
PROCEDURE DbgLine (n: PTR Ast.Node) =
BEGIN
  IF Text.BLen (dbgSrc) = 0 THEN RETURN END ;
  Line (KPbuf, 0, S5 ('#line ', ItoA (n.line), ' "', dbgSrc, '"')) ;
  (* and record the raise site for an unhandled exception's
     message: one store per statement, under -g only, so hot
     production code (no -g) is untouched and its default C the
     same *)
  Line (KPbuf, 1, S3 ('err->line = ', ItoA (n.line), ';'))
END DbgLine ;

(* the byte at offset i of u, as a number: the scanners of C text below
   compare ASCII structure, where a byte IS the character *)
PROCEDURE B (RO u: UTF ; i: I64) : I64 =
BEGIN
  RETURN I64 (Text.BAt (u, i))
END B ;

PROCEDURE StartsW (RO s: UTF ;
                   RO p: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF Text.BLen (s) < Text.BLen (p) THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (p) - 1 DO
    IF B (s, i) # B (p, i) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END StartsW ;

PROCEDURE Has (RO s: UTF ; c: CHAR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) = ORD (c) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Has ;

PROCEDURE FindCh (RO s: UTF ; c: CHAR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) = ORD (c) THEN RETURN i END
  END ;
  RETURN -1
END FindCh ;

(* ---- maps and registries ---- *)

PROCEDURE MInit (VAR m: Map) =
BEGIN
  m.es := NEW (gpool, MEnt, 8) ;
  m.n := 0 ;
  m.ixKey := NEW (gpool, UTF, 16) ;
  m.ixAt := NEW (gpool, I64, 16) ;
  m.ixLast := NEW (gpool, I64, 16) ;
  m.ixOcc := 0
END MInit ;

PROCEDURE MHash (RO s: UTF) : I64 =
VAR i, h : I64 ;
BEGIN
  h := 5381 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO h := h *% 33 +% B (s, i) END ;
  RETURN h
END MHash ;

(* the slot holding key k, or the empty one where it would go *)
PROCEDURE MSlot (VAR m: Map ; RO k: UTF) : I64 =
VAR j, cap : I64 ;
BEGIN
  cap := LEN (m.ixAt) ;
  j := MHash (k) MOD cap ;
  IF j < 0 THEN j := j + cap END ;
  WHILE m.ixAt[j] # 0 AND NOT Text.Eq (m.ixKey[j], k) DO
    j := (j + 1) MOD cap
  END ;
  RETURN j
END MSlot ;

(* the slot's entry, when it is live and still holds k; else -1 *)
PROCEDURE MLive (VAR m: Map ; j: I64 ; RO k: UTF) : I64 =
VAR e : I64 ;
BEGIN
  IF m.ixAt[j] = 0 THEN RETURN -1 END ;
  e := m.ixAt[j] - 1 ;
  IF e < m.n THEN
    IF Text.Eq (m.es[e].k, k) THEN RETURN e END
  END ;
  RETURN -1
END MLive ;

(* the index rebuilt from the live entries, the first of a key kept *)
PROCEDURE MReindex (VAR m: Map ; cap: I64) =
VAR i, j : I64 ;
BEGIN
  m.ixKey := NEW (gpool, UTF, cap) ;
  m.ixAt := NEW (gpool, I64, cap) ;
  m.ixLast := NEW (gpool, I64, cap) ;
  m.ixOcc := 0 ;
  FOR i := 0 TO m.n - 1 DO
    j := MSlot (m, m.es[i].k) ;
    IF m.ixAt[j] = 0 THEN
      m.ixKey[j] := m.es[i].k ;
      m.ixAt[j] := i + 1 ;
      m.ixOcc := m.ixOcc + 1
    END ;
    m.ixLast[j] := i + 1
  END
END MReindex ;

(* the key's latest entry when it is live and still holds k; -1 when
   there is none or it is gone -- a cut-back can leave an earlier live
   entry the index does not know, so -1 means "ask the entries" *)
PROCEDURE MLast (VAR m: Map ; RO k: UTF) : I64 =
VAR j, e : I64 ;
BEGIN
  j := MSlot (m, k) ;
  IF m.ixAt[j] = 0 THEN RETURN -1 END ;
  e := m.ixLast[j] - 1 ;
  IF e >= 0 AND e < m.n THEN
    IF Text.Eq (m.es[e].k, k) THEN RETURN e END
  END ;
  RETURN -1
END MLast ;

PROCEDURE CharVal (RO lit: UTF) : I64 ;
PROCEDURE IsNegLit (e: PTR Ast.Node ; kind: I64) : BOOL ;

(* a CONST built with `+' over string and CHAR literals is FOLDED into
   one literal where it is registered (2026-10-09, cp-kernel's issue
   1: `AtSql = 'SELECT ...' + ' JOIN ...'' passed the checker and the
   emitter said `const form unsupported yet'): 'a' + 'b' + 0AC is the
   literal of those scalars; any other form keeps its node *)
PROCEDURE StrLeaf (k: Ast.Kid ; VAR d: PTR DynUtf.DString) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NString THEN DynUtf.Append (d, e.au) ; RETURN TRUE END ;
    IF e.kind = Ast.NChar THEN DynUtf.AppendChar (d, CHR (CharVal (e.au))) ; RETURN TRUE END ;
    IF e.kind = Ast.NParen THEN RETURN StrLeaf (e.kids[0], d) END ;
    IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') THEN
      IF StrLeaf (e.kids[0], d) THEN RETURN StrLeaf (e.kids[1], d) END
    END
  END ;
  RETURN FALSE
EXCEPT
| ValueRange : RETURN FALSE     (* a CHAR literal that is no scalar: not folded, refused later by name *)
END StrLeaf ;

PROCEDURE FoldStr (k: Ast.Kid) : Ast.Kid =
VAR
  d : PTR DynUtf.DString IN gpool ;
  n, u : PTR Ast.Node IN gpool ;
  iv, nd, i : I64 ;
  ibuf : ARRAY 24 OF CHAR ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') THEN
      d := DynUtf.New (gpool) ;
      IF StrLeaf (k, d) THEN
        n := Ast.NewNode (gpool, Ast.NString, e.line, e.col) ;
        Ast.SetA (gpool, n, DynUtf.ViewIn (gpool, d)) ;
        RETURN SOME (n)
      END
    END ;
    (* an integer CONST over an expression (2 * 3 + 1) is folded to its
       literal with the runtime's arithmetic (Ast.FoldInt); a bare or
       negated literal is left as written, so its C is unchanged *)
    IF e.kind = Ast.NBin OR e.kind = Ast.NParen OR
       (e.kind = Ast.NUn AND NOT IsNegLit (e, Ast.NInt) AND NOT IsNegLit (e, Ast.NReal)) THEN
      IF Ast.FoldInt (k, iv) THEN
        nd := Ast.IntText (iv, ibuf) ;
        IF nd > 0 THEN
          n := Ast.NewNode (gpool, Ast.NInt, e.line, e.col) ;
          (* the digits as a UTF: the same both sides of the switch
             (SetA's UTF twin by type; ibuf is an ARRAY OF CHAR) *)
          Ast.SetA (gpool, n, UTF (SLICE (ibuf, 0, nd))) ;
          IF iv < 0 THEN
            u := Ast.NewNode (gpool, Ast.NUn, e.line, e.col) ;
            Ast.SetA (gpool, u, '-') ;
            Ast.Add (gpool, u, SOME (n)) ;
            RETURN SOME (u)
          END ;
          RETURN SOME (n)
        END
      END
    END
  END ;
  RETURN k
END FoldStr ;

(* a real CONST over an expression of real literals -- ( ) unary - and
   + - * / -- as the C expression of those literals, evaluated by the C
   compiler in double: '' for any other form *)
PROCEDURE RealC (k: Ast.Kid) : UTF =
VAR l, r : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReal THEN RETURN S3 ('(', e.au, ')') END ;
    IF e.nkids < 1 THEN RETURN '' END ;
    IF e.kind = Ast.NParen THEN RETURN RealC (e.kids[0]) END ;
    IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN
      l := RealC (e.kids[0]) ;
      IF Text.BLen (l) = 0 THEN RETURN '' END ;
      RETURN S3 ('(-', l, ')')
    END ;
    IF e.kind = Ast.NBin AND e.nkids = 2 THEN
      IF Text.Eq (e.au, '+') OR Text.Eq (e.au, '-') OR Text.Eq (e.au, '*') OR Text.Eq (e.au, '/') THEN
        l := RealC (e.kids[0]) ;
        r := RealC (e.kids[1]) ;
        IF Text.BLen (l) = 0 OR Text.BLen (r) = 0 THEN RETURN '' END ;
        RETURN S7 ('(', l, ' ', e.au, ' ', r, ')')
      END
    END
  END ;
  RETURN ''
END RealC ;

PROCEDURE MAdd (VAR m: Map ; RO KEPT k: UTF ;
                KEPT v: Ast.Kid ; RO KEPT t: UTF) =
VAR
  nb : SLICE OF MEnt ;
  i, j : I64 ;
BEGIN
  IF m.n = LEN (m.es) THEN
    nb := NEW (gpool, MEnt, 2 * LEN (m.es)) ;
    FOR i := 0 TO m.n - 1 DO nb[i] := m.es[i] END ;
    m.es := nb
  END ;
  m.es[m.n].k := k ;
  m.es[m.n].v := v ;
  m.es[m.n].t := t ;
  m.n := m.n + 1 ;
  IF 2 * (m.ixOcc + 1) > LEN (m.ixAt) THEN
    (* the stale slots go with the rebuild; twice the live entries *)
    i := 16 ;
    WHILE i < 4 * m.n DO i := 2 * i END ;
    MReindex (m, i)
  ELSE
    j := MSlot (m, k) ;
    IF MLive (m, j, k) < 0 THEN
      (* empty, or stale: the key's first live entry is this one *)
      IF m.ixAt[j] = 0 THEN m.ixOcc := m.ixOcc + 1 END ;
      m.ixKey[j] := k ;
      m.ixAt[j] := m.n
    END ;
    m.ixLast[j] := m.n
  END
END MAdd ;

PROCEDURE MFind (VAR m: Map ; RO k: UTF) : I64 =
BEGIN
  RETURN MLive (m, MSlot (m, k), k)
END MFind ;

CONST
  MaxErrs = 8 ;

VAR
  errLines : ARRAY 8 OF I64 ;
  errMsgs  : ARRAY 8 OF UTF ;   (* literals or gpool-composed: both
                                   outlive the report *)
  errMods  : ARRAY 8 OF UTF ;   (* the module whose source the line is
                                   in, '' for the one being emitted *)
  (* which definition a node came from, by its number: a parse numbers
     its nodes in one run (Ast.NewNode), so each registered definition
     is a span of ids, and so are the nodes RegisterExtern makes for it
     (QualArr's copies).  Until 2026-10-29 an error on an imported
     type's node printed the importer's file with the exporter's line
     (`UseShapes.m9:7' for Shapes.m9:7, decision 75's find) *)
  origLo, origHi : SLICE OF I64 ;
  origMod : SLICE OF UTF ;
  norig : I64 ;

PROCEDURE Err2 (line: I64 ; RO msg: UTF) =
  (* the message is copied: callers compose it in their frame *)
BEGIN
  IF nerrV < MaxErrs THEN
    errLines[nerrV] := line ;
    errMsgs[nerrV] := Text.Keep (gpool, msg) ;
    errMods[nerrV] := ''
  END ;
  nerrV := nerrV + 1
END Err2 ;

(* the definition node id was read from, or '' *)
PROCEDURE OriginOf (id: I64) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO norig - 1 DO
    IF id >= origLo[i] AND id <= origHi[i] THEN RETURN origMod[i] END
  END ;
  RETURN ''
END OriginOf ;

PROCEDURE NoteOrigin (lo, hi: I64 ; RO KEPT m: UTF) =
VAR
  nl, nh : SLICE OF I64 ;
  nm : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF hi < lo THEN RETURN END ;
  IF norig = LEN (origLo) THEN
    nl := NEW (gpool, I64, 2 * norig + 8) ;
    nh := NEW (gpool, I64, 2 * norig + 8) ;
    nm := NEW (gpool, UTF, 2 * norig + 8) ;
    FOR i := 0 TO norig - 1 DO
      nl[i] := origLo[i] ; nh[i] := origHi[i] ; nm[i] := origMod[i]
    END ;
    origLo := nl ; origHi := nh ; origMod := nm
  END ;
  origLo[norig] := lo ;
  origHi[norig] := hi ;
  origMod[norig] := m ;
  norig := norig + 1
END NoteOrigin ;

(* the span of ids under a definition's tree *)
PROCEDURE IdSpan (k: Ast.Kid ; VAR lo, hi: I64) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.id < lo THEN lo := n.id END ;
    IF n.id > hi THEN hi := n.id END ;
    FOR i := 0 TO n.nkids - 1 DO IdSpan (n.kids[i], lo, hi) END
  END
END IdSpan ;

(* an error at a node: its line, in the module it was read from *)
PROCEDURE ErrAt (n: PTR Ast.Node ; RO msg: UTF) =
BEGIN
  Err2 (n.line, msg) ;
  IF nerrV - 1 < MaxErrs THEN errMods[nerrV - 1] := OriginOf (n.id) END
END ErrAt ;

PROCEDURE ErrLineAt (i: I64) : I64 =
BEGIN
  IF i < 0 OR i >= MaxErrs THEN RETURN 0 END ;
  RETURN errLines[i]
END ErrLineAt ;

PROCEDURE ErrMsgAt (i: I64) : UTF =
BEGIN
  IF i < 0 OR i >= MaxErrs THEN RETURN '' END ;
  RETURN errMsgs[i]
END ErrMsgAt ;

PROCEDURE ErrModAt (i: I64) : UTF =
BEGIN
  IF i < 0 OR i >= MaxErrs THEN RETURN '' END ;
  RETURN errMods[i]
END ErrModAt ;

PROCEDURE Setup () =
VAR
  ch, sn, ub, un : PTR Ast.Node IN gpool ;
BEGIN
  IF inited THEN RETURN END ;
  inited := TRUE ;
  ch := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
  Ast.SetA (gpool, ch, 'CHAR') ;
  sn := Ast.NewNode (gpool, Ast.NSliceType, 0, 0) ;
  Ast.Add (gpool, sn, SOME (ch)) ;
  strNode := SOME (sn) ;
  (* UTF: SLICE OF <u8>, an element no program can write *)
  ub := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
  Ast.SetA (gpool, ub, '<u8>') ;
  un := Ast.NewNode (gpool, Ast.NSliceType, 0, 0) ;
  Ast.Add (gpool, un, SOME (ub)) ;
  utfNode := SOME (un) ;
  MInit (consts) ;
  MInit (extProcs) ;
  MInit (extTypes) ;
  MInit (extConsts) ;
  MInit (extVars) ;
  MInit (extMods) ;
  MInit (extExcs) ;
  MInit (foreignProcs) ;
  MInit (bpool) ;
  MInit (arrSeen) ;
  MInit (thrSeen) ;
  MInit (gateSeen) ;
  MInit (aggT) ;
  MInit (aggV) ;
  MInit (scope) ;
  gps := NEW (gpool, GP, 8) ;
  MInit (gpIx) ;
  MInit (lowered) ;
  MInit (tyBody) ;
  MInit (tyOpq) ;
  MInit (fieldIx) ;
  MInit (fieldDone) ;
  tys := NEW (gpool, TY, 8) ;
  xcs := NEW (gpool, XC, 8) ;
  mvN := NEW (gpool, UTF, 8) ;
  mvT := NEW (gpool, AKid, 8) ;
  mvDef := NEW (gpool, BOOL, 8) ;
  lpools := NEW (gpool, UTF, 8) ;
  outStr := NEW (gpool, UTF, 8) ;
  outFn := NEW (gpool, UTF, 8) ;
  adoptC := NEW (gpool, UTF, 8) ;
  adoptT := NEW (gpool, AKid, 8) ;
  adoptD := NEW (gpool, UTF, 8) ;
  bHdr := DynUtf.New (gpool) ;
  bSrc := DynUtf.New (gpool) ;
  bTdefs := DynUtf.New (gpool) ;
  bPbuf := DynUtf.New (gpool) ;
  bSprotos := DynUtf.New (gpool) ;
  bLit := DynUtf.New (gpool) ;
  bHdrRecs := DynUtf.New (gpool) ;
  bHdrProtos := DynUtf.New (gpool) ;
  bHdrConsts := DynUtf.New (gpool) ;
  bRec2 := DynUtf.New (gpool) ;
  bArrRec := DynUtf.New (gpool) ;
  bHdrArrRec := DynUtf.New (gpool) ;
  bRec3 := DynUtf.New (gpool) ;
  bThr := DynUtf.New (gpool) ;
  bGate := DynUtf.New (gpool)
END Setup ;

PROCEDURE Line (buf: I64 ; ind: I64 ; RO s: UTF) =
VAR
  scratch : POOL ;                (* the builder dies with the call *)
  d : PTR DynUtf.DString IN scratch ;
  i : I64 ;
  t : UTF ;
BEGIN
  d := DynUtf.New (scratch) ;
  FOR i := 1 TO ind * 2 DO DynUtf.AppendChar (d, ' ') END ;
  DynUtf.Append (d, s) ;
  DynUtf.AppendChar (d, 0AC) ;
  t := DynUtf.View (d) ;
  CASE buf OF
  | KHdr : DynUtf.Append (bHdr, t)
  | KSrc : DynUtf.Append (bSrc, t)
  | KTdefs :
      DynUtf.Append (bTdefs, t) ;
      tdefN := tdefN + 1
  | KPbuf : DynUtf.Append (bPbuf, t)
  | KSprotos :
      DynUtf.Append (bSprotos, t) ;
      sprotoN := sprotoN + 1
  | KLit :
      DynUtf.Append (bLit, t) ;
      litN := litN + 1
  | KHdrRecs : DynUtf.Append (bHdrRecs, t)
  | KHdrProtos : DynUtf.Append (bHdrProtos, t)
  | KHdrConsts :
      DynUtf.Append (bHdrConsts, t) ;
      hdrConstN := hdrConstN + 1
  | KRec2 : DynUtf.Append (bRec2, t)
  | KArrRec : DynUtf.Append (bArrRec, t)
  | KHdrArrRec : DynUtf.Append (bHdrArrRec, t)
  | KRec3 : DynUtf.Append (bRec3, t)
  | KThr : DynUtf.Append (bThr, t)
  | KGate : DynUtf.Append (bGate, t)
  ELSE
    Err2 (0, 'internal: unknown output bucket')
  END
END Line ;

PROCEDURE NewTmp () : UTF =
BEGIN
  tmpN := tmpN + 1 ;
  RETURN S2 ('m9t', ItoA (tmpN))
END NewTmp ;

(* ---- name and type tables ---- *)

(* Four lists of names, each a constant table (report par 2.2.4) and
   a search.  Until 2026-10-01 each was a chain of `Text.Eq (n,
   'a') OR Text.Eq (n, 'b') OR ...`, the longest 96 terms: the same
   list, with the names buried in the code that compared them. *)
CONST
  Builtins = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'F32', 'F64',
    'BYTE', 'BOOL', 'CHAR'
  ] ;
  BuiltinCalls = [
    'ADR', 'ByteSize', 'CHR', 'COPY', 'LEN', 'MAX', 'NAME', 'OCTETS', 'ORD',
    'SizeOf', 'STR', 'UTF', 'VIEW'
  ] ;
  (* the conversions that narrow, each with its own checked helper *)
  WidthConvs = ['I8', 'I16', 'I32', 'U8', 'U16', 'U32', 'U64'] ;
  (* the argument tags C.Int and C.SizeT check (Sem.CTotal's
     complement over the integer tags) *)
  CIntChecked = ['I64', 'U32', 'U64'] ;
  CSizeChecked = ['I8', 'I16', 'I32', 'I64'] ;
  (* the integer types besides I64 a CASE may switch over *)
  CaseInts = ['I8', 'I16', 'I32', 'U8', 'U16', 'U32', 'U64', 'BYTE'] ;
  (* C's integer types a result or local may be declared with *)
  CIntNames = ['int8_t', 'int16_t', 'int32_t', 'int64_t', 'uint8_t',
               'uint16_t', 'uint32_t', 'uint64_t', 'size_t', 'ssize_t'] ;
  (* the builtin types, which are their own canonical type and tag *)
  CanonBuiltins = ['I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64',
                   'F32', 'F64', 'BYTE', 'BOOL', 'CHAR'] ;

  (* libm functions a FOR-C unit may bind (C99 math.h, double + float):
     a LOCAL named like one shadows the extern -- `float cosf;` beside
     `extern float cosf (float);` makes a call to cosf resolve to the
     variable.  Escaped like the C keywords in CN.  No corpus identifier
     matches one; float-heavy modules with their own math bindings are
     the beneficiaries. *)
  LibM = [
    'acos', 'acosf', 'acosh', 'acoshf', 'asin', 'asinf', 'asinh', 'asinhf',
    'atan', 'atanf', 'atan2', 'atan2f', 'atanh', 'atanhf', 'cbrt', 'cbrtf',
    'ceil', 'ceilf', 'copysign', 'copysignf', 'cos', 'cosf', 'cosh', 'coshf',
    'erf', 'erff', 'erfc', 'erfcf', 'exp', 'expf', 'exp2', 'exp2f', 'expm1',
    'expm1f', 'fabs', 'fabsf', 'fdim', 'fdimf', 'floor', 'floorf', 'fma',
    'fmaf', 'fmax', 'fmaxf', 'fmin', 'fminf', 'fmod', 'fmodf', 'frexp',
    'frexpf', 'hypot', 'hypotf', 'ldexp', 'ldexpf', 'lgamma', 'lgammaf',
    'log', 'logf', 'log10', 'log10f', 'log1p', 'log1pf', 'log2', 'log2f',
    'modf', 'modff', 'nan', 'nanf', 'nearbyint', 'nearbyintf', 'nextafter',
    'nextafterf', 'pow', 'powf', 'remainder', 'remainderf', 'rint', 'rintf',
    'round', 'roundf', 'scalbn', 'scalbnf', 'sin', 'sinf', 'sinh', 'sinhf',
    'sqrt', 'sqrtf', 'tan', 'tanf', 'tanh', 'tanhf', 'tgamma', 'tgammaf',
    'trunc', 'truncf',
    (* POSIX's Bessel functions, in glibc's and macOS's math.h: a
       module variable named y0 was `redeclared as different kind of
       symbol' (m9curve's Basemap.m9, 2026-10-08) *)
    'j0', 'j1', 'jn', 'y0', 'y1', 'yn'
  ] ;

  (* what CN escapes besides: the C keywords, the three stdbool names,
     `err` (the state parameter of every generated procedure) and
     `main` -- not a keyword but reserved at file scope in a hosted
     environment: the gm2 collision in the ledger, met again by M9's
     own compiler *)
  CWords = [
    'signed', 'unsigned', 'int', 'char', 'long', 'short', 'float',
    'double', 'void', 'return', 'if', 'else', 'while', 'for', 'do',
    'switch', 'case', 'default', 'break', 'continue', 'goto', 'struct',
    'union', 'enum', 'typedef', 'static', 'extern', 'const', 'volatile',
    'register', 'auto', 'sizeof', 'inline', 'restrict', 'bool', 'true',
    'false', 'err', 'main'
  ] ;

PROCEDURE IsBuiltin (RO n: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (n), Builtins)
END IsBuiltin ;

(* a call CallC answers by name, not through a head: a conversion or
   one of these; none keeps an argument (SinkAlloc) *)
PROCEDURE IsBuiltinCall (RO n: UTF) : BOOL =
BEGIN
  RETURN IsBuiltin (n) OR Text.OneOf (STR (n), BuiltinCalls)
END IsBuiltinCall ;

PROCEDURE IsLibM (RO n: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (n), LibM)
END IsLibM ;

(* Mod.v as the C name Mod_v, in the generator's pool: CN's answers
   are kept *)
PROCEDURE Undot (RO n: UTF) : UTF =
VAR i : I64 ;
BEGIN
  i := Text.FindChar (n, '.') ;
  RETURN S3 (CP (SLICE (n, 0, i)), '_', SLICE (n, i + 1, Text.BLen (n) - i - 1))
END Undot ;

PROCEDURE CN (RO n: UTF) : UTF =
BEGIN
  (* an imported variable is in scope as Mod.v (decision 28); its C
     name is the pointer the exporter defines, Mod_v *)
  IF Text.FindChar (n, '.') >= 0 THEN RETURN Undot (n) END ;
  IF Text.OneOf (STR (n), CWords) THEN RETURN S2 (n, '_') END ;
  IF IsLibM (n) THEN RETURN S2 (n, '_') END ;
  RETURN n
END CN ;

PROCEDURE CMap (RO n: UTF) : UTF =
BEGIN
  IF Text.Eq (n, 'Int') THEN RETURN 'int' END ;
  IF Text.Eq (n, 'SizeT') THEN RETURN 'size_t' END ;
  IF Text.Eq (n, 'SSizeT') THEN RETURN 'int64_t' END ;
  IF Text.Eq (n, 'ConstPtr') THEN RETURN 'const void *' END ;
  IF Text.Eq (n, 'MutPtr') THEN RETURN 'void *' END ;
  IF Text.Eq (n, 'Double') THEN RETURN 'double' END ;
  IF Text.Eq (n, 'Float') THEN RETURN 'float' END ;
  IF Text.Eq (n, 'LongDouble') THEN RETURN 'long double' END ;
  RETURN ''
END CMap ;

PROCEDURE BuiltinC (RO n: UTF) : UTF =
BEGIN
  IF Text.Eq (n, 'I8') THEN RETURN 'int8_t' END ;
  IF Text.Eq (n, 'I16') THEN RETURN 'int16_t' END ;
  IF Text.Eq (n, 'I32') THEN RETURN 'int32_t' END ;
  IF Text.Eq (n, 'I64') THEN RETURN 'int64_t' END ;
  IF Text.Eq (n, 'U8') THEN RETURN 'uint8_t' END ;
  IF Text.Eq (n, 'U16') THEN RETURN 'uint16_t' END ;
  IF Text.Eq (n, 'U32') THEN RETURN 'uint32_t' END ;
  IF Text.Eq (n, 'U64') THEN RETURN 'uint64_t' END ;
  IF Text.Eq (n, 'F32') THEN RETURN 'float' END ;
  IF Text.Eq (n, 'F64') THEN RETURN 'double' END ;
  IF Text.Eq (n, 'BYTE') THEN RETURN 'uint8_t' END ;
  IF Text.Eq (n, 'BOOL') THEN RETURN 'bool' END ;
  IF Text.Eq (n, 'CHAR') THEN RETURN 'uint32_t' END ;
  RETURN ''
END BuiltinC ;

PROCEDURE FindTypeN (RO n: UTF) : Ast.Kid =
VAR j : I64 ;
BEGIN
  (* the first entry of n with a body (tyBody, filled beside tys) *)
  j := MFind (tyBody, n) ;
  IF j < 0 THEN RETURN NONE END ;
  RETURN tyBody.es[j].v
END FindTypeN ;

PROCEDURE IsOpaque (RO n: UTF) : BOOL =
BEGIN
  (* some entry of n is opaque (tyOpq, filled beside tys) *)
  RETURN MFind (tyOpq, n) >= 0
END IsOpaque ;

PROCEDURE FindProcN (RO n: UTF) : I64 =
BEGIN
  (* gpIx's entries are gps's, one each and in order *)
  RETURN MFind (gpIx, n)
END FindProcN ;

PROCEDURE ExtBare (RO nm: UTF) : I64 =
VAR
  i, kl : I64 ;
BEGIN
  FOR i := 0 TO extTypes.n - 1 DO
    kl := Text.BLen (extTypes.es[i].k) ;
    IF kl > Text.BLen (nm) THEN
      IF B (extTypes.es[i].k, kl - Text.BLen (nm) - 1) = ORD ('.') THEN
        IF Text.Eq (SLICE (extTypes.es[i].k, kl - Text.BLen (nm), Text.BLen (nm)),
                      nm) THEN
          RETURN i
        END
      END
    END
  END ;
  RETURN -1
END ExtBare ;

PROCEDURE IsPtrK (k: I64) : BOOL =
BEGIN
  RETURN k = Ast.NPtrType OR k = Ast.NSharedType
END IsPtrK ;

PROCEDURE IsRecK (k: I64) : BOOL =
BEGIN
  RETURN k = Ast.NRecordType OR k = Ast.NCaseRecordType OR
         k = Ast.NEnumType OR
         k = Ast.NMonitorType
END IsRecK ;

PROCEDURE Resolve (t: Ast.Kid) : Ast.Kid =
VAR
  cur : Ast.Kid ;
  depth, ei : I64 ;
BEGIN
  cur := t ;
  depth := 0 ;
  LOOP
    (* STR expands to the slice it abbreviates (par 2.2), so nothing
       downstream needs a case for it -- at every step of the chain,
       not only its start: `TYPE Name = STR' followed to STR met the
       name where a subscript wanted the slice (genforms GfStrAlias,
       2026-10-24) *)
    IF cur IS SOME c0 THEN
      IF c0.kind = Ast.NQualident AND Text.BLen (c0.bu) = 0 AND
         Text.Eq (c0.au, 'STR') THEN
        IF strUtf THEN cur := utfNode ELSE cur := strNode END
      ELSIF c0.kind = Ast.NQualident AND Text.BLen (c0.bu) = 0 AND
         Text.Eq (c0.au, 'UTF') THEN
        cur := utfNode
      END
    END ;
    IF cur IS SOME n THEN
      IF n.kind # Ast.NQualident THEN RETURN cur END ;
      (* C.Int and the like, the foreign boundary's types: always with
         a member.  A bare C is a program's type -- `TYPE C = A' was
         left unresolved, and `c[k]' was `index into a non-array
         unsupported yet' until 2026-10-29 (report M7) *)
      IF IsBuiltin (n.au) OR Text.Eq (n.au, 'POOL') OR
         (Text.Eq (n.au, 'C') AND Text.BLen (n.bu) > 0) THEN
        RETURN cur
      END ;
      IF depth >= 8 THEN RETURN cur END ;
      IF Text.BLen (n.bu) > 0 THEN
        ei := MFind (extTypes, S3 (n.au, '.', n.bu)) ;
        IF ei < 0 THEN RETURN cur END ;
        cur := extTypes.es[ei].v
      ELSE
        IF FindTypeN (n.au) IS SOME nx THEN
          cur := SOME (nx)
        ELSE
          ei := ExtBare (n.au) ;
          IF ei < 0 THEN RETURN NONE END ;
          cur := extTypes.es[ei].v
        END
      END ;
      depth := depth + 1
    ELSE
      RETURN NONE
    END
  END
END Resolve ;

(* the enumeration or case-record type node an ARRAY bound names, or
   NONE when the bound is an integer.  ARRAY Colour OF T is indexed by
   the type: its length is the variant count and its subscript is a
   member, not an ordinal (docs/enum-plan.md, part 2). *)
PROCEDURE ArrEnumBoundNode (b: Ast.Kid) : Ast.Kid =
VAR ci : I64 ;
BEGIN
  IF b IS SOME bn THEN
    IF bn.kind = Ast.NDesignator THEN
      IF bn.nkids = 0 THEN
        IF FindTypeN (bn.au) IS SOME t THEN
          IF t.kind = Ast.NEnumType OR t.kind = Ast.NCaseRecordType THEN
            RETURN SOME (t)
          END
        END
      ELSIF bn.nkids = 1 THEN
        IF bn.kids[0] IS SOME sf THEN
          IF sf.kind = Ast.NSelField THEN
            ci := MFind (extTypes, S3 (bn.au, '.', sf.au)) ;
            IF ci >= 0 THEN
              IF extTypes.es[ci].v IS SOME xt THEN
                IF xt.kind = Ast.NEnumType OR xt.kind = Ast.NCaseRecordType THEN
                  RETURN SOME (xt)
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ArrEnumBoundNode ;

(* the value of an integer constant expression whose names are CONSTs
   -- Ast.FoldInt's literals, parentheses, unary minus and + - * DIV
   MOD, and a name followed to its value: bare, in module m ('' this
   one), or Mod.N, whose value's bare names are Mod's.  Until
   2026-10-29 an array bound folded literals only, so ARRAY 2 * N OF T
   was `array count form unsupported' even in the module declaring N *)
PROCEDURE FoldIn (k: Ast.Kid ; RO KEPT m: UTF ; depth: I64 ; VAR v: I64) : BOOL =
VAR
  a, b, ci : I64 ;
BEGIN
  IF depth > 16 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NInt THEN RETURN Ast.FoldInt (k, v) END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      IF Text.BLen (m) = 0 THEN
        ci := MFind (consts, e.au) ;
        IF ci >= 0 THEN RETURN FoldIn (consts.es[ci].v, m, depth + 1, v) END
      ELSE
        ci := MFind (extConsts, S3 (m, '.', e.au)) ;
        IF ci >= 0 THEN RETURN FoldIn (extConsts.es[ci].v, m, depth + 1, v) END
      END ;
      RETURN FALSE
    END ;
    IF e.nkids < 1 THEN RETURN FALSE END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 1 THEN
      IF e.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          ci := MFind (extConsts, S3 (e.au, '.', sf.au)) ;
          IF ci >= 0 THEN
            RETURN FoldIn (extConsts.es[ci].v, Text.Keep (gpool, e.au), depth + 1, v)
          END
        END
      END ;
      RETURN FALSE
    END ;
    IF e.kind = Ast.NParen THEN RETURN FoldIn (e.kids[0], m, depth + 1, v) END ;
    IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN
      IF NOT FoldIn (e.kids[0], m, depth + 1, a) THEN RETURN FALSE END ;
      v := 0 - a ;
      RETURN TRUE
    END ;
    IF e.kind = Ast.NBin AND e.nkids = 2 THEN
      IF NOT FoldIn (e.kids[0], m, depth + 1, a) THEN RETURN FALSE END ;
      IF NOT FoldIn (e.kids[1], m, depth + 1, b) THEN RETURN FALSE END ;
      IF Text.Eq (e.au, '+') THEN v := a + b ; RETURN TRUE END ;
      IF Text.Eq (e.au, '-') THEN v := a - b ; RETURN TRUE END ;
      IF Text.Eq (e.au, '*') THEN v := a * b ; RETURN TRUE END ;
      IF Text.Eq (e.au, 'DIV') OR Text.Eq (e.au, 'MOD') THEN
        IF b = 0 THEN RETURN FALSE END ;
        IF b = -1 AND a = -9223372036854775807 - 1 THEN RETURN FALSE END ;
        IF Text.Eq (e.au, 'DIV') THEN v := a DIV b ELSE v := a MOD b END ;
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
EXCEPT
| Overflow : RETURN FALSE
END FoldIn ;

PROCEDURE ArrCount (e: PTR Ast.Node) : UTF =
VAR
  ci, v : I64 ;
  ch : BOOL ;
  src : Ast.Kid ;
BEGIN
  IF e.kind = Ast.NInt THEN RETURN e.au END ;
  (* ARRAY Colour OF T: the count is the number of members *)
  IF ArrEnumBoundNode (SOME (e)) IS SOME et THEN RETURN ItoA (et.nkids) END ;
  IF e.kind = Ast.NDesignator THEN
    IF e.nkids = 0 THEN
      ci := MFind (consts, e.au) ;
      IF ci >= 0 THEN
        IF consts.es[ci].v IS SOME cv THEN
          IF cv.kind = Ast.NInt THEN RETURN cv.au END
        END
      END
    END ;
    (* ARRAY Mod.N OF T: an imported CONST, from the extern table --
       refused as `form unsupported' until 2026-10-08 *)
    IF e.nkids = 1 THEN
      IF e.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          ci := MFind (extConsts, S3 (e.au, '.', sf.au)) ;
          IF ci >= 0 THEN
            IF extConsts.es[ci].v IS SOME xv THEN
              IF xv.kind = Ast.NInt THEN RETURN xv.au END
            END
          END
        END
      END
    END
  END ;
  (* any other constant: an imported CONST folded from an expression,
     an expression of literals *)
  src := SOME (e) ;
  IF ConstValue (SOME (e)) IS SOME cv2 THEN src := ConstValue (SOME (e)) END ;
  IF Ast.ScalarConst (src, v, ch) THEN
    IF NOT ch AND v > 0 THEN RETURN ItoA (v) END
  END ;
  (* an expression over CONST names: ARRAY 2 * N OF T, ARRAY Mod.N +
     1 OF T, a CONST whose value is one *)
  IF FoldIn (SOME (e), '', 0, v) THEN
    IF v > 0 THEN RETURN ItoA (v) END
  END ;
  ErrAt (e, 'array count form unsupported yet') ;
  RETURN '0'
END ArrCount ;

PROCEDURE ArrCount2 (k: Ast.Kid) : UTF =
BEGIN
  IF k IS SOME e THEN RETURN ArrCount (e) END ;
  Err2 (0, 'array count missing') ;
  RETURN '0'
END ArrCount2 ;

PROCEDURE ConstValue (k: Ast.Kid) : Ast.Kid =
VAR ci : I64 ;
BEGIN
  (* the value node of a designator naming a CONST, or NONE.  Both
     spellings: a bare name in this module, and Mod.Name imported. *)
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF e.nkids = 0 THEN
        ci := MFind (consts, e.au) ;
        IF ci >= 0 THEN RETURN consts.es[ci].v END ;
        RETURN NONE
      END ;
      IF e.nkids = 1 THEN
        IF e.kids[0] IS SOME sf THEN
          IF sf.kind = Ast.NSelField THEN
            ci := MFind (extConsts, S3 (e.au, '.', sf.au)) ;
            IF ci >= 0 THEN RETURN extConsts.es[ci].v END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ConstValue ;

(* a constant where C needs one -- a CASE label, an array bound --
   through the one evaluator, Ast.ScalarConst, after a CONST's name is
   followed to its value (this module's or an imported one's: an
   imported CONST is registered unfolded, so `Mod.N' with N = 4 * 4 is
   folded here).  '' when it is not a constant (the typed tree's stage
   2, 2026-10-09; until then a negative, an expression, a range, a CHAR
   or string CONST and an imported folded CONST were all `form
   unsupported') *)
PROCEDURE ScalarC (k: Ast.Kid) : UTF =
VAR
  src : Ast.Kid ;
  v : I64 ;
  ch : BOOL ;
BEGIN
  src := k ;
  IF ConstValue (k) IS SOME cv THEN src := ConstValue (k) END ;
  IF NOT Ast.ScalarConst (src, v, ch) THEN RETURN '' END ;
  IF ch THEN RETURN S2 (ItoA (v), 'u') END ;
  IF v = -9223372036854775807 - 1 THEN
    RETURN '(-INT64_C(9223372036854775807) - 1)'
  END ;
  RETURN S3 ('INT64_C(', ItoA (v), ')')
END ScalarC ;

(* MAX of a builtin type, as C *)
PROCEDURE MaxC (RO t: UTF) : UTF =
BEGIN
  IF Text.Eq (t, 'I64') THEN RETURN 'INT64_MAX' END ;
  IF Text.Eq (t, 'I32') THEN RETURN 'INT32_MAX' END ;
  IF Text.Eq (t, 'I16') THEN RETURN 'INT16_MAX' END ;
  IF Text.Eq (t, 'I8') THEN RETURN 'INT8_MAX' END ;
  IF Text.Eq (t, 'U64') THEN RETURN 'UINT64_MAX' END ;
  IF Text.Eq (t, 'U32') THEN RETURN 'UINT32_MAX' END ;
  IF Text.Eq (t, 'U16') THEN RETURN 'UINT16_MAX' END ;
  IF Text.Eq (t, 'U8') OR Text.Eq (t, 'BYTE') THEN RETURN 'UINT8_MAX' END ;
  IF Text.Eq (t, 'F64') THEN RETURN '1.7976931348623157e308' END ;
  IF Text.Eq (t, 'F32') THEN RETURN '3.40282347e38f' END ;
  IF Text.Eq (t, 'CHAR') THEN RETURN '1114111u' END ;
  IF Text.Eq (t, 'BOOL') THEN RETURN 'true' END ;
  RETURN ''
END MaxC ;

(* a FOR step's value as C text, signed, '' when it is no constant *)
PROCEDURE StepC (k: Ast.Kid) : UTF =
VAR
  src : Ast.Kid ;
  v : I64 ;
  ch : BOOL ;
BEGIN
  src := k ;
  IF ConstValue (k) IS SOME cv THEN src := ConstValue (k) END ;
  IF NOT Ast.ScalarConst (src, v, ch) THEN RETURN '' END ;
  IF ch OR v = 0 THEN RETURN '' END ;
  RETURN ItoA (v)
END StepC ;

PROCEDURE IsAdaptive (k: Ast.Kid) : BOOL =
BEGIN
  (* ADAPTIVE: carries no width of its own, so it takes the other
     operand's.  A real or integer literal, arithmetic over such, and
     a CONST whose value is one -- M9's CONST is an untyped literal,
     not a typed constant, which is the whole reason `Satfwb * p` is
     legal at either width. *)
  IF k IS SOME e THEN
    IF e.kind = Ast.NReal OR e.kind = Ast.NInt THEN RETURN TRUE END ;
    IF e.kind = Ast.NParen THEN RETURN IsAdaptive (e.kids[0]) END ;
    IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN
      RETURN IsAdaptive (e.kids[0])
    END ;
    IF e.kind = Ast.NBin THEN
      IF Text.Eq (e.au, '+') OR Text.Eq (e.au, '-') OR
         Text.Eq (e.au, '*') OR Text.Eq (e.au, '/') THEN
        IF IsAdaptive (e.kids[0]) THEN RETURN IsAdaptive (e.kids[1]) END ;
        RETURN FALSE
      END ;
      RETURN FALSE
    END ;
    IF ConstValue (k) IS SOME cv THEN RETURN IsAdaptive (SOME (cv)) END
  END ;
  RETURN FALSE
END IsAdaptive ;

(* an expression under any parentheses, as Sem.ParenCore reads it *)
PROCEDURE ParenCore (k: Ast.Kid) : Ast.Kid =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen THEN RETURN ParenCore (e.kids[0]) END
  END ;
  RETURN k
END ParenCore ;

PROCEDURE IsNegLit (e: PTR Ast.Node ; kind: I64) : BOOL =
BEGIN
  IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN
    IF e.kids[0] IS SOME lit THEN RETURN lit.kind = kind END
  END ;
  RETURN FALSE
END IsNegLit ;

PROCEDURE NegLitText (e: PTR Ast.Node) : UTF =
BEGIN
  IF e.kids[0] IS SOME lit THEN RETURN lit.au END ;
  RETURN '0'
END NegLitText ;

PROCEDURE SliceTy (elem: Ast.Kid) : UTF ;
PROCEDURE CopyArg (a: Ast.Kid ; RO w: UTF) : UTF ;
PROCEDURE TagOfType (t: Ast.Kid) : UTF ;

(* where an ARRAY OF elem's typedef goes: after the struct of a record
   of this module -- its C file for a private one, its header for a
   transparent one (KArrRec, KHdrArrRec) -- and with the other
   typedefs otherwise.  A nested array follows its innermost element. *)
PROCEDURE ArrBucket (elem: Ast.Kid) : I64 =
VAR i : I64 ;
BEGIN
  IF elem IS SOME e THEN
    IF e.kind = Ast.NArrayType THEN RETURN ArrBucket (e.kids[1]) END ;
    IF e.kind = Ast.NQualident AND Text.BLen (e.bu) = 0 THEN
      FOR i := 0 TO ntys - 1 DO
        IF Text.Eq (tys[i].name, e.au) THEN
          IF tys[i].node IS SOME d THEN
            IF d.kind = Ast.NRecordType OR d.kind = Ast.NMonitorType THEN
              IF tys[i].fdef AND NOT IsOpaque (tys[i].name) THEN
                RETURN KHdrArrRec
              END ;
              RETURN KArrRec
            END
          END
        END
      END
    END
  END ;
  RETURN KTdefs
END ArrBucket ;

PROCEDURE TyC (t: Ast.Kid) : UTF =
VAR
  s, nm, ec2 : UTF ;
  ei, ai : I64 ;
  da : PTR DynUtf.DString IN gpool ;
BEGIN
  IF t IS SOME n THEN
    CASE n.kind OF
    | Ast.NQualident :
        IF Text.BLen (n.bu) > 0 THEN
          IF Text.Eq (n.au, 'C') THEN
            s := CMap (n.bu) ;
            IF Text.BLen (s) = 0 THEN
              ErrAt (n, S2 ('unknown C type: C.', n.bu))
            END ;
            RETURN s
          END ;
          ei := MFind (extTypes, S3 (n.au, '.', n.bu)) ;
          IF ei >= 0 THEN
            IF extTypes.es[ei].v IS SOME r2 THEN
              IF IsRecK (r2.kind) OR r2.kind = Ast.NProcType THEN
                RETURN S3 (CP (n.au), '_', n.bu)
              END ;
              RETURN TyC (extTypes.es[ei].v)
            END
          END ;
          IF MFind (extMods, n.au) >= 0 THEN
            RETURN S3 (CP (n.au), '_', n.bu)
          END ;
          ErrAt (n, S2 ('unknown name: ', S3 (n.au, '.', n.bu))) ;
          RETURN 'void'
        END ;
        IF Text.Eq (n.au, 'POOL') THEN RETURN 'm9_pool' END ;
        IF Text.Eq (n.au, 'STR') THEN
          IF strUtf THEN RETURN 'm9_sl_UTF8' END ;
          IF strNode IS SOME sn THEN RETURN SliceTy (sn.kids[0]) END
        END ;
        IF Text.Eq (n.au, 'UTF') THEN RETURN 'm9_sl_UTF8' END ;
        IF Text.Eq (n.au, '<u8>') THEN RETURN 'uint8_t' END ;
        s := BuiltinC (n.au) ;
        IF Text.BLen (s) > 0 THEN RETURN s END ;
        IF FindTypeN (n.au) IS SOME r3 THEN
          (* a procedure type is a NAMED C typedef like a record's,
             emitted into the header beside the slice typedefs
             (par 2.2.3) *)
          IF IsRecK (r3.kind) OR r3.kind = Ast.NProcType THEN
            RETURN S3 (CP (modName), '_', n.au)
          END ;
          RETURN TyC (SOME (r3))
        END ;
        ei := ExtBare (n.au) ;
        IF ei >= 0 THEN
          IF extTypes.es[ei].v IS SOME r4 THEN
            IF IsRecK (r4.kind) OR r4.kind = Ast.NProcType THEN
              RETURN S3 (CP (SLICE (extTypes.es[ei].k, 0,
                Text.BLen (extTypes.es[ei].k) - Text.BLen (n.au) - 1)), '_', n.au)
            END ;
            RETURN TyC (extTypes.es[ei].v)
          END
        END ;
        RETURN S3 (CP (modName), '_', n.au)
    | Ast.NPtrType :
        RETURN S2 (TyC (n.kids[0]), ' *')
    | Ast.NSharedType :
        RETURN S2 (TyC (n.kids[0]), ' *')
    | Ast.NOptType :
        IF Resolve (n.kids[0]) IS SOME r5 THEN
          (* a procedure value is pointer-shaped too: NONE is NULL *)
          IF IsPtrK (r5.kind) OR r5.kind = Ast.NProcType THEN
            RETURN TyC (n.kids[0])
          END
        END ;
        ErrAt (n, 'dereference of a non-pointer unsupported yet') ;
        RETURN 'void'
    | Ast.NSliceType :
        RETURN SliceTy (n.kids[0])
    | Ast.NGridType :
        IF n.kids[0] IS SOME rk THEN
          RETURN GridTy (n.kids[1], ArrCount (rk))
        END ;
        RETURN 'void'
    | Ast.NArrayType :
        IF n.kids[0] IS SOME cnt THEN
          (* the element's own typedefs first (idempotent), and the
             NAME derives from the element's C type the way SliceTy's
             does: TagOfType collapsed every nested array to ARR and
             every record to REC, so two same-length arrays of
             different element types shared one typedef and the
             second field was silently laid out as the first --
             found by ASan under the proxy's session registry *)
          ec2 := TyC (n.kids[1]) ;
          da := DynUtf.New (gpool) ;
          DynUtf.Append (da, 'm9_arr_') ;
          DynUtf.Append (da, ArrCount (cnt)) ;
          DynUtf.AppendChar (da, '_') ;
          FOR ai := 0 TO Text.BLen (ec2) - 1 DO
            IF B (ec2, ai) = ORD ('*') THEN
              DynUtf.AppendChar (da, 'p')
            ELSIF B (ec2, ai) # 32 THEN
              DynUtf.Append (da, SLICE (ec2, ai, 1))
            END
          END ;
          s := DynUtf.ViewIn (gpool, da) ;
          IF MFind (arrSeen, s) < 0 THEN
            MAdd (arrSeen, s, NONE, '') ;
            (* each typedef defines a fresh anonymous struct, so two
               modules emitting the same name are conflicting types,
               not a legal C11 redefinition: guard every one *)
            ai := ArrBucket (n.kids[1]) ;
            IF arrInto # 0 AND (ai = KArrRec OR ai = KHdrArrRec) THEN
              ai := arrInto
            END ;
            Line (ai, 0, S2 ('#ifndef M9SL_', s)) ;
            Line (ai, 0, S2 ('#define M9SL_', s)) ;
            Line (ai, 0, S7 ('typedef struct { ', ec2,
              ' v[', ArrCount (cnt), ']; } ', s, ';')) ;
            Line (ai, 0, '#endif')
          END ;
          RETURN s
        END ;
        RETURN 'void'
    ELSE
      ErrAt (n, 'type kind unsupported yet') ;
      RETURN 'void'
    END
  END ;
  RETURN 'void'
END TyC ;

(* one argument of COPY, as declarations: m9c<w>p its first element,
   m9c<w>n its count; a slice's descriptor or an array's address taken
   once *)
PROCEDURE CopyArg (a: Ast.Kid ; RO w: UTF) : UTF =
VAR
  e, v : UTF ;
  d : PTR DynUtf.DString IN gpool ;
BEGIN
  e := EX (a, '') ;
  v := S2 ('m9c', w) ;
  d := DynUtf.New (gpool) ;
  IF Text.Eq (TagOfExpr (a), 'ARR') THEN
    (* __typeof__ (X) *m9cda = &(X); __typeof__ (&m9cda->v[0]) m9cdp =
       m9cda->v; int64_t m9cdn = sizeof m9cda->v / sizeof m9cda->v[0]; *)
    DynUtf.Append (d, S5 ('__typeof__ (', e, ') *', v, 'a = &(')) ;
    DynUtf.Append (d, S2 (e, '); ')) ;
    DynUtf.Append (d, S5 ('__typeof__ (&', v, 'a->v[0]) ', v, 'p = ')) ;
    DynUtf.Append (d, S2 (v, 'a->v; ')) ;
    DynUtf.Append (d, S5 ('int64_t ', v, 'n = (int64_t) (sizeof (', v, 'a->v) / sizeof (')) ;
    DynUtf.Append (d, S2 (v, 'a->v[0])); '))
  ELSE
    (* __typeof__ (X) m9cdq = (X); __typeof__ (m9cdq.p) m9cdp = m9cdq.p;
       int64_t m9cdn = m9cdq.len; *)
    DynUtf.Append (d, S5 ('__typeof__ (', e, ') ', v, 'q = (')) ;
    DynUtf.Append (d, S2 (e, '); ')) ;
    DynUtf.Append (d, S5 ('__typeof__ (', v, 'q.p) ', v, 'p = ')) ;
    DynUtf.Append (d, S2 (v, 'q.p; ')) ;
    DynUtf.Append (d, S5 ('int64_t ', v, 'n = ', v, 'q.len; '))
  END ;
  RETURN DynUtf.ViewIn (gpool, d)
END CopyArg ;

PROCEDURE SliceTy (elem: Ast.Kid) : UTF =
VAR
  scratch : POOL ;                (* the builder dies with the call *)
  nm, ec : UTF ;
  i : I64 ;
  d : PTR DynUtf.DString IN scratch ;
BEGIN
  (* the UTF slice's own element, which Resolve does not know (it is
     no declared type): a SLICE OF STR under the rehearsed switch
     reaches here with it, and read `Check_<u8>' until 2026-10-24 *)
  IF elem IS SOME e0 THEN
    IF e0.kind = Ast.NQualident AND Text.BLen (e0.bu) = 0 AND
       Text.Eq (e0.au, '<u8>') THEN
      RETURN 'm9_sl_UTF8'
    END
  END ;
  IF Resolve (elem) IS SOME r THEN
    IF r.kind = Ast.NQualident THEN
      IF Text.BLen (r.bu) = 0 THEN
        IF IsBuiltin (r.au) THEN RETURN S2 ('m9_sl_', r.au) END ;
        IF Text.Eq (r.au, '<u8>') THEN RETURN 'm9_sl_UTF8' END
      END
    END
  END ;
  ec := TyC (elem) ;
  d := DynUtf.New (scratch) ;
  DynUtf.Append (d, 'm9_sl_') ;
  FOR i := 0 TO Text.BLen (ec) - 1 DO
    IF B (ec, i) = ORD ('*') THEN DynUtf.AppendChar (d, 'p')
    ELSIF B (ec, i) # 32 THEN DynUtf.Append (d, SLICE (ec, i, 1)) END
  END ;
  nm := DynUtf.View (d) ;
  IF MFind (arrSeen, nm) < 0 THEN
    MAdd (arrSeen, Text.Keep (gpool, nm), NONE, '') ;   (* kept on a miss only *)
    Line (KTdefs, 0, S2 ('#ifndef M9SL_', nm)) ;
    Line (KTdefs, 0, S2 ('#define M9SL_', nm)) ;
    Line (KTdefs, 0, S5 ('typedef struct { ', ec,
      ' *p; int64_t len; } ', nm, ';')) ;
    Line (KTdefs, 0, '#endif')
  END ;
  RETURN nm
END SliceTy ;

(* one struct per rank per element type, guarded like the slice
   typedefs: each defines a fresh anonymous struct, so the same name
   from two modules is a conflicting type and not a redefinition *)
PROCEDURE GridTy (elem: Ast.Kid ; RO rank: UTF) : UTF =
VAR
  nm, ec : UTF ;
  i : I64 ;
  d : PTR DynUtf.DString IN gpool ;
BEGIN
  ec := TyC (elem) ;
  d := DynUtf.New (gpool) ;
  DynUtf.Append (d, 'm9_gd') ;
  DynUtf.Append (d, rank) ;
  DynUtf.AppendChar (d, '_') ;
  FOR i := 0 TO Text.BLen (ec) - 1 DO
    IF B (ec, i) = ORD ('*') THEN DynUtf.AppendChar (d, 'p')
    ELSIF B (ec, i) # 32 THEN DynUtf.Append (d, SLICE (ec, i, 1)) END
  END ;
  nm := DynUtf.ViewIn (gpool, d) ;
  IF MFind (arrSeen, nm) < 0 THEN
    MAdd (arrSeen, nm, NONE, '') ;
    Line (KTdefs, 0, S2 ('#ifndef M9SL_', nm)) ;
    Line (KTdefs, 0, S2 ('#define M9SL_', nm)) ;
    Line (KTdefs, 0, S7 ('M9_GRID_T (', nm, ', ', ec, ', ', rank, ')')) ;
    Line (KTdefs, 0, '#endif')
  END ;
  RETURN nm
END GridTy ;

(* the ALL axis marker: a predeclared identifier, so it is a bare
   designator with that name and no selectors *)
(* the checked helper's width suffix for an integer type tag.  Each
   of the eight exact widths has its own helper since 2026-09-27:
   before that everything went through the I64 one and a narrow
   result was stored unchecked, so `I32 max + 1` wrapped in silence
   (docs/agent-review-2026-09-27.md F1).  A tag that is none of the
   eight -- a C.* value, an enumeration's ordinal -- is a 64-bit
   value to the checker and keeps the I64 helper. *)
PROCEDURE ISuf (RO t: UTF) : UTF =
BEGIN
  IF Text.Eq (t, 'I8') THEN RETURN 'i8' END ;
  IF Text.Eq (t, 'I16') THEN RETURN 'i16' END ;
  IF Text.Eq (t, 'I32') THEN RETURN 'i32' END ;
  IF Text.Eq (t, 'U8') THEN RETURN 'u8' END ;
  IF Text.Eq (t, 'U16') THEN RETURN 'u16' END ;
  IF Text.Eq (t, 'U32') THEN RETURN 'u32' END ;
  IF Text.Eq (t, 'U64') THEN RETURN 'u64' END ;
  RETURN 'i64'
END ISuf ;

PROCEDURE IsWidthConv (RO n: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (n), WidthConvs)
END IsWidthConv ;

(* the runtime's name for each checked narrowing.  A table rather
   than a lowercasing loop: CHR is itself a checked conversion, so
   spelling seven known names with one would put a RAISES ValueRange
   on the generator's name mangling. *)
PROCEDURE LowerName (RO n: UTF) : UTF =
BEGIN
  IF Text.Eq (n, 'I8') THEN RETURN 'i8' END ;
  IF Text.Eq (n, 'I16') THEN RETURN 'i16' END ;
  IF Text.Eq (n, 'I32') THEN RETURN 'i32' END ;
  IF Text.Eq (n, 'U8') THEN RETURN 'u8' END ;
  IF Text.Eq (n, 'U16') THEN RETURN 'u16' END ;
  IF Text.Eq (n, 'U32') THEN RETURN 'u32' END ;
  IF Text.Eq (n, 'U64') THEN RETURN 'u64' END ;
  RETURN ''
END LowerName ;

(* a conversion's argument x of tag at as the int64_t the checked
   narrowings take: a real through m9_i64_f64 and a U64 through
   m9_i64_u64, each checked -- until 2026-10-21 both went through C's
   own conversion, so I32 (NaN) answered 0 without ValueRange and
   I32 (MAX (U64)) answered -1 (the compiler review's G2) *)
PROCEDURE IntArgC (RO x: UTF ; RO at: UTF) : UTF =
BEGIN
  IF Text.Eq (at, 'F64') OR Text.Eq (at, 'F32') THEN
    RETURN S3 ('m9_i64_f64 ((double)(', x, '), err)')
  END ;
  IF Text.Eq (at, 'U64') THEN RETURN S3 ('m9_i64_u64 (', x, ', err)') END ;
  RETURN x
END IntArgC ;

PROCEDURE IsAllArg (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF e.nkids = 0 THEN RETURN Text.Eq (e.au, 'ALL') END
    END
  END ;
  RETURN FALSE
END IsAllArg ;

(* ---- a case record that lives in another module ----

   A CR: tag names the case record type; until 2026-09-15 it named it
   BARE, so every consumer prefixed modName and looked it up locally,
   and a value typed `Shape.Kind' -- a parameter, a variable, a call
   result -- could not be CASEd ("CASE over this selector unsupported
   yet") nor built ("unknown name: Shape").  Csv, Frame and Plot each
   grew an integer face to route around it, in their own comments.

   Now the tag carries the module when there is one -- `CR:Kind' at
   home, `CR:Shape.Kind' abroad -- and these two answer, for either
   spelling, the C prefix and the declaring node.  The header of the
   other module already declares Shape_Kind and its tags; nothing has
   to be re-emitted. *)
PROCEDURE CRPrefix (RO tn: UTF) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (tn) - 1 DO
    IF B (tn, i) = ORD ('.') THEN
      RETURN S3 (CP (SLICE (tn, 0, i)), '_', SLICE (tn, i + 1, Text.BLen (tn) - i - 1))
    END
  END ;
  RETURN S3 (CP (modName), '_', tn)
END CRPrefix ;

PROCEDURE CRNode (RO tn: UTF) : Ast.Kid =
VAR i, ei : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (tn) - 1 DO
    IF B (tn, i) = ORD ('.') THEN
      ei := MFind (extTypes, tn) ;
      IF ei >= 0 THEN RETURN extTypes.es[ei].v END ;
      RETURN NONE
    END
  END ;
  RETURN FindTypeN (tn)
END CRNode ;

PROCEDURE TagOfType (t: Ast.Kid) : UTF =
VAR ei : I64 ;
BEGIN
  IF t IS SOME n0 THEN
    IF n0.kind = Ast.NQualident THEN
      IF Text.BLen (n0.bu) = 0 THEN
        IF FindTypeN (n0.au) IS SOME cr THEN
          IF cr.kind = Ast.NCaseRecordType OR cr.kind = Ast.NEnumType THEN
            RETURN S2 ('CR:', n0.au)
          END
        END
      ELSE
        ei := MFind (extTypes, S3 (n0.au, '.', n0.bu)) ;
        IF ei >= 0 THEN
          IF extTypes.es[ei].v IS SOME cr2 THEN
            IF cr2.kind = Ast.NCaseRecordType OR cr2.kind = Ast.NEnumType THEN
              RETURN S4 ('CR:', n0.au, '.', n0.bu)
            END
          END
        END
      END
    END
  END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NQualident :
        IF Text.Eq (r.au, 'POOL') THEN RETURN 'POOL' END ;
        IF IsBuiltin (r.au) THEN RETURN r.au END ;
        RETURN '?'
    | Ast.NPtrType : RETURN 'PTR'
    | Ast.NSharedType : RETURN 'SHARED'
    | Ast.NOptType : RETURN 'OPTPTR'
    | Ast.NSliceType :
        IF IsUtfSlice (r) THEN RETURN 'UTF' END ;
        RETURN 'SLICE'
    | Ast.NGridType : RETURN 'GRID'
    | Ast.NArrayType : RETURN 'ARR'
    | Ast.NRecordType : RETURN 'REC'
    | Ast.NMonitorType : RETURN 'REC'
    | Ast.NProcType : RETURN 'PROC'
    ELSE RETURN '?'
    END
  END ;
  RETURN '?'
END TagOfType ;

(* a name in the scope table, by the language's order and not the
   table's: the parameters and locals first (they come before the
   module block); then the BINDERS, pushed on top of the block by the
   statements and popped with them, innermost first; the module
   variables and constant tables last.  Until 2026-10-03 the table
   was searched from its start, so `IF k IS SOME a THEN a.line' in a
   module with `VAR a : STR' found the module variable and failed with
   `selection through a non-record' while the checker accepted it
   (owed ledger, found writing M9elide). *)
PROCEDURE ScopeFind (RO n: UTF) : I64 =
VAR f, l, lo, hi : I64 ;
BEGIN
  (* ScopeScan's answer from the index: the first entry when it is a
     parameter or local, else the latest when it is a binder, else the
     first, a module variable.  A scan was n squared in a module's
     variables (the review's F5); the scan stays for the one case the
     index cannot say, a latest entry a cut-back took away *)
  lo := mvBase ;
  IF lo > scope.n THEN lo := scope.n END ;
  hi := mvBase + nmv + extVars.n + aggT.n ;
  IF hi > scope.n THEN hi := scope.n END ;
  f := MFind (scope, n) ;
  IF f < 0 THEN RETURN -1 END ;
  IF f < lo THEN RETURN f END ;
  l := MLast (scope, n) ;
  IF l < 0 THEN RETURN ScopeScan (n) END ;
  IF l >= hi THEN RETURN l END ;
  RETURN f
END ScopeFind ;

PROCEDURE ScopeScan (RO n: UTF) : I64 =
VAR i, lo, hi : I64 ;
BEGIN
  lo := mvBase ;
  IF lo > scope.n THEN lo := scope.n END ;
  hi := mvBase + nmv + extVars.n + aggT.n ;
  IF hi > scope.n THEN hi := scope.n END ;
  FOR i := 0 TO lo - 1 DO
    IF Text.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  FOR i := scope.n - 1 TO hi BY -1 DO
    IF Text.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  FOR i := lo TO hi - 1 DO
    IF Text.Eq (scope.es[i].k, n) THEN RETURN i END
  END ;
  RETURN -1
END ScopeScan ;

PROCEDURE ScopeNode (RO n: UTF) : Ast.Kid =
VAR ix : I64 ;
BEGIN
  ix := ScopeFind (n) ;
  IF ix < 0 THEN RETURN NONE END ;
  RETURN scope.es[ix].v
END ScopeNode ;

PROCEDURE ScopeMode (RO n: UTF) : UTF =
VAR ix : I64 ;
BEGIN
  ix := ScopeFind (n) ;
  IF ix < 0 THEN RETURN '' END ;
  RETURN scope.es[ix].t
END ScopeMode ;

(* the module block of the scope: this module's variables, then every
   imported module's exports as Mod.v in VAR-parameter mode -- the C is
   a pointer to the exporter's storage, so index, LEN, lending and
   assignment take the VAR paths unchanged, as the constant tables'
   do (decision 28).  The constant tables follow (PushAggs). *)
PROCEDURE ModuleScope () =
VAR i : I64 ;
BEGIN
  mvBase := scope.n ;
  FOR i := 0 TO nmv - 1 DO
    MAdd (scope, mvN[i], mvT[i], 'l')
  END ;
  FOR i := 0 TO extVars.n - 1 DO
    MAdd (scope, extVars.es[i].k, extVars.es[i].v, 'v')
  END
END ModuleScope ;

(* a type node from module MODNAME made self-contained: its bare type
   names qualified, as Sem.QualifiedIn does it, so that an importer
   reads an exported variable's type where it was declared -- and an
   ARRAY's bound that is a bare CONST of that module too, as `Mod.N':
   read in the importer, `ARRAY MaxErr OF Perr' looked MaxErr up among
   the importer's constants and was `array count form unsupported'
   (2026-10-10; Parse.m9 wrote the literal 64 for it) *)
(* an array bound written as a bare CONST of module m, as `m.N'; any
   other bound as it is *)
PROCEDURE QualBound (KEPT b: Ast.Kid ; RO KEPT m: UTF) : Ast.Kid =
VAR d, sf : PTR Ast.Node IN gpool ;
BEGIN
  IF b IS SOME e THEN
    IF e.kind = Ast.NDesignator AND e.nkids = 0 AND
       MFind (extConsts, S3 (m, '.', e.au)) >= 0 THEN
      d := Ast.NewNode (gpool, Ast.NDesignator, e.line, e.col) ;
      d.id := e.id ;
      Ast.SetA (gpool, d, m) ;
      sf := Ast.NewNode (gpool, Ast.NSelField, e.line, e.col) ;
      sf.id := e.id ;
      Ast.SetA (gpool, sf, e.au) ;
      Ast.Add (gpool, d, SOME (sf)) ;
      RETURN SOME (d)
    END
  END ;
  RETURN b
END QualBound ;

PROCEDURE QualIn (KEPT t: Ast.Kid ; RO KEPT modName: UTF) : Ast.Kid =
VAR
  n : PTR Ast.Node IN gpool ;
  b : Ast.Kid ;
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident THEN
      IF Text.BLen (tn.bu) = 0 AND NOT IsBuiltin (tn.au) AND
         NOT Text.Eq (tn.au, 'STR') AND NOT Text.Eq (tn.au, 'UTF') AND
         NOT Text.Eq (tn.au, 'POOL') THEN
        n := Ast.NewNode (gpool, Ast.NQualident, tn.line, tn.col) ;
        n.id := tn.id ;
        Ast.SetA (gpool, n, modName) ;
        Ast.SetB (gpool, n, tn.au) ;
        RETURN SOME (n)
      END
    ELSIF tn.kind = Ast.NPtrType OR tn.kind = Ast.NOptType OR
          tn.kind = Ast.NSharedType OR tn.kind = Ast.NSliceType THEN
      n := Ast.NewNode (gpool, tn.kind, tn.line, tn.col) ;
      n.id := tn.id ;
      IF tn.nkids > 0 THEN
        Ast.Add (gpool, n, QualIn (tn.kids[0], modName))
      END ;
      Ast.Add (gpool, n, NONE) ;
      RETURN SOME (n)
    ELSIF (tn.kind = Ast.NArrayType OR tn.kind = Ast.NGridType) AND
          tn.nkids >= 2 THEN
      n := Ast.NewNode (gpool, tn.kind, tn.line, tn.col) ;
      n.id := tn.id ;
      b := tn.kids[0] ;
      IF tn.kind = Ast.NArrayType THEN b := QualBound (b, modName) END ;
      Ast.Add (gpool, n, b) ;
      Ast.Add (gpool, n, QualIn (tn.kids[1], modName)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN t
END QualIn ;

(* does definition u declare a CONST or a TYPE named nm? *)
PROCEDURE DeclaresIn (u: PTR Ast.Node ; RO nm: UTF) : BOOL =
VAR i, j : I64 ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NTypeSection OR d.kind = Ast.NConstSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd THEN
            IF Text.Eq (cd.au, nm) THEN RETURN TRUE END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END DeclaresIn ;

(* an array bound written in definition u, as an importer reads it:
   every bare name in it that u declares -- a CONST, an enumeration --
   as `u.N', through parentheses and operators; anything else as it
   is *)
PROCEDURE QualExpr (KEPT b: Ast.Kid ; KEPT u: PTR Ast.Node) : Ast.Kid =
VAR
  d, sf : PTR Ast.Node IN gpool ;
  i : I64 ;
BEGIN
  IF b IS SOME e THEN
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      IF DeclaresIn (u, e.au) THEN
        d := Ast.NewNode (gpool, Ast.NDesignator, e.line, e.col) ;
        d.id := e.id ;
        Ast.SetA (gpool, d, u.au) ;
        sf := Ast.NewNode (gpool, Ast.NSelField, e.line, e.col) ;
        sf.id := e.id ;
        Ast.SetA (gpool, sf, e.au) ;
        Ast.Add (gpool, d, SOME (sf)) ;
        RETURN SOME (d)
      END
    ELSIF e.kind = Ast.NParen OR e.kind = Ast.NUn OR e.kind = Ast.NBin THEN
      d := Ast.NewNode (gpool, e.kind, e.line, e.col) ;
      d.id := e.id ;
      Ast.SetA (gpool, d, e.au) ;
      FOR i := 0 TO e.nkids - 1 DO Ast.Add (gpool, d, QualExpr (e.kids[i], u)) END ;
      RETURN SOME (d)
    END
  END ;
  RETURN b
END QualExpr ;

(* an exported TYPE's declaration as an importer reads it: an ARRAY's
   bound qualified (QualExpr), through nested arrays; every other node
   the declaration's own, so a record, an enumeration or an alias is
   the node it was *)
PROCEDURE QualArr (KEPT t: Ast.Kid ; KEPT u: PTR Ast.Node) : Ast.Kid =
VAR n : PTR Ast.Node IN gpool ;
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NArrayType AND tn.nkids >= 2 THEN
      n := Ast.NewNode (gpool, tn.kind, tn.line, tn.col) ;
      n.id := tn.id ;
      Ast.Add (gpool, n, QualExpr (tn.kids[0], u)) ;
      Ast.Add (gpool, n, QualArr (tn.kids[1], u)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN t
END QualArr ;

(* the module a qualified type name points into, noted while a
   designator walks a foreign aggregate, so that its component types
   are read where they were declared (canonCtx; Sem's NoteMod) *)
PROCEDURE NoteMod (t: Ast.Kid ; VAR m: UTF) =
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident AND Text.BLen (tn.bu) > 0 THEN m := tn.au END
  END
END NoteMod ;

PROCEDURE InMod (KEPT t: Ast.Kid ; RO KEPT m: UTF) : Ast.Kid =
BEGIN
  IF Text.BLen (m) = 0 OR Text.Eq (m, modName) THEN RETURN t END ;
  RETURN QualIn (t, m)
END InMod ;

(* entry e of fieldIx names field group g of its record *)
PROCEDURE FieldGrp (e, g: I64) =
VAR nb : SLICE OF I64 ; k : I64 ;
BEGIN
  IF e >= LEN (fieldGrp) THEN
    nb := NEW (gpool, I64, 2 * e + 64) ;
    FOR k := 0 TO LEN (fieldGrp) - 1 DO nb[k] := fieldGrp[k] END ;
    fieldGrp := nb
  END ;
  fieldGrp[e] := g
END FieldGrp ;

PROCEDURE FieldType (rec: PTR Ast.Node ;
                     RO f: UTF) : Ast.Kid =
VAR i, j : I64  ;
  fsk : Ast.Kid ;
  rid, key : UTF ;
BEGIN
  (* NRecordType is kids[0]=base, kids[1]=fields; NMonitorType has no
     base, so its fields are kids[0] *)
  IF rec.kind = Ast.NMonitorType THEN
    fsk := rec.kids[0]
  ELSE
    fsk := rec.kids[1]
  END ;
  (* every field of the record entered once, the first of a name
     winning as the scan's first hit did: the scan per access made
     --check quadratic in a record's fields, which the scale gate's
     `fields' shape showed on CI (ratio 6.3; 40,000 fields 0.69 s, ten
     times 10,000's) once the checker's own scans were indexed *)
  rid := ItoA (rec.id) ;
  IF MFind (fieldDone, rid) < 0 THEN
    MAdd (fieldDone, Text.Keep (gpool, rid), NONE, '') ;
    IF fsk IS SOME fs THEN
      FOR i := 0 TO fs.nkids - 1 DO
        IF fs.kids[i] IS SOME g THEN
          IF g.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                key := S3 (rid, ' ', id.au) ;
                IF MFind (fieldIx, key) < 0 THEN
                  (* the group's index, not its node: rec is borrowed,
                     and a node of it kept in a module map is a
                     retention the checker refuses (par 4.1) *)
                  MAdd (fieldIx, Text.Keep (gpool, key), NONE, '') ;
                  FieldGrp (fieldIx.n - 1, i)
                END
              END
            END
          END
        END
      END
    END
  END ;
  i := MFind (fieldIx, S3 (rid, ' ', f)) ;
  IF i >= 0 THEN
    IF fsk IS SOME fs2 THEN
      IF fs2.kids[fieldGrp[i]] IS SOME g2 THEN RETURN g2.kids[1] END
    END
  END ;
  RETURN NONE
END FieldType ;

(* ---- the frame form of NEW, and adoption at exit (rule 1 of
   docs/pool-elision-plan.md) ---- *)

(* a designator with at most one field selector as a fresh qualident
   node, for the type position of a NEW *)
PROCEDURE AsQualG (k: Ast.Kid) : Ast.Kid =
VAR q : PTR Ast.Node IN gpool ;
BEGIN
  IF k IS SOME d THEN
    IF d.kind # Ast.NQualident AND d.kind # Ast.NDesignator THEN
      RETURN NONE
    END ;
    IF d.nkids > 1 THEN RETURN NONE END ;
    q := Ast.NewNode (gpool, Ast.NQualident, d.line, d.col) ;
    Ast.SetA (gpool, q, Text.Keep (gpool, d.au)) ;
    Ast.SetB (gpool, q, Text.Keep (gpool, d.bu)) ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind # Ast.NSelField THEN RETURN NONE END ;
        Ast.SetB (gpool, q, Text.Keep (gpool, sel.au))
      END
    END ;
    RETURN SOME (q)
  END ;
  RETURN NONE
END AsQualG ;

(* the four spellings of NEW, told apart by NAME (par 10, item 6):
   'frame' for NEW (T) and NEW (T, n...), 'pool' for NEW (pool, T...),
   'own' for NEW (OWN, T).  The checker (Sem.NewForm) has already
   refused anything else; this side only has to agree.  ty is the
   type's node and ext0 the index of the first extent, whose kid may
   be NONE. *)
PROCEDURE NewShape (e: PTR Ast.Node ; VAR ty: Ast.Kid ;
                    VAR ext0: I64) : UTF =
VAR isVar : BOOL ;
BEGIN
  ty := NONE ;
  ext0 := 2 ;
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 AND Text.Eq (d.au, 'OWN') THEN
      ty := e.kids[1] ;
      RETURN 'own'
    END ;
    isVar := TRUE ;
    IF d.nkids = 0 THEN
      IF Text.BLen (ScopeMode (d.au)) = 0 AND NOT Text.Eq (d.au, 'HEAP') THEN
        isVar := FALSE
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF Text.BLen (ScopeMode (d.au)) = 0 AND
             MFind (extMods, d.au) >= 0 THEN
            isVar := FALSE
          END
        END
      END
    END ;
    IF isVar THEN
      ty := AsQualG (e.kids[1]) ;
      RETURN 'pool'
    END ;
    ty := AsQualG (e.kids[0]) ;
    ext0 := 1 ;
    RETURN 'frame'
  END ;
  ty := e.kids[1] ;
  RETURN 'frame'
END NewShape ;

(* can a value of this type carry a pointer into the frame?  A PTR,
   an OPT PTR, a slice or a grid can; a record or an array can when a
   component can; a SHARED handle (heap), a procedure value and a
   scalar cannot.  Bounded, since a record may name itself through a
   PTR -- which is where the walk stops anyway. *)
PROCEDURE HasPtr (t: Ast.Kid ; depth: I64) : BOOL =
VAR i, j : I64 ;
  fsk : Ast.Kid ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NPtrType : RETURN TRUE
    | Ast.NOptType : RETURN HasPtr (r.kids[0], depth + 1)
    | Ast.NSliceType : RETURN TRUE
    | Ast.NGridType : RETURN TRUE
    | Ast.NArrayType : RETURN HasPtr (r.kids[1], depth + 1)
    | Ast.NRecordType :
        fsk := r.kids[1] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NMonitorType :
        fsk := r.kids[0] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME v THEN
            IF v.kids[0] IS SOME vfs THEN
              FOR j := 0 TO vfs.nkids - 1 DO
                IF vfs.kids[j] IS SOME fg THEN
                  IF HasPtr (fg.kids[1], depth + 1) THEN RETURN TRUE END
                END
              END
            END
          END
        END ;
        RETURN FALSE
    ELSE RETURN FALSE
    END
  END ;
  RETURN FALSE
END HasPtr ;

(* the exit test, one line per pointer component of the value EXPR
   of type T: adopt the frame's arena into the caller's when the
   component points into it.  An array loops; a record and a variant
   walk their fields (every arm of a variant -- reading an inactive
   arm's pointer bits compares an address and nothing else, and a
   spurious adoption keeps memory where a missed one would free it
   under a live pointer). *)
(* does a VAR parameter of this type carry its object's pool as a
   hidden argument (docs/pool-elision-plan.md, rule 2)?  Written as
   `PTR T` or `OPT PTR T`: yes, by node kind and no lookup.  A record,
   monitor, array or variant that can hold a pointer: yes, since a
   component of it may be handed on.  A bare slice, grid or string:
   no -- those are output slots, re-homed or adopted at exit.
   Sem.PtrParamTy is the twin; gendiff holds the two generators to
   one answer. *)
PROCEDURE PoolParamTy (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME n THEN
    IF n.kind = Ast.NPtrType THEN RETURN TRUE END ;
    IF n.kind = Ast.NOptType THEN
      IF n.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
      RETURN FALSE
    END ;
    IF n.kind = Ast.NSliceType OR n.kind = Ast.NGridType THEN RETURN FALSE END ;
    IF Resolve (t) IS SOME r THEN
      (* a name for a pointer -- `SinkP = PTR Zarr.Sink`, `Ast.Kid =
         OPT PTR Node` -- is the pointer it names (the proxy's P9) *)
      IF r.kind = Ast.NPtrType THEN RETURN TRUE END ;
      IF r.kind = Ast.NOptType THEN
        IF r.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
        RETURN FALSE
      END ;
      IF r.kind = Ast.NRecordType OR r.kind = Ast.NMonitorType OR
         r.kind = Ast.NArrayType OR r.kind = Ast.NCaseRecordType THEN
        RETURN HasPtr (t, 0)
      END
    END
  END ;
  RETURN FALSE
END PoolParamTy ;

(* the exit test, one line per pointer component of EXPR of type T,
   each adopting the frame into DST: the caller's arena for a result,
   the object's own pool for a VAR parameter's target (rule 2) *)
PROCEDURE AdoptEmit (RO expr: UTF ; t: Ast.Kid ; RO dst: UTF ;
                     ind: I64 ; depth: I64) =
VAR i, j, k : I64 ;
  fsk : Ast.Kid ;
  kv : UTF ;
BEGIN
  IF depth > 8 THEN RETURN END ;
  IF Resolve (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NPtrType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, ');'))
    | Ast.NOptType :
        IF HasPtr (r.kids[0], depth + 1) THEN
          Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, ');'))
        END
    | Ast.NSliceType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, '.p);'))
    | Ast.NGridType :
        Line (KPbuf, ind, S5 ('m9_adopt_if (&m9frame, ', dst, ', ', expr, '.p);'))
    | Ast.NArrayType :
        IF HasPtr (r.kids[1], depth + 1) THEN
          kv := S2 ('m9k', ItoA (depth)) ;
          Line (KPbuf, ind, S9 ('for (int64_t ', kv, ' = 0; ', kv, ' < ',
            ArrCount2 (r.kids[0]), '; ', kv, '++) {')) ;
          AdoptEmit (S4 (expr, '.v[', kv, ']'), r.kids[1], dst, ind + 1,
                     depth + 1) ;
          Line (KPbuf, ind, '}')
        END
    | Ast.NRecordType :
        fsk := r.kids[1] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN
                IF g.kids[0] IS SOME ids THEN
                  FOR j := 0 TO ids.nkids - 1 DO
                    IF ids.kids[j] IS SOME id THEN
                      AdoptEmit (S3 (expr, '.', CN (id.au)), g.kids[1],
                                 dst, ind, depth + 1)
                    END
                  END
                END
              END
            END
          END
        END
    | Ast.NMonitorType :
        fsk := r.kids[0] ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF HasPtr (g.kids[1], depth + 1) THEN
                IF g.kids[0] IS SOME ids THEN
                  FOR j := 0 TO ids.nkids - 1 DO
                    IF ids.kids[j] IS SOME id THEN
                      AdoptEmit (S3 (expr, '.', CN (id.au)), g.kids[1],
                                 dst, ind, depth + 1)
                    END
                  END
                END
              END
            END
          END
        END
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME v THEN
            IF v.kids[0] IS SOME vfs THEN
              FOR j := 0 TO vfs.nkids - 1 DO
                IF vfs.kids[j] IS SOME fg THEN
                  IF HasPtr (fg.kids[1], depth + 1) THEN
                    IF fg.kids[0] IS SOME fids THEN
                      FOR k := 0 TO fids.nkids - 1 DO
                        IF fids.kids[k] IS SOME fid THEN
                          AdoptEmit (S5 (expr, '.u.', v.au, '.', CN (fid.au)),
                                     fg.kids[1], dst, ind, depth + 1)
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
    ELSE
    END
  END
END AdoptEmit ;

PROCEDURE CharVal (RO lit: UTF) : I64 =
BEGIN
  RETURN Ast.CharCode (STR (lit))
END CharVal ;

(* u + v for a UTF: a CHAR side is its encoding, a literal adapts
   (docs/utf8-plan.md, U2) *)
PROCEDURE UtfSide (k: Ast.Kid) : UTF =
VAR c : UTF ;
BEGIN
  IF Text.Eq (TagOfExpr (k), 'CHAR') THEN
    c := EX (k, 'CHAR') ;
    RETURN S3 ('m9_utf_of_char (err->res, ', c, ', err)')
  END ;
  RETURN EX (k, 'UTF')
END UtfSide ;

PROCEDURE UtfBuiltinC (RO name: UTF ; a: Ast.Kid ; VAR tag: UTF ;
                       RO pool: UTF) : UTF =
VAR at, x : UTF ;
BEGIN
  IF Text.Eq (name, 'STR') THEN
    IF strUtf THEN
      tag := 'UTF' ;
      RETURN EX (a, 'UTF')
    END ;
    tag := 'SLICE' ;
    x := EX (a, 'UTF') ;
    RETURN S3 ('m9_utf_to_chars (err->res, ', x, ', err)')
  END ;
  IF Text.Eq (name, 'OCTETS') THEN
    tag := 'SLICE' ;
    x := EX (a, 'UTF') ;
    RETURN S3 ('m9_utf_octets (', x, ')')
  END ;
  tag := 'UTF' ;
  at := '' ;
  IF a IS SOME an THEN at := Ast.TyStrAt (an.id) ;
    (* a literal is a UTF already, in static storage -- but placed in a
       pool it is copied there, as any UTF is *)
    IF an.kind = Ast.NString AND Text.Eq (pool, 'err->res') THEN RETURN EX (a, 'UTF') END ;
    IF an.kind = Ast.NString THEN at := 'SLICE OF <u8>' END
  END ;
  IF Text.Eq (at, 'SLICE OF <u8>') THEN
    x := EX (a, 'UTF') ;
    IF Text.Eq (pool, 'err->res') THEN RETURN x END ;
    RETURN S5 ('m9_utf_from_bytes (', pool, ', m9_utf_octets (', x, '), err)')
  END ;
  IF Text.Eq (at, 'SLICE OF BYTE') THEN
    x := EX (a, 'SLICE') ;
    RETURN S5 ('m9_utf_from_bytes (', pool, ', ', x, ', err)')
  END ;
  x := EX (a, 'SLICE') ;
  RETURN S5 ('m9_utf_from_chars (', pool, ', ', x, ', err)')
END UtfBuiltinC ;

PROCEDURE UtfCat (e: PTR Ast.Node) : UTF =
VAR l, r : UTF ;
BEGIN
  l := UtfSide (e.kids[0]) ;
  r := UtfSide (e.kids[1]) ;
  RETURN S5 ('m9_utf_cat (err->res, ', l, ', ', r, ', err)')
END UtfCat ;

(* the SLICE OF <u8> that UTF names, by its element *)
PROCEDURE IsUtfSlice (r: PTR Ast.Node) : BOOL =
BEGIN
  IF r.kind # Ast.NSliceType OR r.nkids = 0 THEN RETURN FALSE END ;
  IF r.kids[0] IS SOME el THEN
    RETURN el.kind = Ast.NQualident AND Text.BLen (el.bu) = 0 AND Text.Eq (el.au, '<u8>')
  END ;
  RETURN FALSE
END IsUtfSlice ;

(* a literal's UTF-8 length, and its octets as C initialisers *)
PROCEDURE Utf8Len (RO s: UTF) : I64 =
BEGIN
  RETURN Text.BLen (s)
END Utf8Len ;

PROCEDURE Oct (VAR d: PTR DynUtf.DString ; b: I64) =
BEGIN
  IF DynUtf.BLen (d) > 0 THEN DynUtf.Append (d, ', ') END ;
  DynUtf.AppendI64 (d, b)
END Oct ;

PROCEDURE Utf8Codes (RO s: UTF) : UTF =
VAR
  d : PTR DynUtf.DString IN gpool ;
  i : I64 ;
BEGIN
  d := DynUtf.New (gpool) ;
  FOR i := 0 TO Text.BLen (s) - 1 DO Oct (d, B (s, i)) END ;
  RETURN DynUtf.ViewIn (gpool, d)
END Utf8Codes ;

PROCEDURE StrCodes (RO s: UTF) : UTF =
VAR
  scratch : POOL ;                (* the builder dies with the call *)
  d : PTR DynUtf.DString IN scratch ;
  c : CHAR ;
  first : BOOL ;
BEGIN
  (* every Unicode scalar, as its code: the source is read as UTF-8
     (Io.ReadFile since 2026-10-09), so a literal's CHARs are scalars
     and nothing is left to refuse (it was `non-ASCII string literal
     unsupported yet' while a source file arrived as octets) *)
  d := DynUtf.New (scratch) ;
  first := TRUE ;
  FOR c IN s DO
    IF NOT first THEN DynUtf.Append (d, ', ') END ;
    first := FALSE ;
    DynUtf.AppendI64 (d, ORD (c)) ;
    DynUtf.AppendChar (d, 'u')
  END ;
  RETURN DynUtf.View (d)
END StrCodes ;

(* the record a CONST's call names, as a type node -- Row (...) or
   Mod.Row (...), an alias followed -- or NONE *)
PROCEDURE RecordConstQual (k: Ast.Kid) : Ast.Kid =
VAR
  name, ct, m, tn : UTF ;
  j : I64 ;
  q : PTR Ast.Node IN gpool ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        name := dn.au ;
        FOR j := 0 TO dn.nkids - 1 DO
          IF dn.kids[j] IS SOME sf THEN
            IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.au) END
          END
        END ;
        IF RecordAt (name, ct, m, tn) IS SOME rn THEN
          q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
          IF Text.Eq (m, modName) THEN
            Ast.SetA (gpool, q, tn)
          ELSE
            Ast.SetA (gpool, q, m) ;
            Ast.SetB (gpool, q, tn)
          END ;
          RETURN SOME (q)
        END
      END
    END
  END ;
  RETURN NONE
END RecordConstQual ;

PROCEDURE IsAggregate (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAggregate THEN RETURN TRUE END ;
    IF RecordConstQual (k) IS SOME rq THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsAggregate ;

(* a constant table (par 2.2.4): CONST X = [ e1, ..., en ] is kept as
   an ARRAY n OF T built here, T read off the first element -- the
   checker has held every element to it *)
PROCEDURE AddAgg (RO KEPT nm: UTF ; KEPT agk: Ast.Kid) =
VAR
  cnt, at, q : PTR Ast.Node IN gpool ;
  ek : I64 ;
  elt : Ast.Kid ;
BEGIN
  (* a record CONST: its type is the record (par 2.2.4) *)
  IF RecordConstQual (agk) IS SOME rq THEN
    MAdd (aggT, nm, SOME (rq), '') ;
    MAdd (aggV, nm, agk, '') ;
    RETURN
  END ;
  IF agk IS SOME ag THEN
    cnt := Ast.NewNode (gpool, Ast.NInt, 0, 0) ;
    Ast.SetA (gpool, cnt, Text.Keep (gpool, ItoA (ag.nkids))) ;
    ek := Ast.NInt ;
    IF ag.kids[0] IS SOME el THEN
      ek := el.kind ;
      IF el.kind = Ast.NUn THEN
        IF el.kids[0] IS SOME o THEN ek := o.kind END
      END
    END ;
    q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
    Ast.SetA (gpool, q, 'I64') ;
    IF ek = Ast.NReal THEN Ast.SetA (gpool, q, 'F64')
    ELSIF ek = Ast.NChar THEN Ast.SetA (gpool, q, 'CHAR')
    ELSIF ek = Ast.NTrue OR ek = Ast.NFalse THEN Ast.SetA (gpool, q, 'BOOL')
    END ;
    elt := SOME (q) ;
    IF ek = Ast.NString THEN
      IF strUtf THEN elt := utfNode ELSE elt := strNode END
    END ;
    IF RecordConstQual (ag.kids[0]) IS SOME req THEN elt := SOME (req) END ;
    at := Ast.NewNode (gpool, Ast.NArrayType, 0, 0) ;
    Ast.Add (gpool, at, SOME (cnt)) ;
    Ast.Add (gpool, at, elt) ;
    MAdd (aggT, nm, SOME (at), '') ;
    MAdd (aggV, nm, agk, '')
  END
END AddAgg ;

(* ... visible in every body after the module variables, in the mode
   of a VAR parameter: the name is a POINTER to the table, so index,
   LEN and lending take the paths a VAR array parameter takes *)
PROCEDURE PushAggs () =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO aggT.n - 1 DO
    MAdd (scope, aggT.es[i].k, aggT.es[i].v, 'v')
  END
END PushAggs ;

(* ... and emitted as const data -- read-only storage, so a write the
   checker missed is a fault and not a changed constant -- with the
   name a pointer to it.  One element per line: a table is read. *)
(* a literal of a constant table or record CONST as C; a string's
   characters are the static array sname, emitted before by StrsC *)
PROCEDURE LitC (e: PTR Ast.Node ; RO sname: UTF ; RO what: UTF) : UTF =
BEGIN
  IF e.kind = Ast.NInt THEN RETURN S3 ('INT64_C(', e.au, ')') END ;
  IF e.kind = Ast.NReal THEN RETURN S3 ('(', e.au, ')') END ;
  IF e.kind = Ast.NChar THEN RETURN S2 (ItoA (CharVal (e.au)), 'u') END ;
  IF e.kind = Ast.NTrue THEN RETURN 'true' END ;
  IF e.kind = Ast.NFalse THEN RETURN 'false' END ;
  IF e.kind = Ast.NString THEN
    IF Text.BLen (e.au) > 0 AND strUtf THEN
      RETURN S5 ('{ (uint8_t *) ', sname, ', ', ItoA (Utf8Len (e.au)), ' }')
    END ;
    IF Text.BLen (e.au) > 0 THEN
      RETURN S5 ('{ (uint32_t *) ', sname, ', ', ItoA (Text.CpCount (e.au)), ' }')
    END ;
    RETURN '{ 0, 0 }'
  END ;
  IF IsNegLit (e, Ast.NInt) THEN RETURN S3 ('INT64_C(-', NegLitText (e), ')') END ;
  IF IsNegLit (e, Ast.NReal) THEN RETURN S3 ('(-', NegLitText (e), ')') END ;
  ErrAt (e, S2 ('aggregate element unsupported yet: ', what)) ;
  RETURN '0'
END LitC ;

(* the static array a string literal's characters live in *)
PROCEDURE StrC (e: PTR Ast.Node ; RO sname: UTF) =
BEGIN
  IF e.kind = Ast.NString AND Text.BLen (e.au) > 0 THEN
    IF strUtf THEN       (* the rehearsed switch: a table's string is octets *)
      Line (KRec3, 0, S9 ('static const uint8_t ', sname, '[',
        ItoA (Utf8Len (e.au)), '] = { ', Utf8Codes (e.au), ' };', '', ''))
    ELSE
      Line (KRec3, 0, S9 ('static const uint32_t ', sname, '[',
        ItoA (Text.CpCount (e.au)), '] = { ', StrCodes (e.au), ' };', '', ''))
    END
  END
END StrC ;

(* a record aggregate of literals as a brace initializer, its strings
   emitted first as <base>_<field> *)
PROCEDURE RecStrs (e: PTR Ast.Node ; RO base: UTF) =
VAR f : I64 ;
BEGIN
  IF e.kids[1] IS SOME al THEN
    FOR f := 0 TO al.nkids - 1 DO
      IF al.kids[f] IS SOME a THEN StrC (a, S3 (base, '_', ItoA (f))) END
    END
  END
END RecStrs ;

PROCEDURE RecC (e: PTR Ast.Node ; RO base: UTF ; RO what: UTF) : UTF =
VAR
  f : I64 ;
  cs : UTF ;
BEGIN
  cs := '{ ' ;
  IF e.kids[1] IS SOME al THEN
    FOR f := 0 TO al.nkids - 1 DO
      IF al.kids[f] IS SOME a THEN
        IF f > 0 THEN cs := S2 (cs, ', ') END ;
        cs := S2 (cs, LitC (a, S3 (base, '_', ItoA (f)), what))
      END
    END
  END ;
  RETURN S2 (cs, ' }')
END RecC ;

PROCEDURE EmitAggs () =
VAR
  i, k : I64 ;
  ty, nm, cs : UTF ;
BEGIN
  FOR i := 0 TO aggT.n - 1 DO
    ty := TyC (aggT.es[i].v) ;
    nm := CN (aggT.es[i].k) ;
    IF aggV.es[i].v IS SOME ag THEN
      IF ag.kind = Ast.NCallExpr THEN
        (* a record CONST: one record of const data *)
        RecStrs (ag, S2 (nm, '_s0')) ;
        Line (KRec3, 0, S7 ('static const ', ty, ' ', nm, '_k = ',
          RecC (ag, S2 (nm, '_s0'), aggT.es[i].k), ';')) ;
        Line (KRec3, 0, S9 ('static ', ty, ' * const ', nm, ' = (', ty,
          ' *) &', nm, '_k;'))
      ELSE
        FOR k := 0 TO ag.nkids - 1 DO
          IF ag.kids[k] IS SOME se THEN
            IF se.kind = Ast.NCallExpr THEN
              RecStrs (se, S3 (nm, '_s', ItoA (k)))
            ELSE
              StrC (se, S3 (nm, '_s', ItoA (k)))
            END
          END
        END ;
        Line (KRec3, 0, S5 ('static const ', ty, ' ', nm, '_k = { {')) ;
        FOR k := 0 TO ag.nkids - 1 DO
          cs := '0' ;
          IF ag.kids[k] IS SOME e THEN
            IF e.kind = Ast.NCallExpr THEN
              cs := RecC (e, S3 (nm, '_s', ItoA (k)), aggT.es[i].k)
            ELSE
              cs := LitC (e, S3 (nm, '_s', ItoA (k)), aggT.es[i].k)
            END
          END ;
          IF k < ag.nkids - 1 THEN cs := S2 (cs, ',') END ;
          Line (KRec3, 1, cs)
        END ;
        Line (KRec3, 0, '} };') ;
        Line (KRec3, 0, S9 ('static ', ty, ' * const ', nm, ' = (', ty,
          ' *) &', nm, '_k;'))
      END
    END
  END
END EmitAggs ;

(* ---- registry loading ---- *)

(* Sem.NanWalk's twin: a bare designator NaN becomes the real literal
   NAN (report par 2.1), here too because the generator also runs
   without the checker *)
PROCEDURE NanWalk (VAR n: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND Text.Eq (n.au, 'NaN') THEN
    n.kind := Ast.NReal ;
    Ast.SetA (gpool, n, 'NAN')
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN NanWalk (c) END
  END
END NanWalk ;

PROCEDURE LoadUnit (VAR KEPT u: PTR Ast.Node) =
VAR
  i, j, k, pi : I64 ;
  nb : SLICE OF GP ;
  tb : SLICE OF TY ;
  xb : SLICE OF XC ;
  sb : SLICE OF UTF ;
  kb : SLICE OF AKid ;
  db : SLICE OF BOOL ;
  hasBody : BOOL ;
BEGIN
  Setup () ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME w THEN NanWalk (w) END
  END ;
  IF u.kind = Ast.NDefinition AND Text.BLen (u.bu) > 0 THEN
    FOR i := 0 TO u.nkids - 1 DO
      IF u.kids[i] IS SOME d THEN
        IF d.kind = Ast.NProcDecl THEN
          (* the unit goes in the entry's tag: the [SERIAL]
             gate is per LIBRARY, not per procedure *)
          MAdd (foreignProcs, d.au, SOME (d), u.au)
        END
      END
    END ;
    RETURN
  END ;
  IF u.kind = Ast.NProgram THEN isProgram := TRUE END ;
  IF Text.BLen (modName) = 0 THEN modName := u.au END ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcN (d.au) ;
        IF pi < 0 THEN
          IF ngps = LEN (gps) THEN
            nb := NEW (gpool, GP, 2 * LEN (gps)) ;
            FOR k := 0 TO ngps - 1 DO nb[k] := gps[k] END ;
            gps := nb
          END ;
          gps[ngps].name := d.au ;
          gps[ngps].node := SOME (d) ;
          gps[ngps].body := d.kids[4] ;
          gps[ngps].exported := u.kind = Ast.NDefinition ;
          MAdd (gpIx, d.au, NONE, '') ;
          ngps := ngps + 1
        ELSE
          IF d.kids[4] IS SOME bd THEN
            gps[pi].body := SOME (bd) ;
            gps[pi].node := SOME (d)
          END
        END
      ELSIF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF ntys = LEN (tys) THEN
              tb := NEW (gpool, TY, 2 * LEN (tys)) ;
              FOR k := 0 TO ntys - 1 DO tb[k] := tys[k] END ;
              tys := tb
            END ;
            tys[ntys].name := td.au ;
            tys[ntys].node := td.kids[0] ;
            tys[ntys].opq := FALSE ;
            hasBody := FALSE ;
            IF td.kids[0] IS SOME tb0 THEN hasBody := TRUE END ;
            IF u.kind = Ast.NDefinition AND NOT hasBody THEN
              tys[ntys].opq := TRUE
            END ;
            tys[ntys].fdef := u.kind = Ast.NDefinition ;
            IF hasBody AND MFind (tyBody, td.au) < 0 THEN
              MAdd (tyBody, td.au, td.kids[0], '')
            END ;
            IF tys[ntys].opq AND MFind (tyOpq, td.au) < 0 THEN
              MAdd (tyOpq, td.au, NONE, '')
            END ;
            ntys := ntys + 1
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd THEN
            IF IsAggregate (cd.kids[0]) THEN
              AddAgg (cd.au, cd.kids[0])
            ELSE
              MAdd (consts, cd.au, FoldStr (cd.kids[0]), '')
            END
          END
        END
      ELSIF d.kind = Ast.NExcSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN
            IF nxcs = LEN (xcs) THEN
              xb := NEW (gpool, XC, 2 * LEN (xcs)) ;
              FOR k := 0 TO nxcs - 1 DO xb[k] := xcs[k] END ;
              xcs := xb
            END ;
            xcs[nxcs].name := xd.au ;
            xcs[nxcs].fields := xd.kids[0] ;
            xcs[nxcs].fdef := u.kind = Ast.NDefinition ;
            nxcs := nxcs + 1
          END
        END
      ELSIF d.kind = Ast.NVarSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME ids THEN
              FOR k := 0 TO ids.nkids - 1 DO
                IF ids.kids[k] IS SOME id THEN
                  IF nmv = LEN (mvN) THEN
                    sb := NEW (gpool, UTF, 2 * LEN (mvN)) ;
                    kb := NEW (gpool, AKid, 2 * LEN (mvT)) ;
                    db := NEW (gpool, BOOL, 2 * LEN (mvT)) ;
                    FOR pi := 0 TO nmv - 1 DO
                      sb[pi] := mvN[pi] ;
                      kb[pi] := mvT[pi] ;
                      db[pi] := mvDef[pi]
                    END ;
                    mvN := sb ;
                    mvT := kb ;
                    mvDef := db
                  END ;
                  mvN[nmv] := id.au ;
                  mvT[nmv] := vd.kids[1] ;
                  mvDef[nmv] := u.kind = Ast.NDefinition ;
                  nmv := nmv + 1
                END
              END
            END
          END
        END
      ELSIF d.kind = Ast.NModBody THEN
        mainBody := d.kids[0]
      END
    END
  END
END LoadUnit ;

PROCEDURE RegisterExtern (KEPT u: PTR Ast.Node ; addInclude: BOOL) =
VAR i, j, k, lo, hi : I64 ;
BEGIN
  Setup () ;
  IF u.kind # Ast.NDefinition THEN RETURN END ;
  (* an error on one of these nodes is in u's source (ErrAt) *)
  lo := u.id ;
  hi := u.id ;
  IdSpan (SOME (u), lo, hi) ;
  NoteOrigin (lo, hi, Text.Keep (gpool, u.au)) ;
  IF Text.BLen (u.bu) > 0 THEN
    FOR i := 0 TO u.nkids - 1 DO
      IF u.kids[i] IS SOME d THEN
        IF d.kind = Ast.NProcDecl THEN
          (* the unit goes in the entry's tag: the [SERIAL]
             gate is per LIBRARY, not per procedure *)
          MAdd (foreignProcs, d.au, SOME (d), u.au)
        END
      END
    END ;
    RETURN
  END ;
  (* the include list is the DIRECT imports only; a deep load
     registers the declarations and stops there *)
  IF addInclude THEN
    (* the definition kept with it: Emit asks whether it imports this
       module back (CycleForwards) *)
    IF MFind (extMods, u.au) < 0 THEN MAdd (extMods, u.au, SOME (u), '') END
  END ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        MAdd (extProcs, Text.Keep (gpool, S3 (u.au, '.', d.au)), SOME (d), '')
      ELSIF d.kind = Ast.NExcSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN
            MAdd (extExcs, xd.au, xd.kids[0], u.au)
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd THEN
            MAdd (extConsts, Text.Keep (gpool, S3 (u.au, '.', cd.au)), cd.kids[0], '')
          END
        END
      END
    END
  END ;
  (* types and variables after every CONST: an array bound in them
     that is a bare CONST of u is qualified (QualIn), and the CONST
     may be declared below the TYPE.  An exported TYPE was registered
     as written until 2026-10-29, so an importer's `VAR v : Shapes.Vec'
     with Vec = ARRAY N OF F64 looked N up among its own constants and
     was `array count form unsupported' *)
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF td.kids[0] IS SOME tb THEN
              MAdd (extTypes, Text.Keep (gpool, S3 (u.au, '.', td.au)), QualArr (SOME (tb), u), '')
            END
          END
        END
      ELSIF d.kind = Ast.NVarSection THEN
        (* the definition's variables: an importer's Mod.v, a pointer
           to the exporter's storage in VAR-parameter mode, whose C
           name is Mod_v (decision 28) *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME vids THEN
              FOR k := 0 TO vids.nkids - 1 DO
                IF vids.kids[k] IS SOME vid THEN
                  MAdd (extVars, Text.Keep (gpool, S3 (u.au, '.', vid.au)), QualIn (QualArr (vd.kids[1], u), u.au), '')
                END
              END
            END
          END
        END
      END
    END
  END
END RegisterExtern ;

(* does definition u import module m? *)
PROCEDURE ImportsMod (u: PTR Ast.Node ; RO m: UTF) : BOOL =
VAR i, k : I64 ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME imp THEN
      IF imp.kind = Ast.NImportList THEN
        IF imp.kids[0] IS SOME ids THEN
          FOR k := 0 TO ids.nkids - 1 DO
            IF ids.kids[k] IS SOME id THEN
              IF Text.Eq (id.au, m) THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ImportsMod ;

(* TWO DEFINITIONS THAT IMPORT EACH OTHER (allowed; Alex, 2026-10-22:
   types do not change at run time, so a copy works).  Whichever header
   the C compiler reads first includes the other, whose own include of
   the first is then skipped by its guard -- so the second sees none of
   the first's type names, and `int64_t DB_G (DA_A a, ...)' was
   `unknown type name DA_A'.  The partner's struct-like types are
   copied here as their forward typedefs: identical typedefs may be
   repeated (C11), and a prototype may take an incomplete type.  A
   record FIELD of the partner's type by value still needs the body,
   which a cycle cannot always give; pointers and parameters do not.
   A module in no cycle gets nothing here: its C is unchanged. *)
PROCEDURE CycleForwards (RO me: UTF) =
VAR i, j, k : I64 ;
BEGIN
  FOR i := 0 TO extMods.n - 1 DO
    IF extMods.es[i].v IS SOME u THEN
      IF ImportsMod (u, me) THEN
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME sec THEN
            IF sec.kind = Ast.NTypeSection THEN
              FOR k := 0 TO sec.nkids - 1 DO
                IF sec.kids[k] IS SOME td THEN
                  IF StructLike (td.kids[0]) THEN
                    Line (KHdr, 0, S6 ('typedef struct ', CP (u.au), '_', td.au,
                      ' ', S4 (CP (u.au), '_', td.au, ';')))
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END CycleForwards ;

(* a type C spells as a named struct: a record, a monitor, a case
   record, an enumeration -- or an opaque one, which has no body *)
PROCEDURE StructLike (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME n THEN
    RETURN n.kind = Ast.NRecordType OR n.kind = Ast.NMonitorType OR
           n.kind = Ast.NCaseRecordType OR n.kind = Ast.NEnumType
  END ;
  RETURN TRUE
END StructLike ;

PROCEDURE LoadExtern (KEPT u: PTR Ast.Node) =
BEGIN
  RegisterExtern (u, TRUE)
END LoadExtern ;

PROCEDURE LoadExternDeep (KEPT u: PTR Ast.Node) =
BEGIN
  RegisterExtern (u, FALSE)
END LoadExternDeep ;

(* ---- mutual recursion heads ---- *)

PROCEDURE DES (d: PTR Ast.Node ; VAR tag: UTF) : UTF ;
PROCEDURE EX (k: Ast.Kid ; RO want: UTF) : UTF ;
PROCEDURE LeftRaises (k: Ast.Kid) : BOOL ;
PROCEDURE CallC (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: UTF) : UTF ;
PROCEDURE CallC0 (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: UTF) : UTF ;
PROCEDURE EmitStmt (k: Ast.Kid ; ind: I64) ;
PROCEDURE EmitSeq (k: Ast.Kid ; ind: I64) ;
PROCEDURE VariantCtor (vt: PTR Ast.Node ;
                       RO tn: UTF ;
                       RO vn: UTF ;
                       argl: Ast.Kid ; nargs: I64 ;
                       VAR tag: UTF) : UTF ;

(* an integer-constant CASE label: local CONST or imported Mod.CONST *)
PROCEDURE ConstLbl (d: PTR Ast.Node) : UTF =
VAR
  ci : I64 ;
  ek : Ast.Kid ;
  res : UTF ;
BEGIN
  res := '' ;
  ek := NONE ;
  IF d.nkids = 0 THEN
    ci := MFind (consts, d.au) ;
    IF ci >= 0 THEN ek := consts.es[ci].v END
  ELSIF d.nkids = 1 THEN
    IF d.kids[0] IS SOME sf THEN
      IF sf.kind = Ast.NSelField THEN
        ci := MFind (extConsts, S3 (d.au, '.', sf.au)) ;
        IF ci >= 0 THEN ek := extConsts.es[ci].v END
      END
    END
  END ;
  IF ek IS SOME en THEN
    IF en.kind = Ast.NInt THEN res := S3 ('INT64_C(', en.au, ')') END
  END ;
  RETURN res
END ConstLbl ;

(* the declared type node a designator lands on (no code emitted) *)
(* the type a selector reaches: the checker's, from the typed tree,
   when it recorded one; else what this generator worked out itself
   (the review of 2026-10-09: one computation, the checker's) *)
PROCEDURE Checked (sel: PTR Ast.Node ; own: Ast.Kid) : Ast.Kid =
VAR ck : Ast.Kid ;
BEGIN
  ck := Ast.TypeAt (sel.id) ;
  IF ck IS SOME cx THEN RETURN ck END ;
  RETURN own
END Checked ;

PROCEDURE DesigDecl (d: PTR Ast.Node) : Ast.Kid =
VAR
  j : I64 ;
  cur, rk, px : Ast.Kid ;
  tmod : UTF ;
BEGIN
  tmod := '' ;
  cur := ScopeNode (d.au) ;
  FOR j := 0 TO d.nkids - 1 DO
    NoteMod (cur, tmod) ;
    rk := Resolve (cur) ;
    LOOP
      IF rk IS SOME rr THEN
        IF IsPtrK (rr.kind) THEN
          px := InMod (rr.kids[0], tmod) ;
          NoteMod (px, tmod) ;
          rk := Resolve (px)
        ELSE
          EXIT
        END
      ELSE
        EXIT
      END
    END ;
    IF rk IS SOME r2 THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r2.kind = Ast.NRecordType OR
             r2.kind = Ast.NMonitorType THEN
            cur := Checked (sel, InMod (FieldType (r2, sel.au), tmod))
          ELSE
            RETURN NONE
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r2.kind = Ast.NSliceType THEN cur := Checked (sel, InMod (r2.kids[0], tmod))
          ELSIF r2.kind = Ast.NArrayType THEN cur := Checked (sel, InMod (r2.kids[1], tmod))
          ELSIF r2.kind = Ast.NGridType THEN cur := Checked (sel, InMod (r2.kids[1], tmod))
          ELSE RETURN NONE END
        END
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN cur
END DesigDecl ;

(* exception descriptor reference by bare name: this module, the
   predeclared four, then imported definitions *)
(* A QUALIFIED name resolves in exactly the module it states:
   Io.IOError and ZarrStore.IOError (StoreError since 2026-09-27) were two descriptors, and the
   first version dropped the qualifier and answered whichever module
   registered the bare name first -- a handler for ZarrStore.IOError
   compiled to a test against &Io_IOError and matched nothing.
   Found by the tutorial service's no-network zarr cell; the FPC
   twin carried the same defect and both are fixed together.        *)
(* IndexError (index, length : I64) as the field sequence a declared
   exception would have parsed to *)
PROCEDURE IxFields () : Ast.Kid =
VAR fs, g, il, i1, i2, ty : PTR Ast.Node IN gpool ;
BEGIN
  IF ixFields IS SOME have THEN RETURN SOME (have) END ;
  fs := Ast.NewNode (gpool, Ast.NFieldSeq, 0, 0) ;
  g := Ast.NewNode (gpool, Ast.NFieldGroup, 0, 0) ;
  il := Ast.NewNode (gpool, Ast.NIdentList, 0, 0) ;
  i1 := Ast.NewNode (gpool, Ast.NIdent, 0, 0) ;
  Ast.SetA (gpool, i1, 'index') ;
  i2 := Ast.NewNode (gpool, Ast.NIdent, 0, 0) ;
  Ast.SetA (gpool, i2, 'length') ;
  ty := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
  Ast.SetA (gpool, ty, 'I64') ;
  Ast.Add (gpool, il, SOME (i1)) ;
  Ast.Add (gpool, il, SOME (i2)) ;
  Ast.Add (gpool, g, SOME (il)) ;
  Ast.Add (gpool, g, SOME (ty)) ;
  Ast.Add (gpool, fs, SOME (g)) ;
  ixFields := SOME (fs) ;
  RETURN ixFields
END IxFields ;

PROCEDURE ExcRef (RO qual: UTF ; RO nm: UTF ;
                  VAR fields: Ast.Kid) : UTF =
VAR i : I64 ;
BEGIN
  fields := NONE ;
  IF Text.BLen (qual) > 0 AND NOT Text.Eq (qual, modName) THEN
    FOR i := 0 TO extExcs.n - 1 DO
      IF Text.Eq (extExcs.es[i].k, nm) AND
         Text.Eq (extExcs.es[i].t, qual) THEN
        fields := extExcs.es[i].v ;
        RETURN S3 (CP (qual), '_', nm)
      END
    END ;
    RETURN ''
  END ;
  FOR i := 0 TO nxcs - 1 DO
    IF Text.Eq (xcs[i].name, nm) THEN
      fields := xcs[i].fields ;
      RETURN S3 (CP (modName), '_', nm)
    END
  END ;
  IF Text.Eq (nm, 'IndexError') THEN
    (* the predeclared payload every index check writes: err->i[0]
       and err->i[1], the index and the length as the check saw them
       (report par 5, 2026-10-09) *)
    fields := IxFields () ;
    RETURN 'm9_exc_IndexError'
  END ;
  IF Text.Eq (nm, 'Overflow') OR
     Text.Eq (nm, 'OutOfMemory') OR Text.Eq (nm, 'ValueRange') THEN
    RETURN S2 ('m9_exc_', nm)
  END ;
  i := MFind (extExcs, nm) ;
  IF i >= 0 THEN
    fields := extExcs.es[i].v ;
    RETURN S3 (CP (extExcs.es[i].t), '_', nm)
  END ;
  RETURN ''
END ExcRef ;

(* the OPT payload type of an IS SOME operand: a designator's declared
   type or a call's return type *)
PROCEDURE OptInner (k: Ast.Kid) : Ast.Kid =
VAR
  r, res : Ast.Kid ;
  nm : UTF ;
  pi, dot : I64 ;
  q, pn : PTR Ast.Node IN gpool ;
BEGIN
  res := NONE ;
  r := NONE ;
  dot := -1 ;
  nm := '' ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      r := Resolve (DesigDecl (e))
    ELSIF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        nm := dn.au ;
        IF dn.nkids = 1 THEN
          IF dn.kids[0] IS SOME sf THEN
            IF sf.kind = Ast.NSelField THEN nm := S3 (nm, '.', sf.au) END
          END
        END ;
        dot := FindCh (nm, '.') ;
        IF dot >= 0 THEN
          pi := MFind (extProcs, nm) ;
          IF pi >= 0 THEN
            IF extProcs.es[pi].v IS SOME ep THEN
              r := Resolve (ep.kids[1])
            END
          END
        ELSE
          pi := FindProcN (nm) ;
          IF pi >= 0 THEN
            IF gps[pi].node IS SOME lp THEN r := Resolve (lp.kids[1]) END
          END
        END
      END
    END ;
    IF r IS SOME rn THEN
      IF rn.kind = Ast.NOptType THEN res := rn.kids[0] END
    END ;
    (* an extern return type names its OWN module's types bare: qualify *)
    IF e.kind = Ast.NCallExpr AND dot >= 0 THEN
      IF res IS SOME rp THEN
        IF rp.kind = Ast.NPtrType THEN
          IF rp.kids[0] IS SOME rq THEN
            IF rq.kind = Ast.NQualident AND Text.BLen (rq.bu) = 0 THEN
              IF NOT IsBuiltin (rq.au) THEN
                q := Ast.NewNode (gpool, Ast.NQualident, 0, 0) ;
                Ast.SetA (gpool, q, Text.Keep (gpool, SLICE (nm, 0, dot))) ;
                Ast.SetB (gpool, q, rq.au) ;
                pn := Ast.NewNode (gpool, Ast.NPtrType, 0, 0) ;
                Ast.Add (gpool, pn, SOME (q)) ;
                Ast.Add (gpool, pn, NONE) ;
                res := SOME (pn)
              END
            END
          END
        END
      END
    END
  END ;
  RETURN res
END OptInner ;

(* the typed tree's stage 3: the generator's tag for the checker's
   canonical type string -- one map, so that the tag is read off what
   the checker decided instead of worked out again.  A named type is
   fully qualified there (Mod.T, aliases resolved), so it is looked up
   by its whole name: this module's own, or an imported one's.  '?' for
   what has no tag (unknown, C.*, <void>) *)
PROCEDURE TagOfCanon (RO s: UTF) : UTF =
VAR
  dot, i, ei : I64 ;
  m, t : UTF ;
  n : Ast.Kid ;
BEGIN
  IF Text.BLen (s) = 0 THEN RETURN '?' END ;
  IF Text.Eq (s, '<int>') THEN RETURN 'I64' END ;
  IF Text.Eq (s, '<real>') THEN RETURN 'F64' END ;
  IF Text.Eq (s, '<str1>') THEN RETURN 'STR1' END ;
  IF Text.Eq (s, '<none>') THEN RETURN 'OPTPTR' END ;
  IF Text.Eq (s, 'POOL') THEN RETURN 'POOL' END ;
  IF Text.OneOf (STR (s), CanonBuiltins) THEN RETURN s END ;
  IF Text.Eq (s, 'SLICE OF <u8>') THEN RETURN 'UTF' END ;
  IF StartsW (s, 'SLICE OF ') THEN RETURN 'SLICE' END ;
  IF StartsW (s, 'GRID ') THEN RETURN 'GRID' END ;
  IF StartsW (s, 'ARRAY ') THEN RETURN 'ARR' END ;
  IF StartsW (s, 'PTR ') THEN RETURN 'PTR' END ;
  IF StartsW (s, 'SHARED PTR ') THEN RETURN 'SHARED' END ;
  IF StartsW (s, 'OPT ') THEN RETURN 'OPTPTR' END ;
  IF StartsW (s, 'PROCEDURE') THEN RETURN 'PROC' END ;
  IF StartsW (s, '<') OR StartsW (s, 'C.') THEN RETURN '?' END ;
  dot := -1 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) = 32 THEN RETURN '?' END ;
    IF B (s, i) = ORD ('.') AND dot < 0 THEN dot := i END
  END ;
  IF dot <= 0 THEN RETURN '?' END ;
  m := SLICE (s, 0, dot) ;
  t := SLICE (s, dot + 1, Text.BLen (s) - dot - 1) ;
  n := NONE ;
  IF Text.Eq (m, modName) THEN
    n := FindTypeN (t)
  ELSE
    ei := MFind (extTypes, s) ;
    IF ei >= 0 THEN n := extTypes.es[ei].v END
  END ;
  IF n IS SOME nd THEN
    IF nd.kind = Ast.NCaseRecordType OR nd.kind = Ast.NEnumType THEN
      IF Text.Eq (m, modName) THEN RETURN S2 ('CR:', t) END ;
      RETURN S2 ('CR:', s)
    END ;
    IF nd.kind = Ast.NRecordType OR nd.kind = Ast.NMonitorType THEN
      RETURN 'REC'
    END
  END ;
  RETURN '?'
END TagOfCanon ;

(* what the checker did not record: a literal it typed by another
   path (a CONST's expression, an argument checked against its
   parameter), and the operators over such values.  Everything else --
   a designator, a call, a NEW, SLICE, GRID, NONE -- the checker
   records; until the typed tree's stage 3 this procedure worked those
   out too, by re-running DES and CallC "dry", and measured over the
   library and 160 files of the three applications it contributed
   nothing once the RAISE payload was typed (decision 43) *)
PROCEDURE TagOfExprOwn (k: Ast.Kid) : UTF =
VAR
  t2, u2, res : UTF ;
BEGIN
  IF k IS SOME e THEN
    res := '?' ;
    CASE e.kind OF
    | Ast.NInt : res := 'I64'
    | Ast.NReal : res := 'F64'
    | Ast.NChar : res := 'CHAR'
    | Ast.NString :
        IF Text.CpCount (e.au) = 1 THEN res := 'STR1' ELSE res := 'SLICE' END
    | Ast.NTrue : res := 'BOOL'
    | Ast.NFalse : res := 'BOOL'
    | Ast.NParen : res := TagOfExpr (e.kids[0])
    | Ast.NBin :
        IF Text.Eq (e.au, 'AND') OR Text.Eq (e.au, 'OR') OR
           Text.Eq (e.au, '=') OR Text.Eq (e.au, '#') OR
           Text.Eq (e.au, '<') OR Text.Eq (e.au, '<=') OR
           Text.Eq (e.au, '>') OR Text.Eq (e.au, '>=') THEN
          RETURN 'BOOL'
        END ;
        t2 := TagOfExpr (e.kids[0]) ;
        IF Text.Eq (t2, 'I64') THEN t2 := TagOfExpr (e.kids[1]) END ;
        (* and a real literal adapts the same way *)
        IF IsAdaptive (e.kids[0]) THEN t2 := TagOfExpr (e.kids[1]) END ;
        (* a string concatenation is a STRING whatever its left
           operand's own tag: a one-character literal, or a CHAR
           prepended to a string (par 2.3, revised 2026-09-06) *)
        IF Text.Eq (e.au, '+') AND
           (Text.Eq (t2, 'STR1') OR Text.Eq (t2, 'CHAR')) THEN
          u2 := TagOfExpr (e.kids[1]) ;
          IF Text.Eq (t2, 'STR1') OR Text.Eq (u2, 'SLICE') OR
             Text.Eq (u2, 'STR1') THEN
            t2 := 'SLICE'
          END
        END ;
        res := t2
    | Ast.NUn :
        IF Text.Eq (e.au, 'NOT') THEN res := 'BOOL'
        ELSE res := TagOfExpr (e.kids[0]) END
    ELSE
      res := '?'
    END ;
    RETURN res
  END ;
  RETURN '?'
END TagOfExprOwn ;

(* an expression's tag: the checker's type, recorded where it computed
   it (stage 3), when there is one; else the generator works it out --
   for a literal the checker typed by another path, a CONST's
   expression, and anything the checker did not know.  Measured over
   the library the day it was built: where both answered, they agreed
   but at one binder, where the checker's was the more precise *)
PROCEDURE TagOfExpr (k: Ast.Kid) : UTF =
VAR t : UTF ;
BEGIN
  IF k IS SOME e THEN
    t := TagOfCanon (Ast.TyStrAt (e.id)) ;
    IF NOT Text.Eq (t, '?') THEN RETURN t END
  END ;
  RETURN TagOfExprOwn (k)
END TagOfExpr ;

(* ---- designators ---- *)

(* the C address of the pool a NEW's first argument names: a POOL
   variable or HEAP by designator, or a VAR parameter's hidden pool
   (rule 2), which is a pointer already *)
PROCEDURE PoolAddrC (pd: PTR Ast.Node) : UTF =
VAR tg : UTF ;
BEGIN
  IF pd.nkids = 0 AND Text.Eq (ScopeMode (pd.au), 'v') AND
     PoolParamTy (ScopeNode (pd.au)) THEN
    RETURN S2 (CN (pd.au), '_pool')
  END ;
  tg := '?' ;
  RETURN S3 ('&(', DES (pd, tg), ')')
END PoolAddrC ;

(* the pool of the object a designator names, from its ROOT (rule 2
   of docs/pool-elision-plan.md): a VAR parameter's hidden pool; a
   binder's origin's; a local's IN clause, else this frame's arena
   (the result slot, which is the caller's in a pointer-answering
   function); a module variable's IN clause, else the module frame.
   The checker refused every root this cannot name (Sem.ObjPoolIssue),
   so the arena answered for the rest is never reached. *)
(* is the name another module's exported variable, `Mod.v' (decision
   28: it is in scope in VAR-parameter mode under its dotted name) *)
PROCEDURE Exported (RO nm: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (ScopeMode (nm), 'v') AND Text.FindChar (nm, '.') > 0
END Exported ;

PROCEDURE ObjPoolC (a: PTR Ast.Node) : UTF =
VAR
  m : UTF ;
  ix, i : I64 ;
  t : Ast.Kid ;
BEGIN
  m := ScopeMode (a.au) ;
  IF Text.Eq (m, 'v') THEN
    IF PoolParamTy (ScopeNode (a.au)) THEN RETURN S2 (CN (a.au), '_pool') END ;
    (* another module's exported variable: the pool its exporter
       publishes for it (ExportVars) *)
    IF Exported (a.au) AND HasPtr (ScopeNode (a.au), 0) THEN RETURN S2 (CN (a.au), '_pool') END ;
    RETURN 'err->res'
  END ;
  IF Text.Eq (m, 'b') THEN
    i := bpool.n - 1 ;
    WHILE i >= 0 DO
      IF Text.Eq (bpool.es[i].k, a.au) THEN RETURN bpool.es[i].t END ;
      i := i - 1
    END ;
    RETURN 'err->res'
  END ;
  IF Text.Eq (m, 'l') THEN
    t := ScopeNode (a.au) ;
    IF t IS SOME tn THEN
      IF tn.kind = Ast.NOptType THEN t := tn.kids[0] END
    END ;
    IF Resolve (t) IS SOME r THEN
      IF r.kind = Ast.NPtrType THEN
        IF r.kids[1] IS SOME pn THEN RETURN PoolAddrC (pn) END
      END
    END ;
    ix := ScopeFind (a.au) ;
    IF ix >= mvBase AND ix < mvBase + nmv THEN RETURN '&m9mframe' END ;
    RETURN 'err->res'
  END ;
  RETURN 'err->res'
END ObjPoolC ;

(* a binder's pool is its origin's when the origin is a designator,
   else the arena a call's answer lands in *)
PROCEDURE OriginPool (k: Ast.Kid) : UTF =
BEGIN
  IF k IS SOME o THEN
    IF o.kind = Ast.NDesignator THEN RETURN ObjPoolC (o) END
  END ;
  RETURN 'err->res'
END OriginPool ;

(* the selectors of d from kid FROM on, applied to the C expression
   RES of type TND: a designator's from its name (DES), a call's
   answer -- F (x).f, NCallSel -- from the temporary holding it *)
(* the error test before a step THROUGH what a subscript answered
   (2026-10-21, the compiler review's G3).  A failed index answers the
   runtime's one poison cell, and the error was tested only after the
   whole designator: a failed `s[9].q := live' left live's pointer in
   the cell, and the next failed `s[8].q.n := 77' wrote through it
   into live.  So before a pointer is followed, or a slice or grid
   descriptor read out of an element is subscripted, the prefix's
   value goes through a statement expression that leaves on the error
   -- the shape the call-selection of decision 46 uses.  A field of an
   element, or an inline array's subscript, stays inside the cell and
   needs none. *)
PROCEDURE AtGuard (RO res: UTF ; tnd: Ast.Kid) : UTF =
BEGIN
  RETURN S7 ('({ ', TyC (tnd), ' m9g = (', res, '); if (err->exc) goto ',
    raiseLbl, '; m9g; })')
END AtGuard ;

(* the test before following a pointer READ OUT OF A FIELD OR AN
   ELEMENT (2026-10-21, the compiler review's C8): a PTR field of a
   record that arrived zeroed holds NULL until it is set, and following
   it was a SIGSEGV; now IndexError (-1, 0), raised by m9_unset (m9rt.h
   says why).  With pend, a failed subscript's error is tested first,
   as AtGuard does. *)
(* is the bare name a MODULE variable -- this module's, or another's
   exported `Mod.v' -- or a VAR parameter?  A zeroed static like a
   zeroed record's field: a pointer in one that is not OPT holds NULL
   until set, and any procedure may read it, so no rule at the source
   can say it was set; a VAR parameter is the caller's storage itself,
   which may be such a static, an output nobody filled (2026-10-21,
   soundfuzz's first findings) *)
PROCEDURE ModVarRoot (RO nm: UTF) : BOOL =
VAR ix : I64 ;
BEGIN
  IF Text.Eq (ScopeMode (nm), 'v') THEN RETURN TRUE END ;
  IF NOT Text.Eq (ScopeMode (nm), 'l') THEN RETURN FALSE END ;
  ix := ScopeFind (nm) ;
  RETURN ix >= mvBase AND ix < mvBase + nmv
END ModVarRoot ;

PROCEDURE NnGuard (RO res: UTF ; tnd: Ast.Kid ; pend: BOOL) : UTF =
VAR e : UTF ;
BEGIN
  e := '' ;
  IF pend THEN e := S3 ('if (err->exc) goto ', raiseLbl, '; ') END ;
  (* the temporary's type by __typeof__, not by name: a type of a
     module this unit does not import directly has no name here --
     `Obs.f' of type PTR Frame.Fr in a notebook's show cell failed with
     `unknown name: Frame.Fr' from the first build of this guard
     (2026-10-21) until 2026-10-22 *)
  (* __auto_type, not __typeof__ (res): res is the level below, and
     repeating it doubled the C per selector (the second review's fuzz
     N2: twenty `.p' steps took 1.2 GB) *)
  RETURN S9 ('({ __auto_type m9g = (', res, '); ', '', '', e,
    'if (__builtin_expect (m9g == NULL, 0)) { m9_unset (err); goto ', raiseLbl, '; } m9g; })')
END NnGuard ;

PROCEDURE DESSel (d: PTR Ast.Node ; from: I64 ; RO res0: UTF ;
                  tnd0: Ast.Kid ; VAR tag: UTF) : UTF =
VAR
  j, jj, rk : I64 ;
  tnd, r2, px : Ast.Kid ;
  res, base, ix, ec, cnt, tmod : UTF ;
  dg, dns : PTR DynUtf.DString IN gpool ;
  fldOk, enumIx, pendAt, viaSel : BOOL ;
BEGIN
  res := res0 ;
  pendAt := FALSE ;
  viaSel := FALSE ;      (* the value in hand was read out of a field or an element *)
  (* or out of a module variable, which is one more zeroed static *)
  IF from = 0 THEN viaSel := ModVarRoot (d.au) END ;
  tnd := tnd0 ;
  tmod := '' ;
  FOR j := from TO d.nkids - 1 DO
    NoteMod (tnd, tmod) ;
    r2 := Resolve (tnd) ;
    (* a subscript through a pointer reaches what it points to, as the
       checker's DesigDeclType has it; a field through a pointer is
       the -> below *)
    IF d.kids[j] IS SOME s0 THEN
      IF s0.kind = Ast.NSelIndex THEN
        IF r2 IS SOME rp THEN
          IF IsPtrK (rp.kind) THEN
            px := InMod (rp.kids[0], tmod) ;
            NoteMod (px, tmod) ;
            r2 := Resolve (px) ;
            IF viaSel THEN
              res := NnGuard (res, tnd, pendAt) ;
              pendAt := FALSE
            ELSIF pendAt THEN
              res := AtGuard (res, tnd) ;
              pendAt := FALSE
            END ;
            res := S3 ('(*', res, ')')
          END
        END
      END
    END ;
    IF r2 IS SOME r THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF IsPtrK (r.kind) THEN
            (* the target's module noted, so that its fields' bare type
               names are read where they were declared -- the step the
               checker took and this generator did not, until the
               review of 2026-10-09 (the enumeration compare of b6e7507
               and `CASE q.kind' were both this) *)
            px := InMod (r.kids[0], tmod) ;
            NoteMod (px, tmod) ;
            IF Resolve (px) IS SOME inner THEN
              IF inner.kind # Ast.NRecordType AND
                 inner.kind # Ast.NMonitorType THEN
                ErrAt (d,
                  'selection through a non-record unsupported yet') ;
                RETURN '0'
              END ;
              IF viaSel THEN
                res := NnGuard (res, tnd, pendAt) ;
                pendAt := FALSE
              ELSIF pendAt THEN
                res := AtGuard (res, tnd) ;
                pendAt := FALSE
              END ;
              res := S3 (res, '->', CN (sel.au)) ;
              tnd := Checked (sel, InMod (FieldType (inner, sel.au), tmod))
            ELSE
              ErrAt (d, 'field base type unresolvable') ;
              RETURN '0'
            END
          ELSIF r.kind = Ast.NRecordType OR
                r.kind = Ast.NMonitorType THEN
            res := S3 (res, '.', CN (sel.au)) ;
            tnd := Checked (sel, InMod (FieldType (r, sel.au), tmod))
          ELSE
            ErrAt (d,
              'selection through a non-record unsupported yet') ;
            RETURN '0'
          END ;
          fldOk := FALSE ;
          IF tnd IS SOME t1 THEN fldOk := TRUE END ;
          IF NOT fldOk THEN
            ErrAt (d, S2 ('unknown record field: ', sel.au)) ;
            RETURN '0'
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            (* every axis against its own extent: the check a
               hand-rolled d[r * cols + c] cannot make *)
            IF pendAt THEN res := AtGuard (res, tnd) ; pendAt := FALSE END ;
            base := res ;
            ec := TyC (r.kids[1]) ;
            dg := DynUtf.New (gpool) ;
            FOR jj := 0 TO sel.nkids - 1 DO
              IF jj > 0 THEN DynUtf.Append (dg, ', ') END ;
              DynUtf.Append (dg, EX (sel.kids[jj], ''))
            END ;
            cnt := ArrCount2 (r.kids[0]) ;
            rk := sel.nkids ;
            IF rk >= 1 AND rk <= 4 THEN
              (* ranks 1..4 go to the written-out form: extents and
                 strides by value, no index array, no loop over the
                 rank.  2.60x -> 1.29x on the port's kernel, with
                 the same checks -- see runtime/m9rt.h and
                 the port's gat_cost.c. *)
              dns := DynUtf.New (gpool) ;
              DynUtf.Append (dns, '(*(') ;
              DynUtf.Append (dns, ec) ;
              DynUtf.Append (dns, ' *) m9_gat') ;
              DynUtf.Append (dns, ItoA (rk)) ;
              DynUtf.Append (dns, ' (') ;
              DynUtf.Append (dns, base) ;
              DynUtf.Append (dns, '.p, sizeof (') ;
              DynUtf.Append (dns, ec) ;
              DynUtf.Append (dns, '), ') ;
              FOR jj := 0 TO rk - 1 DO
                DynUtf.Append (dns, base) ;
                DynUtf.Append (dns, '.n[') ;
                DynUtf.Append (dns, ItoA (jj)) ;
                DynUtf.Append (dns, '], ')
              END ;
              FOR jj := 0 TO rk - 1 DO
                DynUtf.Append (dns, base) ;
                DynUtf.Append (dns, '.s[') ;
                DynUtf.Append (dns, ItoA (jj)) ;
                DynUtf.Append (dns, '], ')
              END ;
              DynUtf.Append (dns, DynUtf.ViewIn (gpool, dg)) ;
              DynUtf.Append (dns, ', err))') ;
              res := DynUtf.ViewIn (gpool, dns)
            ELSE
              res := S9 ('(*(', ec, ' *) m9_gat (', base, '.p, sizeof (',
                ec, '), ', base,
                S9 ('.n, ', base, '.s, (int64_t[]){', DynUtf.ViewIn (gpool, dg),
                    '}, ', cnt, ', err))', '', ''))
            END ;
            pendAt := TRUE ;
            tnd := Checked (sel, InMod (r.kids[1], tmod))
          ELSE
          ix := EX (sel.kids[0], '') ;
          IF r.kind = Ast.NSliceType THEN
            IF pendAt THEN res := AtGuard (res, tnd) ; pendAt := FALSE END ;
            base := res ;
            ec := TyC (r.kids[0]) ;
            res := S9 ('(*(', ec, ' *) m9_at (', base, '.p, ', ix,
              ', ', base, S5 ('.len, sizeof (', ec, '), err))', '', '')) ;
            pendAt := TRUE ;
            tnd := Checked (sel, InMod (r.kids[0], tmod))
          ELSIF r.kind = Ast.NArrayType THEN
            base := res ;
            ec := TyC (r.kids[1]) ;
            (* ARRAY Colour OF T: the subscript is an enum value, its
               tag 0..n-1 by construction -- no runtime bounds check,
               a.v[(k).tag] directly.  Detect it from the SUBSCRIPT's
               type, not the array's bound: an imported enum indexes an
               imported record's field the same way, where the bound
               name resolves only in its own module (docs/enum-plan.md,
               part 2) *)
            enumIx := FALSE ;
            IF ArrEnumBoundNode (r.kids[0]) IS SOME earr THEN
              enumIx := TRUE
            END ;
            IF NOT enumIx THEN
              IF sel.nkids >= 1 THEN
                enumIx := StartsW (TagOfExpr (sel.kids[0]), 'CR:')
              END
            END ;
            IF enumIx THEN
              res := S5 ('(', base, '.v[(', ix, ').tag])') ;
              tnd := Checked (sel, InMod (r.kids[1], tmod))
            ELSE
              cnt := ArrCount2 (r.kids[0]) ;
              res := S9 ('(*(', ec, ' *) m9_at (', base, '.v, ', ix,
                ', INT64_C(', cnt, S5 ('), sizeof (', ec, '), err))',
                '', '')) ;
              pendAt := TRUE ;
              tnd := Checked (sel, InMod (r.kids[1], tmod))
            END
          ELSE
            ErrAt (d, 'index into a non-array unsupported yet') ;
            RETURN '0'
          END
          END
        END
      END
    ELSE
      ErrAt (d, 'selector form unsupported yet') ;
      RETURN '0'
    END ;
    viaSel := TRUE
  END ;
  tag := TagOfType (tnd) ;
  RETURN res
END DESSel ;

PROCEDURE DES (d: PTR Ast.Node ; VAR tag: UTF) : UTF =
VAR
  ci, j : I64 ;
  tnd : Ast.Kid ;
  res, base, ix : UTF ;
  known : BOOL ;
BEGIN
  tag := '?' ;
  tnd := ScopeNode (d.au) ;
  known := FALSE ;
  IF tnd IS SOME t0 THEN known := TRUE END ;
  IF NOT known THEN
    ci := MFind (consts, d.au) ;
    IF ci >= 0 THEN
      (* a MODULE const is a C declaration named Mod_Name; a
         PROCEDURE-LOCAL one has none, so its value is inlined at the
         use.  For a literal that is all a CONST ever was. *)
      IF ci >= constsBase THEN
        res := EX (consts.es[ci].v, '')
      ELSE
        res := S3 (CP (modName), '_', d.au)
      END ;
      tag := TagOfExpr (consts.es[ci].v) ;
      (* const slice indexing *)
      FOR j := 0 TO d.nkids - 1 DO
        IF d.kids[j] IS SOME sel THEN
          IF sel.kind = Ast.NSelIndex THEN
            base := res ;
            ix := EX (sel.kids[0], '') ;
            res := S7 ('(*(uint32_t *) m9_at (', base, '.p, ', ix,
              ', ', base, '.len, sizeof (uint32_t), err))') ;
            IF Text.Eq (tag, 'SLICE') THEN
              tag := 'CHAR'                    (* const strings only *)
            END
          END
        END
      END ;
      RETURN res
    END ;
    (* imported constant: Mod.Name (a #define in Mod.h) *)
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sf1 THEN
        IF sf1.kind = Ast.NSelField THEN
          ci := MFind (extConsts, S3 (d.au, '.', sf1.au)) ;
          IF ci >= 0 THEN
            tag := TagOfExpr (extConsts.es[ci].v) ;
            RETURN S3 (CP (d.au), '_', sf1.au)
          END
        END
      END
    END ;
    (* a top-level procedure named as a VALUE (par 2.2.3): its C
       function, this module's or an imported module's; the checker
       has already held its head to the procedure type it lands in *)
    IF d.nkids = 0 THEN
      IF FindProcN (d.au) >= 0 THEN
        tag := 'PROC' ;
        RETURN S3 (CP (modName), '_', d.au)
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sfp THEN
        IF sfp.kind = Ast.NSelField THEN
          IF MFind (extProcs, S3 (d.au, '.', sfp.au)) >= 0 THEN
            tag := 'PROC' ;
            RETURN S3 (CP (d.au), '_', sfp.au)
          END
        END
      END
    END ;
    (* payload-less variant constructor: Type.Variant *)
    IF FindTypeN (d.au) IS SOME vt THEN
      IF (vt.kind = Ast.NCaseRecordType OR vt.kind = Ast.NEnumType) AND d.nkids = 1 THEN
        IF d.kids[0] IS SOME sf2 THEN
          IF sf2.kind = Ast.NSelField THEN
            tag := S2 ('CR:', d.au) ;
            RETURN S7 ('((', CP (modName), '_', d.au, '){ .tag = ',
              S5 (CP (modName), '_', d.au, '_', sf2.au), ' })')
          END
        END
      END
    END ;
    (* and across a module: Mod.Type.Variant, the checker's spelling
       for an imported variant, refused here until 2026-09-15 *)
    IF MFind (extMods, d.au) >= 0 AND d.nkids = 2 THEN
      IF d.kids[0] IS SOME sfT THEN
        IF d.kids[1] IS SOME sfV THEN
          IF sfT.kind = Ast.NSelField AND sfV.kind = Ast.NSelField THEN
            ci := MFind (extTypes, S3 (d.au, '.', sfT.au)) ;
            IF ci >= 0 THEN
              IF extTypes.es[ci].v IS SOME xvt THEN
                IF xvt.kind = Ast.NCaseRecordType OR xvt.kind = Ast.NEnumType THEN
                  tag := S4 ('CR:', d.au, '.', sfT.au) ;
                  RETURN S7 ('((', CP (d.au), '_', sfT.au, '){ .tag = ',
                    S5 (CP (d.au), '_', sfT.au, '_', sfV.au), ' })')
                END
              END
            END
          END
        END
      END
    END ;
    (* HEAP: the predeclared pool that is never freed (par 4.3).  A
       name in both ends or neither -- the checker types it, so the
       generator emits it. *)
    IF Text.Eq (d.au, 'HEAP') AND d.nkids = 0 THEN
      tag := 'POOL' ;
      RETURN 'm9_heap'
    END ;
    ErrAt (d, S2 ('unknown name: ', d.au)) ;
    RETURN '0'
  END ;
  res := CN (d.au) ;
  IF Text.Eq (ScopeMode (d.au), 'v') OR
     Text.Eq (ScopeMode (d.au), 'o') THEN
    res := S3 ('(*', CN (d.au), ')')
  END ;
  RETURN DESSel (d, 0, res, tnd, tag)
END DES ;

(* ---- expressions ---- *)

(* is d, as a value, a non-OPT pointer read out of a field or an
   element (its last selector one of those, its declared type PTR or
   SHARED PTR)?  Then EX tests it for NULL (C8) *)
(* whether a FOR IN's iterand -- a slice -- holds pointers, by the type
   the checker recorded for it *)
PROCEDURE ForInPtr (k: Ast.Kid) : BOOL =
VAR
  t : UTF ;
  i : I64 ;
BEGIN
  IF k IS SOME e THEN
    t := Ast.TyStrAt (e.id) ;
    IF Text.StartsWith (t, 'RO ') THEN t := SLICE (t, 3, Text.BLen (t) - 3) END ;
    (* an ARRAY n OF PTR too (the fourth review's M2: no guard, SIGSEGV) *)
    IF Text.StartsWith (t, 'ARRAY ') THEN
      i := Text.FindUtf (t, ' OF ') ;
      IF i > 0 THEN t := S2 ('SLICE', SLICE (t, i, Text.BLen (t) - i)) END
    END ;
    RETURN Text.StartsWith (t, 'SLICE OF PTR ') OR Text.StartsWith (t, 'SLICE OF SHARED PTR ')
  END ;
  RETURN FALSE
END ForInPtr ;

(* is the designator's declared type OPT over a SHARED handle *)
PROCEDURE OptShared (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME d THEN
    IF Resolve (DesigDecl (d)) IS SOME t THEN
      IF t.kind = Ast.NOptType THEN
        IF Resolve (t.kids[0]) IS SOME u THEN RETURN u.kind = Ast.NSharedType END
      END
    END
  END ;
  RETURN FALSE
END OptShared ;

(* a SHARED or OPT SHARED handle read out of a BINDING (a name, a
   field, an element; SOME of one): storing it anywhere is a second
   holder, which counts.  SHARED (o) and a call's answer are not
   bindings -- they hand over a count of their own *)
PROCEDURE SharedBinding (k: Ast.Kid) : BOOL =
VAR sop : Ast.Kid ;
BEGIN
  sop := k ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen THEN sop := e.kids[0] END
  END ;
  IF sop IS SOME so THEN
    RETURN so.kind = Ast.NDesignator AND (Text.Eq (TagOfExpr (sop), 'SHARED') OR OptShared (sop))
  END ;
  RETURN FALSE
END SharedBinding ;

(* RETURN of a bare local or OWN parameter hands its count over (a
   move); any other binding is copied, so that every answer carries a
   count of its own and `x := Id (h) ; DISPOSE (x)' leaves h alive *)
PROCEDURE SharedReturnMoves (k: Ast.Kid) : BOOL =
VAR sop : Ast.Kid ;
BEGIN
  sop := k ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen THEN sop := e.kids[0] END
  END ;
  IF sop IS SOME so THEN
    IF so.kind = Ast.NDesignator AND so.nkids = 0 THEN
      IF Text.Eq (ScopeMode (so.au), 'o') THEN RETURN TRUE END ;
      RETURN Text.Eq (ScopeMode (so.au), 'l') AND NOT ModVarRoot (so.au)
    END
  END ;
  RETURN FALSE
END SharedReturnMoves ;

PROCEDURE NnCopy (d: PTR Ast.Node) : BOOL =
BEGIN
  IF d.nkids = 0 AND NOT ModVarRoot (d.au) THEN RETURN FALSE END ;
  IF d.nkids > 0 THEN
    IF d.kids[d.nkids - 1] IS SOME ls THEN
      IF ls.kind # Ast.NSelField AND ls.kind # Ast.NSelIndex THEN RETURN FALSE END
    END
  END ;
  IF Resolve (DesigDecl (d)) IS SOME dt THEN
    RETURN dt.kind = Ast.NPtrType OR dt.kind = Ast.NSharedType
  END ;
  RETURN FALSE
END NnCopy ;

PROCEDURE EX (k: Ast.Kid ; RO want: UTF) : UTF =
VAR
  callRaise : BOOL ;
  l, r, lt, rt, w, tg, cop, a1, a2, cnt, res, sh : UTF ;
  d2 : PTR DynUtf.DString IN gpool ;
  jj, rk, ext0, nx : I64 ;
  isCat : BOOL ;
  inr, tyk : Ast.Kid ;
  isx : UTF ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NInt :
        (* an unsigned context spells the literal UINT64_C: INT64_C of
           a value past 2^63 warned in C (the value was right) *)
        IF Text.Eq (want, 'U64') THEN RETURN S3 ('UINT64_C(', e.au, ')') END ;
        RETURN S3 ('INT64_C(', e.au, ')')
    | Ast.NReal :
        (* NaN's NAN is a float already, and the same NaN as a double *)
        IF Text.Eq (want, 'F32') AND NOT Text.Eq (e.au, 'NAN') THEN
          RETURN S2 (e.au, 'f')
        END ;
        RETURN e.au
    | Ast.NChar : RETURN S2 (ItoA (CharVal (e.au)), 'u')
    | Ast.NString :
        IF Text.Eq (want, 'UTF') THEN
          (* a literal where a UTF is wanted is its UTF-8 octets, in
             static storage as every literal is *)
          IF Text.BLen (e.au) = 0 THEN RETURN '((m9_sl_UTF8){ NULL, 0 })' END ;
          l := S2 ('m9s', ItoA (litN)) ;
          Line (KLit, 0, S7 ('static const uint8_t ', l, '[',
            ItoA (Utf8Len (e.au)), '] = { ', Utf8Codes (e.au), ' };')) ;
          RETURN S5 ('((m9_sl_UTF8){ (uint8_t *) ', l, ', ',
            ItoA (Utf8Len (e.au)), ' })')
        ELSIF Text.Eq (want, 'CHAR') AND Text.CpCount (e.au) = 1 THEN
          RETURN S2 (ItoA (ORD (Text.CpAt (e.au, 0))), 'u')
        ELSIF Text.BLen (e.au) = 0 THEN
          RETURN '(m9_sl_CHAR){ NULL, 0 }'
        ELSE
          (* static storage, never a stack compound literal: a returned
             literal (Reason's 'Not Found') must not dangle *)
          l := S2 ('m9s', ItoA (litN)) ;
          Line (KLit, 0, S7 ('static const uint32_t ', l, '[',
            ItoA (Text.CpCount (e.au)), '] = { ', StrCodes (e.au), ' };')) ;
          RETURN S5 ('((m9_sl_CHAR){ (uint32_t *) ', l, ', ',
            ItoA (Text.CpCount (e.au)), ' })')
        END
    | Ast.NTrue : RETURN 'true'
    | Ast.NFalse : RETURN 'false'
    | Ast.NNoneLit : RETURN 'NULL'
    | Ast.NSomeExpr : RETURN EX (e.kids[0], '')  (* OPT PTR is nullable *)
    | Ast.NSharedExpr :
        (* rc lives in the hidden header: rc := 1 in place (par 11) *)
        l := EX (e.kids[0], '') ;
        RETURN S5 ('((__typeof__(', l, ')) m9_share (', l, '))')
    | Ast.NParen : RETURN S3 ('(', EX (e.kids[0], want), ')')
    | Ast.NDesignator :
        (* a string CONST where a UTF is wanted is its literal's
           octets, as the literal itself is (decision 66, 2026-10-23) *)
        IF Text.Eq (want, 'UTF') THEN
          IF ConstValue (k) IS SOME cvu THEN
            IF cvu.kind = Ast.NString THEN RETURN EX (ConstValue (k), 'UTF') END
          END
        END ;
        (* a one-character string CONST where a CHAR is wanted is that
           character, as the literal itself is (a C error until
           2026-10-09: the CONST's slice macro landed in a uint32_t) *)
        IF Text.Eq (want, 'CHAR') THEN
          IF ConstValue (k) IS SOME cvc THEN
            IF cvc.kind = Ast.NString AND Text.CpCount (cvc.au) = 1 THEN
              RETURN S2 (ItoA (ORD (Text.CpAt (cvc.au, 0))), 'u')
            END
          END
        END ;
        tg := '?' ;
        res := DES (e, tg) ;
        (* a pointer READ OUT OF A FIELD OR AN ELEMENT and copied as a
           value is tested before it travels on (2026-10-21, the review's
           C8): a NULL in a zeroed record's PTR field would otherwise
           reach a local or a parameter and fail where nothing tests *)
        (* or out of a module variable or a VAR parameter (soundfuzz) *)
        IF NnCopy (e) THEN
          res := S3 ('({ __auto_type m9n = (', res, '); (__typeof__ (m9n)) m9_nn ((void *) m9n, err); })')
        END ;
        (* a CONST is a C macro holding a double literal, so in an
           F32 context it must be cast or the expression widens
           around it *)
        IF Text.Eq (want, 'F32') THEN
          IF ConstValue (k) IS SOME cv2 THEN
            IF IsAdaptive (k) THEN RETURN S3 ('((float) ', res, ')') END
          END
        END ;
        RETURN res
    | Ast.NCallExpr :
        tg := '?' ;
        RETURN CallC (e.kids[0], e.kids[1], tg)
    | Ast.NCallSel :
        (* F (x).f, F (x)[i]: the answer into a temporary of the
           callee's declared result type -- the checker recorded it on
           this node -- the error slot read before anything is
           selected, then the selectors as a designator's (DESSel) *)
        IF Ast.TypeAt (e.id) IS SOME rty THEN
          l := EX (e.kids[0], '') ;
          callRaise := LeftRaises (e.kids[0]) ;
          w := NewTmp () ;
          tg := '?' ;
          r := DESSel (e, 1, w, Ast.TypeAt (e.id), tg) ;
          res := S5 ('({ ', TyC (Ast.TypeAt (e.id)), ' ', w, S3 (' = ', l, '; ')) ;
          IF callRaise THEN
            res := S4 (res, 'if (err->exc) goto ', raiseLbl, '; ')
          END ;
          RETURN S3 (res, r, '; })')
        END ;
        ErrAt (e, "selection from this call's answer unsupported yet") ;
        RETURN '0'
    | Ast.NNewExpr :
        sh := NewShape (e, tyk, ext0) ;
        IF Text.Eq (sh, 'own') THEN
          l := TyC (tyk) ;
          RETURN S5 ('(', l, ' *) m9_new (sizeof (', l, '), err)')
        END ;
        IF Text.Eq (sh, 'pool') THEN
          r := 'err->res' ;
          IF e.kids[0] IS SOME pd THEN r := PoolAddrC (pd) END
        ELSE
          (* the frame form: the result slot, which is this frame's
             arena in the body and the caller's while a RETURN
             expression is emitted -- `+`'s rule exactly (par 2.3),
             so `RETURN NEW (T, n)` lands where it is going *)
          r := 'err->res'
        END ;
        nx := 0 ;
        FOR jj := ext0 TO e.nkids - 1 DO
          IF e.kids[jj] IS SOME dm1 THEN nx := nx + 1 END
        END ;
        IF nx > 1 THEN
          (* more than one extent is a GRID.  Row-major: the last
             axis has stride 1, so an innermost loop over the
             rightmost subscript walks memory in order.  The oracle
             computes TyC, then the temp, then the grid typedef,
             then the extents in order -- side effects are part of
             the bytes, so the order is reproduced deliberately. *)
          l := TyC (tyk) ;
          w := NewTmp () ;
          rk := nx ;
          a1 := GridTy (tyk, ItoA (rk)) ;
          d2 := DynUtf.New (gpool) ;
          DynUtf.Append (d2, S5 ('({ ', a1, ' ', w, '; ')) ;
          FOR jj := ext0 TO e.nkids - 1 DO
            a2 := EX (e.kids[jj], '') ;
            DynUtf.Append (d2,
              S7 (w, '.n[', ItoA (jj - ext0), '] = ', a2, '; ', ''))
          END ;
          DynUtf.Append (d2,
            S5 (w, '.s[', ItoA (rk - 1), '] = 1; ', '')) ;
          jj := rk - 2 ;
          WHILE jj >= 0 DO
            DynUtf.Append (d2,
              S9 (w, '.s[', ItoA (jj), '] = ', w, '.s[',
                  ItoA (jj + 1), '] * ', w)) ;
            DynUtf.Append (d2,
              S5 ('.n[', ItoA (jj + 1), ']; ', '', '')) ;
            jj := jj - 1
          END ;
          DynUtf.Append (d2,
            S9 (w, '.p = (', l, ' *) m9_pool_alloc (', r,
                ', sizeof (', l, '), m9_gcount (', w)) ;
          DynUtf.Append (d2,
            S7 ('.n, ', ItoA (rk), ', err), err); ', w, '; })', '', '')) ;
          RETURN DynUtf.ViewIn (gpool, d2)
        ELSIF nx = 1 THEN
          l := TyC (tyk) ;
          a1 := SliceTy (tyk) ;          (* oracle order: TyC, then *)
          a2 := EX (e.kids[ext0], '') ;  (* SliceTy, then the count *)
          RETURN S9 ('M9_POOL_SL (', a1, ', ', l,
            ', ', r, ', ', a2, ', err)')
        ELSE
          l := TyC (tyk) ;
          RETURN S7 ('(', l, ' *) m9_pool_alloc (', r,
            ', sizeof (', l, '), 1, err)')
        END
    | Ast.NGridOf :
        (* GRID (s, n0, ..., nR): a grid of the slice's element type
           laid over its storage, row-major; m9_gridof holds the
           extents to the length and raises IndexError, answering an
           empty grid (par 2.2.1, 2026-10-08) *)
        inr := NONE ;
        IF e.kids[0] IS SOME gds THEN
          IF gds.kind = Ast.NDesignator THEN inr := Resolve (DesigDecl (gds)) END
        END ;
        tyk := NONE ;
        IF inr IS SOME gin THEN
          IF gin.kind = Ast.NSliceType THEN tyk := gin.kids[0] END
        END ;
        IF tyk IS SOME gel THEN
          rk := e.nkids - 1 ;
          tg := GridTy (tyk, ItoA (rk)) ;
          l := EX (e.kids[0], '') ;
          w := NewTmp () ;
          d2 := DynUtf.New (gpool) ;
          DynUtf.Append (d2, S5 ('({ __auto_type ', w, ' = ', l, '; ')) ;
          DynUtf.Append (d2, S7 (tg, ' ', w, 'r; int64_t ', w, 'n[', ItoA (rk))) ;
          DynUtf.Append (d2, '] = { ') ;
          FOR jj := 1 TO e.nkids - 1 DO
            IF jj > 1 THEN DynUtf.Append (d2, ', ') END ;
            a1 := EX (e.kids[jj], '') ;
            DynUtf.Append (d2, a1)
          END ;
          DynUtf.Append (d2, S9 (' }; m9_gridof (', w, '.len, ', w, 'n, ', ItoA (rk), ', ', w, 'r.n, ')) ;
          DynUtf.Append (d2, S7 (w, 'r.s, err); ', w, 'r.p = ', w, '.p; ', '')) ;
          DynUtf.Append (d2, S2 (w, 'r; })')) ;
          RETURN DynUtf.ViewIn (gpool, d2)
        END ;
        ErrAt (e, 'GRID of an expression that is not a slice designator') ;
        RETURN '0'
    | Ast.NSliceOf3 :
        lt := TagOfExpr (e.kids[0]) ;
        IF Text.Eq (lt, 'UTF') THEN l := EX (e.kids[0], 'UTF')
        ELSE l := EX (e.kids[0], '') END ;
        w := NewTmp () ;
        IF Text.Eq (lt, 'UTF') THEN
          (* byte offsets, both ends at the start of a character *)
          a1 := EX (e.kids[1], '') ;
          a2 := EX (e.kids[2], '') ;
          RETURN S7 ('m9_utf_slice (', l, ', ', a1, ', ', a2, ', err)')
        END ;
        IF Text.Eq (lt, 'SLICE') THEN
          a1 := EX (e.kids[1], '') ;
          a2 := EX (e.kids[2], '') ;
          d2 := DynUtf.New (gpool) ;
          DynUtf.Append (d2, '({ __auto_type ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, ' = ') ;
          DynUtf.Append (d2, l) ;
          DynUtf.Append (d2, '; int64_t ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'a = ') ;
          DynUtf.Append (d2, a1) ;
          DynUtf.Append (d2, ', ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'n = ') ;
          DynUtf.Append (d2, a2) ;
          (* the offset first, in a statement of its own, and a failed
             check answers an EMPTY view: it answered its offset 0 with
             the REQUESTED length, and a callee that ran before the error
             was seen read past the slice (the compiler review's G6) --
             C leaves the order of an initializer list's elements open,
             so the test cannot sit beside the call in the braces *)
          DynUtf.Append (d2, '; int64_t ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'o = m9_chk_slice (') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'a, ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'n, ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, '.len, err); (__typeof__(') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, ')){ ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, '.p + ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'o, err->exc ? 0 : ') ;
          DynUtf.Append (d2, w) ;
          DynUtf.Append (d2, 'n }; })') ;
          RETURN DynUtf.ViewIn (gpool, d2)
        ELSIF Text.Eq (lt, 'ARR') THEN
          (* the view of an array's elements (par 2.2) *)
          inr := NONE ;
          IF e.kids[0] IS SOME desg THEN
            inr := Resolve (DesigDecl (desg))
          END ;
          IF inr IS SOME inn THEN
            IF inn.kind # Ast.NArrayType THEN
              ErrAt (e, 'SLICE() of non-slice unsupported yet') ;
              RETURN '0'
            END ;
            a1 := EX (e.kids[1], '') ;
            a2 := EX (e.kids[2], '') ;
            cnt := ArrCount2 (inn.kids[0]) ;
            d2 := DynUtf.New (gpool) ;
            DynUtf.Append (d2, '({ int64_t ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'a = ') ;
            DynUtf.Append (d2, a1) ;
            DynUtf.Append (d2, ', ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'n = ') ;
            DynUtf.Append (d2, a2) ;
            DynUtf.Append (d2, '; int64_t ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'o = m9_chk_slice (') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'a, ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'n, INT64_C(') ;
            DynUtf.Append (d2, cnt) ;
            DynUtf.Append (d2, '), err); (') ;
            DynUtf.Append (d2, SliceTy (inn.kids[1])) ;
            DynUtf.Append (d2, '){ (') ;
            DynUtf.Append (d2, l) ;
            DynUtf.Append (d2, ').v + ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'o, err->exc ? 0 : ') ;
            DynUtf.Append (d2, w) ;
            DynUtf.Append (d2, 'n }; })') ;
            RETURN DynUtf.ViewIn (gpool, d2)
          ELSE
            ErrAt (e, 'SLICE() argument form unsupported yet') ;
            RETURN '0'
          END
        ELSE
          ErrAt (e, 'SLICE() argument form unsupported yet') ;
          RETURN '0'
        END
    | Ast.NIs :
        (* `x IS SOME' / `x IS NONE' with no binder: an OPT is a
           nullable pointer in C (par 2.2; issue 4, 2026-10-09) *)
        IF e.kids[1] IS SOME isr THEN
          IF isr.kind = Ast.NIsSome AND Text.BLen (isr.au) = 0 THEN
            isx := EX (e.kids[0], '') ;
            IF isr.f1 THEN
              RETURN S3 ('(', isx, ' == NULL)')
            ELSE
              RETURN S3 ('(', isx, ' != NULL)')
            END
          END
        END ;
        ErrAt (e, 'IS with a binder is the whole condition of an IF, ELSIF or WHILE') ;
        RETURN '0'
    | Ast.NBin :
        lt := TagOfExpr (e.kids[0]) ;
        IF Text.Eq (lt, 'I64') THEN lt := TagOfExpr (e.kids[1]) END ;
        IF IsAdaptive (e.kids[0]) THEN lt := TagOfExpr (e.kids[1]) END ;
        (* string concatenation: `+` where either side is a slice.
           The checker has already refused every other slice element
           type, so a SLICE tag here is a string.  Both sides are
           wanted AS SLICES -- a one-character literal is a string in
           this position, not a CHAR. *)
        (* a UTF concatenation, by the type the checker gave the + *)
        IF Text.Eq (e.au, '+') AND Text.Eq (TagOfExpr (k), 'UTF') THEN
          RETURN UtfCat (e)
        END ;
        isCat := FALSE ;
        rt := '' ;
        IF Text.Eq (e.au, '+') THEN
          rt := TagOfExpr (e.kids[1]) ;
          IF Text.Eq (lt, 'SLICE') OR Text.Eq (lt, 'STR1') OR
             Text.Eq (rt, 'SLICE') OR Text.Eq (rt, 'STR1') THEN
            isCat := TRUE
          END
        END ;
        IF isCat THEN
          (* a CHAR on one side is one code point appended or
             prepended: m9_cat over a one-element view of it (par 2.3,
             revised 2026-09-06).  A one-character LITERAL is STR1,
             not CHAR, and stays on the slice path. *)
          IF Text.Eq (lt, 'CHAR') THEN
            l := EX (e.kids[0], 'CHAR') ;
            r := EX (e.kids[1], 'SLICE') ;
            RETURN S5 ('m9_ch_cat (err->res, ', l, ', ', r, ', err)')
          END ;
          IF Text.Eq (rt, 'CHAR') THEN
            l := EX (e.kids[0], 'SLICE') ;
            r := EX (e.kids[1], 'CHAR') ;
            RETURN S5 ('m9_cat_ch (err->res, ', l, ', ', r, ', err)')
          END ;
          l := EX (e.kids[0], 'SLICE') ;
          r := EX (e.kids[1], 'SLICE') ;
          (* the slot, not HEAP: this frame normally, the caller's
             arena while a RETURN expression is being emitted *)
          RETURN S5 ('m9_cat (err->res, ', l, ', ', r, ', err)')
        END ;
        w := '' ;
        IF Text.Eq (lt, 'CHAR') OR Text.Eq (lt, 'STR1') THEN
          w := 'CHAR'
        END ;
        (* at single precision the literals must be single too, or C
           widens the whole expression and narrows once at the end *)
        IF Text.Eq (lt, 'F32') THEN w := 'F32' END ;
        IF Text.Eq (lt, 'U64') THEN w := 'U64' END ;
        (* and an adaptive node -- `5.02808 * 0.43429`, all literals
           -- has no width of its own, so it takes the context's
           rather than recomputing one from operands that have none *)
        IF Text.BLen (want) > 0 THEN
          IF IsAdaptive (k) THEN w := want END
        END ;
        l := EX (e.kids[0], w) ;
        (* the right operand of AND and OR is evaluated only when the
           left decides nothing (short-circuit, par 2.3), so a raising
           argument in it is NOT hoisted ahead of the operator -- found
           by gendiff, when the M9-compiled generator evaluated
           TagOfExpr eagerly in `tg = 'SHARED' AND TagOfExpr (..)'.
           It is lowered INSIDE the branch that evaluates it
           (docs/ir-plan.md, step 3): `({ bool b = l; if (b) { the
           temporaries ; b = r; } b; })', `if (!b)' for OR -- until then
           `p AND F (q.c)' called F on the NULL m9_nn had just let
           through (UBSan: member access within null pointer) *)
        IF (Text.Eq (e.au, 'AND') OR Text.Eq (e.au, 'OR')) AND
           WouldHoist (e.kids[1]) > 0 THEN
          RETURN AndOrLowered (e, l, w)
        END ;
        r := EX (e.kids[1], w) ;
        cop := e.au ;
        IF Text.Eq (cop, '=') THEN cop := '=='
        ELSIF Text.Eq (cop, '#') THEN cop := '!='
        ELSIF Text.Eq (cop, 'AND') THEN cop := '&&'
        ELSIF Text.Eq (cop, 'OR') THEN cop := '||' END ;
        IF Text.Eq (cop, '+') OR Text.Eq (cop, '-') OR
           Text.Eq (cop, '*') THEN
          (* AN UNKNOWN TYPE MUST NOT BECOME INTEGER ARITHMETIC.  A
             tag of '?' means the generator could not resolve an
             operand's type -- most often a callee whose signature
             names a type from a module this one does not import --
             and the integer arm would emit checked 64-bit adds over
             doubles: a program that runs and answers wrong. *)
          IF Text.Eq (lt, '?') THEN
            ErrAt (e,
              'arithmetic on an operand of unresolved type') ;
            RETURN '0'
          END ;
          IF Text.Eq (lt, 'F64') OR Text.Eq (lt, 'F32') THEN
            RETURN S5 ('(', l, S3 (' ', cop, ' '), r, ')')
          ELSE
            IF Text.Eq (cop, '+') THEN
              RETURN S5 (S3 ('m9_add_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            ELSIF Text.Eq (cop, '-') THEN
              RETURN S5 (S3 ('m9_sub_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            ELSE
              RETURN S5 (S3 ('m9_mul_', ISuf (lt), ' ('), l, ', ', r, ', err)')
            END
          END
        ELSIF Text.Eq (cop, '/') THEN
          RETURN S5 ('(', l, ' / ', r, ')')
        ELSIF Text.Eq (cop, 'DIV') THEN
          RETURN S5 (S3 ('m9_div_', ISuf (lt), ' ('), l, ', ', r, ', err)')
        ELSIF Text.Eq (cop, 'MOD') THEN
          RETURN S5 (S3 ('m9_mod_', ISuf (lt), ' ('), l, ', ', r, ', err)')
        ELSIF Text.Eq (cop, '+%') THEN
          RETURN S5 ('m9_addw_i64 (', l, ', ', r, ')')
        ELSIF Text.Eq (cop, '-%') THEN
          RETURN S5 ('m9_subw_i64 (', l, ', ', r, ')')
        ELSIF Text.Eq (cop, '*%') THEN
          RETURN S5 ('m9_mulw_i64 (', l, ', ', r, ')')
        ELSIF (Text.Eq (cop, '==') OR Text.Eq (cop, '!=')) AND
              (StartsW (lt, 'CR:') OR StartsW (TagOfExpr (e.kids[1]), 'CR:')) THEN
          (* two enumeration (or case-record) values compare by tag:
             `k = Kind.Int' is a struct == in C, which gcc refuses --
             the tag is what carries identity (docs/enum-plan.md).
             EITHER side says so: a field of an IMPORTED record
             (`c.shade = ExportDef.Shade.Dark') has a tag the left side
             does not report, and was a struct == until 2026-10-09
             (cp-kernel's Jv.Kind finding) *)
          RETURN S7 ('((', l, ').tag ', cop, ' (', r, ').tag)')
        ELSE
          RETURN S5 ('(', l, S3 (' ', cop, ' '), r, ')')
        END
    | Ast.NUn :
        l := EX (e.kids[0], want) ;
        IF Text.Eq (e.au, 'NOT') THEN
          RETURN S3 ('(!', l, ')')
        ELSIF Text.Eq (e.au, '-') THEN
          lt := TagOfExpr (e.kids[0]) ;
          IF Text.Eq (lt, 'F64') OR Text.Eq (lt, 'F32') THEN
            RETURN S3 ('(- ', l, ')')
          ELSE
            RETURN S3 (S3 ('m9_neg_', ISuf (lt), ' ('), l, ', err)')
          END
        ELSE
          RETURN l
        END
    ELSE
      ErrAt (e, 'expression kind unsupported yet') ;
      RETURN '0'
    END
  END ;
  RETURN '0'
END EX ;

(* ---- calls ---- *)

PROCEDURE EnumConvCount (n: PTR Ast.Node) : I64 =
  (* the member count of a type convertible from an integer -- an
     enumeration, or a case record all of whose variants are
     payload-less -- else -1.  A typed parameter, so the field reads
     do not fall on an IS SOME binder (which the FPC generator types
     as unknown -- `field on non-record'). *)
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NEnumType THEN RETURN n.nkids END ;
  IF n.kind = Ast.NCaseRecordType THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kids[i] IS SOME v THEN
        IF v.kids[0] IS SOME vf THEN RETURN 0 - 1 END
      END
    END ;
    RETURN n.nkids
  END ;
  RETURN 0 - 1
END EnumConvCount ;

PROCEDURE Arg0 (argl: Ast.Kid) : Ast.Kid =
  (* the first argument as a node, without a field read on an IS SOME
     binder at the caller *)
BEGIN
  IF argl IS SOME a THEN RETURN a.kids[0] END ;
  RETURN NONE
END Arg0 ;

(* the RECORD a callee names -- this module's `Row' or an imported
   `Mod.Row' -- and its C type name, or NONE (Sem.RecordNamed) *)
PROCEDURE RecordAt (RO name: UTF ; VAR ctype: UTF ; VAR m: UTF ; VAR tn: UTF) : Ast.Kid =
VAR
  dot, ei, depth : I64 ;
  t : Ast.Kid ;
BEGIN
  dot := 0 - 1 ;
  FOR ei := 0 TO Text.BLen (name) - 1 DO
    IF B (name, ei) = ORD ('.') AND dot < 0 THEN dot := ei END
  END ;
  IF dot < 0 THEN
    m := modName ;
    tn := name
  ELSE
    m := SLICE (name, 0, dot) ;
    tn := SLICE (name, dot + 1, Text.BLen (name) - dot - 1)
  END ;
  (* follow an alias BY NAME to the record it stands for: an alias has
     no C type of its own, and the record's is Mod_Name where it was
     declared *)
  FOR depth := 0 TO 7 DO
    IF Text.Eq (m, modName) THEN
      t := FindTypeN (tn)
    ELSE
      ei := MFind (extTypes, S3 (m, '.', tn)) ;
      IF ei < 0 THEN RETURN NONE END ;
      t := extTypes.es[ei].v
    END ;
    IF t IS SOME n THEN
      IF n.kind = Ast.NRecordType THEN
        ctype := S3 (CP (m), '_', tn) ;
        RETURN SOME (n)
      ELSIF n.kind = Ast.NQualident THEN
        IF Text.BLen (n.bu) > 0 THEN
          m := n.au ;
          tn := n.bu
        ELSE
          tn := n.au
        END
      ELSE
        RETURN NONE
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN NONE
END RecordAt ;

(* A RAISING CALL NESTED AS AN ARGUMENT IS GUARDED BEFORE THE
   ENCLOSING CALL RUNS (report par 5, 2026-10-08; the owed item from
   ONEFlux's report 18).  `F (G (x))' was one C expression under one
   guard after the statement, so F ran on whatever G had answered
   when it raised -- a zero, a NULL -- before the handler saw G's
   error.  An argument that can raise (ExprRaises) goes into a
   temporary with its own guard, in a block the statement closes
   (CloseN): `{ __typeof__(G (x)) m9a1 = G (x); if (err->exc)
   goto L;' and F gets m9a1.  Only where the statement is evaluated
   once -- an assignment, a call statement, a RETURN, a FOR's bounds, a
   CASE selector -- or at the top of each WHILE pass and in ELSIF's own
   else block: made by LowerWalk before the statement is emitted. *)
(* ---- the IR lowering, step 1: what can raise, from the tree ----

   ExprRaises answers, before anything is emitted, whether an
   expression can raise -- an OR over the subtree of the constructs
   that test err->exc behind them: a call, a checked subscript, checked
   integer arithmetic, DIV and MOD, a narrowing conversion, a string
   concatenation, NEW, SLICE, GRID, a pointer read out of a field or a
   module variable (the NULL test).  It places the lowering's
   temporaries and, as LeftRaises, every error test after a statement;
   the emitter's own flag that it was measured against (stRaise, 0
   disagreements over 494 files at each site) is gone (docs/ir-plan.md,
   step 1). *)

PROCEDURE ExprRaises (k: Ast.Kid) : BOOL ;

PROCEDURE KidsRaise (e: PTR Ast.Node) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO e.nkids - 1 DO
    IF ExprRaises (e.kids[i]) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END KidsRaise ;

PROCEDURE DesigRaisesAt (d: PTR Ast.Node ; copied: BOOL) : BOOL ;

PROCEDURE DesigRaises (d: PTR Ast.Node) : BOOL =
BEGIN
  RETURN DesigRaisesAt (d, TRUE)
END DesigRaises ;

(* a designator READ is tested after its copy (NnCopy, m9_nn); one
   WRITTEN is not -- following a pointer is guarded in place (NnGuard,
   its own goto), so only a checked subscript leaves a test behind *)
PROCEDURE DesigRaisesAt (d: PTR Ast.Node ; copied: BOOL) : BOOL =
VAR i : I64 ;
BEGIN
  IF copied AND NnCopy (d) THEN RETURN TRUE END ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelIndex THEN
        (* an enumeration value indexes without a check (DESSel) *)
        IF sel.nkids >= 1 THEN
          IF NOT StartsW (TagOfExpr (sel.kids[0]), 'CR:') THEN RETURN TRUE END
        ELSE
          RETURN TRUE
        END
      END
    END
  END ;
  RETURN FALSE
END DesigRaisesAt ;

(* An ALIAS FOR A SCALAR IS A CONVERSION under its own name.  The
   checker already treats `TYPE Real = F32' as F32 for assignment,
   arguments and RETURN -- aliases chase to structure -- so `Real (x)'
   meaning anything other than `F32 (x)' would be the odd case.  Chased
   once, so every conversion applies unchanged; forced by a Fortran
   port, which needs one source buildable at both of the original's
   real kinds.  CallC and CallRaises both ask it. *)
PROCEDURE ScalarAliasName (RO name: UTF ; nargs: I64) : UTF =
VAR
  dot, pi : I64 ;
  aliasK : Ast.Kid ;
BEGIN
  IF nargs # 1 OR IsBuiltin (name) THEN RETURN name END ;
  aliasK := NONE ;
  dot := FindCh (name, '.') ;
  IF dot > 0 THEN
    pi := MFind (extTypes, name)
  ELSE
    pi := -1 ;
    IF FindTypeN (name) IS SOME tnx THEN
      aliasK := SOME (tnx)
    ELSE
      pi := ExtBare (name)
    END
  END ;
  IF pi >= 0 THEN aliasK := extTypes.es[pi].v END ;
  IF aliasK IS SOME ak0 THEN
    aliasK := Resolve (SOME (ak0)) ;
    IF aliasK IS SOME ak1 THEN
      IF ak1.kind = Ast.NQualident AND Text.BLen (ak1.bu) = 0 THEN
        IF IsBuiltin (ak1.au) THEN RETURN ak1.au END
      END
    END
  END ;
  RETURN name
END ScalarAliasName ;

PROCEDURE CallRaises (c: PTR Ast.Node) : BOOL =
VAR
  name, at, vn, rc, rm, rt : UTF ;
  args : BOOL ;
  i, dot, dot2, nargs : I64 ;
BEGIN
  name := '' ;
  IF c.kids[0] IS SOME dn THEN
    (* the dotted name, as CallC reads it *)
    name := dn.au ;
    FOR i := 0 TO dn.nkids - 1 DO
      IF dn.kids[i] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.au) END
      END
    END
  END ;
  args := FALSE ;
  at := '' ;
  nargs := 0 ;
  IF c.kids[1] IS SOME al THEN
    args := KidsRaise (al) ;
    nargs := al.nkids ;
    IF al.nkids > 0 THEN at := TagOfExpr (al.kids[0]) END
  END ;
  (* a record aggregate is a compound literal (CallC) *)
  IF RecordAt (name, rc, rm, rt) IS SOME rn THEN RETURN args END ;
  name := ScalarAliasName (name, nargs) ;
  IF Text.Eq (name, 'LEN') OR Text.Eq (name, 'ORD') OR
     Text.Eq (name, 'NAME') OR Text.Eq (name, 'SizeOf') OR
     Text.Eq (name, 'ByteSize') OR Text.Eq (name, 'MAX') OR
     Text.Eq (name, 'ADR') OR Text.Eq (name, 'F64') OR
     Text.Eq (name, 'OCTETS') THEN
    RETURN args
  END ;
  IF Text.Eq (name, 'I64') THEN
    RETURN args OR Text.Eq (at, 'F64') OR Text.Eq (at, 'F32') OR
           Text.Eq (at, 'U64')
  END ;
  IF Text.Eq (name, 'F32') THEN RETURN args OR Text.Eq (at, 'F64') END ;
  IF Text.Eq (name, 'U64') AND Text.Eq (at, 'U64') THEN RETURN args END ;
  dot := Text.FindChar (name, '.') ;
  IF dot < 0 THEN
    (* a foreign procedure has no error slot; the module's own and a
       procedure value shadow it, as in CallC *)
    IF FindProcN (name) < 0 AND MFind (foreignProcs, name) >= 0 THEN
      IF Resolve (ScopeNode (name)) IS SOME svt THEN
        IF svt.kind = Ast.NProcType THEN RETURN TRUE END
      END ;
      RETURN args
    END
  ELSIF Text.Eq (SLICE (name, 0, dot), 'C') THEN
    (* a C.* conversion is a cast, but for the three that narrow
       (CallC's C branch: Sem.CTotal's rule, a literal exempt) *)
    vn := SLICE (name, dot + 1, Text.BLen (name) - dot - 1) ;
    IF c.kids[1] IS SOME alc THEN
      IF alc.nkids > 0 THEN
        IF alc.kids[0] IS SOME a0c THEN
          IF a0c.kind = Ast.NInt OR IsNegLit (a0c, Ast.NInt) THEN at := '' END
        END
      END
    END ;
    RETURN args OR (Text.Eq (vn, 'Int') AND Text.OneOf (STR (at), CIntChecked)) OR
           (Text.Eq (vn, 'SizeT') AND Text.OneOf (STR (at), CSizeChecked)) OR
           (Text.Eq (vn, 'Float') AND Text.Eq (at, 'F64'))
  ELSE
    (* a variant constructor, Type.Variant (...) or Mod.Type.Variant
       (...), is a compound literal *)
    IF FindTypeN (SLICE (name, 0, dot)) IS SOME vt THEN
      IF vt.kind = Ast.NCaseRecordType OR vt.kind = Ast.NEnumType THEN RETURN args END
    END ;
    dot2 := Text.FindChar (SLICE (name, dot + 1, Text.BLen (name) - dot - 1), '.') ;
    IF dot2 > 0 THEN
      IF CRNode (SLICE (name, 0, dot + 1 + dot2)) IS SOME xvt THEN
        IF xvt.kind = Ast.NCaseRecordType OR xvt.kind = Ast.NEnumType THEN RETURN args END
      END
    END
  END ;
  RETURN TRUE
END CallRaises ;

PROCEDURE ExprRaises (k: Ast.Kid) : BOOL =
VAR lt, rt : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF irLeft THEN
      IF MFind (lowered, IrKey (e.id, 0)) >= 0 THEN RETURN FALSE END
    END ;
    CASE e.kind OF
    | Ast.NInt, Ast.NReal, Ast.NChar, Ast.NString, Ast.NTrue, Ast.NFalse,
      Ast.NNoneLit :
        RETURN FALSE
    | Ast.NDesignator : RETURN DesigRaises (e) OR KidsRaise (e)
    | Ast.NCallExpr : RETURN CallRaises (e)
    | Ast.NCallSel : RETURN TRUE
    | Ast.NNewExpr, Ast.NGridOf, Ast.NSliceOf3 : RETURN TRUE
    | Ast.NBin :
        IF KidsRaise (e) THEN RETURN TRUE END ;
        lt := TagOfExpr (e.kids[0]) ;
        IF Text.Eq (lt, 'I64') THEN lt := TagOfExpr (e.kids[1]) END ;
        IF IsAdaptive (e.kids[0]) THEN lt := TagOfExpr (e.kids[1]) END ;
        IF Text.Eq (e.au, '+') THEN
          rt := TagOfExpr (e.kids[1]) ;
          IF Text.Eq (lt, 'SLICE') OR Text.Eq (lt, 'STR1') OR
             Text.Eq (rt, 'SLICE') OR Text.Eq (rt, 'STR1') THEN
            RETURN TRUE
          END
        END ;
        IF Text.Eq (e.au, '+') OR Text.Eq (e.au, '-') OR Text.Eq (e.au, '*') THEN
          RETURN NOT (Text.Eq (lt, 'F64') OR Text.Eq (lt, 'F32') OR Text.Eq (lt, '?'))
        END ;
        RETURN Text.Eq (e.au, 'DIV') OR Text.Eq (e.au, 'MOD')
    | Ast.NUn :
        IF ExprRaises (e.kids[0]) THEN RETURN TRUE END ;
        IF Text.Eq (e.au, '-') THEN
          lt := TagOfExpr (e.kids[0]) ;
          RETURN NOT (Text.Eq (lt, 'F64') OR Text.Eq (lt, 'F32'))
        END ;
        RETURN FALSE
    ELSE
      RETURN KidsRaise (e)
    END
  END ;
  RETURN FALSE
END ExprRaises ;

(* can this expression still raise once it is emitted -- ExprRaises with
   every argument the lowering made a temporary counted as done, since
   its own test ran before the statement (docs/ir-plan.md, step 1's
   third part: the error test AFTER a statement, decided by the tree) *)
PROCEDURE LeftRaises (k: Ast.Kid) : BOOL =
VAR sv, r : BOOL ;
BEGIN
  sv := irLeft ; irLeft := TRUE ;
  r := ExprRaises (k) ;
  irLeft := sv ;
  RETURN r
END LeftRaises ;

(* the same for an assignment's target, which is written, not copied *)
PROCEDURE LeftRaisesTarget (k: Ast.Kid) : BOOL =
VAR sv, r : BOOL ;
BEGIN
  r := FALSE ;
  IF k IS SOME d THEN
    sv := irLeft ; irLeft := TRUE ;
    r := DesigRaisesAt (d, FALSE) OR KidsRaise (d) ;
    irLeft := sv
  END ;
  RETURN r
END LeftRaisesTarget ;

(* the same for a call statement, whose node is the call's *)
PROCEDURE LeftRaisesCall (c: PTR Ast.Node) : BOOL =
VAR sv, r : BOOL ;
BEGIN
  sv := irLeft ; irLeft := TRUE ;
  r := CallRaises (c) ;
  irLeft := sv ;
  RETURN r
END LeftRaisesCall ;

(* does CallC take argument k of this call by its GENERIC path -- the
   one where a raising argument is hoisted -- rather than as a VAR or
   OWN argument, an array lent as a slice, or no head at all (a
   builtin, a foreign procedure, a constructor)?  The lowering's step
   1a; IrArgCheck holds it to CallC's own choice. *)
PROCEDURE IrArgGeneric (dn: Ast.Kid ; argl: Ast.Kid ; k: I64) : BOOL =
VAR pty : Ast.Kid ;
BEGIN
  RETURN IrArgParam (dn, argl, k, pty)
END IrArgGeneric ;

(* the tag CallC renders a generic argument with: its parameter's *)
PROCEDURE IrArgWant (dn: Ast.Kid ; argl: Ast.Kid ; k: I64) : UTF =
VAR pty : Ast.Kid ;
BEGIN
  IF IrArgParam (dn, argl, k, pty) THEN RETURN TagOfType (pty) END ;
  RETURN ''
END IrArgWant ;

PROCEDURE IrArgParam (dn: Ast.Kid ; argl: Ast.Kid ; k: I64 ; VAR pty: Ast.Kid) : BOOL =
VAR g, j, i : I64 ;
BEGIN
  pty := NONE ;
  IF dn IS SOME dnode THEN
    IF dnode.nkids = 0 AND IsBuiltinCall (dnode.au) THEN RETURN FALSE END ;
    IF CalleeHead (dn) IS SOME pn THEN
      i := 0 ;
      IF pn.kids[0] IS SOME pl THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF grp.kids[0] IS SOME gids THEN
              FOR j := 0 TO gids.nkids - 1 DO
                IF i = k THEN
                  IF grp.f1 OR grp.f2 THEN RETURN FALSE END ;
                  pty := HeadType (grp.kids[1], dnode) ;
                  IF Text.Eq (TagOfType (pty), 'SLICE') THEN
                    IF argl IS SOME al THEN
                      IF al.kids[k] IS SOME arg THEN
                        IF arg.kind = Ast.NDesignator AND
                           Text.Eq (TagOfExpr (al.kids[k]), 'ARR') THEN
                          RETURN FALSE
                        END
                      END
                    END
                  END ;
                  RETURN TRUE
                END ;
                i := i + 1
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END IrArgParam ;

PROCEDURE IrArgCheck (dn: Ast.Kid ; argl: Ast.Kid ; k: I64 ; generic: BOOL ; line: I64) =
VAR tree : BOOL ;
BEGIN
  tree := IrArgGeneric (dn, argl, k) ;
  IF tree = generic THEN RETURN END ;
  irN := irN + 1 ;
  IF irN > 200 THEN RETURN END ;
  DynUtf.Append (irBuf, ItoA (line)) ;
  DynUtf.Append (irBuf, S3 (': argument ', ItoA (k), ' path: ')) ;
  IF tree THEN DynUtf.Append (irBuf, 'tree generic, emitter not')
  ELSE DynUtf.Append (irBuf, 'tree not, emitter generic') END ;
  IF dn IS SOME d THEN DynUtf.Append (irBuf, S2 (' -- ', d.au)) END ;
  DynUtf.AppendChar (irBuf, 0AC)
END IrArgCheck ;

PROCEDURE SetStrUtf (on: BOOL) =
BEGIN
  strUtf := on
END SetStrUtf ;

(* under SetStrUtf: X is not emitted when this unit declares XUtf *)
PROCEDURE Collapsed (RO nm: UTF) : BOOL =
VAR n : I64 ;
BEGIN
  IF NOT strUtf THEN RETURN FALSE END ;
  n := Text.BLen (nm) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (nm, n - 3, 3), 'Utf') THEN RETURN FALSE END
  END ;
  RETURN FindProcN (S2 (nm, 'Utf')) >= 0
END Collapsed ;

PROCEDURE SetIrCheck (on: BOOL) =
BEGIN
  MInit (irReach) ;
  irOn := on ;
  irN := 0 ;
  irBuf := DynUtf.New (gpool)
END SetIrCheck ;

PROCEDURE IrReport () : UTF =
BEGIN
  IF NOT irOn OR irN = 0 THEN RETURN '' END ;
  RETURN DynUtf.View (irBuf)
END IrReport ;

(* ---- the lowering (docs/ir-plan.md, step 1) ----

   A statement's raising arguments are made temporaries BEFORE the
   expression that holds them is emitted: LowerWalk visits an
   expression in the order EX emits it -- a call's arguments left to
   right, each walked before it is itself made a temporary, so inner
   ones come first; the right operand of AND and OR not at all (it is
   evaluated only when the left lets it, and a temporary ahead of the
   operator would evaluate it always: decision 35) -- and LowerHoist
   emits `{ __typeof__(a) m9aN = a; if (err->exc) goto L;', as
   HoistArg did from the text the emitter had just made.  CallC finds
   the name in `lowered' by the argument's node.  Where a temporary
   goes is the tree's answer -- IrArgGeneric and ExprRaises -- and the
   statement that called Lower closes the blocks it answers (CloseN). *)

PROCEDURE LowerWalk (k: Ast.Kid ; ind: I64 ; VAR n: I64) ;

(* a temporary at indentation ind, which opens one block (n counts it) *)
PROCEDURE LowerHoist (ak: Ast.Kid ; RO want: UTF ; ind: I64 ; VAR n: I64) =
VAR
  e, tmp : UTF ;
BEGIN
  IF ak IS SOME a THEN
    e := EX (ak, want) ;
    nhoist := nhoist + 1 ;
    tmp := S2 ('m9a', ItoA (nhoist)) ;
    Line (KPbuf, ind, S6 ('{ __typeof__(', e, ') ', tmp, ' = ', S2 (e, ';'))) ;
    Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
    n := n + 1 ;
    MAdd (lowered, IrKey (a.id, 0), NONE, Text.Keep (gpool, tmp))
  END
END LowerHoist ;

PROCEDURE LowerCall (dn: Ast.Kid ; argl: Ast.Kid ; ind: I64 ; VAR n: I64) =
VAR k : I64 ;
BEGIN
  IF argl IS SOME al THEN
    FOR k := 0 TO al.nkids - 1 DO
      LowerWalk (al.kids[k], ind, n) ;
      IF IrArgGeneric (dn, argl, k) THEN
        IF ExprRaises (al.kids[k]) THEN
          LowerHoist (al.kids[k], IrArgWant (dn, argl, k), ind, n)
        END
      END
    END
  END
END LowerCall ;

PROCEDURE LowerWalk (k: Ast.Kid ; ind: I64 ; VAR n: I64) =
VAR i, j : I64 ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NCallExpr : LowerCall (e.kids[0], e.kids[1], ind, n)
    | Ast.NBin :
        LowerWalk (e.kids[0], ind, n) ;
        IF NOT (Text.Eq (e.au, 'AND') OR Text.Eq (e.au, 'OR')) THEN
          LowerWalk (e.kids[1], ind, n)
        END
    | Ast.NDesignator :
        FOR i := 0 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME sel THEN
            IF sel.kind = Ast.NSelIndex THEN
              FOR j := 0 TO sel.nkids - 1 DO LowerWalk (sel.kids[j], ind, n) END
            END
          END
        END
    ELSE
      FOR i := 0 TO e.nkids - 1 DO LowerWalk (e.kids[i], ind, n) END
    END
  END
END LowerWalk ;

(* how many temporaries LowerWalk would make in k, emitting nothing --
   measured for the right operand of AND and OR, which is not lowered
   (docs/ir-plan.md, step 3) *)
PROCEDURE WouldHoist (k: Ast.Kid) : I64 =
VAR i, j, n, a : I64 ;
BEGIN
  n := 0 ;
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NCallExpr :
        IF e.kids[1] IS SOME al THEN
          FOR a := 0 TO al.nkids - 1 DO
            n := n + WouldHoist (al.kids[a]) ;
            IF IrArgGeneric (e.kids[0], e.kids[1], a) THEN
              IF ExprRaises (al.kids[a]) THEN n := n + 1 END
            END
          END
        END
    | Ast.NDesignator :
        FOR i := 0 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME sel THEN
            IF sel.kind = Ast.NSelIndex THEN
              FOR j := 0 TO sel.nkids - 1 DO n := n + WouldHoist (sel.kids[j]) END
            END
          END
        END
    ELSE
      FOR i := 0 TO e.nkids - 1 DO n := n + WouldHoist (e.kids[i]) END
    END
  END ;
  RETURN n
END WouldHoist ;

(* AND or OR whose right operand needs temporaries (EX, NBin): the
   right operand lowered into a scratch buffer, its lines joined into
   the expression, inside the branch that evaluates it *)
PROCEDURE AndOrLowered (e: PTR Ast.Node ; RO l: UTF ; RO w: UTF) : UTF =
VAR
  sv : PTR DynUtf.DString IN gpool ;
  b, r, temps, closes, nl : UTF ;
  n, i : I64 ;
BEGIN
  sv := bPbuf ;
  bPbuf := DynUtf.New (gpool) ;
  n := Lower (e.kids[1], 0) ;
  r := EX (e.kids[1], w) ;
  nl := UTF ('' + 0AC) ;
  temps := Text.Keep (gpool, Text.Replace (DynUtf.ViewIn (gpool, bPbuf), nl, ' ')) ;
  bPbuf := sv ;
  closes := '' ;
  FOR i := 1 TO n DO closes := S2 (closes, ' }') END ;
  b := NewTmp () ;
  IF Text.Eq (e.au, 'AND') THEN
    RETURN S9 ('({ bool ', b, ' = ', l, '; if (', b, ') { ', temps,
      S9 (b, ' = (', r, ');', closes, ' } ', b, '; })', ''))
  END ;
  RETURN S9 ('({ bool ', b, ' = ', l, '; if (!', b, ') { ', temps,
    S9 (b, ' = (', r, ');', closes, ' } ', b, '; })', ''))
END AndOrLowered ;

(* an expression of a statement lowered at indentation ind: its
   temporaries written, and how many blocks they opened -- the site
   closes them where its form says (docs/ir-plan.md, step 2) *)
PROCEDURE Lower (k: Ast.Kid ; ind: I64) : I64 =
VAR n : I64 ;
BEGIN
  n := 0 ;
  LowerWalk (k, ind, n) ;
  RETURN n
END Lower ;

(* the same for a call statement's arguments *)
PROCEDURE LowerArgs (dn: Ast.Kid ; argl: Ast.Kid ; ind: I64) : I64 =
VAR n : I64 ;
BEGIN
  n := 0 ;
  LowerCall (dn, argl, ind, n) ;
  RETURN n
END LowerArgs ;

(* n blocks the lowering opened, closed at indentation ind *)
PROCEDURE CloseN (n, ind: I64) =
VAR i : I64 ;
BEGIN
  FOR i := 1 TO n DO Line (KPbuf, ind, '}') END
END CloseN ;

(* CallC, and under M9_IRCHECK the reverse of IrArgCheck: every
   argument the tree calls generic was reached as generic (CallC0 marks
   it), so a call CallC handles before its parameter loop -- a builtin,
   a constructor -- cannot hide a wrong prediction *)
PROCEDURE CallC (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: UTF) : UTF =
VAR
  r : UTF ;
  k : I64 ;
BEGIN
  IF NOT irOn THEN RETURN CallC0 (dn, argl, tag) END ;
  r := CallC0 (dn, argl, tag) ;
  IF argl IS SOME al THEN
    FOR k := 0 TO al.nkids - 1 DO
      IF IrArgGeneric (dn, argl, k) AND MFind (irReach, IrKey (al.id, k)) < 0 THEN
        IrArgCheck (dn, argl, k, FALSE, 0)
      END
    END
  END ;
  RETURN r
END CallC ;

PROCEDURE IrKey (id: I64 ; k: I64) : UTF =
BEGIN
  RETURN Text.Keep (gpool, S3 (ItoA (id), ':', ItoA (k)))
END IrKey ;

PROCEDURE CallC0 (dn: Ast.Kid ; argl: Ast.Kid ; VAR tag: UTF) : UTF =
VAR
  name, args, at, want2, tn, vn, cfunc, e1, e2, res, cnt, at2, ex2, pre, plain : UTF ;
  gname, xtn, px : UTF ;
  pi, g, j, k, k2, nargs, dot, dot2, nf32, nf64, eln : I64 ;
  pnodeK, ak, vgrid, enode, pty : Ast.Kid ;
  ser, pv, vg0c, anyRaise : BOOL ;
  d3 : PTR DynUtf.DString IN gpool ;
  pmod : UTF ;            (* the callee's module, for an imported head *)
  rpool, rp, ov, rv, rty : UTF ;   (* VarPool's: the pool the call adopts into *)
  jl : I64 ;
BEGIN
  tag := '?' ;
  name := '' ;
  pmod := '' ;
  rpool := '' ;
  nargs := 0 ;
  eln := 0 ;
  IF dn IS SOME d9 THEN eln := d9.line END ;
  IF dn IS SOME dnode THEN
    (* the dotted callee name: every field selector joins, so
       Mod.Type.Variant reaches the constructor branch whole -- the
       two-part cut read it as procedure `Csv' and refused it as
       `callee unsupported yet' until 2026-09-15 *)
    name := dnode.au ;
    FOR j := 0 TO dnode.nkids - 1 DO
      IF dnode.kids[j] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.au) END
      END
    END
  ELSE
    Err2 (eln, 'designator form unsupported yet') ;
    RETURN '0'
  END ;
  IF argl IS SOME al0 THEN nargs := al0.nkids END ;

  (* A RECORD AGGREGATE: Row (a, b), or Mod.Row (a, b) -- a compound
     literal of the record's C type, the fields in declaration order,
     which is the struct's order (report par 2.2.4) *)
  IF RecordAt (name, cfunc, gname, xtn) IS SOME rn THEN
    tag := 'REC' ;
    args := '' ;
    k2 := 0 ;
    IF rn.kids[1] IS SOME rfs THEN
      FOR g := 0 TO rfs.nkids - 1 DO
        IF rfs.kids[g] IS SOME rg THEN
          IF rg.kids[0] IS SOME rids THEN
            FOR j := 0 TO rids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME ral THEN
                  IF Text.BLen (args) > 0 THEN args := S2 (args, ', ') END ;
                  want2 := TagOfType (rg.kids[1]) ;
                  ex2 := EX (ral.kids[k2], want2) ;
                  (* a handle stored in the record is a holder *)
                  IF SharedBinding (ral.kids[k2]) THEN
                    ex2 := S5 ('((__typeof__(', ex2, ')) m9_share_copy (', ex2, '))')
                  END ;
                  args := S2 (args, ex2)
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN Err2 (eln, 'record aggregate arity wrong') END ;
    RETURN S5 ('((', cfunc, '){ ', args, ' })')
  END ;

  (* AN INTEGER TO AN ENUMERATION: Colour (i), or Palette.Hue (i),
     the checked inverse of ORD.  The callee is a type -- an enum or a
     payload-less case record -- and CRNode/CRPrefix already resolve
     it for either spelling.  m9_enum raises ValueRange for a value
     that names no member (docs/enum-plan.md). *)
  IF nargs = 1 THEN
    IF CRNode (name) IS SOME enode THEN
      nf32 := EnumConvCount (enode) ;      (* reuse nf32 as a scratch *)
      IF nf32 >= 0 THEN
        tag := S2 ('CR:', name) ;
        RETURN S7 ('((', CRPrefix (name), '){ .tag = m9_enum ((int64_t)(',
          EX (Arg0 (argl), ''), '), INT64_C(', ItoA (nf32),
          '), err) })')
      END
    END
  END ;

  (* An ALIAS FOR A SCALAR IS A CONVERSION under its own name.  The
     checker already treats `TYPE Real = F32` as F32 for assignment,
     arguments and RETURN -- aliases chase to structure -- so `Real
     (x)` meaning anything other than `F32 (x)` would be the odd
     case.  Chased here, once, so every conversion below applies
     unchanged.  Forced by a Fortran port, which needs one source
     buildable at both of the original's real kinds. *)
  name := ScalarAliasName (name, nargs) ;

  (* builtins the milestone needs *)
  IF argl IS SOME al THEN
    (* the UTF builtins (docs/utf8-plan.md, U2): UTF (s) encodes, UTF (b)
       validates and copies, UTF (u) is u, STR (u) decodes, OCTETS (u)
       views; a procedure of the program's own by the name is not one *)
    IF nargs = 1 AND FindProcN (name) < 0 AND ScopeFind (name) < 0 AND
       (Text.Eq (name, 'UTF') OR Text.Eq (name, 'STR') OR
        Text.Eq (name, 'OCTETS')) THEN
      RETURN UtfBuiltinC (name, al.kids[0], tag, 'err->res')
    END ;
    (* UTF (pool, x): the same, into pool (Alex, 2026-10-23) *)
    IF nargs = 2 AND FindProcN (name) < 0 AND ScopeFind (name) < 0 AND
       Text.Eq (name, 'UTF') THEN
      e1 := '' ;
      IF al.kids[0] IS SOME upd THEN e1 := PoolAddrC (upd) END ;
      RETURN UtfBuiltinC (name, al.kids[1], tag, e1)
    END ;
    IF Text.Eq (name, 'COPY') AND nargs = 2 THEN
      (* COPY (to, from) (docs/blockcopy-plan.md): each argument
         evaluated once, as a slice -- an array's elements and count --
         then m9_copy: one length compare and a memmove *)
      e1 := CopyArg (al.kids[0], 'd') ;
      e2 := CopyArg (al.kids[1], 's') ;
      tag := '<void>' ;
      RETURN S5 ('({ ', e1, e2,
        'm9_copy ((void *) m9cdp, m9cdn, (const void *) m9csp, m9csn, ',
        'sizeof (*m9cdp), err); })')
    END ;
    IF Text.Eq (name, 'LEN') THEN
      at := TagOfExpr (al.kids[0]) ;
      (* a grid has one length per axis, so LEN names the axis *)
      IF Text.Eq (at, 'GRID') AND nargs = 2 THEN
        tag := 'I64' ;
        e1 := EX (al.kids[0], '') ;
        e2 := EX (al.kids[1], '') ;
        RETURN S5 ('(', e1, ').n[', e2, ']')
      END ;
      IF Text.Eq (at, 'SLICE') THEN
        tag := 'I64' ;
        RETURN S3 ('(', EX (al.kids[0], ''), ').len')
      END ;
      IF Text.Eq (at, 'ARR') THEN
        IF al.kids[0] IS SOME a0 THEN
          (* a bare name: its declaration's count.  Anything with
             selectors -- an array FIELD, `p.errs', or an array in an
             element -- C counts itself: the root name's declaration
             is another array or none, and `.len' is a slice's
             (2026-10-10, genforms GfArrRecField) *)
          IF a0.kind = Ast.NDesignator AND a0.nkids = 0 THEN
            IF Resolve (ScopeNode (a0.au)) IS SOME arr THEN
              IF arr.kind = Ast.NArrayType THEN
                tag := 'I64' ;
                RETURN S3 ('INT64_C(', ArrCount2 (arr.kids[0]), ')')
              END
            END
          ELSE
            tag := 'I64' ;
            e1 := EX (al.kids[0], '') ;
            RETURN S5 ('((int64_t) (sizeof ((', e1, ').v) / sizeof ((', e1, ').v[0])))')
          END
        END
      END ;
      tag := 'I64' ;
      RETURN S3 ('(', EX (al.kids[0], ''), ').len')
    END ;
    (* VIEW (g, i, ALL, ...): a borrowed sub-grid.  The axes are
       known here, so the loop is unrolled and the rank of the answer
       is a compile-time fact -- which is what lets a view have a type
       at all.  Dropped axes are CHECKED where the view is taken. *)
    IF Text.Eq (name, 'VIEW') THEN
      vgrid := NONE ;
      vg0c := FALSE ;
      IF al.kids[0] IS SOME vg0 THEN
        vg0c := vg0.kind = Ast.NCallExpr ;
        IF vg0c THEN
          (* a grid a call answers: its cells are in this arena, as any
             answer's are, so the view is sound -- the grid's type is the
             callee's declared result, read in the callee's module
             (genforms GfViewOfCall, owed since 2026-10-10) *)
          IF CalleeHead (vg0.kids[0]) IS SOME hd THEN
            IF hd.kind = Ast.NProcDecl THEN
              IF vg0.kids[0] IS SOME cdn THEN
                vgrid := Resolve (HeadType (hd.kids[1], cdn))
              END
            END
          END
        ELSE
          vgrid := Resolve (DesigDecl (vg0))
        END
      END ;
      IF vgrid IS SOME vd THEN
        IF vd.kind # Ast.NGridType THEN
          Err2 (eln, 'VIEW of a non-GRID') ;
          RETURN '0'
        END ;
        k2 := 0 ;
        FOR j := 1 TO nargs - 1 DO
          IF IsAllArg (al.kids[j]) THEN k2 := k2 + 1 END
        END ;
        vn := NewTmp () ;
        tn := TyC (vgrid) ;
        want2 := GridTy (vd.kids[1], ItoA (k2)) ;
        e1 := EX (al.kids[0], '') ;
        d3 := DynUtf.New (gpool) ;
        DynUtf.Append (d3, S7 ('({ ', tn, ' ', vn, ' = ', e1, '; ')) ;
        (* a call that raised answered nothing: no view of it is taken
           (the drop's own check would replace the exception) *)
        IF vg0c AND ExprRaises (al.kids[0]) THEN
          DynUtf.Append (d3, S3 ('if (err->exc) goto ', raiseLbl, '; '))
        END ;
        DynUtf.Append (d3,
          S7 (want2, ' ', vn, 'r; int64_t ', vn, 'o = 0; ', '')) ;
        g := 0 ;
        FOR j := 1 TO nargs - 1 DO
          IF IsAllArg (al.kids[j]) THEN
            DynUtf.Append (d3,
              S9 (vn, 'r.n[', ItoA (g), '] = ', vn, '.n[',
                  ItoA (j - 1), ']; ', '')) ;
            DynUtf.Append (d3,
              S9 (vn, 'r.s[', ItoA (g), '] = ', vn, '.s[',
                  ItoA (j - 1), ']; ', '')) ;
            g := g + 1
          ELSE
            e2 := EX (al.kids[j], '') ;
            DynUtf.Append (d3,
              S9 (vn, 'o += m9_gdrop (', e2, ', ', vn, '.n[',
                  ItoA (j - 1), '], ', vn)) ;
            DynUtf.Append (d3,
              S5 ('.s[', ItoA (j - 1), '], err); ', '', ''))
          END
        END ;
        DynUtf.Append (d3,
          S9 (vn, 'r.p = ', vn, '.p + ', vn, 'o; ', vn, 'r; })', '')) ;
        tag := 'GRID' ;
        RETURN DynUtf.ViewIn (gpool, d3)
      END ;
      Err2 (eln, 'VIEW form unsupported yet') ;
      RETURN '0'
    END ;
    IF Text.Eq (name, 'ORD') THEN
      tag := 'I64' ;
      (* an enumeration (or any payload-less case record) answers its
         tag; a CHAR answers its code point.  ORD (Colour.Red) is 0,
         ORD (c) is the member's position, 0..n-1 (docs/enum-plan.md) *)
      IF StartsW (TagOfExpr (al.kids[0]), 'CR:') THEN
        RETURN S3 ('(int64_t)((', EX (al.kids[0], ''), ').tag)')
      END ;
      RETURN S3 ('(int64_t)(', EX (al.kids[0], 'CHAR'), ')')
    END ;
    IF Text.Eq (name, 'NAME') THEN
      (* the member's identifier as a STR, from the table emitted
         beside the tag #defines: NAME (Colour.Red) is 'Red'.  The
         tag names the type -- CR:Kind at home, CR:Mod.Kind abroad --
         and CRPrefix turns either into the C table name *)
      IF strUtf THEN tag := 'UTF' ELSE tag := 'SLICE' END ;
      at := TagOfExpr (al.kids[0]) ;
      RETURN S6 ('(', CRPrefix (SLICE (at, 3, Text.BLen (at) - 3)), '_names[(',
        EX (al.kids[0], ''), ').tag])', '')
    END ;
    IF Text.Eq (name, 'CHR') THEN
      tag := 'CHAR' ;
      RETURN S3 ('m9_chr (', EX (al.kids[0], ''), ', err)')
    END ;
    IF Text.Eq (name, 'BYTE') THEN
      tag := 'BYTE' ;
      at := TagOfExpr (al.kids[0]) ;
      e1 := EX (al.kids[0], '') ;
      RETURN S3 ('m9_byte (', IntArgC (e1, at), ', err)')
    END ;
    (* the other widths, each a checked narrowing: the museum's
       founding bug is a width that converted itself, so every one of
       these is a call that can raise rather than a cast that cannot.
       By SOURCE as well as target: a real or a U64 is checked on its
       way to int64_t (IntArgC), and a U64 target takes a real through
       its own range and a U64 as it is *)
    IF IsWidthConv (name) THEN
      tag := name ;
      at := TagOfExpr (al.kids[0]) ;
      e1 := EX (al.kids[0], '') ;
      IF Text.Eq (name, 'U64') AND Text.Eq (at, 'U64') THEN
        RETURN S3 ('(uint64_t)(', e1, ')')
      END ;
      IF Text.Eq (name, 'U64') AND
         (Text.Eq (at, 'F64') OR Text.Eq (at, 'F32')) THEN
        RETURN S3 ('m9_u64_f64 ((double)(', e1, '), err)')
      END ;
      RETURN S5 ('m9_', LowerName (name), ' (', IntArgC (e1, at), ', err)')
    END ;
    IF Text.Eq (name, 'I64') THEN
      tag := 'I64' ;
      at := TagOfExpr (al.kids[0]) ;
      IF Text.Eq (at, 'F64') OR Text.Eq (at, 'F32') THEN
        RETURN S3 ('m9_i64_f64 ((double)(', EX (al.kids[0], ''),
          '), err)')
      END ;
      IF Text.Eq (at, 'U64') THEN
        RETURN S3 ('m9_i64_u64 (', EX (al.kids[0], ''), ', err)')
      END ;
      RETURN S3 ('(int64_t)(', EX (al.kids[0], ''), ')')
    END ;
    IF Text.Eq (name, 'F64') THEN
      tag := 'F64' ;
      RETURN S3 ('(double)(', EX (al.kids[0], ''), ')')
    END ;
    IF Text.Eq (name, 'F32') THEN
      tag := 'F32' ;
      (* from a double: checked, a value beyond F32's range raises
         ValueRange where C's cast gives an infinity (2026-10-08) *)
      at := TagOfExpr (al.kids[0]) ;
      IF Text.Eq (at, 'F64') THEN
        RETURN S3 ('m9_f32_f64 (', EX (al.kids[0], ''), ', err)')
      END ;
      RETURN S3 ('(float)(', EX (al.kids[0], ''), ')')
    END ;
    IF Text.Eq (name, 'MAX') THEN
      IF al.kids[0] IS SOME m0 THEN
        tag := m0.au ;
        (* every builtin type's largest value: the checker takes MAX
           of any (only I64 until the typed tree's stage 3); a real's
           is the largest finite one, written out so that no float.h
           is needed; a CHAR's is the largest scalar *)
        res := MaxC (m0.au) ;
        IF Text.BLen (res) > 0 THEN RETURN res END
      END ;
      Err2 (eln, 'MAX of this type unsupported yet') ;
      RETURN '0'
    END ;
    (* SizeOf (x): x's type size, a compile-time C sizeof.  A bare
       builtin or user type name asks the type; else the value's
       type (sizeof does not evaluate).  A slice's SizeOf is its
       descriptor; ByteSize is the data.  In-memory only. *)
    IF Text.Eq (name, 'SizeOf') THEN
      tag := 'I64' ;
      IF al.kids[0] IS SOME s0 THEN
        IF s0.kind = Ast.NDesignator AND s0.nkids = 0 THEN
          IF Text.BLen (BuiltinC (s0.au)) > 0 THEN
            RETURN S3 ('((int64_t) sizeof (', BuiltinC (s0.au), '))')
          END ;
          IF FindTypeN (s0.au) IS SOME ft THEN
            RETURN S5 ('((int64_t) sizeof (', CP (modName), '_', s0.au, '))')
          END
        END
      END ;
      RETURN S3 ('((int64_t) sizeof (', EX (al.kids[0], ''), '))')
    END ;
    (* ByteSize (s): LEN times element size; the element size is
       read off the slice's pointer type, unevaluated *)
    IF Text.Eq (name, 'ByteSize') THEN
      tag := 'I64' ;
      at := EX (al.kids[0], '') ;
      RETURN S5 ('((int64_t) (', at, ').len * (int64_t) sizeof (*(', at, ').p))')
    END ;
    IF Text.Eq (name, 'ADR') THEN
      tag := '?' ;
      at := TagOfExpr (al.kids[0]) ;
      IF Text.Eq (at, 'SLICE') THEN
        RETURN S3 ('((void *)(', EX (al.kids[0], ''), ').p)')
      END ;
      IF Text.Eq (at, 'ARR') THEN
        RETURN S3 ('((void *)(', EX (al.kids[0], ''), ').v)')
      END ;
      (* a record or scalar VARIABLE: its own address (2026-10-25, for
         the UTF descriptor m9_utf_adopt_p fills in Io.ReadFileUtf) *)
      IF al.kids[0] IS SOME d0 THEN
        IF d0.kind = Ast.NDesignator THEN
          RETURN S3 ('((void *) &(', EX (al.kids[0], ''), '))')
        END
      END ;
      Err2 (eln, 'ADR of this expression unsupported: a slice, an array or a variable') ;
      RETURN '0'
    END
  END ;

  (* WIDTH DISPATCH BY DECLARED TWIN, the generator half.  The checker
     resolved `Math.Sqrt (x)` on an F32 to Math.SqrtF32 and typed it;
     the call has to be EMITTED to the same procedure or the two ends
     disagree about which program this is.

     HERE, and not before the builtins: up there it would ask
     TagOfExpr for the first argument's type on every call, and
     `MAX (I64)` passes a TYPE NAME rather than an expression.  A
     builtin has no twin by construction, so this is the only place
     the rule can apply. *)
  IF nargs >= 1 AND Text.BLen (name) > 3 THEN
    IF NOT Text.Eq (SLICE (name, Text.BLen (name) - 3, 3), 'F32') THEN
      dot := FindCh (name, '.') ;
      IF dot > 0 OR FindProcN (name) >= 0 THEN
        IF argl IS SOME alw THEN
          (* SOME argument is F32 and NONE is F64 -- the checker's
             rule, character for character, because the two ends must
             agree about which procedure this call is.  A literal
             types as neither width, so Math.Pow (10.0, c) dispatches
             on c. *)
          nf32 := 0 ;
          nf64 := 0 ;
          FOR k2 := 0 TO nargs - 1 DO
            (* an adaptive argument is neither width and must not
               vote: Math.Pow (10.0, c) dispatches on c *)
            IF NOT IsAdaptive (alw.kids[k2]) THEN
              at := TagOfExpr (alw.kids[k2]) ;
              IF Text.Eq (at, 'F32') THEN nf32 := nf32 + 1 END ;
              IF Text.Eq (at, 'F64') THEN nf64 := nf64 + 1 END
            END
          END ;
          IF nf32 > 0 AND nf64 = 0 THEN
            IF dot > 0 THEN
              IF MFind (extProcs, S2 (name, 'F32')) >= 0 THEN
                name := S2 (name, 'F32')
              END
            ELSE
              IF FindProcN (S2 (name, 'F32')) >= 0 THEN
                name := S2 (name, 'F32')
              END
            END
          END
        END
      END
    END
  END ;
  (* TWINS BY TYPE for UTF (docs/utf8-plan.md, U3; Alex, 2026-10-23):
     `Text.Eq (u, v)' with a UTF argument is `Text.EqUtf (u, v)' when
     the module declares it -- the checker's rule (Sem.UtfTwin), so the
     two ends agree on which procedure the call is *)
  IF nargs >= 1 OR strUtf THEN
    IF Text.BLen (name) <= 3 OR
       NOT Text.Eq (SLICE (name, Text.BLen (name) - 3, 3), 'Utf') THEN
      nf32 := 0 ;
      IF argl IS SOME alu THEN
        FOR k2 := 0 TO nargs - 1 DO
          IF Text.Eq (TagOfExpr (alu.kids[k2]), 'UTF') THEN nf32 := nf32 + 1 END ;
          (* or a slice of them, Text.Join's parts (Sem.UtfVotes) *)
          IF alu.kids[k2] IS SOME ak2 THEN
            IF Text.Eq (Ast.TyStrAt (ak2.id), 'SLICE OF SLICE OF <u8>') THEN nf32 := nf32 + 1 END
          END
        END
      END ;
      (* under the rehearsed switch every call of X is XUtf's, a call
         of a three-letter name or of no arguments too (Len (5),
         Tag ()) -- found by the strswitch fixture *)
      IF nf32 > 0 OR strUtf THEN
        IF FindCh (name, '.') > 0 THEN
          IF MFind (extProcs, S2 (name, 'Utf')) >= 0 THEN name := S2 (name, 'Utf') END
        ELSIF FindProcN (S2 (name, 'Utf')) >= 0 THEN
          name := S2 (name, 'Utf')
        END
      END
    END
  END ;

  pnodeK := NONE ;
  cfunc := '' ;
  dot := FindCh (name, '.') ;
  IF dot >= 0 THEN
    tn := SLICE (name, 0, dot) ;
    vn := SLICE (name, dot + 1, Text.BLen (name) - dot - 1) ;
    (* C.* conversion: a cast at the foreign boundary *)
    IF Text.Eq (tn, 'C') THEN
      at := CMap (vn) ;
      IF Text.BLen (at) = 0 THEN
        Err2 (eln, S2 ('unknown C type: C.', vn)) ;
        RETURN '0'
      END ;
      tag := '?' ;
      IF nargs # 1 THEN
        Err2 (eln, 'a conversion takes one argument')
      END ;
      IF argl IS SOME alc THEN
        (* a conversion that NARROWS is checked, where the checker
           counts its ValueRange (Sem.CTotal; 2026-10-10): C.Int of a
           64-bit or unsigned 32-bit integer, C.SizeT of a signed one,
           C.Float of an F64.  A literal and anything else is a cast. *)
        e1 := EX (alc.kids[0], '') ;
        at2 := TagOfExpr (alc.kids[0]) ;
        IF alc.kids[0] IS SOME a0c THEN
          IF a0c.kind = Ast.NInt OR IsNegLit (a0c, Ast.NInt) THEN at2 := '' END
        END ;
        IF Text.Eq (vn, 'Int') AND Text.OneOf (STR (at2), CIntChecked) THEN
          RETURN S3 ('((int) m9_i32 (', e1, ', err))')
        ELSIF Text.Eq (vn, 'SizeT') AND Text.OneOf (STR (at2), CSizeChecked) THEN
          RETURN S3 ('((size_t) m9_u64 (', e1, ', err))')
        ELSIF Text.Eq (vn, 'Float') AND Text.Eq (at2, 'F64') THEN
          RETURN S3 ('(m9_f32_f64 (', e1, ', err))')
        END ;
        RETURN S5 ('((', at, ')(', e1, '))')
      END ;
      RETURN '0'
    END ;
    (* the wire boundary: F64/F32 . From/ToBytesLE (par 2.1) *)
    IF (Text.Eq (tn, 'F64') OR Text.Eq (tn, 'F32')) AND
       Text.Eq (vn, 'FromBytesLE') THEN
      IF nargs # 1 THEN
        Err2 (eln, 'FromBytesLE takes one argument')
      END ;
      tag := tn ;
      IF argl IS SOME alf THEN
        IF Text.Eq (tn, 'F64') THEN
          RETURN S3 ('m9_f64_from_le (', EX (alf.kids[0], ''), ', err)')
        END ;
        RETURN S3 ('m9_f32_from_le (', EX (alf.kids[0], ''), ', err)')
      END ;
      RETURN '0'
    END ;
    IF (Text.Eq (tn, 'F64') OR Text.Eq (tn, 'F32')) AND
       Text.Eq (vn, 'ToBytesLE') THEN
      IF nargs # 2 THEN
        Err2 (eln, 'ToBytesLE takes two arguments')
      END ;
      tag := '?' ;
      IF argl IS SOME alt THEN
        e1 := EX (alt.kids[0], '') ;
        e2 := EX (alt.kids[1], '') ;
        IF Text.Eq (tn, 'F64') THEN
          RETURN S5 ('m9_f64_to_le (', e1, ', ', e2, ', err)')
        END ;
        RETURN S5 ('m9_f32_to_le (', e1, ', ', e2, ', err)')
      END ;
      RETURN '0'
    END ;
    (* variant constructor with payload: Type.Variant (args) *)
    IF FindTypeN (tn) IS SOME vt THEN
      IF vt.kind = Ast.NCaseRecordType OR vt.kind = Ast.NEnumType THEN
        RETURN VariantCtor (vt, tn, vn, argl, nargs, tag)
      END
    END ;
    (* and Mod.Type.Variant (args), the type's module named: the
       callee split at its first dot reads as module Mod, procedure
       `Type.Variant', which is no procedure.  CRPrefix and the CR:
       tag both carry `Mod.Type' since 2026-09-15. *)
    dot2 := 0 - 1 ;
    FOR k := 0 TO Text.BLen (vn) - 1 DO
      IF B (vn, k) = ORD ('.') AND dot2 < 0 THEN dot2 := k END
    END ;
    IF dot2 > 0 THEN
      xtn := S3 (tn, '.', SLICE (vn, 0, dot2)) ;
      IF CRNode (xtn) IS SOME xvt THEN
        IF xvt.kind = Ast.NCaseRecordType OR xvt.kind = Ast.NEnumType THEN
          RETURN VariantCtor (xvt, xtn,
                              SLICE (vn, dot2 + 1, Text.BLen (vn) - dot2 - 1),
                              argl, nargs, tag)
        END
      END
    END ;
    (* cross-module call: Mod.Proc against a loaded extern def *)
    g := MFind (extProcs, name) ;
    IF g >= 0 THEN
      pnodeK := extProcs.es[g].v ;
      cfunc := S3 (CP (tn), '_', vn) ;
      (* its parameter and result types are written in ITS module: a
         bare `V' there is Pa.V, not whichever imported module's V
         ExtBare meets first (OneFlux, 2026-10-19: Clean.Verdict, no
         pointer, imported before Outlier.Verdict, three slices, and
         the call to Outlier.Detect went without its hidden pool) *)
      pmod := Text.Keep (gpool, tn)
    END
  ELSE
    (* a call THROUGH A PROCEDURE VALUE (par 2.2.3): a parameter or
       an IS SOME binder whose type is a procedure type.  Its head
       drives the argument conversion below exactly as a declaration's
       would, and the call is `name (args, err)` on the C pointer. *)
    pv := FALSE ;
    IF Resolve (ScopeNode (name)) IS SOME svt THEN
      IF svt.kind = Ast.NProcType THEN
        pnodeK := SOME (svt) ;
        cfunc := CN (name) ;
        pv := TRUE
      END
    END ;
    IF NOT pv THEN
    (* the module's own procedures shadow foreign imports *)
    pi := FindProcN (name) ;
    IF pi >= 0 THEN
      pnodeK := gps[pi].node ;
      cfunc := S3 (CP (modName), '_', name)
    ELSE
      (* foreign procedure: direct extern call, no err slot (par 11) *)
      pi := MFind (foreignProcs, name) ;
      IF pi >= 0 THEN
        IF foreignProcs.es[pi].v IS SOME fp THEN
          tag := '?' ;
          args := '' ;
          (* each argument into a temporary BEFORE the call: a raising
             argument is tested before C sees the zero it answered
             (`StrLen (P ())' passed strlen a NULL), and under [SERIAL]
             no argument runs inside the gate -- a NULL guard's goto
             jumped past the leave and left the gate locked, and
             `F (G (x))' entered G's gate inside F's (the fourth review's
             B2, M1).  The names have an underscore, which M9 cannot
             spell: `m9gm' was a legal variable name and was captured *)
          pre := '' ;
          plain := '' ;
          anyRaise := FALSE ;
          k2 := 0 ;
          IF fp.kids[0] IS SOME fpl THEN
            FOR g := 0 TO fpl.nkids - 1 DO
              IF fpl.kids[g] IS SOME fg THEN
                IF fg.kids[0] IS SOME fids THEN
                  FOR j := 0 TO fids.nkids - 1 DO
                    IF k2 < nargs THEN
                      IF argl IS SOME alx THEN
                        IF Text.BLen (args) > 0 THEN args := S2 (args, ', ') ; plain := S2 (plain, ', ') END ;
                        e1 := EX (alx.kids[k2], '') ;
                        plain := S2 (plain, e1) ;
                        IF LeftRaises (alx.kids[k2]) THEN anyRaise := TRUE END ;
                        at := S2 ('m9_fa', NewTmp ()) ;
                        pre := S6 (pre, '__auto_type ', at, ' = (', e1, '); ') ;
                        IF LeftRaises (alx.kids[k2]) THEN
                          pre := S4 (pre, 'if (err->exc) goto ', raiseLbl, '; ')
                        END ;
                        args := S2 (args, at)
                      END
                    END ;
                    k2 := k2 + 1
                  END
                END
              END
            END
          END ;
          IF k2 # nargs THEN Err2 (eln, 'call arity wrong') END ;

          (* [SERIAL] MEANS SERIALISED, NOT FORBIDDEN.

             The attribute says this foreign procedure may not be
             called concurrently -- ecCodes on a global context,
             blosc on global state, the museum's founding race.  The
             checker's rule was that a THREAD may not REACH one,
             which is unenforceable in practice: its BFS walks a
             per-unit call graph and cannot see a [SERIAL] two
             modules away, which is every realistic case.

             So the generator makes it true instead of checking it.
             One gate per FOR-C unit, because the state these
             procedures share is the LIBRARY's; a caller arriving
             while another thread is inside waits.  Uncontended the
             mutex costs about twenty nanoseconds against a foreign
             call costing microseconds.

             A GNU statement expression, because a call is an
             expression and the lock has to bracket it. *)
          gname := foreignProcs.es[pi].t ;
          ser := FALSE ;
          IF fp.kids[3] IS SOME att THEN
            IF Text.Eq (att.au, 'SERIAL') THEN ser := TRUE END
          END ;
          IF ser AND Text.BLen (gname) > 0 THEN
            IF MFind (gateSeen, gname) < 0 THEN
              MAdd (gateSeen, Text.Keep (gpool, gname), NONE, '') ;
              (* a pointer to the program's ONE gate for the unit,
                 fetched by name on first use (m9rt.h m9_gate): a
                 static monitor per file let two modules calling the
                 same [SERIAL] unit in at once (2026-10-10) *)
              Line (KGate, 0, S3 ('static m9_mon *m9_gate_', gname, ';'))
            END ;
            (* the gate fetched ONCE into a local, entered and left: the
               leave re-read the static plainly while another thread's
               m9_gate might store it -- a data race TSan reports in
               IoPar (the second review's R7), benign only by luck of the
               value being the same *)
            IF fp.kids[1] IS SOME frt THEN
              RETURN S6 (S2 ('({ ', pre), 'm9_mon *m9_gm = m9_gate (&m9_gate_', gname,
                S3 (', "', gname, '"); m9_mon_enter (m9_gm); __typeof__('), S4 (fp.bu, ' (', args, ')'),
                S6 (') m9_gv = ', fp.bu, ' (', args, '); ', 'm9_mon_leave (m9_gm); m9_gv; })'))
            END ;
            RETURN S6 (S2 ('({ ', pre), 'm9_mon *m9_gm = m9_gate (&m9_gate_', gname, S3 (', "', gname, '"); m9_mon_enter (m9_gm); '),
              S4 (fp.bu, ' (', args, '); '),
              'm9_mon_leave (m9_gm); })')
          END ;
          IF anyRaise THEN
            RETURN S5 ('({ ', pre, S4 (fp.bu, ' (', args, ');'), ' ', '})')
          END ;
          (* nothing raises and no gate: the call as it was *)
          RETURN S4 (fp.bu, ' (', plain, ')')
        END
      END
    END
    END
  END ;
  IF pnodeK IS SOME pn THEN
    IF pn.kids[1] IS SOME rt THEN
      IF Text.BLen (pmod) > 0 THEN
        tag := TagOfType (QualIn (pn.kids[1], pmod))
      ELSE
        tag := TagOfType (pn.kids[1])
      END
    END ;
    args := '' ;
    k2 := 0 ;
    IF pn.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          pty := grp.kids[1] ;
          IF Text.BLen (pmod) > 0 THEN pty := QualIn (grp.kids[1], pmod) END ;
          IF grp.kids[0] IS SOME gids THEN
            FOR j := 0 TO gids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME aly THEN
                  ak := aly.kids[k2] ;
                  IF ak IS SOME arg THEN
                    IF Text.BLen (args) > 0 THEN args := S2 (args, ', ') END ;
                    IF grp.f1 OR grp.f2 THEN
                      IF irOn THEN IrArgCheck (dn, argl, k2, FALSE, eln) END ;
                      IF arg.kind = Ast.NDesignator AND arg.nkids = 0 AND
                         (Text.Eq (ScopeMode (arg.au), 'v') OR
                          Text.Eq (ScopeMode (arg.au), 'o')) THEN
                        args := S2 (args, CN (arg.au))
                             (* pass the pointer along *)
                      ELSIF arg.kind = Ast.NDesignator THEN
                        at := '?' ;
                        IF ExprRaises (ak) THEN
                          (* a failed subscript answers the runtime's poison
                             cell with the error set; the call ran on it --
                             a failed `Poke (s[k])' wrote through what an
                             earlier failed store had left in the cell (the
                             second review's gen N1, 2026-10-26) -- so the
                             address is tested first, as a value argument's
                             temporary is *)
                          px := DES (arg, at) ;
                          args := S6 (args, '({ __typeof__ (&(', px, ')) m9v = &(', px,
                            S3 ('); if (err->exc) goto ', raiseLbl, '; m9v; })'))
                        ELSE
                          args := S4 (args, '&(', DES (arg, at), ')')
                        END
                      ELSE
                        Err2 (eln,
                          'VAR argument must be a designator')
                      END ;
                      (* rule 2: the object's pool rides behind it,
                         named from the root of the designator *)
                      IF grp.f1 AND arg.kind = Ast.NDesignator AND
                         PoolParamTy (pty) THEN
                        args := S3 (args, ', ', ObjPoolC (arg))
                      END ;
                      (* a STR, slice or grid takes no pool: the callee
                         adopts a new value into the arena it was called
                         from.  Where the argument outlives that arena --
                         a module variable, an object in a named pool --
                         the call is made from the argument's pool
                         (2026-10-21, the compiler review's C5: SetIt
                         (last, 5) with `last' a module STR read back
                         freed storage) *)
                      IF grp.f1 AND arg.kind = Ast.NDesignator AND
                         NOT PoolParamTy (pty) AND HasPtr (pty, 0) THEN
                        (* a VAR parameter's root is adopted into its pool
                           at this procedure's own exit (AdoptEmit) -- the
                           bare parameter only: a COMPONENT of one,
                           `st.instr[0].model' with st a VAR record, is
                           called from the parameter's pool too (oneflux's
                           PpV1: the string read back freed under ASan,
                           2026-10-26) *)
                        rp := ObjPoolC (arg) ;
                        IF NOT Text.Eq (rp, 'err->res') AND
                           (NOT Text.Eq (ScopeMode (arg.au), 'v') OR Exported (arg.au) OR
                            arg.nkids > 0) THEN
                          IF Text.BLen (rpool) = 0 THEN
                            rpool := rp
                          ELSIF NOT Text.Eq (rpool, rp) THEN
                            Err2 (eln, 'VAR arguments whose storage lives in two pools: pass one per call')
                          END
                        END
                      END
                    ELSE
                      want2 := TagOfType (pty) ;
                      (* ARRAY N OF T is the view of all N elements
                         where a SLICE OF T is expected (par 2.2) *)
                      IF Text.Eq (want2, 'SLICE') AND
                         arg.kind = Ast.NDesignator AND
                         Text.Eq (TagOfExpr (ak), 'ARR') THEN
                        IF irOn THEN IrArgCheck (dn, argl, k2, FALSE, eln) END ;
                        IF Resolve (DesigDecl (arg)) IS SOME av THEN
                          IF av.kind = Ast.NArrayType THEN
                            e1 := TyC (pty) ;   (* order: TyC, *)
                            e2 := EX (ak, '') ;         (* then EX     *)
                            cnt := ArrCount2 (av.kids[0]) ;
                            args := S2 (args, S7 ('((', e1, '){ (', e2,
                              ').v, INT64_C(', cnt, ') })'))
                          ELSE
                            Err2 (eln, 'argument form unsupported yet')
                          END
                        ELSE
                          Err2 (eln, 'argument form unsupported yet')
                        END
                      ELSE
                        (* a raising argument is guarded before this
                           call runs (LowerHoist) *)
                        IF irOn THEN
                          IrArgCheck (dn, argl, k2, TRUE, eln) ;
                          MAdd (irReach, IrKey (aly.id, k2), NONE, '')
                        END ;
                        (* the lowering (docs/ir-plan.md, step 1): a
                           raising argument was made a temporary before
                           this expression was emitted (LowerWalk); its
                           name stands here *)
                        jl := MFind (lowered, IrKey (arg.id, 0)) ;
                        IF jl >= 0 THEN
                          e2 := lowered.es[jl].t
                        ELSE
                          e2 := EX (ak, want2) ;
                        END ;
                        args := S2 (args, e2)
                      END
                    END
                  END
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN Err2 (eln, 'call arity wrong') END ;
    IF Text.BLen (args) > 0 THEN args := S2 (args, ', ') END ;
    IF Text.BLen (rpool) > 0 THEN
      ov := NewTmp () ;
      IF pn.kids[1] IS SOME rt2 THEN
        IF Text.BLen (pmod) > 0 THEN rty := TyC (QualIn (pn.kids[1], pmod))
        ELSE rty := TyC (pn.kids[1]) END ;
        rv := NewTmp () ;
        RETURN S6 (S5 ('({ m9_pool *', ov, ' = err->res; err->res = ', rpool, '; '),
          S3 (rty, ' ', rv), S5 (' = ', cfunc, ' (', args, 'err); '),
          S3 ('err->res = ', ov, '; '), S2 (rv, '; })'), '')
      END ;
      RETURN S6 (S5 ('({ m9_pool *', ov, ' = err->res; err->res = ', rpool, '; '),
        S4 (cfunc, ' (', args, 'err); '), S3 ('err->res = ', ov, '; })'), '', '', '')
    END ;
    RETURN S4 (cfunc, ' (', args, 'err)')
  END ;
  Err2 (eln, S2 ('callee unsupported yet: ', name)) ;
  RETURN '0'
END CallC0 ;

PROCEDURE VariantCtor (vt: PTR Ast.Node ;
                       RO tn: UTF ;
                       RO vn: UTF ;
                       argl: Ast.Kid ; nargs: I64 ;
                       VAR tag: UTF) : UTF =
VAR
  vd : Ast.Kid ;
  args, res : UTF ;
  g, j, k2, eln : I64 ;
BEGIN
  eln := vt.line ;
  IF argl IS SOME a9 THEN eln := a9.line END ;
  vd := NONE ;
  FOR g := 0 TO vt.nkids - 1 DO
    IF vt.kids[g] IS SOME v0 THEN
      IF Text.Eq (v0.au, vn) THEN vd := vt.kids[g] END
    END
  END ;
  IF vd IS SOME vdn THEN
    tag := S2 ('CR:', tn) ;
    args := '' ;
    k2 := 0 ;
    IF vdn.kids[0] IS SOME vfs THEN
      FOR g := 0 TO vfs.nkids - 1 DO
        IF vfs.kids[g] IS SOME vg THEN
          IF vg.kids[0] IS SOME vids THEN
            FOR j := 0 TO vids.nkids - 1 DO
              IF k2 < nargs THEN
                IF argl IS SOME alv THEN
                  IF Text.BLen (args) > 0 THEN args := S2 (args, ', ') END ;
                  args := S2 (args,
                    EX (alv.kids[k2], TagOfType (vg.kids[1])))
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    END ;
    IF k2 # nargs THEN
      Err2 (eln, 'variant constructor arity wrong')
    END ;
    res := S5 ('((', CRPrefix (tn), '){ .tag = ',
      S3 (CRPrefix (tn), '_', vn), '') ;
    IF Text.BLen (args) > 0 THEN
      res := S6 (res, ', .u.', vn, ' = { ', args, ' }')
    END ;
    RETURN S2 (res, ' })')
  END ;
  Err2 (eln, 'variant constructor form unsupported yet') ;
  RETURN '0'
END VariantCtor ;

(* ---- statements ---- *)

(* one EXCEPT arm: identity match, literal payload guards, binders
   copied out of the slots before the slot is cleared *)
PROCEDURE EmitHandler (h: PTR Ast.Node ; RO dlbl: UTF ;
                       ind: I64) =
VAR
  nm, qual, desc, cond, slot, ety, bn, ec : UTF ;
  fields, fx : Ast.Kid ;
  savedScope, ii, di, si, k2, g, j, q, nbl : I64 ;
  blines : SLICE OF UTF ;
  nb : SLICE OF UTF ;
  hasPay : BOOL ;
BEGIN
  nm := '' ;
  qual := '' ;
  IF h.kids[0] IS SOME qn THEN
    nm := qn.au ;
    IF Text.BLen (qn.bu) > 0 THEN
      qual := qn.au ;
      nm := qn.bu
    END
  END ;
  desc := ExcRef (qual, nm, fields) ;
  IF Text.BLen (desc) = 0 THEN
    ErrAt (h, S2 ('unknown exception in handler: ', nm)) ;
    RETURN
  END ;
  cond := S2 ('err->exc == &', desc) ;
  (* `| A, B :' -- the further names, kids[3..]: any of them enters the
     arm; the checker holds a binder to fields the same in all *)
  FOR q := 3 TO h.nkids - 1 DO
    IF h.kids[q] IS SOME qx THEN
      IF Text.BLen (qx.bu) > 0 THEN desc := ExcRef (qx.au, qx.bu, fx)
      ELSE desc := ExcRef ('', qx.au, fx) END ;
      IF Text.BLen (desc) = 0 THEN
        ErrAt (h, S2 ('unknown exception in handler: ', qx.au)) ;
        RETURN
      END ;
      cond := S4 ('(', cond, ' || err->exc == &', S2 (desc, ')'))
    END
  END ;
  blines := NEW (gpool, UTF, 8) ;
  nbl := 0 ;
  savedScope := scope.n ;
  k2 := 0 ; ii := 0 ; di := 0 ; si := 0 ;
  hasPay := FALSE ;
  IF h.kids[1] IS SOME pay0 THEN hasPay := TRUE END ;
  IF hasPay THEN
    IF fields IS SOME fs THEN
      FOR g := 0 TO fs.nkids - 1 DO
        IF fs.kids[g] IS SOME fg THEN
          IF fg.kids[0] IS SOME fids THEN
            FOR j := 0 TO fids.nkids - 1 DO
              ety := TagOfType (fg.kids[1]) ;
              slot := '' ;
              IF Text.Eq (ety, 'F64') OR Text.Eq (ety, 'F32') THEN
                slot := S3 ('err->d[', ItoA (di), ']') ;
                di := di + 1
              ELSIF Text.Eq (ety, 'SLICE') OR Text.Eq (ety, 'UTF') THEN
                si := si + 1          (* a UTF travels in a slice slot *)
              ELSE
                slot := S3 ('err->i[', ItoA (ii), ']') ;
                ii := ii + 1
              END ;
              IF h.kids[1] IS SOME pay THEN
                IF k2 < pay.nkids THEN
                  IF pay.kids[k2] IS SOME arg THEN
                    IF arg.kind = Ast.NIdent THEN
                      bn := CN (arg.au) ;
                      IF nbl = LEN (blines) THEN
                        nb := NEW (gpool, UTF, 2 * LEN (blines)) ;
                        FOR q := 0 TO nbl - 1 DO nb[q] := blines[q] END ;
                        blines := nb
                      END ;
                      IF Text.Eq (ety, 'SLICE') OR Text.Eq (ety, 'UTF') THEN
                        ec := '' ;
                        IF Text.Eq (ety, 'UTF') THEN
                          ec := 'uint8_t'          (* a UTF's octets *)
                        ELSIF Resolve (fg.kids[1]) IS SOME sr THEN
                          ec := TyC (sr.kids[0])
                        END ;
                        (* a copy in this procedure's frame: the
                           in-flight one is overwritten by the next
                           raise (m9rt.h, m9_pay_take) *)
                        blines[nbl] := S9 (TyC (fg.kids[1]), ' ', bn,
                          ' = { (', ec, ' *) m9_pay_take (err, ',
                          ItoA (si - 1), ', sizeof (',
                          S9 (ec, ')), err->s[', ItoA (si - 1),
                          '].len }; (void) ', bn, ';', '', '', ''))
                      ELSIF Text.StartsWith (ety, 'CR:') THEN
                        (* an enumeration, back from its tag *)
                        blines[nbl] := S7 (TyC (fg.kids[1]), ' ', bn,
                          ' = { .tag = ', slot, ' }; (void) ',
                          S2 (bn, ';'))
                      ELSE
                        blines[nbl] := S7 (TyC (fg.kids[1]), ' ', bn,
                          ' = ', slot, '; (void) ',
                          S2 (bn, ';'))
                      END ;
                      nbl := nbl + 1 ;
                      (* the maps keep their keys: a copy, not a view
                         of the tree (par 4.1, 2026-10-18) *)
                      MAdd (bpool, Text.Keep (gpool, arg.au), NONE, 'err->res') ;
                      MAdd (scope, Text.Keep (gpool, arg.au), fg.kids[1], 'b')
                    ELSIF arg.kind = Ast.NInt THEN
                      cond := S5 (cond, ' && ', slot, ' == INT64_C(',
                        S2 (arg.au, ')'))
                    ELSE
                      ErrAt (h,
                        'handler payload form unsupported yet')
                    END
                  END
                END
              END ;
              k2 := k2 + 1
            END
          END
        END
      END
    ELSE
      ErrAt (h, 'handler payload form unsupported yet')
    END
  END ;
  Line (KPbuf, ind, S3 ('if (', cond, ') {')) ;
  FOR j := 0 TO nbl - 1 DO
    Line (KPbuf, ind + 1, blines[j])
  END ;
  Line (KPbuf, ind + 1, 'err->exc = NULL;') ;
  EmitSeq (h.kids[2], ind + 1) ;
  Line (KPbuf, ind + 1, S2 ('goto ', S2 (dlbl, ';'))) ;
  Line (KPbuf, ind, '}') ;
  scope.n := savedScope
END EmitHandler ;

PROCEDURE EmitSeq (k: Ast.Kid ; ind: I64) =
VAR j : I64 ;
BEGIN
  IF k IS SOME s THEN
    FOR j := 0 TO s.nkids - 1 DO
      EmitStmt (s.kids[j], ind)
    END
  END
END EmitSeq ;

(* IS binding forms are legal only as the whole condition of an
   IF/ELSIF/WHILE (par 10), so absence gets its own predicate *)
PROCEDURE IsNone (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN RETURN FALSE END ;
  RETURN TRUE
END IsNone ;

PROCEDURE IsSomeCond (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME c THEN
    IF c.kind = Ast.NIs THEN
      IF c.kids[1] IS SOME rhs THEN
        RETURN rhs.kind = Ast.NIsSome AND Text.BLen (rhs.au) > 0
      END
    END
  END ;
  RETURN FALSE
END IsSomeCond ;

PROCEDURE EmitCaseCR (st: PTR Ast.Node ; RO w: UTF ;
                      RO tg: UTF ; ind: I64) ;
PROCEDURE EmitCaseScalar (st: PTR Ast.Node ; RO w: UTF ;
                          ind: I64) ;
PROCEDURE EmitBlock (KEPT st: PTR Ast.Node ; ind: I64) ;
PROCEDURE EmitDispose (st: PTR Ast.Node ; ind: I64) ;
PROCEDURE EmitRaise (st: PTR Ast.Node ; ind: I64) ;

(* the end of a loop body an EXIT inside a CASE arm jumps to: the
   break there leaves the loop the body belongs to *)
PROCEDURE LoopExit (ind: I64) =
BEGIN
  IF Text.BLen (xitLbl) > 0 THEN
    Line (KPbuf, ind, S3 ('if (0) { ', xitLbl, ': break; }'))
  END
END LoopExit ;

(* does this IF hold an ELSIF that IS SOME makes the generator nest *)
PROCEDURE NeedsSplit (st: PTR Ast.Node) : BOOL =
VAR j : I64 ; elsif, some : BOOL ;
BEGIN
  elsif := FALSE ;
  some := IsSomeCond (st.kids[0]) ;
  FOR j := 2 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME tail THEN
      IF tail.kind = Ast.NElsif THEN
        elsif := TRUE ;
        IF IsSomeCond (tail.kids[0]) THEN some := TRUE END
      END
    END
  END ;
  RETURN elsif AND some
END NeedsSplit ;

(* IF c1 THEN s1 ELSIF c2 THEN s2 <rest> END as IF c1 THEN s1 ELSE
   IF c2 THEN s2 <rest> END END; the inner IF is split again if it
   needs it *)
PROCEDURE SplitIf (KEPT st: PTR Ast.Node) : PTR Ast.Node =
VAR
  outer, inner, els, seq : PTR Ast.Node IN gpool ;
  j : I64 ;
BEGIN
  inner := Ast.NewNode (gpool, Ast.NIf, st.line, st.col) ;
  IF st.kids[2] IS SOME first THEN
    Ast.Add (gpool, inner, first.kids[0]) ;
    Ast.Add (gpool, inner, first.kids[1])
  END ;
  FOR j := 3 TO st.nkids - 1 DO Ast.Add (gpool, inner, st.kids[j]) END ;
  seq := Ast.NewNode (gpool, Ast.NStmtSeq, st.line, st.col) ;
  Ast.Add (gpool, seq, SOME (inner)) ;
  els := Ast.NewNode (gpool, Ast.NElse, st.line, st.col) ;
  Ast.Add (gpool, els, SOME (seq)) ;
  outer := Ast.NewNode (gpool, Ast.NIf, st.line, st.col) ;
  Ast.Add (gpool, outer, st.kids[0]) ;
  Ast.Add (gpool, outer, st.kids[1]) ;
  Ast.Add (gpool, outer, SOME (els)) ;
  RETURN outer
END SplitIf ;

(* ---- a statement's temporaries, released with the statement
        (docs/statement-release-plan.md, stage 2; 2026-10-18) ----

   RELEASABLE = the statement ALLOCATES in the arena, and no SINK
   receives an expression that contains an allocation.  An allocation
   is a string `+`, a frame-form NEW, or a call whose answer carries a
   pointer (the callee built it in our arena -- or in a pool, which a
   release of the arena cannot touch, so counting it costs a mark and
   nothing else).  A sink is the right side of an assignment whose
   left side's type carries a pointer, an argument in VAR, OWN or KEPT
   position, and any argument of a callee this generator cannot
   resolve to a head -- a foreign procedure, a constructor -- taken
   conservatively.  RETURN, RAISE, THREAD and the binder forms are
   never released.  Syntactic, over one statement's trees and the
   typed tree, plus the one fact the checker enforces: KEPT (par 4.1).
   The release is skipped on the error path, as the frame's exit frees
   everything anyway.  Mirrors nothing: M9Gen.pas carries the same
   four procedures and gendiff holds them identical.                 *)
PROCEDURE Allocates (k: Ast.Kid) : BOOL =
VAR
  i, ext0 : I64 ;
  lt, rt : UTF ;
  tyk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') THEN
      lt := TagOfExpr (e.kids[0]) ;
      rt := TagOfExpr (e.kids[1]) ;
      IF Text.Eq (lt, 'SLICE') OR Text.Eq (lt, 'STR1') OR
         Text.Eq (rt, 'SLICE') OR Text.Eq (rt, 'STR1') THEN
        RETURN TRUE
      END
    END ;
    IF e.kind = Ast.NNewExpr THEN
      IF Text.Eq (NewShape (e, tyk, ext0), 'frame') THEN RETURN TRUE END
    END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallSel THEN
      IF Ast.TypeAt (e.id) IS SOME rt0 THEN
        IF HasPtr (SOME (rt0), 0) THEN RETURN TRUE END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF Allocates (e.kids[i]) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END Allocates ;

(* the callee's head -- a declaration's node, or a procedure type's
   -- the way CallC finds it: Mod.Proc in the loaded definitions, a
   procedure value in scope, this module's own; NONE for a builtin, a
   foreign procedure, a constructor or anything unknown *)
PROCEDURE CalleeHead (dn: Ast.Kid) : Ast.Kid =
VAR
  name : UTF ;
  j, g : I64 ;
BEGIN
  IF dn IS SOME dnode THEN
    IF dnode.kind # Ast.NDesignator THEN RETURN NONE END ;
    name := dnode.au ;
    FOR j := 0 TO dnode.nkids - 1 DO
      IF dnode.kids[j] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN name := S3 (name, '.', sf.au) ELSE RETURN NONE END
      END
    END ;
    IF FindCh (name, '.') >= 0 THEN
      g := MFind (extProcs, name) ;
      IF g >= 0 THEN RETURN extProcs.es[g].v END ;
      RETURN NONE
    END ;
    IF Resolve (ScopeNode (name)) IS SOME svt THEN
      IF svt.kind = Ast.NProcType THEN RETURN SOME (svt) END
    END ;
    g := FindProcN (name) ;
    IF g >= 0 THEN RETURN gps[g].node END
  END ;
  RETURN NONE
END CalleeHead ;

(* does a SINK under K receive an expression containing an allocation
   -- an argument in VAR, OWN or KEPT position, or any argument of a
   callee without a head (a builtin keeps nothing and is walked
   through) *)

(* a parameter type of the head a call names, read in the module
   that wrote it: QualIn for an imported callee (`Mod.Proc'), the node
   itself for this module's own (CallC's pmod) *)
PROCEDURE HeadType (KEPT t: Ast.Kid ; dn: PTR Ast.Node) : Ast.Kid =
BEGIN
  IF dn.nkids > 0 THEN
    IF MFind (extMods, dn.au) >= 0 THEN
      RETURN QualIn (t, Text.Keep (gpool, dn.au))
    END
  END ;
  RETURN t
END HeadType ;

PROCEDURE SinkAlloc (k: Ast.Kid) : BOOL =
VAR
  i, g, b, n : I64 ;
  name : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[0] IS SOME dn THEN
        name := dn.au ;
        IF CalleeHead (e.kids[0]) IS SOME hd THEN
          IF e.kids[1] IS SOME al THEN
            n := 0 ;
            IF hd.kids[0] IS SOME pl THEN
              FOR g := 0 TO pl.nkids - 1 DO
                IF pl.kids[g] IS SOME grp THEN
                  IF grp.kids[0] IS SOME ids THEN
                    FOR b := 0 TO ids.nkids - 1 DO
                      IF n < al.nkids AND (grp.f1 OR grp.f2 OR grp.f4) THEN
                        IF Allocates (al.kids[n]) THEN RETURN TRUE END
                      END ;
                      (* A VAR ARGUMENT THAT CARRIES A POINTER is a sink
                         whether or not it allocates: what the callee
                         stores there may be re-homed into the arena the
                         statement marks -- the hidden pool behind a VAR
                         pointer or record is that arena for a frame-form
                         root (DynStr.Append growing `d`: cp-kernel's
                         Cs.Canonical, 2026-10-18), and a new string or
                         slice the callee assigns to a VAR STR or SLICE is
                         adopted into the caller's arena at its exit
                         (`Add (a, x + y)` with `line := line + datum`:
                         OneFlux's Va.m9 and EddyPro's header lines,
                         2026-10-19).  Either lands above the mark and the
                         release freed it. *)
                      IF n < al.nkids AND grp.f1 AND
                         HasPtr (HeadType (grp.kids[1], dn), 0) THEN
                        RETURN TRUE
                      END ;
                      n := n + 1
                    END
                  END
                END
              END
            END
          END
        ELSIF NOT (dn.nkids = 0 AND IsBuiltinCall (name)) THEN
          IF Allocates (e.kids[1]) THEN RETURN TRUE END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF SinkAlloc (e.kids[i]) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END SinkAlloc ;

(* is this call statement or assignment released with the statement?

   NEVER IN A MODULE BODY (OneFlux, 2026-10-19).  There the marked
   arena is &m9mframe, and that is not this statement's alone: it is
   the pool every module variable without IN names (rule 2), so any
   procedure of the module the statement calls may grow such a
   variable's object in it -- `Line (s + t)` appending to a module
   `out : PTR DynUtf.DString` -- and every frame allocation a callee
   keeps in a module variable is adopted into it at the callee's exit
   (rule 1).  Both land above the mark, and the release freed them:
   OneFlux's gate programs printed NUL bytes.  What a callee can reach
   in a PROCEDURE's frame arena is only what its arguments name, which
   SinkAlloc sees. *)
PROCEDURE Releasable (st: PTR Ast.Node) : BOOL =
BEGIN
  IF inMain THEN RETURN FALSE END ;
  IF st.kind = Ast.NCallStmt THEN
    RETURN Allocates (st.kids[1]) AND NOT SinkAlloc (SOME (st))
  END ;
  IF st.kind = Ast.NAssign THEN
    IF st.kids[0] IS SOME lhs THEN
      IF Ast.TypeAt (lhs.id) IS SOME lt THEN
        IF HasPtr (SOME (lt), 0) THEN RETURN FALSE END
      ELSE
        RETURN FALSE
      END
    END ;
    RETURN Allocates (st.kids[1]) AND NOT SinkAlloc (st.kids[1])
  END ;
  RETURN FALSE
END Releasable ;

(* a condition's release: the mark before its evaluation, the test
   hoisted into a bool, the release after -- or '' when the condition
   allocates nothing it could not also leak *)
PROCEDURE CondMark (k: Ast.Kid ; ind: I64) : UTF =
VAR mk : UTF ;
BEGIN
  (* not in a module body: Releasable says why *)
  IF NOT inMain AND Allocates (k) AND NOT SinkAlloc (k) THEN
    mk := NewTmp () ;
    Line (KPbuf, ind, S3 ('m9_mark ', mk, ' = m9_pool_mark (err->res);')) ;
    RETURN mk
  END ;
  RETURN ''
END CondMark ;

PROCEDURE EmitStmt (k: Ast.Kid ; ind: I64) =
VAR
  savedXit, mk : UTF ;
  l, r, tg, w, cnd, stp, bname, thrPool : UTF ;
  j, j2, savedScope, sv, sf, thrPi, h0, kh, nh : I64 ;
  hc : SLICE OF I64 ;
  vtN, vd, sop : Ast.Kid ;
  thrWants, lRaise, shared, rel, thrRef, rs : BOOL ;
  thrPty : UTF ;
BEGIN
  IF k IS SOME st THEN
    DbgLine (st) ;
    CASE st.kind OF
    | Ast.NAssign :
        rel := Releasable (st) ;
        IF rel THEN
          mk := NewTmp () ;
          Line (KPbuf, ind, S3 ('m9_mark ', mk, ' = m9_pool_mark (err->res);'))
        END ;
        tg := '?' ;
        nh := Lower (st.kids[0], ind) ;
        IF st.kids[0] IS SOME lhs THEN l := DES (lhs, tg) ELSE l := '0' END ;
        rs := LeftRaisesTarget (st.kids[0]) ;
        lRaise := rs ;
        nh := nh + Lower (st.kids[1], ind) ;
        r := EX (st.kids[1], tg) ;
        rs := LeftRaises (st.kids[1]) ;
        (* copying a SHARED handle refcounts it (par 4.2); SHARED(x)
           itself already set rc=1 and is not re-counted *)
        (* ... and only a copy OF A BINDING counts: a name, a field, an
           element, which keep their own count.  `SHARED (o)' and a
           call's answer are MOVES -- the handle has no other holder,
           and no exit releases one (only DISPOSE does) -- and were
           counted again until 2026-10-21: `s := SHARED (o) ; DISPOSE
           (s)' left rc at 1 and never freed, 1.62 GB for 2000 rounds
           of a 100,000-element store (the compiler review's G7) *)
        (* an OPT SHARED target too, given SOME (x): `g := SOME (p)' was
           a plain copy, so a kept handle did not count and died with the
           caller's DISPOSE (the third review's ownership O4) *)
        (* an OPT SHARED source too (`g := q', the third review's B1):
           any binding of either kind, into a target of either kind *)
        shared := SharedBinding (st.kids[1]) AND
                  (Text.Eq (tg, 'SHARED') OR OptShared (st.kids[0])) ;
        IF rs THEN
          (* A CALL THAT RAISED ANSWERED NOTHING (report par 5,
             2026-10-03): the right side goes into a temporary, the
             error slot is read, and only then is the target written.
             Until then `b := Make (0)' stored Make's zero -- NULL
             into a pointer that is not OPT -- and went to the
             handler, which read the pointer a later line died on
             (ShareUse); a SHARED answer was share-copied before the
             test as well (ZarrStoreTest).  __typeof__ of the target
             evaluates nothing, so an indexed target is checked once,
             at the store. *)
          Line (KPbuf, ind, S5 ('{ __typeof__(', l, ') m9v = ', r, ';')) ;
          Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
          IF shared THEN
            r := S3 ('((__typeof__(', l, ')) m9_share_copy (m9v))')
          ELSE
            r := 'm9v'
          END ;
          Line (KPbuf, ind + 1, S4 (l, ' = ', r, ';')) ;
          IF lRaise THEN
            Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          Line (KPbuf, ind, '}') ;
        ELSE
          IF shared THEN
            r := S5 ('((__typeof__(', r, ')) m9_share_copy (', r, '))')
          END ;
          Line (KPbuf, ind, S4 (l, ' = ', r, ';')) ;
          IF lRaise THEN
            Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END
        END ;
        CloseN (nh, ind) ;
        IF rel THEN
          Line (KPbuf, ind, S3 ('m9_pool_release (err->res, ', mk, ');'))
        END
    | Ast.NCallStmt :
        rel := Releasable (st) ;
        IF rel THEN
          mk := NewTmp () ;
          Line (KPbuf, ind, S3 ('m9_mark ', mk, ' = m9_pool_mark (err->res);'))
        END ;
        tg := '?' ;
        nh := LowerArgs (st.kids[0], st.kids[1], ind) ;
        Line (KPbuf, ind, S2 (CallC (st.kids[0], st.kids[1], tg), ';')) ;
        rs := LeftRaisesCall (st) ;
        IF rs THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        CloseN (nh, ind) ;
        IF rel THEN
          Line (KPbuf, ind, S3 ('m9_pool_release (err->res, ', mk, ');'))
        END
    | Ast.NIf :
        (* an ELSIF chain with IS SOME in it -- at its head or in an arm
           -- is emitted as the nested IF it means: IF c1 THEN s1 ELSE
           IF c2 THEN s2 ... END END (ELSIF after IS SOME was refused
           until 2026-10-09; every other IF keeps its C) *)
        IF NeedsSplit (st) THEN
          EmitStmt (SOME (SplitIf (st)), ind) ;
          RETURN
        END ;
        (* IF x IS SOME p THEN: bind the payload, test for NULL *)
        IF IsSomeCond (st.kids[0]) THEN
          IF st.kids[0] IS SOME isn THEN
            vtN := OptInner (isn.kids[0]) ;
            IF vtN IS SOME vt0 THEN
              cnd := EX (isn.kids[0], '') ;
              rs := LeftRaises (isn.kids[0]) ;
              bname := '' ;
              IF isn.kids[1] IS SOME bn0 THEN bname := Text.Keep (gpool, bn0.au) END ;
              Line (KPbuf, ind, S6 ('{ ', TyC (vtN), ' ', CN (bname),
                ' = ', S2 (cnd, ';'))) ;
              IF rs THEN
                Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
              END ;
              savedScope := scope.n ;
              MAdd (bpool, bname, NONE, Text.Keep (gpool, OriginPool (isn.kids[0]))) ;
              MAdd (scope, bname, vtN, 'b') ;
              Line (KPbuf, ind, S3 ('if (', CN (bname), ' != NULL) {')) ;
              EmitSeq (st.kids[1], ind + 1) ;
              FOR j := 2 TO st.nkids - 1 DO
                IF st.kids[j] IS SOME tail THEN
                  IF tail.kind = Ast.NElsif THEN
                    ErrAt (st, 'ELSIF after IS SOME unsupported yet')
                  ELSE
                    Line (KPbuf, ind, '} else {') ;
                    EmitSeq (tail.kids[0], ind + 1)
                  END
                END
              END ;
              Line (KPbuf, ind, '} }') ;
              scope.n := savedScope
            ELSE
              ErrAt (st, 'IS SOME form unsupported yet')
            END
          END ;
          RETURN
        END ;
        mk := CondMark (st.kids[0], ind) ;
        (* a raising argument in a condition is hoisted where the
           condition is evaluated, and its blocks stay open over the
           arms (the compiler review's G6): F (SLICE (s, 1, k)) ran on
           the failed view before the error was seen.  ELSIF's hoist
           in its own else block, closed before that block's brace;
           the body's statements start with none open *)
        hc := NEW (I64, st.nkids + 1) ;
        h0 := Lower (st.kids[0], ind) ;
        cnd := EX (st.kids[0], '') ;
        rs := LeftRaises (st.kids[0]) ;
        IF rs OR Text.BLen (mk) > 0 THEN
          w := NewTmp () ;
          Line (KPbuf, ind, S4 ('bool ', w, ' = ', S2 (cnd, ';'))) ;
          IF rs THEN
            Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          IF Text.BLen (mk) > 0 THEN
            Line (KPbuf, ind, S3 ('m9_pool_release (err->res, ', mk, ');'))
          END ;
          cnd := w
        END ;
        Line (KPbuf, ind, S3 ('if (', cnd, ') {')) ;
        EmitSeq (st.kids[1], ind + 1) ;
        (* ELSIF becomes a nested else-block so a raising condition
           can be hoisted with its guard before the test *)
        j2 := 0 ;
        FOR j := 2 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME tail THEN
            IF tail.kind = Ast.NElsif THEN
              Line (KPbuf, ind, '} else {') ;
              mk := CondMark (tail.kids[0], ind + 1) ;
              hc[j2 + 1] := Lower (tail.kids[0], ind + 1) ;
              cnd := EX (tail.kids[0], '') ;
              rs := LeftRaises (tail.kids[0]) ;
              IF rs OR Text.BLen (mk) > 0 THEN
                w := NewTmp () ;
                Line (KPbuf, ind + 1, S4 ('bool ', w, ' = ',
                  S2 (cnd, ';'))) ;
                IF rs THEN
                  Line (KPbuf, ind + 1,
                    S3 ('if (err->exc) goto ', raiseLbl, ';'))
                END ;
                IF Text.BLen (mk) > 0 THEN
                  Line (KPbuf, ind + 1,
                    S3 ('m9_pool_release (err->res, ', mk, ');'))
                END ;
                cnd := w
              END ;
              Line (KPbuf, ind + 1, S3 ('if (', cnd, ') {')) ;
              EmitSeq (tail.kids[1], ind + 2) ;
              j2 := j2 + 1
            ELSE
              Line (KPbuf, ind, '} else {') ;
              EmitSeq (tail.kids[0], ind + 1)
            END
          END
        END ;
        cnd := '}' ;
        FOR j := j2 TO 1 BY -1 DO
          FOR kh := 1 TO hc[j] DO cnd := S2 (cnd, ' }') END ;
          cnd := S2 (cnd, ' }')
        END ;
        FOR kh := 1 TO h0 DO cnd := S2 (cnd, ' }') END ;
        Line (KPbuf, ind, cnd)
    | Ast.NWhile :
        (* WHILE x IS SOME p DO: rebind per iteration *)
        IF IsSomeCond (st.kids[0]) THEN
          IF st.kids[0] IS SOME isn THEN
            vtN := OptInner (isn.kids[0]) ;
            IF vtN IS SOME vt1 THEN
              bname := '' ;
              IF isn.kids[1] IS SOME bn1 THEN bname := Text.Keep (gpool, bn1.au) END ;
              Line (KPbuf, ind, 'for (;;) {') ;
              cnd := EX (isn.kids[0], '') ;
              rs := LeftRaises (isn.kids[0]) ;
              Line (KPbuf, ind + 1, S5 (TyC (vtN), ' ', CN (bname),
                ' = ', S2 (cnd, ';'))) ;
              IF rs THEN
                Line (KPbuf, ind + 1,
                  S3 ('if (err->exc) goto ', raiseLbl, ';'))
              END ;
              Line (KPbuf, ind + 1,
                S3 ('if (!(', CN (bname), ' != NULL)) break;')) ;
              savedScope := scope.n ;
              MAdd (bpool, bname, NONE, Text.Keep (gpool, OriginPool (isn.kids[0]))) ;
              MAdd (scope, bname, vtN, 'b') ;
              sv := inSwitch ; inSwitch := 0 ;
              sf := finDepth ; finDepth := 0 ;
              savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
              EmitSeq (st.kids[1], ind + 1) ;
              LoopExit (ind + 1) ;
              loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
              inSwitch := sv ; finDepth := sf ;
              scope.n := savedScope ;
              Line (KPbuf, ind, '}')
            ELSE
              ErrAt (st, 'IS SOME form unsupported yet')
            END
          END ;
          RETURN
        END ;
        Line (KPbuf, ind, 'for (;;) {') ;
        mk := CondMark (st.kids[0], ind + 1) ;
        (* hoisted INSIDE the loop, before the test, and closed at the
           end of the body: evaluated every pass, as the condition is *)
        h0 := Lower (st.kids[0], ind + 1) ;
        cnd := EX (st.kids[0], '') ;
        rs := LeftRaises (st.kids[0]) ;
        IF rs OR Text.BLen (mk) > 0 THEN
          w := NewTmp () ;
          Line (KPbuf, ind + 1, S4 ('bool ', w, ' = ', S2 (cnd, ';'))) ;
          IF rs THEN
            Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          IF Text.BLen (mk) > 0 THEN
            Line (KPbuf, ind + 1, S3 ('m9_pool_release (err->res, ', mk, ');'))
          END ;
          cnd := w
        END ;
        Line (KPbuf, ind + 1, S3 ('if (!(', cnd, ')) break;')) ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
        EmitSeq (st.kids[1], ind + 1) ;
        LoopExit (ind + 1) ;
        FOR kh := 1 TO h0 DO Line (KPbuf, ind + 1, '}') END ;
        loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '}')
    | Ast.NFor :
        (* FOR over an enumeration walks its tags: the variable is a
           struct, so the loop runs on `.tag' -- c.tag = lo.tag;
           c.tag <= hi.tag; c.tag++ (docs/enum-plan.md, part 2) *)
        IF StartsW (TagOfExpr (st.kids[0]), 'CR:') THEN
          w := NewTmp () ;
          Line (KPbuf, ind, S3 ('{ int32_t ', w, 'to;')) ;
          Line (KPbuf, ind, S5 (CN (st.au), '.tag = (', EX (st.kids[0], ''),
            ').tag;', '')) ;
          Line (KPbuf, ind, S5 (w, 'to = (', EX (st.kids[1], ''),
            ').tag;', '')) ;
          Line (KPbuf, ind, S9 ('for (; ', CN (st.au), '.tag <= ', w,
            'to; ', CN (st.au), '.tag++', ') {', '')) ;
          sv := inSwitch ; inSwitch := 0 ;
          sf := finDepth ; finDepth := 0 ;
          savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
          EmitSeq (st.kids[3], ind + 1) ;
          LoopExit (ind + 1) ;
          loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
          inSwitch := sv ; finDepth := sf ;
          Line (KPbuf, ind, '} }') ;
          RETURN
        END ;
        (* a raising argument in a bound is guarded before the loop
           (LowerHoist), as in a statement: the bounds are evaluated once,
           so the hoists open here and close after the loop (2026-10-21,
           the compiler review's G6) *)
        h0 := Lower (st.kids[0], ind) ;
        l := EX (st.kids[0], '') ;
        w := NewTmp () ;
        (* the bound in the VARIABLE's type, and the test before the
           step (2026-10-21, the compiler review's G5): `for (; i <=
           to; i += s)' stepped past the type's last value -- I8 120 TO
           127 and U8 3 TO 0 BY -1 never ended, I64 MAX-2 TO MAX was
           signed overflow -- and an int64_t bound truncated a U64's.
           Now the loop is entered when the bound is reached at all,
           and left when the distance still to go, in unsigned
           arithmetic, is less than the step: the variable never leaves
           lo .. to, and holds the last value it took *)
        Line (KPbuf, ind, S5 ('{ __typeof__(', CN (st.au), ') ', w, 'to;')) ;
        Line (KPbuf, ind, S4 (CN (st.au), ' = ', l, ';')) ;
        h0 := h0 + Lower (st.kids[1], ind) ;
        r := EX (st.kids[1], '') ;
        rs := LeftRaises (st.kids[0]) OR LeftRaises (st.kids[1]) ;
        Line (KPbuf, ind, S4 (w, 'to = ', r, ';')) ;
        IF rs THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        stp := '1' ;
        IF st.kids[2] IS SOME by THEN
          stp := '' ;
          IF by.kind = Ast.NInt THEN
            stp := by.au
          ELSIF by.kind = Ast.NUn AND Text.Eq (by.au, '-') THEN
            IF by.kids[0] IS SOME bl THEN
              IF bl.kind = Ast.NInt THEN stp := S2 ('-', bl.au) END
            END
          END ;
          (* any other constant step -- a CONST, an imported one, an
             expression of literals -- through the one evaluator; the
             checker has refused a step that is not a constant (par 10) *)
          IF Text.BLen (stp) = 0 THEN stp := StepC (st.kids[2]) END ;
          IF Text.BLen (stp) = 0 THEN
            ErrAt (st, 'FOR BY step form unsupported yet') ;
            stp := '1'
          END
        END ;
        IF B (stp, 0) = ORD ('-') THEN
          Line (KPbuf, ind, S6 ('if (', CN (st.au), ' >= ', w, 'to) for (;;) {', ''))
        ELSE
          Line (KPbuf, ind, S6 ('if (', CN (st.au), ' <= ', w, 'to) for (;;) {', ''))
        END ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
        EmitSeq (st.kids[3], ind + 1) ;
        LoopExit (ind + 1) ;
        IF B (stp, 0) = ORD ('-') THEN
          Line (KPbuf, ind + 1, S7 ('if ((uint64_t) ', CN (st.au), ' - (uint64_t) ', w,
            'to < (uint64_t) ', SLICE (stp, 1, Text.BLen (stp) - 1), ') break;'))
        ELSE
          Line (KPbuf, ind + 1, S7 ('if ((uint64_t) ', w, 'to - (uint64_t) ', CN (st.au),
            ' < (uint64_t) ', stp, ') break;'))
        END ;
        Line (KPbuf, ind + 1, S4 (CN (st.au), ' += ', stp, ';')) ;
        loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '} }') ;
        FOR kh := 1 TO h0 DO Line (KPbuf, ind, '}') END
    | Ast.NForIn :
        (* FOR x IN s (2026-10-11): s evaluated ONCE -- a slice's
           descriptor copied, an array by its address -- and x given each
           element in turn; the index is the loop's own, so no element
           read needs a check *)
        tg := TagOfExpr (st.kids[0]) ;
        l := EX (st.kids[0], '') ;
        rs := LeftRaises (st.kids[0]) ;
        w := NewTmp () ;
        IF Text.Eq (tg, 'ARR') THEN
          Line (KPbuf, ind, S7 ('{ __typeof__(', l, ') *', w, 's = &(', l, ');'))
        ELSE
          Line (KPbuf, ind, S7 ('{ __typeof__(', l, ') ', w, 's = ', l, ';'))
        END ;
        IF rs THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        IF Text.Eq (tg, 'ARR') AND ForInPtr (st.kids[0]) THEN
          (* an array of pointers: each element tested as the slice's are *)
          Line (KPbuf, ind, S9 ('for (int64_t ', w, 'i = 0; ', w,
            'i < (int64_t) (sizeof (', w, 's->v) / sizeof (', w,
            S5 ('s->v[0])); ', w, 'i++) { ', CN (st.au), S3 (' = ',
              NnGuard (S4 (w, 's->v[', w, 'i]'), NONE, FALSE), ';'))))
        ELSIF Text.Eq (tg, 'ARR') THEN
          Line (KPbuf, ind, S9 ('for (int64_t ', w, 'i = 0; ', w,
            'i < (int64_t) (sizeof (', w, 's->v) / sizeof (', w,
            S5 ('s->v[0])); ', w, 'i++) { ', CN (st.au), S4 (' = ', w, 's->v[', S2 (w, 'i];')))))
        ELSIF Text.Eq (tg, 'UTF') THEN
          (* FOR c IN u decodes: the index is a byte offset the decoding
             step moves (docs/utf8-plan.md, U3) *)
          Line (KPbuf, ind, S9 ('for (int64_t ', w, 'i = 0; ', w, 'i < ', w,
            's.len; ) { ', CN (st.au), S5 (' = m9_utf_next (', w, 's, &', w, 'i);')))
        ELSIF ForInPtr (st.kids[0]) THEN
          (* a pointer element is tested before the body follows it, as
             s[i] is (decision 58): an unset one raised SIGSEGV in the
             body (review2 N6) *)
          Line (KPbuf, ind, S9 ('for (int64_t ', w, 'i = 0; ', w, 'i < ', w,
            's.len; ', w, S5 ('i++) { ', CN (st.au), ' = ',
            NnGuard (S4 (w, 's.p[', w, 'i]'), NONE, FALSE), ';')))
        ELSE
          Line (KPbuf, ind, S9 ('for (int64_t ', w, 'i = 0; ', w, 'i < ', w,
            's.len; ', w, S5 ('i++) { ', CN (st.au), ' = ', w, S4 ('s.p[', w, 'i];', ''))))
        END ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
        EmitSeq (st.kids[1], ind + 1) ;
        LoopExit (ind + 1) ;
        loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '} }')
    | Ast.NLoop :
        (* EXIT leaves the innermost LOOP, WHILE or FOR (report par 5):
           a C `break' where that loop is the innermost breakable
           construct, else -- inside a CASE arm's switch -- a goto to
           `if (0) { m9xitN: break; }' at the end of the loop's body,
           made only when such an EXIT is met (refused until
           2026-10-09: the break would have left the switch) *)
        Line (KPbuf, ind, 'for (;;) {') ;
        sv := inSwitch ; inSwitch := 0 ;
        sf := finDepth ; finDepth := 0 ;
        savedXit := xitLbl ; xitLbl := '' ; loopDepth := loopDepth + 1 ;
        EmitSeq (st.kids[0], ind + 1) ;
        LoopExit (ind + 1) ;
        loopDepth := loopDepth - 1 ; xitLbl := savedXit ;
        inSwitch := sv ; finDepth := sf ;
        Line (KPbuf, ind, '}')
    | Ast.NExit :
        IF loopDepth = 0 THEN
          ErrAt (st, 'EXIT outside a loop')
        END ;
        IF finDepth > 0 THEN
          ErrAt (st,
            'EXIT across FINALLY refused (it would skip the cleanup)')
        END ;
        IF inSwitch > 0 THEN
          IF Text.BLen (xitLbl) = 0 THEN
            xitN := xitN + 1 ;
            xitLbl := Text.Keep (gpool, S2 ('m9xit', ItoA (xitN)))
          END ;
          Line (KPbuf, ind, S3 ('goto ', xitLbl, ';'))
        ELSE
          Line (KPbuf, ind, 'break;')
        END
    | Ast.NBlock : EmitBlock (st, ind)
    | Ast.NCase :
        (* the selector's raising arguments hoisted, closed after the
           switch (the compiler review's G6) *)
        h0 := Lower (st.kids[0], ind) ;
        cnd := EX (st.kids[0], '') ;
        rs := LeftRaises (st.kids[0]) ;
        tg := TagOfExpr (st.kids[0]) ;
        w := NewTmp () ;
        Line (KPbuf, ind, S6 ('{ __typeof__(', cnd, ') ', w, ' = ',
          S2 (cnd, ';'))) ;
        IF rs THEN
          Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
        END ;
        IF StartsW (tg, 'CR:') THEN
          EmitCaseCR (st, w, tg, ind)
        ELSIF Text.Eq (tg, 'CHAR') OR Text.Eq (tg, 'I64') OR
              Text.OneOf (STR (tg), CaseInts) THEN
          (* every integer type switches the same way: C converts each
             label to the selector's type, and the checker has held the
             labels to it *)
          EmitCaseScalar (st, w, ind)
        ELSE
          ErrAt (st, 'CASE over this selector unsupported yet')
        END ;
        FOR kh := 1 TO h0 DO Line (KPbuf, ind, '}') END
    (* ---- par 6: the monitor statements ----

       WAIT and SIGNAL name the MONITOR, not a field of it: there is
       one condition variable per monitor, so the monitor is the
       condition.  A WAIT is written as a loop around its predicate,
       which is why SIGNAL broadcasts -- see m9rt.h. *)
    | Ast.NWait, Ast.NSignal :
        tg := '?' ;
        l := '0' ;
        vtN := NONE ;
        IF st.kids[0] IS SOME mz THEN
          l := DES (mz, tg) ;
          vtN := Resolve (DesigDecl (mz))
        END ;
        IF vtN IS SOME mn THEN
          IF mn.kind # Ast.NMonitorType THEN
            ErrAt (st, 'WAIT/SIGNAL needs a monitor designator')
          ELSIF st.kind = Ast.NWait THEN
            Line (KPbuf, ind, S3 ('m9_mon_wait (&(', l, ').m9mon);'))
          ELSE
            Line (KPbuf, ind, S3 ('m9_mon_signal (&(', l, ').m9mon);'))
          END
        ELSE
          ErrAt (st, 'WAIT/SIGNAL needs a monitor designator')
        END

    (* THREAD (P, arg).  ONE TRAMPOLINE PER PROCEDURE, not per site.
       par 6's SHARABLE argument is a MONITOR or an owned value moved
       in; a MONITOR is shared BY REFERENCE and M9 gives no way to
       take its address outside UNSAFE, so the generator passes it.
       The trampoline carries its own error slot, because a thread
       has no caller to check one. *)
    | Ast.NThread :
        tg := '?' ;
        IF st.kids[0] IS SOME pn THEN
          IF pn.kind # Ast.NDesignator THEN
            ErrAt (st, 'THREAD target form unsupported yet')
          ELSE
            bname := Text.Keep (gpool, pn.au) ;
            l := '0' ;
            vd := NONE ;
            vtN := NONE ;
            thrPool := 'NULL' ;
            (* under parentheses as bare: `THREAD (P, (x))', accepted by
               both checkers (CheckThread's ParenCore), was `THREAD form
               unsupported yet' here until 2026-10-29 *)
            IF ParenCore (st.kids[1]) IS SOME az THEN
              l := DES (az, tg) ;
              vd := DesigDecl (az) ;
              vtN := Resolve (vd) ;
              (* rule 2: the pool the argument lives in crosses with
                 it, since the target's first parameter carries one *)
              thrPool := ObjPoolC (az)
            END ;
            IF vtN IS SOME an THEN
              IF an.kind = Ast.NMonitorType THEN
                l := S3 ('&(', l, ')') ;
                w := S2 (TyC (vd), ' *')
              ELSE
                w := TyC (vd)
              END ;
              (* pointer-shaped means TyC ended with a star; one
                 character beats importing Text for it *)
              IF an.kind # Ast.NMonitorType AND
                 NOT (Text.BLen (w) > 0 AND B (w, Text.BLen (w) - 1) = ORD ('*')) THEN
                ErrAt (st,
                  'THREAD argument must be pointer-shaped or a monitor')
              ELSE
                IF MFind (thrSeen, bname) < 0 THEN
                  MAdd (thrSeen, bname, NONE, '') ;
                  thrWants := FALSE ;
                  thrRef := FALSE ;
                  thrPi := FindProcN (bname) ;
                  IF thrPi >= 0 THEN
                    IF gps[thrPi].node IS SOME tdn THEN
                      IF tdn.kids[0] IS SOME tpl THEN
                        IF tpl.nkids > 0 THEN
                          IF tpl.kids[0] IS SOME tg0 THEN
                            thrWants := tg0.f1 AND PoolParamTy (tg0.kids[1]) ;
                            (* a VAR or OWN parameter whose type is itself a
                               pointer is passed by reference, T ** -- the
                               thunk handed it the pointer, and the target
                               read the record's own bytes as one
                               (2026-10-21, found writing ExecPar.m9: `OWN
                               job: PTR Job').  A VAR record is T *, the
                               pointer the thunk has. *)
                            thrPty := TyC (tg0.kids[1]) ;
                            thrRef := (tg0.f1 OR tg0.f2) AND Text.BLen (thrPty) > 0 AND
                              B (thrPty, Text.BLen (thrPty) - 1) = ORD ('*')
                          END
                        END
                      END
                    END
                  END ;
                  Line (KThr, 0, S4 ('static void *m9_thr_', modName,
                    '_', S2 (bname, ' (void *p, m9_pool *pool)'))) ;
                  Line (KThr, 0, '{') ;
                  Line (KThr, 0, '  m9_state e = { 0 };') ;
                  IF thrRef THEN
                    Line (KThr, 0, S5 ('  ', w, ' m9thr = (', w, ') p;')) ;
                    cnd := '&m9thr'
                  ELSE
                    cnd := S3 ('(', w, ') p')
                  END ;
                  IF thrWants THEN
                    Line (KThr, 0, S6 ('  ', CP (modName), '_', bname, ' (',
                      S2 (cnd, ', pool, &e);')))
                  ELSE
                    Line (KThr, 0, '  (void) pool;') ;
                    Line (KThr, 0, S6 ('  ', CP (modName), '_', bname, ' (',
                      S2 (cnd, ', &e);')))
                  END ;
                  Line (KThr, 0,
                    '  if (e.exc) m9_thread_died (e.exc->name);') ;
                  Line (KThr, 0, '  return NULL;') ;
                  Line (KThr, 0, '}') ;
                  Line (KThr, 0, '')
                END ;
                IF ExprRaises (st.kids[1]) THEN
                  (* the argument tested before a worker is started on it:
                     a failed `THREAD (W, jobs[k])' ran W on the poison cell
                     (the second review's gen N2, 2026-10-26) *)
                  Line (KPbuf, ind, S3 ('{ void *m9tv = (void *) ', l, ';')) ;
                  Line (KPbuf, ind + 1, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
                  l := 'm9tv'
                END ;
                Line (KPbuf, ind, S6 ('m9_thread_start2 (m9_thr_',
                  CP (modName), '_', bname, ', (void *) ',
                  S5 (l, ', ', thrPool, ', err);', ''))) ;
                Line (KPbuf, ind,
                  S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
                IF ExprRaises (st.kids[1]) THEN Line (KPbuf, ind, '}') END
              END
            ELSE
              ErrAt (st, 'THREAD form unsupported yet')
            END
          END
        ELSE
          ErrAt (st, 'THREAD form unsupported yet')
        END

    | Ast.NDispose : EmitDispose (st, ind)
    | Ast.NRaiseStmt : EmitRaise (st, ind)
    | Ast.NReturn :
        IF st.kids[0] IS SOME rv THEN
          (* the answer outlives this frame, so it is built in the
             caller's arena.  Intermediates within the expression land
             there too -- generous, and the price of not tracking tail
             position through EX. *)
          Line (KPbuf, ind, 'err->res = m9res;') ;
          nh := Lower (st.kids[0], ind) ;
          r := EX (st.kids[0], curRetTag) ;
          rs := LeftRaises (st.kids[0]) ;
          IF SharedBinding (st.kids[0]) AND NOT SharedReturnMoves (st.kids[0]) THEN
            r := S5 ('((__typeof__(', r, ')) m9_share_copy (', r, '))')
          END ;
          Line (KPbuf, ind, S3 ('m9ret = ', r, ';')) ;
          IF rs THEN
            Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
          END ;
          CloseN (nh, ind)
        END ;
        IF Text.BLen (curRetq) > 0 THEN
          Line (KPbuf, ind, S2 (curRetq, ' = true;'))
        END ;
        Line (KPbuf, ind, S3 ('goto ', exitLbl, ';'))
    ELSE
      ErrAt (st, 'statement kind unsupported yet')
    END
  END
END EmitStmt ;

(* BEGIN s EXCEPT h FINALLY f END as BEGIN BEGIN s EXCEPT h END FINALLY f END *)
PROCEDURE SplitFinally (KEPT st: PTR Ast.Node) : PTR Ast.Node =
VAR
  outer, inner, seq : PTR Ast.Node IN gpool ;
  j : I64 ;
BEGIN
  inner := Ast.NewNode (gpool, Ast.NBlock, st.line, st.col) ;
  outer := Ast.NewNode (gpool, Ast.NBlock, st.line, st.col) ;
  Ast.Add (gpool, inner, st.kids[0]) ;
  seq := Ast.NewNode (gpool, Ast.NStmtSeq, st.line, st.col) ;
  Ast.Add (gpool, seq, SOME (inner)) ;
  Ast.Add (gpool, outer, SOME (seq)) ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME part THEN
      IF part.kind = Ast.NFinally THEN
        Ast.Add (gpool, outer, st.kids[j])
      ELSE
        Ast.Add (gpool, inner, st.kids[j])
      END
    END
  END ;
  RETURN outer
END SplitFinally ;

PROCEDURE EmitBlock (KEPT st: PTR Ast.Node ; ind: I64) =
VAR
  w, l, cnd, tg, savedExit, savedRq : UTF ;
  j : I64 ;
  fin : Ast.Kid ;
  hasHdl : BOOL ;
BEGIN
  hasHdl := FALSE ;                     (* any handler? *)
  fin := NONE ;                         (* the FINALLY node *)
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME part THEN
      IF part.kind = Ast.NHandler THEN hasHdl := TRUE
      ELSIF part.kind = Ast.NFinally THEN fin := st.kids[j] END
    END
  END ;
  IF hasHdl THEN
    IF fin IS SOME f0 THEN
      (* EXCEPT and FINALLY on one block: the handlers on an inner
         block, the FINALLY on an outer one around it -- the cleanup
         runs after a handler as after the sequence (refused until
         2026-10-09) *)
      EmitBlock (SplitFinally (st), ind) ;
      RETURN
    END ;
    (* handlers: raises inside the sequence jump to the dispatch;
       RETURNs bypass it (returns are not exceptions) *)
    w := S2 ('L_hdl_', NewTmp ()) ;
    cnd := S2 ('L_dn_', NewTmp ()) ;
    tg := raiseLbl ;
    raiseLbl := Text.Keep (gpool, w) ;
    EmitSeq (st.kids[0], ind) ;
    raiseLbl := tg ;
    Line (KPbuf, ind, S3 ('goto ', cnd, ';')) ;
    Line (KPbuf, 0, S2 (w, ': ;')) ;
    FOR j := 1 TO st.nkids - 1 DO
      IF st.kids[j] IS SOME part THEN
        IF part.kind = Ast.NHandler THEN EmitHandler (part, cnd, ind) END
      END
    END ;
    Line (KPbuf, ind, S3 ('goto ', raiseLbl, ';')) ;
    Line (KPbuf, 0, S2 (cnd, ': ;')) ;
    RETURN
  END ;
  IF fin IS SOME fnode THEN
    (* FINALLY as a goto cleanup chain (par 11): raises and RETURNs
       inside the block land on the label; the cleanup runs; then
       whatever was pending continues outward *)
    w := NewTmp () ;
    l := S2 ('L_fin_', NewTmp ()) ;
    Line (KPbuf, ind, S5 ('bool ', w, ' = false; (void) ', w, ';')) ;
    savedExit := exitLbl ; savedRq := curRetq ; tg := raiseLbl ;
    exitLbl := Text.Keep (gpool, l) ; raiseLbl := exitLbl ; curRetq := Text.Keep (gpool, w) ;
    finDepth := finDepth + 1 ;
    EmitSeq (st.kids[0], ind) ;
    finDepth := finDepth - 1 ;
    Line (KPbuf, 0, S2 (l, ': ;')) ;
    (* the cleanup runs with nothing pending: a raise is saved and
       cleared here and put back after it (m9rt.h says why) *)
    Line (KPbuf, ind, S5 ('m9_fin ', w, 'f; m9_fin_save (err, &', w, 'f);')) ;
    exitLbl := savedExit ; raiseLbl := tg ; curRetq := savedRq ;
    EmitSeq (fnode.kids[0], ind) ;
    Line (KPbuf, ind, S3 ('m9_fin_restore (err, &', w, 'f);')) ;
    IF Text.BLen (curRetq) > 0 THEN
      Line (KPbuf, ind, S7 ('if (', w, ') { ', curRetq, ' = true; goto ',
        exitLbl, '; }'))
    ELSE
      Line (KPbuf, ind, S5 ('if (', w, ') goto ', exitLbl, ';'))
    END ;
    Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';')) ;
    RETURN
  END ;
  EmitSeq (st.kids[0], ind)
END EmitBlock ;

(* the member a CASE label over an enumeration or CASE RECORD names:
   a bare `Fs', or `Kind.Fs' / `Mod.Kind.Fs' -- the last field of a
   designator that is nothing but field selectors; '' for any other
   form.  The qualified spelling was accepted by the checker and
   refused by the generator until 2026-10-09 (cp-kernel's issue 13),
   and the totality check skipped it *)
PROCEDURE LabelName (lv: PTR Ast.Node) : UTF =
VAR i : I64 ;
BEGIN
  IF lv.kind # Ast.NDesignator THEN RETURN '' END ;
  IF lv.nkids = 0 THEN RETURN lv.au END ;
  FOR i := 0 TO lv.nkids - 1 DO
    IF lv.kids[i] IS SOME sel THEN
      IF sel.kind # Ast.NSelField THEN RETURN '' END
    ELSE
      RETURN ''
    END
  END ;
  IF lv.kids[lv.nkids - 1] IS SOME last THEN RETURN last.au END ;
  RETURN ''
END LabelName ;

PROCEDURE EmitCaseCR (st: PTR Ast.Node ; RO w: UTF ;
                      RO tg: UTF ; ind: I64) =
VAR
  l, tn, bname, fldn : UTF ;
  j, i2, j2, k2, g2, jj, savedScope : I64 ;
  vtN, vd : Ast.Kid ;
  hadElse, opened : BOOL ;
BEGIN
  tn := SLICE (tg, 3, Text.BLen (tg) - 3) ;
  l := S2 (CRPrefix (tn), '_') ;
  vtN := CRNode (tn) ;
  hadElse := FALSE ;
  Line (KPbuf, ind, S3 ('switch (', w, '.tag) {')) ;
  inSwitch := inSwitch + 1 ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        savedScope := scope.n ;
        opened := FALSE ;
        IF arm.kids[0] IS SOME lbls THEN
          FOR i2 := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[i2] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN
                Line (KPbuf, ind, S4 ('case ', l, lbl.au, ': {')) ;
                opened := TRUE ;
                (* positional binders copy the payload fields *)
                vd := NONE ;
                IF vtN IS SOME vtn2 THEN
                  FOR j2 := 0 TO vtn2.nkids - 1 DO
                    IF vtn2.kids[j2] IS SOME v0 THEN
                      IF Text.Eq (v0.au, lbl.au) THEN vd := vtn2.kids[j2] END
                    END
                  END
                END ;
                IF vd IS SOME vdn THEN
                  k2 := 0 ;
                  IF vdn.kids[0] IS SOME vfs THEN
                    FOR g2 := 0 TO vfs.nkids - 1 DO
                      IF vfs.kids[g2] IS SOME vg THEN
                        IF vg.kids[0] IS SOME vids THEN
                          FOR jj := 0 TO vids.nkids - 1 DO
                            IF lbl.kids[0] IS SOME bl THEN
                              IF k2 < bl.nkids THEN
                                IF bl.kids[k2] IS SOME bid THEN
                                  IF vids.kids[jj] IS SOME fid THEN
                                    bname := CN (bid.au) ;
                                    fldn := CN (fid.au) ;
                                    Line (KPbuf, ind + 1,
                                      S9 (TyC (vg.kids[1]), ' ', bname,
                                        ' = ', w, '.u.', lbl.au, '.',
                                        S5 (fldn, '; (void) ', bname,
                                            ';', ''))) ;
                                    MAdd (bpool, Text.Keep (gpool, bid.au), NONE,
                                          Text.Keep (gpool, OriginPool (st.kids[0]))) ;
                                    MAdd (scope, Text.Keep (gpool, bid.au), vg.kids[1], 'b')
                                  END
                                END
                              END
                            END ;
                            k2 := k2 + 1
                          END
                        END
                      END
                    END
                  END
                ELSE
                  ErrAt (st, 'CASE label form unsupported yet')
                END
              ELSIF lbl.kind = Ast.NLabelRange THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF Text.BLen (LabelName (lv)) > 0 AND IsNone (lbl.kids[1]) THEN
                    Line (KPbuf, ind, S4 ('case ', l, LabelName (lv), ':'))
                  ELSE
                    ErrAt (st, 'CASE label form unsupported yet')
                  END
                END
              ELSE
                ErrAt (st, 'CASE label form unsupported yet')
              END
            END
          END
        END ;
        IF NOT opened THEN Line (KPbuf, ind, '{') END ;
        EmitSeq (arm.kids[1], ind + 1) ;
        Line (KPbuf, ind, '} break;') ;
        scope.n := savedScope
      ELSE
        hadElse := TRUE ;
        Line (KPbuf, ind, 'default: {') ;
        EmitSeq (arm.kids[0], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      END
    END
  END ;
  IF NOT hadElse THEN
    Line (KPbuf, ind, 'default: m9_trap_tag ();')
  END ;
  inSwitch := inSwitch - 1 ;
  Line (KPbuf, ind, '} }')
END EmitCaseCR ;

PROCEDURE EmitCaseScalar (st: PTR Ast.Node ; RO w: UTF ;
                          ind: I64) =
VAR
  r, lo, hi : UTF ;
  j, i2 : I64 ;
  hadElse, single : BOOL ;
BEGIN
  hadElse := FALSE ;
  Line (KPbuf, ind, S3 ('switch (', w, ') {')) ;
  inSwitch := inSwitch + 1 ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR i2 := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[i2] IS SOME lbl THEN
              r := '' ;
              single := FALSE ;
              IF lbl.kind = Ast.NLabelRange THEN
                single := IsNone (lbl.kids[1])
              END ;
              IF single THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF lv.kind = Ast.NString AND Text.CpCount (lv.au) = 1 THEN
                    r := S2 (ItoA (ORD (Text.CpAt (lv.au, 0))), 'u')
                  ELSIF lv.kind = Ast.NChar THEN
                    r := S2 (ItoA (CharVal (lv.au)), 'u')
                  ELSIF lv.kind = Ast.NInt THEN
                    r := S3 ('INT64_C(', lv.au, ')')
                  ELSIF lv.kind = Ast.NDesignator THEN
                    r := ConstLbl (lv)
                  END ;
                  IF Text.BLen (r) = 0 THEN r := ScalarC (lbl.kids[0]) END
                END
              ELSIF lbl.kind = Ast.NLabelRange THEN
                (* lo .. hi: the GNU C case range, both ends constants *)
                lo := ScalarC (lbl.kids[0]) ;
                hi := ScalarC (lbl.kids[1]) ;
                IF Text.BLen (lo) > 0 AND Text.BLen (hi) > 0 THEN
                  r := S3 (lo, ' ... ', hi)
                END
              END ;
              IF Text.BLen (r) = 0 THEN
                ErrAt (st, 'CASE label form unsupported yet')
              ELSE
                Line (KPbuf, ind, S3 ('case ', r, ':'))
              END
            END
          END
        END ;
        Line (KPbuf, ind, '{') ;
        EmitSeq (arm.kids[1], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      ELSE
        hadElse := TRUE ;
        Line (KPbuf, ind, 'default: {') ;
        EmitSeq (arm.kids[0], ind + 1) ;
        Line (KPbuf, ind, '} break;')
      END
    END
  END ;
  IF NOT hadElse THEN
    ErrAt (st,
      'scalar CASE without ELSE refused (unmatched-label semantics undecided)')
  END ;
  inSwitch := inSwitch - 1 ;
  Line (KPbuf, ind, '} }')
END EmitCaseScalar ;

PROCEDURE EmitDispose (st: PTR Ast.Node ; ind: I64) =
VAR
  l, tg : UTF ;
  j, i2 : I64 ;
  vtN, vd, ft : Ast.Kid ;
  opened : BOOL ;
BEGIN
  tg := '?' ;
  l := '0' ;
  IF st.kids[0] IS SOME dz THEN l := DES (dz, tg) END ;
  (* interior pools die with their record (par 4.3) and interior
     SHARED handles are released -- but only when THIS is the last
     handle: a shared object's interior outlives any one Close
     (found by the bench driver closing the store first)             *)
  opened := FALSE ;
  vtN := NONE ;
  IF st.kids[0] IS SOME dz2 THEN vtN := Resolve (DesigDecl (dz2)) END ;
  IF vtN IS SOME pt THEN
    IF IsPtrK (pt.kind) THEN
      IF Resolve (pt.kids[0]) IS SOME rec THEN
        IF rec.kind = Ast.NRecordType THEN
          IF rec.kids[1] IS SOME fs THEN
            FOR j := 0 TO fs.nkids - 1 DO
              IF fs.kids[j] IS SOME fg THEN
                ft := Resolve (fg.kids[1]) ;
                IF ft IS SOME ftn THEN
                  IF (ftn.kind = Ast.NQualident AND
                      Text.Eq (ftn.au, 'POOL')) OR
                     ftn.kind = Ast.NSharedType THEN
                    IF NOT opened THEN
                      (* the release and the last-handle test are one
                         atomic step, so one thread cleans the interior
                         and frees (m9rt.h, 2026-10-18) *)
                      Line (KPbuf, ind,
                        S3 ('if (m9_release (', l, ')) {')) ;
                      opened := TRUE
                    END ;
                    IF fg.kids[0] IS SOME fids THEN
                      FOR i2 := 0 TO fids.nkids - 1 DO
                        IF fids.kids[i2] IS SOME fid THEN
                          IF ftn.kind = Ast.NSharedType THEN
                            Line (KPbuf, ind + 1, S5 ('m9_dispose (', l,
                              '->', CN (fid.au), ');'))
                          ELSE
                            Line (KPbuf, ind + 1, S5 ('m9_pool_free (&',
                              l, '->', CN (fid.au), ');'))
                          END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  IF opened THEN
    Line (KPbuf, ind + 1, S3 ('m9_free_last (', l, ');')) ;
    Line (KPbuf, ind, '}')
  ELSE
    Line (KPbuf, ind, S3 ('m9_dispose (', l, ');'))
  END ;
  IF LeftRaisesTarget (st.kids[0]) THEN
    Line (KPbuf, ind, S3 ('if (err->exc) goto ', raiseLbl, ';'))
  END
END EmitDispose ;

(* the C tag of an exception's k-th field, '' past the last *)
PROCEDURE FieldTagAt (fields: Ast.Kid ; k: I64) : UTF =
VAR g, j, ix : I64 ;
BEGIN
  ix := 0 ;
  IF fields IS SOME fs THEN
    FOR g := 0 TO fs.nkids - 1 DO
      IF fs.kids[g] IS SOME fg THEN
        IF fg.kids[0] IS SOME fids THEN
          FOR j := 0 TO fids.nkids - 1 DO
            IF ix = k THEN RETURN TagOfType (fg.kids[1]) END ;
            ix := ix + 1
          END
        END
      END
    END
  END ;
  RETURN ''
END FieldTagAt ;

PROCEDURE EmitRaise (st: PTR Ast.Node ; ind: I64) =
VAR
  l, l2, r, tg, cnd, w : UTF ;
  j, i2, j2, k2 : I64 ;
  fields : Ast.Kid ;
BEGIN
  l := '' ;
  l2 := '' ;
  IF st.kids[0] IS SOME xn THEN
    l := xn.au ;
    IF Text.BLen (xn.bu) > 0 THEN
      l2 := xn.au ;
      l := xn.bu
    END
  END ;
  r := ExcRef (l2, l, fields) ;
  IF Text.BLen (r) = 0 THEN
    ErrAt (st, S2 ('RAISE of unknown exception: ', l)) ;
    RETURN
  END ;
  r := S2 ('&', r) ;
  (* payload: I64-class into i[], F64 into d[], slices into s[] *)
  IF st.kids[1] IS SOME pay THEN
    i2 := 0 ; j2 := 0 ; k2 := 0 ;
    FOR j := 0 TO pay.nkids - 1 DO
      tg := TagOfExpr (pay.kids[j]) ;
      (* the FIELD says where a value travels: a one-character string
         literal tags as a CHAR and went into an integer slot of a STR
         field, which gcc refused (`RAISE Other ('x')', 0.20.0 to 0.21.0;
         found writing genforms GfMultiArm, 2026-10-11) *)
      IF Text.Eq (FieldTagAt (fields, j), 'SLICE') THEN tg := 'SLICE' END ;
      (* a UTF is a slice of octets: the s[] slots (found by the
         rehearsed switch's STR payload, 2026-10-24; a UTF field had
         gone to an integer slot before that) *)
      IF Text.Eq (tg, 'UTF') OR Text.Eq (FieldTagAt (fields, j), 'UTF') THEN
        tg := 'SLICE' ;
        (* a literal given to a UTF field is rendered as its octets:
           with want '' it is a CHAR slice, and the handler takes the
           slot as octets -- ZipTest's refusal texts read as
           `n   o   t' under the rehearsed switch (2026-10-24) *)
        cnd := EX (pay.kids[j], 'UTF')
      ELSE
        cnd := EX (pay.kids[j], '')
      END ;
      IF Text.Eq (tg, 'F64') OR Text.Eq (tg, 'F32') THEN
        (* THE SLOTS ARE FINITE AND OVERFLOWING THEM IS SILENT.
           m9_state carries i[4], d[2], s[2]; before this check a
           seventh integer or a third real simply wrote past the end
           of the struct, and the generated C compiled.  Found by
           declaring an exception with six F64 fields and reading the
           emitted code. *)
        IF j2 >= 2 THEN
          ErrAt (st,
            'exception payload: more than 2 real fields') ;
          RETURN
        END ;
        Line (KPbuf, ind, S5 ('err->d[', ItoA (j2), '] = ', cnd, ';')) ;
        j2 := j2 + 1
      ELSIF Text.Eq (tg, 'SLICE') THEN
        IF k2 >= 3 THEN
          ErrAt (st,
            'exception payload: more than 3 slice fields') ;
          RETURN
        END ;
        w := NewTmp () ;
        (* m9_pay_keep copies the octets out of the frame that built
           them, which the raise is about to leave (m9rt.h) *)
        Line (KPbuf, ind, S9 ('{ __typeof__(', cnd, ') ', w, ' = ', cnd,
          '; err->s[', ItoA (k2), S9 ('].p = ', w, '.p; err->s[',
          ItoA (k2), '].len = ', w, '.len; m9_pay_keep (err, ',
          ItoA (k2), S3 (', sizeof (*', w, '.p)); }')))) ;
        k2 := k2 + 1
      ELSE
        IF i2 >= 4 THEN
          ErrAt (st,
            'exception payload: more than 4 integer fields') ;
          RETURN
        END ;
        (* an enumeration -- a case record of tags only, the checker
           refuses any other at the EXCEPTION -- travels as its tag:
           it was the whole struct into an int64_t slot, which gcc
           refused (2026-10-10) *)
        IF Text.StartsWith (tg, 'CR:') THEN cnd := S3 ('(', cnd, ').tag') END ;
        Line (KPbuf, ind, S5 ('err->i[', ItoA (i2), '] = ', cnd, ';')) ;
        i2 := i2 + 1
      END
    END
  END ;
  Line (KPbuf, ind, S3 ('m9_raise (err, ', r, ');')) ;
  Line (KPbuf, ind, S3 ('goto ', raiseLbl, ';'))
END EmitRaise ;

(* ---- procedures ---- *)

PROCEDURE ZeroInit (RO cty: UTF) : UTF =
BEGIN
  IF Has (cty, '*') THEN RETURN ' = NULL' END ;
  IF Text.Eq (cty, 'double') OR Text.Eq (cty, 'float') THEN
    RETURN ' = 0'
  END ;
  IF Text.Eq (cty, 'bool') THEN RETURN ' = false' END ;
  (* the fixed-width integers by NAME: `contains _t' also matched
     m9_arr_4_int64_t, and a function answering an ARRAY declared
     `m9_arr_4_int64_t m9ret = 0' -- invalid C (found 2026-10-09
     building F (x)[i] over an array answer) *)
  IF Text.OneOf (STR (cty), CIntNames) THEN RETURN ' = 0' END ;
  RETURN ' = {0}'
END ZeroInit ;

(* the C typedef of a procedure type -- `typedef R ( * Mod_Name) (T1,
   T2 *, m9_state *err);` with the star written apart here because
   the two characters together open a comment -- a value parameter is
   its C type, VAR and OWN are a pointer to it, exactly GenProc's rule
   for a heading, so a procedure of the same head IS a value of the
   type in C *)
PROCEDURE ProcTypedefC (RO name: UTF ; ptn: PTR Ast.Node) : UTF =
VAR
  retC, ps, cty : UTF ;
  g, j : I64 ;
BEGIN
  retC := 'void' ;
  IF ptn.kids[1] IS SOME rt THEN retC := TyC (ptn.kids[1]) END ;
  ps := '' ;
  IF ptn.kids[0] IS SOME pl THEN
    FOR g := 0 TO pl.nkids - 1 DO
      IF pl.kids[g] IS SOME grp THEN
        cty := TyC (grp.kids[1]) ;
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF grp.f1 AND PoolParamTy (grp.kids[1]) THEN
              ps := S3 (ps, cty, ' *, m9_pool *, ')   (* rule 2 *)
            ELSIF grp.f1 OR grp.f2 THEN
              ps := S3 (ps, cty, ' *, ')
            ELSE
              ps := S3 (ps, cty, ', ')
            END
          END
        END
      END
    END
  END ;
  RETURN S7 ('typedef ', retC, ' (*', CP (modName), '_', name,
             S3 (') (', ps, 'm9_state *err);'))
END ProcTypedefC ;

PROCEDURE GenProc (gi: I64) =
VAR
  pl, grp, body, ids : Ast.Kid ;
  g, j, i, k : I64 ;
  ci2, cj2 : I64 ;             (* the procedure's own CONSTs *)
  sig, retC, mode, cty, init, nm, dst : UTF ;
  monPar : UTF ;   (* the monitor this proc is bound to *)
  nb : SLICE OF UTF ;
  rk : Ast.Kid ;
  hasBody : BOOL ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  IF gps[gi].node IS SOME d THEN
    IF d.kids[1] IS SOME rt THEN
      retC := TyC (d.kids[1]) ;
      curRetTag := Text.Keep (gpool, TagOfType (d.kids[1]))
    ELSE
      retC := 'void' ;
      curRetTag := ''
    END ;
    sig := S6 (retC, ' ', CP (modName), '_', gps[gi].name, ' (') ;
    monPar := '' ;
    pl := d.kids[0] ;
    IF pl IS SOME pln THEN
      FOR g := 0 TO pln.nkids - 1 DO
        IF pln.kids[g] IS SOME grpn THEN
          IF grpn.f1 THEN mode := 'v'
          ELSIF grpn.f2 THEN mode := 'o'
          ELSE mode := 'p' END ;
          cty := TyC (grpn.kids[1]) ;
          IF grpn.kids[0] IS SOME pids THEN
            FOR j := 0 TO pids.nkids - 1 DO
              IF pids.kids[j] IS SOME pid THEN
                (* A BOUND PROCEDURE IS ONE WHOSE FIRST PARAMETER
                   IS THE MONITOR TYPE -- M9 has no method syntax, so
                   the parameter is the binding
                   (docs/concurrency.md).  Its body is wrapped in
                   enter/leave, which is how par 6's "all access to
                   the record's fields is implicitly serialized"
                   becomes a property of the emitted code. *)
                IF g = 0 AND j = 0 THEN
                  IF Resolve (grpn.kids[1]) IS SOME mtn THEN
                    IF mtn.kind = Ast.NMonitorType THEN
                      IF Text.Eq (mode, 'p') THEN
                        ErrAt (grpn,
                          'a monitor receiver must be VAR')
                      ELSE
                        monPar := CN (pid.au)
                      END
                    END
                  END
                END ;
                MAdd (scope, pid.au, grpn.kids[1], mode) ;
                IF Text.Eq (mode, 'p') THEN
                  sig := S5 (sig, cty, ' ', CN (pid.au), ', ')
                ELSE
                  sig := S5 (sig, cty, ' *', CN (pid.au), ', ') ;
                  (* rule 2 of docs/pool-elision-plan.md: a VAR
                     parameter of a pointer-bearing type carries the
                     pool its object lives in, right behind it, and
                     its target is adopted into THAT pool at exit
                     rather than into the caller's arena *)
                  IF Text.Eq (mode, 'v') AND PoolParamTy (grpn.kids[1]) THEN
                    sig := S4 (sig, 'm9_pool *', CN (pid.au), '_pool, ') ;
                    dst := S2 (CN (pid.au), '_pool')
                  ELSE
                    dst := 'm9res'
                  END ;
                  IF StrCIs (cty) THEN
                    OutReg (Text.Keep (gpool, CN (pid.au)), RehomeFn (cty))
                  ELSIF HasPtr (grpn.kids[1], 0) THEN
                    AdoptReg (Text.Keep (gpool, CN (pid.au)), grpn.kids[1], dst)
                  END
                END
              END
            END
          END
        END
      END
    END ;
    sig := S2 (sig, 'm9_state *err)') ;

    IF gps[gi].exported THEN
      Line (KHdrProtos, 0, S2 (sig, ';'))
    ELSE
      sig := S2 ('static ', sig) ;
      Line (KSprotos, 0, S2 (sig, ';'))
    END ;

    hasBody := FALSE ;
    IF gps[gi].body IS SOME b0 THEN hasBody := TRUE END ;
    IF NOT hasBody THEN RETURN END ;

    Line (KPbuf, 0, '') ;
    Line (KPbuf, 0, sig) ;
    Line (KPbuf, 0, '{') ;
    (* THE FRAME ARENA.  Empty costs nothing -- m9_pool is one NULL
       pointer and the first block is created lazily -- so a procedure
       that never concatenates pays for a zeroed word.  Registered like
       any local POOL, which frees it on EVERY exit: par 11 routes
       return, raise and FINALLY through L_ret alike.

       And the result slot: err->res is the CALLER's arena when we are
       entered, so it is captured before our own calls overwrite it,
       and then claimed for them -- a callee's answer lands in OUR
       frame.  Each procedure restores it at L_ret, which is why a
       caller sets it once rather than around every call.  NULL means a
       caller that does not play (a hand-written C driver) and HEAP is
       the fallback, which is what `+` did before this. *)
    Line (KPbuf, 1, 'm9_pool m9frame = {0};') ;
    PoolReg ('m9frame') ;
    Line (KPbuf, 1,
      'm9_pool *m9res = err->res ? err->res : &m9_heap;') ;
    Line (KPbuf, 1, '(void) m9res;') ;
    (* A FUNCTION WHOSE ANSWER CARRIES A POINTER BUILDS IN ITS
       CALLER'S ARENA from the first statement, not only in its
       RETURN expression (rule 1 of docs/pool-elision-plan.md): what
       it allocates is on its way out, and adoption at the exit would
       carry the same bytes up in the frame's own 64 KB blocks, one
       block per level of a recursive builder.  So the slot is left
       as the caller's, the frame stays empty, and the exit's adoption
       test finds nothing to move.  A function answering a scalar or
       a string, and a proper procedure, claim the slot as before:
       their temporaries die here, and a string answer is re-homed. *)
    IF d.kids[1] IS SOME rtn0 THEN
      IF NOT StrCIs (retC) AND HasPtr (d.kids[1], 0) THEN
        Line (KPbuf, 1, 'err->res = m9res;')
      ELSE
        Line (KPbuf, 1, 'err->res = &m9frame;')
      END
    ELSE
      Line (KPbuf, 1, 'err->res = &m9frame;')
    END ;
    IF Text.BLen (dbgSrc) > 0 THEN
      Line (KPbuf, 1, S3 ('err->file = "', dbgSrc, '";'))
    END ;
    (* PROCEDURE-LOCAL CONSTs.  The grammar always allowed them and
       neither end implemented them: this said `unknown name` and the
       checker said nothing at all.  They register in the same map the
       module's own use, and the map is truncated when the procedure
       ends -- a shadow is refused by the checker, so appending is
       safe even though MFind answers the FIRST hit. *)
    constsBase := consts.n ;
    IF gps[gi].body IS SOME cbd THEN
      FOR ci2 := 0 TO cbd.nkids - 1 DO
        IF cbd.kids[ci2] IS SOME csec THEN
          IF csec.kind = Ast.NConstSection THEN
            FOR cj2 := 0 TO csec.nkids - 1 DO
              IF csec.kids[cj2] IS SOME cdl THEN
                MAdd (consts, cdl.au, FoldStr (cdl.kids[0]), '')
              END
            END
          END
        END
      END
    END ;
    IF NOT Text.Eq (retC, 'void') THEN
      Line (KPbuf, 1, S4 (retC, ' m9ret', ZeroInit (retC), ';'))
    END ;
    (* the monitor is entered BEFORE the locals are declared -- the
       order the bootstrap generator emits (M9Gen.pas), which gendiff
       holds this one to; a monitor-bound procedure with a local VAR
       first appeared in the corpus with Mat's banded kernels *)
    IF Text.BLen (monPar) > 0 THEN
      Line (KPbuf, 1, S3 ('m9_mon_enter (&(*', monPar, ').m9mon);'))
    END ;

    (* locals: zero-initialized, pools registered for L_ret free *)
    body := gps[gi].body ;
    IF body IS SOME bd THEN
      FOR i := 0 TO bd.nkids - 2 DO
        IF bd.kids[i] IS SOME sect THEN
          IF sect.kind = Ast.NVarSection THEN
            FOR g := 0 TO sect.nkids - 1 DO
              IF sect.kids[g] IS SOME vd THEN
                cty := TyC (vd.kids[1]) ;
                rk := Resolve (vd.kids[1]) ;
                init := ZeroInit (cty) ;
                (* the structural test wins over the name: a GRID of
                   I64 is called m9_gd3_int64_t, which contains _t and
                   is not a scalar -- it emitted `= 0` and gcc refused
                   it.  Found by the port's second kernel; a SLICE
                   OF I64 had the same defect and no corpus module had
                   happened to declare one as a local. *)
                IF rk IS SOME rk0 THEN
                  IF rk0.kind = Ast.NGridType OR
                     rk0.kind = Ast.NSliceType OR
                     rk0.kind = Ast.NArrayType OR
                     rk0.kind = Ast.NRecordType OR
                     rk0.kind = Ast.NCaseRecordType OR
                     rk0.kind = Ast.NEnumType THEN
                    init := ' = {0}'
                  END
                END ;
                IF vd.kids[0] IS SOME vids THEN
                  FOR j := 0 TO vids.nkids - 1 DO
                    IF vids.kids[j] IS SOME vid THEN
                      MAdd (scope, vid.au, vd.kids[1], 'l') ;
                      nm := CN (vid.au) ;
                      Line (KPbuf, 1, S7 (cty, ' ', nm, init,
                        '; (void) ', nm, ';')) ;
                      IF rk IS SOME rkn THEN
                        IF rkn.kind = Ast.NQualident AND
                           Text.Eq (rkn.au, 'POOL') THEN
                          IF nlp = LEN (lpools) THEN
                            nb := NEW (gpool, UTF, 2 * LEN (lpools)) ;
                            FOR k := 0 TO nlp - 1 DO nb[k] := lpools[k] END ;
                            lpools := nb
                          END ;
                          lpools[nlp] := Text.Keep (gpool, nm) ;
                          nlp := nlp + 1
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END ;

      (* module state, visible after params and locals (first hit wins) *)
      ModuleScope () ;
      PushAggs () ;

      (* the body's block goes through the statement emitter so a
         proc-level EXCEPT/FINALLY gets the full treatment *)
      EmitStmt (bd.kids[bd.nkids - 1], 1)
    END ;

    Line (KPbuf, 0, 'L_ret: ;') ;
    (* every exit passes through L_ret, so a RAISE drops the lock for
       the same reason a RETURN does -- and the result slot goes back
       to the caller's arena for the same reason again, before this
       frame is freed underneath it *)
    Line (KPbuf, 1, 'err->res = m9res;') ;
    (* par 2.3: a string leaving this frame -- the result, or a
       VAR/OWN STR parameter's target -- is copied into the caller's
       arena IF it lives in the frame that is about to be freed.
       Asked of the address, at the exit: a `+`, a callee's re-homed
       answer, a view of either, are all caught; a literal, a borrow,
       or a string in a pool the caller named is not moved.  This is
       what lets a string procedure take no pool. *)
    (* ... and from every LOCAL named pool as well, since 2026-09-30:
       `VAR scratch: POOL` + DynStr + `RETURN DynUtf.View (d)` is then
       a string builder that takes no pool, the scratch dying here
       and the answer copied out (docs/pool-elision-plan.md, stage 2).
       The frame is lpools[0]; a pool with no block is one load. *)
    IF StrCIs (retC) THEN
      FOR i := 0 TO nlp - 1 DO
        Line (KPbuf, 1, S5 ('m9ret = ', RehomeFn (retC), ' (&', lpools[i],
                            ', m9res, m9ret, err);'))
      END
    END ;
    FOR i := 0 TO nout - 1 DO
      FOR k := 0 TO nlp - 1 DO
        Line (KPbuf, 1, S9 ('*', outStr[i], ' = ', outFn[i], ' (&', lpools[k],
                            ', m9res, *', outStr[i], ', err);'))
      END
    END ;
    (* rule 1 of docs/pool-elision-plan.md: a frame allocation that
       leaves -- through the result, or a VAR/OWN parameter's target
       -- takes the whole arena with it into the caller's, which a
       copy could not do for a graph.  One address test per pointer
       component; a frame that never allocated has no blocks. *)
    IF d.kids[1] IS SOME rtn THEN
      IF NOT StrCIs (retC) THEN
        IF HasPtr (d.kids[1], 0) THEN
          AdoptEmit ('m9ret', d.kids[1], 'm9res', 1, 0)
        END
      END
    END ;
    FOR i := 0 TO nadopt - 1 DO
      AdoptEmit (S3 ('(*', adoptC[i], ')'), adoptT[i], adoptD[i], 1, 0)
    END ;
    IF Text.BLen (monPar) > 0 THEN
      Line (KPbuf, 1, S3 ('m9_mon_leave (&(*', monPar, ').m9mon);'))
    END ;
    FOR i := 0 TO nlp - 1 DO
      Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
    END ;
    IF Text.Eq (retC, 'void') THEN
      Line (KPbuf, 1, 'return;')
    ELSE
      Line (KPbuf, 1, 'return m9ret;')
    END ;
    Line (KPbuf, 0, '}') ;
    consts.n := constsBase
  END
END GenProc ;

(* a program module's body becomes main ().  The err slot is declared
   here and nowhere else: it is the root of the ABI, so an exception
   reaching this frame escaped every handler in the program and must
   be REPORTED and exited on, never swallowed -- par 11's flush rule,
   which the museum's HALT piece paid for.                          *)
PROCEDURE GenMain () =
VAR i : I64 ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  curRetTag := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  ModuleScope () ;
  PushAggs () ;
  Line (KPbuf, 0, '') ;
  Line (KPbuf, 0, 'int main (int argc, char **argv)') ;
  Line (KPbuf, 0, '{') ;
  Line (KPbuf, 1, 'm9_state errv = {0};') ;
  Line (KPbuf, 1, 'm9_state *err = &errv;') ;
  PoolReg ('m9mframe') ;
  Line (KPbuf, 1, 'err->res = &m9mframe;') ;
  IF Text.BLen (dbgSrc) > 0 THEN
    Line (KPbuf, 1, S3 ('err->file = "', dbgSrc, '";'))
  END ;
  Line (KPbuf, 1, 'm9_args (argc, argv);') ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KPbuf, 1, S3 (CP (extMods.es[i].k), '_m9init (err);',
      ' if (err->exc) goto L_ret;'))
  END ;
  inMain := TRUE ;
  EmitStmt (mainBody, 1) ;
  inMain := FALSE ;
  Line (KPbuf, 0, 'L_ret: ;') ;
  FOR i := 0 TO nlp - 1 DO
    Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
  END ;
  Line (KPbuf, 1, 'return m9_exit (err);') ;
  Line (KPbuf, 0, '}')
END GenMain ;

(* a NON-program module's body is its INITIALISATION, and it RUNS --
   Modula-2's rule.  Every module emits an idempotent Mod_m9init that
   runs its direct imports' inits first (so a module sees its
   dependencies initialised) and then its own body; a body-less module
   still emits one, a no-op chain, so the ordering reaches through it.
   A program's main calls its imports' inits before its own body.
   Before this a library body was accepted and silently dropped --
   an init nobody ran, the contract broken without a word.          *)
PROCEDURE GenInit (RO forModule: UTF) =
VAR i : I64 ;
BEGIN
  scope.n := 0 ;
  nlp := 0 ;
  nout := 0 ;
  nadopt := 0 ;
  tmpN := 0 ;
  exitLbl := 'L_ret' ;
  raiseLbl := 'L_ret' ;
  curRetq := '' ;
  curRetTag := '' ;
  finDepth := 0 ;
  inSwitch := 0 ;
  ModuleScope () ;
  PushAggs () ;
  Line (KPbuf, 0, '') ;
  Line (KPbuf, 0, S3 ('void ', CP (forModule), '_m9init (m9_state *err)')) ;
  Line (KPbuf, 0, '{') ;
  Line (KPbuf, 1, 'static int m9done = 0;') ;
  Line (KPbuf, 1, 'if (m9done) return;') ;
  Line (KPbuf, 1, 'm9done = 1;') ;
  (* the init body's frame is the MODULE's lifetime: the checker
     exempts a store into a module variable here (par 2.3) because
     the frame and the module variables share one, so the arena is
     static and never freed -- a frame allocation the body keeps in a
     module variable stays valid for the process (rule 1) *)
  Line (KPbuf, 1, 'm9_pool *m9prev = err->res;') ;
  Line (KPbuf, 1, 'err->res = &m9mframe;') ;
  (* direct imports first, so their state is ready *)
  FOR i := 0 TO extMods.n - 1 DO
    Line (KPbuf, 1, S3 (CP (extMods.es[i].k), '_m9init (err);',
      ' if (err->exc) goto L_ret;'))
  END ;
  inMain := TRUE ;
  EmitStmt (mainBody, 1) ;
  inMain := FALSE ;
  Line (KPbuf, 0, 'L_ret: ;') ;
  FOR i := 0 TO nlp - 1 DO
    Line (KPbuf, 1, S3 ('m9_pool_free (&', lpools[i], ');'))
  END ;
  Line (KPbuf, 1, 'err->res = m9prev;')
  ;
  Line (KPbuf, 0, '}')
END GenInit ;

(* ---- EXPORTED MODULE VARIABLES (decision 28, 2026-10-04) ----

   The exporter keeps its variable a file-local static, as every
   module variable is, and publishes a constant POINTER to it,
   Mod_v, declared extern in its header -- the constant table's
   shape (decision 20).  An importer has Mod.v in scope in
   VAR-parameter mode (ModuleScope), so every read, write, index,
   LEN and lending goes through the paths a VAR parameter takes.  A
   pointer-bearing variable publishes its pool as well, Mod_v_pool --
   the pool rule 2 says a VAR root carries: its IN clause, else the
   module frame. *)
PROCEDURE ExportVars () =
VAR
  i : I64 ;
  ty, cn, pl : UTF ;
  t : Ast.Kid ;
  any : BOOL ;
BEGIN
  any := FALSE ;
  FOR i := 0 TO nmv - 1 DO
    IF mvDef[i] THEN
      any := TRUE ;
      ty := TyC (mvT[i]) ;
      cn := S3 (CP (modName), '_', mvN[i]) ;
      Line (KRec3, 0, S6 (ty, ' * const ', cn, ' = &', CN (mvN[i]), ';')) ;
      Line (KHdrProtos, 0, S5 ('extern ', ty, ' * const ', cn, ';')) ;
      (* a STR or slice too (the second review's gen N4, 2026-10-26):
         an importer's `Fill (ExpV.s)' is called from this pool, where
         it was the importer's frame and ExpV.s read back freed *)
      IF PoolParamTy (mvT[i]) OR HasPtr (mvT[i], 0) THEN
        pl := '&m9mframe' ;
        t := mvT[i] ;
        IF t IS SOME tn THEN
          IF tn.kind = Ast.NOptType THEN t := tn.kids[0] END
        END ;
        IF Resolve (t) IS SOME r THEN
          IF r.kind = Ast.NPtrType THEN
            IF r.kids[1] IS SOME pn THEN
              IF pn.nkids = 0 THEN pl := S2 ('&', CN (pn.au)) END
            END
          END
        END ;
        Line (KRec3, 0, S4 ('m9_pool * const ', cn, '_pool = ', S2 (pl, ';'))) ;
        Line (KHdrProtos, 0, S3 ('extern m9_pool * const ', cn, '_pool;'))
      END
    END
  END ;
  IF any THEN Line (KRec3, 0, '') END
END ExportVars ;

(* is `name' declared under k: a variable, parameter, binder, type,
   constant or exception -- Sem.DeclaresName, for the shadow test *)
PROCEDURE DeclaresName (k: Ast.Kid ; RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NIdent OR n.kind = Ast.NIsSome OR n.kind = Ast.NTypeDecl
       OR n.kind = Ast.NConstDecl OR n.kind = Ast.NExcDecl THEN
      IF Text.Eq (n.au, name) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF DeclaresName (n.kids[i], name) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DeclaresName ;

(* a name this module declares at its own level, or the procedure
   `scope' declares: the module of the same spelling is shadowed *)
PROCEDURE NameShadowed (scope: Ast.Kid ; RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF DeclaresName (scope, name) THEN RETURN TRUE END ;
  IF FindProcN (name) >= 0 OR MFind (consts, name) >= 0 THEN RETURN TRUE END ;
  IF FindTypeN (name) IS SOME tn THEN RETURN TRUE END ;
  FOR i := 0 TO nmv - 1 DO
    IF Text.Eq (mvN[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END NameShadowed ;

(* Sem.ExportWalk's twin: the designator Mod.v... of a directly
   imported module's exported variable becomes the designator rooted
   at the one name Mod.v.  Here, and not only in the checker, because
   the generator is also run without it (gendump_m9, the oracle's
   gentest) and both ends must emit the same C. *)
PROCEDURE ExportWalk (VAR n: PTR Ast.Node ; scope: Ast.Kid) =
VAR i, j, k : I64 ;
  nm : SLICE OF CHAR ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
    IF n.kids[0] IS SOME s THEN
      IF s.kind = Ast.NSelField AND MFind (extMods, n.au) >= 0 THEN
        IF MFind (extVars, S3 (n.au, '.', s.au)) >= 0 AND
           NOT NameShadowed (scope, n.au) THEN
          (* `Mod.v', built in the NODE's pool -- through n's hidden pool --
             which a 2026-10-04 workaround avoided (the name dangled once the
             walk returned, `unknown name: const vo'); measured sound again
             2026-10-10 after the pool rules of 10-08, and kept so the
             gates exercise the shape that failed *)
          Ast.SetA (gpool, n, n.au + '.' + s.au) ;
          FOR i := 0 TO n.nkids - 2 DO n.kids[i] := n.kids[i + 1] END ;
          n.nkids := n.nkids - 1
        END
      END
    END
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN
      IF n.kind = Ast.NProcDecl THEN
        ExportWalk (c, SOME (n))
      ELSE
        ExportWalk (c, scope)
      END
    END
  END
END ExportWalk ;

PROCEDURE ExportWalks () =
VAR i : I64 ;
BEGIN
  IF extVars.n = 0 THEN RETURN END ;
  FOR i := 0 TO ngps - 1 DO
    IF gps[i].node IS SOME pn THEN ExportWalk (pn, NONE) END
  END ;
  IF mainBody IS SOME mb THEN ExportWalk (mb, NONE) END
END ExportWalks ;

(* the header guard's part from the file's name: a character that is
   no letter or digit is `_' and its code, so the guard is one C
   identifier and two names give two guards -- `a-b.m9' gave
   `M9G_a-b_H', which is M9G_a and junk, the guard of `a-c.m9' too
   (the review's F6).  A module's own name is unchanged. *)
PROCEDURE GuardName (RO n: UTF) : UTF =
VAR
  i : I64 ;
  c : CHAR ;
  ok : BOOL ;
  d : PTR DynUtf.DString IN gpool ;
BEGIN
  ok := TRUE ;
  FOR c IN n DO
    IF NOT ((c >= 'a' AND c <= 'z') OR (c >= 'A' AND c <= 'Z') OR
            (c >= '0' AND c <= '9')) THEN ok := FALSE END
  END ;
  IF ok THEN RETURN n END ;
  d := DynUtf.New (gpool) ;
  FOR c IN n DO
    IF (c >= 'a' AND c <= 'z') OR (c >= 'A' AND c <= 'Z') OR
       (c >= '0' AND c <= '9') THEN
      DynUtf.AppendChar (d, c)
    ELSE
      DynUtf.Append (d, '_') ;
      DynUtf.Append (d, ItoA (ORD (c)))
    END
  END ;
  RETURN DynUtf.ViewIn (gpool, d)
END GuardName ;

PROCEDURE Emit (RO forModule: UTF) =
VAR
  fm : UTF ;                      (* fm, for the UTF text below *)
  i, ci, j2, i2 : I64 ;
  cs, s, tgt : UTF ;
  anyPay : BOOL ;
  fsq : Ast.Kid ;
  fts : SLICE OF UTF ;
  d2 : PTR DynUtf.DString IN gpool ;
  buf : I64 ;
BEGIN
  fm := forModule ;
  Setup () ;
  bHdr := DynUtf.New (gpool) ;
  bSrc := DynUtf.New (gpool) ;
  bTdefs := DynUtf.New (gpool) ;
  bPbuf := DynUtf.New (gpool) ;
  bSprotos := DynUtf.New (gpool) ;
  bLit := DynUtf.New (gpool) ;
  bHdrRecs := DynUtf.New (gpool) ;
  bHdrProtos := DynUtf.New (gpool) ;
  bHdrConsts := DynUtf.New (gpool) ;
  bRec2 := DynUtf.New (gpool) ;
  bArrRec := DynUtf.New (gpool) ;
  bHdrArrRec := DynUtf.New (gpool) ;
  bRec3 := DynUtf.New (gpool) ;
  bThr := DynUtf.New (gpool) ;
  bGate := DynUtf.New (gpool) ;
  tdefN := 0 ; sprotoN := 0 ; litN := 0 ; hdrConstN := 0 ;
  MInit (arrSeen) ;
  ExportWalks () ;
  (* under --utf-str the first line says so: m9c's --make reads it and
     rebuilds a module whose header was generated the other way (a
     plain Fmt.h in the build directory was taken as current, maillists
     2026-10-25); without the flag the line is as it always was *)
  IF strUtf THEN
    Line (KHdr, 0, S3 ('/* generated by M9Gen from ', fm,
      '.m9 with --utf-str -- do not edit */'))
  ELSE
    Line (KHdr, 0, S3 ('/* generated by M9Gen from ', fm,
      '.m9 -- do not edit */'))
  END ;
  Line (KHdr, 0, S2 ('#ifndef M9G_', S2 (GuardName (fm), '_H'))) ;
  Line (KHdr, 0, S2 ('#define M9G_', S2 (GuardName (fm), '_H'))) ;
  Line (KHdr, 0, '#include "m9rt.h"') ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KHdr, 0, S3 ('#include "', extMods.es[i].k, '.h"'))
  END ;
  CycleForwards (fm) ;
  Line (KHdr, 0, '') ;
  (* every library module declares its initialiser, so an importer can
     run it before the module's state is used (docs/enum-plan.md) *)
  IF NOT isProgram THEN
    Line (KHdr, 0, S3 ('void ', CP (fm), '_m9init (m9_state *err);')) ;
    Line (KHdr, 0, '')
  END ;
  Line (KSrc, 0, S3 ('/* generated by M9Gen from ', fm,
    '.m9 -- do not edit */')) ;
  Line (KSrc, 0, S3 ('#include "', fm, '.h"')) ;
  FOR i := 0 TO extMods.n - 1 DO
    Line (KSrc, 0, S3 ('#include "', extMods.es[i].k, '.h"'))
  END ;
  Line (KSrc, 0, '') ;

  (* forward typedefs for every record type: slice typedefs and
     mutually recursive fields need the names before the structs
     (typedef redefinition is legal C11, so the transparent structs'
     own typedef lines are harmless duplicates) *)
  FOR i := 0 TO ntys - 1 DO
    anyPay := tys[i].opq ;
    IF tys[i].node IS SOME tn THEN
      IF tn.kind = Ast.NRecordType OR
         tn.kind = Ast.NMonitorType OR
         tn.kind = Ast.NCaseRecordType OR
         tn.kind = Ast.NEnumType THEN anyPay := TRUE END
    END ;
    IF anyPay THEN
      Line (KHdr, 0, S6 ('typedef struct ', CP (modName), '_', tys[i].name,
        ' ', S4 (CP (modName), '_', tys[i].name, ';')))
    END
  END ;
  Line (KHdr, 0, '') ;

  (* procedure types (par 2.2.3): a function-pointer typedef with the
     err slot last, the same C signature GenProc gives a procedure of
     that head.  Into the discovered-typedef stream, AFTER the slice
     typedefs its parameters register on the way and BEFORE the
     record bodies that may hold a field of it. *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        Line (KTdefs, 0, ProcTypedefC (tys[i].name, ptn))
      END
    END
  END ;

  (* case records: tagged structs, tags from 0 in declaration order;
     variants with payload fields become union members named after
     the variant *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME d THEN
      IF d.kind = Ast.NCaseRecordType OR d.kind = Ast.NEnumType THEN
        IF tys[i].fdef THEN buf := KHdr ELSE buf := KSrc END ;
        anyPay := FALSE ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            IF v.kids[0] IS SOME vf THEN anyPay := TRUE END
          END
        END ;
        (* a NAMED struct, like records: an anonymous typedef cannot
           be forward-declared, so a SLICE OF this variant put an
           undeclared name in the header (SliceVar.m9) *)
        IF NOT IsOpaque (tys[i].name) THEN
          Line (buf, 0, S6 ('typedef struct ', CP (modName), '_', tys[i].name,
            ' ', S4 (CP (modName), '_', tys[i].name, ';')))
        END ;
        IF anyPay THEN
          Line (buf, 0, S5 ('struct ', CP (modName), '_', tys[i].name, ' {')) ;
          Line (buf, 0, '  int32_t tag;') ;
          Line (buf, 0, '  union {') ;
          FOR ci := 0 TO d.nkids - 1 DO
            IF d.kids[ci] IS SOME v THEN
              IF v.kids[0] IS SOME vfs THEN
                s := '    struct { ' ;
                FOR j2 := 0 TO vfs.nkids - 1 DO
                  IF vfs.kids[j2] IS SOME fg THEN
                    IF fg.kids[0] IS SOME fids THEN
                      FOR i2 := 0 TO fids.nkids - 1 DO
                        IF fids.kids[i2] IS SOME fid THEN
                          s := S5 (s, TyC (fg.kids[1]), ' ',
                            CN (fid.au), '; ')
                        END
                      END
                    END
                  END
                END ;
                Line (buf, 0, S3 (s, '} ', S2 (v.au, ';')))
              END
            END
          END ;
          Line (buf, 0, '  } u;') ;
          Line (buf, 0, '};')
        ELSE
          Line (buf, 0, S4 ('struct ', CP (modName), '_',
            S2 (tys[i].name, ' { int32_t tag; };')))
        END ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            Line (buf, 0, S7 ('#define ', CP (modName), '_', tys[i].name,
              '_', v.au, S2 (' ', ItoA (ci)))) ;
            (* NAME's food: one code-point array per member -- its
               octets under the rehearsed switch *)
            IF strUtf THEN
              Line (buf, 0, S9 ('static const uint8_t ', CP (modName), '_',
                tys[i].name, '_nm', ItoA (ci), '[] = { ',
                Utf8Codes (v.au), ' };'))
            ELSE
              Line (buf, 0, S9 ('static const uint32_t ', CP (modName), '_',
                tys[i].name, '_nm', ItoA (ci), '[] = { ',
                StrCodes (v.au), ' };'))
            END
          END
        END ;
        (* and the table NAME indexes by tag *)
        (* __unused__: the table is dead when nobody calls NAME on
           this type, and -Werror=unused-const-variable would reject
           it; the linker strips it either way *)
        IF strUtf THEN
          Line (buf, 0, S6 ('static const m9_sl_UTF8 __attribute__((__unused__)) ',
            CP (modName), '_', tys[i].name, '_names[] = {', ''))
        ELSE
          Line (buf, 0, S6 ('static const m9_sl_CHAR __attribute__((__unused__)) ',
            CP (modName), '_', tys[i].name, '_names[] = {', ''))
        END ;
        FOR ci := 0 TO d.nkids - 1 DO
          IF d.kids[ci] IS SOME v THEN
            IF strUtf THEN
              Line (buf, 0, S9 ('  { (uint8_t *) ', CP (modName), '_',
                tys[i].name, '_nm', ItoA (ci), ', ',
                ItoA (Utf8Len (v.au)), ' },'))
            ELSE
              Line (buf, 0, S9 ('  { (uint32_t *) ', CP (modName), '_',
                tys[i].name, '_nm', ItoA (ci), ', ',
                ItoA (Text.CpCount (v.au)), ' },'))
            END
          END
        END ;
        Line (buf, 0, '};') ;
        Line (buf, 0, '')
      END
    END
  END ;

  (* exceptions: static descriptors, identity by address (par 11) *)
  FOR i := 0 TO nxcs - 1 DO
    IF xcs[i].fdef THEN
      Line (KHdr, 0, S4 ('extern const m9_exc ', CP (modName), '_',
        S2 (xcs[i].name, ';'))) ;
      Line (KSrc, 0, S7 ('const m9_exc ', CP (modName), '_', xcs[i].name,
        ' = { "', xcs[i].name, '" };'))
    ELSE
      Line (KSrc, 0, S7 ('static const m9_exc ', CP (modName), '_',
        xcs[i].name, ' = { "', xcs[i].name, '" };'))
    END
  END ;
  IF nxcs > 0 THEN
    Line (KHdr, 0, '') ;
    Line (KSrc, 0, '')
  END ;

  (* record bodies -- into rec2 (spliced after the typedefs their
     field types register), except transparent DEFINITION records,
     which callers must see: those go to the header *)
  FOR i := 0 TO ntys - 1 DO
    IF tys[i].node IS SOME d THEN
      IF d.kind = Ast.NRecordType OR
         d.kind = Ast.NMonitorType THEN
        IF tys[i].fdef AND NOT IsOpaque (tys[i].name) THEN
          buf := KHdrRecs
        ELSE
          buf := KRec2
        END ;
        IF d.kind = Ast.NMonitorType THEN
          fsq := d.kids[0]
        ELSE
          fsq := d.kids[1]
        END ;
        (* the field types FIRST: a field that is an ARRAY OF a record
           of this module registers that array's typedef as its type is
           computed, and the typedef must come before this struct and
           after the element's -- gcc refused "unknown type name
           m9_arr_64_Pw_Perr" for `errs : ARRAY MaxErr OF Perr' in a
           record (2026-10-10; Parse.m9 kept three parallel arrays
           for it).  Into this record's buffer, then, and computed
           once: the struct below writes the same types. *)
        fts := NEW (UTF, 0) ;
        IF fsq IS SOME fs THEN
          fts := NEW (UTF, fs.nkids) ;
          arrInto := buf ;
          FOR ci := 0 TO fs.nkids - 1 DO
            IF fs.kids[ci] IS SOME fg THEN fts[ci] := TyC (fg.kids[1]) END
          END ;
          arrInto := 0
        END ;
        IF NOT IsOpaque (tys[i].name) THEN
          Line (buf, 0, S6 ('typedef struct ', CP (modName), '_',
            tys[i].name, ' ', S4 (CP (modName), '_', tys[i].name, ';')))
        END ;
        Line (buf, 0, S5 ('struct ', CP (modName), '_', tys[i].name, ' {')) ;
        (* A MONITOR IS A RECORD WITH A LOCK AS ITS FIRST FIELD, so it
           is layout-compatible with the record it is and the lock
           needs no offset arithmetic.  No constructor: M9 records
           arrive zeroed and a zeroed pthread_mutex_t is
           PTHREAD_MUTEX_INITIALIZER on glibc -- measured, see
           m9rt.h. *)
        IF d.kind = Ast.NMonitorType THEN
          Line (buf, 0, '  m9_mon m9mon;')
        END ;
        (* one declarator per line: `T * a, b` is one pointer and one
           struct in C -- the star binds to the declarator, not the
           type *)
        IF fsq IS SOME fs THEN
          FOR ci := 0 TO fs.nkids - 1 DO
            IF fs.kids[ci] IS SOME fg THEN
              s := fts[ci] ;
              IF fg.kids[0] IS SOME fids THEN
                FOR j2 := 0 TO fids.nkids - 1 DO
                  IF fids.kids[j2] IS SOME fid THEN
                    Line (buf, 0, S4 ('  ', s, ' ', S2 (CN (fid.au), ';')))
                  END
                END
              END
            END
          END
        END ;
        Line (buf, 0, '};') ;
        Line (buf, 0, '')
      END
    END
  END ;

  (* module consts -- into the header, so importers see them *)
  FOR ci := 0 TO consts.n - 1 DO
    IF consts.es[ci].v IS SOME e THEN
      IF e.kind = Ast.NInt THEN
        Line (KHdrConsts, 0, S6 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' INT64_C(', S2 (e.au, ')')))
      (* a negated literal is a unary node, not a literal: Dict's
         Empty = -1 is the first const the corpus wrote that way *)
      ELSIF IsNegLit (e, Ast.NInt) THEN
        Line (KHdrConsts, 0, S6 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' INT64_C(-', S2 (NegLitText (e), ')')))
      ELSIF IsNegLit (e, Ast.NReal) THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (-', NegLitText (e), ')'))
      ELSIF e.kind = Ast.NReal THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (', e.au, ')'))
      ELSIF Text.BLen (RealC (consts.es[ci].v)) > 0 THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ', RealC (consts.es[ci].v), ''))
      (* a BOOLEAN constant.  the ported model's parameter module has four of them and
         Fortran calls them parameters, which is what they are: a
         switch a program cannot flip at run time *)
      ELSIF e.kind = Ast.NTrue THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' true'))
      ELSIF e.kind = Ast.NFalse THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' false'))
      ELSIF e.kind = Ast.NString AND Text.BLen (e.au) > 0 AND strUtf THEN
        (* the rehearsed switch: a string CONST is its octets *)
        Line (KHdrConsts, 0, S9 ('static const uint8_t ', CP (modName), '_',
          consts.es[ci].k, '_d[', ItoA (Utf8Len (e.au)), '] = { ',
          Utf8Codes (e.au), ' };')) ;
        Line (KHdrConsts, 0, S9 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ((m9_sl_UTF8){ (uint8_t *) ', CP (modName),
          '_', consts.es[ci].k, S4 ('_d, ', ItoA (Utf8Len (e.au)), ' })', '')))
      ELSIF e.kind = Ast.NString AND Text.BLen (e.au) > 0 THEN
        Line (KHdrConsts, 0, S9 ('static const uint32_t ', CP (modName), '_',
          consts.es[ci].k, '_d[', ItoA (Text.CpCount (e.au)), '] = { ',
          StrCodes (e.au), ' };')) ;
        Line (KHdrConsts, 0, S9 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ((m9_sl_CHAR){ (uint32_t *) ', CP (modName),
          '_', consts.es[ci].k, S4 ('_d, ', ItoA (Text.CpCount (e.au)), ' })', '')))
      (* the empty string: no storage, as the literal '' has none *)
      ELSIF e.kind = Ast.NString AND strUtf THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ((m9_sl_UTF8){ NULL, 0 })'))
      ELSIF e.kind = Ast.NString THEN
        Line (KHdrConsts, 0, S5 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' ((m9_sl_CHAR){ NULL, 0 })'))
      (* a CHAR constant: one code point, emitted like the char
         literal it names -- <cp>u -- so `s + NL` joins it as a code
         point the way `s + 0AC` does (par 2.2) *)
      ELSIF e.kind = Ast.NChar THEN
        Line (KHdrConsts, 0, S7 ('#define ', CP (modName), '_',
          consts.es[ci].k, ' (', S2 (ItoA (CharVal (e.au)), 'u'), ')'))
      ELSE
        ErrAt (e, 'const form unsupported yet')
      END
    END
  END ;

  (* foreign procedures: extern declarations against the C ABI, the
     names passing through verbatim (par 7) *)
  FOR i := 0 TO foreignProcs.n - 1 DO
    IF foreignProcs.es[i].v IS SOME d THEN
      IF d.kids[1] IS SOME rt THEN s := TyC (d.kids[1]) ELSE s := 'void' END ;
      cs := '' ;
      IF d.kids[0] IS SOME pl THEN
        FOR ci := 0 TO pl.nkids - 1 DO
          IF pl.kids[ci] IS SOME grp THEN
            IF grp.kids[0] IS SOME gids THEN
              FOR j2 := 0 TO gids.nkids - 1 DO
                IF Text.BLen (cs) > 0 THEN cs := S2 (cs, ', ') END ;
                cs := S2 (cs, TyC (grp.kids[1]))
              END
            END
          END
        END
      END ;
      IF Text.BLen (cs) = 0 THEN cs := 'void' END ;
      Line (KSrc, 0, S6 ('extern ', s, ' ', d.bu, ' (', S2 (cs, ');')))
    END
  END ;
  IF foreignProcs.n > 0 THEN Line (KSrc, 0, '') END ;

  (* STATEFUL module state: statics, zero like every C static --
     which is also M9's defined-zero story.  Emitted into rec2 now so
     their array typedefs register before tdefs is spliced. *)
  FOR i := 0 TO nmv - 1 DO
    Line (KRec3, 0, S5 ('static ', TyC (mvT[i]), ' ', CN (mvN[i]), ';'))
  END ;
  EmitAggs () ;
  (* the MODULE FRAME: the arena of the init body (a program's main),
     static and at file scope since 2026-09-30 so that a module
     variable declared without a pool has one to be grown in (rule 2
     of docs/pool-elision-plan.md) -- a module variable lives as long
     as the module, and so does this *)
  Line (KRec3, 0, 'static m9_pool m9mframe = {0};') ;
  Line (KRec3, 0, '') ;
  ExportVars () ;

  (* procedures emit into pbuf; typedefs, string literals, and static
     prototypes they discover along the way land before them *)
  FOR i := 0 TO ngps - 1 DO
    IF NOT Collapsed (gps[i].name) THEN GenProc (i) END
  END ;
  IF isProgram THEN
    IF mainBody IS SOME mb THEN GenMain () END
  ELSE
    GenInit (fm)
  END ;

  (* header assembly: consts, discovered typedefs, transparent def
     records, prototypes -- in dependency order *)
  DynUtf.Append (bHdr, DynUtf.ViewIn (gpool, bHdrConsts)) ;
  IF hdrConstN > 0 THEN Line (KHdr, 0, '') END ;
  DynUtf.Append (bHdr, DynUtf.ViewIn (gpool, bTdefs)) ;
  IF tdefN > 0 THEN Line (KHdr, 0, '') END ;
  DynUtf.Append (bHdr, DynUtf.ViewIn (gpool, bHdrRecs)) ;
  DynUtf.Append (bHdr, DynUtf.ViewIn (gpool, bHdrArrRec)) ;
  DynUtf.Append (bHdr, DynUtf.ViewIn (gpool, bHdrProtos)) ;
  Line (KHdr, 0, '') ;
  Line (KHdr, 0, '#endif') ;

  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bRec2)) ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bArrRec)) ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bRec3)) ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bLit)) ;
  IF litN > 0 THEN Line (KSrc, 0, '') END ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bGate)) ;
  IF gateSeen.n > 0 THEN Line (KSrc, 0, '') END ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bSprotos)) ;
  IF sprotoN > 0 THEN Line (KSrc, 0, '') END ;
  (* the trampolines go AFTER the prototypes they call and before the
     bodies, which is the only place both are visible *)
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bThr)) ;
  IF thrSeen.n > 0 THEN Line (KSrc, 0, '') END ;
  DynUtf.Append (bSrc, DynUtf.ViewIn (gpool, bPbuf)) ;

  hOut := DynUtf.ViewIn (gpool, bHdr) ;
  cOut := DynUtf.ViewIn (gpool, bSrc)
END Emit ;

PROCEDURE HText () : UTF =
BEGIN
  RETURN hOut
END HText ;

PROCEDURE CText () : UTF =
BEGIN
  RETURN cOut
END CText ;

PROCEDURE Errs () : I64 =
BEGIN
  RETURN nerrV
END Errs ;

END Gen.
