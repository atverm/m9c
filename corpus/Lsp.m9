MODULE Lsp ;

(* m9lsp -- the Language Server Protocol over standard input and
   output, in M9.

   THE RULE THIS PROGRAM EXISTS TO KEEP: no second scanner.  The
   corpus refuted editor-side relexing the day a phantom comment ate
   fifty-four lines of Gen.m9 (eighteen string literals carrying
   comment brackets), so every diagnostic this server publishes is
   the COMPILER's own answer: it invokes `m9c --check` -- the flag
   built for this program: check, print, write NOTHING -- and
   republishes the diagnostics with their line and column.  The
   server never lexes M9; it parses m9c's output lines.

   Version 1, and the narrowings are stated rather than hidden:
   - checks run on didOpen and didSave, against the file ON DISK: an
     unsaved buffer is not checked, because m9c reads files and a
     temp-file mirror would break module-name-matches-file;
   - diagnostics only -- the VS Code extension already has hover and
     completion from `m9c --doc`, and other editors get those when
     the server grows its second stage;
   - a body is taken as the UTF-8 it arrives as (ValueRange when it is
     not), and Content-Length is a UTF's byte length.

   The compiler invoked is $M9LSP_M9C, else `m9c` from PATH; the
   search path is m9c's own -- $M9LIBRARY, the installed StdLib, and
   the checked file's directory.                                     *)

IMPORT Io ;
IMPORT DynUtf ;
IMPORT Text ;
IMPORT JsonUtf ;
IMPORT Diag ;

CONST
  Version = '0.25.1' ;
  RdCap = 65536 ;

VAR
  inBuf : SLICE OF BYTE ;    (* the stdin window: [inPos, inLen) *)
  inPos, inLen : I64 ;
  atEof : BOOL ;
  m9c : STR ;                (* the compiler this server repeats *)
  errFile : STR ;

(* ---- framed input ------------------------------------------------ *)

(* more bytes into the window, compacting first; FALSE at end of
   input.  The buffer doubles when a message outgrows it, so one
   allocation serves a whole session of ordinary traffic. *)
PROCEDURE Fill () : BOOL =
VAR
  nb, got : SLICE OF BYTE ;
  i, room : I64 ;
BEGIN
  IF atEof THEN RETURN FALSE END ;
  IF inPos > 0 THEN
    FOR i := 0 TO inLen - inPos - 1 DO inBuf[i] := inBuf[inPos + i] END ;
    inLen := inLen - inPos ;
    inPos := 0
  END ;
  room := LEN (inBuf) - inLen ;
  IF room = 0 THEN
    nb := NEW (HEAP, BYTE, 2 * LEN (inBuf)) ;
    FOR i := 0 TO inLen - 1 DO nb[i] := inBuf[i] END ;
    inBuf := nb ;
    room := LEN (inBuf) - inLen
  END ;
  got := Io.ReadStdin (room) ;
  IF LEN (got) = 0 THEN
    atEof := TRUE ;
    RETURN FALSE
  END ;
  FOR i := 0 TO LEN (got) - 1 DO inBuf[inLen + i] := got[i] END ;
  inLen := inLen + LEN (got) ;
  RETURN TRUE
END Fill ;

(* one header line as text, CR and LF stripped; FALSE at end of
   input.  Header octets are ASCII by protocol. *)
PROCEDURE ReadLine (VAR line: UTF) : BOOL
  RAISES ValueRange =
VAR
  i, n : I64 ;
  found : BOOL ;
BEGIN
  found := FALSE ;
  WHILE NOT found DO
    i := inPos ;
    WHILE i < inLen AND inBuf[i] # 0x0A DO i := i + 1 END ;
    IF i < inLen THEN found := TRUE
    ELSE
      IF NOT Fill () THEN RETURN FALSE END
    END
  END ;
  i := inPos ;
  WHILE inBuf[i] # 0x0A DO i := i + 1 END ;
  n := i - inPos ;
  IF n > 0 AND inBuf[i - 1] = 0x0D THEN n := n - 1 END ;
  line := UTF (SLICE (inBuf, inPos, n)) ;
  inPos := i + 1 ;
  RETURN TRUE
END ReadLine ;

(* exactly n body octets, as the UTF they are *)
PROCEDURE ReadBody (n: I64 ; VAR body: UTF) : BOOL
  RAISES ValueRange =
BEGIN
  WHILE inLen - inPos < n DO
    IF NOT Fill () THEN RETURN FALSE END
  END ;
  body := UTF (SLICE (inBuf, inPos, n)) ;
  inPos := inPos + n ;
  RETURN TRUE
END ReadBody ;

(* ---- framed output ----------------------------------------------- *)

PROCEDURE ByteLen (RO s: UTF) : I64 =
BEGIN
  RETURN Text.BLen (s)            (* a UTF's length IS its byte count *)
END ByteLen ;

PROCEDURE Send (RO body: UTF) =
VAR
  scratch : POOL ;
  d : PTR DynUtf.DString IN scratch ;
BEGIN
  d := DynUtf.New (scratch) ;
  DynUtf.Append (d, 'Content-Length: ') ;
  DynUtf.AppendI64 (d, ByteLen (body)) ;
  DynUtf.AppendChar (d, 0DC) ;
  DynUtf.AppendChar (d, 0AC) ;
  DynUtf.AppendChar (d, 0DC) ;
  DynUtf.AppendChar (d, 0AC) ;
  Io.Write (DynUtf.View (d)) ;
  Io.Write (body) ;
  Io.Flush ()
END Send ;

PROCEDURE ItoA (v: I64) : UTF =
VAR pool : POOL ;
    d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.AppendI64 (d, v) ;
  RETURN DynUtf.View (d)
END ItoA ;

PROCEDURE Cat (RO a: UTF ; RO b: UTF) : UTF =
VAR pool : POOL ;
    d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.Append (d, b) ;
  RETURN DynUtf.View (d)
END Cat ;

(* ---- diagnostics: m9c --check, republished ----------------------- *)

(* file:///a/b%2Dc -> /a/b-c.  Only the path is wanted here; the
   URI itself is echoed back verbatim, so this never round-trips. *)
PROCEDURE UriPath (RO uri: UTF) : UTF
  RAISES ValueRange =
VAR
  b : SLICE OF BYTE ;
  i, n, hi, lo : I64 ;
BEGIN
  (* decoded into octets -- %C3%A4 is the two octets of an a-umlaut,
     not two characters -- and validated as UTF-8 at the end *)
  b := NEW (BYTE, Text.BLen (uri)) ;
  n := 0 ;
  i := 0 ;
  IF Text.StartsWith (uri, 'file://') THEN i := 7 END ;
  WHILE i < Text.BLen (uri) DO
    IF Text.BAt (uri, i) = BYTE (37) AND i + 2 < Text.BLen (uri) THEN
      hi := HexVal (I64 (Text.BAt (uri, i + 1))) ;
      lo := HexVal (I64 (Text.BAt (uri, i + 2))) ;
      IF hi >= 0 AND lo >= 0 THEN
        b[n] := BYTE (hi * 16 + lo) ;
        i := i + 3
      ELSE
        b[n] := Text.BAt (uri, i) ;
        i := i + 1
      END
    ELSE
      b[n] := Text.BAt (uri, i) ;
      i := i + 1
    END ;
    n := n + 1
  END ;
  RETURN UTF (SLICE (b, 0, n))
END UriPath ;

PROCEDURE HexVal (c: I64) : I64 =
BEGIN
  IF c >= 48 AND c <= 57 THEN RETURN c - 48 END ;         (* 0-9 *)
  IF c >= 97 AND c <= 102 THEN RETURN c - 97 + 10 END ;   (* a-f *)
  IF c >= 65 AND c <= 70 THEN RETURN c - 65 + 10 END ;    (* A-F *)
  RETURN -1
END HexVal ;

PROCEDURE DiagJson (ln, cl: I64 ; RO msg: UTF) : UTF
  RAISES ValueRange =
VAR
  pool : POOL ;
  d : PTR DynUtf.DString IN pool ;
  l0, c0 : I64 ;
BEGIN
  l0 := ln - 1 ;
  c0 := cl - 1 ;
  IF l0 < 0 THEN l0 := 0 END ;
  IF c0 < 0 THEN c0 := 0 END ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, '{"range":{"start":{"line":') ;
  DynUtf.AppendI64 (d, l0) ;
  DynUtf.Append (d, ',"character":') ;
  DynUtf.AppendI64 (d, c0) ;
  DynUtf.Append (d, '},"end":{"line":') ;
  DynUtf.AppendI64 (d, l0) ;
  DynUtf.Append (d, ',"character":') ;
  DynUtf.AppendI64 (d, c0) ;
  DynUtf.Append (d, '}},"severity":1,"source":"m9c","message":') ;
  Diag.JStrUtf (d, msg) ;
  DynUtf.AppendChar (d, 07DC) ;
  RETURN DynUtf.View (d)
END DiagJson ;

(* check the file the uri names and publish what m9c said.  A path
   carrying a quote is refused with one diagnostic rather than
   handed to a shell -- m9c's own rule at its own link step.  The
   reading of m9c's lines is Diag.Check's (shared with m9edit and
   the tutor); what is m9lsp's is the LSP envelope and the 0-based
   positions. *)
PROCEDURE Check (VAR pool: POOL ; RO uri: UTF)
  RAISES ValueRange, IndexError =
VAR
  body : PTR DynUtf.DString IN pool ;
  path, one : UTF ;
  fs : SLICE OF Diag.Finding ;
  i, n : I64 ;
  bad : BOOL ;
BEGIN
  path := UriPath (uri) ;
  bad := Text.FindChar (path, 027C) >= 0 OR Text.FindChar (path, 022C) >= 0 ;
  body := DynUtf.New (pool) ;
  DynUtf.Append (body,
    '{"jsonrpc":"2.0","method":"textDocument/publishDiagnostics",') ;
  DynUtf.Append (body, '"params":{"uri":') ;
  Diag.JStrUtf (body, uri) ;
  DynUtf.Append (body, ',"diagnostics":[') ;
  n := 0 ;
  IF bad THEN
    one := DiagJson (1, 1,
      'm9lsp: a path containing a quote is not checked') ;
    DynUtf.Append (body, one) ;
    n := 1
  ELSE
    fs := Diag.Check (pool, m9c, '', '', STR (path), errFile) ;
    FOR i := 0 TO LEN (fs) - 1 DO
      one := DiagJson (fs[i].line, fs[i].col, fs[i].msg) ;
      IF n > 0 THEN DynUtf.AppendChar (body, 02CC) END ;
      DynUtf.Append (body, one) ;
      n := n + 1
    END
  END ;
  DynUtf.Append (body, ']}}') ;
  Send (DynUtf.ViewIn (pool, body))
END Check ;

(* ---- the loop ---------------------------------------------------- *)

PROCEDURE Respond (RO idText: UTF ; RO result: UTF) =
VAR pool : POOL ;
    d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, '{"jsonrpc":"2.0","id":') ;
  DynUtf.Append (d, idText) ;
  DynUtf.Append (d, ',"result":') ;
  DynUtf.Append (d, result) ;
  DynUtf.AppendChar (d, 07DC) ;
  Send (DynUtf.View (d))
END Respond ;

(* the request id, re-rendered: a number, or a string, per JSON-RPC *)
PROCEDURE RenderIdS (idn: PTR JsonUtf.Node) : UTF
  RAISES ValueRange =
VAR pool : POOL ;
    d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  Diag.JStrUtf (d, JsonUtf.AsStr (idn)) ;
  RETURN DynUtf.View (d)
EXCEPT
| JsonUtf.TypeMismatch (m) :
    RETURN ''
END RenderIdS ;

PROCEDURE RenderId (idn: PTR JsonUtf.Node) : UTF
  RAISES ValueRange =
BEGIN
  RETURN ItoA (JsonUtf.AsI64 (idn))
EXCEPT
| JsonUtf.TypeMismatch (m) :
    RETURN RenderIdS (idn)
END RenderId ;

PROCEDURE DocUri (msg: PTR JsonUtf.Node) : UTF =
BEGIN
  IF JsonUtf.Field (msg, 'params') IS SOME p THEN
    IF JsonUtf.Field (p, 'textDocument') IS SOME td THEN
      IF JsonUtf.Field (td, 'uri') IS SOME u THEN
        RETURN JsonUtf.AsStr (u)
      END
    END
  END ;
  RETURN ''
EXCEPT
| JsonUtf.TypeMismatch (m) :
    RETURN ''
END DocUri ;

PROCEDURE MethodOf (msg: PTR JsonUtf.Node) : UTF =
BEGIN
  IF JsonUtf.Field (msg, 'method') IS SOME mn THEN
    RETURN JsonUtf.AsStr (mn)
  END ;
  RETURN ''
EXCEPT
| JsonUtf.TypeMismatch (m) :
    RETURN ''
END MethodOf ;

PROCEDURE Handle (VAR pool: POOL ; RO body: UTF) RAISES ValueRange =
VAR
  msg : PTR JsonUtf.Node ;
  method, ids, uri : UTF ;
BEGIN
  msg := JsonUtf.Parse (body) ;
  method := MethodOf (msg) ;
  ids := '' ;
  IF JsonUtf.Field (msg, 'id') IS SOME idn THEN
    ids := RenderId (idn)
  END ;
  IF Text.Eq (method, 'initialize') THEN
    Respond (ids, Cat ('{"capabilities":{"textDocumentSync":{"openClose":true,"change":0,"save":true}},"serverInfo":{"name":"m9lsp","version":"',
      Cat (Version, '"}}')))
  ELSIF Text.Eq (method, 'shutdown') THEN
    Respond (ids, 'null')
  ELSIF Text.Eq (method, 'exit') THEN
    Io.Flush () ;
    Io.Halt (0)
  ELSIF Text.Eq (method, 'textDocument/didOpen') OR
        Text.Eq (method, 'textDocument/didSave') THEN
    uri := DocUri (msg) ;
    IF Text.BLen (uri) > 0 THEN Check (pool, uri) END
  ELSE
    (* a REQUEST we do not know must be answered or the client
       hangs; a notification must not be *)
    IF Text.BLen (ids) > 0 THEN
      Send (Cat (Cat ('{"jsonrpc":"2.0","id":', ids),
        ',"error":{"code":-32601,"message":"method not found"}}'))
    END
  END
EXCEPT
| JsonUtf.ParseError (m, l, c) :
    (* a malformed frame is the client's bug; surviving it is ours *)
    Io.ErrLine ('m9lsp: unparsable message: ' + m)
END Handle ;

PROCEDURE Serve () RAISES ValueRange =
VAR
  reqPool : POOL ;
  line, body : UTF ;
  clen : I64 ;
BEGIN
  WHILE TRUE DO
    clen := -1 ;
    IF NOT ReadLine (line) THEN RETURN END ;
    WHILE Text.BLen (line) > 0 DO
      IF Text.StartsWith (line, 'Content-Length: ') THEN
        clen := Io.ParseI64 (SLICE (line, 16, Text.BLen (line) - 16))
      END ;
      IF NOT ReadLine (line) THEN RETURN END
    END ;
    IF clen >= 0 THEN
      IF NOT ReadBody (clen, body) THEN RETURN END ;
      Handle (reqPool, body)
    END
  END
END Serve ;

BEGIN
  inBuf := NEW (HEAP, BYTE, RdCap) ;
  inPos := 0 ;
  inLen := 0 ;
  atEof := FALSE ;
  m9c := Io.Env (HEAP, 'M9LSP_M9C') ;
  IF LEN (m9c) = 0 THEN m9c := 'm9c' END ;
  errFile := '/tmp/m9lsp.err' ;
  Serve ()
EXCEPT
| ValueRange :
    Io.ErrLine ('m9lsp: internal ValueRange; stopping') ;
    Io.Halt (1)
END Lsp.
