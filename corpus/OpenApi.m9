DEFINITION MODULE OpenApi ;

(* Minimal OpenAPI 3.0 document from an HttpServer route table.
   Routes are data, so the description is derived, not maintained:
   a path the server answers is a path the document lists, by
   construction.  Serve the result on /openapi.json and the router
   documents itself.                                                 *)

IMPORT HttpServer ;

PROCEDURE Document (RO title: STR ;
                    RO version: STR ;
                    r: PTR HttpServer.Router)
  : RO STR ;
  (* the document text lives in pool.  Title, version, and summaries
     are emitted verbatim -- no JSON escaping, so a quote in them is
     the caller's bug.  Escape when a real client demands it, with a
     museum piece.                                                   *)

END OpenApi.


IMPLEMENTATION MODULE OpenApi ;

IMPORT HttpServer ;
IMPORT DynStr ;

PROCEDURE PathSeen (r: PTR HttpServer.Router ; i: I64) : BOOL =
VAR j : I64 ;
BEGIN
  FOR j := 0 TO i - 1 DO
    IF DynStr.Eq (HttpServer.RoutePath (r, j),
                  HttpServer.RoutePath (r, i)) THEN
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END PathSeen ;

PROCEDURE AppendMethod (VAR d: PTR DynStr.DString ;
                        RO m: STR) =
BEGIN
  (* OpenAPI wants lowercase method keys; the known verbs map, an
     unknown verb passes through verbatim and the document's reader
     rejects it -- the failure stays visible                         *)
  IF DynStr.Eq (m, 'GET') THEN DynStr.Append (d, 'get')
  ELSIF DynStr.Eq (m, 'POST') THEN DynStr.Append (d, 'post')
  ELSIF DynStr.Eq (m, 'PUT') THEN DynStr.Append (d, 'put')
  ELSIF DynStr.Eq (m, 'DELETE') THEN DynStr.Append (d, 'delete')
  ELSIF DynStr.Eq (m, 'HEAD') THEN DynStr.Append (d, 'head')
  ELSE DynStr.Append (d, m)
  END
END AppendMethod ;

PROCEDURE Operation (VAR d: PTR DynStr.DString ;
                     r: PTR HttpServer.Router ; j: I64) =
BEGIN
  (* "get":{"summary":S,"responses":{"200":{"description":S,
     "content":{"text/plain":{}}}}} -- the summary doubles as the
     response description: one string, two mandatory slots           *)
  DynStr.AppendChar (d, '"') ;
  AppendMethod (d, HttpServer.RouteMethod (r, j)) ;
  DynStr.Append (d, '":{"summary":"') ;
  DynStr.Append (d, HttpServer.RouteSummary (r, j)) ;
  DynStr.Append (d, '","responses":{"') ;
  DynStr.AppendI64 (d, HttpServer.RouteStatus (r, j)) ;
  DynStr.Append (d, '":{"description":"') ;
  DynStr.Append (d, HttpServer.RouteSummary (r, j)) ;
  DynStr.Append (d, '","content":{"') ;
  DynStr.Append (d, HttpServer.RouteType (r, j)) ;
  DynStr.Append (d, '":{}}}}}')
END Operation ;

PROCEDURE Document (RO title: STR ;
                    RO version: STR ;
                    r: PTR HttpServer.Router)
  : RO STR =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  i, j, n : I64 ;
  firstPath, firstOp : BOOL ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, '{"openapi":"3.0.3","info":{"title":"') ;
  DynStr.Append (d, title) ;
  DynStr.Append (d, '","version":"') ;
  DynStr.Append (d, version) ;
  DynStr.Append (d, '"},"paths":{') ;
  n := HttpServer.RouteCount (r) ;
  firstPath := TRUE ;
  FOR i := 0 TO n - 1 DO
    IF NOT PathSeen (r, i) THEN
      (* one path object per distinct path; every method on that
         path becomes an operation inside it.  O(n^2) over a route
         table: measure before believing it matters.                 *)
      IF NOT firstPath THEN DynStr.AppendChar (d, ',') END ;
      firstPath := FALSE ;
      DynStr.AppendChar (d, '"') ;
      DynStr.Append (d, HttpServer.RoutePath (r, i)) ;
      DynStr.Append (d, '":{') ;
      firstOp := TRUE ;
      FOR j := i TO n - 1 DO
        IF DynStr.Eq (HttpServer.RoutePath (r, j),
                      HttpServer.RoutePath (r, i)) THEN
          IF NOT firstOp THEN DynStr.AppendChar (d, ',') END ;
          firstOp := FALSE ;
          Operation (d, r, j)
        END
      END ;
      DynStr.AppendChar (d, '}')
    END
  END ;
  DynStr.Append (d, '}}') ;
  RETURN DynStr.View (d)
END Document ;

END OpenApi.
