MODULE ExportUse ;

(* ExportUse imports ExportDef's variables (decision 28).  It reads and
   writes them (a scalar, a slice element, a field through a pointer)
   and asks ExportDef what it sees, which must be what was written. *)

IMPORT Io ;
IMPORT Fmt ;
IMPORT ExportDef ;
VAR
  row : ARRAY ExportDef.Width OF F64 ;   (* an imported CONST as a bound *)
  c : PTR ExportDef.Cell ;
  time, exit : I64 ;   (* named like C library functions, beside the imported ExportDef.time *)
BEGIN
  (* This compares a field of an imported record with an imported
     enumeration's member.  `c.shade = ExportDef.Shade.Dark' was a C
     struct == until 2026-10-09 (cp-kernel's Jv.Kind finding). *)
  c := NEW (ExportDef.Cell) ;
  (* LEN (row) folds to a constant, so the C would never name row.
     This write keeps the array a variable the C uses. *)
  row[0] := 1.0 ;
  c.shade := ExportDef.Shade.Dark ;
  IF c.shade = ExportDef.Shade.Dark THEN Io.WriteLine ('ExportUse compares a Shade across modules') END ;
  IF c.shade # ExportDef.Shade.Light THEN Io.WriteLine ('and its negation') END ;
  Io.WriteLine ('ExportUse reads count ' + Fmt.I64Str (ExportDef.count) +
                ', LEN xs ' + Fmt.I64Str (LEN (ExportDef.xs)) +
                ', version ' + Fmt.I64Str (ExportDef.version) +
                ', LEN row ' + Fmt.I64Str (LEN (row))) ;
  ExportDef.count := ExportDef.count + 2 ;
  ExportDef.xs[1] := 9.5 ;
  ExportDef.box.n := 7 ;
  ExportDef.Show () ;
  (* A program's variable and an imported one share a name with the C
     library's time ().  Each is its own storage. *)
  time := ExportDef.time + 1 ;
  ExportDef.time := time * 2 ;
  exit := ExportDef.time - time ;
  Io.WriteLine ('time ' + Fmt.I64Str (time) + ', ExportDef.time ' +
                Fmt.I64Str (ExportDef.time) + ', exit ' + Fmt.I64Str (exit)) ;
  ExportDef.SetTime (1) ;
  ExportUse.exit := ExportDef.time ;
  Io.WriteLine ('SetTime (1) gives ' + Fmt.I64Str (ExportUse.exit))
EXCEPT
| ValueRange :
    Io.Halt (2)
| IndexError :
    Io.Halt (3)
END ExportUse.
