STATEFUL DEFINITION MODULE Lex ;

(* The M9 lexer, in M9 -- the first thousandth of the self-hosted
   compiler (P5 stage 1), restated from host/fpc/M9Lex.pas, which
   now serves as its differential oracle: both must emit identical
   token streams over every corpus and museum file.
   Kinds are I64 codes, stable and documented: 0 EOF, 1 Error,
   2 Ident, 3 IntLit, 4 RealLit, 5 CharLit, 6 StrLit, then keywords
   from 7 and operators from 200.  Codes are identifiers, not
   positions in a sorted list: a new keyword APPENDS at the next
   free code rather than renumbering its alphabetical neighbours.
   Errors are tokens carrying their message; lexing continues.
   STATEFUL for the comment side channel's list (Collect, below); the
   unexpected-character message was the other reason, a module buffer
   until 2026-10-23.  The source is UTF-8 (step 4 of
   docs/utf8-stage3-plan.md): Init takes a STR and encodes it, InitUtf
   takes the octets as they are.                                     *)

TYPE
  Token = RECORD
    kind, line, col : I64 ;
    text : UTF ;      (* verbatim source; for Error, message *)
  END ;

  (* the source is UTF-8 and pos a BYTE offset into it (since
     2026-10-23, docs/utf8-stage3-plan.md step 4); line and col count
     characters, as they always did, so a diagnostic's position is the
     same on both sides of the switch *)
  Lexer = RECORD
    src : UTF ;
    pos, line, col : I64 ;
  END ;

  (* A comment, for the callers that want the documentation rather
     than the program.  text is VERBATIM and includes the opening
     `(*` and closing `*)`, because a reader that wants them stripped
     can strip them and one that wants the nesting cannot put them
     back. *)
  Comment = RECORD
    line, col, endLine : I64 ;
    text : UTF ;
  END ;

PROCEDURE Init (VAR lx: Lexer ; RO src: STR) ;
  (* src encoded into the lexer's own pool: the STR form, for a caller
     that has not moved to UTF; Lex.Init (lx, u) with a UTF is InitUtf *)

PROCEDURE InitUtf (VAR lx: Lexer ; RO src: UTF) ;
  (* the lexer keeps the source; keep it alive while lexing -- the
     Json.Parse contract again.  Nothing is copied *)

PROCEDURE Next (VAR lx: Lexer ; VAR t: Token) ;
  (* the next token, skipping blanks and nested comments on the way.

     ERRORS ARE TOKENS: a bad character or an unterminated comment
     comes back as an Error token carrying the message and its
     line:col, and lexing CONTINUES.  There is no error state to
     check and no exception to handle, so a caller can report every
     mistake in a file in one pass -- which is what lextest does.

       t -- VAR rather than a result because a Token is a record and
            this is called once per token; the caller reuses one.

     Comments leave no trace here at all: they cost zero tokens, so
     the count lextest.golden records is a count of code.          *)

PROCEDURE KindName (k: I64) : STR ;
  (* the FPC oracle's names, for dumps and diagnostics *)

(* ---- comments, BESIDE the token stream ----

   Comments are not tokens and never will be: making one a token
   would move every count in lextest.golden and put a code in the
   kind table that the parser must then be taught to ignore.  So
   `Skip` throws them away, which is right for a compiler and leaves
   nothing for a documentation tool to read.

   These three procedures are the side channel.  Armed, the lexer
   ALSO appends each comment it skips to a module-level list; the
   token stream, the counts and the printer are untouched, and a
   caller that never arms it pays one BOOL test per comment.

   Storage is HEAP, the predeclared pool: the list outlives the
   Lexer that filled it -- a caller reads it after parsing, not
   during -- and Init takes no pool to borrow.  It is therefore
   never freed, which is what HEAP means, and is the same bargain
   every other one-module-per-process registry here makes.

   THE TEXT IS A VIEW, not a copy: a Comment's text is a slice of
   the source Init was given, so the source must stay alive for as
   long as the comments are read.  That is the contract Init already
   states, extended past the last token. *)

PROCEDURE Collect (on: BOOL) ;
  (* arm or disarm.  Arming also CLEARS what was collected, so one
     process can lex several files and keep them apart; disarming
     keeps it, so a caller can arm, parse one file, disarm, and then
     read the comments of that file only while its dependencies go
     past uncollected.  That is exactly what m9c --doc needs.       *)

PROCEDURE ComCount () : I64 ;
PROCEDURE ComAt (i: I64) : Comment RAISES IndexError ;
  (* what was collected, in source order.

       i -- 0 .. ComCount - 1.  An UNTERMINATED comment is not in
            here at all: it never closed, so it has no end line and
            no text, and the Error token Next answers is the whole
            of what is known about it.                              *)

END Lex.


UNSAFE IMPLEMENTATION MODULE Lex ;

(* UNSAFE is inherited style only: nothing foreign here yet; ADR is
   unused.  Drop UNSAFE the day the checker minds.                   *)

IMPORT DynStr ;
IMPORT Text ;

CONST
  KEOF     = 0 ;
  KError   = 1 ;
  KIdent   = 2 ;
  KInt     = 3 ;
  KReal    = 4 ;
  KChar    = 5 ;
  KStr     = 6 ;
  (* Kind codes are stable IDENTIFIERS, not positions in a sorted
     list.  The first 58 keywords happen to run alphabetically
     because they arrived together; every later one APPENDS at the
     next free code and the table stops being alphabetical.  That is
     deliberate: deriving a code from spelling means an unrelated
     keyword renumbers its neighbours, which churns both lexers, the
     parser's token table and every recorded stream -- a code that
     moves is a code no one can rely on.  Lookup is a linear scan,
     so alphabetical order buys nothing but the reading.
     Keywords own 7..199 and grow upward; operators start at 200.   *)
  KwFirst  = 7 ;
  KwLast   = 68 ;         (* grows as keywords are appended *)
  OpFirst  = 200 ;

  KAssign = 200 ; KEq = 201 ; KNeq = 202 ; KLt = 203 ; KLe = 204 ;
  KGt = 205 ; KGe = 206 ; KPlus = 207 ; KMinus = 208 ; KStar = 209 ;
  KSlash = 210 ; KPlusW = 211 ; KMinusW = 212 ; KStarW = 213 ;
  KLParen = 214 ; KRParen = 215 ; KLBrack = 216 ; KRBrack = 217 ;
  KComma = 218 ; KSemi = 219 ; KColon = 220 ; KDot = 221 ;
  KDotDot = 222 ; KBar = 223 ; KCaret = 224 ;

  HexMsg   = '0123456789abcdef' ;
  HexUp    = '0123456789ABCDEF' ;
  (* the ASCII characters by code: a byte below 128 read as its CHAR
     with no conversion to check -- CHR would put a RAISES ValueRange
     on every Peek *)
  Ascii = [
    0C, 1C, 2C, 3C, 4C, 5C, 6C, 7C, 8C, 9C, 0AC, 0BC,
    0CC, 0DC, 0EC, 0FC, 10C, 11C, 12C, 13C, 14C, 15C, 16C, 17C,
    18C, 19C, 1AC, 1BC, 1CC, 1DC, 1EC, 1FC, 20C, 21C, 22C, 23C,
    24C, 25C, 26C, 27C, 28C, 29C, 2AC, 2BC, 2CC, 2DC, 2EC, 2FC,
    30C, 31C, 32C, 33C, 34C, 35C, 36C, 37C, 38C, 39C, 3AC, 3BC,
    3CC, 3DC, 3EC, 3FC, 40C, 41C, 42C, 43C, 44C, 45C, 46C, 47C,
    48C, 49C, 4AC, 4BC, 4CC, 4DC, 4EC, 4FC, 50C, 51C, 52C, 53C,
    54C, 55C, 56C, 57C, 58C, 59C, 5AC, 5BC, 5CC, 5DC, 5EC, 5FC,
    60C, 61C, 62C, 63C, 64C, 65C, 66C, 67C, 68C, 69C, 6AC, 6BC,
    6CC, 6DC, 6EC, 6FC, 70C, 71C, 72C, 73C, 74C, 75C, 76C, 77C,
    78C, 79C, 7AC, 7BC, 7CC, 7DC, 7EC, 7FC
  ] ;

VAR
  comOn  : BOOL ;               (* Collect armed? *)
  coms   : SLICE OF Comment ;   (* grown in HEAP, doubling *)
  ncom   : I64 ;

PROCEDURE Collect (on: BOOL) =
BEGIN
  comOn := on ;
  IF on THEN ncom := 0 END
END Collect ;

PROCEDURE ComCount () : I64 =
BEGIN
  RETURN ncom
END ComCount ;

PROCEDURE ComAt (i: I64) : Comment RAISES IndexError =
BEGIN
  IF i < 0 OR i >= ncom THEN RAISE IndexError (i, ncom) END ;
  RETURN coms[i]
END ComAt ;

(* one comment onto the list, doubling the vector when it is full.
   The abandoned vector stays in HEAP, which is the same trade
   DynStr.Grow makes and for the same reason.  The text is COPIED
   into HEAP too: a view of the source would be module state keeping
   the lexer's input, and every lexer up to the parser's callers
   would have to say KEPT for a comment list (par 4.1, 2026-10-18). *)
PROCEDURE Note (line, col, endLine: I64 ; RO text: UTF) =
VAR
  nc : SLICE OF Comment ;
  i  : I64 ;
BEGIN
  IF ncom = LEN (coms) THEN
    IF LEN (coms) = 0 THEN
      nc := NEW (HEAP, Comment, 64)
    ELSE
      nc := NEW (HEAP, Comment, 2 * LEN (coms))
    END ;
    FOR i := 0 TO ncom - 1 DO nc[i] := coms[i] END ;
    coms := nc
  END ;
  coms[ncom].line := line ;
  coms[ncom].col := col ;
  coms[ncom].endLine := endLine ;
  coms[ncom].text := UTF (HEAP, text) ;
  ncom := ncom + 1
END Note ;

PROCEDURE KwName (i: I64) : STR =
BEGIN
  CASE i OF
  | 7  : RETURN 'AND'
  | 8  : RETURN 'ARRAY'
  | 9  : RETURN 'BEGIN'
  | 10 : RETURN 'BY'
  | 11 : RETURN 'CASE'
  | 12 : RETURN 'CONST'
  | 13 : RETURN 'DEFINITION'
  | 14 : RETURN 'DISPOSE'
  | 15 : RETURN 'DIV'
  | 16 : RETURN 'DO'
  | 17 : RETURN 'ELSE'
  | 18 : RETURN 'ELSIF'
  | 19 : RETURN 'END'
  | 20 : RETURN 'EXCEPT'
  | 21 : RETURN 'EXCEPTION'
  | 22 : RETURN 'EXIT'
  | 23 : RETURN 'FALSE'
  | 24 : RETURN 'FINALLY'
  | 25 : RETURN 'FOR'
  | 26 : RETURN 'FROM'
  | 27 : RETURN 'IF'
  | 28 : RETURN 'IMPLEMENTATION'
  | 29 : RETURN 'IMPORT'
  | 30 : RETURN 'IN'
  | 31 : RETURN 'IS'
  | 32 : RETURN 'LOOP'
  | 33 : RETURN 'MOD'
  | 34 : RETURN 'MODULE'
  | 35 : RETURN 'MONITOR'
  | 36 : RETURN 'NEW'
  | 37 : RETURN 'NONE'
  | 38 : RETURN 'NOT'
  | 39 : RETURN 'OF'
  | 40 : RETURN 'OPT'
  | 41 : RETURN 'OR'
  | 42 : RETURN 'OWN'
  | 43 : RETURN 'POOL'
  | 44 : RETURN 'PROCEDURE'
  | 45 : RETURN 'PTR'
  | 46 : RETURN 'RAISE'
  | 47 : RETURN 'RAISES'
  | 48 : RETURN 'RECORD'
  | 49 : RETURN 'RETURN'
  | 50 : RETURN 'SHARED'
  | 51 : RETURN 'SIGNAL'
  | 52 : RETURN 'SLICE'
  | 53 : RETURN 'SOME'
  | 54 : RETURN 'STATEFUL'
  | 55 : RETURN 'THEN'
  | 56 : RETURN 'THREAD'
  | 57 : RETURN 'TO'
  | 58 : RETURN 'TRANSFER'
  | 59 : RETURN 'TRUE'
  | 60 : RETURN 'TYPE'
  | 61 : RETURN 'UNSAFE'
  | 62 : RETURN 'VAR'
  | 63 : RETURN 'WAIT'
  | 64 : RETURN 'WHILE'
  (* appended after the alphabetical 58: codes are identifiers *)
  | 65 : RETURN 'RO'
  | 66 : RETURN 'GRID'
  | 67 : RETURN 'KEPT'
  | 68 : RETURN 'LINK'
  ELSE RETURN '?'
  END
END KwName ;

PROCEDURE KindName (k: I64) : STR =
BEGIN
  IF k >= KwFirst THEN
    IF k <= KwLast THEN RETURN KwName (k) END
  END ;
  CASE k OF
  | 0  : RETURN 'EOF'
  | 1  : RETURN 'Error'
  | 2  : RETURN 'Ident'
  | 3  : RETURN 'IntLit'
  | 4  : RETURN 'RealLit'
  | 5  : RETURN 'CharLit'
  | 6  : RETURN 'StrLit'
  | KAssign : RETURN 'Assign'
  | KEq : RETURN 'Eq'
  | KNeq : RETURN 'Neq'
  | KLt : RETURN 'Lt'
  | KLe : RETURN 'Le'
  | KGt : RETURN 'Gt'
  | KGe : RETURN 'Ge'
  | KPlus : RETURN 'Plus'
  | KMinus : RETURN 'Minus'
  | KStar : RETURN 'Star'
  | KSlash : RETURN 'Slash'
  | KPlusW : RETURN 'PlusWrap'
  | KMinusW : RETURN 'MinusWrap'
  | KStarW : RETURN 'StarWrap'
  | KLParen : RETURN 'LParen'
  | KRParen : RETURN 'RParen'
  | KLBrack : RETURN 'LBrack'
  | KRBrack : RETURN 'RBrack'
  | KComma : RETURN 'Comma'
  | KSemi : RETURN 'Semi'
  | KColon : RETURN 'Colon'
  | KDot : RETURN 'Dot'
  | KDotDot : RETURN 'DotDot'
  | KBar : RETURN 'Bar'
  | KCaret : RETURN 'Caret'
  ELSE RETURN '?'
  END
END KindName ;

(* the character the byte at i of u is, for an ASCII run (digits,
   names): 0C for a byte past ASCII, which no such run holds *)
PROCEDURE At (RO u: UTF ; i: I64) : CHAR =
VAR b : I64 ;
BEGIN
  b := I64 (Text.BAt (u, i)) ;
  IF b < 128 THEN RETURN Ascii[b] END ;
  RETURN 0C
END At ;

(* u, an identifier's octets, spells the keyword s *)
PROCEDURE SpellsKw (RO u: UTF ; RO s: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF Text.BLen (u) # LEN (s) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF At (u, i) # s[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END SpellsKw ;

PROCEDURE Lookup (RO s: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := KwFirst TO KwLast DO
    IF SpellsKw (s, KwName (i)) THEN RETURN i END
  END ;
  RETURN KIdent
END Lookup ;

PROCEDURE Init (VAR lx: Lexer ; RO src: STR) =
BEGIN
  InitUtf (lx, UTF (lx, src))
END Init ;

PROCEDURE InitUtf (VAR lx: Lexer ; RO src: UTF) =
VAR at : I64 ;
BEGIN
  lx.src := src ;
  lx.pos := 0 ;
  lx.line := 1 ;
  lx.col := 1 ;
  (* a first line beginning #! is the operating system's, naming the
     program that runs this file as a script (`#!/usr/bin/m9c --run`),
     and is not M9 (report par 2).  Skipped to its line end, not past
     it, so the newline is counted and every line keeps its number. *)
  (* a byte order mark (U+FEFF), which some editors write first, is
     not M9 either: skipped, the column stays 1.  It was refused as
     `unexpected character 0xff', its low byte (the review's F6) *)
  IF Text.BLen (src) >= 3 THEN
    at := 0 ;
    IF Text.NextCp (src, at) = 0FEFFC THEN lx.pos := at END
  END ;
  IF Text.BLen (src) >= lx.pos + 2 THEN
    IF At (src, lx.pos) = '#' AND At (src, lx.pos + 1) = '!' THEN
      WHILE lx.pos < Text.BLen (src) AND At (src, lx.pos) # 0AC DO
        lx.pos := lx.pos + 1
      END
    END
  END
END InitUtf ;

(* the character ahead characters on from pos (0 the one at pos); 0C
   past the end.  An ASCII byte is its character; past ASCII the
   character is decoded *)
PROCEDURE Peek (VAR lx: Lexer ; ahead: I64) : CHAR =
VAR
  at, k, b : I64 ;
  c : CHAR ;
BEGIN
  at := lx.pos ;
  k := ahead ;
  LOOP
    IF at >= Text.BLen (lx.src) THEN RETURN 0C END ;
    b := I64 (Text.BAt (lx.src, at)) ;
    IF b < 128 THEN
      c := Ascii[b] ;
      at := at + 1
    ELSE
      c := Text.NextCp (lx.src, at)
    END ;
    IF k = 0 THEN RETURN c END ;
    k := k - 1
  END
END Peek ;

PROCEDURE Advance (VAR lx: Lexer) =
VAR c : CHAR ;
BEGIN
  (* a line ends at LF, and at a CR no LF follows: a file with CR-only
     line ends was one line (the review's F6) *)
  IF Peek (lx, 0) = 0AC OR (Peek (lx, 0) = 0DC AND Peek (lx, 1) # 0AC) THEN
    lx.line := lx.line + 1 ;
    lx.col := 1
  ELSE
    lx.col := lx.col + 1
  END ;
  (* past the character: one byte, or the octets of one past ASCII *)
  IF lx.pos < Text.BLen (lx.src) AND I64 (Text.BAt (lx.src, lx.pos)) >= 128 THEN
    c := Text.NextCp (lx.src, lx.pos)
  ELSE
    lx.pos := lx.pos + 1
  END
END Advance ;

PROCEDURE IsLetter (c: CHAR) : BOOL =
BEGIN
  RETURN (c >= 'A' AND c <= 'Z') OR (c >= 'a' AND c <= 'z')
END IsLetter ;

PROCEDURE IsDigit (c: CHAR) : BOOL =
BEGIN
  RETURN c >= '0' AND c <= '9'
END IsDigit ;

PROCEDURE IsHexAny (c: CHAR) : BOOL =
BEGIN
  RETURN IsDigit (c) OR (c >= 'A' AND c <= 'F') OR
         (c >= 'a' AND c <= 'f')
END IsHexAny ;

PROCEDURE IsHexUp (c: CHAR) : BOOL =
BEGIN
  RETURN IsDigit (c) OR (c >= 'A' AND c <= 'F')
END IsHexUp ;

(* skip blanks and nested comments; bad=TRUE means an unterminated
   comment opened at eline:ecol *)
PROCEDURE Skip (VAR lx: Lexer ; VAR bad: BOOL ; VAR eline, ecol: I64) =
VAR
  depth, cstart : I64 ;
  c : CHAR ;
BEGIN
  bad := FALSE ;
  LOOP
    c := Peek (lx, 0) ;
    WHILE c = ' ' OR c = 09C OR c = 0DC OR c = 0AC DO
      Advance (lx) ;
      c := Peek (lx, 0)
    END ;
    IF Peek (lx, 0) = '(' AND Peek (lx, 1) = '*' THEN
      eline := lx.line ;
      ecol := lx.col ;
      cstart := lx.pos ;
      depth := 0 ;
      LOOP
        IF Peek (lx, 0) = '(' AND Peek (lx, 1) = '*' THEN
          depth := depth + 1 ;
          Advance (lx) ;
          Advance (lx)
        ELSIF Peek (lx, 0) = '*' AND Peek (lx, 1) = ')' THEN
          depth := depth - 1 ;
          Advance (lx) ;
          Advance (lx) ;
          IF depth = 0 THEN
            (* lx.line is still the line the closing delimiter
               sits on: advancing past it cannot have crossed a
               newline.  And note that this sentence may not name
               that delimiter literally -- comments NEST, so the two
               characters would close this one early.  That is a
               real constraint on writing M9 prose, and it cost 1900
               parse errors to rediscover. *)
            IF comOn THEN
              Note (eline, ecol, lx.line,
                    SLICE (lx.src, cstart, lx.pos - cstart))
            END ;
            EXIT
          END
        ELSIF Peek (lx, 0) = 0C THEN
          bad := TRUE ;
          RETURN
        ELSE
          Advance (lx)
        END
      END
    ELSE
      RETURN
    END
  END
END Skip ;

PROCEDURE Mk (VAR t: Token ; kind: I64 ; RO text: UTF ;
              line, col: I64) =
BEGIN
  t.kind := kind ;
  t.text := text ;
  t.line := line ;
  t.col := col
END Mk ;

PROCEDURE Punct (VAR lx: Lexer ; VAR t: Token ; c: CHAR ;
                 ln, cl: I64) : BOOL =
BEGIN
  (* two-char lookahead forms first: longest match *)
  IF c = ':' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '=' THEN Advance (lx) ; Mk (t, KAssign, ':=', ln, cl)
    ELSE Mk (t, KColon, ':', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '.' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '.' THEN Advance (lx) ; Mk (t, KDotDot, '..', ln, cl)
    ELSE Mk (t, KDot, '.', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '<' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '=' THEN Advance (lx) ; Mk (t, KLe, '<=', ln, cl)
    ELSE Mk (t, KLt, '<', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '>' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '=' THEN Advance (lx) ; Mk (t, KGe, '>=', ln, cl)
    ELSE Mk (t, KGt, '>', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '+' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '%' THEN Advance (lx) ; Mk (t, KPlusW, '+%', ln, cl)
    ELSE Mk (t, KPlus, '+', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '-' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '%' THEN Advance (lx) ; Mk (t, KMinusW, '-%', ln, cl)
    ELSE Mk (t, KMinus, '-', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '*' THEN
    Advance (lx) ;
    IF Peek (lx, 0) = '%' THEN Advance (lx) ; Mk (t, KStarW, '*%', ln, cl)
    ELSE Mk (t, KStar, '*', ln, cl) END ;
    RETURN TRUE
  ELSIF c = '=' THEN Advance (lx) ; Mk (t, KEq, '=', ln, cl) ; RETURN TRUE
  ELSIF c = '#' THEN Advance (lx) ; Mk (t, KNeq, '#', ln, cl) ; RETURN TRUE
  ELSIF c = '/' THEN Advance (lx) ; Mk (t, KSlash, '/', ln, cl) ; RETURN TRUE
  ELSIF c = '(' THEN Advance (lx) ; Mk (t, KLParen, '(', ln, cl) ; RETURN TRUE
  ELSIF c = ')' THEN Advance (lx) ; Mk (t, KRParen, ')', ln, cl) ; RETURN TRUE
  ELSIF c = '[' THEN Advance (lx) ; Mk (t, KLBrack, '[', ln, cl) ; RETURN TRUE
  ELSIF c = ']' THEN Advance (lx) ; Mk (t, KRBrack, ']', ln, cl) ; RETURN TRUE
  ELSIF c = ',' THEN Advance (lx) ; Mk (t, KComma, ',', ln, cl) ; RETURN TRUE
  ELSIF c = ';' THEN Advance (lx) ; Mk (t, KSemi, ';', ln, cl) ; RETURN TRUE
  ELSIF c = '|' THEN Advance (lx) ; Mk (t, KBar, '|', ln, cl) ; RETURN TRUE
  ELSIF c = '^' THEN Advance (lx) ; Mk (t, KCaret, '^', ln, cl) ; RETURN TRUE
  END ;
  RETURN FALSE
END Punct ;

(* ---- literals beyond 64 bits (2026-10-21, the compiler review's F1).
   A literal the lexer accepted was any length: `18446744073709551617'
   reached C as an integer constant too large for its type, which gcc
   truncates with a warning -- the program printed 1 -- and a real
   literal past F64's range became an infinity.  Refused here, in both
   lexers, where the digits are.  An integer literal is at most 64 bits,
   decimal or hex (one past MAX (I64) is a U64, which the checker
   types it as); a real must not round to infinity as an F64, held
   EXACTLY: it does when its value is at least 2^1024 - 2^970, whose
   309 digits are F64Top (written by Python's int, round to nearest
   even sends that value itself to infinity). ---- *)
CONST
  U64Top = '18446744073709551615' ;
  F64Top = '' ;

(* the digits of a run with its leading zeros dropped *)
PROCEDURE Significant (RO run: UTF ; from: I64) : I64 =
VAR i : I64 ;
BEGIN
  i := from ;
  WHILE i < Text.BLen (run) - 1 AND At (run, i) = '0' DO i := i + 1 END ;
  RETURN i
END Significant ;

(* a decimal integer literal past 64 bits *)
PROCEDURE IntPast64 (RO run: UTF) : BOOL =
VAR i, n, k : I64 ;
BEGIN
  i := Significant (run, 0) ;
  n := Text.BLen (run) - i ;
  IF n # LEN (U64Top) THEN RETURN n > LEN (U64Top) END ;
  FOR k := 0 TO n - 1 DO
    IF At (run, i + k) # U64Top[k] THEN RETURN At (run, i + k) > U64Top[k] END
  END ;
  RETURN FALSE
END IntPast64 ;

(* a real literal `ddd.ddd' with an optional exponent that rounds to
   infinity as an F64: its value is 0.D * 10^n with D its digits, the
   leading zeros moved into n, compared with F64Top digit by digit *)
PROCEDURE RealTooBig (RO run: UTF) : BOOL =
VAR
  i, m, e, nInt, lead, n, j : I64 ;
  neg : BOOL ;
BEGIN
  m := 0 ;
  WHILE m < Text.BLen (run) AND At (run, m) # 'e' AND At (run, m) # 'E' DO m := m + 1 END ;
  nInt := 0 ;
  WHILE nInt < m AND At (run, nInt) # '.' DO nInt := nInt + 1 END ;
  e := 0 ;
  IF m < Text.BLen (run) THEN
    i := m + 1 ;
    neg := FALSE ;
    IF At (run, i) = '+' THEN
      i := i + 1
    ELSIF At (run, i) = '-' THEN
      neg := TRUE ;
      i := i + 1
    END ;
    WHILE i < Text.BLen (run) DO
      (* capped: E999999999999999999 is past every bound, and its value
         must not overflow the counting *)
      IF e < 100000 THEN e := e * 10 + (ORD (At (run, i)) - 48) END ;
      i := i + 1
    END ;
    IF neg THEN e := -e END
  END ;
  lead := 0 ;
  i := 0 ;
  WHILE i < m AND (At (run, i) = '0' OR At (run, i) = '.') DO
    IF At (run, i) = '0' THEN lead := lead + 1 END ;
    i := i + 1
  END ;
  IF i = m THEN RETURN FALSE END ;             (* zero *)
  n := nInt - lead + e ;
  IF n # LEN (F64Top) THEN RETURN n > LEN (F64Top) END ;
  j := 0 ;
  WHILE i < m DO
    IF At (run, i) # '.' THEN
      IF j = LEN (F64Top) THEN RETURN TRUE END ;
      IF At (run, i) # F64Top[j] THEN RETURN At (run, i) > F64Top[j] END ;
      j := j + 1
    END ;
    i := i + 1
  END ;
  (* the literal's digits ran out first: it is below the threshold
     unless every digit of the threshold left is a zero *)
  WHILE j < LEN (F64Top) DO
    IF F64Top[j] # '0' THEN RETURN FALSE END ;
    j := j + 1
  END ;
  RETURN TRUE
END RealTooBig ;

PROCEDURE Number (VAR lx: Lexer ; VAR t: Token ; ln, cl, start: I64) =
VAR
  hasHexLetter, isReal : BOOL ;
  run : UTF ;
  i, cv, d : I64 ;
  c : CHAR ;
BEGIN
  IF Peek (lx, 0) = '0' AND Peek (lx, 1) = 'x' THEN
    Advance (lx) ;
    Advance (lx) ;
    IF NOT IsHexAny (Peek (lx, 0)) THEN
      Mk (t, KError, 'hex literal needs digits after 0x', ln, cl) ;
      RETURN
    END ;
    WHILE IsHexAny (Peek (lx, 0)) DO Advance (lx) END ;
    IF IsLetter (Peek (lx, 0)) THEN
      Mk (t, KError,
          'letter may not immediately follow a numeric literal', ln, cl) ;
      RETURN
    END ;
    run := SLICE (lx.src, start + 2, lx.pos - start - 2) ;
    IF Text.BLen (run) - Significant (run, 0) > 16 THEN
      Mk (t, KError, 'hex literal beyond 64 bits', ln, cl) ;
      RETURN
    END ;
    Mk (t, KInt, SLICE (lx.src, start, lx.pos - start), ln, cl) ;
    RETURN
  END ;

  (* digits and uppercase hex letters; classify by shape *)
  hasHexLetter := FALSE ;
  c := Peek (lx, 0) ;
  WHILE IsHexUp (c) DO
    IF NOT IsDigit (c) THEN hasHexLetter := TRUE END ;
    Advance (lx) ;
    c := Peek (lx, 0)
  END ;
  run := SLICE (lx.src, start, lx.pos - start) ;

  IF hasHexLetter THEN
    IF At (run, Text.BLen (run) - 1) # 'C' THEN
      Mk (t, KError,
          'malformed numeric literal; forms are 10, 0x1F, 1.5, 1.5e-3, 0AC',
          ln, cl) ;
      RETURN
    END ;
    IF IsLetter (Peek (lx, 0)) THEN
      Mk (t, KError,
          'letter may not immediately follow a numeric literal', ln, cl) ;
      RETURN
    END ;
    cv := 0 ;
    FOR i := 0 TO Text.BLen (run) - 2 DO
      c := At (run, i) ;
      IF IsDigit (c) THEN d := ORD (c) - 48 ELSE d := ORD (c) - 55 END ;
      cv := cv * 16 + d ;
      IF cv > 1114111 THEN
        Mk (t, KError,
            'char literal beyond Unicode scalar range (max 10FFFFC)',
            ln, cl) ;
        RETURN
      END
    END ;
    IF cv >= 55296 THEN
      IF cv <= 57343 THEN
        Mk (t, KError,
            'char literal is a surrogate code point, not a scalar',
            ln, cl) ;
        RETURN
      END
    END ;
    Mk (t, KChar, run, ln, cl) ;
    RETURN
  END ;

  isReal := FALSE ;
  (* the 1..5 case: dot followed by dot is DOTDOT, not a real *)
  IF Peek (lx, 0) = '.' AND Peek (lx, 1) # '.' THEN
    isReal := TRUE ;
    Advance (lx) ;
    IF NOT IsDigit (Peek (lx, 0)) THEN
      Mk (t, KError, 'digit required after decimal point', ln, cl) ;
      RETURN
    END ;
    WHILE IsDigit (Peek (lx, 0)) DO Advance (lx) END ;
    IF Peek (lx, 0) = 'e' OR Peek (lx, 0) = 'E' THEN
      Advance (lx) ;
      IF Peek (lx, 0) = '+' OR Peek (lx, 0) = '-' THEN Advance (lx) END ;
      IF NOT IsDigit (Peek (lx, 0)) THEN
        Mk (t, KError, 'digit required in exponent', ln, cl) ;
        RETURN
      END ;
      WHILE IsDigit (Peek (lx, 0)) DO Advance (lx) END
    END
  END ;
  IF IsLetter (Peek (lx, 0)) THEN
    Mk (t, KError,
        'letter may not immediately follow a numeric literal (char literal ends in C: 0AC; exponent needs a decimal point: 1.0e5)',
        ln, cl) ;
    RETURN
  END ;
  run := SLICE (lx.src, start, lx.pos - start) ;
  IF isReal THEN
    IF RealTooBig (run) THEN
      Mk (t, KError, 'real literal beyond F64 (it would be an infinity)', ln, cl)
    ELSE
      Mk (t, KReal, run, ln, cl)
    END
  ELSIF IntPast64 (run) THEN
    Mk (t, KError,
        'integer literal beyond 64 bits (the largest is 18446744073709551615, a U64; above MAX (I64) a literal is a U64)',
        ln, cl)
  ELSE
    Mk (t, KInt, run, ln, cl)
  END
END Number ;

PROCEDURE Next (VAR lx: Lexer ; VAR t: Token) =
VAR
  bad : BOOL ;
  ln, cl, start, n, nd, p, k : I64 ;
  c, q : CHAR ;
  msg : UTF ;
BEGIN
  Skip (lx, bad, ln, cl) ;
  IF bad THEN
    Mk (t, KError, 'unterminated comment (opened here)', ln, cl) ;
    RETURN
  END ;

  ln := lx.line ;
  cl := lx.col ;
  start := lx.pos ;
  c := Peek (lx, 0) ;

  IF c = 0C THEN
    (* Peek answers 0C past the end; a NUL before it is a character,
       and ended the source without a word (the review's F6) *)
    IF lx.pos < Text.BLen (lx.src) THEN
      Advance (lx) ;
      Mk (t, KError, 'unexpected character 0x00', ln, cl) ;
      RETURN
    END ;
    Mk (t, KEOF, '', ln, cl) ;
    RETURN
  END ;

  IF IsLetter (c) THEN
    WHILE IsLetter (Peek (lx, 0)) OR IsDigit (Peek (lx, 0)) DO
      Advance (lx)
    END ;
    Mk (t, KIdent, SLICE (lx.src, start, lx.pos - start), ln, cl) ;
    t.kind := Lookup (t.text) ;
    IF Peek (lx, 0) = '_' THEN
      Mk (t, KError, 'underscore is not part of an identifier in M9',
          lx.line, lx.col)
    END ;
    RETURN
  END ;

  IF IsDigit (c) THEN
    Number (lx, t, ln, cl, start) ;
    RETURN
  END ;

  IF c = "'" OR c = '"' THEN
    q := c ;
    Advance (lx) ;
    start := lx.pos ;
    WHILE Peek (lx, 0) # q AND Peek (lx, 0) # 0C AND
          Peek (lx, 0) # 0AC DO
      Advance (lx)
    END ;
    IF Peek (lx, 0) # q THEN
      Mk (t, KError, 'unterminated string', ln, cl) ;
      RETURN
    END ;
    Mk (t, KStr, SLICE (lx.src, start, lx.pos - start), ln, cl) ;
    Advance (lx) ;
    RETURN
  END ;

  IF Punct (lx, t, c, ln, cl) THEN RETURN END ;

  (* 'unexpected character 0xNN', composed as a UTF in the frame and
     adopted with the token (it was a module buffer until 2026-10-23,
     the reason Lex was STATEFUL then) *)
  Advance (lx) ;
  n := ORD (Text.NextCp (lx.src, start)) ;
  IF n < 128 THEN
    msg := 'unexpected character 0x' ;
    (* the digit as the octet it is (ASCII): the same both sides of the
       UTF switch, where a subscript of a string CONST is refused *)
    msg := msg + Text.BChar (HexMsg, (n DIV 16) MOD 16) + Text.BChar (HexMsg, n MOD 16)
  ELSE
    (* past ASCII the scalar, U+XXXX with at least four digits: its
       low byte named another character (U+FEFF read 0xff) *)
    msg := 'unexpected character U+' ;
    nd := 4 ;
    IF n >= 65536 THEN nd := 5 END ;
    IF n >= 1048576 THEN nd := 6 END ;
    p := 1 ;
    FOR k := 2 TO nd DO p := p * 16 END ;
    WHILE p > 0 DO
      msg := msg + Text.BChar (HexUp, (n DIV p) MOD 16) ;
      p := p DIV 16
    END
  END ;
  Mk (t, KError, msg, ln, cl)
END Next ;

END Lex.
