STATEFUL DEFINITION MODULE Plot ;

(* matplotlib-styled SVG plots, restated from the M2 stack's Plot.mod.
   STATEFUL is the definition telling the truth: the line figure is a
   module-level builder (ClearFigure / AddLine / Render), exactly the
   hidden state the M2 version kept without saying so.  Number
   formatting goes through the SAME fmt_g C shim the oracle used, so
   the emitted digits are identical by construction, not by hope.
   Render answers the SVG as a slice; writing files is the caller's
   business (M9 has no file module yet, and the OpenApi precedent
   says a document is a value).                                      *)

IMPORT Mat ;

TYPE
  Cmap = CASE RECORD
  | Viridis | Coolwarm
  END ;

PROCEDURE ClearFigure () ;
  (* discards every series added so far and starts an empty figure.

     This module is STATEFUL -- the figure being built IS module
     state, and the definition says so -- so a second plot in the
     same program must start with this call or it inherits the
     first one's lines.  One figure at a time is the price of the
     state, and the alternative is a figure handle nobody asked
     for.                                                          *)

PROCEDURE AddLine (RO xs: SLICE OF F64 ;
                   RO ys: SLICE OF F64 ;
                   colorIdx: I64 ;
                   RO KEPT label: STR) ;
  (* up to 4 series, up to 8192 points; colorIdx 0..3 = matplotlib
     C0..C3; NaN values lift the pen, as mpl does.  The label slice
     is retained until Render -- ledger material, like AddRoute.     *)

PROCEDURE SetDots (RO KEPT xs: SLICE OF F64 ; RO KEPT ys: SLICE OF F64) ;
  (* one scatter layer, drawn UNDER the lines: every point a small
     black circle, NaN points skipped, no per-series cap -- the
     layer is for raw observations behind their summary lines.  The
     slices are RETAINED until Render, not copied (the AddLine and
     AddRoute precedent), so the caller's arrays must outlive it.
     ClearFigure drops the layer with everything else.              *)

CONST
  (* bar style codes.  Plain I64 constants, chosen when a payload-less
     variant constructor could not be written from another module.
     That generator gap closed 2026-09-15; the codes stay because
     every caller spells them and a named constant reads the same at
     a call site.  Ledgered in `docs/p3-ledger.md` as a workaround
     left standing. *)
  BarVertical   = 0 ;   (* bars rise from the x axis        *)
  BarHorizontal = 1 ;   (* bars run right from the y axis   *)
  BarGrouped    = 0 ;   (* series side by side in each slot *)
  BarStacked    = 1 ;   (* series piled on one another      *)
  BarAtValue    = 0 ;   (* a bar is CENTRED on its position *)
  BarDiscrete   = 1 ;   (* positions ignored: slots 0, 1, 2 *)

PROCEDURE AddBars (RO at: SLICE OF F64 ;
                   RO v: SLICE OF F64 ;
                   colorIdx: I64 ;
                   RO KEPT label: STR) ;
  (* one bar series: up to 4 of them, up to 8192 bars each, drawn
     UNDER any lines and dots.

       at -- where each bar sits on the CATEGORY axis (x for vertical
             bars, y for horizontal ones).  With BarDiscrete the
             values are ignored and the bars take slots 0, 1, 2 ...
       v  -- the bar's length on the VALUE axis.  Negative is legal
             and draws the other way from the baseline; NaN skips
             the bar, as it lifts the pen in AddLine.

     Bars and lines can share a figure: the ranges cover both, and a
     bar series always includes its baseline so a bar is never drawn
     hanging in the air.  colorIdx is the C0..C3 palette, unless
     SetBarColor names something else.                              *)

PROCEDURE SetBarStyle (dir: I64 ; mode: I64 ; place: I64 ;
                       filled: BOOL ; width: F64) ;
  (* how every bar series is drawn.  The defaults are what a caller
     who never calls this gets: vertical, grouped, at its value,
     filled, width 0.8.

       dir   -- BarVertical or BarHorizontal
       mode  -- BarGrouped or BarStacked.  Stacking sums the series
                in the order they were added; a stack of one is a
                plain bar, so grouped and stacked agree for one
                series and that is the check the gate makes.
       place -- BarAtValue centres each bar on its own position and
                sizes the slot from the CLOSEST pair of positions,
                so an irregular axis does not overlap; BarDiscrete
                puts them at 0, 1, 2 ... which is what a category
                chart wants and what the reader means by "bar 3".
       width -- the fraction of a slot the bars occupy, 0 < width
                <= 1.  Grouped series divide that between them.   *)

PROCEDURE SetBarErrors (series: I64 ; RO KEPT err: SLICE OF F64) ;
  (* symmetric error bars for one series: a whisker of +/- err[i]
     on the VALUE axis with a cap at each end, drawn over the bars.
     A NaN or negative entry draws nothing for that bar, which is
     how "no uncertainty for this one" is said.  The slice is
     RETAINED until Render, like AddLine's label and SetDots's
     points.                                                       *)

PROCEDURE SetBarColor (series: I64 ; RO KEPT hex: STR) ;
  (* override the palette for one series with an SVG colour --
     '#cc3311', 'darkgreen'.  It is written into the document
     verbatim, so it is the caller's business that it is a colour;
     an empty string restores the palette entry.                   *)

PROCEDURE Viridis () : Cmap ;
PROCEDURE Coolwarm () : Cmap ;
  (* the colour maps as PROCEDURES, written when a payload-less
     variant constructor from ANOTHER module type-checked and the
     generator refused it (met by RenderHeat's first caller outside
     this file).  Since 2026-09-15 `Plot.Cmap.Viridis` works from
     anywhere; these two remain as the shorter spelling their callers
     use, and answer exactly that constructor. *)

PROCEDURE SetLineColor (series: I64 ; RO KEPT hex: STR) ;
  (* the line twin of SetBarColor: override one line series' palette
     entry with an SVG colour -- 'black', '#cc3311'.  Written into
     the document verbatim, so it is the caller's business that it is
     a colour; an empty string restores the C0..C3 entry.  Added
     because the palette has no black and a measured series wants
     one (Alex, 2026-09-01).                                        *)

PROCEDURE SetLogX (on: BOOL) ;
PROCEDURE SetLogY (on: BOOL) ;
  (* a base-10 logarithmic axis, for lines, dots and bars alike.
     Ticks land on the decades rather than on NiceStep's round
     numbers, and are labelled as the values themselves (100, not
     10^2), which is what a reader of a small chart wants.

     A value that cannot be shown on a log axis -- zero or negative
     -- is SKIPPED, the same treatment NaN gets, rather than clamped
     to something that would draw a line to a place the data does
     not go.  A bar on a log value axis starts at the axis floor
     instead of at zero, because zero is not on the axis.

     ClearFigure turns both off again: a second figure in the same
     program starts linear, like it starts empty.                  *)

PROCEDURE Render (RO title: STR ;
                  RO xlabel: STR ;
                  RO ylabel: STR) : STR
  RAISES ValueRange ;

PROCEDURE RenderHeat (RO title: STR ;
                      m: PTR Mat.Matrix ;
                      cmap: Cmap ;
                      symmetric: BOOL) : STR
  RAISES ValueRange ;
  (* symmetric centres the scale on zero, for anomaly fields;
     NaN cells render white                                          *)

PROCEDURE SetHeatRange (lo: F64 ; hi: F64) ;
  (* pin the next RenderHeat's colour range to [lo, hi], overriding
     both the data min/max and symmetric; ClearFigure clears it.  For
     a rounded, stable scale that a caller controls.                 *)

END Plot.


UNSAFE DEFINITION MODULE FOR "C" cfmt ;

PROCEDURE FmtG = "fmt_g" (dst: C.MutPtr ; v: C.Double) : C.Int
  [REENTRANT] ;
  (* sprintf "%.4g" -- the oracle's exact formatter, shared          *)

END cfmt.


UNSAFE IMPLEMENTATION MODULE Plot ;

(* UNSAFE for one reason: ADR at the fmt_g boundary.                 *)

FROM cfmt IMPORT FmtG ;
IMPORT Mat ;
IMPORT DynStr ;

VAR
  heatLo, heatHi : F64 ;
  heatFixed : BOOL ;

CONST
  MaxSer  = 4 ;
  MaxPts  = 8192 ;        (* was 1024: a year of hourly-selected obs
                             at one station is ~1 700 rows, and the
                             cap cut the station series at day 230
                             (2026-09-15) *)
  FigW    = 720.0 ;
  FigH    = 440.0 ;
  MLeft   = 70.0 ;
  MRight  = 25.0 ;
  MTop    = 45.0 ;
  MBottom = 55.0 ;
  HexDigits = '0123456789abcdef' ;
  Cap = 3.0 ;            (* half the error whisker's cap, in pixels.
                            Module level because the generator
                            refuses a CONST declared inside a
                            procedure -- which the checker accepts,
                            the same softness the reversed NEW had *)

VAR
  serX, serY : ARRAY 32768 OF F64 ;      (* MaxSer x MaxPts, flat *)
  serN, serCol : ARRAY 4 OF I64 ;
  serLbl : ARRAY 4 OF STR ;
  nSer : I64 ;

  (* BARS.  Same shape as the line series -- flat MaxSer x MaxPts --
     so the two layers are read the same way.  Everything here is
     zero or FALSE until a caller asks for it, which is what keeps a
     figure without bars emitting exactly the bytes it always did. *)
  barAt, barV : ARRAY 32768 OF F64 ;
  barN, barCol : ARRAY 4 OF I64 ;
  barLbl, barHex : ARRAY 4 OF STR ;
  serHex : ARRAY 4 OF STR ;
  barErr : ARRAY 4 OF SLICE OF F64 ;     (* retained, see the def *)
  barHasErr : ARRAY 4 OF BOOL ;
  nBar : I64 ;
  barDir, barMode, barPlace : I64 ;
  barFilled : BOOL ;
  barWidth : F64 ;
  logX, logY : BOOL ;

PROCEDURE IsNaN (v: F64) : BOOL =
BEGIN
  RETURN NOT (v = v)
END IsNaN ;

PROCEDURE EmitR (VAR d: PTR DynStr.DString ; v: F64)
  RAISES ValueRange =
VAR
  buf : ARRAY 32 OF BYTE ;
  n, i : I64 ;
BEGIN
  n := I64 (FmtG (ADR (buf), C.Double (v))) ;
  FOR i := 0 TO n - 1 DO
    DynStr.AppendChar (d, CHR (ORD (buf[i])))
  END
END EmitR ;

PROCEDURE EmitColor (VAR d: PTR DynStr.DString ;
                     idx: I64) =
BEGIN
  CASE idx OF
  | 0 : DynStr.Append (d, '#1f77b4')
  | 1 : DynStr.Append (d, '#ff7f0e')
  | 2 : DynStr.Append (d, '#2ca02c')
  | 3 : DynStr.Append (d, '#d62728')
  ELSE DynStr.Append (d, '#333333')
  END
END EmitColor ;

PROCEDURE CmapPt (cmap: Cmap ; i: I64 ; VAR r, g, b: I64) =
BEGIN
  CASE cmap OF
  | Viridis :
      CASE i OF
      | 0 : r := 68 ; g := 1 ; b := 84
      | 1 : r := 59 ; g := 82 ; b := 139
      | 2 : r := 33 ; g := 145 ; b := 140
      | 3 : r := 94 ; g := 201 ; b := 98
      ELSE r := 253 ; g := 231 ; b := 37
      END
  | Coolwarm :
      CASE i OF
      | 0 : r := 59 ; g := 76 ; b := 192
      | 1 : r := 124 ; g := 159 ; b := 249
      | 2 : r := 221 ; g := 221 ; b := 221
      | 3 : r := 245 ; g := 156 ; b := 125
      ELSE r := 180 ; g := 4 ; b := 38
      END
  END
END CmapPt ;

PROCEDURE EmitHexByte (VAR d: PTR DynStr.DString ;
                       v: I64) =
BEGIN
  DynStr.AppendChar (d, HexDigits[v DIV 16]) ;
  DynStr.AppendChar (d, HexDigits[v MOD 16])
END EmitHexByte ;

PROCEDURE EmitCmap (VAR d: PTR DynStr.DString ;
                    cmap: Cmap ; t: F64)
  RAISES ValueRange =
VAR
  seg, r0, g0, b0, r1, g1, b1 : I64 ;
  f : F64 ;
BEGIN
  IF t < 0.0 THEN t := 0.0 END ;
  IF t > 1.0 THEN t := 1.0 END ;
  f := t * 4.0 ;
  seg := I64 (f) ;
  IF seg > 3 THEN seg := 3 END ;
  f := f - F64 (seg) ;
  CmapPt (cmap, seg, r0, g0, b0) ;
  CmapPt (cmap, seg + 1, r1, g1, b1) ;
  DynStr.AppendChar (d, '#') ;
  EmitHexByte (d, I64 (F64 (r0) + f * (F64 (r1) - F64 (r0)))) ;
  EmitHexByte (d, I64 (F64 (g0) + f * (F64 (g1) - F64 (g0)))) ;
  EmitHexByte (d, I64 (F64 (b0) + f * (F64 (b1) - F64 (b0))))
END EmitCmap ;

(* Heckbert's nice tick spacing, transcribed *)
PROCEDURE NiceStep (span: F64) : F64 =
VAR mag, s : F64 ;
BEGIN
  s := span / 5.0 ;
  mag := 1.0 ;
  WHILE mag < s DO mag := mag * 10.0 END ;
  WHILE mag / 10.0 >= s DO mag := mag / 10.0 END ;
  IF s <= mag / 5.0 THEN RETURN mag / 5.0
  ELSIF s <= mag / 2.0 THEN RETURN mag / 2.0
  ELSE RETURN mag END
END NiceStep ;

PROCEDURE FloorMul (v, step: F64) : F64
  RAISES ValueRange =
VAR
  k : I64 ;
  av : F64 ;
BEGIN
  av := v ;
  IF av < 0.0 THEN av := -av END ;
  k := I64 (av / step) ;
  IF v >= 0.0 THEN RETURN step * F64 (k)
  ELSE RETURN -(step * F64 (k + 1)) END
END FloorMul ;

PROCEDURE PXof (x, xmin, xmax: F64) : F64 =
BEGIN
  RETURN MLeft + (x - xmin) / (xmax - xmin) * (FigW - MLeft - MRight)
END PXof ;

PROCEDURE PYof (y, ymin, ymax: F64) : F64 =
BEGIN
  RETURN FigH - MBottom - (y - ymin) / (ymax - ymin) * (FigH - MTop - MBottom)
END PYof ;

PROCEDURE SetHeatRange (lo: F64 ; hi: F64) =
BEGIN
  IF lo < hi THEN
    heatLo := lo ;
    heatHi := hi ;
    heatFixed := TRUE
  END
END SetHeatRange ;

PROCEDURE ClearFigure () =
VAR i : I64 ;
BEGIN
  nSer := 0 ;
  dotN := 0 ;
  nBar := 0 ;
  FOR i := 0 TO MaxSer - 1 DO
    barHasErr[i] := FALSE ;
    barHex[i] := '' ;
    serHex[i] := ''
  END ;
  (* the style defaults ARE the documented ones, set here rather than
     at declaration so a second figure starts where the first did *)
  barDir := BarVertical ;
  barMode := BarGrouped ;
  barPlace := BarAtValue ;
  barFilled := TRUE ;
  barWidth := 0.8 ;
  logX := FALSE ;
  logY := FALSE ;
  heatFixed := FALSE
END ClearFigure ;

(* base-10 log, by the identity log10 x = ln x / ln 10, because Math
   is not imported here and this is the only place a log is wanted.
   Only ever called on a positive value: Loggable is the guard. *)
PROCEDURE Log10 (v: F64) : F64 =
VAR y, t, num, den : F64 ; k : I64 ;
BEGIN
  (* ln by the atanh series on (v-1)/(v+1), after scaling v into
     [1, 10) by counting powers of ten -- twenty terms is far more
     than an SVG coordinate can show *)
  k := 0 ;
  y := v ;
  WHILE y >= 10.0 DO y := y / 10.0 ; k := k + 1 END ;
  WHILE y < 1.0 DO y := y * 10.0 ; k := k - 1 END ;
  t := (y - 1.0) / (y + 1.0) ;
  num := t ;
  den := 1.0 ;
  y := 0.0 ;
  WHILE den < 40.0 DO
    y := y + num / den ;
    num := num * t * t ;
    den := den + 2.0
  END ;
  RETURN F64 (k) + 2.0 * y / 2.302585092994046
END Log10 ;

(* a value this axis can show: everything, unless the axis is
   logarithmic and the value is not positive *)
PROCEDURE Loggable (v: F64 ; lg: BOOL) : BOOL =
BEGIN
  IF IsNaN (v) THEN RETURN FALSE END ;
  IF lg THEN RETURN v > 0.0 END ;
  RETURN TRUE
END Loggable ;

(* the axis coordinate of a value: itself, or its logarithm.  With
   the axis linear this is the identity, which is what lets every
   existing figure emit the bytes it always did. *)
PROCEDURE Axis (v: F64 ; lg: BOOL) : F64 =
BEGIN
  IF lg THEN RETURN Log10 (v) END ;
  RETURN v
END Axis ;

PROCEDURE SetLogX (on: BOOL) =
BEGIN
  logX := on
END SetLogX ;

PROCEDURE SetLogY (on: BOOL) =
BEGIN
  logY := on
END SetLogY ;

PROCEDURE SetBarStyle (dir: I64 ; mode: I64 ; place: I64 ;
                       filled: BOOL ; width: F64) =
BEGIN
  barDir := dir ;
  barMode := mode ;
  barPlace := place ;
  barFilled := filled ;
  (* a width outside (0, 1] is a caller's slip, and silently drawing
     bars that overlap or vanish would hide it; the documented range
     is kept instead *)
  IF width > 0.0 THEN
    IF width <= 1.0 THEN barWidth := width END
  END
END SetBarStyle ;

PROCEDURE SetBarErrors (series: I64 ; RO KEPT err: SLICE OF F64) =
BEGIN
  IF series < 0 OR series >= MaxSer THEN RETURN END ;
  barErr[series] := err ;
  barHasErr[series] := TRUE
END SetBarErrors ;

PROCEDURE SetBarColor (series: I64 ; RO KEPT hex: STR) =
BEGIN
  IF series < 0 OR series >= MaxSer THEN RETURN END ;
  barHex[series] := hex
END SetBarColor ;

PROCEDURE Viridis () : Cmap =
BEGIN
  RETURN Cmap.Viridis
END Viridis ;

PROCEDURE Coolwarm () : Cmap =
BEGIN
  RETURN Cmap.Coolwarm
END Coolwarm ;

PROCEDURE SetLineColor (series: I64 ; RO KEPT hex: STR) =
BEGIN
  IF series < 0 OR series >= MaxSer THEN RETURN END ;
  serHex[series] := hex
END SetLineColor ;

PROCEDURE EmitLineColor (VAR d: PTR DynStr.DString ;
                         s: I64) =
  (* the caller's colour if one was named, else the palette.  Kept
     as one procedure so the line and its legend swatch cannot
     disagree -- they are two call sites of the same question. *)
BEGIN
  IF LEN (serHex[s]) > 0 THEN
    DynStr.Append (d, serHex[s])
  ELSE
    EmitColor (d, serCol[s])
  END
END EmitLineColor ;

PROCEDURE AddBars (RO at: SLICE OF F64 ;
                   RO v: SLICE OF F64 ;
                   colorIdx: I64 ;
                   RO KEPT label: STR) =
VAR n, i : I64 ;
BEGIN
  IF nBar >= MaxSer THEN RETURN END ;
  n := LEN (at) ;
  IF LEN (v) < n THEN n := LEN (v) END ;
  IF n > MaxPts THEN n := MaxPts END ;
  FOR i := 0 TO n - 1 DO
    barAt[nBar * MaxPts + i] := at[i] ;
    barV[nBar * MaxPts + i] := v[i]
  END ;
  barN[nBar] := n ;
  barCol[nBar] := colorIdx ;
  barLbl[nBar] := label ;
  nBar := nBar + 1
END AddBars ;

(* a bar series' colour: the caller's own if SetBarColor named one,
   and otherwise the C0..C3 palette the lines use *)
PROCEDURE EmitBarColor (VAR d: PTR DynStr.DString ;
                        s: I64) =
BEGIN
  IF LEN (barHex[s]) > 0 THEN
    DynStr.Append (d, barHex[s])
  ELSE
    EmitColor (d, barCol[s])
  END
END EmitBarColor ;

(* an error whisker: the line, then a cap across each end.  `horiz`
   says which way the caps turn, which is the only difference
   between the two directions. *)
PROCEDURE EmitWhisker (VAR d: PTR DynStr.DString ;
                       x0, y0, x1, y1: F64 ; horiz: BOOL)
  RAISES ValueRange =
BEGIN
  DynStr.Append (d, '<path d="M ') ;
  EmitR (d, x0) ; DynStr.AppendChar (d, ' ') ;
  EmitR (d, y0) ; DynStr.Append (d, ' L ') ;
  EmitR (d, x1) ; DynStr.AppendChar (d, ' ') ;
  EmitR (d, y1) ;
  IF horiz THEN
    DynStr.Append (d, ' M ') ;
    EmitR (d, x0) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y0 - Cap) ; DynStr.Append (d, ' L ') ;
    EmitR (d, x0) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y0 + Cap) ;
    DynStr.Append (d, ' M ') ;
    EmitR (d, x1) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y1 - Cap) ; DynStr.Append (d, ' L ') ;
    EmitR (d, x1) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y1 + Cap)
  ELSE
    DynStr.Append (d, ' M ') ;
    EmitR (d, x0 - Cap) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y0) ; DynStr.Append (d, ' L ') ;
    EmitR (d, x0 + Cap) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y0) ;
    DynStr.Append (d, ' M ') ;
    EmitR (d, x1 - Cap) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y1) ; DynStr.Append (d, ' L ') ;
    EmitR (d, x1 + Cap) ; DynStr.AppendChar (d, ' ') ;
    EmitR (d, y1)
  END ;
  DynStr.Append (d, '" fill="none" stroke="#222" stroke-width="1.2"/>')
END EmitWhisker ;

(* the decade at or below an axis coordinate, which is already a
   logarithm: the first tick a log axis wants *)
PROCEDURE DecadeFloor (v: F64) : F64 RAISES ValueRange =
VAR k : F64 ;
BEGIN
  k := F64 (I64 (v)) ;
  IF k > v THEN k := k - 1.0 END ;
  RETURN k
END DecadeFloor ;

(* back from an axis coordinate to the value it stands for, so a log
   axis can be LABELLED 100 rather than 2 *)
PROCEDURE Pow10 (k: F64) : F64 RAISES ValueRange =
VAR r : F64 ; n : I64 ;
BEGIN
  r := 1.0 ;
  n := I64 (k) ;
  WHILE n > 0 DO r := r * 10.0 ; n := n - 1 END ;
  WHILE n < 0 DO r := r / 10.0 ; n := n + 1 END ;
  RETURN r
END Pow10 ;

(* grow the two ranges to hold a bar's category span and value span.
   VAR on all five because it is the range being extended, and the
   caller passes them in whichever order the bar direction means:
   that swap is the whole of what BarHorizontal costs. *)
PROCEDURE ExtendRange (VAR cmin: F64 ; VAR cmax: F64 ;
                       VAR vmin: F64 ; VAR vmax: F64 ;
                       VAR seen: BOOL ;
                       c0, c1, v0, v1: F64) =
BEGIN
  IF NOT seen THEN
    cmin := c0 ; cmax := c1 ;
    vmin := v0 ; vmax := v1 ;
    seen := TRUE ;
    RETURN
  END ;
  IF c0 < cmin THEN cmin := c0 END ;
  IF c1 > cmax THEN cmax := c1 END ;
  IF v0 < vmin THEN vmin := v0 END ;
  IF v1 > vmax THEN vmax := v1 END
END ExtendRange ;

(* where bar i of this series sits on the category axis, before the
   grouping offset: its own position, or its index *)
PROCEDURE BarPos (s: I64 ; i: I64) : F64 =
BEGIN
  IF barPlace = BarDiscrete THEN RETURN F64 (i) END ;
  RETURN barAt[s * MaxPts + i]
END BarPos ;

(* the width of one slot on the category axis: 1 for discrete bars,
   and otherwise the CLOSEST pair of positions anywhere in the
   figure, so the widest bar that cannot overlap is the one drawn *)
PROCEDURE SlotWidth () : F64 =
VAR s, i : I64 ; gap, w, a, b : F64 ; seen : BOOL ;
BEGIN
  IF barPlace = BarDiscrete THEN RETURN 1.0 END ;
  seen := FALSE ;
  gap := 1.0 ;
  FOR s := 0 TO nBar - 1 DO
    FOR i := 1 TO barN[s] - 1 DO
      a := barAt[s * MaxPts + i - 1] ;
      b := barAt[s * MaxPts + i] ;
      IF NOT (IsNaN (a) OR IsNaN (b)) THEN
        w := b - a ;
        IF w < 0.0 THEN w := 0.0 - w END ;
        IF w > 0.0 THEN
          IF NOT seen THEN gap := w ; seen := TRUE
          ELSIF w < gap THEN gap := w END
        END
      END
    END
  END ;
  RETURN gap
END SlotWidth ;

(* the value a stacked bar starts from: the sum of the series below
   it at the same index, or the baseline for the first *)
PROCEDURE StackBase (s: I64 ; i: I64) : F64 =
VAR k : I64 ; acc, v : F64 ;
BEGIN
  acc := 0.0 ;
  IF barMode # BarStacked THEN RETURN acc END ;
  FOR k := 0 TO s - 1 DO
    IF i < barN[k] THEN
      v := barV[k * MaxPts + i] ;
      IF NOT IsNaN (v) THEN acc := acc + v END
    END
  END ;
  RETURN acc
END StackBase ;

VAR
  dotX, dotY : SLICE OF F64 ;   (* retained caller slices, see def *)
  dotN : I64 ;

PROCEDURE SetDots (RO KEPT xs: SLICE OF F64 ; RO KEPT ys: SLICE OF F64) =
BEGIN
  dotX := xs ;
  dotY := ys ;
  dotN := LEN (xs) ;
  IF LEN (ys) < dotN THEN dotN := LEN (ys) END
END SetDots ;

PROCEDURE AddLine (RO xs: SLICE OF F64 ;
                   RO ys: SLICE OF F64 ;
                   colorIdx: I64 ;
                   RO KEPT label: STR) =
VAR n, i : I64 ;
BEGIN
  IF nSer >= MaxSer THEN RETURN END ;
  n := LEN (xs) ;
  IF n > MaxPts THEN n := MaxPts END ;
  FOR i := 0 TO n - 1 DO
    serX[nSer * MaxPts + i] := xs[i] ;
    serY[nSer * MaxPts + i] := ys[i]
  END ;
  serN[nSer] := n ;
  serCol[nSer] := colorIdx ;
  serLbl[nSer] := label ;
  nSer := nSer + 1
END AddLine ;

PROCEDURE Render (RO title: STR ;
                  RO xlabel: STR ;
                  RO ylabel: STR) : STR
  RAISES ValueRange =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  s, i : I64 ;
  xmin, xmax, ymin, ymax, pad, step, t, px, py, ly, v, w : F64 ;
  slot, half, grp, off, base, top, e, c0, c1, v0, v1 : F64 ;
  seen, pen : BOOL ;
BEGIN
  IF nSer = 0 AND nBar = 0 THEN RETURN '' END ;
  seen := FALSE ;
  xmin := 0.0 ; xmax := 1.0 ; ymin := 0.0 ; ymax := 1.0 ;
  FOR s := 0 TO nSer - 1 DO
    FOR i := 0 TO serN[s] - 1 DO
      v := serX[s * MaxPts + i] ;
      w := serY[s * MaxPts + i] ;
      IF Loggable (v, logX) AND Loggable (w, logY) THEN
        v := Axis (v, logX) ;
        w := Axis (w, logY) ;
        IF NOT seen THEN
          xmin := v ; xmax := v ;
          ymin := w ; ymax := w ;
          seen := TRUE
        ELSE
          IF v < xmin THEN xmin := v END ;
          IF v > xmax THEN xmax := v END ;
          IF w < ymin THEN ymin := w END ;
          IF w > ymax THEN ymax := w END
        END
      END
    END
  END ;
  FOR i := 0 TO dotN - 1 DO
    v := dotX[i] ;
    w := dotY[i] ;
    IF Loggable (v, logX) AND Loggable (w, logY) THEN
      v := Axis (v, logX) ;
      w := Axis (w, logY) ;
      IF NOT seen THEN
        xmin := v ; xmax := v ;
        ymin := w ; ymax := w ;
        seen := TRUE
      ELSE
        IF v < xmin THEN xmin := v END ;
        IF v > xmax THEN xmax := v END ;
        IF w < ymin THEN ymin := w END ;
        IF w > ymax THEN ymax := w END
      END
    END
  END ;
  (* THE BARS' CONTRIBUTION, and only when there are bars, so a
     line-only figure computes exactly the range it always did.  A
     bar series brings three things a line does not: the slot it
     occupies on the category axis (half a slot either side of the
     outermost bar), its BASELINE -- a bar hanging in the air with
     its foot off the chart is a lie about its own length -- and,
     where they are asked for, the ends of its error whiskers. *)
  IF nBar > 0 THEN
    slot := SlotWidth () ;
    half := slot * 0.5 ;
    FOR s := 0 TO nBar - 1 DO
      FOR i := 0 TO barN[s] - 1 DO
        v := BarPos (s, i) ;
        w := barV[s * MaxPts + i] ;
        IF NOT IsNaN (w) THEN
          base := StackBase (s, i) ;
          top := base + w ;
          IF barHasErr[s] THEN
            IF i < LEN (barErr[s]) THEN
              e := barErr[s][i] ;
              IF NOT IsNaN (e) THEN
                IF e > 0.0 THEN top := top + e END
              END
            END
          END ;
          (* the category extent and the value extent, then mapped
             onto x and y by the direction *)
          IF barDir = BarHorizontal THEN
            c0 := Axis (v - half, logY) ; c1 := Axis (v + half, logY) ;
            IF logX AND base <= 0.0 THEN base := top / 100.0 END ;
            v0 := Axis (base, logX) ; v1 := Axis (top, logX)
          ELSE
            c0 := Axis (v - half, logX) ; c1 := Axis (v + half, logX) ;
            IF logY AND base <= 0.0 THEN base := top / 100.0 END ;
            v0 := Axis (base, logY) ; v1 := Axis (top, logY)
          END ;
          IF v1 < v0 THEN v0 := top ; v1 := base END ;
          IF barDir = BarHorizontal THEN
            ExtendRange (ymin, ymax, xmin, xmax, seen, c0, c1, v0, v1)
          ELSE
            ExtendRange (xmin, xmax, ymin, ymax, seen, c0, c1, v0, v1)
          END
        END
      END
    END
  END ;

  pad := (ymax - ymin) * 0.08 ;
  IF pad = 0.0 THEN pad := 1.0 END ;
  ymin := ymin - pad ;
  ymax := ymax + pad ;

  d := DynStr.New (pool) ;
  DynStr.Append (d, '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 440" ') ;
  DynStr.Append (d, 'font-family="DejaVu Sans, Helvetica, sans-serif">') ;
  DynStr.Append (d, '<rect width="720" height="440" fill="white"/>') ;

  (* A LOG AXIS IS TICKED ON THE DECADES, not on NiceStep's round
     numbers: on a logarithmic axis the round numbers are the powers,
     and a grid line every 0.2 of a decade says nothing a reader
     wants.  The linear branch below is untouched, which is why every
     figure that never asks for a log axis still emits the bytes the
     Modula-2 original emitted. *)
  IF logY THEN
    t := DecadeFloor (ymin) ;
    WHILE t <= ymax DO
      DynStr.Append (d, '<line x1="') ; EmitR (d, MLeft) ;
      DynStr.Append (d, '" y1="') ; EmitR (d, PYof (t, ymin, ymax)) ;
      DynStr.Append (d, '" x2="') ; EmitR (d, FigW - MRight) ;
      DynStr.Append (d, '" y2="') ; EmitR (d, PYof (t, ymin, ymax)) ;
      DynStr.Append (d, '" stroke="#e0e0e0" stroke-width="1"/>') ;
      DynStr.Append (d, '<text x="') ; EmitR (d, MLeft - 8.0) ;
      DynStr.Append (d, '" y="') ;
      EmitR (d, PYof (t, ymin, ymax) + 4.0) ;
      DynStr.Append (d, '" font-size="11" fill="#444" text-anchor="end">') ;
      EmitR (d, Pow10 (t)) ;
      DynStr.Append (d, '</text>') ;
      t := t + 1.0
    END
  ELSE
  step := NiceStep (ymax - ymin) ;
  t := FloorMul (ymin, step) ;
  WHILE t < ymin DO t := t + step END ;
  WHILE t <= ymax DO
    DynStr.Append (d, '<line x1="') ; EmitR (d, MLeft) ;
    DynStr.Append (d, '" y1="') ; EmitR (d, PYof (t, ymin, ymax)) ;
    DynStr.Append (d, '" x2="') ; EmitR (d, FigW - MRight) ;
    DynStr.Append (d, '" y2="') ; EmitR (d, PYof (t, ymin, ymax)) ;
    DynStr.Append (d, '" stroke="#e0e0e0" stroke-width="1"/>') ;
    DynStr.Append (d, '<text x="') ; EmitR (d, MLeft - 8.0) ;
    DynStr.Append (d, '" y="') ;
    EmitR (d, PYof (t, ymin, ymax) + 4.0) ;
    DynStr.Append (d, '" font-size="11" fill="#444" text-anchor="end">') ;
    EmitR (d, t) ;
    DynStr.Append (d, '</text>') ;
    t := t + step
  END
  END ;
  IF logX THEN
    t := DecadeFloor (xmin) ;
    WHILE t <= xmax DO
      DynStr.Append (d, '<line x1="') ; EmitR (d, PXof (t, xmin, xmax)) ;
      DynStr.Append (d, '" y1="') ; EmitR (d, MTop) ;
      DynStr.Append (d, '" x2="') ; EmitR (d, PXof (t, xmin, xmax)) ;
      DynStr.Append (d, '" y2="') ;
      EmitR (d, FigH - MBottom) ;
      DynStr.Append (d, '" stroke="#e0e0e0" stroke-width="1"/>') ;
      DynStr.Append (d, '<text x="') ; EmitR (d, PXof (t, xmin, xmax)) ;
      DynStr.Append (d, '" y="') ;
      EmitR (d, FigH - MBottom + 18.0) ;
      DynStr.Append (d, '" font-size="11" fill="#444" text-anchor="middle">') ;
      EmitR (d, Pow10 (t)) ;
      DynStr.Append (d, '</text>') ;
      t := t + 1.0
    END
  ELSE
  step := NiceStep (xmax - xmin) ;
  t := FloorMul (xmin, step) ;
  WHILE t < xmin DO t := t + step END ;
  WHILE t <= xmax DO
    DynStr.Append (d, '<line x1="') ; EmitR (d, PXof (t, xmin, xmax)) ;
    DynStr.Append (d, '" y1="') ; EmitR (d, MTop) ;
    DynStr.Append (d, '" x2="') ; EmitR (d, PXof (t, xmin, xmax)) ;
    DynStr.Append (d, '" y2="') ;
    EmitR (d, FigH - MBottom) ;
    DynStr.Append (d, '" stroke="#e0e0e0" stroke-width="1"/>') ;
    DynStr.Append (d, '<text x="') ; EmitR (d, PXof (t, xmin, xmax)) ;
    DynStr.Append (d, '" y="') ;
    EmitR (d, FigH - MBottom + 18.0) ;
    DynStr.Append (d, '" font-size="11" fill="#444" text-anchor="middle">') ;
    EmitR (d, t) ;
    DynStr.Append (d, '</text>') ;
    t := t + step
  END
  END ;

  DynStr.Append (d, '<line x1="') ; EmitR (d, MLeft) ;
  DynStr.Append (d, '" y1="') ; EmitR (d, MTop) ;
  DynStr.Append (d, '" x2="') ; EmitR (d, MLeft) ;
  DynStr.Append (d, '" y2="') ; EmitR (d, FigH - MBottom) ;
  DynStr.Append (d, '" stroke="black" stroke-width="1.2"/>') ;
  DynStr.Append (d, '<line x1="') ; EmitR (d, MLeft) ;
  DynStr.Append (d, '" y1="') ;
  EmitR (d, FigH - MBottom) ;
  DynStr.Append (d, '" x2="') ; EmitR (d, FigW - MRight) ;
  DynStr.Append (d, '" y2="') ;
  EmitR (d, FigH - MBottom) ;
  DynStr.Append (d, '" stroke="black" stroke-width="1.2"/>') ;

  (* THE BARS, under the dots and the lines.  Each is a rectangle
     from its baseline to its value on the VALUE axis, and one slot
     wide on the CATEGORY axis -- with the two axes swapped when the
     bars are horizontal, which is the only thing that direction
     changes.  A grouped series takes its own share of the slot; a
     stacked one starts where the series below it ended. *)
  IF nBar > 0 THEN
    slot := SlotWidth () * barWidth ;
    IF barMode = BarStacked THEN grp := slot
    ELSE grp := slot / F64 (nBar) END ;
    FOR s := 0 TO nBar - 1 DO
      IF barMode = BarStacked THEN off := 0.0
      ELSE off := 0.0 - slot * 0.5 + grp * (F64 (s) + 0.5) END ;
      FOR i := 0 TO barN[s] - 1 DO
        w := barV[s * MaxPts + i] ;
        IF NOT IsNaN (w) THEN
          v := BarPos (s, i) + off ;
          base := StackBase (s, i) ;
          top := base + w ;
          (* on a log value axis zero is nowhere, so the foot of the
             bar is the axis floor -- said in the definition, because
             a reader comparing bar HEIGHTS on a log axis is already
             comparing ratios and should know where they start *)
          IF barDir = BarHorizontal THEN
            IF logX AND base <= 0.0 THEN base := Pow10 (xmin) END
          ELSE
            IF logY AND base <= 0.0 THEN base := Pow10 (ymin) END
          END ;
          IF barDir = BarHorizontal THEN
            c0 := PYof (Axis (v + grp * 0.5, logY), ymin, ymax) ;
            c1 := PYof (Axis (v - grp * 0.5, logY), ymin, ymax) ;
            v0 := PXof (Axis (base, logX), xmin, xmax) ;
            v1 := PXof (Axis (top, logX), xmin, xmax)
          ELSE
            c0 := PXof (Axis (v - grp * 0.5, logX), xmin, xmax) ;
            c1 := PXof (Axis (v + grp * 0.5, logX), xmin, xmax) ;
            v0 := PYof (Axis (top, logY), ymin, ymax) ;
            v1 := PYof (Axis (base, logY), ymin, ymax)
          END ;
          IF c1 < c0 THEN t := c0 ; c0 := c1 ; c1 := t END ;
          IF v1 < v0 THEN t := v0 ; v0 := v1 ; v1 := t END ;
          DynStr.Append (d, '<rect x="') ;
          IF barDir = BarHorizontal THEN EmitR (d, v0)
          ELSE EmitR (d, c0) END ;
          DynStr.Append (d, '" y="') ;
          IF barDir = BarHorizontal THEN EmitR (d, c0)
          ELSE EmitR (d, v0) END ;
          DynStr.Append (d, '" width="') ;
          IF barDir = BarHorizontal THEN EmitR (d, v1 - v0)
          ELSE EmitR (d, c1 - c0) END ;
          DynStr.Append (d, '" height="') ;
          IF barDir = BarHorizontal THEN EmitR (d, c1 - c0)
          ELSE EmitR (d, v1 - v0) END ;
          (* FILLED OR NOT is one attribute pair, and an unfilled bar
             still needs its outline in the series colour or it is
             invisible *)
          IF barFilled THEN
            DynStr.Append (d, '" fill="') ;
            EmitBarColor (d, s) ;
            DynStr.Append (d, '" stroke="none"/>')
          ELSE
            DynStr.Append (d, '" fill="none" stroke="') ;
            EmitBarColor (d, s) ;
            DynStr.Append (d, '" stroke-width="1.6"/>')
          END
        END
      END
    END ;

    (* THE ERROR BARS, over the rectangles they belong to: a whisker
       from value-e to value+e with a cap at each end.  Drawn in a
       second pass so a later series' bar cannot cover an earlier
       series' whisker. *)
    FOR s := 0 TO nBar - 1 DO
      IF barHasErr[s] THEN
        IF barMode = BarStacked THEN off := 0.0
        ELSE off := 0.0 - slot * 0.5 + grp * (F64 (s) + 0.5) END ;
        FOR i := 0 TO barN[s] - 1 DO
          w := barV[s * MaxPts + i] ;
          IF NOT IsNaN (w) THEN
            IF i < LEN (barErr[s]) THEN
              e := barErr[s][i] ;
              IF NOT IsNaN (e) THEN
                IF e > 0.0 THEN
                  v := BarPos (s, i) + off ;
                  top := StackBase (s, i) + w ;
                  IF barDir = BarHorizontal THEN
                    c0 := PYof (Axis (v, logY), ymin, ymax) ;
                    v0 := PXof (Axis (top - e, logX), xmin, xmax) ;
                    v1 := PXof (Axis (top + e, logX), xmin, xmax) ;
                    EmitWhisker (d, v0, c0, v1, c0, TRUE)
                  ELSE
                    c0 := PXof (Axis (v, logX), xmin, xmax) ;
                    v0 := PYof (Axis (top - e, logY), ymin, ymax) ;
                    v1 := PYof (Axis (top + e, logY), ymin, ymax) ;
                    EmitWhisker (d, c0, v0, c0, v1, FALSE)
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;

  (* the scatter layer, under the lines *)
  FOR i := 0 TO dotN - 1 DO
    v := dotX[i] ;
    w := dotY[i] ;
    IF Loggable (v, logX) AND Loggable (w, logY) THEN
      DynStr.Append (d, '<circle cx="') ;
      EmitR (d, PXof (Axis (v, logX), xmin, xmax)) ;
      DynStr.Append (d, '" cy="') ;
      EmitR (d, PYof (Axis (w, logY), ymin, ymax)) ;
      DynStr.Append (d, '" r="0.7" fill="black"/>')
    END
  END ;

  FOR s := 0 TO nSer - 1 DO
    DynStr.Append (d, '<path d="') ;
    pen := FALSE ;
    FOR i := 0 TO serN[s] - 1 DO
      v := serX[s * MaxPts + i] ;
      w := serY[s * MaxPts + i] ;
      IF NOT (Loggable (v, logX) AND Loggable (w, logY)) THEN
        pen := FALSE
      ELSE
        px := PXof (Axis (v, logX), xmin, xmax) ;
        py := PYof (Axis (w, logY), ymin, ymax) ;
        IF pen THEN DynStr.Append (d, 'L ')
        ELSE DynStr.Append (d, 'M ') END ;
        EmitR (d, px) ; DynStr.AppendChar (d, ' ') ;
        EmitR (d, py) ; DynStr.AppendChar (d, ' ') ;
        pen := TRUE
      END
    END ;
    DynStr.Append (d, '" fill="none" stroke="') ;
    EmitLineColor (d, s) ;
    DynStr.Append (d, '" stroke-width="1.8"/>')
  END ;

  ly := MTop + 14.0 ;
  FOR s := 0 TO nSer - 1 DO
    DynStr.Append (d, '<line x1="') ;
    EmitR (d, FigW - MRight - 150.0) ;
    DynStr.Append (d, '" y1="') ; EmitR (d, ly - 4.0) ;
    DynStr.Append (d, '" x2="') ;
    EmitR (d, FigW - MRight - 126.0) ;
    DynStr.Append (d, '" y2="') ; EmitR (d, ly - 4.0) ;
    DynStr.Append (d, '" stroke="') ;
    EmitLineColor (d, s) ;
    DynStr.Append (d, '" stroke-width="2"/>') ;
    DynStr.Append (d, '<text x="') ;
    EmitR (d, FigW - MRight - 120.0) ;
    DynStr.Append (d, '" y="') ; EmitR (d, ly) ;
    DynStr.Append (d, '" font-size="11" fill="#222">') ;
    DynStr.Append (d, serLbl[s]) ;
    DynStr.Append (d, '</text>') ;
    ly := ly + 16.0
  END ;

  (* and a swatch per bar series, in the same column under the line
     entries: a small rectangle rather than a stroke, because that is
     what the reader is looking for on the chart *)
  FOR s := 0 TO nBar - 1 DO
    DynStr.Append (d, '<rect x="') ;
    EmitR (d, FigW - MRight - 150.0) ;
    DynStr.Append (d, '" y="') ; EmitR (d, ly - 11.0) ;
    DynStr.Append (d, '" width="24" height="9"') ;
    IF barFilled THEN
      DynStr.Append (d, ' fill="') ;
      EmitBarColor (d, s) ;
      DynStr.Append (d, '" stroke="none"/>')
    ELSE
      DynStr.Append (d, ' fill="none" stroke="') ;
      EmitBarColor (d, s) ;
      DynStr.Append (d, '" stroke-width="1.6"/>')
    END ;
    DynStr.Append (d, '<text x="') ;
    EmitR (d, FigW - MRight - 120.0) ;
    DynStr.Append (d, '" y="') ; EmitR (d, ly) ;
    DynStr.Append (d, '" font-size="11" fill="#222">') ;
    DynStr.Append (d, barLbl[s]) ;
    DynStr.Append (d, '</text>') ;
    ly := ly + 16.0
  END ;

  DynStr.Append (d, '<text x="360" y="24" font-size="14" fill="#111" text-anchor="middle">') ;
  DynStr.Append (d, title) ;
  DynStr.Append (d, '</text>') ;
  DynStr.Append (d, '<text x="360" y="') ;
  EmitR (d, FigH - 14.0) ;
  DynStr.Append (d, '" font-size="12" fill="#222" text-anchor="middle">') ;
  DynStr.Append (d, xlabel) ;
  DynStr.Append (d, '</text>') ;
  DynStr.Append (d, '<text x="18" y="230" font-size="12" fill="#222" text-anchor="middle" ') ;
  DynStr.Append (d, 'transform="rotate(-90 18 230)">') ;
  DynStr.Append (d, ylabel) ;
  DynStr.Append (d, '</text>') ;
  DynStr.Append (d, '</svg>') ;
  RETURN DynStr.View (d)
END Render ;

PROCEDURE RenderHeat (RO title: STR ;
                      m: PTR Mat.Matrix ;
                      cmap: Cmap ;
                      symmetric: BOOL) : STR
  RAISES ValueRange =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  r, c, nr, nc, i : I64 ;
  mn, mx, cw, ch, t, v : F64 ;
BEGIN
  nr := Mat.Rows (m) ;
  nc := Mat.Cols (m) ;
  Mat.MinMax (m, mn, mx) ;
  IF symmetric THEN
    IF -mn > mx THEN mx := -mn ELSE mn := -mx END
  END ;
  (* a pinned range wins over both, symmetric included *)
  IF heatFixed THEN
    mn := heatLo ;
    mx := heatHi
  END ;
  IF mx = mn THEN mx := mn + 1.0 END ;
  cw := (FigW - MLeft - MRight - 60.0) / F64 (nc) ;
  ch := (FigH - MTop - MBottom) / F64 (nr) ;

  d := DynStr.New (pool) ;
  DynStr.Append (d, '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 440" ') ;
  DynStr.Append (d, 'font-family="DejaVu Sans, Helvetica, sans-serif">') ;
  DynStr.Append (d, '<rect width="720" height="440" fill="white"/>') ;

  FOR r := 0 TO nr - 1 DO
    FOR c := 0 TO nc - 1 DO
      v := Mat.Get (m, r, c) ;
      DynStr.Append (d, '<rect x="') ;
      EmitR (d, MLeft + F64 (c) * cw) ;
      DynStr.Append (d, '" y="') ;
      EmitR (d, MTop + F64 (r) * ch) ;
      DynStr.Append (d, '" width="') ;
      EmitR (d, cw + 0.5) ;
      DynStr.Append (d, '" height="') ;
      EmitR (d, ch + 0.5) ;
      DynStr.Append (d, '" fill="') ;
      IF NOT (v = v) THEN
        DynStr.Append (d, '#ffffff')
      ELSE
        EmitCmap (d, cmap, (v - mn) / (mx - mn))
      END ;
      DynStr.Append (d, '"/>')
    END
  END ;

  FOR i := 0 TO 99 DO
    t := F64 (i) / 99.0 ;
    DynStr.Append (d, '<rect x="') ;
    EmitR (d, FigW - MRight - 38.0) ;
    DynStr.Append (d, '" y="') ;
    EmitR (d, MTop + t * (FigH - MTop - MBottom - 3.4)) ;
    DynStr.Append (d, '" width="16" height="') ;
    EmitR (d, (FigH - MTop - MBottom) / 100.0 + 0.5) ;
    DynStr.Append (d, '" fill="') ;
    EmitCmap (d, cmap, 1.0 - t) ;
    DynStr.Append (d, '"/>')
  END ;
  DynStr.Append (d, '<text x="') ;
  EmitR (d, FigW - MRight - 30.0) ;
  DynStr.Append (d, '" y="') ; EmitR (d, MTop - 6.0) ;
  DynStr.Append (d, '" font-size="10" fill="#333" text-anchor="middle">') ;
  EmitR (d, mx) ;
  DynStr.Append (d, '</text>') ;
  DynStr.Append (d, '<text x="') ;
  EmitR (d, FigW - MRight - 30.0) ;
  DynStr.Append (d, '" y="') ;
  EmitR (d, FigH - MBottom + 14.0) ;
  DynStr.Append (d, '" font-size="10" fill="#333" text-anchor="middle">') ;
  EmitR (d, mn) ;
  DynStr.Append (d, '</text>') ;

  DynStr.Append (d, '<text x="360" y="24" font-size="14" fill="#111" text-anchor="middle">') ;
  DynStr.Append (d, title) ;
  DynStr.Append (d, '</text>') ;
  DynStr.Append (d, '</svg>') ;
  RETURN DynStr.View (d)
END RenderHeat ;

END Plot.
