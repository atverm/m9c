DEFINITION MODULE Json ;

IMPORT DynStr ;

(* JSON parsing for M9.  The 2026-08-20 Modula-2 version leaked every
   node by design and capped strings at 255 characters; here the pool
   owns the tree and slices are unbounded.  Failure is in the
   signature, not in a JErrorK node the caller can forget to check.   *)

TYPE
  Node ;                                 (* opaque; lives in a POOL *)

  Value = CASE RECORD
  | Object  : first: OPT PTR Node
  | Arr     : first: OPT PTR Node ; count: I64
  | Str     : RO s: STR
  | Num     : r: F64 ; i: I64 ; isInt: BOOL
  | Bool    : b: BOOL
  | Null
  END ;

EXCEPTION
  ParseError (RO msg: STR ; line, col: I64) ;
  TypeMismatch (RO msg: STR) ;
  (* a RAISES clause may only cite an exception the reader can find
     (par 5); IndexError and ValueRange are predeclared, so not here. *)

PROCEDURE Parse (RO src: STR) : PTR Node
  RAISES ParseError ;
  (* the whole tree is built in the caller's frame (par 4.3): it lives
     as long as the caller does, and a caller that must keep it longer
     Clones it into a pool.
     ParseError carries line and column -- errors are values.          *)

PROCEDURE Field (obj: PTR Node ; RO name: STR)
  : OPT PTR Node ;
  (* absence is OPT, not NIL: the caller must guard before use.        *)

PROCEDURE Item (arr: PTR Node ; i: I64) : PTR Node
  RAISES TypeMismatch, IndexError ;
  (* the M2 version answered NIL for "not an array"; M9 has no NIL
     to hide behind, so the confusion is named in the signature.       *)

PROCEDURE Count (arr: PTR Node) : I64
  RAISES TypeMismatch ;
  (* how many elements an array has, so a walk is a FOR over it.

       arr -- must BE an array.  Asking an object or a string how
              many elements it has is a question about the document's
              shape that the caller got wrong, so it raises rather
              than answering 0 -- an empty array and a value that is
              not an array are different, and 0 would merge them.  *)

PROCEDURE MemberCount (obj: PTR Node) : I64
  RAISES TypeMismatch ;
  (* how many members an Object has -- the object twin of Count,
     with the same refusal for a non-object.                          *)

PROCEDURE NameAt (obj: PTR Node ; i: I64) : STR
  RAISES TypeMismatch, IndexError ;
  (* the i-th member's NAME, document order -- with MemberAt this is
     the walk Field cannot do: reading an object whose keys are data
     (the proxy's host map).                                          *)

PROCEDURE MemberAt (obj: PTR Node ; i: I64) : PTR Node
  RAISES TypeMismatch, IndexError ;
  (* the i-th member's value node, document order.                    *)

PROCEDURE AsI64 (n: PTR Node) : I64
  RAISES TypeMismatch, ValueRange ;
  (* TypeMismatch if not Num; ValueRange if a float value is
     non-finite or beyond I64 -- the Trunc(NaN) crash and numpy's
     silent INT64_MIN, both named in the contract.                     *)

PROCEDURE AsF64 (n: PTR Node) : F64
  RAISES TypeMismatch ;
  (* the numeric value as it was parsed.  Unlike AsI64 this cannot
     raise ValueRange: every JSON number has an F64 value, and it is
     only the narrowing to an integer that can fail.  Reach for this
     one when the document says 3.5 and for AsI64 when it says a
     count.                                                         *)

PROCEDURE AsBool (n: PTR Node) : BOOL
  RAISES TypeMismatch ;
  (* a JSON false is a value, not an absence, so this raises on a
     non-Bool rather than answering FALSE: the first caller to read
     configuration out of a document needed to tell "the option says
     no" from "the option is not there".                              *)

PROCEDURE AsStr (n: PTR Node) : STR
  RAISES TypeMismatch ;
  (* the TEXT of a JSON string.  A VIEW into the document the tree
     was parsed from -- nothing is copied and nothing is unescaped,
     which is exactly what Parse promises about the source it retains
     -- so a caller that outlives the source must copy it, the same
     contract Parse already states.

     Until this existed a document's strings could only be COMPARED,
     through StrIs, so a configuration could ask "is the mode 'fast'"
     and could not read a path out of the file.  Found by the ported model's
     pathnames moving into the options document.                    *)

PROCEDURE ParseIn (VAR pool: POOL ; RO src: STR) : PTR Node IN pool
  RAISES ParseError ;
  (* Parse with the tree in pool: for a document a module keeps past
     the frame that read it.  String payloads are VIEWS into src, as
     Parse's are, so src must outlive the tree -- a file read into
     the same pool, or a literal. *)

PROCEDURE Text (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange ;
  (* the DECODED text of a JSON string: escapes resolved the way
     json.loads resolves them -- quote, backslash, slash, the five
     control shorthands, unicode escapes with surrogate pairs
     combined.  A string holding no backslash answers the same VIEW
     AsStr does, nothing copied, so the escape-free common case
     stays free; a malformed escape raises TypeMismatch naming it,
     and a LONE surrogate is refused the same way where Python would
     carry the unpaired code unit -- stated, since no real document
     wants one.  Demanded by the zarr proxy's ledger: AsStr's raw
     view is right for comparing and wrong for READING a value
     somebody escaped.                                              *)

PROCEDURE StrIs (n: PTR Node ; RO s: STR) : BOOL ;
  (* is n a string equal to s?  Total, and deliberately so: it
     answers FALSE for a number, an object or a missing member, so a
     caller testing `"type" is "array"` writes one call and no
     handler.  Comparison against a value the caller supplies cannot
     be a type confusion the way AsI64 can.                         *)

PROCEDURE IsNull (n: PTR Node) : BOOL ;

PROCEDURE CompactSorted (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange, IndexError ;
  (* Compact with every object's members sorted by name -- the
     json.dumps(sort_keys=True, separators=(",", ":")) rendering the
     proxy's passportSha256 canonicalises over.  Same float refusal
     as Compact.                                                      *)

PROCEDURE Pretty (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange ;
  (* json.dumps(indent=2): document order, two-space indentation,
     ": " after keys, one element per line, empty containers inline
     -- the rendering the proxy's saved passport files use.           *)

PROCEDURE ReprText (r: F64) : STR
  RAISES ValueRange ;
  (* a bare F64 exactly as json.dumps renders it -- Python repr for
     finite values, the NaN / Infinity tokens otherwise.  For
     composers that hold the value, not a Node.

     ReprText ALLOCATES: it carves a DString to hold one number and
     answers a view of it.  In a loop that is a pool block per value --
     the zarr proxy measured five million of them emitting a million
     ndjson rows -- so a composer that already HAS a buffer should call
     AppendF64 below and copy nothing.                                *)

PROCEDURE AppendF64 (VAR d: PTR DynStr.DString ; r: F64)
  RAISES ValueRange ;
  (* ReprText's own body, appending straight into d.  Identical bytes,
     no intermediate string: this is what a row emitter wants.        *)

PROCEDURE NumText (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange ;
  (* the number as Python str() renders it -- the digits for an
     integer, repr for a float.  TypeMismatch when n is not Num.     *)

(* ---- building a document ------------------------------------- *)

PROCEDURE AppendJString (VAR d: PTR DynStr.DString ;
                         RO t: STR)
  RAISES ValueRange ;
  (* t appended as a JSON string literal, quotes included -- the
     same escaping Compact uses, exported for callers composing
     JSON documents directly (the proxy's catalog builder).  The
     declared raise is conversion accounting; it cannot fire.       *)

(* ---- building a document -----------------------------------------

   Json could PARSE a tree and re-serialise it and could not MAKE
   one, so every composer in this family wrote its JSON as text and
   got the escaping right by hand.  These close that: build a tree,
   hand it to Compact, and the escaping, the float spelling and the
   member order are the ones already held byte for byte against
   json.dumps.

   ORDER IS THE POINT.  Set APPENDS a name that is new and REPLACES
   one that is already there IN PLACE -- which is what Python's
   {**a, "k": v} does, a shared key keeping a's position and taking
   b's value.  The ICOS store attributes this was added for are
   re-derived and diffed against live stores, where a member in the
   right place with the right value is the whole test.

   A node belongs to at most ONE parent: Set and Add LINK the node
   given, they do not copy it, so handing the same node to two
   parents makes a cycle or a shared tail.  Build a child, place it,
   go on filling it -- that order is fine, because the link is by
   pointer.

   Set walks the member chain, so an object of n members costs
   O(n^2) to build.  That is right for what this exists for -- a
   store's .zattrs, an agent guide: tens of members -- and wrong for
   a consolidated index of 100,000 entries, which is composed as
   text and always was.                                             *)

PROCEDURE NewObj () : PTR Node ;
PROCEDURE NewArr () : PTR Node ;

PROCEDURE NewStr (RO s: STR) : PTR Node
  RAISES ValueRange ;
  (* s is the string's VALUE, not document text.  It is escaped
     here, because a Node's Str payload is always DOCUMENT text --
     Text decodes it, Compact decodes it and re-escapes -- so a
     value carrying a literal backslash stored raw would be read
     back as an escape and could fail to parse at all.  Escaping at
     construction keeps built and parsed nodes indistinguishable,
     which is what lets one tree mix them.                          *)

PROCEDURE NewI64 (v: I64) : PTR Node ;
PROCEDURE NewF64 (r: F64) : PTR Node ;
PROCEDURE NewBool (b: BOOL) : PTR Node ;
PROCEDURE NewNull () : PTR Node ;

(* THE SAME CONSTRUCTORS WITH THE NODE IN A NAMED POOL, for a tree
   that outlives the frame that builds it: a cache, a passport, a
   store's metadata held by a server between requests.  The frame
   forms above build in the caller's arena, which is right for a
   tree that is composed and serialised in one frame and wrong for
   one a module keeps -- the checker refuses a frame node stored
   anywhere durable.  A node made here carries no frame taint, so a
   helper that takes the tree VAR KEPT may make a member in the
   tree's pool and Set it (`n := NewStrIn (pool, v) ; Set (o, k, n)`),
   which is the shape the zarr proxy composes its documents in.
   Dict spells the same pair as New/NewIn.  Members of one tree share
   a pool: Set and Add link by pointer and copy nothing. *)
PROCEDURE NewObjIn (VAR pool: POOL) : PTR Node IN pool ;
PROCEDURE NewArrIn (VAR pool: POOL) : PTR Node IN pool ;
PROCEDURE NewStrIn (VAR pool: POOL ; RO s: STR) : PTR Node IN pool
  RAISES ValueRange ;
  (* NewStr with the node and its escaped payload in pool *)
PROCEDURE NewI64In (VAR pool: POOL ; v: I64) : PTR Node IN pool ;
PROCEDURE NewF64In (VAR pool: POOL ; r: F64) : PTR Node IN pool ;

PROCEDURE NewRaw (RO text: STR) : PTR Node
  RAISES ParseError, TypeMismatch ;
PROCEDURE NewRawIn (VAR pool: POOL ; RO text: STR) : PTR Node IN pool
  RAISES ParseError, TypeMismatch ;
  (* a NUMBER written exactly as `text' says it -- `1.0E-5', `2.50',
     `1e400' -- where NewF64 would write the double's shortest repr.
     For an output whose numbers follow another program's printing
     (Java's Double.toString, a fixed number of decimals).  text must
     be one JSON number: anything else raises ParseError, a JSON value
     of another kind TypeMismatch, so a document stays JSON.  The node
     is a Num like any other -- AsF64 and AsI64 read its value -- and
     Compact, Pretty, NumText and Clone keep the text (2026-10-10,
     cp-kernel's proposal: its view printed numbers through a JSON
     builder of its own). *)
PROCEDURE NewBoolIn (VAR pool: POOL ; b: BOOL) : PTR Node IN pool ;
PROCEDURE NewNullIn (VAR pool: POOL) : PTR Node IN pool ;

PROCEDURE Name (RO s: STR) : STR
  RAISES ValueRange ;
  (* the DOCUMENT spelling of a member name whose VALUE is s -- what
     Set and Field expect, since a name inside a Node is document
     text exactly as a Str payload is.  A literal name needs none of
     this; a name that comes from DATA does: the FLUXNET shuttle's
     BADM export put a Windows path into a group name, and
     `badm_c:\users\...` set raw was read back as a broken escape.
     Escaped exactly as NewStr escapes a value, so a name built here
     and one parsed from a document compare equal.                *)

PROCEDURE Set (VAR KEPT obj: PTR Node ; RO KEPT name: STR ;
               VAR KEPT v: PTR Node)
  RAISES TypeMismatch ;
  (* append v under name, or put it where a member of that name
     already stands.  TypeMismatch when obj is not an object.

     BOTH POINTERS ARE VAR, and that is par 4.1 rather than a
     preference: linking WRITES through them, and a value PTR
     parameter is a shared borrow the checker will not let a
     procedure write through.  So a member is a named local, not an
     argument spelled inline -- `n := NewStr (p, s) ; Set (o, k, n)`
     -- and a composer that wants the one-liner back wraps these in
     its own helper, where the skip-blanks policy belongs anyway. *)

PROCEDURE Add (VAR KEPT arr: PTR Node ; VAR KEPT v: PTR Node)
  RAISES TypeMismatch ;
  (* append to an array, count kept.                               *)

PROCEDURE CloneIn (VAR pool: POOL ; n: PTR Node) : PTR Node IN pool
  RAISES TypeMismatch ;
  (* Clone with every node, payload and member name in pool *)

PROCEDURE Clone (n: PTR Node) : PTR Node
  RAISES TypeMismatch ;
  (* a DEEP copy, in the caller's frame.  A node belongs to at most one parent --
     Set and Add relink the node they are given -- so a subtree that
     is to appear in a second document is cloned, never linked twice.
     Merging a shared vocabulary into a per-store document is exactly
     that case, and linking would quietly corrupt the vocabulary for
     every later store.

     Deep rather than shallow on purpose: a shallow copy would share
     the child chain, so a later Set on the copy would reach into the
     original.  These documents are tens of members; the copy is not
     worth being clever about.

     STRING PAYLOADS AND MEMBER NAMES ARE COPIED TOO, which is what
     makes a clone that outlives its source document safe.  A Str's
     text is a VIEW -- of the document when the node came from Parse,
     of a builder's buffer when it came from NewStr -- so a clone
     that kept the view would dangle the moment the source pool went
     away.  Nothing in the type system can see that: a POOL is not
     part of a STR's type.                                         *)

PROCEDURE Spaced (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange ;
  (* Compact's separators are json.dumps' COMPACT ones; these are its
     DEFAULT ones -- ", " between members and ": " after a name, all
     on one line.  Same escaping, same float spelling, same order.

     It exists because that is the spelling zarr-python 3 writes a
     consolidated `.zmetadata` in, and the one icos_ingest.finalize
     writes a slim root in.  A store's metadata is otherwise NOT
     byte-comparable across implementations at all -- measured
     2026-09-09: zarr 2.18.7 indents by four and sorts its keys,
     zarr 3.3.0 indents by two and keeps insertion order, and the
     live ICOS stores carry BOTH because one store is rebuilt nightly
     and the others are not.  The one-line spaced form is the only
     spelling two of those three agree on.                          *)

PROCEDURE Compact (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange ;
  (* the tree re-serialised COMPACT, python-json.dumps style:
     member order preserved (the parser keeps document order),
     separators bare, floats as Python repr (shortest round-trip,
     m9_repr_double -- held to repr digit for digit over 300k
     values), non-finite values as dumps' NaN/Infinity tokens,
     strings escaped exactly as ensure_ascii=False
     escapes them (quote, backslash, the five control shorthands,
     \u00xx for other controls, everything else raw for a UTF-8
     wire).  Tree strings are DECODED first (Text's rules) and
     re-escaped, which is exactly loads-then-dumps: a document
     spelling a quote as \" emits \" again, not the doubled
     re-escape a raw pass would make of it.  Demanded by the zarr
     proxy, whose reference answers json.loads-then-JSONResponse
     and must be matched byte for byte.                              *)
  (* is n the literal null?  A JSON null is a VALUE, not an absence
     -- a member present and null is different from a member that is
     not there, and Field raises for the second -- so this asks
     about the first and nothing else.                              *)

END Json.


UNSAFE DEFINITION MODULE FOR "C" cjrepr ;

(* m9rt's shortest-round-trip float printer: CPython's repr(float),
   probed with %.*e and judged by strtod.  REENTRANT -- all state on
   the caller's stack.  buf needs 32 bytes; answers the length.     *)

PROCEDURE ReprF64 = "m9_repr_double" (v: C.Double ; buf: C.MutPtr)
  : C.SSizeT
  [REENTRANT] ;
PROCEDURE StrToD = "m9_strtod" (s: C.ConstPtr) : C.Double
  [REENTRANT] ;

END cjrepr.


UNSAFE IMPLEMENTATION MODULE Json ;

(* UNSAFE for ADR at the float-printing boundary. *)

FROM cjrepr IMPORT ReprF64, StrToD ;

IMPORT DynStr ;

TYPE
  Node = RECORD
    v    : Value ;
    RO name : STR ;    (* member name inside Object *)
    next : OPT PTR Node ;
    RO raw : STR ;     (* a Num's text as NewRaw was given it; '' else *)
  END ;

  Cursor = RECORD
    RO src       : STR ;
    pos       : I64 ;
    line, col : I64 ;
  END ;

PROCEDURE Cur (VAR c: PTR Cursor) : CHAR =
BEGIN
  IF c.pos < LEN (c.src) THEN RETURN c.src[c.pos] ELSE RETURN 0C END
END Cur ;

PROCEDURE Bump (VAR c: PTR Cursor) =
BEGIN
  IF Cur (c) = 0AC THEN c.line := c.line + 1 ; c.col := 1
  ELSE c.col := c.col + 1 END ;
  c.pos := c.pos + 1
END Bump ;

PROCEDURE Skip (VAR c: PTR Cursor) =
BEGIN
  WHILE Cur (c) = ' ' OR Cur (c) = 09C OR Cur (c) = 0AC OR Cur (c) = 0DC DO
    Bump (c)
  END
END Skip ;

PROCEDURE Fail (VAR c: PTR Cursor ; RO msg: STR)
  RAISES ParseError =
BEGIN
  RAISE ParseError (msg, c.line, c.col)
END Fail ;

PROCEDURE ParseValue (VAR c: PTR Cursor) : PTR Node
  RAISES ParseError =
VAR n : PTR Node ;
BEGIN
  Skip (c) ;
  CASE Cur (c) OF
  | '{' : RETURN ParseObject (c)
  | '[' : RETURN ParseArray (c)
  | '"' : n := NEW (c, Node) ;
          n.v := Value.Str (ParseString (c)) ;
          RETURN n
  ELSE
    IF Match (c, 'true') THEN
      n := NEW (c, Node) ; n.v := Value.Bool (TRUE) ; RETURN n
    ELSIF Match (c, 'false') THEN
      n := NEW (c, Node) ; n.v := Value.Bool (FALSE) ; RETURN n
    ELSIF Match (c, 'null') THEN
      n := NEW (c, Node) ; n.v := Value.Null ; RETURN n
    ELSIF Cur (c) = '-' OR (Cur (c) >= '0' AND Cur (c) <= '9') THEN
      RETURN ParseNumber (c)
    ELSE
      (* the RAISE is written here, not reached through Fail: a call
         is never an ending to the checker, whatever its callee does *)
      RAISE ParseError ('value expected', c.line, c.col)
    END
  END
  (* no fall-through returns exist: every path RETURNs or RAISEs,
     and the compiler proves it -- the uninitialized-Result class,
     closed at the language level.  (True since 2026-10-01.  For
     five weeks before that this comment was the only thing saying
     so: with `Fail (c, ...)` as the last branch the function could
     reach its END, and both checkers accepted it.)                   *)
END ParseValue ;

PROCEDURE Field (obj: PTR Node ; RO name: STR)
  : OPT PTR Node =
VAR c : OPT PTR Node ;
BEGIN
  CASE obj.v OF
  | Object (first) : c := first
  ELSE RETURN NONE
  END ;
  WHILE c IS SOME p DO
    IF DynStr.Eq (p.name, name) THEN RETURN SOME (p) END ;
    c := p.next
  END ;
  RETURN NONE
END Field ;

PROCEDURE AsI64 (n: PTR Node) : I64
  RAISES TypeMismatch, ValueRange =
BEGIN
  CASE n.v OF
  | Num (r, i, isInt) :
      IF isInt THEN RETURN i END ;
      RETURN I64 (r)            (* checked conversion: RAISES ValueRange
                                   on NaN, Inf, or overflow -- par 2.1 *)
  ELSE
    RAISE TypeMismatch ('number expected')
  END
END AsI64 ;

PROCEDURE ParseObject (VAR c: PTR Cursor) : PTR Node
  RAISES ParseError =
VAR
  n, child   : PTR Node ;
  head, last : OPT PTR Node ;
  RO nm         : STR ;
BEGIN
  Bump (c) ;                                       (* consume '{' *)
  Skip (c) ;
  head := NONE ; last := NONE ;
  IF Cur (c) = '}' THEN
    Bump (c) ;
    n := NEW (c, Node) ; n.v := Value.Object (NONE) ; RETURN n
  END ;
  LOOP
    Skip (c) ;
    nm := ParseString (c) ;
    Skip (c) ;
    IF Cur (c) # ':' THEN Fail (c, 'colon expected after member name') END ;
    Bump (c) ;
    child := ParseValue (c) ;
    child.name := nm ;
    IF last IS SOME lp THEN lp.next := SOME (child)
    ELSE head := SOME (child) END ;
    last := SOME (child) ;
    Skip (c) ;
    IF Cur (c) = ',' THEN Bump (c)
    ELSIF Cur (c) = '}' THEN Bump (c) ; EXIT
    ELSE Fail (c, 'comma or closing brace expected') END
  END ;
  n := NEW (c, Node) ;
  n.v := Value.Object (head) ;
  RETURN n
END ParseObject ;

PROCEDURE ParseArray (VAR c: PTR Cursor) : PTR Node
  RAISES ParseError =
VAR
  n, child   : PTR Node ;
  head, last : OPT PTR Node ;
  k          : I64 ;
BEGIN
  Bump (c) ;                                       (* consume '[' *)
  Skip (c) ;
  head := NONE ; last := NONE ; k := 0 ;
  IF Cur (c) = ']' THEN
    Bump (c) ;
    n := NEW (c, Node) ; n.v := Value.Arr (NONE, 0) ; RETURN n
  END ;
  LOOP
    child := ParseValue (c) ;
    IF last IS SOME lp THEN lp.next := SOME (child)
    ELSE head := SOME (child) END ;
    last := SOME (child) ;
    k := k + 1 ;
    Skip (c) ;
    IF Cur (c) = ',' THEN Bump (c)
    ELSIF Cur (c) = ']' THEN Bump (c) ; EXIT
    ELSE Fail (c, 'comma or closing bracket expected') END
  END ;
  n := NEW (c, Node) ;
  n.v := Value.Arr (head, k) ;
  RETURN n
END ParseArray ;

PROCEDURE ParseString (VAR c: PTR Cursor) : RO STR
  RAISES ParseError =
VAR
  start : I64 ;
  RO s     : STR ;
BEGIN
  IF Cur (c) # '"' THEN Fail (c, 'string expected') END ;
  Bump (c) ;
  start := c.pos ;
  WHILE Cur (c) # '"' DO
    IF c.pos >= LEN (c.src) THEN Fail (c, 'unterminated string') END ;
    IF Cur (c) = '\' THEN Bump (c) END ;           (* skip escaped char *)
    Bump (c)
  END ;
  s := SLICE (c.src, start, c.pos - start) ;
  Bump (c) ;                                       (* closing quote *)
  RETURN s
  (* the slice is verbatim source: escapes are carried raw, where the
     M2 version dropped the backslash and kept the next char.  Zarr
     metadata contains neither.  Decoding needs pool allocation; add
     it when a real store demands it, with a museum piece.            *)
END ParseString ;

PROCEDURE ParseNumber (VAR c: PTR Cursor) : PTR Node
  RAISES ParseError =
VAR
  scratch          : POOL ;      (* strtod's zero-terminated bytes *)
  n                : PTR Node ;
  neg, negE, isInt : BOOL ;
  ip, d, ex, start : I64 ;
  r, frac, sc      : F64 ;
  tb               : SLICE OF BYTE ;
BEGIN
  start := c.pos ;
  neg := FALSE ;
  IF Cur (c) = '-' THEN neg := TRUE ; Bump (c) END ;
  IF Cur (c) < '0' OR Cur (c) > '9' THEN Fail (c, 'digit expected') END ;
  ip := 0 ; r := 0.0 ; isInt := TRUE ;
  WHILE Cur (c) >= '0' AND Cur (c) <= '9' DO
    d := ORD (Cur (c)) - ORD ('0') ;
    r := r * 10.0 + F64 (d) ;
    IF isInt AND (ip <= (MAX (I64) - d) DIV 10) THEN ip := ip * 10 + d
    ELSE isInt := FALSE END ;
    (* overflow never traps here: past I64 the number demotes to F64.
       The M2 version wrapped silently -- par 2.1's Overflow trap is
       for arithmetic, not for deciding a representation.             *)
    Bump (c)
  END ;
  IF Cur (c) = '.' THEN
    isInt := FALSE ;
    Bump (c) ;
    IF Cur (c) < '0' OR Cur (c) > '9' THEN
      Fail (c, 'digit expected after decimal point') END ;
    frac := 0.0 ; sc := 0.1 ;
    WHILE Cur (c) >= '0' AND Cur (c) <= '9' DO
      frac := frac + sc * F64 (ORD (Cur (c)) - ORD ('0')) ;
      sc := sc / 10.0 ;
      Bump (c)
    END ;
    r := r + frac
  END ;
  IF Cur (c) = 'e' OR Cur (c) = 'E' THEN
    isInt := FALSE ;
    Bump (c) ;
    negE := FALSE ;
    IF Cur (c) = '-' THEN negE := TRUE ; Bump (c)
    ELSIF Cur (c) = '+' THEN Bump (c) END ;
    IF Cur (c) < '0' OR Cur (c) > '9' THEN
      Fail (c, 'digit expected in exponent') END ;
    ex := 0 ;
    WHILE Cur (c) >= '0' AND Cur (c) <= '9' DO
      IF ex < 1000 THEN ex := ex * 10 + ORD (Cur (c)) - ORD ('0') END ;
      (* clamped: past any F64 range already; r saturates below *)
      Bump (c)
    END ;
    WHILE ex > 0 DO
      IF negE THEN r := r / 10.0 ELSE r := r * 10.0 END ;
      ex := ex - 1
    END
  END ;
  IF neg THEN r := -r ; ip := -ip END ;
  IF NOT isInt THEN
    (* the accumulated r is an ulp off for some tokens; a document
       held to Python's bytes takes libc's value, the same strtod
       repr round-trips against.  The token includes its sign.      *)
    tb := DynStr.Bytes (scratch, SLICE (c.src, start, c.pos - start),
                        TRUE) ;
    r := F64 (StrToD (ADR (tb)))
  END ;
  n := NEW (c, Node) ;
  n.v := Value.Num (r, ip, isInt) ;
  RETURN n
EXCEPT
| ValueRange :
    (* DynStr.Bytes' accounting arm; a digit token cannot fire it *)
    Fail (c, 'number unrepresentable') ;
    RETURN NEW (c, Node)
END ParseNumber ;

PROCEDURE Match (VAR c: PTR Cursor ; RO lit: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF c.pos + LEN (lit) > LEN (c.src) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (lit) - 1 DO
    IF c.src[c.pos + i] # lit[i] THEN RETURN FALSE END
  END ;
  c.pos := c.pos + LEN (lit) ;
  c.col := c.col + LEN (lit) ;      (* keywords never contain newlines *)
  RETURN TRUE
END Match ;

PROCEDURE Parse (RO src: STR) : PTR Node
  RAISES ParseError =
VAR
  c : PTR Cursor ;
  n : PTR Node ;
BEGIN
  (* the cursor is the parser's allocation root: every node is NEW
     (c, Node), so the tree lands where the cursor lives -- here the
     frame, which for a function answering a pointer is the caller's
     arena; in ParseIn the pool *)
  c := NEW (Cursor) ;
  c.src := src ; c.pos := 0 ; c.line := 1 ; c.col := 1 ;
  n := ParseValue (c) ;
  Skip (c) ;
  IF c.pos < LEN (c.src) THEN Fail (c, 'trailing characters after value') END ;
  RETURN n
END Parse ;

PROCEDURE ParseIn (VAR pool: POOL ; RO src: STR) : PTR Node IN pool
  RAISES ParseError =
VAR
  c : PTR Cursor IN pool ;
  n : PTR Node IN pool ;
BEGIN
  c := NEW (pool, Cursor) ;
  c.src := src ; c.pos := 0 ; c.line := 1 ; c.col := 1 ;
  n := ParseValue (c) ;
  Skip (c) ;
  IF c.pos < LEN (c.src) THEN Fail (c, 'trailing characters after value') END ;
  RETURN n
END ParseIn ;

PROCEDURE Item (arr: PTR Node ; i: I64) : PTR Node
  RAISES TypeMismatch, IndexError =
VAR
  c : OPT PTR Node ;
  j : I64 ;
BEGIN
  CASE arr.v OF
  | Arr (first, count) :
      IF i < 0 OR i >= count THEN RAISE IndexError (i, count) END ;
      c := first ;
      j := i ;
      WHILE c IS SOME p DO
        IF j = 0 THEN RETURN p END ;
        j := j - 1 ;
        c := p.next
      END ;
      RAISE IndexError (i, count)   (* count and chain disagree: only
                                       reachable through a broken tree *)
  ELSE
    RAISE TypeMismatch ('array expected')
  END
END Item ;

PROCEDURE Count (arr: PTR Node) : I64
  RAISES TypeMismatch =
BEGIN
  CASE arr.v OF
  | Arr (first, count) : RETURN count
  ELSE RAISE TypeMismatch ('array expected')
  END
END Count ;

PROCEDURE MemberCount (obj: PTR Node) : I64
  RAISES TypeMismatch =
VAR
  c : OPT PTR Node ;
  n : I64 ;
BEGIN
  CASE obj.v OF
  | Object (first) : c := first
  ELSE RAISE TypeMismatch ('object expected')
  END ;
  n := 0 ;
  WHILE c IS SOME p DO
    n := n + 1 ;
    c := p.next
  END ;
  RETURN n
END MemberCount ;

PROCEDURE MemberNode (obj: PTR Node ; i: I64) : PTR Node
  RAISES TypeMismatch, IndexError =
VAR
  c : OPT PTR Node ;
  n : I64 ;
BEGIN
  CASE obj.v OF
  | Object (first) : c := first
  ELSE RAISE TypeMismatch ('object expected')
  END ;
  n := 0 ;
  WHILE c IS SOME p DO
    IF n = i THEN RETURN p END ;
    n := n + 1 ;
    c := p.next
  END ;
  RAISE IndexError
END MemberNode ;

PROCEDURE NameAt (obj: PTR Node ; i: I64) : STR
  RAISES TypeMismatch, IndexError =
VAR p : PTR Node ;
BEGIN
  p := MemberNode (obj, i) ;
  RETURN p.name
END NameAt ;

PROCEDURE MemberAt (obj: PTR Node ; i: I64) : PTR Node
  RAISES TypeMismatch, IndexError =
BEGIN
  RETURN MemberNode (obj, i)
END MemberAt ;

PROCEDURE AsF64 (n: PTR Node) : F64
  RAISES TypeMismatch =
BEGIN
  CASE n.v OF
  | Num (r, i, isInt) :
      IF isInt THEN RETURN F64 (i) END ;
      RETURN r
  ELSE
    RAISE TypeMismatch ('number expected')
  END
END AsF64 ;

PROCEDURE AsBool (n: PTR Node) : BOOL
  RAISES TypeMismatch =
BEGIN
  CASE n.v OF
  | Bool (b) : RETURN b
  ELSE
    RAISE TypeMismatch ('true or false expected')
  END
END AsBool ;

PROCEDURE AsStr (n: PTR Node) : STR
  RAISES TypeMismatch =
BEGIN
  CASE n.v OF
  | Str (t) : RETURN t
  ELSE RAISE TypeMismatch ('expected a string')
  END
END AsStr ;

PROCEDURE StrIs (n: PTR Node ; RO s: STR) : BOOL =
BEGIN
  CASE n.v OF
  | Str (t) : RETURN DynStr.Eq (t, s)
  ELSE RETURN FALSE
  END
END StrIs ;

PROCEDURE ReprText (r: F64) : STR
  RAISES ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  (* built in a scratch pool that dies here; the answer is re-homed
     into the caller's frame at exit (par 2.3) *)
  d := DynStr.New (scratch) ;
  AppendF64 (d, r) ;
  RETURN DynStr.View (d)
END ReprText ;

PROCEDURE NumText (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  IF LEN (n.raw) > 0 THEN RETURN n.raw END ;
  CASE n.v OF
  | Num (r, i, isInt) :
      d := DynStr.New (scratch) ;
      IF isInt THEN
        DynStr.AppendI64 (d, i)
      ELSE
        AppendF64 (d, r)
      END ;
      RETURN DynStr.View (d)
  ELSE RAISE TypeMismatch ('number expected')
  END
END NumText ;

(* a copy of s in the pool dst lives in (rule 2): the payloads and
   member names of a clone share their tree's pool *)
PROCEDURE CopyStrTo (VAR dst: PTR Node ; RO s: STR) : STR =
VAR
  c : STR ;
  i : I64 ;
BEGIN
  c := NEW (dst, CHAR, LEN (s)) ;
  FOR i := 0 TO LEN (s) - 1 DO c[i] := s[i] END ;
  RETURN c
END CopyStrTo ;

PROCEDURE Clone (n: PTR Node) : PTR Node
  RAISES TypeMismatch =
VAR c : PTR Node ;
BEGIN
  c := NEW (Node) ;
  CopyInto (c, c, n) ;
  RETURN c
END Clone ;

PROCEDURE CloneIn (VAR pool: POOL ; n: PTR Node) : PTR Node IN pool
  RAISES TypeMismatch =
VAR c : PTR Node IN pool ;
BEGIN
  c := NEW (pool, Node) ;
  CopyInto (c, c, n) ;
  RETURN c
END CloneIn ;

(* the deep copy itself: c already exists, in the frame or in a pool,
   and every node, payload and name the copy makes is allocated where
   the ROOT lives -- root is the clone's root, carried down the
   recursion as its own VAR parameter so that NEW (root, T) names the
   tree's pool at every depth; a child held in a local would name
   this frame instead (rule 2 reads the pool off the argument's root,
   and a pool-less local is the frame), which is how the first
   CloneIn handed back grandchildren that died with the copy.  So
   Clone and CloneIn differ only in where the root was made.  The
   member chains are linked here as the parser links them, not
   through Set and Add, which KEEP their object and would want c
   declared so. *)
PROCEDURE CopyInto (VAR root: PTR Node ; VAR c: PTR Node ; n: PTR Node)
  RAISES TypeMismatch =
VAR
  cc : PTR Node ;
  cur, head, last : OPT PTR Node ;
  k : I64 ;
BEGIN
  CASE n.v OF
  | Object (first) :
      head := NONE ; last := NONE ;
      cur := first ;
      WHILE cur IS SOME p DO
        cc := NEW (root, Node) ;
        CopyInto (root, cc, p) ;
        cc.name := CopyStrTo (root, p.name) ;
        cc.next := NONE ;
        IF last IS SOME lp THEN lp.next := SOME (cc) ELSE head := SOME (cc) END ;
        last := SOME (cc) ;
        cur := p.next
      END ;
      c.v := Value.Object (head)
  | Arr (first, count) :
      head := NONE ; last := NONE ; k := 0 ;
      cur := first ;
      WHILE cur IS SOME p DO
        cc := NEW (root, Node) ;
        CopyInto (root, cc, p) ;
        cc.next := NONE ;
        IF last IS SOME lp THEN lp.next := SOME (cc) ELSE head := SOME (cc) END ;
        last := SOME (cc) ;
        k := k + 1 ;
        cur := p.next
      END ;
      c.v := Value.Arr (head, k)
  | Str (t) :
      (* THE PAYLOAD IS COPIED, and that is the difference between a
         clone and a share.  A Str's `s` is a VIEW -- of document text
         when the node came from Parse, of a builder's buffer when it
         came from NewStr -- and a clone into a DIFFERENT pool that
         kept the view would dangle the moment the source pool went
         away.  Nothing in the type system can see it: a POOL is not
         part of a STR's type, and the ICOS ObsPack builder segfaulted
         on exactly this, with the member NAMES dangling too.  The
         names are copied above for the same reason. *)
      c.v := Value.Str (CopyStrTo (root, t))
  (* Num, Bool, Null: the variant IS the value -- rebuilt arm by arm,
     so that the checker sees scalars copied and not n's storage
     shared (`c.v := n.v' under an ELSE read as a retention of n once
     a record value counted as one, 2026-10-08) *)
  | Num (r, i, isInt) :
      c.v := Value.Num (r, i, isInt) ;
      IF LEN (n.raw) > 0 THEN c.raw := CopyStrTo (root, n.raw) END
  | Bool (b) :
      c.v := Value.Bool (b)
  | Null :
      c.v := Value.Null
  END
END CopyInto ;

PROCEDURE AppendJString (VAR d: PTR DynStr.DString ; RO t: STR)
  RAISES ValueRange =
BEGIN
  EmitJStr (d, t)
END AppendJString ;

PROCEDURE HasBackslash (RO t: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (t) - 1 DO
    IF ORD (t[i]) = 92 THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasBackslash ;

PROCEDURE HexVal (ch: CHAR) : I64 =
  (* -1 when ch is not a hex digit *)
BEGIN
  IF ch >= '0' AND ch <= '9' THEN RETURN ORD (ch) - ORD ('0') END ;
  IF ch >= 'a' AND ch <= 'f' THEN
    RETURN ORD (ch) - ORD ('a') + 10
  END ;
  IF ch >= 'A' AND ch <= 'F' THEN
    RETURN ORD (ch) - ORD ('A') + 10
  END ;
  RETURN -1
END HexVal ;

PROCEDURE Hex4 (RO t: STR ; at: I64) : I64
  RAISES TypeMismatch =
  (* four hex digits of a unicode escape, starting at 'at' *)
VAR v, k, h : I64 ;
BEGIN
  IF at + 3 >= LEN (t) THEN
    RAISE TypeMismatch ('truncated unicode escape')
  END ;
  v := 0 ;
  FOR k := 0 TO 3 DO
    h := HexVal (t[at + k]) ;
    IF h < 0 THEN
      RAISE TypeMismatch ('bad hex in unicode escape')
    END ;
    v := v * 16 + h
  END ;
  RETURN v
END Hex4 ;

PROCEDURE DecodeStr (RO t: STR) : STR
  RAISES TypeMismatch, ValueRange =
  (* the raw source text of a parsed string, decoded json.loads'
     way.  Escape-free input answers the input view unchanged; a
     decoded one is built in a scratch pool and re-homed out (par
     2.3).                                                          *)
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  i, v, lo : I64 ;
  ch : CHAR ;
BEGIN
  IF NOT HasBackslash (t) THEN RETURN t END ;
  d := DynStr.New (scratch) ;
  i := 0 ;
  WHILE i < LEN (t) DO
    ch := t[i] ;
    IF ORD (ch) = 92 THEN
      IF i + 1 >= LEN (t) THEN
        RAISE TypeMismatch ('escape at end of string')
      END ;
      ch := t[i + 1] ;
      i := i + 2 ;
      IF ch = '"' OR ch = '/' OR ORD (ch) = 92 THEN
        DynStr.AppendChar (d, ch)
      ELSIF ch = 'b' THEN DynStr.AppendChar (d, 08C)
      ELSIF ch = 't' THEN DynStr.AppendChar (d, 09C)
      ELSIF ch = 'n' THEN DynStr.AppendChar (d, 0AC)
      ELSIF ch = 'f' THEN DynStr.AppendChar (d, 0CC)
      ELSIF ch = 'r' THEN DynStr.AppendChar (d, 0DC)
      ELSIF ch = 'u' THEN
        v := Hex4 (t, i) ;
        i := i + 4 ;
        IF v >= 55296 AND v <= 56319 THEN
          (* high surrogate: only legal with a low one right after *)
          IF i + 5 < LEN (t) AND ORD (t[i]) = 92 AND
             t[i + 1] = 'u' THEN
            lo := Hex4 (t, i + 2) ;
            IF lo < 56320 OR lo > 57343 THEN
              RAISE TypeMismatch ('lone surrogate in unicode escape')
            END ;
            v := 65536 + (v - 55296) * 1024 + (lo - 56320) ;
            i := i + 6
          ELSE
            RAISE TypeMismatch ('lone surrogate in unicode escape')
          END
        ELSIF v >= 56320 AND v <= 57343 THEN
          RAISE TypeMismatch ('lone surrogate in unicode escape')
        END ;
        DynStr.AppendChar (d, CHR (v))
      ELSE
        RAISE TypeMismatch ('unknown escape in string')
      END
    ELSE
      DynStr.AppendChar (d, ch) ;
      i := i + 1
    END
  END ;
  RETURN DynStr.View (d)
END DecodeStr ;

PROCEDURE Text (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange =
BEGIN
  CASE n.v OF
  | Str (t) : RETURN DecodeStr (t)
  ELSE RAISE TypeMismatch ('expected a string')
  END
END Text ;

PROCEDURE EmitJStr (VAR d: PTR DynStr.DString ;
                    RO t: STR)
  RAISES ValueRange =
BEGIN
  DynStr.AppendChar (d, '"') ;
  EscapeBody (d, t) ;
  DynStr.AppendChar (d, '"')
END EmitJStr ;

(* the same escaping WITHOUT the quotes: what a Str node's payload
   holds, since that payload is document text *)
PROCEDURE EscapeBody (VAR d: PTR DynStr.DString ;
                      RO t: STR)
  RAISES ValueRange =
VAR
  i, v : I64 ;
  ch : CHAR ;
BEGIN
  FOR i := 0 TO LEN (t) - 1 DO
    ch := t[i] ;
    v := ORD (ch) ;
    IF ch = '"' THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, '"')
    ELSIF v = 92 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 05CC)
    ELSIF v = 8 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 'b')
    ELSIF v = 9 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 't')
    ELSIF v = 10 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 'n')
    ELSIF v = 12 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 'f')
    ELSIF v = 13 THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, 'r')
    ELSIF v < 32 THEN
      DynStr.Append (d, '\u00') ;
      DynStr.AppendChar (d, HexDigit (v DIV 16)) ;
      DynStr.AppendChar (d, HexDigit (v MOD 16))
    ELSE
      DynStr.AppendChar (d, ch)
    END
  END
END EscapeBody ;

PROCEDURE HexDigit (v: I64) : CHAR
  RAISES ValueRange =
  (* the CHR the checker counts; v is DIV/MOD 16 of a control code,
     so it cannot fire *)
BEGIN
  IF v < 10 THEN RETURN CHR (ORD ('0') + v) END ;
  RETURN CHR (ORD ('a') + v - 10)
END HexDigit ;

PROCEDURE EmitVal (VAR d: PTR DynStr.DString ;
                   n: PTR Node ; spaced: BOOL)
  RAISES TypeMismatch, ValueRange =
VAR
  c : OPT PTR Node ;
  sep : BOOL ;
BEGIN
  CASE n.v OF
  | Object (first) :
      DynStr.AppendChar (d, '{') ;
      c := first ;
      sep := FALSE ;
      WHILE c IS SOME p DO
        IF sep THEN
          DynStr.AppendChar (d, ',') ;
          IF spaced THEN DynStr.AppendChar (d, ' ') END
        END ;
        sep := TRUE ;
        EmitJStr (d, DecodeStr (p.name)) ;
        DynStr.AppendChar (d, ':') ;
        IF spaced THEN DynStr.AppendChar (d, ' ') END ;
        EmitVal (d, p, spaced) ;
        c := p.next
      END ;
      DynStr.AppendChar (d, '}')
  | Arr (first, count) :
      DynStr.AppendChar (d, '[') ;
      c := first ;
      sep := FALSE ;
      WHILE c IS SOME p DO
        IF sep THEN
          DynStr.AppendChar (d, ',') ;
          IF spaced THEN DynStr.AppendChar (d, ' ') END
        END ;
        sep := TRUE ;
        EmitVal (d, p, spaced) ;
        c := p.next
      END ;
      DynStr.AppendChar (d, ']')
  | Str (t) :
      EmitJStr (d, DecodeStr (t))
  | Num (r, i, isInt) :
      IF LEN (n.raw) > 0 THEN
        DynStr.Append (d, n.raw)
      ELSIF isInt THEN
        DynStr.AppendI64 (d, i)
      ELSE
        AppendF64 (d, r)
      END
  | Bool (b) :
      IF b THEN
        DynStr.Append (d, 'true')
      ELSE
        DynStr.Append (d, 'false')
      END
  | Null :
      DynStr.Append (d, 'null')
  END
END EmitVal ;

(* a float exactly as json.dumps renders it: Python repr for finite
   values, the NaN / Infinity / -Infinity tokens otherwise *)
PROCEDURE AppendF64 (VAR d: PTR DynStr.DString ;
                     r: F64)
  RAISES ValueRange =
VAR
  buf : ARRAY 32 OF BYTE ;
  n, i : I64 ;
BEGIN
  IF r # r THEN
    DynStr.Append (d, 'NaN') ;
    RETURN
  END ;
  IF r > MAX (F64) THEN
    DynStr.Append (d, 'Infinity') ;
    RETURN
  END ;
  IF r < 0.0 - MAX (F64) THEN
    DynStr.Append (d, '-Infinity') ;
    RETURN
  END ;
  n := I64 (ReprF64 (C.Double (r), ADR (buf))) ;
  FOR i := 0 TO n - 1 DO
    DynStr.AppendChar (d, CHR (I64 (buf[i])))
  END
END AppendF64 ;

PROCEDURE Compact (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  d := DynStr.New (scratch) ;
  EmitVal (d, n, FALSE) ;
  RETURN DynStr.View (d)
END Compact ;

PROCEDURE Spaced (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  d := DynStr.New (scratch) ;
  EmitVal (d, n, TRUE) ;
  RETURN DynStr.View (d)
END Spaced ;

TYPE
  NodeP = PTR Node ;             (* NEW takes a NAMED element type *)

PROCEDURE EmitSorted (VAR d: PTR DynStr.DString ;
                      n: PTR Node)
  RAISES TypeMismatch, ValueRange, IndexError =
VAR
  c : OPT PTR Node ;
  ms : SLICE OF NodeP ;
  nms : SLICE OF STR ;
  cnt, i, j : I64 ;
  t : NodeP ;
  ns : STR ;
  sep : BOOL ;
BEGIN
  CASE n.v OF
  | Object (first) :
      cnt := 0 ;
      c := first ;
      WHILE c IS SOME p DO
        cnt := cnt + 1 ;
        c := p.next
      END ;
      ms := NEW (d, NodeP, cnt) ;
      nms := NEW (d, STR, cnt) ;
      cnt := 0 ;
      c := first ;
      WHILE c IS SOME p DO
        ms[cnt] := p ;
        (* sort_keys orders by the DECODED name, so decode before
           the sort as well as for the emission *)
        nms[cnt] := DecodeStr (p.name) ;
        cnt := cnt + 1 ;
        c := p.next
      END ;
      FOR i := 1 TO cnt - 1 DO
        j := i ;
        WHILE j > 0 AND NameLess (nms[j], nms[j - 1]) DO
          t := ms[j] ;
          ms[j] := ms[j - 1] ;
          ms[j - 1] := t ;
          ns := nms[j] ;
          nms[j] := nms[j - 1] ;
          nms[j - 1] := ns ;
          j := j - 1
        END
      END ;
      DynStr.AppendChar (d, '{') ;
      sep := FALSE ;
      FOR i := 0 TO cnt - 1 DO
        IF sep THEN DynStr.AppendChar (d, ',') END ;
        sep := TRUE ;
        EmitJStr (d, nms[i]) ;
        DynStr.AppendChar (d, ':') ;
        EmitSorted (d, ms[i])
      END ;
      DynStr.AppendChar (d, '}')
  | Arr (first, count) :
      DynStr.AppendChar (d, '[') ;
      c := first ;
      sep := FALSE ;
      WHILE c IS SOME p DO
        IF sep THEN DynStr.AppendChar (d, ',') END ;
        sep := TRUE ;
        EmitSorted (d, p) ;
        c := p.next
      END ;
      DynStr.AppendChar (d, ']')
  ELSE
    EmitVal (d, n, FALSE)
  END
END EmitSorted ;

(* json.dumps sorts by the decoded string's code points; the
   compare runs over decoded names (EmitSorted decodes before the
   sort), scalar by scalar *)
PROCEDURE NameLess (RO a: STR ; RO b: STR) : BOOL =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (a) AND i < LEN (b) DO
    IF a[i] # b[i] THEN RETURN a[i] < b[i] END ;
    i := i + 1
  END ;
  RETURN LEN (a) < LEN (b)
END NameLess ;

PROCEDURE CompactSorted (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange, IndexError =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  d := DynStr.New (scratch) ;
  EmitSorted (d, n) ;
  RETURN DynStr.View (d)
END CompactSorted ;

PROCEDURE Indent (VAR d: PTR DynStr.DString ;
                  depth: I64)
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  DynStr.AppendChar (d, 0AC) ;
  FOR i := 1 TO depth * 2 DO
    DynStr.AppendChar (d, ' ')
  END
END Indent ;

PROCEDURE EmitPretty (VAR d: PTR DynStr.DString ;
                      n: PTR Node ; depth: I64)
  RAISES TypeMismatch, ValueRange =
VAR
  c : OPT PTR Node ;
  sep : BOOL ;
  cnt : I64 ;
BEGIN
  CASE n.v OF
  | Object (first) :
      cnt := 0 ;
      c := first ;
      WHILE c IS SOME p DO
        cnt := cnt + 1 ;
        c := p.next
      END ;
      IF cnt = 0 THEN
        DynStr.Append (d, '{}') ;
        RETURN
      END ;
      c := first ;
      DynStr.AppendChar (d, '{') ;
      sep := FALSE ;
      WHILE c IS SOME p DO
        IF sep THEN DynStr.AppendChar (d, ',') END ;
        sep := TRUE ;
        Indent (d, depth + 1) ;
        EmitJStr (d, DecodeStr (p.name)) ;
        DynStr.Append (d, ': ') ;
        EmitPretty (d, p, depth + 1) ;
        c := p.next
      END ;
      Indent (d, depth) ;
      DynStr.AppendChar (d, '}')
  | Arr (first, count) :
      IF count = 0 THEN
        DynStr.Append (d, '[]') ;
        RETURN
      END ;
      c := first ;
      DynStr.AppendChar (d, '[') ;
      sep := FALSE ;
      WHILE c IS SOME p DO
        IF sep THEN DynStr.AppendChar (d, ',') END ;
        sep := TRUE ;
        Indent (d, depth + 1) ;
        EmitPretty (d, p, depth + 1) ;
        c := p.next
      END ;
      Indent (d, depth) ;
      DynStr.AppendChar (d, ']')
  ELSE
    EmitVal (d, n, FALSE)
  END
END EmitPretty ;

PROCEDURE Pretty (n: PTR Node) : STR
  RAISES TypeMismatch, ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  d := DynStr.New (scratch) ;
  EmitPretty (d, n, 0) ;
  RETURN DynStr.View (d)
END Pretty ;

PROCEDURE IsNull (n: PTR Node) : BOOL =
BEGIN
  CASE n.v OF
  | Null : RETURN TRUE
  ELSE RETURN FALSE
  END
END IsNull ;

(* ---- building a document: the bodies (moved here from the DEFINITION
   module 2026-09-27, where six of them had sat, compiled and shipped,
   and documented twice in docs/modules/Json.md; review F7) ---- *)

PROCEDURE NewObj () : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Object (NONE) ;
  RETURN n
END NewObj ;

PROCEDURE NewArr () : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Arr (NONE, 0) ;
  RETURN n
END NewArr ;

PROCEDURE NewStr (RO s: STR) : PTR Node
  RAISES ValueRange =
VAR
  n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Str (Name (s)) ;
  RETURN n
END NewStr ;

PROCEDURE NewI64 (v: I64) : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Num (F64 (v), v, TRUE) ;
  RETURN n
END NewI64 ;

PROCEDURE Name (RO s: STR) : STR
  RAISES ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
BEGIN
  d := DynStr.New (scratch) ;
  EscapeBody (d, s) ;
  RETURN DynStr.View (d)
END Name ;

PROCEDURE NewF64 (r: F64) : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  (* the integer slot is unread while isInt is FALSE; 0 rather than a
     conversion that could trap on a huge or non-finite r *)
  n.v := Value.Num (r, 0, FALSE) ;
  RETURN n
END NewF64 ;

PROCEDURE NewBool (b: BOOL) : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Bool (b) ;
  RETURN n
END NewBool ;

PROCEDURE NewNull () : PTR Node =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := Value.Null ;
  RETURN n
END NewNull ;

PROCEDURE NewObjIn (VAR pool: POOL) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Object (NONE) ;
  RETURN n
END NewObjIn ;

PROCEDURE NewArrIn (VAR pool: POOL) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Arr (NONE, 0) ;
  RETURN n
END NewArrIn ;

PROCEDURE NewStrIn (VAR pool: POOL ; RO s: STR) : PTR Node IN pool
  RAISES ValueRange =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  (* Name escapes into this frame; the payload is copied beside the
     node, so the tree holds no view into a frame that ends here *)
  n.v := Value.Str (CopyStrTo (n, Name (s))) ;
  RETURN n
END NewStrIn ;

PROCEDURE NewI64In (VAR pool: POOL ; v: I64) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Num (F64 (v), v, TRUE) ;
  RETURN n
END NewI64In ;

PROCEDURE NewF64In (VAR pool: POOL ; r: F64) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Num (r, 0, FALSE) ;
  RETURN n
END NewF64In ;

(* the value of a raw number's text, through the parser itself, so
   that what it accepts is exactly JSON's number grammar *)
PROCEDURE RawValue (RO text: STR) : Value
  RAISES ParseError, TypeMismatch =
VAR t : PTR Node ;
BEGIN
  t := Parse (text) ;
  CASE t.v OF
  | Num (r, i, isInt) : RETURN Value.Num (r, i, isInt)
  ELSE RAISE TypeMismatch ('a raw value is one JSON number')
  END
END RawValue ;

PROCEDURE NewRaw (RO text: STR) : PTR Node
  RAISES ParseError, TypeMismatch =
VAR n : PTR Node ;
BEGIN
  n := NEW (Node) ;
  n.v := RawValue (text) ;
  n.raw := CopyStrTo (n, text) ;
  RETURN n
END NewRaw ;

PROCEDURE NewRawIn (VAR pool: POOL ; RO text: STR) : PTR Node IN pool
  RAISES ParseError, TypeMismatch =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := RawValue (text) ;
  n.raw := CopyStrTo (n, text) ;
  RETURN n
END NewRawIn ;

PROCEDURE NewBoolIn (VAR pool: POOL ; b: BOOL) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Bool (b) ;
  RETURN n
END NewBoolIn ;

PROCEDURE NewNullIn (VAR pool: POOL) : PTR Node IN pool =
VAR n : PTR Node IN pool ;
BEGIN
  n := NEW (pool, Node) ;
  n.v := Value.Null ;
  RETURN n
END NewNullIn ;

PROCEDURE Set (VAR KEPT obj: PTR Node ; RO KEPT name: STR ;
               VAR KEPT v: PTR Node)
  RAISES TypeMismatch =
VAR
  cur, prev : OPT PTR Node ;
BEGIN
  CASE obj.v OF
  | Object (first) : cur := first
  ELSE RAISE TypeMismatch ('Set on a node that is not an object')
  END ;
  v.name := name ;
  prev := NONE ;
  WHILE cur IS SOME p DO
    IF DynStr.Eq (p.name, name) THEN
      (* REPLACE IN PLACE: the new node takes the old one's position
         and its tail, so the member order does not move.  The old
         node is left to the pool, which is what a pool is for. *)
      v.next := p.next ;
      IF prev IS SOME q THEN
        q.next := SOME (v)
      ELSE
        obj.v := Value.Object (SOME (v))
      END ;
      RETURN
    END ;
    prev := SOME (p) ;
    cur := p.next
  END ;
  v.next := NONE ;
  IF prev IS SOME q THEN
    q.next := SOME (v)
  ELSE
    obj.v := Value.Object (SOME (v))
  END
END Set ;

PROCEDURE Add (VAR KEPT arr: PTR Node ; VAR KEPT v: PTR Node)
  RAISES TypeMismatch =
VAR
  cur, prev, head : OPT PTR Node ;
  k : I64 ;
BEGIN
  (* the head is read out HERE, because rebuilding the variant with
     the new count is the only way to store it and CASE is the only
     way back in *)
  CASE arr.v OF
  | Arr (first, count) : head := first ; cur := first ; k := count
  ELSE RAISE TypeMismatch ('Add on a node that is not an array')
  END ;
  v.next := NONE ;
  prev := NONE ;
  WHILE cur IS SOME p DO
    prev := SOME (p) ;
    cur := p.next
  END ;
  IF prev IS SOME q THEN
    q.next := SOME (v) ;
    arr.v := Value.Arr (head, k + 1)
  ELSE
    arr.v := Value.Arr (SOME (v), k + 1)
  END
END Add ;

END Json.
