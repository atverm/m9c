MODULE FmtTest ;

(* Fmt, tested in M9 (runtime/test/m9test.sh runs every *Test.m9
   beside its module): Short, ParseF64, Hex, and since 2026-10-10
   Fixed and Sci, exact now and held to printf's digits through
   Python's %-formatting.  runtime/test/fmt_driver.c keeps Bits and
   the padding forms.

   Short against Python's repr: runtime/test/gold/Fmt.gold, written by
   tools/fmtgold.py, inputs as Fmt.Bits so no decimal parser stands
   between the oracle and the test. *)

IMPORT Check ;
IMPORT Fmt ;
IMPORT Io ;
IMPORT Text ;

CONST
  Parts = ['hand', 'pow2', 'pow10', 'ints', 'ties', 'data', 'random'] ;
  Says = ['the cases a shortest printer gets wrong first',
          'every power of two, and neighbours every eighth exponent',
          'every power of ten and its neighbours, both signs',
          'integers, up to 2^63 and 10^17',
          'ties in the 17th digit: the even one',
          'values a data file holds',
          'random bit patterns'] ;

VAR
  t : Check.T ;
  pool : POOL ;
  i : I64 ;

PROCEDURE Part (RO name, says: STR) =
VAR
  gold : STR ;
  xs : SLICE OF F64 ;
  got : SLICE OF STR ;
  i : I64 ;
BEGIN
  gold := Check.GoldPath ('Fmt.gold') ;
  xs := Check.GoldF64s (t, gold, name + '.x') ;
  got := NEW (pool, STR, LEN (xs)) ;
  FOR i := 0 TO LEN (xs) - 1 DO got[i] := Text.Keep (pool, Fmt.Short (xs[i])) END ;
  Check.EqStrs (t, 'Short = repr: ' + says, got, Check.GoldStrs (t, gold, name + '.want'))
END Part ;

(* ParseF64 = Python's float(): the correctly rounded double, held to
   the bit on 2,413 strings (tools/fmtgold.py: data reprs, mantissa-
   and-exponent strings over the whole range, twenty-digit fractions,
   the hard cases) -- 1,314 of a like set were wrong before 2026-10-09 *)
PROCEDURE Parses () =
VAR
  gold : STR ;
  ins : SLICE OF STR ;
  want : SLICE OF F64 ;
  i, right : I64 ;
BEGIN
  gold := Check.GoldPath ('Fmt.gold') ;
  ins := Check.GoldStrs (t, gold, 'parse.in') ;
  want := Check.GoldF64s (t, gold, 'parse.want') ;
  right := 0 ;
  FOR i := 0 TO LEN (ins) - 1 DO
    IF Text.Eq (Fmt.Bits (Fmt.ParseF64 (ins[i])), Fmt.Bits (want[i])) THEN right := right + 1 END
  END ;
  Check.That (t, 'the golden file has parse cases', LEN (ins) > 2000) ;
  Check.EqI64 (t, 'ParseF64 = float (): every string to the bit', right, LEN (ins))
EXCEPT
| ValueRange : Check.That (t, 'ParseF64 refused a golden string', FALSE)
| IndexError : Check.That (t, 'the parse golden lines differ in length', FALSE)
END Parses ;

(* Fixed = '%.*f' and Sci = '%.*e' with the exponent written short,
   each value at its own decimals: the hand cases at 0, 2, 6 and 17,
   exact ties (an odd o times 2^-(d+1)), data values, powers of two
   and ten, random bit patterns -- 1e308 at 17 decimals included *)
PROCEDURE Formats () =
VAR
  gold : STR ;
  xs : SLICE OF F64 ;
  ds : SLICE OF I64 ;
  fixed, sci : SLICE OF STR ;
  i : I64 ;
BEGIN
  gold := Check.GoldPath ('Fmt.gold') ;
  xs := Check.GoldF64s (t, gold, 'fmt.x') ;
  ds := Check.GoldI64s (t, gold, 'fmt.d') ;
  fixed := NEW (pool, STR, LEN (xs)) ;
  sci := NEW (pool, STR, LEN (xs)) ;
  FOR i := 0 TO LEN (xs) - 1 DO
    fixed[i] := Text.Keep (pool, Fmt.Fixed (xs[i], ds[i])) ;
    sci[i] := Text.Keep (pool, Fmt.Sci (xs[i], ds[i]))
  END ;
  Check.That (t, 'the golden file has format cases', LEN (xs) > 1000) ;
  Check.EqStrs (t, 'Fixed = printf %.*f', fixed, Check.GoldStrs (t, gold, 'fixed.want')) ;
  Check.EqStrs (t, 'Sci = printf %.*e, the exponent short', sci, Check.GoldStrs (t, gold, 'sci.want'))
EXCEPT
| ValueRange : Check.That (t, 'Fixed or Sci refused a golden value', FALSE)
| IndexError : Check.That (t, 'the format golden lines differ in length', FALSE)
END Formats ;

PROCEDURE TooMany () : BOOL =
VAR s : STR ;
BEGIN
  s := Fmt.Fixed (1.0, Fmt.MaxDecimals + 1) ;
  RETURN FALSE
EXCEPT
| ValueRange : RETURN TRUE
END TooMany ;

PROCEDURE Refused (RO s: STR) : BOOL =
VAR v : F64 ;
BEGIN
  v := Fmt.ParseF64 (s) ;
  RETURN FALSE
EXCEPT
| ValueRange : RETURN TRUE
END Refused ;

BEGIN
  Parses () ;
  Formats () ;
  Check.That (t, 'Fixed refuses more than MaxDecimals', TooMany ()) ;
  Check.That (t, 'ParseF64 refuses a decimal beyond the largest double', Refused ('1.7976931348623159e308')) ;
  Check.That (t, 'and its negative', Refused ('-1e400')) ;
  Check.That (t, 'and what is no decimal: a hex float', Refused ('0x1p3')) ;
  Check.That (t, 'and an empty exponent', Refused ('1e')) ;
  Check.That (t, 'and a leading blank, which strtod would skip', Refused (' 1')) ;
  (* by hand, so that a reader sees the layout without the golden *)
  Check.EqStr (t, 'Short 0.1', Fmt.Short (0.1), '0.1') ;
  Check.EqStr (t, 'Short 0.1 + 0.2', Fmt.Short (0.1 + 0.2), '0.30000000000000004') ;
  Check.EqStr (t, 'Short 1.0 keeps its point', Fmt.Short (1.0), '1.0') ;
  Check.EqStr (t, 'Short -0.0 keeps its sign', Fmt.Short (-0.0), '-0.0') ;
  Check.EqStr (t, 'Short 1e16 goes scientific', Fmt.Short (1.0E16), '1e+16') ;
  Check.EqStr (t, 'Short 1e15 does not', Fmt.Short (1.0E15), '1000000000000000.0') ;
  Check.EqStr (t, 'Short 0.0001 stays positional', Fmt.Short (0.0001), '0.0001') ;
  Check.EqStr (t, 'Short 0.00001 does not', Fmt.Short (0.00001), '1e-05') ;
  Check.EqStr (t, 'Short NaN', Fmt.Short (NaN), 'nan') ;
  (* Hex, held to Python's '%0*x' (cp-kernel's issue 16) *)
  Check.EqStr (t, 'Hex of a CRC, eight digits', Fmt.Hex (3421780262, 8), 'cbf43926') ;
  Check.EqStr (t, 'Hex 255 in four', Fmt.Hex (255, 4), '00ff') ;
  Check.EqStr (t, 'Hex 0 in no width is one digit', Fmt.Hex (0, 0), '0') ;
  Check.EqStr (t, 'Hex never truncates: 4096 in two', Fmt.Hex (4096, 2), '1000') ;
  Check.EqStr (t, 'Hex of -1 is its 64-bit pattern', Fmt.Hex (-1, 0), 'ffffffffffffffff') ;
  Check.EqStr (t, 'Hex of the smallest I64', Fmt.Hex (-9223372036854775807 - 1, 0), '8000000000000000') ;
  Check.EqStr (t, 'Hex of the largest I64', Fmt.Hex (9223372036854775807, 0), '7fffffffffffffff') ;
  FOR i := 0 TO LEN (Parts) - 1 DO Part (Parts[i], Says[i]) END ;
  Io.Halt (Check.Done (t, 'Fmt'))
END FmtTest.
