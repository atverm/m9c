DEFINITION MODULE Palette ;

(* a small enumeration in its own module, so EnumUse can import it --
   the cross-module half of the type family (docs/enum-plan.md) *)

TYPE Hue = (Warm, Cool, Neutral) ;

TYPE Weights = RECORD
  w : ARRAY Hue OF I64 ;   (* an enum-indexed array as a record field *)
END ;

PROCEDURE Warmest () : Hue ;
PROCEDURE MakeWeights () : Weights ;

END Palette.

IMPLEMENTATION MODULE Palette ;

PROCEDURE Warmest () : Hue =
BEGIN
  RETURN Hue.Warm
END Warmest ;

PROCEDURE MakeWeights () : Weights =
VAR wt : Weights ; h : Hue ;
BEGIN
  FOR h := Hue.Warm TO Hue.Neutral DO wt.w[h] := ORD (h) * 10 END ;
  RETURN wt
END MakeWeights ;

END Palette.
