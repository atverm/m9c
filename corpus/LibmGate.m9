DEFINITION MODULE LibmGate ;

PROCEDURE Zero () : F32 ;

END LibmGate.

IMPLEMENTATION MODULE LibmGate ;

(* A gate fixture, not a library anyone calls: its locals are named
   after every libm function CN escapes (96 of them), so the
   generated C carries each as name_.  gendiff byte-compares both
   generators over this file, so a one-sided edit to their IsLibM lists
   becomes a byte difference; libmgate.sh then greps the output to
   prove the escaping is present, not merely consistent. *)
PROCEDURE Zero () : F32 =
VAR
  acos, acosf, acosh, acoshf, asin, asinf,
  asinh, asinhf, atan, atanf, atan2, atan2f,
  atanh, atanhf, cbrt, cbrtf, ceil, ceilf,
  copysign, copysignf, cos, cosf, cosh, coshf,
  erf, erff, erfc, erfcf, exp, expf,
  exp2, exp2f, expm1, expm1f, fabs, fabsf,
  fdim, fdimf, floor, floorf, fma, fmaf,
  fmax, fmaxf, fmin, fminf, fmod, fmodf,
  frexp, frexpf, hypot, hypotf, ldexp, ldexpf,
  lgamma, lgammaf, log, logf, log10, log10f,
  log1p, log1pf, log2, log2f, modf, modff,
  nan, nanf, nearbyint, nearbyintf, nextafter, nextafterf,
  pow, powf, remainder, remainderf, rint, rintf,
  round, roundf, scalbn, scalbnf, sin, sinf,
  sinh, sinhf, sqrt, sqrtf, tan, tanf,
  tanh, tanhf, tgamma, tgammaf, trunc, truncf : F32 ;
BEGIN
  RETURN F32 (0.0)
END Zero ;

END LibmGate.
