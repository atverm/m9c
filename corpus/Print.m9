DEFINITION MODULE Print ;

(* Canonical form, in M9 -- restated from host/fpc/M9Print.pas,
   append-order-faithful so the emitted bytes are the oracle's bytes.
   One layout, deterministic; the P5 differential compares this
   module's output against the FPC printer over the whole corpus.    *)

IMPORT Ast ;

PROCEDURE Tree (VAR pool: POOL ; root: PTR Ast.Node) : STR ;
  (* the whole tree back as CANONICAL M9 source: one spelling per
     construct, chosen by this module rather than recovered from the
     input.

     COMMENTS AND LAYOUT DO NOT SURVIVE, and cannot: comments are
     never tokens, so the parser has not seen them.  What is
     promised instead is checked by parsetest -- printing is a
     fixpoint, and re-lexing the output yields the source's own
     token sequence.  So Tree round-trips the PROGRAM, not the
     file.

       root -- the NFile node from Parse.File.  A tree with parse
               errors in it prints whatever was recovered, which is
               why the caller checks p.nerr first.                 *)

(* canonical fragments, for the checker: def and impl signatures are
   compared as TEXT, so the printer is what decides whether two
   declarations are the same declaration *)
PROCEDURE TypeText (VAR pool: POOL ; k: Ast.Kid) : STR ;
PROCEDURE ParamsText (k: Ast.Kid) : STR ;
PROCEDURE ExprText (k: Ast.Kid) : STR ;

END Print.


IMPLEMENTATION MODULE Print ;

IMPORT Ast ;
IMPORT DynStr ;

PROCEDURE Sp (VAR d: PTR DynStr.DString ; ind: I64) =
VAR i : I64 ;
BEGIN
  FOR i := 1 TO ind * 2 DO DynStr.AppendChar (d, ' ') END
END Sp ;

PROCEDURE Quoted (VAR d: PTR DynStr.DString ;
                  RO s: STR) =
VAR
  i : I64 ;
  hasApo : BOOL ;
  q : CHAR ;
BEGIN
  hasApo := FALSE ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = "'" THEN hasApo := TRUE END
  END ;
  IF hasApo THEN q := '"' ELSE q := "'" END ;
  DynStr.AppendChar (d, q) ;
  DynStr.Append (d, s) ;
  DynStr.AppendChar (d, q)
END Quoted ;

PROCEDURE Qual (VAR d: PTR DynStr.DString ;
                n: PTR Ast.Node) =
BEGIN
  DynStr.Append (d, n.a) ;
  IF LEN (n.b) > 0 THEN
    DynStr.AppendChar (d, '.') ;
    DynStr.Append (d, n.b)
  END
END Qual ;

PROCEDURE Idents (VAR d: PTR DynStr.DString ;
                  n: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO n.nkids - 1 DO
    IF i > 0 THEN DynStr.Append (d, ', ') END ;
    IF n.kids[i] IS SOME id THEN DynStr.Append (d, id.a) END
  END
END Idents ;

PROCEDURE E (VAR d: PTR DynStr.DString ;
             k: Ast.Kid) ;

PROCEDURE Args (VAR d: PTR DynStr.DString ;
                k: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF i > 0 THEN DynStr.Append (d, ', ') END ;
      E (d, n.kids[i])
    END
  END
END Args ;

PROCEDURE Desig (VAR d: PTR DynStr.DString ;
                 n: PTR Ast.Node) =
VAR i, j : I64 ;
BEGIN
  DynStr.Append (d, n.a) ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN
        DynStr.AppendChar (d, '.') ;
        DynStr.Append (d, sel.a)
      ELSIF sel.kind = Ast.NSelIndex THEN
        DynStr.AppendChar (d, '[') ;
        FOR j := 0 TO sel.nkids - 1 DO
          IF j > 0 THEN DynStr.Append (d, ', ') END ;
          E (d, sel.kids[j])
        END ;
        DynStr.AppendChar (d, ']')
      END
    END
  END
END Desig ;

PROCEDURE E (VAR d: PTR DynStr.DString ;
             k: Ast.Kid) =
VAR j : I64 ;
BEGIN
  IF k IS SOME n THEN
    CASE n.kind OF
    | Ast.NBin :
        E (d, n.kids[0]) ;
        DynStr.AppendChar (d, ' ') ;
        DynStr.Append (d, n.a) ;
        DynStr.AppendChar (d, ' ') ;
        E (d, n.kids[1])
    | Ast.NUn :
        IF DynStr.Eq (n.a, 'NOT') THEN
          DynStr.Append (d, 'NOT ')
        ELSE
          DynStr.Append (d, n.a)
        END ;
        E (d, n.kids[0])
    | Ast.NIs :
        E (d, n.kids[0]) ;
        DynStr.Append (d, ' IS ') ;
        IF n.kids[1] IS SOME t THEN
          IF t.kind = Ast.NIsSome THEN
            DynStr.Append (d, 'SOME ') ;
            DynStr.Append (d, t.a)
          ELSE
            Qual (d, t)
          END
        END
    | Ast.NParen :
        DynStr.AppendChar (d, '(') ;
        E (d, n.kids[0]) ;
        DynStr.AppendChar (d, ')')
    | Ast.NInt, Ast.NReal, Ast.NChar :
        DynStr.Append (d, n.a)
    | Ast.NString :
        Quoted (d, n.a)
    | Ast.NTrue : DynStr.Append (d, 'TRUE')
    | Ast.NFalse : DynStr.Append (d, 'FALSE')
    | Ast.NNoneLit : DynStr.Append (d, 'NONE')
    | Ast.NSomeExpr :
        DynStr.Append (d, 'SOME (') ;
        E (d, n.kids[0]) ;
        DynStr.AppendChar (d, ')')
    | Ast.NSharedExpr :
        DynStr.Append (d, 'SHARED (') ;
        E (d, n.kids[0]) ;
        DynStr.AppendChar (d, ')')
    | Ast.NNewExpr :
        DynStr.Append (d, 'NEW (') ;
        IF n.kids[0] IS SOME p THEN
          Desig (d, p) ;
          DynStr.Append (d, ', ')
        END ;
        (* a qualident in the single-argument form, an expression in
           the others (a type name or an extent, resolved downstream) *)
        IF n.kids[1] IS SOME q THEN
          IF q.kind = Ast.NQualident THEN Qual (d, q)
          ELSE E (d, n.kids[1]) END
        END ;
        (* one extent is a slice; more than one is the shape of a grid *)
        FOR j := 2 TO n.nkids - 1 DO
          IF n.kids[j] IS SOME c THEN
            DynStr.Append (d, ', ') ;
            E (d, n.kids[j])
          END
        END ;
        DynStr.AppendChar (d, ')')
    | Ast.NGridOf :
        DynStr.Append (d, 'GRID (') ;
        FOR j := 0 TO n.nkids - 1 DO
          IF j > 0 THEN DynStr.Append (d, ', ') END ;
          E (d, n.kids[j])
        END ;
        DynStr.AppendChar (d, ')')
    | Ast.NSliceOf3 :
        DynStr.Append (d, 'SLICE (') ;
        E (d, n.kids[0]) ;
        DynStr.Append (d, ', ') ;
        E (d, n.kids[1]) ;
        DynStr.Append (d, ', ') ;
        E (d, n.kids[2]) ;
        DynStr.AppendChar (d, ')')
    | Ast.NCallExpr :
        IF n.kids[0] IS SOME f THEN Desig (d, f) END ;
        DynStr.Append (d, ' (') ;
        Args (d, n.kids[1]) ;
        DynStr.AppendChar (d, ')')
    | Ast.NDesignator :
        Desig (d, n)
    | Ast.NQualident :
        Qual (d, n)
    | Ast.NIdent :
        DynStr.Append (d, n.a)
    | Ast.NAggregate :
        (* on one line: this is the form a diagnostic quotes.  A
           declaration prints it one element to a line, EDecl *)
        DynStr.AppendChar (d, '[') ;
        FOR j := 0 TO n.nkids - 1 DO
          IF j > 0 THEN DynStr.Append (d, ', ') END ;
          E (d, n.kids[j])
        END ;
        DynStr.AppendChar (d, ']')
    ELSE
      DynStr.Append (d, '?expr?')
    END
  END
END E ;

PROCEDURE EType (VAR d: PTR DynStr.DString ;
                 k: Ast.Kid ; ind: I64) ;

PROCEDURE Group (VAR d: PTR DynStr.DString ;
                 g: PTR Ast.Node) =
BEGIN
  IF g.f3 THEN DynStr.Append (d, 'RO ') END ;
  IF g.kids[0] IS SOME ids THEN Idents (d, ids) END ;
  DynStr.Append (d, ': ') ;
  EType (d, g.kids[1], 0)
END Group ;

PROCEDURE FieldsInline (VAR d: PTR DynStr.DString ;
                        k: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF k IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF i > 0 THEN DynStr.Append (d, ' ; ') END ;
      IF fs.kids[i] IS SOME g THEN Group (d, g) END
    END ;
    IF fs.f1 THEN DynStr.Append (d, ' ;') END
  END
END FieldsInline ;

PROCEDURE FieldsLines (VAR d: PTR DynStr.DString ;
                       k: Ast.Kid ; ind: I64) =
VAR i : I64 ;
BEGIN
  IF k IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        Sp (d, ind) ;
        IF g.f3 THEN DynStr.Append (d, 'RO ') END ;
        IF g.kids[0] IS SOME ids THEN Idents (d, ids) END ;
        DynStr.Append (d, ' : ') ;
        EType (d, g.kids[1], ind) ;
        IF (i < fs.nkids - 1) OR fs.f1 THEN
          DynStr.Append (d, ' ;')
        END ;
        DynStr.AppendChar (d, 0AC)
      END
    END
  END
END FieldsLines ;

PROCEDURE EType (VAR d: PTR DynStr.DString ;
                 k: Ast.Kid ; ind: I64) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    CASE n.kind OF
    | Ast.NQualident :
        Qual (d, n)
    | Ast.NArrayType :
        DynStr.Append (d, 'ARRAY ') ;
        E (d, n.kids[0]) ;
        DynStr.Append (d, ' OF ') ;
        EType (d, n.kids[1], ind)
    | Ast.NGridType :
        DynStr.Append (d, 'GRID ') ;
        E (d, n.kids[0]) ;
        DynStr.Append (d, ' OF ') ;
        EType (d, n.kids[1], ind)
    | Ast.NSliceType :
        DynStr.Append (d, 'SLICE OF ') ;
        EType (d, n.kids[0], ind)
    | Ast.NPtrType :
        DynStr.Append (d, 'PTR ') ;
        EType (d, n.kids[0], ind) ;
        IF n.kids[1] IS SOME pd THEN
          DynStr.Append (d, ' IN ') ;
          Desig (d, pd)
        END
    | Ast.NOptType :
        DynStr.Append (d, 'OPT ') ;
        EType (d, n.kids[0], ind)
    | Ast.NSharedType :
        DynStr.Append (d, 'SHARED PTR ') ;
        EType (d, n.kids[0], ind)
    | Ast.NRecordType :
        DynStr.Append (d, 'RECORD') ;
        IF n.kids[0] IS SOME b THEN
          DynStr.Append (d, ' (') ;
          Qual (d, b) ;
          DynStr.AppendChar (d, ')')
        END ;
        DynStr.AppendChar (d, 0AC) ;
        FieldsLines (d, n.kids[1], ind + 1) ;
        Sp (d, ind) ;
        DynStr.Append (d, 'END')
    | Ast.NCaseRecordType :
        DynStr.Append (d, 'CASE RECORD') ;
        DynStr.AppendChar (d, 0AC) ;
        FOR i := 0 TO n.nkids - 1 DO
          IF n.kids[i] IS SOME v THEN
            Sp (d, ind) ;
            DynStr.Append (d, '| ') ;
            DynStr.Append (d, v.a) ;
            IF v.kids[0] IS SOME vf THEN
              DynStr.Append (d, ' : ') ;
              FieldsInline (d, v.kids[0])
            END ;
            DynStr.AppendChar (d, 0AC)
          END
        END ;
        Sp (d, ind) ;
        DynStr.Append (d, 'END')
    | Ast.NMonitorType :
        DynStr.Append (d, 'MONITOR RECORD') ;
        DynStr.AppendChar (d, 0AC) ;
        FieldsLines (d, n.kids[0], ind + 1) ;
        Sp (d, ind) ;
        DynStr.Append (d, 'END')
    | Ast.NEnumType :
        DynStr.AppendChar (d, '(') ;
        FOR i := 0 TO n.nkids - 1 DO
          IF n.kids[i] IS SOME m THEN
            IF i > 0 THEN DynStr.Append (d, ', ') END ;
            DynStr.Append (d, m.a)
          END
        END ;
        DynStr.AppendChar (d, ')')
    | Ast.NProcType :
        (* inline, RAISES on the same line: a type is one line where a
           declaration's heading breaks before its RAISES *)
        DynStr.Append (d, 'PROCEDURE (') ;
        EParams (d, n.kids[0]) ;
        DynStr.AppendChar (d, ')') ;
        IF n.kids[1] IS SOME rt THEN
          DynStr.Append (d, ' : ') ;
          IF n.f3 THEN DynStr.Append (d, 'RO ') END ;
          EType (d, n.kids[1], ind)
        END ;
        IF n.kids[2] IS SOME rs THEN
          DynStr.Append (d, ' RAISES ') ;
          FOR i := 0 TO rs.nkids - 1 DO
            IF i > 0 THEN DynStr.Append (d, ', ') END ;
            IF rs.kids[i] IS SOME q THEN Qual (d, q) END
          END
        END
    ELSE
      DynStr.Append (d, '?type?')
    END
  END
END EType ;

PROCEDURE ELabel (VAR d: PTR DynStr.DString ;
                  n: PTR Ast.Node) =
BEGIN
  IF n.kind = Ast.NLabelPattern THEN
    DynStr.Append (d, n.a) ;
    DynStr.Append (d, ' (') ;
    IF n.kids[0] IS SOME ids THEN Idents (d, ids) END ;
    DynStr.AppendChar (d, ')')
  ELSE
    E (d, n.kids[0]) ;
    IF n.kids[1] IS SOME hi THEN
      DynStr.Append (d, ' .. ') ;
      E (d, n.kids[1])
    END
  END
END ELabel ;

PROCEDURE EBlock (VAR d: PTR DynStr.DString ;
                  n: PTR Ast.Node ; ind: I64 ; withEnd: BOOL) ;

PROCEDURE ESeq (VAR d: PTR DynStr.DString ;
                k: Ast.Kid ; ind: I64) ;

PROCEDURE EStmt (VAR d: PTR DynStr.DString ;
                 n: PTR Ast.Node ; ind: I64) =
VAR i, j : I64 ;
BEGIN
  CASE n.kind OF
  | Ast.NAssign :
      Sp (d, ind) ;
      IF n.kids[0] IS SOME ds THEN Desig (d, ds) END ;
      DynStr.Append (d, ' := ') ;
      E (d, n.kids[1])
  | Ast.NCallStmt :
      Sp (d, ind) ;
      IF n.kids[0] IS SOME ds THEN Desig (d, ds) END ;
      IF n.f1 THEN
        DynStr.Append (d, ' (') ;
        Args (d, n.kids[1]) ;
        DynStr.AppendChar (d, ')')
      END
  | Ast.NIf :
      Sp (d, ind) ;
      DynStr.Append (d, 'IF ') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ' THEN') ;
      DynStr.AppendChar (d, 0AC) ;
      ESeq (d, n.kids[1], ind + 1) ;
      FOR i := 2 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME e THEN
          IF e.kind = Ast.NElsif THEN
            Sp (d, ind) ;
            DynStr.Append (d, 'ELSIF ') ;
            E (d, e.kids[0]) ;
            DynStr.Append (d, ' THEN') ;
            DynStr.AppendChar (d, 0AC) ;
            ESeq (d, e.kids[1], ind + 1)
          ELSIF e.kind = Ast.NElse THEN
            Sp (d, ind) ;
            DynStr.Append (d, 'ELSE') ;
            DynStr.AppendChar (d, 0AC) ;
            ESeq (d, e.kids[0], ind + 1)
          END
        END
      END ;
      Sp (d, ind) ;
      DynStr.Append (d, 'END')
  | Ast.NWhile :
      Sp (d, ind) ;
      DynStr.Append (d, 'WHILE ') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ' DO') ;
      DynStr.AppendChar (d, 0AC) ;
      ESeq (d, n.kids[1], ind + 1) ;
      Sp (d, ind) ;
      DynStr.Append (d, 'END')
  | Ast.NFor :
      Sp (d, ind) ;
      DynStr.Append (d, 'FOR ') ;
      DynStr.Append (d, n.a) ;
      DynStr.Append (d, ' := ') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ' TO ') ;
      E (d, n.kids[1]) ;
      IF n.kids[2] IS SOME by THEN
        DynStr.Append (d, ' BY ') ;
        E (d, n.kids[2])
      END ;
      DynStr.Append (d, ' DO') ;
      DynStr.AppendChar (d, 0AC) ;
      ESeq (d, n.kids[3], ind + 1) ;
      Sp (d, ind) ;
      DynStr.Append (d, 'END')
  | Ast.NLoop :
      Sp (d, ind) ;
      DynStr.Append (d, 'LOOP') ;
      DynStr.AppendChar (d, 0AC) ;
      ESeq (d, n.kids[0], ind + 1) ;
      Sp (d, ind) ;
      DynStr.Append (d, 'END')
  | Ast.NExit :
      Sp (d, ind) ;
      DynStr.Append (d, 'EXIT')
  | Ast.NCase :
      Sp (d, ind) ;
      DynStr.Append (d, 'CASE ') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ' OF') ;
      DynStr.AppendChar (d, 0AC) ;
      FOR i := 1 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME arm THEN
          IF arm.kind = Ast.NCaseArm THEN
            Sp (d, ind) ;
            DynStr.Append (d, '| ') ;
            IF arm.kids[0] IS SOME lbls THEN
              FOR j := 0 TO lbls.nkids - 1 DO
                IF j > 0 THEN DynStr.Append (d, ', ') END ;
                IF lbls.kids[j] IS SOME lb THEN
                  ELabel (d, lb)
                END
              END
            END ;
            DynStr.Append (d, ' :') ;
            DynStr.AppendChar (d, 0AC) ;
            ESeq (d, arm.kids[1], ind + 2)
          ELSIF arm.kind = Ast.NElse THEN
            Sp (d, ind) ;
            DynStr.Append (d, 'ELSE') ;
            DynStr.AppendChar (d, 0AC) ;
            ESeq (d, arm.kids[0], ind + 2)
          END
        END
      END ;
      Sp (d, ind) ;
      DynStr.Append (d, 'END')
  | Ast.NReturn :
      Sp (d, ind) ;
      DynStr.Append (d, 'RETURN') ;
      IF n.kids[0] IS SOME e THEN
        DynStr.AppendChar (d, ' ') ;
        E (d, n.kids[0])
      END
  | Ast.NRaiseStmt :
      Sp (d, ind) ;
      DynStr.Append (d, 'RAISE ') ;
      IF n.kids[0] IS SOME q THEN Qual (d, q) END ;
      IF n.kids[1] IS SOME ar THEN
        DynStr.Append (d, ' (') ;
        Args (d, n.kids[1]) ;
        DynStr.AppendChar (d, ')')
      END
  | Ast.NDispose :
      Sp (d, ind) ;
      DynStr.Append (d, 'DISPOSE (') ;
      IF n.kids[0] IS SOME ds THEN Desig (d, ds) END ;
      DynStr.AppendChar (d, ')')
  | Ast.NThread :
      Sp (d, ind) ;
      DynStr.Append (d, 'THREAD (') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ', ') ;
      E (d, n.kids[1]) ;
      DynStr.AppendChar (d, ')')
  | Ast.NTransfer :
      Sp (d, ind) ;
      DynStr.Append (d, 'TRANSFER (') ;
      E (d, n.kids[0]) ;
      DynStr.Append (d, ', ') ;
      E (d, n.kids[1]) ;
      DynStr.AppendChar (d, ')')
  | Ast.NWait :
      Sp (d, ind) ;
      DynStr.Append (d, 'WAIT (') ;
      E (d, n.kids[0]) ;
      DynStr.AppendChar (d, ')')
  | Ast.NSignal :
      Sp (d, ind) ;
      DynStr.Append (d, 'SIGNAL (') ;
      E (d, n.kids[0]) ;
      DynStr.AppendChar (d, ')')
  | Ast.NBlock :
      EBlock (d, n, ind, TRUE)
  | Ast.NStmtSeq :
      Sp (d, ind)
  ELSE
    Sp (d, ind) ;
    DynStr.Append (d, '?stmt?')
  END
END EStmt ;

PROCEDURE ESeq (VAR d: PTR DynStr.DString ;
                k: Ast.Kid ; ind: I64) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kids[i] IS SOME st THEN
        EStmt (d, st, ind) ;
        IF (i < n.nkids - 1) OR n.f1 THEN
          DynStr.Append (d, ' ;')
        END ;
        DynStr.AppendChar (d, 0AC)
      END
    END
  END
END ESeq ;

PROCEDURE EBlock (VAR d: PTR DynStr.DString ;
                  n: PTR Ast.Node ; ind: I64 ; withEnd: BOOL) =
VAR
  i, j : I64 ;
  more : BOOL ;
BEGIN
  Sp (d, ind) ;
  DynStr.Append (d, 'BEGIN') ;
  DynStr.AppendChar (d, 0AC) ;
  ESeq (d, n.kids[0], ind + 1) ;
  i := 1 ;
  more := FALSE ;
  IF i < n.nkids THEN
    IF n.kids[i] IS SOME h0 THEN
      IF h0.kind = Ast.NHandler THEN more := TRUE END
    END
  END ;
  IF more THEN
    Sp (d, ind) ;
    DynStr.Append (d, 'EXCEPT') ;
    DynStr.AppendChar (d, 0AC) ;
    LOOP
      IF i >= n.nkids THEN EXIT END ;
      IF n.kids[i] IS SOME h THEN
        IF h.kind # Ast.NHandler THEN EXIT END ;
        Sp (d, ind) ;
        DynStr.Append (d, '| ') ;
        IF h.kids[0] IS SOME q THEN Qual (d, q) END ;
        IF h.kids[1] IS SOME ar THEN
          DynStr.Append (d, ' (') ;
          FOR j := 0 TO ar.nkids - 1 DO
            IF j > 0 THEN DynStr.Append (d, ', ') END ;
            E (d, ar.kids[j])
          END ;
          DynStr.AppendChar (d, ')')
        END ;
        DynStr.Append (d, ' :') ;
        DynStr.AppendChar (d, 0AC) ;
        ESeq (d, h.kids[2], ind + 2) ;
        i := i + 1
      ELSE
        EXIT
      END
    END
  END ;
  IF i < n.nkids THEN
    IF n.kids[i] IS SOME f THEN
      IF f.kind = Ast.NFinally THEN
        Sp (d, ind) ;
        DynStr.Append (d, 'FINALLY') ;
        DynStr.AppendChar (d, 0AC) ;
        ESeq (d, f.kids[0], ind + 1) ;
        i := i + 1
      END
    END
  END ;
  IF withEnd THEN
    Sp (d, ind) ;
    DynStr.Append (d, 'END')
  END
END EBlock ;

PROCEDURE EParams (VAR d: PTR DynStr.DString ;
                   k: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF k IS SOME pl THEN
    FOR i := 0 TO pl.nkids - 1 DO
      IF pl.kids[i] IS SOME p THEN
        IF i > 0 THEN DynStr.Append (d, ' ; ') END ;
        IF p.f1 THEN DynStr.Append (d, 'VAR ') END ;
        IF p.f2 THEN DynStr.Append (d, 'OWN ') END ;
        IF p.f3 THEN DynStr.Append (d, 'RO ') END ;
        IF p.f4 THEN DynStr.Append (d, 'KEPT ') END ;
        IF p.kids[0] IS SOME ids THEN Idents (d, ids) END ;
        DynStr.Append (d, ': ') ;
        EType (d, p.kids[1], 0)
      END
    END
  END
END EParams ;

PROCEDURE EDecl (VAR d: PTR DynStr.DString ;
                 n: PTR Ast.Node ; ind: I64) ;

PROCEDURE EProc (VAR d: PTR DynStr.DString ;
                 n: PTR Ast.Node ; ind: I64) =
VAR i : I64 ;
BEGIN
  Sp (d, ind) ;
  DynStr.Append (d, 'PROCEDURE ') ;
  DynStr.Append (d, n.a) ;
  IF LEN (n.b) > 0 THEN
    DynStr.Append (d, ' = ') ;
    Quoted (d, n.b)
  END ;
  DynStr.Append (d, ' (') ;
  EParams (d, n.kids[0]) ;
  DynStr.AppendChar (d, ')') ;
  IF n.kids[1] IS SOME rt THEN
    DynStr.Append (d, ' : ') ;
    IF n.f3 THEN DynStr.Append (d, 'RO ') END ;
    EType (d, n.kids[1], ind)
  END ;
  IF n.kids[2] IS SOME rs THEN
    DynStr.AppendChar (d, 0AC) ;
    Sp (d, ind + 1) ;
    DynStr.Append (d, 'RAISES ') ;
    FOR i := 0 TO rs.nkids - 1 DO
      IF i > 0 THEN DynStr.Append (d, ', ') END ;
      IF rs.kids[i] IS SOME q THEN Qual (d, q) END
    END
  END ;
  IF n.kids[3] IS SOME at THEN
    DynStr.Append (d, ' [') ;
    DynStr.Append (d, at.a) ;
    DynStr.AppendChar (d, ']')
  END ;
  IF n.kids[4] IS SOME body THEN
    DynStr.Append (d, ' =') ;
    DynStr.AppendChar (d, 0AC) ;
    FOR i := 0 TO body.nkids - 2 DO
      IF body.kids[i] IS SOME dc THEN EDecl (d, dc, ind) END
    END ;
    IF body.kids[body.nkids - 1] IS SOME blk THEN
      EBlock (d, blk, ind, TRUE)
    END ;
    DynStr.AppendChar (d, ' ') ;
    DynStr.Append (d, n.a) ;
    DynStr.Append (d, ' ;') ;
    DynStr.AppendChar (d, 0AC)
  ELSE
    DynStr.Append (d, ' ;') ;
    DynStr.AppendChar (d, 0AC)
  END
END EProc ;

PROCEDURE IsAggregate (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN RETURN n.kind = Ast.NAggregate END ;
  RETURN FALSE
END IsAggregate ;

(* a CONST's aggregate, ONE ELEMENT TO A LINE, always: a table is
   read down and diffed by row, and a rule with no width in it prints
   the same on both sides without either measuring anything.

     Name = [
       e1,
       e2
     ] ;                                                            *)
PROCEDURE EAggregate (VAR d: PTR DynStr.DString ; k: Ast.Kid ;
                      ind: I64) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    DynStr.AppendChar (d, '[') ;
    DynStr.AppendChar (d, 0AC) ;
    FOR i := 0 TO n.nkids - 1 DO
      Sp (d, ind + 1) ;
      E (d, n.kids[i]) ;
      IF i < n.nkids - 1 THEN DynStr.AppendChar (d, ',') END ;
      DynStr.AppendChar (d, 0AC)
    END ;
    Sp (d, ind) ;
    DynStr.AppendChar (d, ']')
  END
END EAggregate ;

PROCEDURE EDecl (VAR d: PTR DynStr.DString ;
                 n: PTR Ast.Node ; ind: I64) =
VAR i : I64 ;
BEGIN
  CASE n.kind OF
  | Ast.NConstSection :
      Sp (d, ind) ;
      DynStr.Append (d, 'CONST') ;
      DynStr.AppendChar (d, 0AC) ;
      FOR i := 0 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME c THEN
          Sp (d, ind + 1) ;
          DynStr.Append (d, c.a) ;
          DynStr.Append (d, ' = ') ;
          IF IsAggregate (c.kids[0]) THEN
            EAggregate (d, c.kids[0], ind + 1)
          ELSE
            E (d, c.kids[0])
          END ;
          DynStr.Append (d, ' ;') ;
          DynStr.AppendChar (d, 0AC)
        END
      END
  | Ast.NTypeSection :
      Sp (d, ind) ;
      DynStr.Append (d, 'TYPE') ;
      DynStr.AppendChar (d, 0AC) ;
      FOR i := 0 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME td THEN
          Sp (d, ind + 1) ;
          DynStr.Append (d, td.a) ;
          IF td.kids[0] IS SOME ty THEN
            DynStr.Append (d, ' = ') ;
            EType (d, td.kids[0], ind + 1)
          END ;
          DynStr.Append (d, ' ;') ;
          DynStr.AppendChar (d, 0AC)
        END
      END
  | Ast.NVarSection :
      Sp (d, ind) ;
      DynStr.Append (d, 'VAR') ;
      DynStr.AppendChar (d, 0AC) ;
      FOR i := 0 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME vd THEN
          Sp (d, ind + 1) ;
          IF vd.f3 THEN DynStr.Append (d, 'RO ') END ;
          IF vd.kids[0] IS SOME ids THEN Idents (d, ids) END ;
          DynStr.Append (d, ' : ') ;
          EType (d, vd.kids[1], ind + 1) ;
          DynStr.Append (d, ' ;') ;
          DynStr.AppendChar (d, 0AC)
        END
      END
  | Ast.NExcSection :
      Sp (d, ind) ;
      DynStr.Append (d, 'EXCEPTION') ;
      DynStr.AppendChar (d, 0AC) ;
      FOR i := 0 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME xd THEN
          Sp (d, ind + 1) ;
          DynStr.Append (d, xd.a) ;
          IF xd.kids[0] IS SOME xf THEN
            DynStr.Append (d, ' (') ;
            FieldsInline (d, xd.kids[0]) ;
            DynStr.AppendChar (d, ')')
          END ;
          DynStr.Append (d, ' ;') ;
          DynStr.AppendChar (d, 0AC)
        END
      END
  | Ast.NProcDecl :
      EProc (d, n, ind)
  ELSE
  END
END EDecl ;

PROCEDURE EUnit (VAR d: PTR DynStr.DString ;
                 u: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  IF u.kind = Ast.NDefinition THEN
    IF u.f1 THEN DynStr.Append (d, 'UNSAFE ') END ;
    IF u.f2 THEN DynStr.Append (d, 'STATEFUL ') END ;
    DynStr.Append (d, 'DEFINITION MODULE ') ;
    IF LEN (u.b) > 0 THEN
      DynStr.Append (d, 'FOR ') ;
      Quoted (d, u.b) ;
      DynStr.AppendChar (d, ' ')
    END ;
    DynStr.Append (d, u.a) ;
    DynStr.Append (d, ' ;')
  ELSIF u.kind = Ast.NImplementation THEN
    IF u.f1 THEN DynStr.Append (d, 'UNSAFE ') END ;
    DynStr.Append (d, 'IMPLEMENTATION MODULE ') ;
    DynStr.Append (d, u.a) ;
    DynStr.Append (d, ' ;')
  ELSE
    DynStr.Append (d, 'MODULE ') ;
    DynStr.Append (d, u.a) ;
    DynStr.Append (d, ' ;')
  END ;
  DynStr.AppendChar (d, 0AC) ;
  DynStr.AppendChar (d, 0AC) ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME kd THEN
      IF kd.kind = Ast.NFromImport THEN
        DynStr.Append (d, 'FROM ') ;
        DynStr.Append (d, kd.a) ;
        DynStr.Append (d, ' IMPORT ') ;
        IF kd.kids[0] IS SOME ids THEN Idents (d, ids) END ;
        DynStr.Append (d, ' ;') ;
        DynStr.AppendChar (d, 0AC) ;
        DynStr.AppendChar (d, 0AC)
      ELSIF kd.kind = Ast.NImportList THEN
        DynStr.Append (d, 'IMPORT ') ;
        IF kd.kids[0] IS SOME ids THEN Idents (d, ids) END ;
        DynStr.Append (d, ' ;') ;
        DynStr.AppendChar (d, 0AC) ;
        DynStr.AppendChar (d, 0AC)
      ELSIF kd.kind = Ast.NModBody THEN
        (* the block's END is the MODULE's END: one keyword, not two *)
        IF kd.kids[0] IS SOME blk2 THEN
          EBlock (d, blk2, 0, FALSE)
        END
      ELSE
        EDecl (d, kd, 0) ;
        DynStr.AppendChar (d, 0AC)
      END
    END
  END ;
  DynStr.Append (d, 'END ') ;
  DynStr.Append (d, u.a) ;
  DynStr.Append (d, '.') ;
  DynStr.AppendChar (d, 0AC)
END EUnit ;

PROCEDURE TypeText (VAR pool: POOL ; k: Ast.Kid) : STR =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  EType (d, k, 0) ;
  RETURN DynStr.View (d)
END TypeText ;

PROCEDURE ParamsText (k: Ast.Kid) : STR =
VAR pool : POOL ;
    d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  EParams (d, k) ;
  RETURN DynStr.View (d)
END ParamsText ;

PROCEDURE ExprText (k: Ast.Kid) : STR =
VAR pool : POOL ;
    d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  E (d, k) ;
  RETURN DynStr.View (d)
END ExprText ;

PROCEDURE Tree (VAR pool: POOL ; root: PTR Ast.Node) : STR =
VAR
  d : PTR DynStr.DString IN pool ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  FOR i := 0 TO root.nkids - 1 DO
    IF i > 0 THEN
      DynStr.AppendChar (d, 0AC) ;
      DynStr.AppendChar (d, 0AC)
    END ;
    IF root.kids[i] IS SOME u THEN EUnit (d, u) END
  END ;
  RETURN DynStr.View (d)
END Tree ;

END Print.
