DEFINITION MODULE Mat ;

(* Dense 2-D matrices of F64 with NaN-aware, loop-free operations.
   The FOR loops have not gone anywhere: they moved in here, were
   written once, and are auto-vectorised by the compiler.  This is
   also all numpy ever promised.                                     *)

IMPORT Faults ;

TYPE
  Matrix ;                               (* opaque; lives in a POOL *)

  ReduceOp = CASE RECORD
  | Mean | Min | Max | Sum | Count
  END ;
  (* the M2 enumeration: an empty-variant CASE RECORD is M9's
     enumeration, and CASE over it must be total.  The first layout
     of this declaration put the variants in a margin comment's
     interior -- the lexer shrugged, the parser refused; P1 caught a
     corpus bug on its first run.                                    *)

PROCEDURE New (VAR pool: POOL ; rows, cols: I64) : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* nonpositive dimensions are Faults.SizeError at the door, not a zero-
     element surprise later.  Storage is defined-zero (par 4.3): the
     M2 version handed out uninitialized REALs.                      *)

PROCEDURE Rows (m: PTR Matrix) : I64 ;
PROCEDURE Cols (m: PTR Matrix) : I64 ;
  (* the two extents.  They are asked of the MATRIX and not carried
     beside it by the caller, which is the whole reason this type
     became a GRID 2 OF F64: when the shape lived in the caller's
     head, Get (m, 0, 3) on a 2x3 matrix answered element (1,0) and
     raised nothing, because index 3 is inside a 6-element flat
     slice.  Now every axis is checked against its own extent.    *)

PROCEDURE Get (m: PTR Matrix ; r, c: I64) : F64 ;
PROCEDURE Set (VAR m: PTR Matrix ; r, c: I64 ; v: F64) ;
  (* r/c bounds are checked runtime errors like all indexing:
     always on, undeclarable, catchable.                             *)

PROCEDURE ColReduce (m: PTR Matrix ; op: ReduceOp ; out: SLICE OF F64)
  RAISES Faults.SizeError ;
  (* out[c] receives the NaN-aware statistic of column c.  The M2
     version silently skipped columns beyond HIGH (out); here
     LEN (out) # Cols (m) is Faults.SizeError, said out loud.               *)

PROCEDURE SubRowVector (VAR pool: POOL ; m: PTR Matrix ;
                        RO v: SLICE OF F64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* result[r,c] := m[r,c] - v[c], broadcast over rows *)

PROCEDURE MinMax (m: PTR Matrix ; VAR mn, mx: F64) ;
  (* NaN-aware global range.  All-NaN input answers NaN twice --
     the M2 version answered 0.0, which is a lie with digits.        *)

(* ---- linear algebra, added for Bayesian inversions ----

   The cited need: the ICOS inversion x = xb + B H^T K^-1 (y - H xb)
   with K = H B H^T + R, which composes from multiply, transpose and
   an SPD solve.  Everything answers a NEW matrix from the pool; the
   inputs are never written.  Shape mismatches are Faults.SizeError with the
   offending pair.  A general (non-SPD) LU solve is deliberately
   absent until something needs it: K and B are covariance matrices,
   and covariances are SPD or the problem is already wrong. *)

EXCEPTION
  NotSPD (row: I64) ;
  (* Cholesky met a nonpositive pivot at this row: the matrix is not
     symmetric positive definite.  For a covariance matrix that is a
     data or modelling error worth a name, not a NaN worth nothing. *)

PROCEDURE MulM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* a (r x k) times b (k x c); Cols (a) # Rows (b) is Faults.SizeError *)

PROCEDURE MulV (VAR pool: POOL ; a: PTR Matrix ; RO x: SLICE OF F64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* a times a column vector, answered as an n x 1 matrix so it can
     feed straight back into MulM/CholSolve *)

PROCEDURE Transpose (VAR pool: POOL ; m: PTR Matrix)
  : PTR Matrix IN pool RAISES Faults.SizeError ;

PROCEDURE AddM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError ;
PROCEDURE SubM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError ;
PROCEDURE Scale (VAR m: PTR Matrix ; s: F64) ;
  (* in place, the one mutator: scaling allocates nothing *)

PROCEDURE Identity (VAR pool: POOL ; n: I64) : PTR Matrix IN pool
  RAISES Faults.SizeError ;
PROCEDURE CopyM (VAR pool: POOL ; m: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError ;

PROCEDURE Cholesky (VAR pool: POOL ; a: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange ;
  (* the lower-triangular L with L L^T = a.  Only the lower triangle
     of a is read, which is the usual contract and means a matrix
     that is SPD in its lower half is never betrayed by garbage in
     its upper. *)

PROCEDURE CholSolve (VAR pool: POOL ; l, b: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* solve A X = B given L = Cholesky (A); B may carry many columns,
     which is how the Kalman-style gain is built in one call *)

PROCEDURE SpdInverse (VAR pool: POOL ; a: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange ;
  (* CholSolve against the identity: the posterior covariance step *)

PROCEDURE CholeskyT (VAR pool: POOL ; a: PTR Matrix ; threads: I64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange ;
  (* Cholesky's factor, computed BLOCKED and on threads (2026-09-15):
     the lower triangle of a is copied and factored in place, panel
     by panel -- the diagonal block serially, the rows below it as
     independent forward substitutions, the trailing lower triangle
     updated a row at a time -- with the rows of the last two steps
     claimed in bands by `threads` workers.  Every cell sees the
     same subtractions in the same order the serial Cholesky applies
     (k ascending, one running value, never a panel dot product
     subtracted whole), so the factor is BIT-IDENTICAL to Cholesky's
     at any thread count; the gate holds it so.  On 16 629 unknowns
     the serial factorisation was the last single-threaded minutes
     of a solve whose other stages were already banded.            *)

PROCEDURE CholInverse (VAR pool: POOL ; KEPT l: PTR Matrix ; threads: I64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError ;
  (* (L L^T)^-1 from the factor Cholesky answered, in two contiguous
     passes on `threads` threads (2026-09-15, the year inversion's
     8-hour inverse):

       T = (L^-1)^T   row j of T is column j of L^-1: a forward
                      substitution against the identity's column j,
                      zero above j, reading row i of L along its
                      columns -- contiguous, and the zeros halve it;
       P = T T^T      P[a,b] = sum over k >= max(a,b) of T[a,k] T[b,k]
                      -- two rows read along their columns.

     SpdInverse's back substitution read the factor DOWN a column for
     each of n identity columns, a cache miss per multiply: n = 16 629
     took 8 hours; this takes n^3/3 flops instead of n^3 and reads
     memory the way it lies.  Columns of T and rows of P are
     independent, so the work is claimed in bands by `threads`
     workers, each writing only its own rows; the arithmetic of every
     cell is the same in the same order whatever the thread count, so
     the answer is bit-identical for 1 and for 32.  threads <= 1 runs
     in the caller's thread.                                        *)

PROCEDURE AddNormal (h: PTR Matrix ; RO w: SLICE OF F64 ;
                     VAR k: PTR Matrix ; threads: I64)
  RAISES Faults.SizeError ;
  (* k := k + H^T diag (w) H, the normal matrix of a weighted least
     squares, accumulated where it lies: one pass over the rows of H
     per band of columns, zeros of H skipped, the upper triangle
     computed and the lower mirrored at the end.  A worker owns a band
     of rows of k and reads every row of H, so nothing is written
     twice; the per-cell sums run over the rows of H ascending in
     every band, as the serial loop did, so the result does not depend
     on the thread count.                                           *)

(* ---- general linear algebra (2026-10-02) ----

   What the paragraph above left out "until something needs it": the
   data science backlog does.  Here, and not in a module of its own,
   by decision: one matrix type, one module.  The oracle is
   numpy.linalg, in corpus/MatTest.m9.

   As above, everything answers NEW storage in the pool and writes
   none of its inputs.  A factorisation that has two or three parts
   hands them back through VAR parameters; a vector of values goes
   into a slice the caller made, and a slice of the wrong length is
   Faults.SizeError.

   These are the textbook algorithms, unblocked and single-threaded:
   right, and fast enough for the hundreds of unknowns a regression
   or a small inversion has.  The Cholesky family above is the one
   that was made fast, because 16 629 unknowns needed it. *)

EXCEPTION
  Singular (col: I64) ;
  (* no pivot at this column.  In Solve, Inverse and Det that is a
     pivot EXACTLY zero, LAPACK's own test: the matrix has no
     inverse.  A matrix that is merely close to singular raises
     nothing there and answers with few digits, as it does
     everywhere -- its condition number is the caller's to know.  In
     LstSq it is a column that adds nothing to the columns before it
     beyond rounding: the problem has no unique answer. *)
  NoConverge (sweeps: I64) ;
  (* the Jacobi iteration of Svd or EigSym did not settle in this
     many sweeps.  Not seen on a finite matrix; an infinity inside
     one does it. *)

PROCEDURE Solve (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular ;
  (* the X with A X = B, A square, by LU with partial pivoting
     (numpy.linalg.solve); B may carry many columns *)

PROCEDURE Det (a: PTR Matrix) : F64 RAISES Faults.SizeError ;
  (* the determinant, from the same factorisation: the product of the
     pivots, negated once for every row exchange.  0.0 for a matrix
     whose elimination meets a zero pivot. *)

PROCEDURE Inverse (VAR pool: POOL ; a: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular ;
  (* Solve against the identity (numpy.linalg.inv).  To solve a
     system, Solve it: an inverse multiplied in costs three times
     the work and loses digits. *)

PROCEDURE Qr (VAR pool: POOL ; a: PTR Matrix ; VAR q, r: PTR Matrix)
  RAISES Faults.SizeError, ValueRange ;
  (* a = q r by Householder reflections, in the reduced form: for a
     of m x n and k the smaller of the two, q is m x k with
     orthonormal columns and r is k x n, zero below its diagonal
     (numpy.linalg.qr, mode 'reduced').  THE DIAGONAL OF r IS NEVER
     NEGATIVE: a factorisation is unique only up to the sign of each
     column of q, and this is the one that is said.  ValueRange is a
     NaN in a: it cannot travel through a square root. *)

PROCEDURE LstSq (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular, ValueRange ;
  (* the X that makes A X - B smallest, column by column, in the
     least-squares sense: A of m x n with m >= n and full column
     rank, B of m rows, X of n rows (numpy.linalg.lstsq).  Through
     QR, never through the normal equations, which square the
     condition number.  Fewer equations than unknowns is
     Faults.SizeError, and a column that is a combination of earlier
     ones is Singular: neither has ONE answer, and the smallest of
     the many is Svd's to find. *)

PROCEDURE Svd (VAR pool: POOL ; a: PTR Matrix ; VAR u: PTR Matrix ;
               VAR s: SLICE OF F64 ; VAR vt: PTR Matrix)
  RAISES Faults.SizeError, NoConverge, ValueRange ;
  (* a = u diag (s) vt, the singular value decomposition without the
     full matrices: for a of m x n and k the smaller, u is m x k, s
     has k values, vt is k x n (numpy.linalg.svd, full_matrices
     False).  LEN (s) must be k.  The values DESCEND and are never
     negative.  A pair of singular vectors is unique only up to one
     sign, and this is the one that is said: the component of
     largest magnitude of each row of vt is positive.

     By one-sided Jacobi rotations, which find small singular values
     to their own precision.  Where a value is exactly zero the
     matrix does not determine its vector on the side that was
     iterated, and that vector is answered as zeros. *)

PROCEDURE EigSym (VAR pool: POOL ; a: PTR Matrix ; VAR w: SLICE OF F64 ;
                  VAR v: PTR Matrix)
  RAISES Faults.SizeError, NoConverge, ValueRange ;
  (* the eigenvalues w, ASCENDING, and the eigenvectors, the COLUMNS
     of v, of a symmetric matrix: a v = v diag (w) (numpy.linalg.eigh).
     Only the lower triangle of a is read, as Cholesky reads it.
     LEN (w) must be the matrix's order.  Each vector's component of
     largest magnitude is positive.  By Jacobi rotations.  A general
     matrix has complex eigenvalues and is not this procedure's. *)

END Mat.


IMPLEMENTATION MODULE Mat ;

IMPORT Faults ;

IMPORT Math ;

TYPE
  Matrix = RECORD
    d : GRID 2 OF F64 ;
  END ;
  (* The rows and cols fields are gone: a GRID carries its own extent
     per axis, and LEN (d, 0) cannot disagree with the storage the way
     a remembered `rows` could.

     This module used to say `d[r * cols + c]` over a flat slice, and
     that arithmetic is exactly the hole GRID closes: Get (m, 0, 3) on
     a three-column matrix returned element (1,0) and raised NOTHING,
     because index 3 is inside a six-element slice.  Measured, in
     docs/nd-arrays.md, before the feature was designed.  The check is
     now per axis and the driver asserts the raise.                  *)

PROCEDURE New (VAR pool: POOL ; rows, cols: I64) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR m : PTR Matrix IN pool ;
BEGIN
  IF rows <= 0 OR cols <= 0 THEN RAISE Faults.SizeError (rows, cols) END ;
  m := NEW (pool, Matrix) ;
  m.d := NEW (pool, F64, rows, cols) ;
  RETURN m
END New ;

PROCEDURE Rows (m: PTR Matrix) : I64 =
BEGIN
  RETURN LEN (m.d, 0)
END Rows ;

PROCEDURE Cols (m: PTR Matrix) : I64 =
BEGIN
  RETURN LEN (m.d, 1)
END Cols ;

PROCEDURE Get (m: PTR Matrix ; r, c: I64) : F64 =
BEGIN
  RETURN m.d[r, c]
END Get ;

PROCEDURE Set (VAR m: PTR Matrix ; r, c: I64 ; v: F64) =
BEGIN
  m.d[r, c] := v
END Set ;

PROCEDURE ColReduce (m: PTR Matrix ; op: ReduceOp ; out: SLICE OF F64)
  RAISES Faults.SizeError =
VAR
  r, c, n : I64 ;
  acc, v  : F64 ;
BEGIN
  IF LEN (out) # LEN (m.d, 1) THEN
    RAISE Faults.SizeError (LEN (out), LEN (m.d, 1))
  END ;
  FOR c := 0 TO LEN (m.d, 1) - 1 DO
    n := 0 ;
    acc := 0.0 ;
    FOR r := 0 TO LEN (m.d, 0) - 1 DO
      v := m.d[r, c] ;
      IF NOT Math.IsNaN (v) THEN
        IF n = 0 THEN
          acc := v
        ELSE
          CASE op OF
          | Mean  : acc := acc + v
          | Sum   : acc := acc + v
          | Min   : IF v < acc THEN acc := v END
          | Max   : IF v > acc THEN acc := v END
          | Count :                      (* n does the counting *)
          END
        END ;
        n := n + 1
      END
    END ;
    IF n = 0 THEN
      out[c] := 0.0 / 0.0                (* honest NaN for empty column *)
    ELSE
      CASE op OF
      | Mean  : out[c] := acc / F64 (n)
      | Sum   : out[c] := acc
      | Min   : out[c] := acc
      | Max   : out[c] := acc
      | Count : out[c] := F64 (n)
      END
      (* both CASEs are total: the M2 version lumped arms into ELSE,
         and adding an op there compiled clean and computed garbage.
         Adding a ReduceOp variant here breaks this compile until
         every arm answers.  [the partial-case museum piece]         *)
    END
  END
END ColReduce ;

PROCEDURE SubRowVector (VAR pool: POOL ; m: PTR Matrix ;
                        RO v: SLICE OF F64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  res  : PTR Matrix IN pool ;
  r, c : I64 ;
BEGIN
  IF LEN (v) # LEN (m.d, 1) THEN
    RAISE Faults.SizeError (LEN (v), LEN (m.d, 1))
  END ;
  res := New (pool, LEN (m.d, 0), LEN (m.d, 1)) ;
  FOR r := 0 TO LEN (m.d, 0) - 1 DO
    FOR c := 0 TO LEN (m.d, 1) - 1 DO
      res.d[r, c] := m.d[r, c] - v[c]
    END
  END ;
  RETURN res
END SubRowVector ;

PROCEDURE MinMax (m: PTR Matrix ; VAR mn, mx: F64) =
VAR
  r, c : I64 ;
  v    : F64 ;
  seen : BOOL ;
BEGIN
  mn := 0.0 / 0.0 ;
  mx := 0.0 / 0.0 ;
  seen := FALSE ;
  FOR r := 0 TO LEN (m.d, 0) - 1 DO
  FOR c := 0 TO LEN (m.d, 1) - 1 DO
    v := m.d[r, c] ;
    IF NOT Math.IsNaN (v) THEN
      IF NOT seen THEN
        mn := v ; mx := v ; seen := TRUE
      ELSE
        IF v < mn THEN mn := v END ;
        IF v > mx THEN mx := v END
      END
    END
  END
  END
END MinMax ;


(* ---- linear algebra ---- *)

PROCEDURE MulM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  m : PTR Matrix IN pool ;
  r, c, k : I64 ;
  acc : F64 ;
BEGIN
  IF Cols (a) # Rows (b) THEN RAISE Faults.SizeError (Cols (a), Rows (b)) END ;
  m := New (pool, Rows (a), Cols (b)) ;
  FOR r := 0 TO Rows (a) - 1 DO
    FOR c := 0 TO Cols (b) - 1 DO
      acc := 0.0 ;
      FOR k := 0 TO Cols (a) - 1 DO
        acc := acc + a.d[r, k] * b.d[k, c]
      END ;
      m.d[r, c] := acc
    END
  END ;
  RETURN m
END MulM ;

PROCEDURE MulV (VAR pool: POOL ; a: PTR Matrix ; RO x: SLICE OF F64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  m : PTR Matrix IN pool ;
  r, k : I64 ;
  acc : F64 ;
BEGIN
  IF Cols (a) # LEN (x) THEN RAISE Faults.SizeError (Cols (a), LEN (x)) END ;
  m := New (pool, Rows (a), 1) ;
  FOR r := 0 TO Rows (a) - 1 DO
    acc := 0.0 ;
    FOR k := 0 TO Cols (a) - 1 DO
      acc := acc + a.d[r, k] * x[k]
    END ;
    m.d[r, 0] := acc
  END ;
  RETURN m
END MulV ;

PROCEDURE Transpose (VAR pool: POOL ; m: PTR Matrix)
  : PTR Matrix IN pool RAISES Faults.SizeError =
VAR
  t : PTR Matrix IN pool ;
  r, c : I64 ;
BEGIN
  t := New (pool, Cols (m), Rows (m)) ;
  FOR r := 0 TO Rows (m) - 1 DO
    FOR c := 0 TO Cols (m) - 1 DO
      t.d[c, r] := m.d[r, c]
    END
  END ;
  RETURN t
END Transpose ;

PROCEDURE Same (a, b: PTR Matrix) RAISES Faults.SizeError =
BEGIN
  IF Rows (a) # Rows (b) THEN RAISE Faults.SizeError (Rows (a), Rows (b)) END ;
  IF Cols (a) # Cols (b) THEN RAISE Faults.SizeError (Cols (a), Cols (b)) END
END Same ;

PROCEDURE AddM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  m : PTR Matrix IN pool ;
  r, c : I64 ;
BEGIN
  Same (a, b) ;
  m := New (pool, Rows (a), Cols (a)) ;
  FOR r := 0 TO Rows (a) - 1 DO
    FOR c := 0 TO Cols (a) - 1 DO
      m.d[r, c] := a.d[r, c] + b.d[r, c]
    END
  END ;
  RETURN m
END AddM ;

PROCEDURE SubM (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  m : PTR Matrix IN pool ;
  r, c : I64 ;
BEGIN
  Same (a, b) ;
  m := New (pool, Rows (a), Cols (a)) ;
  FOR r := 0 TO Rows (a) - 1 DO
    FOR c := 0 TO Cols (a) - 1 DO
      m.d[r, c] := a.d[r, c] - b.d[r, c]
    END
  END ;
  RETURN m
END SubM ;

PROCEDURE Scale (VAR m: PTR Matrix ; s: F64) =
VAR r, c : I64 ;
BEGIN
  FOR r := 0 TO Rows (m) - 1 DO
    FOR c := 0 TO Cols (m) - 1 DO
      m.d[r, c] := m.d[r, c] * s
    END
  END
END Scale ;

PROCEDURE Identity (VAR pool: POOL ; n: I64) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  m : PTR Matrix IN pool ;
  i : I64 ;
BEGIN
  m := New (pool, n, n) ;
  FOR i := 0 TO n - 1 DO
    m.d[i, i] := 1.0
  END ;
  RETURN m
END Identity ;

PROCEDURE CopyM (VAR pool: POOL ; m: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  t : PTR Matrix IN pool ;
  r, c : I64 ;
BEGIN
  t := New (pool, Rows (m), Cols (m)) ;
  FOR r := 0 TO Rows (m) - 1 DO
    FOR c := 0 TO Cols (m) - 1 DO
      t.d[r, c] := m.d[r, c]
    END
  END ;
  RETURN t
END CopyM ;

PROCEDURE Cholesky (VAR pool: POOL ; a: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange =
VAR
  l : PTR Matrix IN pool ;
  n, i, j, k : I64 ;
  acc : F64 ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  n := Rows (a) ;
  l := New (pool, n, n) ;
  FOR i := 0 TO n - 1 DO
    FOR j := 0 TO i DO
      acc := a.d[i, j] ;
      FOR k := 0 TO j - 1 DO
        acc := acc - l.d[i, k] * l.d[j, k]
      END ;
      IF i = j THEN
        (* a nonpositive pivot is the definition of not-SPD; a NaN
           reaching here also fails the comparison the other way and
           then raises in Sqrt -- either way it cannot travel *)
        IF acc <= 0.0 THEN RAISE NotSPD (i) END ;
        l.d[i, j] := Math.Sqrt (acc)
      ELSE
        l.d[i, j] := acc / l.d[j, j]
      END
    END
  END ;
  RETURN l
END Cholesky ;

PROCEDURE CholSolve (VAR pool: POOL ; l, b: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  x : PTR Matrix IN pool ;
  n, i, k, c : I64 ;
  acc : F64 ;
BEGIN
  IF Rows (l) # Cols (l) THEN RAISE Faults.SizeError (Rows (l), Cols (l)) END ;
  IF Rows (b) # Rows (l) THEN RAISE Faults.SizeError (Rows (b), Rows (l)) END ;
  n := Rows (l) ;
  x := CopyM (pool, b) ;
  FOR c := 0 TO Cols (b) - 1 DO
    (* forward: L y = b *)
    FOR i := 0 TO n - 1 DO
      acc := x.d[i, c] ;
      FOR k := 0 TO i - 1 DO
        acc := acc - l.d[i, k] * x.d[k, c]
      END ;
      x.d[i, c] := acc / l.d[i, i]
    END ;
    (* back: L^T x = y *)
    FOR i := n - 1 TO 0 BY -1 DO
      acc := x.d[i, c] ;
      FOR k := i + 1 TO n - 1 DO
        acc := acc - l.d[k, i] * x.d[k, c]
      END ;
      x.d[i, c] := acc / l.d[i, i]
    END
  END ;
  RETURN x
END CholSolve ;

PROCEDURE SpdInverse (VAR pool: POOL ; a: PTR Matrix)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange =
VAR l : PTR Matrix IN pool ;
BEGIN
  l := Cholesky (pool, a) ;
  RETURN CholSolve (pool, l, Identity (pool, Rows (a)))
END SpdInverse ;

(* ---- the threaded kernels: a band counter in a monitor, the
   matrices shared by pointer, every worker writing its own rows ---- *)

TYPE
  Work = MONITOR RECORD
    done : I64 ;                 (* workers finished *)
    next : I64 ;                 (* the next band to claim *)
  END ;

  InvJob = RECORD
    w : Work ;
    l : PTR Matrix ;             (* the factor, read by all *)
    t : PTR Matrix ;             (* the transpose of the inverse factor: row j belongs to the band holding j *)
    p : PTR Matrix ;             (* the inverse: rows of a band *)
    n, band, nbands, pass : I64
  END ;

  NormalJob = RECORD
    w : Work ;
    h : PTR Matrix ;
    k : PTR Matrix ;
    wt : SLICE OF F64 ;
    n, m, band, nbands : I64
  END ;

PROCEDURE Claim (VAR w: Work) : I64 =
VAR b : I64 ;
BEGIN
  b := w.next ;
  w.next := w.next + 1 ;
  RETURN b
END Claim ;

PROCEDURE Finish (VAR w: Work) =
BEGIN
  w.done := w.done + 1 ;
  SIGNAL (w)
END Finish ;

PROCEDURE AwaitAll (VAR w: Work ; want: I64) =
BEGIN
  WHILE w.done < want DO WAIT (w) END
END AwaitAll ;

PROCEDURE ResetWork (VAR w: Work) =
BEGIN
  w.done := 0 ;
  w.next := 0
END ResetWork ;

PROCEDURE InvBand (VAR j: InvJob ; b: I64) =
  (* pass 1: rows [c0, c1) of T; pass 2: rows [c0, c1) of P and their mirror *)
VAR
  wpool : POOL ;
  x : SLICE OF F64 ;
  c0, c1, col, i, m, a, bb, kk, n : I64 ;
  acc : F64 ;
BEGIN
  n := j.n ;
  c0 := b * j.band ;
  c1 := c0 + j.band ;
  IF c1 > n THEN c1 := n END ;
  IF j.pass = 1 THEN
    x := NEW (wpool, F64, n) ;
    FOR col := c0 TO c1 - 1 DO
      (* L x = e_col: x is zero above col *)
      FOR i := col TO n - 1 DO
        IF i = col THEN acc := 1.0 ELSE acc := 0.0 END ;
        FOR m := col TO i - 1 DO
          acc := acc - j.l.d[i, m] * x[m]
        END ;
        x[i] := acc / j.l.d[i, i]
      END ;
      FOR i := 0 TO col - 1 DO j.t.d[col, i] := 0.0 END ;
      FOR i := col TO n - 1 DO j.t.d[col, i] := x[i] END
    END
  ELSE
    FOR a := c0 TO c1 - 1 DO
      FOR bb := a TO n - 1 DO
        acc := 0.0 ;
        FOR kk := bb TO n - 1 DO
          acc := acc + j.t.d[a, kk] * j.t.d[bb, kk]
        END ;
        j.p.d[a, bb] := acc ;
        j.p.d[bb, a] := acc
      END
    END
  END
END InvBand ;

PROCEDURE InvWorker (VAR j: InvJob) =
VAR b : I64 ;
BEGIN
  b := Claim (j.w) ;
  WHILE b < j.nbands DO
    InvBand (j, b) ;
    b := Claim (j.w)
  END ;
  Finish (j.w)
END InvWorker ;

PROCEDURE RunInv (VAR j: PTR InvJob ; threads: I64) =
  (* one thread is still a thread: the worker takes the job record by
     reference and THREAD hands it the pointer, as chapter 16 does *)
VAR t : I64 ;
BEGIN
  ResetWork (j.w) ;
  IF threads < 1 THEN threads := 1 END ;
  FOR t := 1 TO threads DO THREAD (InvWorker, j) END ;
  AwaitAll (j.w, threads)
END RunInv ;

(* ---- the blocked Cholesky: a panel's rows below the diagonal
   block and the trailing update, both in row bands ---- *)

TYPE
  CholJob = RECORD
    w : Work ;
    l : PTR Matrix ;             (* the factor in the making, lower triangle *)
    n, k0, k1, pass, band, nbands : I64 ;
    bad : I64                    (* a NotSPD row, -1 while none *)
  END ;

PROCEDURE CholBand (VAR j: CholJob ; b: I64) =
VAR
  r0, r1, i, jj, k : I64 ;
  acc : F64 ;
BEGIN
  r0 := j.k1 + b * j.band ;
  r1 := r0 + j.band ;
  IF r1 > j.n THEN r1 := j.n END ;
  IF j.pass = 1 THEN
    (* the panel below the diagonal block: row i's entries in columns
       k0..k1-1, each the serial recurrence continued from the value
       the earlier panels' updates left in l[i, jj] *)
    FOR i := r0 TO r1 - 1 DO
      FOR jj := j.k0 TO j.k1 - 1 DO
        acc := j.l.d[i, jj] ;
        FOR k := j.k0 TO jj - 1 DO
          acc := acc - j.l.d[i, k] * j.l.d[jj, k]
        END ;
        j.l.d[i, jj] := acc / j.l.d[jj, jj]
      END
    END
  ELSE
    (* the trailing update: the lower triangle of rows k1.., the
       panel's products subtracted k ascending from the running value *)
    FOR i := r0 TO r1 - 1 DO
      FOR jj := j.k1 TO i DO
        acc := j.l.d[i, jj] ;
        FOR k := j.k0 TO j.k1 - 1 DO
          acc := acc - j.l.d[i, k] * j.l.d[jj, k]
        END ;
        j.l.d[i, jj] := acc
      END
    END
  END
END CholBand ;

PROCEDURE CholWorker (VAR j: CholJob) =
VAR b : I64 ;
BEGIN
  b := Claim (j.w) ;
  WHILE b < j.nbands DO
    CholBand (j, b) ;
    b := Claim (j.w)
  END ;
  Finish (j.w)
END CholWorker ;

PROCEDURE RunChol (VAR j: PTR CholJob ; threads: I64) =
VAR t : I64 ;
BEGIN
  ResetWork (j.w) ;
  IF threads < 1 THEN threads := 1 END ;
  FOR t := 1 TO threads DO THREAD (CholWorker, j) END ;
  AwaitAll (j.w, threads)
END RunChol ;

PROCEDURE CholeskyT (VAR pool: POOL ; a: PTR Matrix ; threads: I64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError, NotSPD, ValueRange =
VAR
  scratch : POOL ;
  j : PTR CholJob IN scratch ;
  l : PTR Matrix IN pool ;
  n, nb, k0, k1, i, jj, k : I64 ;
  acc : F64 ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  n := Rows (a) ;
  l := New (pool, n, n) ;
  FOR i := 0 TO n - 1 DO
    FOR jj := 0 TO i DO l.d[i, jj] := a.d[i, jj] END
  END ;
  nb := 128 ;
  IF n < 512 THEN nb := 32 END ;
  j := NEW (scratch, CholJob) ;
  j.n := n ;
  j.band := 32 ;
  k0 := 0 ;
  WHILE k0 < n DO
    k1 := k0 + nb ;
    IF k1 > n THEN k1 := n END ;
    (* the diagonal block, serially: the serial recurrence on rows
       k0..k1-1 within their own columns *)
    FOR i := k0 TO k1 - 1 DO
      FOR jj := k0 TO i DO
        acc := l.d[i, jj] ;
        FOR k := k0 TO jj - 1 DO
          acc := acc - l.d[i, k] * l.d[jj, k]
        END ;
        IF i = jj THEN
          IF acc <= 0.0 THEN RAISE NotSPD (i) END ;
          l.d[i, jj] := Math.Sqrt (acc)
        ELSE
          l.d[i, jj] := acc / l.d[jj, jj]
        END
      END
    END ;
    IF k1 < n THEN
      j.l := l ;
      j.k0 := k0 ; j.k1 := k1 ;
      j.nbands := (n - k1 + j.band - 1) DIV j.band ;
      j.pass := 1 ;
      RunChol (j, threads) ;
      j.pass := 2 ;
      RunChol (j, threads) ;
      l := j.l
    END ;
    k0 := k1
  END ;
  RETURN l
END CholeskyT ;

PROCEDURE CholInverse (VAR pool: POOL ; KEPT l: PTR Matrix ; threads: I64)
  : PTR Matrix IN pool
  RAISES Faults.SizeError =
VAR
  scratch : POOL ;
  j : PTR InvJob IN scratch ;
  n : I64 ;
BEGIN
  IF Rows (l) # Cols (l) THEN RAISE Faults.SizeError (Rows (l), Cols (l)) END ;
  n := Rows (l) ;
  j := NEW (scratch, InvJob) ;
  j.n := n ;
  j.l := l ;
  j.t := New (scratch, n, n) ;
  j.p := New (pool, n, n) ;
  (* small bands, claimed as workers free up: the work per row of T
     falls with its index and the work per row of P likewise, so a
     static split would leave most threads waiting on the first *)
  j.band := 32 ;
  IF n < 128 THEN j.band := 8 END ;
  j.nbands := (n + j.band - 1) DIV j.band ;
  j.pass := 1 ;
  RunInv (j, threads) ;
  j.pass := 2 ;
  RunInv (j, threads) ;
  RETURN j.p
END CholInverse ;

PROCEDURE NormalBand (VAR j: NormalJob ; b: I64) =
VAR
  r0, r1, i, c, cc : I64 ;
  hic, hv : F64 ;
BEGIN
  r0 := b * j.band ;
  r1 := r0 + j.band ;
  IF r1 > j.n THEN r1 := j.n END ;
  FOR i := 0 TO j.m - 1 DO
    FOR c := r0 TO r1 - 1 DO
      hic := j.h.d[i, c] ;
      IF hic # 0.0 THEN
        hic := hic * j.wt[i] ;
        FOR cc := c TO j.n - 1 DO
          hv := j.h.d[i, cc] ;
          IF hv # 0.0 THEN
            j.k.d[c, cc] := j.k.d[c, cc] + hic * hv
          END
        END
      END
    END
  END
END NormalBand ;

PROCEDURE NormalWorker (VAR j: NormalJob) =
VAR b : I64 ;
BEGIN
  b := Claim (j.w) ;
  WHILE b < j.nbands DO
    NormalBand (j, b) ;
    b := Claim (j.w)
  END ;
  Finish (j.w)
END NormalWorker ;

PROCEDURE AddNormal (h: PTR Matrix ; RO w: SLICE OF F64 ;
                     VAR k: PTR Matrix ; threads: I64)
  RAISES Faults.SizeError =
VAR
  scratch : POOL ;
  j : PTR NormalJob IN scratch ;
  t, c, cc : I64 ;
BEGIN
  IF Rows (k) # Cols (h) OR Cols (k) # Cols (h) THEN RAISE Faults.SizeError (Rows (k), Cols (h)) END ;
  IF LEN (w) # Rows (h) THEN RAISE Faults.SizeError (LEN (w), Rows (h)) END ;
  j := NEW (scratch, NormalJob) ;
  j.h := h ;
  j.k := k ;
  j.wt := w ;
  j.n := Cols (h) ;
  j.m := Rows (h) ;
  j.band := 64 ;
  j.nbands := (j.n + j.band - 1) DIV j.band ;
  ResetWork (j.w) ;
  IF threads < 1 THEN threads := 1 END ;
  FOR t := 1 TO threads DO THREAD (NormalWorker, j) END ;
  AwaitAll (j.w, threads) ;
  FOR c := 1 TO j.n - 1 DO
    FOR cc := 0 TO c - 1 DO
      k.d[c, cc] := k.d[cc, c]
    END
  END
END AddNormal ;

(* ---- general linear algebra ---- *)

CONST
  Eps = 2.220446049250313e-16 ;      (* the spacing of F64 at 1.0 *)
  MaxSweeps = 60 ;

(* Doolittle with partial pivoting, in place: the multipliers of L
   below the diagonal (its unit diagonal implied), U on and above.
   perm[i] is the row of the original now at i; sign is +1 or -1 by
   the parity of the exchanges.  Answers -1, or the column whose
   pivot is exactly zero. *)
PROCEDURE Factor (VAR lu: PTR Matrix ; VAR perm: SLICE OF I64 ;
                  VAR sign: F64) : I64 =
VAR
  n, i, j, k, p, held : I64 ;
  big, v, t, f : F64 ;
BEGIN
  n := Rows (lu) ;
  sign := 1.0 ;
  FOR i := 0 TO n - 1 DO perm[i] := i END ;
  FOR k := 0 TO n - 1 DO
    p := k ;
    big := Math.Fabs (lu.d[k, k]) ;
    FOR i := k + 1 TO n - 1 DO
      v := Math.Fabs (lu.d[i, k]) ;
      IF v > big THEN
        big := v ;
        p := i
      END
    END ;
    IF big = 0.0 THEN RETURN k END ;
    IF p # k THEN
      FOR j := 0 TO n - 1 DO
        t := lu.d[k, j] ;
        lu.d[k, j] := lu.d[p, j] ;
        lu.d[p, j] := t
      END ;
      held := perm[k] ;
      perm[k] := perm[p] ;
      perm[p] := held ;
      sign := -sign
    END ;
    FOR i := k + 1 TO n - 1 DO
      f := lu.d[i, k] / lu.d[k, k] ;
      lu.d[i, k] := f ;
      FOR j := k + 1 TO n - 1 DO
        lu.d[i, j] := lu.d[i, j] - f * lu.d[k, j]
      END
    END
  END ;
  RETURN -1
END Factor ;

PROCEDURE Solve (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular =
VAR
  scratch : POOL ;
  lu : PTR Matrix IN scratch ;
  x : PTR Matrix IN pool ;
  perm : SLICE OF I64 ;
  n, i, k, c, bad : I64 ;
  acc, sign : F64 ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  IF Rows (b) # Rows (a) THEN RAISE Faults.SizeError (Rows (b), Rows (a)) END ;
  n := Rows (a) ;
  lu := CopyM (scratch, a) ;
  perm := NEW (scratch, I64, n) ;
  bad := Factor (lu, perm, sign) ;
  IF bad >= 0 THEN RAISE Singular (bad) END ;
  x := New (pool, n, Cols (b)) ;
  FOR c := 0 TO Cols (b) - 1 DO
    (* forward: L y = P b *)
    FOR i := 0 TO n - 1 DO
      acc := b.d[perm[i], c] ;
      FOR k := 0 TO i - 1 DO
        acc := acc - lu.d[i, k] * x.d[k, c]
      END ;
      x.d[i, c] := acc
    END ;
    (* back: U x = y *)
    FOR i := n - 1 TO 0 BY -1 DO
      acc := x.d[i, c] ;
      FOR k := i + 1 TO n - 1 DO
        acc := acc - lu.d[i, k] * x.d[k, c]
      END ;
      x.d[i, c] := acc / lu.d[i, i]
    END
  END ;
  RETURN x
END Solve ;

PROCEDURE Det (a: PTR Matrix) : F64 RAISES Faults.SizeError =
VAR
  scratch : POOL ;
  lu : PTR Matrix IN scratch ;
  perm : SLICE OF I64 ;
  n, i : I64 ;
  d : F64 ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  n := Rows (a) ;
  lu := CopyM (scratch, a) ;
  perm := NEW (scratch, I64, n) ;
  IF Factor (lu, perm, d) >= 0 THEN RETURN 0.0 END ;
  FOR i := 0 TO n - 1 DO d := d * lu.d[i, i] END ;
  RETURN d
END Det ;

PROCEDURE Inverse (VAR pool: POOL ; a: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular =
VAR
  scratch : POOL ;
  eye : PTR Matrix IN scratch ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  eye := Identity (scratch, Rows (a)) ;
  RETURN Solve (pool, a, eye)
END Inverse ;

(* the reflector that turns column j of w, from row j down, into a
   multiple of the first unit vector, left in column j of h from row
   j down; answers v.v, or 0.0 when the column is already zero there
   and nothing is to be done *)
PROCEDURE Reflector (VAR w, h: PTR Matrix ; j: I64) : F64
  RAISES ValueRange =
VAR
  m, i : I64 ;
  acc, norm : F64 ;
BEGIN
  m := Rows (w) ;
  acc := 0.0 ;
  FOR i := j TO m - 1 DO acc := acc + w.d[i, j] * w.d[i, j] END ;
  IF acc = 0.0 THEN RETURN 0.0 END ;
  norm := Math.Sqrt (acc) ;
  FOR i := j TO m - 1 DO h.d[i, j] := w.d[i, j] END ;
  (* away from the entry's own sign, so nothing cancels *)
  IF w.d[j, j] < 0.0 THEN
    h.d[j, j] := h.d[j, j] - norm
  ELSE
    h.d[j, j] := h.d[j, j] + norm
  END ;
  acc := 0.0 ;
  FOR i := j TO m - 1 DO acc := acc + h.d[i, j] * h.d[i, j] END ;
  RETURN acc
END Reflector ;

(* t := (I - 2 v v^T / v.v) t over the columns of t from `from' on,
   v being column j of h from row j down *)
PROCEDURE Reflect (VAR t: PTR Matrix ; h: PTR Matrix ; j: I64 ; vv: F64 ;
                   from: I64) =
VAR
  m, i, c : I64 ;
  acc, f : F64 ;
BEGIN
  IF vv = 0.0 THEN RETURN END ;
  m := Rows (t) ;
  FOR c := from TO Cols (t) - 1 DO
    acc := 0.0 ;
    FOR i := j TO m - 1 DO acc := acc + h.d[i, j] * t.d[i, c] END ;
    f := 2.0 * acc / vv ;
    FOR i := j TO m - 1 DO t.d[i, c] := t.d[i, c] - f * h.d[i, j] END
  END
END Reflect ;

PROCEDURE Qr (VAR pool: POOL ; a: PTR Matrix ; VAR q, r: PTR Matrix)
  RAISES Faults.SizeError, ValueRange =
VAR
  scratch : POOL ;
  w, h : PTR Matrix IN scratch ;
  vv : SLICE OF F64 ;
  m, n, k, i, j : I64 ;
BEGIN
  m := Rows (a) ;
  n := Cols (a) ;
  k := m ;
  IF n < m THEN k := n END ;
  w := CopyM (scratch, a) ;
  h := New (scratch, m, k) ;
  vv := NEW (scratch, F64, k) ;
  FOR j := 0 TO k - 1 DO
    vv[j] := Reflector (w, h, j) ;
    Reflect (w, h, j, vv[j], j)
  END ;
  (* r is what is left on and above the diagonal *)
  r := New (pool, k, n) ;
  FOR i := 0 TO k - 1 DO
    FOR j := i TO n - 1 DO r.d[i, j] := w.d[i, j] END
  END ;
  (* q is the reflectors applied, last first, to the first k columns
     of the identity *)
  q := New (pool, m, k) ;
  FOR j := 0 TO k - 1 DO q.d[j, j] := 1.0 END ;
  FOR j := k - 1 TO 0 BY -1 DO
    Reflect (q, h, j, vv[j], 0)
  END ;
  (* the sign that is said: no negative on r's diagonal *)
  FOR i := 0 TO k - 1 DO
    IF r.d[i, i] < 0.0 THEN
      FOR j := i TO n - 1 DO r.d[i, j] := -r.d[i, j] END ;
      FOR j := 0 TO m - 1 DO q.d[j, i] := -q.d[j, i] END
    END
  END
END Qr ;

PROCEDURE LstSq (VAR pool: POOL ; a, b: PTR Matrix) : PTR Matrix IN pool
  RAISES Faults.SizeError, Singular, ValueRange =
VAR
  scratch : POOL ;
  q, r : PTR Matrix IN scratch ;
  x : PTR Matrix IN pool ;
  m, n, i, k, c : I64 ;
  acc, big : F64 ;
BEGIN
  m := Rows (a) ;
  n := Cols (a) ;
  IF m < n THEN RAISE Faults.SizeError (m, n) END ;
  IF Rows (b) # m THEN RAISE Faults.SizeError (Rows (b), m) END ;
  Qr (scratch, a, q, r) ;
  (* a column that adds nothing to those before it leaves a diagonal
     entry that is rounding and no more: never exactly zero, so held
     to the largest entry instead, as numpy's rcond holds a singular
     value (machine epsilon times the larger dimension) *)
  big := 0.0 ;
  FOR i := 0 TO n - 1 DO
    IF r.d[i, i] > big THEN big := r.d[i, i] END
  END ;
  FOR i := 0 TO n - 1 DO
    IF r.d[i, i] <= Eps * F64 (m) * big THEN RAISE Singular (i) END
  END ;
  x := New (pool, n, Cols (b)) ;
  FOR c := 0 TO Cols (b) - 1 DO
    (* q^T b, then back through r *)
    FOR i := 0 TO n - 1 DO
      acc := 0.0 ;
      FOR k := 0 TO m - 1 DO acc := acc + q.d[k, i] * b.d[k, c] END ;
      x.d[i, c] := acc
    END ;
    FOR i := n - 1 TO 0 BY -1 DO
      acc := x.d[i, c] ;
      FOR k := i + 1 TO n - 1 DO
        acc := acc - r.d[i, k] * x.d[k, c]
      END ;
      x.d[i, c] := acc / r.d[i, i]
    END
  END ;
  RETURN x
END LstSq ;

(* the Jacobi rotation that annihilates an off-diagonal g between two
   diagonals whose difference is `gap' (second minus first): its
   cosine and sine, the smaller of the two angles *)
PROCEDURE Rotation (gap, g: F64 ; VAR c, s: F64) RAISES ValueRange =
VAR zeta, t, root : F64 ;
BEGIN
  zeta := gap / (2.0 * g) ;
  root := Math.Sqrt (1.0 + zeta * zeta) ;
  IF zeta < 0.0 THEN
    t := -1.0 / (root - zeta)
  ELSE
    t := 1.0 / (root + zeta)
  END ;
  root := Math.Sqrt (1.0 + t * t) ;
  c := 1.0 / root ;
  s := c * t
END Rotation ;

(* columns p and q of m turned by the rotation *)
PROCEDURE Turn (VAR m: PTR Matrix ; p, q: I64 ; c, s: F64) =
VAR
  i : I64 ;
  a, b : F64 ;
BEGIN
  FOR i := 0 TO Rows (m) - 1 DO
    a := m.d[i, p] ;
    b := m.d[i, q] ;
    m.d[i, p] := c * a - s * b ;
    m.d[i, q] := s * a + c * b
  END
END Turn ;

(* one-sided Jacobi on a matrix with no more columns than rows: w's
   columns are turned until they are orthogonal to one another, the
   same turns gathered in v, which starts as the identity.  What is
   left is w = U diag (s), and a = w v^T throughout. *)
PROCEDURE Orthogonalise (VAR w, v: PTR Matrix)
  RAISES NoConverge, ValueRange =
VAR
  n, p, q, i, sweep, turned : I64 ;
  alpha, beta, gamma, limit, c, s : F64 ;
BEGIN
  n := Cols (w) ;
  FOR sweep := 1 TO MaxSweeps DO
    turned := 0 ;
    FOR p := 0 TO n - 2 DO
      FOR q := p + 1 TO n - 1 DO
        alpha := 0.0 ;
        beta := 0.0 ;
        gamma := 0.0 ;
        FOR i := 0 TO Rows (w) - 1 DO
          alpha := alpha + w.d[i, p] * w.d[i, p] ;
          beta := beta + w.d[i, q] * w.d[i, q] ;
          gamma := gamma + w.d[i, p] * w.d[i, q]
        END ;
        limit := Math.Sqrt (alpha * beta) ;
        IF Math.Fabs (gamma) > Eps * limit THEN
          Rotation (beta - alpha, gamma, c, s) ;
          Turn (w, p, q, c, s) ;
          Turn (v, p, q, c, s) ;
          turned := turned + 1
        END
      END
    END ;
    IF turned = 0 THEN RETURN END
  END ;
  RAISE NoConverge (MaxSweeps)
END Orthogonalise ;

(* +1.0 or -1.0: what makes the component of largest magnitude of
   row r of m positive (the first such, among equals) *)
PROCEDURE RowSign (m: PTR Matrix ; r: I64) : F64 =
VAR
  j : I64 ;
  big, pick : F64 ;
BEGIN
  big := -1.0 ;
  pick := 1.0 ;
  FOR j := 0 TO Cols (m) - 1 DO
    IF Math.Fabs (m.d[r, j]) > big THEN
      big := Math.Fabs (m.d[r, j]) ;
      IF m.d[r, j] < 0.0 THEN pick := -1.0 ELSE pick := 1.0 END
    END
  END ;
  RETURN pick
END RowSign ;

(* the svd of a matrix with no more columns than rows: u is m x n,
   vt is n x n *)
PROCEDURE SvdTall (VAR pool: POOL ; a: PTR Matrix ; VAR u: PTR Matrix ;
                   VAR s: SLICE OF F64 ; VAR vt: PTR Matrix)
  RAISES Faults.SizeError, NoConverge, ValueRange =
VAR
  scratch : POOL ;
  w, v : PTR Matrix IN scratch ;
  norm : SLICE OF F64 ;
  order : SLICE OF I64 ;
  m, n, i, j, k, best, held : I64 ;
  acc, f : F64 ;
BEGIN
  m := Rows (a) ;
  n := Cols (a) ;
  w := CopyM (scratch, a) ;
  v := Identity (scratch, n) ;
  Orthogonalise (w, v) ;
  norm := NEW (scratch, F64, n) ;
  order := NEW (scratch, I64, n) ;
  FOR j := 0 TO n - 1 DO
    acc := 0.0 ;
    FOR i := 0 TO m - 1 DO acc := acc + w.d[i, j] * w.d[i, j] END ;
    norm[j] := Math.Sqrt (acc) ;
    order[j] := j
  END ;
  (* the largest first; equal values keep the order they had *)
  FOR k := 0 TO n - 2 DO
    best := k ;
    FOR j := k + 1 TO n - 1 DO
      IF norm[order[j]] > norm[order[best]] THEN best := j END
    END ;
    held := order[best] ;
    FOR j := best TO k + 1 BY -1 DO order[j] := order[j - 1] END ;
    order[k] := held
  END ;
  u := New (pool, m, n) ;
  vt := New (pool, n, n) ;
  FOR k := 0 TO n - 1 DO
    j := order[k] ;
    s[k] := norm[j] ;
    FOR i := 0 TO n - 1 DO vt.d[k, i] := v.d[i, j] END ;
    f := RowSign (vt, k) ;
    FOR i := 0 TO n - 1 DO vt.d[k, i] := f * vt.d[k, i] END ;
    IF norm[j] > 0.0 THEN
      FOR i := 0 TO m - 1 DO u.d[i, k] := f * w.d[i, j] / norm[j] END
    END
  END
END SvdTall ;

PROCEDURE Svd (VAR pool: POOL ; a: PTR Matrix ; VAR u: PTR Matrix ;
               VAR s: SLICE OF F64 ; VAR vt: PTR Matrix)
  RAISES Faults.SizeError, NoConverge, ValueRange =
VAR
  scratch : POOL ;
  at, ut, vtt : PTR Matrix IN scratch ;
  m, n, i, k : I64 ;
  f : F64 ;
BEGIN
  m := Rows (a) ;
  n := Cols (a) ;
  IF m >= n THEN
    IF LEN (s) # n THEN RAISE Faults.SizeError (LEN (s), n) END ;
    SvdTall (pool, a, u, s, vt) ;
    RETURN
  END ;
  (* wide: the transpose is tall, and a = (u' s v'^T)^T = v' s u'^T *)
  IF LEN (s) # m THEN RAISE Faults.SizeError (LEN (s), m) END ;
  at := Transpose (scratch, a) ;
  SvdTall (scratch, at, ut, s, vtt) ;
  u := Transpose (pool, vtt) ;
  vt := Transpose (pool, ut) ;
  (* the sign is said on vt, which here was the other side's u *)
  FOR k := 0 TO m - 1 DO
    f := RowSign (vt, k) ;
    IF f < 0.0 THEN
      FOR i := 0 TO n - 1 DO vt.d[k, i] := -vt.d[k, i] END ;
      FOR i := 0 TO m - 1 DO u.d[i, k] := -u.d[i, k] END
    END
  END
END Svd ;

PROCEDURE EigSym (VAR pool: POOL ; a: PTR Matrix ; VAR w: SLICE OF F64 ;
                  VAR v: PTR Matrix)
  RAISES Faults.SizeError, NoConverge, ValueRange =
VAR
  scratch : POOL ;
  d, e, et : PTR Matrix IN scratch ;
  order : SLICE OF I64 ;
  n, p, q, i, j, k, sweep, turned, best, held : I64 ;
  apq, c, s, x, y, f, limit : F64 ;
  settled : BOOL ;
BEGIN
  IF Rows (a) # Cols (a) THEN RAISE Faults.SizeError (Rows (a), Cols (a)) END ;
  n := Rows (a) ;
  IF LEN (w) # n THEN RAISE Faults.SizeError (LEN (w), n) END ;
  (* the lower triangle, mirrored: symmetric whatever was above *)
  d := New (scratch, n, n) ;
  FOR i := 0 TO n - 1 DO
    FOR j := 0 TO i DO
      d.d[i, j] := a.d[i, j] ;
      d.d[j, i] := a.d[i, j]
    END
  END ;
  e := Identity (scratch, n) ;
  settled := n < 2 ;
  sweep := 0 ;
  WHILE NOT settled DO
    sweep := sweep + 1 ;
    IF sweep > MaxSweeps THEN RAISE NoConverge (MaxSweeps) END ;
    turned := 0 ;
    FOR p := 0 TO n - 2 DO
      FOR q := p + 1 TO n - 1 DO
        apq := d.d[p, q] ;
        limit := Math.Sqrt (Math.Fabs (d.d[p, p] * d.d[q, q])) ;
        IF Math.Fabs (apq) > Eps * limit THEN
          Rotation (d.d[q, q] - d.d[p, p], apq, c, s) ;
          (* d := J^T d J: the columns, then the rows *)
          Turn (d, p, q, c, s) ;
          FOR k := 0 TO n - 1 DO
            x := d.d[p, k] ;
            y := d.d[q, k] ;
            d.d[p, k] := c * x - s * y ;
            d.d[q, k] := s * x + c * y
          END ;
          d.d[p, q] := 0.0 ;
          d.d[q, p] := 0.0 ;
          Turn (e, p, q, c, s) ;
          turned := turned + 1
        END
      END
    END ;
    settled := turned = 0
  END ;
  order := NEW (scratch, I64, n) ;
  FOR j := 0 TO n - 1 DO order[j] := j END ;
  (* the smallest first; equal values keep the order they had *)
  FOR k := 0 TO n - 2 DO
    best := k ;
    FOR j := k + 1 TO n - 1 DO
      IF d.d[order[j], order[j]] < d.d[order[best], order[best]] THEN
        best := j
      END
    END ;
    held := order[best] ;
    FOR j := best TO k + 1 BY -1 DO order[j] := order[j - 1] END ;
    order[k] := held
  END ;
  (* RowSign reads a row, so the vectors are laid out as rows first *)
  et := Transpose (scratch, e) ;
  v := New (pool, n, n) ;
  FOR k := 0 TO n - 1 DO
    j := order[k] ;
    w[k] := d.d[j, j] ;
    f := RowSign (et, j) ;
    FOR i := 0 TO n - 1 DO v.d[i, k] := f * e.d[i, j] END
  END
END EigSym ;

END Mat.
