DEFINITION MODULE Fmt ;

(* Numbers to text, and back.

   This exists because M9 could not format a float in M9: Plot bound
   libc's sprintf ("%.4g") through a FOR-C shim, and Io had no way to
   print an F64 at all.  Borrowing printf is worse than it looks --
   it is LOCALE DEPENDENT, so the same program writes 3.14 or 3,14
   depending on the environment, and a JSON document that parses on
   one machine is malformed on another.  For a language whose whole
   claim is that boundaries do not lie quietly, owning this is not
   indulgence.

   Two float paths, with different promises, both stated:

     Bits  is EXACT.  It is the IEEE-754 bit pattern in hex, so
           ParseBits (Bits (x)) = x for every finite double, and for
           NaN and the infinities too.  Ugly for humans, correct for
           machines and for test goldens.

     Fixed is HUMAN, and its accuracy is MEASURED, not claimed.  It
           scales by a power of ten and rounds half to even, the rule
           printf uses.  Against printf over a hundred thousand
           in-range values it disagrees on 0.71%, always by one in
           the last digit.  The cause is not the tie rule -- that was
           tried and moved the rate by 0.01 -- but the scaling:
           v * 10^d rounds before any decision is taken.  Removing
           that needs exact decimal conversion of the Dragon4 kind,
           which nobody has written here yet.  The driver prints the
           rate on every run and fails above 1%, so the number cannot
           quietly rot.

   Use Bits when a value must survive the round trip; use Fixed when
   a person is going to read it.  Saying which is which is the point.

   Short is BOTH, since 2026-10-05: the shortest decimal that reads
   back to the same double, exact by construction (Burger and Dybvig's
   free-format digits over integers, no scaling in F64), and held to
   Python's repr on 9,148 values by FmtTest. *)

CONST
  MaxDecimals = 17 ;

PROCEDURE I64Str (v: I64) : STR ;
  (* decimal text of v, sign and all.  Total for every I64 including
     MIN: the digits are taken in NEGATIVE space, where every I64
     fits, because -MIN does not.

     NO POOL, here or anywhere below: a formatter answers a string
     the caller reads once, and par 2.3 places that string in the
     caller's arena.  These took a pool until 2026-09-03, and every
     caller in the corpus passed one only to throw the result at
     Append or WriteLine.                                            *)

PROCEDURE I64Pad (v: I64 ; width: I64 ; zero: BOOL) : STR ;
  (* right-aligned in width; zero selects '0' over ' ' as the fill.
     A value too wide is never truncated -- silently losing digits is
     the class of bug this language refuses -- it just overflows the
     field, as printf does.                                          *)

PROCEDURE Fixed (v: F64 ; decimals: I64) : STR RAISES ValueRange ;
  (* decimals in 0..MaxDecimals; a magnitude that will not survive
     scaling raises rather than printing a plausible wrong number.
     NaN prints 'nan', the infinities 'inf' and '-inf'.              *)

PROCEDURE FixedPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange ;
  (* Pascal's `v:width:decimals`, which is where the shape comes
     from: Fixed, then right-aligned in width with BLANKS.  Pascal
     pads a real field with blanks and never with zeros, so there is
     no zero flag here as there is on I64Pad; a leading-zero float is
     a different thing and nobody has asked for one.

     Too wide is never truncated -- it overflows the field, exactly
     as I64Pad does and for the same reason: silently losing digits
     is the class of bug this language refuses.                     *)

PROCEDURE Sci (v: F64 ; decimals: I64) : STR RAISES ValueRange ;
  (* scientific notation, one digit before the point and `decimals`
     after it, then 'e' and the decimal exponent: 3.14e-5.

     THE EXPONENT IS WRITTEN THE SHORT WAY, which is neither C's nor
     Pascal's.  printf %.2e gives 3.14e-05 and Pascal gives
     3.14000000000000E-005; both pad the exponent to a fixed width so
     that columns line up, and this pads with the WIDTH parameter
     instead, which is what SciPad is for.  So: 'e', a '-' only when
     the exponent is negative, and no leading zeros -- 3.14e-5 and
     3.14e5.

     Zero prints as 0.00e0, and NEGATIVE zero prints without the
     sign, as Fixed already does: neither consults the sign bit.
     printf disagrees on that one value and the driver excludes it
     rather than pretending they agree.

     The accuracy is Fixed's, and measured the same way: the mantissa
     is normalised by multiplying or dividing by ONE power of ten
     chosen by binary decomposition -- about eighteen roundings at
     the worst instead of the three hundred a divide-by-ten loop
     would take -- and then rounded half to even like Fixed.  The
     driver compares it against printf over a spread of magnitudes
     and prints the disagreement rate.                              *)

PROCEDURE SciPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange ;
  (* Sci, right-aligned in width with blanks -- the `:x:y` of the
     scientific form.  A short exponent makes the field ragged on the
     right, which is what the width is for.                         *)

PROCEDURE Short (v: F64) : STR ;
  (* the SHORTEST decimal that reads back to exactly v -- the closest
     such when there are several, the even last digit on a tie -- in
     Python's repr layout: positional for 1e-4 <= |v| < 1e16 (1.0,
     0.0001, 1234.5), else one digit, a point if more follow, and a
     signed two-digit-or-more exponent (1e+16, 2.5e-05).  -0.0 keeps
     its sign; NaN is 'nan', the infinities 'inf' and '-inf'.  Total:
     no RAISES, every double has an answer.  What a person reads and
     what a machine reads back are the same number.                 *)

PROCEDURE Bits (v: F64) : STR ;
PROCEDURE ParseBits (RO s: STR) : F64 RAISES ValueRange ;
  (* the exact pair: 16 hex digits, low byte first, round-trip total *)

PROCEDURE ParseF64 (RO s: STR) : F64 RAISES ValueRange ;
  (* decimal, with optional sign, fraction and exponent.  Rejects
     anything else, because a command line or a data file that says
     it holds a number and does not is the boundary this catches.    *)

END Fmt.


IMPLEMENTATION MODULE Fmt ;

CONST
  HexDigits = '0123456789ABCDEF' ;
  MaxF64    = 1.7976931348623157E308 ;

(* Digits are PREPENDED, least significant first, and that is a copy
   per digit rather than the in-place extension an append gets --
   twenty of them at most, so the arena holds under 200 characters
   for the worst I64, and nothing here is on anyone's hot path.
   The digit itself is a one-character SLICE of the digit table,
   because `+` takes strings and a CHAR is not one.                  *)
PROCEDURE I64Str (v: I64) : STR =
VAR
  s : STR ;
  q : I64 ;
BEGIN
  IF v = 0 THEN RETURN '0' END ;
  s := '' ;
  (* negative space: q is v or -v, whichever is <= 0, and MOD / DIV
     truncate toward zero, so one digit is negated at a time and
     none of it can overflow *)
  q := v ;
  IF q > 0 THEN q := -q END ;
  WHILE q # 0 DO
    s := SLICE (HexDigits, -(q MOD 10), 1) + s ;
    q := q DIV 10
  END ;
  IF v < 0 THEN s := '-' + s END ;
  RETURN s
END I64Str ;

PROCEDURE I64Pad (v: I64 ; width: I64 ; zero: BOOL) : STR =
VAR
  body, s : STR ;
  i, n : I64 ;
  neg : BOOL ;
BEGIN
  body := I64Str (v) ;
  n := LEN (body) ;
  IF n >= width THEN RETURN body END ;
  neg := FALSE ;
  IF n > 0 THEN neg := body[0] = '-' END ;
  IF zero AND neg THEN
    (* the sign leads the zeros, not the other way round *)
    s := '-' ;
    FOR i := 1 TO width - n DO s := s + '0' END ;
    s := s + SLICE (body, 1, n - 1)
  ELSE
    s := '' ;
    FOR i := 1 TO width - n DO
      IF zero THEN s := s + '0' ELSE s := s + ' ' END
    END ;
    s := s + body
  END ;
  RETURN s
END I64Pad ;

PROCEDURE Pow10 (n: I64) : F64 =
VAR
  i : I64 ;
  p : F64 ;
BEGIN
  p := 1.0 ;
  FOR i := 1 TO n DO p := p * 10.0 END ;
  RETURN p
END Pow10 ;

PROCEDURE Pow10I (n: I64) : I64 =
VAR
  i, p : I64 ;
BEGIN
  p := 1 ;
  FOR i := 1 TO n DO p := p * 10 END ;
  RETURN p
END Pow10I ;

PROCEDURE Fixed (v: F64 ; decimals: I64) : STR RAISES ValueRange =
VAR
  s : STR ;
  scaled, av : F64 ;
  whole, frac, scale, i : I64 ;
  neg : BOOL ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;
  IF decimals < 0 OR decimals > MaxDecimals THEN RAISE ValueRange END ;

  neg := v < 0.0 ;
  av := v ;
  IF neg THEN av := -av END ;

  scale := Pow10I (decimals) ;
  (* Round half to EVEN on the scaled value, which is what printf
     does on the true one.  Half away from zero disagreed with printf
     on 0.72% of a hundred thousand values; the driver measures the
     rate rather than trusting either rule, and prints it. *)
  scaled := av * Pow10 (decimals) ;
  frac := I64 (scaled) ;
  IF scaled - F64 (frac) > 0.5 THEN
    scaled := scaled + 1.0
  ELSIF scaled - F64 (frac) = 0.5 THEN
    IF frac MOD 2 # 0 THEN scaled := scaled + 1.0 END
  END ;
  (* the conversion is checked: a magnitude that will not fit raises
     ValueRange here rather than wrapping into a plausible lie *)
  whole := I64 (scaled) DIV scale ;
  frac := I64 (scaled) MOD scale ;

  s := '' ;
  IF neg THEN s := '-' END ;
  s := s + I64Str (whole) ;
  IF decimals > 0 THEN
    s := s + '.' + I64Pad (frac, decimals, TRUE)
  END ;
  RETURN s
END Fixed ;

(* Blank-padding, right-aligned.  I64Pad keeps its own copy because
   it has the zero fill and the sign-before-the-zeros rule to obey;
   this is the plain one that FixedPad and SciPad share. *)
PROCEDURE PadLeft (RO body: STR ; width: I64) : STR =
VAR
  s : STR ;
  i : I64 ;
BEGIN
  IF LEN (body) >= width THEN RETURN body END ;
  s := '' ;
  FOR i := 1 TO width - LEN (body) DO s := s + ' ' END ;
  RETURN s + body
END PadLeft ;

PROCEDURE FixedPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange =
BEGIN
  RETURN PadLeft (Fixed (v, decimals), width)
END FixedPad ;

(* Bring a into [1, 10) and answer the decimal exponent that was
   taken out of it.

   ONE POWER OF TEN PER STEP, chosen by binary decomposition: 256,
   128, 64 ... 1.  The obvious loop -- divide by ten until it fits --
   rounds once per iteration, which for 1e-320 is three hundred and
   twenty roundings and an answer that has drifted.  This does at
   most eighteen, and each one is a division by an exactly-known
   power rather than a repeated compounding.

   256 is the largest step because Pow10 (512) is already +Inf, and
   1e256 covers the whole F64 range in two applications.  Neither
   loop can overflow: the divide phase only ever makes a smaller,
   and the multiply phase runs with a already below 10.               *)
PROCEDURE Norm (VAR a: F64) : I64 =
VAR
  e, step : I64 ;
  p : F64 ;
BEGIN
  e := 0 ;
  step := 256 ;
  WHILE step >= 1 DO
    p := Pow10 (step) ;
    WHILE a >= p DO a := a / p ; e := e + step END ;
    step := step DIV 2
  END ;
  (* the step = 1 pass above leaves a < 10; this one leaves a >= 1,
     and `a * p < 10.0` is the test that says the multiply is safe *)
  step := 256 ;
  WHILE step >= 1 DO
    p := Pow10 (step) ;
    WHILE a * p < 10.0 DO a := a * p ; e := e - step END ;
    step := step DIV 2
  END ;
  RETURN e
END Norm ;

PROCEDURE Sci (v: F64 ; decimals: I64) : STR RAISES ValueRange =
VAR
  s : STR ;
  av, scaled : F64 ;
  expo, scale, whole, frac : I64 ;
  neg : BOOL ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;
  IF decimals < 0 OR decimals > MaxDecimals THEN RAISE ValueRange END ;

  neg := v < 0.0 ;
  av := v ;
  IF neg THEN av := -av END ;

  scale := Pow10I (decimals) ;
  IF av = 0.0 THEN
    (* zero has no exponent to find, and Norm would not terminate
       looking for one *)
    expo := 0 ;
    whole := 0 ;
    frac := 0
  ELSE
    expo := Norm (av) ;
    (* av is now in [1, 10); the rounding is Fixed's, half to even *)
    scaled := av * Pow10 (decimals) ;
    frac := I64 (scaled) ;
    IF scaled - F64 (frac) > 0.5 THEN
      scaled := scaled + 1.0
    ELSIF scaled - F64 (frac) = 0.5 THEN
      IF frac MOD 2 # 0 THEN scaled := scaled + 1.0 END
    END ;
    whole := I64 (scaled) DIV scale ;
    frac := I64 (scaled) MOD scale ;
    (* 9.99 at two decimals rounds to 10.00, which is not normalised:
       carry it into the exponent rather than printing a mantissa
       with two digits in front of the point *)
    IF whole >= 10 THEN
      whole := 1 ;
      frac := 0 ;
      expo := expo + 1
    END
  END ;

  s := '' ;
  IF neg THEN s := '-' END ;
  s := s + I64Str (whole) ;
  IF decimals > 0 THEN
    s := s + '.' + I64Pad (frac, decimals, TRUE)
  END ;
  (* I64Str writes '-' for a negative and nothing for a positive,
     which is exactly the short form this wants *)
  RETURN s + 'e' + I64Str (expo)
END Sci ;

PROCEDURE SciPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange =
BEGIN
  RETURN PadLeft (Sci (v, decimals), width)
END SciPad ;

PROCEDURE Bits (v: F64) : STR =
VAR
  s : STR ;
  b : SLICE OF BYTE ;
  scratch : POOL ;
  i, x : I64 ;
BEGIN
  b := NEW (scratch, BYTE, 8) ;
  F64.ToBytesLE (v, b) ;
  s := '' ;
  FOR i := 0 TO 7 DO
    x := I64 (b[i]) ;
    s := s + SLICE (HexDigits, x DIV 16, 1) + SLICE (HexDigits, x MOD 16, 1)
  END ;
  RETURN s
END Bits ;

PROCEDURE HexVal (c: CHAR) : I64 RAISES ValueRange =
BEGIN
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 END ;
  IF c >= 'A' AND c <= 'F' THEN RETURN ORD (c) - 55 END ;
  IF c >= 'a' AND c <= 'f' THEN RETURN ORD (c) - 87 END ;
  RAISE ValueRange
END HexVal ;

PROCEDURE ParseBits (RO s: STR) : F64 RAISES ValueRange =
VAR
  scratch : POOL ;
  b : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  IF LEN (s) # 16 THEN RAISE ValueRange END ;
  b := NEW (scratch, BYTE, 8) ;
  FOR i := 0 TO 7 DO
    b[i] := BYTE (HexVal (s[2 * i]) * 16 + HexVal (s[2 * i + 1]))
  END ;
  RETURN F64.FromBytesLE (b)
END ParseBits ;

PROCEDURE ParseF64 (RO s: STR) : F64 RAISES ValueRange =
VAR
  i, n, digits, expo, esign, eval : I64 ;
  mant, scale : F64 ;
  neg, seenDot : BOOL ;
BEGIN
  n := LEN (s) ;
  IF n = 0 THEN RAISE ValueRange END ;
  i := 0 ;
  neg := FALSE ;
  IF s[i] = '-' THEN neg := TRUE ; i := i + 1
  ELSIF s[i] = '+' THEN i := i + 1 END ;

  mant := 0.0 ;
  expo := 0 ;
  digits := 0 ;
  seenDot := FALSE ;
  WHILE i < n DO
    IF s[i] = '.' THEN
      IF seenDot THEN RAISE ValueRange END ;
      seenDot := TRUE ;
      i := i + 1
    ELSIF s[i] >= '0' AND s[i] <= '9' THEN
      mant := mant * 10.0 + F64 (ORD (s[i]) - 48) ;
      IF seenDot THEN expo := expo - 1 END ;
      digits := digits + 1 ;
      i := i + 1
    ELSE
      EXIT
    END
  END ;
  IF digits = 0 THEN RAISE ValueRange END ;

  IF i < n THEN
    IF s[i] = 'e' OR s[i] = 'E' THEN
      i := i + 1 ;
      esign := 1 ;
      IF i < n THEN
        IF s[i] = '-' THEN esign := -1 ; i := i + 1
        ELSIF s[i] = '+' THEN i := i + 1 END
      END ;
      eval := 0 ;
      IF i >= n THEN RAISE ValueRange END ;
      WHILE i < n DO
        IF s[i] < '0' OR s[i] > '9' THEN RAISE ValueRange END ;
        eval := eval * 10 + (ORD (s[i]) - 48) ;
        i := i + 1
      END ;
      expo := expo + esign * eval
    END
  END ;
  IF i # n THEN RAISE ValueRange END ;

  (* scaling in F64: correctly rounded for the decimal exponents a
     data file actually carries, and the driver checks it against
     strtod rather than assuming                                     *)
  scale := Pow10 (expo) ;
  IF expo < 0 THEN
    mant := mant / Pow10 (-expo)
  ELSE
    mant := mant * scale
  END ;
  IF neg THEN RETURN -mant END ;
  RETURN mant
END ParseF64 ;

(* ---- Short: Burger and Dybvig's free-format digits ----

   The value is f * 2^e exactly.  r / s is the value scaled so that
   its digits come out one at a time, mp and mm are the distances to
   the halfway points between v and its neighbours, scaled alike: any
   decimal strictly inside (v - mm, v + mp) reads back as v, and on
   the boundary too when f is even, because a reader rounds a tie to
   the even mantissa.  All four are integers, so nothing is rounded
   on the way -- the reason it is exact where Fixed is measured.

   Integers of up to 48 limbs of 32 bits: the largest is s for the
   smallest subnormal, 2^1075 times ten, 36 limbs.                    *)

CONST
  Limbs = 48 ;
  Base  = 4294967296 ;          (* 2^32: a limb times 2^31 fits an I64 *)

TYPE
  Big = RECORD
    n : I64 ;                   (* limbs in use, the top one non-zero *)
    d : ARRAY Limbs OF I64      (* least significant first *)
  END ;

PROCEDURE BigSmall (VAR a: Big ; v: I64) =
BEGIN
  a.n := 0 ;
  WHILE v > 0 DO
    a.d[a.n] := v MOD Base ;
    v := v DIV Base ;
    a.n := a.n + 1
  END
END BigSmall ;

(* a := a * m, 0 < m < 2^31 *)
PROCEDURE BigMul (VAR a: Big ; m: I64) =
VAR i, x, carry : I64 ;
BEGIN
  carry := 0 ;
  FOR i := 0 TO a.n - 1 DO
    x := a.d[i] * m + carry ;
    a.d[i] := x MOD Base ;
    carry := x DIV Base
  END ;
  WHILE carry > 0 DO
    a.d[a.n] := carry MOD Base ;
    carry := carry DIV Base ;
    a.n := a.n + 1
  END
END BigMul ;

PROCEDURE BigShl (VAR a: Big ; k: I64) =
VAR m : I64 ;
BEGIN
  WHILE k >= 30 DO
    BigMul (a, 1073741824) ;
    k := k - 30
  END ;
  m := 1 ;
  WHILE k > 0 DO
    m := m * 2 ;
    k := k - 1
  END ;
  IF m > 1 THEN BigMul (a, m) END
END BigShl ;

PROCEDURE BigTen (VAR a: Big ; k: I64) =
VAR m : I64 ;
BEGIN
  WHILE k >= 9 DO
    BigMul (a, 1000000000) ;
    k := k - 9
  END ;
  m := 1 ;
  WHILE k > 0 DO
    m := m * 10 ;
    k := k - 1
  END ;
  IF m > 1 THEN BigMul (a, m) END
END BigTen ;

PROCEDURE BigCmp (RO a, b: Big) : I64 =
VAR i : I64 ;
BEGIN
  IF a.n # b.n THEN
    IF a.n < b.n THEN RETURN -1 END ;
    RETURN 1
  END ;
  FOR i := a.n - 1 TO 0 BY -1 DO
    IF a.d[i] # b.d[i] THEN
      IF a.d[i] < b.d[i] THEN RETURN -1 END ;
      RETURN 1
    END
  END ;
  RETURN 0
END BigCmp ;

PROCEDURE BigAdd (RO a, b: Big ; VAR c: Big) =
VAR i, x, carry, n : I64 ;
BEGIN
  n := a.n ;
  IF b.n > n THEN n := b.n END ;
  carry := 0 ;
  FOR i := 0 TO n - 1 DO
    x := carry ;
    IF i < a.n THEN x := x + a.d[i] END ;
    IF i < b.n THEN x := x + b.d[i] END ;
    c.d[i] := x MOD Base ;
    carry := x DIV Base
  END ;
  c.n := n ;
  IF carry > 0 THEN
    c.d[n] := carry ;
    c.n := n + 1
  END
END BigAdd ;

(* a := a - b, a >= b *)
PROCEDURE BigSub (VAR a: Big ; RO b: Big) =
VAR i, x, borrow : I64 ;
BEGIN
  borrow := 0 ;
  FOR i := 0 TO a.n - 1 DO
    x := a.d[i] - borrow ;
    IF i < b.n THEN x := x - b.d[i] END ;
    IF x < 0 THEN
      x := x + Base ;
      borrow := 1
    ELSE
      borrow := 0
    END ;
    a.d[i] := x
  END ;
  WHILE a.n > 0 AND a.d[a.n - 1] = 0 DO a.n := a.n - 1 END
END BigSub ;

(* r + mp reaches s: past it, or onto it when the boundary is in *)
PROCEDURE High (RO r, mp, s: Big ; even: BOOL) : BOOL =
VAR
  t : Big ;
  c : I64 ;
BEGIN
  BigAdd (r, mp, t) ;
  c := BigCmp (t, s) ;
  RETURN c > 0 OR (even AND c = 0)
END High ;

PROCEDURE Zeros (n: I64) : STR =
VAR s : STR ;
BEGIN
  s := '' ;
  WHILE n > 0 DO
    s := s + '0' ;
    n := n - 1
  END ;
  RETURN s
END Zeros ;

PROCEDURE Short (v: F64) : STR =
VAR
  b : SLICE OF BYTE ;
  scratch : POOL ;
  r, s, mp, mm, t : Big ;
  dig : ARRAY 20 OF I64 ;
  sign, ds, out : STR ;
  be, fr, f, e, bl, x, k, d, last, nd, c, i : I64 ;
  even, tc1, tc2 : BOOL ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;

  b := NEW (scratch, BYTE, 8) ;
  F64.ToBytesLE (v, b) ;
  sign := '' ;
  IF I64 (b[7]) >= 128 THEN sign := '-' END ;
  be := (I64 (b[7]) MOD 128) * 16 + I64 (b[6]) DIV 16 ;
  fr := I64 (b[6]) MOD 16 ;
  FOR i := 5 TO 0 BY -1 DO fr := fr * 256 + I64 (b[i]) END ;
  IF be = 0 AND fr = 0 THEN RETURN sign + '0.0' END ;
  IF be = 0 THEN
    f := fr ;                                  (* subnormal *)
    e := -1074
  ELSE
    f := fr + 4503599627370496 ;               (* the hidden 2^52 *)
    e := be - 1075
  END ;
  even := f MOD 2 = 0 ;

  (* v's neighbours are one unit of f either side, except below a
     power of two, where the lower one is half as far *)
  IF e >= 0 THEN
    IF f # 4503599627370496 THEN
      BigSmall (r, f) ; BigShl (r, e + 1) ;
      BigSmall (s, 2) ;
      BigSmall (mp, 1) ; BigShl (mp, e) ;
      BigSmall (mm, 1) ; BigShl (mm, e)
    ELSE
      BigSmall (r, f) ; BigShl (r, e + 2) ;
      BigSmall (s, 4) ;
      BigSmall (mp, 1) ; BigShl (mp, e + 1) ;
      BigSmall (mm, 1) ; BigShl (mm, e)
    END
  ELSIF be <= 1 OR f # 4503599627370496 THEN
    BigSmall (r, f * 2) ;
    BigSmall (s, 1) ; BigShl (s, 1 - e) ;
    BigSmall (mp, 1) ;
    BigSmall (mm, 1)
  ELSE
    BigSmall (r, f * 4) ;
    BigSmall (s, 1) ; BigShl (s, 2 - e) ;
    BigSmall (mp, 2) ;
    BigSmall (mm, 1)
  END ;

  (* k, the decimal exponent, from the binary one: ceil (x log10 2)
     in integers, 0.30103 for log10 2.  Checked over every exponent a
     double has: never above ceil (x log10 2), at most one below it.
     It is one below only when 2^x lies just above a power of ten, and
     then the whole binade lies below twice that power, so the true k
     is the estimate or ONE more and the paper's single step is
     enough -- counted at both ends of every binade (a loop here was
     written first; its second turn never came, and FmtTest could not
     tell it from this). *)
  bl := 0 ;
  x := f ;
  WHILE x > 0 DO
    bl := bl + 1 ;
    x := x DIV 2
  END ;
  x := e + bl - 1 ;
  IF x >= 0 THEN
    k := (x * 30103 + 99999) DIV 100000
  ELSE
    k := -((-x * 30103) DIV 100000)
  END ;
  IF k >= 0 THEN
    BigTen (s, k)
  ELSE
    BigTen (r, -k) ;
    BigTen (mp, -k) ;
    BigTen (mm, -k)
  END ;
  IF High (r, mp, s, even) THEN
    BigMul (s, 10) ;
    k := k + 1
  END ;
  BigMul (r, 10) ;
  BigMul (mp, 10) ;
  BigMul (mm, 10) ;

  (* digits, until one more would leave the interval; the last one is
     the closer of d and d + 1, the even one on a tie (repr does so:
     2^-25 is 2.98023223876953125e-08, exactly between ...12 and
     ...13, and reads ...12) *)
  nd := 0 ;
  LOOP
    d := 0 ;
    WHILE BigCmp (r, s) >= 0 DO
      BigSub (r, s) ;
      d := d + 1
    END ;
    c := BigCmp (r, mm) ;
    tc1 := c < 0 OR (even AND c = 0) ;
    tc2 := High (r, mp, s, even) ;
    IF NOT tc1 AND NOT tc2 THEN
      dig[nd] := d ;
      nd := nd + 1 ;
      BigMul (r, 10) ;
      BigMul (mp, 10) ;
      BigMul (mm, 10)
    ELSE
      IF tc1 AND NOT tc2 THEN
        last := d
      ELSIF tc2 AND NOT tc1 THEN
        last := d + 1
      ELSE
        t := r ;
        BigMul (t, 2) ;
        c := BigCmp (t, s) ;
        IF c < 0 OR (c = 0 AND d MOD 2 = 0) THEN
          last := d
        ELSE
          last := d + 1
        END
      END ;
      dig[nd] := last ;
      nd := nd + 1 ;
      EXIT
    END
  END ;

  (* the value is 0.dig * 10^k; repr's layout *)
  ds := '' ;
  FOR i := 0 TO nd - 1 DO ds := ds + SLICE (HexDigits, dig[i], 1) END ;
  x := k - 1 ;                                 (* exponent of the first digit *)
  IF x >= -4 AND x < 16 THEN
    IF k <= 0 THEN
      out := '0.' + Zeros (-k) + ds
    ELSIF k >= nd THEN
      out := ds + Zeros (k - nd) + '.0'
    ELSE
      out := SLICE (ds, 0, k) + '.' + SLICE (ds, k, nd - k)
    END
  ELSE
    out := SLICE (ds, 0, 1) ;
    IF nd > 1 THEN out := out + '.' + SLICE (ds, 1, nd - 1) END ;
    IF x < 0 THEN
      out := out + 'e-' + I64Pad (-x, 2, TRUE)
    ELSE
      out := out + 'e+' + I64Pad (x, 2, TRUE)
    END
  END ;
  RETURN sign + out
END Short ;

END Fmt.
