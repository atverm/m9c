DEFINITION MODULE Fmt ;

(* Numbers to text, and back.

   This exists because M9 could not format a float in M9: Plot bound
   libc's sprintf ("%.4g") through a FOR-C shim, and Io had no way to
   print an F64 at all.  Borrowing printf is worse than it looks --
   it is LOCALE DEPENDENT, so the same program writes 3.14 or 3,14
   depending on the environment, and a JSON document that parses on
   one machine is malformed on another.  For a language whose whole
   claim is that boundaries do not lie quietly, owning this is not
   indulgence.

   Two float paths, with different promises, both stated:

     Bits  is EXACT.  It is the IEEE-754 bit pattern in hex, so
           ParseBits (Bits (x)) = x for every finite double, and for
           NaN and the infinities too.  Ugly for humans, correct for
           machines and for test goldens.

     Fixed is HUMAN, and its accuracy is MEASURED, not claimed.  It
           scales by a power of ten and rounds half to even, the rule
           printf uses.  Against printf over a hundred thousand
           in-range values it disagrees on 0.71%, always by one in
           the last digit.  The cause is not the tie rule -- that was
           tried and moved the rate by 0.01 -- but the scaling:
           v * 10^d rounds before any decision is taken.  Removing
           that needs exact decimal conversion of the Dragon4 kind,
           which nobody has written here yet.  The driver prints the
           rate on every run and fails above 1%, so the number cannot
           quietly rot.

   Use Bits when a value must survive the round trip; use Fixed when
   a person is going to read it.  Saying which is which is the point.

   Short is BOTH, since 2026-10-05: the shortest decimal that reads
   back to the same double, exact by construction (Burger and Dybvig's
   free-format digits over integers, no scaling in F64), and held to
   Python's repr on 9,148 values by FmtTest. *)

CONST
  MaxDecimals = 17 ;

PROCEDURE I64Str (v: I64) : STR ;
  (* decimal text of v, sign and all.  Total for every I64 including
     MIN: the digits are taken in NEGATIVE space, where every I64
     fits, because -MIN does not.

     NO POOL, here or anywhere below: a formatter answers a string
     the caller reads once, and par 2.3 places that string in the
     caller's arena.  These took a pool until 2026-09-03, and every
     caller in the corpus passed one only to throw the result at
     Append or WriteLine.                                            *)

PROCEDURE Hex (v: I64 ; width: I64) : STR ;
  (* v in lower-case hexadecimal, zero-padded to `width' digits --
     Python's '%0*x' % (width, v) for v >= 0.  A negative v is read as
     the 64-bit pattern it is (its two's complement, sixteen digits),
     as a CRC or a hash word held in an I64 means.  Never truncated:
     a wider value overflows the field (cp-kernel's issue 16). *)

PROCEDURE I64Pad (v: I64 ; width: I64 ; zero: BOOL) : STR ;
  (* right-aligned in width; zero selects '0' over ' ' as the fill.
     A value too wide is never truncated -- silently losing digits is
     the class of bug this language refuses -- it just overflows the
     field, as printf does.                                          *)

PROCEDURE Fixed (v: F64 ; decimals: I64) : STR RAISES ValueRange ;
  (* decimals in 0..MaxDecimals, else ValueRange; printf's %.*f to
     the character -- the double's own decimal expansion rounded half
     to even, every magnitude (1e308 prints its 309 digits).  A value
     that rounds to zero keeps its '-' (-0.001 is -0.00, as printf);
     negative ZERO prints without one, the sign bit is not consulted.
     NaN prints 'nan', the infinities 'inf' and '-inf'.  Exact since
     2026-10-10; it scaled in F64 until then and disagreed with printf
     on 0.71% of values, 1e300 raised.                               *)

PROCEDURE FixedPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange ;
  (* Pascal's `v:width:decimals`, which is where the shape comes
     from: Fixed, then right-aligned in width with BLANKS.  Pascal
     pads a real field with blanks and never with zeros, so there is
     no zero flag here as there is on I64Pad; a leading-zero float is
     a different thing and nobody has asked for one.

     Too wide is never truncated -- it overflows the field, exactly
     as I64Pad does and for the same reason: silently losing digits
     is the class of bug this language refuses.                     *)

PROCEDURE Sci (v: F64 ; decimals: I64) : STR RAISES ValueRange ;
  (* scientific notation, one digit before the point and `decimals`
     after it, then 'e' and the decimal exponent: 3.14e-5.

     THE EXPONENT IS WRITTEN THE SHORT WAY, which is neither C's nor
     Pascal's.  printf %.2e gives 3.14e-05 and Pascal gives
     3.14000000000000E-005; both pad the exponent to a fixed width so
     that columns line up, and this pads with the WIDTH parameter
     instead, which is what SciPad is for.  So: 'e', a '-' only when
     the exponent is negative, and no leading zeros -- 3.14e-5 and
     3.14e5.

     Zero prints as 0.00e0, and NEGATIVE zero prints without the
     sign, as Fixed already does: neither consults the sign bit.
     printf disagrees on that one value and the driver excludes it
     rather than pretending they agree.

     The digits are printf's %.*e to the character, as Fixed's are
     %.*f's: exact, from the double's integer mantissa and exponent,
     half to even (FmtTest holds both to Python's % formatting).  Until
     2026-10-10 the mantissa was normalised in F64 and measured, not
     exact.                                                         *)

PROCEDURE SciPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange ;
  (* Sci, right-aligned in width with blanks -- the `:x:y` of the
     scientific form.  A short exponent makes the field ragged on the
     right, which is what the width is for.                         *)

PROCEDURE Short (v: F64) : STR ;
  (* the SHORTEST decimal that reads back to exactly v -- the closest
     such when there are several, the even last digit on a tie -- in
     Python's repr layout: positional for 1e-4 <= |v| < 1e16 (1.0,
     0.0001, 1234.5), else one digit, a point if more follow, and a
     signed two-digit-or-more exponent (1e+16, 2.5e-05).  -0.0 keeps
     its sign; NaN is 'nan', the infinities 'inf' and '-inf'.  Total:
     no RAISES, every double has an answer.  What a person reads and
     what a machine reads back are the same number.                 *)

PROCEDURE Bits (v: F64) : STR ;
PROCEDURE ParseBits (RO s: STR) : F64 RAISES ValueRange ;
  (* the exact pair: 16 hex digits, low byte first, round-trip total *)

PROCEDURE ParseF64 (RO s: STR) : F64 RAISES ValueRange ;
  (* decimal, with optional sign, fraction and exponent.  Rejects
     anything else, because a command line or a data file that says
     it holds a number and does not is the boundary this catches.
     CORRECTLY ROUNDED -- the double nearest the decimal, ties to
     even, Python's float() -- subnormals and digit strings of any
     length included; a decimal beyond the largest double RAISES
     ValueRange.  In M9 and in integers, no libc: Clinger's fast path,
     else an exact quotient (the implementation says how).  Until
     2026-10-09 it scaled in F64 and was
     wrong in 1,314 of 3,510 strings measured -- by 1 to 10 ulp, the
     largest double read as infinity, subnormals as zero (cp-kernel's
     finding on 0.19.0).
     THE INTEGER READER IS Io.ParseI64 (RAISES ValueRange, Overflow):
     an optional minus and decimal digits, every I64 down to the
     smallest.  It lives in Io because Fmt imports nothing and Io is
     where the command line is read; a reader looking here is sent
     there (cp-kernel's issue 6, 2026-10-09).                        *)

END Fmt.


IMPLEMENTATION MODULE Fmt ;

CONST
  HexDigits = '0123456789ABCDEF' ;
  MaxF64    = 1.7976931348623157E308 ;

(* Digits are PREPENDED, least significant first, and that is a copy
   per digit rather than the in-place extension an append gets --
   twenty of them at most, so the arena holds under 200 characters
   for the worst I64, and nothing here is on anyone's hot path.
   The digit itself is a one-character SLICE of the digit table,
   because `+` takes strings and a CHAR is not one.                  *)
PROCEDURE I64Str (v: I64) : STR =
VAR
  s : STR ;
  q : I64 ;
BEGIN
  IF v = 0 THEN RETURN '0' END ;
  s := '' ;
  (* negative space: q is v or -v, whichever is <= 0, and MOD / DIV
     truncate toward zero, so one digit is negated at a time and
     none of it can overflow *)
  q := v ;
  IF q > 0 THEN q := -q END ;
  WHILE q # 0 DO
    s := SLICE (HexDigits, -(q MOD 10), 1) + s ;
    q := q DIV 10
  END ;
  IF v < 0 THEN s := '-' + s END ;
  RETURN s
END I64Str ;

CONST
  HexLower = '0123456789abcdef' ;   (* Hex's digits; HexDigits above is upper case *)

PROCEDURE Hex (v: I64 ; width: I64) : STR =
VAR
  digits : ARRAY 16 OF CHAR ;
  n, d, k, i : I64 ;
  s : STR ;
BEGIN
  (* nibble by nibble from the right, by floor division, so that a
     negative v gives its two's complement: after sixteen nibbles the
     whole pattern is out *)
  n := v ;
  k := 0 ;
  LOOP
    d := n MOD 16 ;
    IF d < 0 THEN d := d + 16 END ;
    n := (n - d) DIV 16 ;
    digits[k] := HexLower[d] ;
    k := k + 1 ;
    IF k = 16 OR (n = 0 AND v >= 0) THEN EXIT END
  END ;
  s := '' ;
  FOR i := k + 1 TO width DO s := s + '0' END ;
  FOR i := k - 1 TO 0 BY -1 DO s := s + digits[i] END ;
  RETURN s
END Hex ;

PROCEDURE I64Pad (v: I64 ; width: I64 ; zero: BOOL) : STR =
VAR
  body, s : STR ;
  i, n : I64 ;
  neg : BOOL ;
BEGIN
  body := I64Str (v) ;
  n := LEN (body) ;
  IF n >= width THEN RETURN body END ;
  neg := FALSE ;
  IF n > 0 THEN neg := body[0] = '-' END ;
  IF zero AND neg THEN
    (* the sign leads the zeros, not the other way round *)
    s := '-' ;
    FOR i := 1 TO width - n DO s := s + '0' END ;
    s := s + SLICE (body, 1, n - 1)
  ELSE
    s := '' ;
    FOR i := 1 TO width - n DO
      IF zero THEN s := s + '0' ELSE s := s + ' ' END
    END ;
    s := s + body
  END ;
  RETURN s
END I64Pad ;

PROCEDURE Pow10 (n: I64) : F64 =
VAR
  i : I64 ;
  p : F64 ;
BEGIN
  p := 1.0 ;
  FOR i := 1 TO n DO p := p * 10.0 END ;
  RETURN p
END Pow10 ;

PROCEDURE Pow10I (n: I64) : I64 =
VAR
  i, p : I64 ;
BEGIN
  p := 1 ;
  FOR i := 1 TO n DO p := p * 10 END ;
  RETURN p
END Pow10I ;

(* Blank-padding, right-aligned.  I64Pad keeps its own copy because
   it has the zero fill and the sign-before-the-zeros rule to obey;
   this is the plain one that FixedPad and SciPad share. *)
PROCEDURE PadLeft (RO body: STR ; width: I64) : STR =
VAR
  s : STR ;
  i : I64 ;
BEGIN
  IF LEN (body) >= width THEN RETURN body END ;
  s := '' ;
  FOR i := 1 TO width - LEN (body) DO s := s + ' ' END ;
  RETURN s + body
END PadLeft ;

PROCEDURE Bits (v: F64) : STR =
VAR
  s : STR ;
  b : SLICE OF BYTE ;
  scratch : POOL ;
  i, x : I64 ;
BEGIN
  b := NEW (scratch, BYTE, 8) ;
  F64.ToBytesLE (v, b) ;
  s := '' ;
  FOR i := 0 TO 7 DO
    x := I64 (b[i]) ;
    s := s + SLICE (HexDigits, x DIV 16, 1) + SLICE (HexDigits, x MOD 16, 1)
  END ;
  RETURN s
END Bits ;

PROCEDURE HexVal (c: CHAR) : I64 RAISES ValueRange =
BEGIN
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 END ;
  IF c >= 'A' AND c <= 'F' THEN RETURN ORD (c) - 55 END ;
  IF c >= 'a' AND c <= 'f' THEN RETURN ORD (c) - 87 END ;
  RAISE ValueRange
END HexVal ;

PROCEDURE ParseBits (RO s: STR) : F64 RAISES ValueRange =
VAR
  scratch : POOL ;
  b : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  IF LEN (s) # 16 THEN RAISE ValueRange END ;
  b := NEW (scratch, BYTE, 8) ;
  FOR i := 0 TO 7 DO
    b[i] := BYTE (HexVal (s[2 * i]) * 16 + HexVal (s[2 * i + 1]))
  END ;
  RETURN F64.FromBytesLE (b)
END ParseBits ;

(* ---- Short: Burger and Dybvig's free-format digits ----

   The value is f * 2^e exactly.  r / s is the value scaled so that
   its digits come out one at a time, mp and mm are the distances to
   the halfway points between v and its neighbours, scaled alike: any
   decimal strictly inside (v - mm, v + mp) reads back as v, and on
   the boundary too when f is even, because a reader rounds a tie to
   the even mantissa.  All four are integers, so nothing is rounded
   on the way -- the reason it is exact where Fixed is measured.

   Integers of limbs of 32 bits: Short's largest is s for the smallest
   subnormal, 2^1075 times ten, 36 limbs; ParseF64's is near 116 (it
   says why), and Limbs serves both.                                  *)

CONST
  Limbs = 128 ;
  Base  = 4294967296 ;          (* 2^32: a limb times 2^31 fits an I64 *)

(* The helpers take a Big as VAR even where they only read it: an RO
   record is passed as a COPY today (the owed ledger's "RO on a RECORD
   copies it"), and at 128 limbs that copy was most of the time --
   Short ran at half its speed and ParseF64's quotient loop copied two
   kilobytes a step.  None of them writes what it only reads.         *)

TYPE
  Big = RECORD
    n : I64 ;                   (* limbs in use, the top one non-zero *)
    d : ARRAY Limbs OF I64      (* least significant first *)
  END ;

PROCEDURE BigSmall (VAR a: Big ; v: I64) =
BEGIN
  a.n := 0 ;
  WHILE v > 0 DO
    a.d[a.n] := v MOD Base ;
    v := v DIV Base ;
    a.n := a.n + 1
  END
END BigSmall ;

(* a := a * m, 0 < m < 2^31 *)
PROCEDURE BigMul (VAR a: Big ; m: I64) =
VAR i, x, carry : I64 ;
BEGIN
  carry := 0 ;
  FOR i := 0 TO a.n - 1 DO
    x := a.d[i] * m + carry ;
    a.d[i] := x MOD Base ;
    carry := x DIV Base
  END ;
  WHILE carry > 0 DO
    a.d[a.n] := carry MOD Base ;
    carry := carry DIV Base ;
    a.n := a.n + 1
  END
END BigMul ;

PROCEDURE BigShl (VAR a: Big ; k: I64) =
VAR m : I64 ;
BEGIN
  WHILE k >= 30 DO
    BigMul (a, 1073741824) ;
    k := k - 30
  END ;
  m := 1 ;
  WHILE k > 0 DO
    m := m * 2 ;
    k := k - 1
  END ;
  IF m > 1 THEN BigMul (a, m) END
END BigShl ;

PROCEDURE BigTen (VAR a: Big ; k: I64) =
VAR m : I64 ;
BEGIN
  WHILE k >= 9 DO
    BigMul (a, 1000000000) ;
    k := k - 9
  END ;
  m := 1 ;
  WHILE k > 0 DO
    m := m * 10 ;
    k := k - 1
  END ;
  IF m > 1 THEN BigMul (a, m) END
END BigTen ;

PROCEDURE BigCmp (VAR a, b: Big) : I64 =
VAR i : I64 ;
BEGIN
  IF a.n # b.n THEN
    IF a.n < b.n THEN RETURN -1 END ;
    RETURN 1
  END ;
  FOR i := a.n - 1 TO 0 BY -1 DO
    IF a.d[i] # b.d[i] THEN
      IF a.d[i] < b.d[i] THEN RETURN -1 END ;
      RETURN 1
    END
  END ;
  RETURN 0
END BigCmp ;

PROCEDURE BigAdd (VAR a, b, c: Big) =
VAR i, x, carry, n : I64 ;
BEGIN
  n := a.n ;
  IF b.n > n THEN n := b.n END ;
  carry := 0 ;
  FOR i := 0 TO n - 1 DO
    x := carry ;
    IF i < a.n THEN x := x + a.d[i] END ;
    IF i < b.n THEN x := x + b.d[i] END ;
    c.d[i] := x MOD Base ;
    carry := x DIV Base
  END ;
  c.n := n ;
  IF carry > 0 THEN
    c.d[n] := carry ;
    c.n := n + 1
  END
END BigAdd ;

(* a := a - b, a >= b *)
PROCEDURE BigSub (VAR a, b: Big) =
VAR i, x, borrow : I64 ;
BEGIN
  borrow := 0 ;
  FOR i := 0 TO a.n - 1 DO
    x := a.d[i] - borrow ;
    IF i < b.n THEN x := x - b.d[i] END ;
    IF x < 0 THEN
      x := x + Base ;
      borrow := 1
    ELSE
      borrow := 0
    END ;
    a.d[i] := x
  END ;
  WHILE a.n > 0 AND a.d[a.n - 1] = 0 DO a.n := a.n - 1 END
END BigSub ;

(* r + mp reaches s: past it, or onto it when the boundary is in *)
PROCEDURE High (VAR r, mp, s: Big ; even: BOOL) : BOOL =
VAR
  t : Big ;
  c : I64 ;
BEGIN
  BigAdd (r, mp, t) ;
  c := BigCmp (t, s) ;
  RETURN c > 0 OR (even AND c = 0)
END High ;

PROCEDURE Zeros (n: I64) : STR =
VAR s : STR ;
BEGIN
  s := '' ;
  WHILE n > 0 DO
    s := s + '0' ;
    n := n - 1
  END ;
  RETURN s
END Zeros ;

PROCEDURE Short (v: F64) : STR =
VAR
  b : SLICE OF BYTE ;
  scratch : POOL ;
  r, s, mp, mm, t : Big ;
  dig : ARRAY 20 OF I64 ;
  sign, ds, out : STR ;
  be, fr, f, e, bl, x, k, d, last, nd, c, i : I64 ;
  even, tc1, tc2 : BOOL ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;

  b := NEW (scratch, BYTE, 8) ;
  F64.ToBytesLE (v, b) ;
  sign := '' ;
  IF I64 (b[7]) >= 128 THEN sign := '-' END ;
  be := (I64 (b[7]) MOD 128) * 16 + I64 (b[6]) DIV 16 ;
  fr := I64 (b[6]) MOD 16 ;
  FOR i := 5 TO 0 BY -1 DO fr := fr * 256 + I64 (b[i]) END ;
  IF be = 0 AND fr = 0 THEN RETURN sign + '0.0' END ;
  IF be = 0 THEN
    f := fr ;                                  (* subnormal *)
    e := -1074
  ELSE
    f := fr + 4503599627370496 ;               (* the hidden 2^52 *)
    e := be - 1075
  END ;
  even := f MOD 2 = 0 ;

  (* v's neighbours are one unit of f either side, except below a
     power of two, where the lower one is half as far *)
  IF e >= 0 THEN
    IF f # 4503599627370496 THEN
      BigSmall (r, f) ; BigShl (r, e + 1) ;
      BigSmall (s, 2) ;
      BigSmall (mp, 1) ; BigShl (mp, e) ;
      BigSmall (mm, 1) ; BigShl (mm, e)
    ELSE
      BigSmall (r, f) ; BigShl (r, e + 2) ;
      BigSmall (s, 4) ;
      BigSmall (mp, 1) ; BigShl (mp, e + 1) ;
      BigSmall (mm, 1) ; BigShl (mm, e)
    END
  ELSIF be <= 1 OR f # 4503599627370496 THEN
    BigSmall (r, f * 2) ;
    BigSmall (s, 1) ; BigShl (s, 1 - e) ;
    BigSmall (mp, 1) ;
    BigSmall (mm, 1)
  ELSE
    BigSmall (r, f * 4) ;
    BigSmall (s, 1) ; BigShl (s, 2 - e) ;
    BigSmall (mp, 2) ;
    BigSmall (mm, 1)
  END ;

  (* k, the decimal exponent, from the binary one: ceil (x log10 2)
     in integers, 0.30103 for log10 2.  Checked over every exponent a
     double has: never above ceil (x log10 2), at most one below it.
     It is one below only when 2^x lies just above a power of ten, and
     then the whole binade lies below twice that power, so the true k
     is the estimate or ONE more and the paper's single step is
     enough -- counted at both ends of every binade (a loop here was
     written first; its second turn never came, and FmtTest could not
     tell it from this). *)
  bl := 0 ;
  x := f ;
  WHILE x > 0 DO
    bl := bl + 1 ;
    x := x DIV 2
  END ;
  x := e + bl - 1 ;
  IF x >= 0 THEN
    k := (x * 30103 + 99999) DIV 100000
  ELSE
    k := -((-x * 30103) DIV 100000)
  END ;
  IF k >= 0 THEN
    BigTen (s, k)
  ELSE
    BigTen (r, -k) ;
    BigTen (mp, -k) ;
    BigTen (mm, -k)
  END ;
  IF High (r, mp, s, even) THEN
    BigMul (s, 10) ;
    k := k + 1
  END ;
  BigMul (r, 10) ;
  BigMul (mp, 10) ;
  BigMul (mm, 10) ;

  (* digits, until one more would leave the interval; the last one is
     the closer of d and d + 1, the even one on a tie (repr does so:
     2^-25 is 2.98023223876953125e-08, exactly between ...12 and
     ...13, and reads ...12) *)
  nd := 0 ;
  LOOP
    d := 0 ;
    WHILE BigCmp (r, s) >= 0 DO
      BigSub (r, s) ;
      d := d + 1
    END ;
    c := BigCmp (r, mm) ;
    tc1 := c < 0 OR (even AND c = 0) ;
    tc2 := High (r, mp, s, even) ;
    IF NOT tc1 AND NOT tc2 THEN
      dig[nd] := d ;
      nd := nd + 1 ;
      BigMul (r, 10) ;
      BigMul (mp, 10) ;
      BigMul (mm, 10)
    ELSE
      IF tc1 AND NOT tc2 THEN
        last := d
      ELSIF tc2 AND NOT tc1 THEN
        last := d + 1
      ELSE
        t := r ;
        BigMul (t, 2) ;
        c := BigCmp (t, s) ;
        IF c < 0 OR (c = 0 AND d MOD 2 = 0) THEN
          last := d
        ELSE
          last := d + 1
        END
      END ;
      dig[nd] := last ;
      nd := nd + 1 ;
      EXIT
    END
  END ;

  (* the value is 0.dig * 10^k; repr's layout *)
  ds := '' ;
  FOR i := 0 TO nd - 1 DO ds := ds + SLICE (HexDigits, dig[i], 1) END ;
  x := k - 1 ;                                 (* exponent of the first digit *)
  IF x >= -4 AND x < 16 THEN
    IF k <= 0 THEN
      out := '0.' + Zeros (-k) + ds
    ELSIF k >= nd THEN
      out := ds + Zeros (k - nd) + '.0'
    ELSE
      out := SLICE (ds, 0, k) + '.' + SLICE (ds, k, nd - k)
    END
  ELSE
    out := SLICE (ds, 0, 1) ;
    IF nd > 1 THEN out := out + '.' + SLICE (ds, 1, nd - 1) END ;
    IF x < 0 THEN
      out := out + 'e-' + I64Pad (-x, 2, TRUE)
    ELSE
      out := out + 'e+' + I64Pad (x, 2, TRUE)
    END
  END ;
  RETURN sign + out
END Short ;

(* ---- ParseF64: the correctly rounded double, in integers ----

   The digits are read into dg, so the decimal is dg * 10^e exactly.
   Most data is decided by Clinger's fast path: at most 15 digits and
   |e| <= 22, where dg and 10^|e| are both doubles and the one multiply
   or divide rounds once.  Everything else is decided in integers:
   num / den is the decimal, the double is m * 2^q with m the 53-bit
   quotient of num and den * 2^q, and the remainder against half of
   den * 2^q says which way m rounds -- ties to the even m.  Nothing
   is estimated that is not then checked.

   A halfway point between two doubles has at most 767 significant
   digits, so a decimal longer than MaxDig is cut there with a 1
   appended when anything but zeros was cut: the 1 keeps the cut
   decimal on the same side of every halfway point as the whole one
   (fast_float's rule).  The largest integer met is then the
   denominator of a decimal at the bottom of the subnormals with all
   768 digits, 10^1091 shifted by 54, about 3,680 bits: Limbs is 128,
   4,096 bits.                                                        *)

CONST
  MaxDig = 768 ;
  Two52  = 4503599627370496 ;
  Two53  = 9007199254740992 ;
  Two54  = 18014398509481984 ;

(* a := a + v, 0 <= v < Base *)
PROCEDURE BigPlus (VAR a: Big ; v: I64) =
VAR i, x : I64 ;
BEGIN
  i := 0 ;
  WHILE v > 0 DO
    IF i = a.n THEN
      a.d[i] := 0 ;
      a.n := a.n + 1
    END ;
    x := a.d[i] + v ;
    a.d[i] := x MOD Base ;
    v := x DIV Base ;
    i := i + 1
  END
END BigPlus ;

PROCEDURE BitLen (VAR a: Big) : I64 =
VAR x, k : I64 ;
BEGIN
  IF a.n = 0 THEN RETURN 0 END ;
  x := a.d[a.n - 1] ;
  k := 32 * (a.n - 1) ;
  WHILE x > 0 DO
    k := k + 1 ;
    x := x DIV 2
  END ;
  RETURN k
END BitLen ;

(* the top limbs of a as a double, and the power of 2^32 it stands for *)
PROCEDURE TopF (VAR a: Big ; VAR k: I64) : F64 RAISES ValueRange =
VAR
  f : F64 ;
  i : I64 ;
BEGIN
  f := 0.0 ;
  k := a.n ;
  FOR i := 1 TO 3 DO
    IF k > 0 THEN
      k := k - 1 ;
      f := f * 4294967296.0 + F64 (a.d[k])
    END
  END ;
  RETURN f
END TopF ;

(* a := a * m, 0 <= m < 2^54 *)
PROCEDURE BigMulWide (VAR a: Big ; m: I64) =
VAR t : Big ;
BEGIN
  IF m = 0 THEN
    a.n := 0
  ELSIF m < 1073741824 THEN
    BigMul (a, m)
  ELSE
    t := a ;
    BigMul (t, m MOD 134217728) ;
    IF m DIV 134217728 > 0 THEN
      BigMul (a, m DIV 134217728) ;
      BigShl (a, 27) ;
      BigAdd (a, t, a)
    ELSE
      a := t
    END
  END
END BigMulWide ;

(* a DIV b, below 2^54 by the caller's choice of scale; a keeps the
   remainder.  The quotient of the top limbs as doubles is within a
   few units of the true one (relative error near 2^-50); the product
   then says exactly how far, and the loops walk the rest. *)
PROCEDURE Quot (VAR a, b: Big) : I64 RAISES ValueRange =
VAR
  t : Big ;
  fa, fb, r : F64 ;
  ka, kb, m : I64 ;
BEGIN
  IF BigCmp (a, b) < 0 THEN RETURN 0 END ;
  fa := TopF (a, ka) ;
  fb := TopF (b, kb) ;
  r := fa / fb ;
  WHILE ka > kb DO
    r := r * 4294967296.0 ;
    ka := ka - 1
  END ;
  WHILE ka < kb DO
    r := r / 4294967296.0 ;
    ka := ka + 1
  END ;
  m := 0 ;
  IF r > 1.0 THEN m := I64 (r) END ;
  IF m >= Two54 THEN m := Two54 - 1 END ;
  t := b ;
  BigMulWide (t, m) ;
  WHILE BigCmp (t, a) > 0 DO
    BigSub (t, b) ;
    m := m - 1
  END ;
  BigSub (a, t) ;
  WHILE BigCmp (a, b) >= 0 DO
    BigSub (a, b) ;
    m := m + 1
  END ;
  RETURN m
END Quot ;

(* the double with this sign, biased exponent and fraction *)
PROCEDURE Make (neg: BOOL ; be, fr: I64) : F64 RAISES ValueRange =
VAR
  b : SLICE OF BYTE ;
  scratch : POOL ;
  i, x : I64 ;
BEGIN
  b := NEW (scratch, BYTE, 8) ;
  FOR i := 0 TO 5 DO
    b[i] := BYTE (fr MOD 256) ;
    fr := fr DIV 256
  END ;
  b[6] := BYTE (fr + (be MOD 16) * 16) ;
  x := be DIV 16 ;
  IF neg THEN x := x + 128 END ;
  b[7] := BYTE (x) ;
  RETURN F64.FromBytesLE (b)
END Make ;

(* ---- Fixed and Sci: printf's digits, in integers ----

   The value is f * 2^e exactly, so the number a format prints is
   N = f * 2^e * 10^p rounded to an integer, half to even, with p the
   decimals for Fixed and the decimals less the exponent for Sci.
   Both are exact quotients of integers: whatever power of two or ten
   is negative goes into the divisor, and the remainder against half
   the divisor says which way N rounds.  So the digits are the ones
   the decimal expansion of the double has, which is what glibc's
   printf prints -- not those of a product rounded in F64, which is
   what these did until 2026-10-10 (0.71% of Fixed's values wrong in
   the old driver, 1e300 refused outright).                           *)

PROCEDURE Pow2 (k: I64) : I64 =
VAR m : I64 ;
BEGIN
  m := 1 ;
  WHILE k > 0 DO
    m := m * 2 ;
    k := k - 1
  END ;
  RETURN m
END Pow2 ;

(* a := a DIV 2^k, the bits below dropped *)
PROCEDURE BigShr (VAR a: Big ; k: I64) =
VAR q, r, lo, hi, i : I64 ;
BEGIN
  q := k DIV 32 ;
  r := k MOD 32 ;
  IF q >= a.n THEN
    a.n := 0 ;
    RETURN
  END ;
  FOR i := 0 TO a.n - 1 - q DO
    lo := a.d[i + q] DIV Pow2 (r) ;
    hi := 0 ;
    IF r > 0 AND i + q + 1 < a.n THEN
      hi := (a.d[i + q + 1] MOD Pow2 (r)) * Pow2 (32 - r)
    END ;
    a.d[i] := lo + hi
  END ;
  a.n := a.n - q ;
  WHILE a.n > 0 AND a.d[a.n - 1] = 0 DO a.n := a.n - 1 END
END BigShr ;

(* bit i of a *)
PROCEDURE BigBit (VAR a: Big ; i: I64) : BOOL =
BEGIN
  IF i DIV 32 >= a.n THEN RETURN FALSE END ;
  RETURN (a.d[i DIV 32] DIV Pow2 (i MOD 32)) MOD 2 = 1
END BigBit ;

(* some bit of a below bit k is set *)
PROCEDURE BigAnyBelow (VAR a: Big ; k: I64) : BOOL =
VAR i, q : I64 ;
BEGIN
  q := k DIV 32 ;
  FOR i := 0 TO q - 1 DO
    IF i < a.n AND a.d[i] # 0 THEN RETURN TRUE END
  END ;
  IF q < a.n AND a.d[q] MOD Pow2 (k MOD 32) # 0 THEN RETURN TRUE END ;
  RETURN FALSE
END BigAnyBelow ;

(* a := a DIV m, answering a MOD m; 0 < m < 2^31 *)
PROCEDURE BigDivSmall (VAR a: Big ; m: I64) : I64 =
VAR i, x, r : I64 ;
BEGIN
  r := 0 ;
  FOR i := a.n - 1 TO 0 BY -1 DO
    x := r * Base + a.d[i] ;
    a.d[i] := x DIV m ;
    r := x MOD m
  END ;
  WHILE a.n > 0 AND a.d[a.n - 1] = 0 DO a.n := a.n - 1 END ;
  RETURN r
END BigDivSmall ;

(* the decimal digits of a, which it consumes: '0' for zero *)
PROCEDURE BigDec (VAR a: Big) : STR =
VAR
  chunk : ARRAY 160 OF I64 ;
  nc, i : I64 ;
  s : STR ;
BEGIN
  IF a.n = 0 THEN RETURN '0' END ;
  nc := 0 ;
  WHILE a.n > 0 DO
    chunk[nc] := BigDivSmall (a, 1000000000) ;
    nc := nc + 1
  END ;
  s := I64Str (chunk[nc - 1]) ;
  FOR i := nc - 2 TO 0 BY -1 DO s := s + I64Pad (chunk[i], 9, TRUE) END ;
  RETURN s
END BigDec ;

(* v's mantissa and exponent: |v| = f * 2^e; FALSE for a zero *)
PROCEDURE Parts (v: F64 ; VAR f, e: I64) : BOOL =
VAR
  b : SLICE OF BYTE ;
  scratch : POOL ;
  be, i : I64 ;
BEGIN
  b := NEW (scratch, BYTE, 8) ;
  F64.ToBytesLE (v, b) ;
  be := (I64 (b[7]) MOD 128) * 16 + I64 (b[6]) DIV 16 ;
  f := I64 (b[6]) MOD 16 ;
  FOR i := 5 TO 0 BY -1 DO f := f * 256 + I64 (b[i]) END ;
  IF be = 0 AND f = 0 THEN RETURN FALSE END ;
  IF be = 0 THEN
    e := -1074                                 (* subnormal *)
  ELSE
    f := f + Two52 ;
    e := be - 1075
  END ;
  RETURN TRUE
END Parts ;

PROCEDURE Fixed (v: F64 ; decimals: I64) : STR RAISES ValueRange =
VAR
  n : Big ;
  f, e : I64 ;
  ds, s : STR ;
  up : BOOL ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;
  IF decimals < 0 OR decimals > MaxDecimals THEN RAISE ValueRange END ;

  n.n := 0 ;
  IF Parts (v, f, e) THEN
    BigSmall (n, f) ;
    BigTen (n, decimals) ;
    IF e >= 0 THEN
      BigShl (n, e)
    ELSE
      (* the divisor is 2^-e: the bit below the quotient is the half,
         the bits under that say whether it is more than half *)
      up := BigBit (n, -e - 1) ;
      IF up AND NOT BigAnyBelow (n, -e - 1) THEN
        up := BigBit (n, -e)                   (* a tie: to even *)
      END ;
      BigShr (n, -e) ;
      IF up THEN BigPlus (n, 1) END
    END
  END ;

  ds := BigDec (n) ;
  IF LEN (ds) <= decimals THEN ds := Zeros (decimals + 1 - LEN (ds)) + ds END ;
  s := '' ;
  IF v < 0.0 THEN s := '-' END ;
  IF decimals = 0 THEN RETURN s + ds END ;
  RETURN s + SLICE (ds, 0, LEN (ds) - decimals) + '.'
           + SLICE (ds, LEN (ds) - decimals, decimals)
END Fixed ;

PROCEDURE FixedPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange =
BEGIN
  RETURN PadLeft (Fixed (v, decimals), width)
END FixedPad ;

(* f * 2^e * 10^p rounded half to even, while that is below 2^62;
   above, the bits of the quotient saturate at 2^62 - 1 (and the
   rounding may add one), more than any 18 digits, which is all Sci
   asks: the exponent was guessed too low *)
PROCEDURE Scaled (f, e, p: I64) : I64 =
VAR
  num, den, t : Big ;
  q, j, c : I64 ;
BEGIN
  BigSmall (num, f) ;
  BigSmall (den, 1) ;
  IF e >= 0 THEN BigShl (num, e) ELSE BigShl (den, -e) END ;
  IF p >= 0 THEN BigTen (num, p) ELSE BigTen (den, -p) END ;
  t := den ;
  BigShl (t, 62) ;
  (* long division a bit at a time: t is den * 2^j *)
  q := 0 ;
  FOR j := 61 TO 0 BY -1 DO
    BigShr (t, 1) ;
    q := q * 2 ;
    IF BigCmp (num, t) >= 0 THEN
      BigSub (num, t) ;
      q := q + 1
    END
  END ;
  BigMul (num, 2) ;
  c := BigCmp (num, den) ;
  IF c > 0 OR (c = 0 AND q MOD 2 = 1) THEN q := q + 1 END ;
  RETURN q
END Scaled ;

PROCEDURE Sci (v: F64 ; decimals: I64) : STR RAISES ValueRange =
VAR
  f, e, x, k, hi, nn, bl : I64 ;
  ds, s : STR ;
BEGIN
  IF v # v THEN RETURN 'nan' END ;
  IF v > MaxF64 THEN RETURN 'inf' END ;
  IF v < -MaxF64 THEN RETURN '-inf' END ;
  IF decimals < 0 OR decimals > MaxDecimals THEN RAISE ValueRange END ;

  s := '' ;
  IF v < 0.0 THEN s := '-' END ;
  IF NOT Parts (v, f, e) THEN
    k := 0 ;
    nn := 0
  ELSE
    (* 2^x <= |v| < 2^(x+1), so the decimal exponent is floor (x log10
       2) or one more.  0.30103 is log10 2 a part in 10^7 HIGH, and
       counted over every x from -1075 to 1023 the floor below is
       floor (x log10 2) all the same: the guess is never above the
       exponent, so the loop only ever moves it up *)
    bl := 0 ;
    x := f ;
    WHILE x > 0 DO
      bl := bl + 1 ;
      x := x DIV 2
    END ;
    x := e + bl - 1 ;
    IF x >= 0 THEN
      k := (x * 30103) DIV 100000
    ELSE
      k := -((-x * 30103 + 99999) DIV 100000)
    END ;
    hi := Pow10I (decimals + 1) ;
    (* N must have at most decimals + 1 digits; more, or a rounding up
       to 10^(d+1) (9.999 at two decimals), is a guess one too low, and
       the next turn rounds the value itself again -- never N divided
       by ten.  Three turns at the most. *)
    LOOP
      nn := Scaled (f, e, decimals - k) ;
      IF nn < hi THEN EXIT END ;
      k := k + 1
    END
  END ;

  ds := I64Str (nn) ;
  IF decimals = 0 THEN RETURN s + ds + 'e' + I64Str (k) END ;
  IF nn = 0 THEN ds := Zeros (decimals + 1) END ;
  RETURN s + SLICE (ds, 0, 1) + '.' + SLICE (ds, 1, decimals) + 'e' + I64Str (k)
END Sci ;

PROCEDURE SciPad (v: F64 ; width, decimals: I64) : STR
  RAISES ValueRange =
BEGIN
  RETURN PadLeft (Sci (v, decimals), width)
END SciPad ;

PROCEDURE ParseF64 (RO s: STR) : F64 RAISES ValueRange =
VAR
  i, n, d, digits, kept, dexp, ex, e, fast, b, q, m, c, be, fr : I64 ;
  neg, seenDot, nonzero, sticky, eneg : BOOL ;
  dg, num, den, n2, d2 : Big ;
  v : F64 ;
BEGIN
  n := LEN (s) ;
  IF n = 0 THEN RAISE ValueRange END ;
  i := 0 ;
  neg := FALSE ;
  IF s[0] = '-' OR s[0] = '+' THEN
    neg := s[0] = '-' ;
    i := 1
  END ;

  (* the mantissa: leading zeros counted, not kept; the first MaxDig
     significant digits kept, the rest only remembered *)
  digits := 0 ;
  kept := 0 ;
  dexp := 0 ;
  fast := 0 ;
  seenDot := FALSE ;
  nonzero := FALSE ;
  sticky := FALSE ;
  BigSmall (dg, 0) ;
  WHILE i < n DO
    IF s[i] = '.' THEN
      IF seenDot THEN RAISE ValueRange END ;
      seenDot := TRUE
    ELSIF s[i] >= '0' AND s[i] <= '9' THEN
      d := ORD (s[i]) - 48 ;
      digits := digits + 1 ;
      IF d # 0 THEN nonzero := TRUE END ;
      IF NOT nonzero THEN
        IF seenDot THEN dexp := dexp - 1 END
      ELSIF kept < MaxDig THEN
        BigMul (dg, 10) ;
        BigPlus (dg, d) ;
        IF kept < 18 THEN fast := fast * 10 + d END ;
        kept := kept + 1 ;
        IF seenDot THEN dexp := dexp - 1 END
      ELSE
        IF d # 0 THEN sticky := TRUE END ;
        IF NOT seenDot THEN dexp := dexp + 1 END
      END
    ELSE
      EXIT
    END ;
    i := i + 1
  END ;
  IF digits = 0 THEN RAISE ValueRange END ;

  (* the exponent; past nine digits it is beyond every double either
     way, and stops growing *)
  ex := 0 ;
  eneg := FALSE ;
  IF i < n THEN
    IF s[i] = 'e' OR s[i] = 'E' THEN
      i := i + 1 ;
      IF i < n THEN
        IF s[i] = '-' OR s[i] = '+' THEN
          eneg := s[i] = '-' ;
          i := i + 1
        END
      END ;
      IF i >= n THEN RAISE ValueRange END ;
      WHILE i < n DO
        IF s[i] < '0' OR s[i] > '9' THEN RAISE ValueRange END ;
        IF ex < 100000000 THEN ex := ex * 10 + ORD (s[i]) - 48 END ;
        i := i + 1
      END
    END
  END ;
  IF i # n THEN RAISE ValueRange END ;

  IF NOT nonzero THEN RETURN Make (neg, 0, 0) END ;
  IF sticky THEN
    BigMul (dg, 10) ;
    BigPlus (dg, 1) ;
    kept := kept + 1 ;
    dexp := dexp - 1
  END ;
  IF eneg THEN e := dexp - ex ELSE e := dexp + ex END ;

  (* dg * 10^e lies in [10^(kept-1+e), 10^(kept+e)): at or past 10^309
     it is beyond the largest double, below 10^-324 it is under half
     the smallest subnormal *)
  IF kept - 1 + e >= 309 THEN RAISE ValueRange END ;
  IF kept + e <= -324 THEN RETURN Make (neg, 0, 0) END ;

  IF kept <= 15 AND e >= -22 AND e <= 22 THEN
    v := F64 (fast) ;
    IF e >= 0 THEN v := v * Pow10 (e) ELSE v := v / Pow10 (-e) END ;
    IF neg THEN v := -v END ;
    RETURN v
  END ;

  num := dg ;
  BigSmall (den, 1) ;
  IF e >= 0 THEN BigTen (num, e) ELSE BigTen (den, -e) END ;

  (* num / den lies in (2^b, 2^(b+2)), so its 53 bits start at b or
     b + 1: the quotient at b is below 2^54, and one step corrects it *)
  b := BitLen (num) - BitLen (den) - 1 ;
  LOOP
    q := b - 52 ;
    IF q < -1074 THEN q := -1074 END ;
    n2 := num ;
    d2 := den ;
    IF q >= 0 THEN BigShl (d2, q) ELSE BigShl (n2, -q) END ;
    m := Quot (n2, d2) ;
    IF m < Two53 THEN EXIT END ;
    b := b + 1
  END ;

  (* n2 is the remainder: past half of d2 rounds up, half to even *)
  BigMul (n2, 2) ;
  c := BigCmp (n2, d2) ;
  IF c > 0 OR (c = 0 AND m MOD 2 = 1) THEN m := m + 1 END ;
  IF m = Two53 THEN
    m := Two52 ;
    q := q + 1
  END ;
  IF m >= Two52 THEN
    be := q + 1075 ;
    fr := m - Two52
  ELSE
    be := 0 ;                                  (* subnormal *)
    fr := m
  END ;
  IF be >= 2047 THEN RAISE ValueRange END ;
  RETURN Make (neg, be, fr)
END ParseF64 ;

END Fmt.
