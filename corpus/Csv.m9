DEFINITION MODULE Csv ;

(* A reader for delimited text tables with a column header.

   WHAT IT IS FOR.  Numeric tables large enough that the reading is
   the cost: instrument timeseries, model output, station archives.
   It parses every column in ONE pass and hands out finished storage
   afterwards, because a column-at-a-time reader walks the whole file
   once per column and there are usually hundreds.

   WHAT THE CALLER SAYS, AND WHY THE CALLER RATHER THAN THE READER.
   Everything specific to a file is an Option or a per-column Kind:

     the delimiter, whether fields are quoted;
     whether there is a header, and how many preamble lines precede it;
     what each column IS (skipped, real, integer, timestamp, text);
     what a missing value looks like;
     which timezone a naked timestamp was written in.

   THERE IS NO TYPE INFERENCE, deliberately.  A reader that samples the
   first rows and decides types from them will read a column of
   sentinels as an integer and fail on the first real value further
   down -- not hypothetical: polars, given the file this was first
   written for, stops 125 KB in with "could not parse `-2.03` as dtype
   `i64`".  Sampling also cannot distinguish a station code from a
   number.  So the caller states the schema, and a schema is exactly
   the kind of thing that belongs in a file next to the data rather
   than in the program (demo/icos-roundtrip has one, derived from its
   data provider's published variable dictionary).

   MEASUREMENTS ARE F32.  That is what instruments produce and what
   NetCDF and Zarr archives of the same data store, so comparing them
   is a question about bits rather than tolerances.  Text is parsed to
   F32 DIRECTLY, never to F64 and then narrowed: two roundings can
   differ from one, and the way not to argue about when is not to do
   it.  A caller needing F64 measurements should say so and this grows
   a kind; nobody has yet.

   TIME IS Time.Instant, which is UTC by construction.  A timestamp
   written without a zone -- which is most of them, in this kind of
   data -- therefore cannot become an Instant until the caller says
   what zone it was written in.  That is the point, not an
   inconvenience: it is the difference between an hour of silent error
   and a line of configuration.

   WHAT IT IS NOT.  Not a general CSV library: no newlines inside
   quoted fields (with "" undoubled by TextAt), no ragged rows, no type
   inference, no streaming.  Each of those is a real feature for
   somebody and none is free, so they arrive when a caller needs
   one.                                                             *)

IMPORT Time ;

TYPE
  Table ;

  Kind = CASE RECORD
  | Skip                      (* not parsed; costs only the scan *)
  | Real                      (* F32 *)
  | Int                       (* I64 *)
  | Stamp : format : I64      (* Time.Instant; one of the Stamp* below *)
  | Text                      (* kept in place; see TextAt *)
  END ;

  Options = RECORD
    delimiter  : CHAR ;       (* ',' unless said otherwise *)
    quoted     : BOOL ;       (* honour "..." around a field *)
    header     : BOOL ;       (* a header row names the columns *)
    skipLines  : I64 ;        (* preamble lines before the header *)
    missing    : F32 ;        (* a real equal to this becomes NaN *)
    hasMissing : BOOL ;
    utcOffset  : F64 ;        (* seconds to subtract from a Stamp *)
  END ;

CONST
  (* timestamp layouts, named because a caller reading its options
     out of a configuration file has to be able to write one down *)
  StampYmdHm  = 0 ;           (* YYYYMMDDhhmm    *)
  StampYmdHms = 1 ;           (* YYYYMMDDhhmmss  *)
  StampIso    = 2 ;           (* RFC 3339, via Time.ParseIso *)
  StampEpoch  = 3 ;           (* seconds since 1970, as a number *)

EXCEPTION
  ParseError (RO what: STR ; line, col: I64) ;
  RangeError (row, col: I64) ;

PROCEDURE Defaults () : Options ;
  (* comma, unquoted, one header row, no preamble, no missing value,
     UTC.  Every one of those is a decision, so they are in one place
     where a reader can see all of them at once.                    *)

PROCEDURE Open (VAR pool: POOL ; RO path: STR ; RO opt: Options)
  : PTR Table IN pool
  RAISES ParseError, ValueRange, Io.IOError ;
  (* reads the file and the header and counts the rows; parses no
     values, because the caller declares the column kinds first     *)

PROCEDURE Rows (t: PTR Table) : I64 ;
PROCEDURE Cols (t: PTR Table) : I64 ;
PROCEDURE Name (VAR pool: POOL ; t: PTR Table ; c: I64) : STR
  RAISES IndexError, ValueRange ;
PROCEDURE Find (t: PTR Table ; RO name: STR) : I64 ;
  (* the column index, or -1.  Not an error: a caller choosing
     between conventions needs the question, not the diagnosis     *)

PROCEDURE SetKind (VAR t: PTR Table ; c: I64 ; k: Kind)
  RAISES IndexError ;
PROCEDURE SetReal (VAR t: PTR Table ; c: I64) RAISES IndexError ;
PROCEDURE SetInt (VAR t: PTR Table ; c: I64) RAISES IndexError ;
PROCEDURE SetText (VAR t: PTR Table ; c: I64) RAISES IndexError ;
PROCEDURE SetSkip (VAR t: PTR Table ; c: I64) RAISES IndexError ;
PROCEDURE SetStamp (VAR t: PTR Table ; c: I64 ; format: I64)
  RAISES IndexError ;
  (* the same thing as SetKind, said without naming the variant.  An
     M9 caller in another module cannot write `Csv.Kind.Real` today:
     the checker resolves a cross-module payload-less variant
     constructor and the GENERATOR refuses it -- "unknown name: Csv".
     Logged as a gap between the two rather than papered over; a C
     caller can still pass a Kind.                                  *)

CONST
  (* the kind CODES, for KindCodeAt: a caller in another module
     cannot CASE over Csv.Kind today (the generator cannot type a
     cross-module variant selector -- the same family as the
     constructor gap above), so the question is answered as an
     integer against these names *)
  KindSkip  = 0 ;
  KindReal  = 1 ;
  KindInt   = 2 ;
  KindStamp = 3 ;
  KindText  = 4 ;

PROCEDURE KindCodeAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError ;
PROCEDURE FormatAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError ;
  (* the kind the caller set (KindSkip until set) and, for a Stamp
     column, its format.  Added for Frame.m9, which walks a parsed
     table and must ask rather than guess. *)

PROCEDURE Parse (VAR pool: POOL ; VAR t: PTR Table)
  RAISES ParseError, RangeError, ValueRange, IndexError ;
  (* one pass over the whole file *)

PROCEDURE ColF32 (t: PTR Table ; c: I64) : SLICE OF F32
  RAISES IndexError ;
PROCEDURE ColI64 (t: PTR Table ; c: I64) : SLICE OF I64
  RAISES IndexError ;
PROCEDURE ColStamp (t: PTR Table ; c: I64) : SLICE OF Time.Instant
  RAISES IndexError ;
PROCEDURE TextAt (VAR pool: POOL ; t: PTR Table ; c, row: I64) : STR
  RAISES IndexError, ValueRange ;
  (* a text field, built on demand out of the file still in memory: a
     table of a hundred thousand rows does not want a hundred
     thousand strings nobody asked for                              *)

END Csv.


UNSAFE DEFINITION MODULE FOR "C" ccsv ;

PROCEDURE StrToF32 = "m9_strtof" (s: C.ConstPtr) : C.Double
  [REENTRANT] ;
  (* the runtime's one-line shim over strtof, not strtof itself:
     C.ConstPtr is `const void *` and stdlib.h has already declared
     strtof with `const char *`, so a direct binding collides.  The
     same collision m9_cstrlen answers, and the second instance of
     it -- a libc function the runtime header prototypes cannot be
     bound directly today.

     The answer is a C.Double because M9 has no C.Float.  It carries
     exactly the float strtof computed: widening is exact, and the
     conversion back to F32 in FieldF32 is the identity, so the
     reader still parses decimal text to F32 with ONE rounding.

     REENTRANT: strtof reads the C locale, which this never
     changes.                                                      *)

END ccsv.


UNSAFE IMPLEMENTATION MODULE Csv ;

(* UNSAFE for one reason: ADR, to hand strtof a pointer into the file
   buffer rather than a copy of every field.  Grep ADR.            *)

IMPORT DynStr ;
IMPORT Io ;
FROM ccsv IMPORT StrToF32 ;

(* Delimiters and quotes are compared as byte VALUES rather than named
   CHAR constants: a CONST of char type is "const form unsupported
   yet" in the generator, and this reads octets from a file rather
   than Unicode scalars anyway.  10 is a newline, 13 a return, 34 a
   quote, 45 a minus, 46 a point, 48..57 the digits. *)

TYPE
  (* NEW takes a type NAME, not a type expression, so a slice of
     slices needs the element type named -- the same reason Ast
     spells `Kid = OPT PTR Node` *)
  FCol = SLICE OF F32 ;
  ICol = SLICE OF I64 ;
  SCol = SLICE OF Time.Instant ;

  Table = RECORD
    buf     : SLICE OF BYTE ;     (* the whole file, plus a zero *)
    opt     : Options ;
    delim   : I64 ;               (* the delimiter, as an octet *)
    hdrEnd  : I64 ;               (* first byte of the first data row *)
    ncols, nrows : I64 ;
    nameOfs, nameLen : SLICE OF I64 ;   (* header names, in place *)
    kinds   : SLICE OF I64 ;      (* Kind as a code; see KindCode *)
    formats : SLICE OF I64 ;      (* the layout of a Stamp column *)
    fcols   : SLICE OF FCol ;
    icols   : SLICE OF ICol ;
    scols   : SLICE OF SCol ;
    tofs, tlen : SLICE OF ICol ;  (* a Text column, row by row *)
    parsed  : BOOL ;
  END ;

CONST
  KSkip = 0 ; KReal = 1 ; KInt = 2 ; KStamp = 3 ; KText = 4 ;

PROCEDURE Defaults () : Options =
VAR o : Options ;
BEGIN
  o.delimiter := ',' ;
  o.quoted := FALSE ;
  o.header := TRUE ;
  o.skipLines := 0 ;
  o.missing := 0.0 ;
  o.hasMissing := FALSE ;
  o.utcOffset := 0.0 ;
  RETURN o
END Defaults ;

PROCEDURE KindCode (k: Kind ; VAR format: I64) : I64 =
BEGIN
  format := 0 ;
  CASE k OF
  | Skip : RETURN KSkip
  | Real : RETURN KReal
  | Int : RETURN KInt
  | Stamp (f) :
      format := f ;
      RETURN KStamp
  | Text : RETURN KText
  END
END KindCode ;

PROCEDURE KindCodeAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError =
BEGIN
  (* KSkip..KText are declared equal to KindSkip..KindText; the
     driver holds the two spellings together *)
  RETURN t.kinds[c]
END KindCodeAt ;

PROCEDURE FormatAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError =
BEGIN
  RETURN t.formats[c]
END FormatAt ;

PROCEDURE IsDigit (b: BYTE) : BOOL =
BEGIN
  RETURN I64 (b) >= 48 AND I64 (b) <= 57
END IsDigit ;

(* the number of rows, counted before anything is allocated: one pass
   over the file to learn a number is cheaper than growing hundreds
   of columns by doubling *)
PROCEDURE CountRows (RO b: SLICE OF BYTE ; from: I64) : I64
  RAISES IndexError =
VAR
  i, n : I64 ;
BEGIN
  n := 0 ;
  FOR i := from TO LEN (b) - 1 DO
    IF I64 (b[i]) = 10 THEN n := n + 1 END
  END ;
  (* a file whose last line has no newline still has that line *)
  IF LEN (b) > from THEN
    IF I64 (b[LEN (b) - 1]) # 10 THEN n := n + 1 END
  END ;
  RETURN n
END CountRows ;

(* the byte after the end of preamble line number `skip` *)
PROCEDURE SkipLines (RO b: SLICE OF BYTE ; skip: I64) : I64
  RAISES IndexError =
VAR
  i, n : I64 ;
BEGIN
  i := 0 ;
  n := 0 ;
  WHILE n < skip DO
    IF i >= LEN (b) THEN RETURN i END ;
    IF I64 (b[i]) = 10 THEN n := n + 1 END ;
    i := i + 1
  END ;
  RETURN i
END SkipLines ;

(* a field with the quotes taken off, if it wore any *)
PROCEDURE Unquote (RO b: SLICE OF BYTE ; VAR ofs: I64 ; VAR len: I64)
  RAISES IndexError =
BEGIN
  IF len >= 2 THEN
    IF I64 (b[ofs]) = 34 AND I64 (b[ofs + len - 1]) = 34 THEN
      ofs := ofs + 1 ;
      len := len - 2
    END
  END
END Unquote ;

PROCEDURE Open (VAR pool: POOL ; RO path: STR ; RO opt: Options)
  : PTR Table IN pool
  RAISES ParseError, ValueRange, Io.IOError =
VAR
  t : PTR Table IN pool ;
  i, start, n, from : I64 ;
BEGIN
  t := NEW (pool, Table) ;
  t.buf := Io.ReadFileBytes (pool, path) ;
  t.opt := opt ;
  t.delim := ORD (opt.delimiter) ;
  t.parsed := FALSE ;

  from := SkipLines (t.buf, opt.skipLines) ;

  (* the columns are counted first, then recorded, so every per-column
     slice is allocated once at the right size *)
  n := 1 ;
  i := from ;
  WHILE i < LEN (t.buf) DO
    IF I64 (t.buf[i]) = 10 THEN EXIT END ;
    IF I64 (t.buf[i]) = t.delim THEN n := n + 1 END ;
    i := i + 1
  END ;
  IF i >= LEN (t.buf) THEN
    RAISE ParseError ('no first line', opt.skipLines + 1, 0)
  END ;
  t.ncols := n ;
  t.nameOfs := NEW (pool, I64, n) ;
  t.nameLen := NEW (pool, I64, n) ;
  t.kinds := NEW (pool, I64, n) ;
  t.formats := NEW (pool, I64, n) ;
  FOR i := 0 TO n - 1 DO t.kinds[i] := KReal END ;

  IF opt.header THEN
    n := 0 ;
    start := from ;
    i := from ;
    WHILE i < LEN (t.buf) DO
      IF I64 (t.buf[i]) = 10 OR I64 (t.buf[i]) = t.delim THEN
        t.nameOfs[n] := start ;
        t.nameLen[n] := i - start ;
        (* a CRLF file must not leave the return in the name *)
        IF t.nameLen[n] > 0 THEN
          IF I64 (t.buf[i - 1]) = 13 THEN
            t.nameLen[n] := t.nameLen[n] - 1
          END
        END ;
        IF opt.quoted THEN
          Unquote (t.buf, t.nameOfs[n], t.nameLen[n])
        END ;
        n := n + 1 ;
        start := i + 1 ;
        IF I64 (t.buf[i]) = 10 THEN EXIT END
      END ;
      i := i + 1
    END ;
    t.hdrEnd := i + 1
  ELSE
    (* no header: the columns have no names, and the data starts at
       the first line after the preamble *)
    FOR i := 0 TO t.ncols - 1 DO
      t.nameOfs[i] := from ;
      t.nameLen[i] := 0
    END ;
    t.hdrEnd := from
  END ;

  t.nrows := CountRows (t.buf, t.hdrEnd) ;
  t.fcols := NEW (pool, FCol, t.ncols) ;
  t.icols := NEW (pool, ICol, t.ncols) ;
  t.scols := NEW (pool, SCol, t.ncols) ;
  t.tofs := NEW (pool, ICol, t.ncols) ;
  t.tlen := NEW (pool, ICol, t.ncols) ;
  RETURN t
END Open ;

PROCEDURE Rows (t: PTR Table) : I64 =
BEGIN
  RETURN t.nrows
END Rows ;

PROCEDURE Cols (t: PTR Table) : I64 =
BEGIN
  RETURN t.ncols
END Cols ;

PROCEDURE Name (VAR pool: POOL ; t: PTR Table ; c: I64) : STR
  RAISES IndexError, ValueRange =
BEGIN
  RETURN DynStr.Chars (pool,
    SLICE (t.buf, t.nameOfs[c], t.nameLen[c]))
END Name ;

PROCEDURE Find (t: PTR Table ; RO name: STR) : I64 =
VAR
  c, i : I64 ;
  same : BOOL ;
BEGIN
  FOR c := 0 TO t.ncols - 1 DO
    IF t.nameLen[c] = LEN (name) THEN
      same := TRUE ;
      FOR i := 0 TO t.nameLen[c] - 1 DO
        IF I64 (t.buf[t.nameOfs[c] + i]) # ORD (name[i]) THEN
          same := FALSE
        END
      END ;
      IF same THEN RETURN c END
    END
  END ;
  RETURN -1
END Find ;

PROCEDURE SetKind (VAR t: PTR Table ; c: I64 ; k: Kind)
  RAISES IndexError =
VAR f : I64 ;
BEGIN
  t.kinds[c] := KindCode (k, f) ;
  t.formats[c] := f
END SetKind ;

PROCEDURE SetReal (VAR t: PTR Table ; c: I64) RAISES IndexError =
BEGIN
  t.kinds[c] := KReal
END SetReal ;

PROCEDURE SetInt (VAR t: PTR Table ; c: I64) RAISES IndexError =
BEGIN
  t.kinds[c] := KInt
END SetInt ;

PROCEDURE SetText (VAR t: PTR Table ; c: I64) RAISES IndexError =
BEGIN
  t.kinds[c] := KText
END SetText ;

PROCEDURE SetSkip (VAR t: PTR Table ; c: I64) RAISES IndexError =
BEGIN
  t.kinds[c] := KSkip
END SetSkip ;

PROCEDURE SetStamp (VAR t: PTR Table ; c: I64 ; format: I64)
  RAISES IndexError =
BEGIN
  t.kinds[c] := KStamp ;
  t.formats[c] := format
END SetStamp ;

(* 10^k, for k the number of digits after the point.  Exact in F32 up
   to k = 10: 10^10 is 2^10 * 5^10 and 5^10 = 9765625 fits in the
   24-bit significand.  10^11 does not, which is where the fast path
   below stops.  The chain is ordered by how often each k occurs in
   instrument data. *)
PROCEDURE Pow10F32 (k: I64) : F32 =
BEGIN
  IF k = 3 THEN RETURN 1000.0 END ;
  IF k = 2 THEN RETURN 100.0 END ;
  IF k = 1 THEN RETURN 10.0 END ;
  IF k = 0 THEN RETURN 1.0 END ;
  IF k = 4 THEN RETURN 10000.0 END ;
  IF k = 5 THEN RETURN 100000.0 END ;
  IF k = 6 THEN RETURN 1000000.0 END ;
  IF k = 7 THEN RETURN 10000000.0 END ;
  IF k = 8 THEN RETURN 100000000.0 END ;
  IF k = 9 THEN RETURN 1000000000.0 END ;
  RETURN 10000000000.0
END Pow10F32 ;

(* One field.

   THE FAST PATH IS NOT AN APPROXIMATION.  For [-]ddd[.ddd] with at
   most 7 significant digits and at most 10 after the point, the
   mantissa is below 2^24 and 10^k is exact, so both operands of the
   division are exactly representable in F32 and IEEE 754 rounds the
   quotient once, correctly.  That is the same value strtof answers,
   not a value near it -- and the driver proves it by comparing every
   parsed field against strtof rather than taking the argument on
   trust.  On the file this was written for, 98.8% of 34 million
   fields take this path.

   Everything else -- exponent notation, longer mantissas, anything
   with a character the loop does not recognise -- falls through to
   strtof on a pointer INTO the buffer.  No copy: the buffer carries a
   zero byte past its end and every field is followed by a delimiter
   or a newline, either of which stops strtof.                      *)
PROCEDURE FieldF32 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64) : F32
  RAISES IndexError =
VAR
  v : SLICE OF BYTE ;
  i, stop, c, mant, k, digs : I64 ;
  neg, dot, hard : BOOL ;
  r : F32 ;
BEGIN
  i := ofs ;
  stop := ofs + n ;
  neg := FALSE ;
  IF i < stop THEN
    IF I64 (b[i]) = 45 THEN
      neg := TRUE ;
      i := i + 1
    END
  END ;
  mant := 0 ;
  k := 0 ;
  digs := 0 ;
  dot := FALSE ;
  hard := FALSE ;
  WHILE i < stop DO
    c := I64 (b[i]) ;
    IF c >= 48 AND c <= 57 THEN
      (* eight digits is one too many for an exact F32 mantissa, and
         leaving the loop HERE also keeps mant from overflowing on a
         field that is all digits *)
      IF digs >= 7 THEN
        hard := TRUE ;
        EXIT
      END ;
      mant := mant * 10 + (c - 48) ;
      digs := digs + 1 ;
      IF dot THEN k := k + 1 END
    ELSE
      IF c = 46 AND NOT dot THEN
        dot := TRUE
      ELSE
        hard := TRUE ;
        EXIT
      END
    END ;
    i := i + 1
  END ;
  IF NOT hard THEN
    IF digs > 0 AND k <= 10 THEN
      r := F32 (mant) / Pow10F32 (k) ;
      IF neg THEN RETURN -r END ;
      RETURN r
    END
  END ;
  v := SLICE (b, ofs, n) ;
  RETURN F32 (StrToF32 (ADR (v)))
END FieldF32 ;

PROCEDURE FieldI64 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64 ;
                    row, col: I64) : I64
  RAISES RangeError, IndexError =
VAR
  i, v : I64 ;
  neg : BOOL ;
BEGIN
  v := 0 ;
  neg := FALSE ;
  i := ofs ;
  IF n > 0 THEN
    IF I64 (b[i]) = 45 THEN
      neg := TRUE ;
      i := i + 1
    END
  END ;
  WHILE i < ofs + n DO
    IF NOT IsDigit (b[i]) THEN RAISE RangeError (row, col) END ;
    (* checked multiply and add: a column of digits longer than an
       I64 raises Overflow here rather than wrapping into a
       plausible year *)
    v := v * 10 + (I64 (b[i]) - 48) ;
    i := i + 1
  END ;
  IF neg THEN RETURN -v END ;
  RETURN v
END FieldI64 ;

(* the packed digit layouts, YYYYMMDDhhmm and YYYYMMDDhhmmss *)
PROCEDURE CompactStamp (v: I64 ; withSeconds: BOOL) : Time.Instant
  RAISES ValueRange =
VAR c : Time.Civil ;
BEGIN
  c.second := 0.0 ;
  IF withSeconds THEN
    c.second := F64 (v MOD 100) ;
    v := v DIV 100
  END ;
  c.minute := v MOD 100 ;
  v := v DIV 100 ;
  c.hour := v MOD 100 ;
  v := v DIV 100 ;
  c.day := v MOD 100 ;
  v := v DIV 100 ;
  c.month := v MOD 100 ;
  c.year := v DIV 100 ;
  RETURN Time.FromCivil (c)
END CompactStamp ;

PROCEDURE FieldStamp (VAR pool: POOL ; RO b: SLICE OF BYTE ;
                      ofs: I64 ; n: I64 ; format: I64 ;
                      utcOffset: F64 ; row, col: I64) : Time.Instant
  RAISES RangeError, ValueRange, IndexError =
VAR
  t : Time.Instant ;
BEGIN
  IF format = StampIso THEN
    (* an ISO 8601 stamp carries its own zone, so the caller's offset
       does not apply to it and is not applied *)
    RETURN Time.ParseIso (DynStr.Chars (pool, SLICE (b, ofs, n)))
  END ;
  IF format = StampEpoch THEN
    t.t := F64 (FieldI64 (b, ofs, n, row, col)) ;
    RETURN t
  END ;
  IF format = StampYmdHms THEN
    IF n # 14 THEN RAISE RangeError (row, col) END ;
    RETURN Time.AddSeconds (
      CompactStamp (FieldI64 (b, ofs, n, row, col), TRUE), -utcOffset)
  END ;
  IF n # 12 THEN RAISE RangeError (row, col) END ;
  RETURN Time.AddSeconds (
    CompactStamp (FieldI64 (b, ofs, n, row, col), FALSE), -utcOffset)
END FieldStamp ;

PROCEDURE Parse (VAR pool: POOL ; VAR t: PTR Table)
  RAISES ParseError, RangeError, ValueRange, IndexError =
VAR
  i, c, row, start, len, nb, ofs : I64 ;
  f : F32 ;
  inQuote, atEnd : BOOL ;
BEGIN
  FOR c := 0 TO t.ncols - 1 DO
    IF t.kinds[c] = KReal THEN
      t.fcols[c] := NEW (pool, F32, t.nrows)
    ELSIF t.kinds[c] = KInt THEN
      t.icols[c] := NEW (pool, I64, t.nrows)
    ELSIF t.kinds[c] = KStamp THEN
      t.scols[c] := NEW (pool, Time.Instant, t.nrows)
    ELSIF t.kinds[c] = KText THEN
      t.tofs[c] := NEW (pool, I64, t.nrows) ;
      t.tlen[c] := NEW (pool, I64, t.nrows)
    END
  END ;

  nb := LEN (t.buf) ;
  i := t.hdrEnd ;
  row := 0 ;
  c := 0 ;
  start := i ;
  inQuote := FALSE ;
  WHILE i <= nb DO
    (* a field ends at a delimiter, a newline, or the end of the file:
       one test per byte and no lookahead.  Inside quotes the first
       two do not count, which is the whole cost of the option. *)
    IF t.opt.quoted AND i < nb THEN
      IF I64 (t.buf[i]) = 34 THEN inQuote := NOT inQuote END
    END ;
    atEnd := FALSE ;
    IF NOT inQuote THEN
      IF i = nb THEN
        atEnd := TRUE
      ELSIF I64 (t.buf[i]) = t.delim OR I64 (t.buf[i]) = 10 THEN
        atEnd := TRUE
      END
    END ;
    IF atEnd THEN
      len := i - start ;
      IF len > 0 THEN
        IF I64 (t.buf[start + len - 1]) = 13 THEN len := len - 1 END
      END ;
      ofs := start ;
      IF t.opt.quoted THEN Unquote (t.buf, ofs, len) END ;
      IF c < t.ncols THEN
        IF t.kinds[c] = KReal THEN
          IF len = 0 THEN
            t.fcols[c][row] := 0.0 / 0.0
          ELSE
            f := FieldF32 (t.buf, ofs, len) ;
            IF t.opt.hasMissing THEN
              IF f = t.opt.missing THEN f := 0.0 / 0.0 END
            END ;
            t.fcols[c][row] := f
          END
        ELSIF t.kinds[c] = KInt THEN
          IF len > 0 THEN
            t.icols[c][row] := FieldI64 (t.buf, ofs, len, row, c)
          END
        ELSIF t.kinds[c] = KStamp THEN
          IF len > 0 THEN
            t.scols[c][row] := FieldStamp (pool, t.buf, ofs, len,
              t.formats[c], t.opt.utcOffset, row, c)
          END
        ELSIF t.kinds[c] = KText THEN
          t.tofs[c][row] := ofs ;
          t.tlen[c][row] := len
        END
      END ;
      c := c + 1 ;
      start := i + 1 ;
      IF i = nb THEN
        EXIT
      END ;
      IF I64 (t.buf[i]) = 10 THEN
        IF c # t.ncols THEN
          RAISE ParseError ('wrong number of fields', row + 2, c)
        END ;
        row := row + 1 ;
        c := 0 ;
        IF row >= t.nrows THEN EXIT END
      END
    END ;
    i := i + 1
  END ;
  t.parsed := TRUE
END Parse ;

PROCEDURE ColF32 (t: PTR Table ; c: I64) : SLICE OF F32
  RAISES IndexError =
BEGIN
  RETURN t.fcols[c]
END ColF32 ;

PROCEDURE ColI64 (t: PTR Table ; c: I64) : SLICE OF I64
  RAISES IndexError =
BEGIN
  RETURN t.icols[c]
END ColI64 ;

PROCEDURE ColStamp (t: PTR Table ; c: I64) : SLICE OF Time.Instant
  RAISES IndexError =
BEGIN
  RETURN t.scols[c]
END ColStamp ;

PROCEDURE TextAt (VAR pool: POOL ; t: PTR Table ; c, row: I64) : STR
  RAISES IndexError, ValueRange =
VAR
  raw : SLICE OF BYTE ;
  keep : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  raw := SLICE (t.buf, t.tofs[c][row], t.tlen[c][row]) ;
  IF NOT t.opt.quoted THEN
    RETURN DynStr.Chars (pool, raw)
  END ;
  (* undouble "" inside a quoted field.  The header used to declare
     'no doubled "" escapes' as a narrowing; Frame.WriteCsv writes
     them (it must -- a note containing a quote has no other legal
     spelling), and its round-trip gate is what widened this. *)
  n := 0 ;
  i := 0 ;
  WHILE i < LEN (raw) DO
    n := n + 1 ;
    IF I64 (raw[i]) = 34 AND i + 1 < LEN (raw)
       AND I64 (raw[i + 1]) = 34 THEN
      i := i + 2
    ELSE
      i := i + 1
    END
  END ;
  IF n = LEN (raw) THEN
    RETURN DynStr.Chars (pool, raw)
  END ;
  keep := NEW (pool, BYTE, n) ;
  n := 0 ;
  i := 0 ;
  WHILE i < LEN (raw) DO
    keep[n] := raw[i] ;
    n := n + 1 ;
    IF I64 (raw[i]) = 34 AND i + 1 < LEN (raw)
       AND I64 (raw[i + 1]) = 34 THEN
      i := i + 2
    ELSE
      i := i + 1
    END
  END ;
  RETURN DynStr.Chars (pool, keep)
END TextAt ;

END Csv.
