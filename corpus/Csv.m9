(* SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0 *)
DEFINITION MODULE Csv ;

(* Csv reads delimited text tables with a column header.

   WHAT IT IS FOR.  It is for numeric tables large enough that the
   reading is the cost: instrument timeseries, model output, station
   archives.
   It parses every column in ONE pass and hands out finished storage
   afterwards, because a column-at-a-time reader walks the whole file
   once per column and there are usually hundreds.

   WHAT THE CALLER SAYS, AND WHY THE CALLER RATHER THAN THE READER.
   Everything specific to a file is an Option or a per-column Kind:

     the delimiter, whether fields are quoted;
     whether there is a header, and how many preamble lines precede it;
     what each column IS (skipped, real, integer, timestamp, text);
     what a missing value looks like;
     which timezone a naked timestamp was written in.

   THERE IS NO TYPE INFERENCE, deliberately.  A reader that samples the
   first rows and decides types from them will read a column of
   sentinels as an integer and fail on the first real value further
   down.  That is not hypothetical: polars, given the file this was
   first written for, stops 125 KB in with "could not parse `-2.03` as
   dtype `i64`".  Sampling also cannot distinguish a station code from a
   number.  So the caller states the schema, and a schema is exactly the
   kind of thing that belongs in a file next to the data rather than in
   the program (demo/icos-roundtrip has one, derived from its data
   provider's published variable dictionary).

   MEASUREMENTS ARE F32.  That is what instruments produce and what
   NetCDF and Zarr archives of the same data store, so comparing them
   is a question about bits rather than tolerances.  Text is parsed to
   F32 DIRECTLY, never to F64 and then narrowed: two roundings can
   differ from one, and the way not to argue about when is not to do
   it.  A caller needing F64 measurements should say so and this grows
   a kind; nobody has yet.

   TIME IS Time.Instant, which is UTC by construction.  A timestamp
   written without a zone (most of them, in this kind of data)
   therefore cannot become an Instant until the caller says what zone
   it was written in.  That is the point, not an
   inconvenience: it is the difference between an hour of silent error
   and a line of configuration.

   A FIELD THAT IS NOT A NUMBER IS MISSING, NOT ZERO.  A column the
   caller declared Real or Real64 is parsed only when the field looks
   like a number; anything else reads NaN, exactly as an empty field
   does.  strtod answers 0 for text, and a sentence stored as a
   measured 0.0 is the worst of the three possible answers.  The ICOS
   ocean store found this: 551 comment cells there did precisely
   that.  See IsNumber for what counts.

   WHAT IT IS NOT.  Csv is not a general CSV library: no ragged rows,
   no type inference, no streaming.  A quoted field MAY carry a
   newline and a doubled "" (TextAt undoubles it).  Both arrived when
   a caller needed them, the FLUXNET shuttle's BADM tables.  Each of
   the rest is a real feature for somebody and none is free, so they
   arrive the same way.                                             *)

IMPORT Time ;

TYPE
  Table ;

  Kind = CASE RECORD
  | Skip                      (* not parsed; costs only the scan *)
  | Real                      (* F32 *)
  | Real64                    (* F64 *)
  | Int                       (* I64 *)
  | Stamp : format : I64      (* Time.Instant; one of the Stamp* below *)
  | Text                      (* kept in place; see TextAt *)
  END ;

  Options = RECORD
    delimiter  : CHAR ;       (* ',' unless said otherwise *)
    quoted     : BOOL ;       (* honour "..." around a field *)
    header     : BOOL ;       (* a header row names the columns *)
    skipLines  : I64 ;        (* preamble lines before the header *)
    missing    : F32 ;        (* a real equal to this becomes NaN *)
    hasMissing : BOOL ;
    utcOffset  : F64 ;        (* seconds to subtract from a Stamp *)
    threads    : I64 ;        (* the threads Open and Parse may use; 1
                                 unless said otherwise.  See Parse. *)
  END ;

CONST
  (* These are the timestamp layouts, named because a caller reading
     its options out of a configuration file has to be able to write
     one down. *)
  StampYmdHm  = 0 ;           (* YYYYMMDDhhmm    *)
  StampYmdHms = 1 ;           (* YYYYMMDDhhmmss  *)
  StampIso    = 2 ;           (* RFC 3339, via Time.ParseIso *)
  StampEpoch  = 3 ;           (* seconds since 1970, as a number *)

EXCEPTION
  ParseError (RO what: STR ; line, col: I64) ;
  RangeError (row, col: I64) ;

PROCEDURE Defaults () : Options ;
  (* Defaults answers comma, unquoted, one header row, no preamble, no
     missing value, UTC, one thread.  Every one of those is a decision, so they are
     in one place where a reader can see all of them at once.       *)

PROCEDURE Open (VAR pool: POOL ; RO path: STR ; RO opt: Options)
  : PTR Table IN pool
  RAISES ParseError, ValueRange, Io.IOError ;
  (* Open reads the file and the header and counts the rows.  It
     parses no values, because the caller declares the column kinds
     first.  Every column is Skip until a setter names it: a column
     nobody declared is scanned past, never parsed and never carried. *)

PROCEDURE OpenBytes (VAR pool: POOL ; RO src: SLICE OF BYTE ;
                     RO opt: Options) : PTR Table IN pool
  RAISES ParseError, ValueRange ;
  (* OpenBytes does the same over bytes the caller already holds: a
     ZIP member inflated into memory, a body off the wire.  The octets
     are COPIED into the table (plus the trailing zero Open's file read
     carries), so the caller's buffer is free the moment this returns
     and the table never reaches into a pool it does not own.        *)

PROCEDURE Rows (t: PTR Table) : I64 ;
PROCEDURE Cols (t: PTR Table) : I64 ;
PROCEDURE Name (VAR pool: POOL ; t: PTR Table ; c: I64) : STR
  RAISES IndexError, ValueRange ;
PROCEDURE Find (t: PTR Table ; RO name: STR) : I64 ;
  (* Find answers the column index, or -1.  That is not an error: a
     caller choosing between conventions needs the question, not the
     diagnosis.                                                    *)

PROCEDURE SetKind (VAR t: PTR Table ; c: I64 ; k: Kind)
  RAISES IndexError ;
  (* MEASUREMENTS ARE F32 by default, and the module header says why.
     Kind.Real64 is the exception that header names: "a caller needing
     F64 measurements should say so and this grows a kind".  The
     caller that needed it is the ICOS ocean store, whose every
     measurement array is `<f8>`.  A narrowing here and a widening
     again to write would be two roundings where the file has one
     number.  (SetReal, SetReal64, SetInt, SetText, SetSkip and
     SetStamp said the same as SetKind without naming the variant;
     deprecated in 0.27.0, removed in 0.28.0.) *)

PROCEDURE KindAt (t: PTR Table ; c: I64) : Kind
  RAISES IndexError ;
PROCEDURE IsSet (t: PTR Table ; c: I64) : BOOL
  RAISES IndexError ;
  (* IsSet asks whether column c has had its kind named: FALSE while
     it is still Skip.  It gives the count of parsed columns without
     spelling out every kind at the call site. *)
PROCEDURE FormatAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError ;
  (* KindAt answers the kind the caller set (Skip until set), and
     FormatAt, for a Stamp column, its format.  A caller in another
     module CASEs the Kind directly now (the cross-module variant
     selector the enumeration work gave the generator); the integer
     codes it used to answer against are gone. *)

PROCEDURE Parse (VAR pool: POOL ; VAR t: PTR Table)
  RAISES ParseError, RangeError, ValueRange, IndexError ;
  (* Parse makes one pass over the whole file.

     With opt.threads above 1 the file is cut into that many bands at
     row ends, and each band is parsed by a thread of its own
     (docs/csv-threads-plan.md).  The columns are the same, bit for
     bit, as one thread gives, and so is the exception: the one of the
     first bad row, with its line.  A band is never cut inside a
     quoted field.

     After Parse raises, the table's columns are not to be read.  One
     thread has stored the rows before the bad one; several have
     stored other rows too. *)

PROCEDURE ColF32 (t: PTR Table ; c: I64) : SLICE OF F32
  RAISES IndexError ;
PROCEDURE ColF64 (t: PTR Table ; c: I64) : SLICE OF F64
  RAISES IndexError ;
PROCEDURE ColI64 (t: PTR Table ; c: I64) : SLICE OF I64
  RAISES IndexError ;
PROCEDURE ColStamp (t: PTR Table ; c: I64) : SLICE OF Time.Instant
  RAISES IndexError ;
PROCEDURE TextAt (VAR pool: POOL ; t: PTR Table ; c, row: I64) : STR
  RAISES IndexError, ValueRange ;
  (* TextAt answers a text field, built on demand out of the file
     still in memory: a table of a hundred thousand rows does not want
     a hundred thousand strings nobody asked for.                   *)

(* ---- the UTF twins (docs/utf8-plan.md, stage 2; the author: twins in Csv,
   not a second module, since the file is held as octets already).
   Name and TextAt widen one octet to one CHAR, so a header or a field
   past ASCII comes back as its UTF-8 octets read as Latin-1.  These
   answer the text itself, its octets validated into pool (ValueRange
   when the file holds a field that is not UTF-8).  Csv.Find (t, u)
   with a UTF is FindUtf. ---- *)

PROCEDURE NameUtf (VAR pool: POOL ; t: PTR Table ; c: I64) : UTF
  RAISES IndexError, ValueRange ;
PROCEDURE TextAtUtf (VAR pool: POOL ; t: PTR Table ; c, row: I64) : UTF
  RAISES IndexError, ValueRange ;
PROCEDURE FindUtf (t: PTR Table ; RO name: UTF) : I64 ;

END Csv.


UNSAFE DEFINITION MODULE FOR "C" ccsv ;

PROCEDURE StrToF64 = "m9_strtod" (s: C.ConstPtr) : C.Double
  [REENTRANT] ;
PROCEDURE StrToF32 = "m9_strtof" (s: C.ConstPtr) : C.Double
  [REENTRANT] ;
PROCEDURE CNumber = "m9_csv_number" (p: C.ConstPtr ; n: C.SSizeT) : C.Int
  [REENTRANT] ;
PROCEDURE CFieldF64 = "m9_field_f64" (p: C.ConstPtr ; n: C.SSizeT ; out: C.MutPtr) : C.Int
  [REENTRANT] ;
  (* CNumber runs IsNumber's grammar in one pass in the runtime
     (m9rt.h, 2026-10-25), and CFieldF64 runs it with the value: 1 a
     number, 0 not one, -1 under M9_CSV_PORTABLE.  Then IsNumber and
     FieldF64 below decide, the portable twin.  IsNumber and Word were
     31% of a CSV read. *)
  (* StrToF32 binds the runtime's one-line shim over strtof, not
     strtof itself.  C.ConstPtr is `const void *` and stdlib.h has
     already declared strtof with `const char *`, so a direct binding
     collides.  m9_cstrlen answers the same collision, and this is the
     second instance of it: a libc function the runtime header
     prototypes cannot be bound directly today.

     The answer is a C.Double because M9 has no C.Float.  It carries
     exactly the float strtof computed: widening is exact, and the
     conversion back to F32 in FieldF32 is the identity, so the
     reader still parses decimal text to F32 with ONE rounding.

     REENTRANT: strtof reads the C locale, which this never
     changes.                                                      *)

END ccsv.


UNSAFE IMPLEMENTATION MODULE Csv ;

IMPORT Text ;

(* Csv is UNSAFE for one reason: ADR, to hand strtof a pointer into
   the file buffer rather than a copy of every field.  Grep ADR.   *)

IMPORT DynStr ;
IMPORT Io ;
IMPORT Tsk ;
IMPORT Faults ;
FROM ccsv IMPORT StrToF32, StrToF64, CNumber, CFieldF64 ;

(* Held is a double the runtime fills through ADR (h). *)
TYPE Held = RECORD v : F64 END ;

(* Delimiters and quotes are compared as byte VALUES rather than named
   CHAR constants because this reads octets from a file, not Unicode
   scalars (a CHAR CONST itself compiles since 0.20.0; it did not when
   this was written).  10 is a newline, 13 a return, 34 a quote, 45 a
   minus, 46 a point, 48..57 the digits. *)

TYPE
  (* NEW takes a type NAME, not a type expression, so a slice of
     slices needs the element type named -- the same reason Ast
     spells `Kid = OPT PTR Node` *)
  FCol = SLICE OF F32 ;
  DCol = SLICE OF F64 ;
  ICol = SLICE OF I64 ;
  SCol = SLICE OF Time.Instant ;

  Table = RECORD
    buf     : SLICE OF BYTE ;     (* the whole file, plus a zero *)
    opt     : Options ;
    delim   : I64 ;               (* the delimiter, as an octet *)
    hdrEnd  : I64 ;               (* first byte of the first data row *)
    ncols, nrows : I64 ;
    nameOfs, nameLen : SLICE OF I64 ;   (* header names, in place *)
    kinds   : SLICE OF Kind ;     (* the column's Kind, directly *)
    formats : SLICE OF I64 ;      (* the layout of a Stamp column *)
    fcols   : SLICE OF FCol ;
    dcols   : SLICE OF DCol ;
    icols   : SLICE OF ICol ;
    scols   : SLICE OF SCol ;
    tofs, tlen : SLICE OF ICol ;  (* a Text column, row by row *)
    parsed  : BOOL ;
    (* THE BANDS (docs/csv-threads-plan.md).  The data is cut into
       nbands runs of equal bytes.  A band owns the rows that start
       right after a row end inside it; band 0 owns row 0 as well.
       Each worker writes its own band's entries below and its own
       rows of the columns, and nothing else: that is the claim
       [SHARABLE] makes. *)
    nbands  : I64 ;
    nworkers : I64 ;              (* opt.threads, at most the bands *)
    bq      : SLICE OF I64 ;      (* quote characters in the band *)
    be0, be1 : SLICE OF I64 ;     (* row ends, the band entered
                                     outside quotes / inside *)
    bf0, bf1 : SLICE OF I64 ;     (* the byte after the first of them,
                                     or -1 *)
    bFrom   : SLICE OF I64 ;      (* where the band's first row starts *)
    bRow, bRowEnd : SLICE OF I64 ;  (* its rows: bRow .. bRowEnd - 1 *)
    bErr    : SLICE OF I64 ;      (* what its parse raised, an Err* *)
    bErrA, bErrB : SLICE OF I64 ; (* the exception's two numbers *)
  END [SHARABLE] ;

  (* Gate deals the bands out, one at a time, to whichever worker is
     free.  There are more bands than workers: the cores of a machine
     are not all as fast, and with one band a worker the pass took as
     long as the slowest core's band (measured 2026-11-15: 0.14 s on
     6 fast and 12 slow cores, however many threads above 8). *)
  Gate = MONITOR RECORD
    next : I64 ;
  END ;

  (* Job is what a pass hands its workers: the crew, the table and
     which pass it is.  A pass makes a Job of its own, since a crew
     runs once. *)
  Job = RECORD
    crew : Tsk.Crew ;
    t    : PTR Table ;
    pass : I64 ;                  (* an Op* *)
    gate : Gate ;                 (* deals the bands out *)
  END [SHARABLE] ;

CONST

PROCEDURE Defaults () : Options =
VAR o : Options ;
BEGIN
  o.delimiter := ',' ;
  o.quoted := FALSE ;
  o.header := TRUE ;
  o.skipLines := 0 ;
  o.missing := 0.0 ;
  o.hasMissing := FALSE ;
  o.utcOffset := 0.0 ;
  o.threads := 1 ;
  RETURN o
END Defaults ;

PROCEDURE KindAt (t: PTR Table ; c: I64) : Kind
  RAISES IndexError =
BEGIN
  RETURN t.kinds[c]
END KindAt ;

PROCEDURE IsSet (t: PTR Table ; c: I64) : BOOL
  RAISES IndexError =
BEGIN
  CASE t.kinds[c] OF
  | Skip : RETURN FALSE
  | Real : RETURN TRUE
  | Real64 : RETURN TRUE
  | Int : RETURN TRUE
  | Stamp : RETURN TRUE
  | Text : RETURN TRUE
  END
END IsSet ;

PROCEDURE FormatAt (t: PTR Table ; c: I64) : I64
  RAISES IndexError =
BEGIN
  RETURN t.formats[c]
END FormatAt ;

PROCEDURE IsDigit (b: BYTE) : BOOL =
BEGIN
  RETURN I64 (b) >= 48 AND I64 (b) <= 57
END IsDigit ;

(* CountRows counts the rows before anything is allocated.  One pass
   over the file costs less than growing hundreds of columns by
   doubling.

   The loop splits on quoted.  An unquoted file runs the plain loop: one
   test per byte and nothing else.  The quote test inside the one loop
   cost the FLUXNET count 0.17 -> 0.29 s on host1 (beb6732f, measured
   2026-10-31).  The split took it back to 0.17 s. *)
PROCEDURE CountRows (RO b: SLICE OF BYTE ; from: I64 ; quoted: BOOL)
  : I64
  RAISES IndexError =
VAR
  i, n : I64 ;
  inQuote : BOOL ;
BEGIN
  n := 0 ;
  inQuote := FALSE ;
  IF NOT quoted THEN
    FOR i := from TO LEN (b) - 1 DO
      IF I64 (b[i]) = 10 THEN n := n + 1 END
    END
  ELSE
    FOR i := from TO LEN (b) - 1 DO
      (* A newline INSIDE a quoted field belongs to the field, as in
         Parse.  CountRows once counted it as a row.  The count then
         exceeded what Parse fills, and the tail rows read as empty
         text, silently.  78 of the 783 FLUXNET shuttle BADM tables
         carry a multi-line site description. *)
      IF I64 (b[i]) = 34 THEN inQuote := NOT inQuote END ;
      IF I64 (b[i]) = 10 AND NOT inQuote THEN n := n + 1 END
    END
  END ;
  (* The last line counts even without its newline. *)
  IF LEN (b) > from THEN
    IF I64 (b[LEN (b) - 1]) # 10 THEN n := n + 1 END
  END ;
  RETURN n
END CountRows ;

(* SkipLines answers the byte after the end of preamble line number
   `skip`. *)
PROCEDURE SkipLines (RO b: SLICE OF BYTE ; skip: I64) : I64
  RAISES IndexError =
VAR
  i, n : I64 ;
BEGIN
  i := 0 ;
  n := 0 ;
  WHILE n < skip DO
    IF i >= LEN (b) THEN RETURN i END ;
    IF I64 (b[i]) = 10 THEN n := n + 1 END ;
    i := i + 1
  END ;
  RETURN i
END SkipLines ;

(* Unquote answers a field with the quotes taken off, if it wore
   any. *)
PROCEDURE Unquote (RO b: SLICE OF BYTE ; VAR ofs: I64 ; VAR len: I64)
  RAISES IndexError =
BEGIN
  IF len >= 2 THEN
    IF I64 (b[ofs]) = 34 AND I64 (b[ofs + len - 1]) = 34 THEN
      ofs := ofs + 1 ;
      len := len - 2
    END
  END
END Unquote ;

(* ---- THE BANDS (docs/csv-threads-plan.md) ---- *)

CONST
  BandsPerWorker = 8 ;
  OpCount = 0 ;               (* a round's op: count the row ends *)
  OpFill = 1 ;                (* parse the band's rows *)
  ErrNone = 0 ;
  ErrFields = 1 ;             (* ParseError, wrong number of fields *)
  ErrRange = 2 ;              (* RangeError (row, col) *)
  ErrValue = 3 ;              (* ValueRange *)
  ErrIndex = 4 ;              (* IndexError (index, extent) *)

(* BandBytes answers band k's bytes, lo .. hi - 1, of the data after
   the header. *)
PROCEDURE BandBytes (VAR t: PTR Table ; k: I64 ; VAR lo, hi: I64) =
BEGIN
  Tsk.Chunk (k, LEN (t.buf) - t.hdrEnd, t.nbands, lo, hi) ;
  lo := lo + t.hdrEnd ;
  hi := hi + t.hdrEnd
END BandBytes ;

(* CountBand counts band k's row ends.  A band cannot know whether it
   starts inside a quoted field, so it counts for both answers.  The
   serial reader's rule is one toggle a quote character, so `q' below
   is the state of a band entered outside quotes, and its opposite
   the state of one entered inside. *)
PROCEDURE CountBand (VAR t: PTR Table ; k: I64) RAISES IndexError =
VAR
  i, lo, hi, n, e0, e1, f0, f1 : I64 ;
  q : BOOL ;
BEGIN
  BandBytes (t, k, lo, hi) ;
  n := 0 ; e0 := 0 ; e1 := 0 ; f0 := -1 ; f1 := -1 ;
  q := FALSE ;
  IF NOT t.opt.quoted THEN
    FOR i := lo TO hi - 1 DO
      IF I64 (t.buf[i]) = 10 THEN
        e0 := e0 + 1 ;
        IF f0 < 0 THEN f0 := i + 1 END
      END
    END
  ELSE
    FOR i := lo TO hi - 1 DO
      IF I64 (t.buf[i]) = 34 THEN
        q := NOT q ;
        n := n + 1
      ELSIF I64 (t.buf[i]) = 10 THEN
        IF q THEN
          e1 := e1 + 1 ;
          IF f1 < 0 THEN f1 := i + 1 END
        ELSE
          e0 := e0 + 1 ;
          IF f0 < 0 THEN f0 := i + 1 END
        END
      END
    END
  END ;
  t.bq[k] := n ;
  t.be0[k] := e0 ; t.be1[k] := e1 ;
  t.bf0[k] := f0 ; t.bf1[k] := f1
END CountBand ;

PROCEDURE ParseBand (VAR t: PTR Table ; band: I64)
  RAISES ParseError, RangeError, ValueRange, IndexError ;

(* FillBand parses band k and keeps what it raised in the band's own
   entries.  It answers FALSE when it raised.  Tsk carries no
   exception out of a worker, so Parse raises it again from there. *)
PROCEDURE FillBand (VAR t: PTR Table ; k: I64) : BOOL =
BEGIN
  BEGIN
    ParseBand (t, k) ;
    RETURN TRUE
  EXCEPT
  | ParseError (what, line, col) :
      t.bErr[k] := ErrFields ; t.bErrA[k] := line ; t.bErrB[k] := col
  | RangeError (row, col) :
      t.bErr[k] := ErrRange ; t.bErrA[k] := row ; t.bErrB[k] := col
  | ValueRange :
      t.bErr[k] := ErrValue
  | IndexError (ix, n) :
      t.bErr[k] := ErrIndex ; t.bErrA[k] := ix ; t.bErrB[k] := n
  END ;
  RETURN FALSE
END FillBand ;

(* Take answers the next band, or -1 when all are dealt. *)
PROCEDURE Take (VAR g: Gate ; n: I64) : I64 =
BEGIN
  IF g.next >= n THEN RETURN -1 END ;
  g.next := g.next + 1 ;
  RETURN g.next - 1
END Take ;

PROCEDURE Reset (VAR g: Gate) =
BEGIN
  g.next := 0
END Reset ;

(* Worker takes bands from the gate until none is left.  Tsk's own
   chunk is not used: the round is only the start and the barrier. *)
PROCEDURE Worker (VAR j: Job) =
VAR
  s : Tsk.Seat ;
  k : I64 ;
BEGIN
  s := Tsk.Join (j.crew) ;
  WHILE Tsk.Next (j.crew, s) DO
    LOOP
      k := Take (j.gate, j.t.nbands) ;
      IF k < 0 THEN EXIT END ;
      IF j.pass = OpCount THEN
        BEGIN
          CountBand (j.t, k)
        EXCEPT
        | IndexError : s.failed := TRUE
        END
      ELSE
        IF NOT FillBand (j.t, k) THEN s.failed := TRUE END
      END
    END
  END
END Worker ;

(* RunBands runs one pass over every band, a thread a band, and
   answers FALSE when a band failed.  Where no thread can start, the
   bands run here, one after another. *)
PROCEDURE RunBands (VAR pool: POOL ; VAR t: PTR Table ; pass: I64) : BOOL =
VAR
  j : PTR Job IN pool ;
  k, started : I64 ;
  ok : BOOL ;
BEGIN
  j := NEW (pool, Job) ;
  j.t := t ;
  j.pass := pass ;
  Reset (j.gate) ;
  started := 0 ;
  FOR k := 1 TO t.nworkers DO
    BEGIN
      THREAD (Worker, j) ;
      started := started + 1
    EXCEPT
    | OutOfMemory :
    END
  END ;
  ok := TRUE ;
  IF started = 0 THEN
    FOR k := 0 TO t.nbands - 1 DO
      IF pass = OpCount THEN
        BEGIN
          CountBand (t, k)
        EXCEPT
        | IndexError : ok := FALSE
        END
      ELSIF NOT FillBand (t, k) THEN
        ok := FALSE
      END
    END ;
    RETURN ok
  END ;
  BEGIN
    Tsk.Start (j.crew, started) ;
    Tsk.For (j.crew, started, pass)
  EXCEPT
  | Tsk.Failed : ok := FALSE
  | Faults.BadArg : ok := FALSE
  END ;
  Tsk.Stop (j.crew) ;
  RETURN ok
END RunBands ;

(* Bands cuts the data into bands and gives each its rows.  With one
   band it is the serial count.  With more, every band counts its row
   ends for both quote states (CountBand), on a crew.  Then, band by
   band in order, the parity of the quotes before a band says which
   of its two counts is the real one.  That is the serial reader's
   rule applied in order, so a band starts where that reader starts a
   row, whatever the quoting. *)
PROCEDURE Bands (VAR pool: POOL ; VAR t: PTR Table)
  RAISES ValueRange, IndexError =
VAR
  k, n, size, sum, run, e, f : I64 ;
  inside : BOOL ;
BEGIN
  size := LEN (t.buf) - t.hdrEnd ;
  n := t.opt.threads ;
  IF n > size THEN n := size END ;
  IF n < 1 THEN n := 1 END ;
  t.nworkers := n ;
  (* several bands a worker, so a slow core holds no one up *)
  IF n > 1 THEN
    n := n * BandsPerWorker ;
    IF n > size THEN n := size END
  END ;
  t.nbands := n ;
  t.bq := NEW (pool, I64, n) ;
  t.be0 := NEW (pool, I64, n) ;
  t.be1 := NEW (pool, I64, n) ;
  t.bf0 := NEW (pool, I64, n) ;
  t.bf1 := NEW (pool, I64, n) ;
  t.bFrom := NEW (pool, I64, n) ;
  t.bRow := NEW (pool, I64, n) ;
  t.bRowEnd := NEW (pool, I64, n) ;
  t.bErr := NEW (pool, I64, n) ;
  t.bErrA := NEW (pool, I64, n) ;
  t.bErrB := NEW (pool, I64, n) ;
  IF n = 1 THEN
    t.nrows := CountRows (t.buf, t.hdrEnd, t.opt.quoted) ;
    t.bFrom[0] := t.hdrEnd ;
    t.bRow[0] := 0 ;
    t.bRowEnd[0] := t.nrows ;
    RETURN
  END ;
  IF NOT RunBands (pool, t, OpCount) THEN RAISE ValueRange END ;
  (* each band's real count and first row end, kept in be0 and bf0 *)
  sum := 0 ;
  inside := FALSE ;
  FOR k := 0 TO n - 1 DO
    IF inside THEN
      t.be0[k] := t.be1[k] ;
      t.bf0[k] := t.bf1[k]
    END ;
    IF t.bq[k] MOD 2 = 1 THEN inside := NOT inside END ;
    sum := sum + t.be0[k]
  END ;
  (* the last line counts even without its line feed, as in CountRows *)
  t.nrows := sum ;
  IF size > 0 THEN
    IF I64 (t.buf[LEN (t.buf) - 1]) # 10 THEN t.nrows := sum + 1 END
  END ;
  (* row j starts after row end j: band k owns the rows after its own
     row ends, and band 0 row 0 too *)
  run := 0 ;
  FOR k := 0 TO n - 1 DO
    e := t.be0[k] ;
    f := t.bf0[k] ;
    IF k = 0 THEN
      t.bRow[k] := 0 ;
      t.bFrom[k] := t.hdrEnd
    ELSE
      t.bRow[k] := 1 + run ;
      t.bFrom[k] := f
    END ;
    IF t.bRow[k] > t.nrows THEN t.bRow[k] := t.nrows END ;
    run := run + e ;
    t.bRowEnd[k] := 1 + run ;
    IF t.bRowEnd[k] > t.nrows THEN t.bRowEnd[k] := t.nrows END
  END
END Bands ;

PROCEDURE Open (VAR pool: POOL ; RO path: STR ; RO opt: Options)
  : PTR Table IN pool
  RAISES ParseError, ValueRange, Io.IOError =
BEGIN
  RETURN Build (pool, Io.ReadFileBytes (pool, path), opt)
END Open ;

PROCEDURE OpenBytes (VAR pool: POOL ; RO src: SLICE OF BYTE ;
                     RO opt: Options) : PTR Table IN pool
  RAISES ParseError, ValueRange =
VAR
  buf : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  (* The bytes are copied, with one zero past the end: a C string
     function called on a field inside it must not run off the buffer,
     which is the contract Io.ReadFileBytes gives Open. *)
  buf := NEW (pool, BYTE, LEN (src) + 1) ;
  FOR i := 0 TO LEN (src) - 1 DO buf[i] := src[i] END ;
  (* the zero is PAST the slice, exactly as ReadFileBytes places it.
     Inside it, the row counter would see one byte more than the file
     and answer one row too many, which the driver caught. *)
  RETURN Build (pool, SLICE (buf, 0, LEN (src)), opt)
END OpenBytes ;

(* Build reads the header and the row count over a buffer the table
   will keep. *)
PROCEDURE Build (VAR pool: POOL ; RO buf: SLICE OF BYTE ;
                 RO opt: Options) : PTR Table IN pool
  RAISES ParseError, ValueRange =
VAR
  t : PTR Table IN pool ;
  i, start, n, from : I64 ;
BEGIN
  t := NEW (pool, Table) ;
  t.buf := buf ;
  t.opt := opt ;
  t.delim := ORD (opt.delimiter) ;
  t.parsed := FALSE ;

  from := SkipLines (t.buf, opt.skipLines) ;

  (* the columns are counted first, then recorded, so every per-column
     slice is allocated once at the right size *)
  n := 1 ;
  i := from ;
  WHILE i < LEN (t.buf) DO
    IF I64 (t.buf[i]) = 10 THEN EXIT END ;
    IF I64 (t.buf[i]) = t.delim THEN n := n + 1 END ;
    i := i + 1
  END ;
  IF i >= LEN (t.buf) THEN
    RAISE ParseError ('no first line', opt.skipLines + 1, 0)
  END ;
  t.ncols := n ;
  t.nameOfs := NEW (pool, I64, n) ;
  t.nameLen := NEW (pool, I64, n) ;
  t.kinds := NEW (pool, Kind, n) ;
  t.formats := NEW (pool, I64, n) ;
  (* every column is Skip until a setter names its kind, as the
     definition promises.  It was Real here until 2026-09-06, and a
     caller that declared two of 244 columns got all 244 parsed. *)
  FOR i := 0 TO n - 1 DO t.kinds[i] := Kind.Skip END ;

  IF opt.header THEN
    n := 0 ;
    start := from ;
    i := from ;
    WHILE i < LEN (t.buf) DO
      IF I64 (t.buf[i]) = 10 OR I64 (t.buf[i]) = t.delim THEN
        t.nameOfs[n] := start ;
        t.nameLen[n] := i - start ;
        (* a CRLF file must not leave the return in the name *)
        IF t.nameLen[n] > 0 THEN
          IF I64 (t.buf[i - 1]) = 13 THEN
            t.nameLen[n] := t.nameLen[n] - 1
          END
        END ;
        IF opt.quoted THEN
          Unquote (t.buf, t.nameOfs[n], t.nameLen[n])
        END ;
        n := n + 1 ;
        start := i + 1 ;
        IF I64 (t.buf[i]) = 10 THEN EXIT END
      END ;
      i := i + 1
    END ;
    t.hdrEnd := i + 1
  ELSE
    (* no header: the columns have no names, and the data starts at
       the first line after the preamble *)
    FOR i := 0 TO t.ncols - 1 DO
      t.nameOfs[i] := from ;
      t.nameLen[i] := 0
    END ;
    t.hdrEnd := from
  END ;

  Bands (pool, t) ;
  t.fcols := NEW (pool, FCol, t.ncols) ;
  t.dcols := NEW (pool, DCol, t.ncols) ;
  t.icols := NEW (pool, ICol, t.ncols) ;
  t.scols := NEW (pool, SCol, t.ncols) ;
  t.tofs := NEW (pool, ICol, t.ncols) ;
  t.tlen := NEW (pool, ICol, t.ncols) ;
  RETURN t
END Build ;

PROCEDURE Rows (t: PTR Table) : I64 =
BEGIN
  RETURN t.nrows
END Rows ;

PROCEDURE Cols (t: PTR Table) : I64 =
BEGIN
  RETURN t.ncols
END Cols ;

PROCEDURE Name (VAR pool: POOL ; t: PTR Table ; c: I64) : STR
  RAISES IndexError, ValueRange =
BEGIN
  RETURN DynStr.Chars (pool,
    SLICE (t.buf, t.nameOfs[c], t.nameLen[c]))
END Name ;

PROCEDURE Find (t: PTR Table ; RO name: STR) : I64 =
VAR
  c, i : I64 ;
  same : BOOL ;
BEGIN
  FOR c := 0 TO t.ncols - 1 DO
    IF t.nameLen[c] = LEN (name) THEN
      same := TRUE ;
      FOR i := 0 TO t.nameLen[c] - 1 DO
        IF I64 (t.buf[t.nameOfs[c] + i]) # ORD (name[i]) THEN
          same := FALSE
        END
      END ;
      IF same THEN RETURN c END
    END
  END ;
  RETURN -1
END Find ;

PROCEDURE SetKind (VAR t: PTR Table ; c: I64 ; k: Kind)
  RAISES IndexError =
BEGIN
  t.kinds[c] := k ;
  CASE k OF
  | Stamp (fmt) : t.formats[c] := fmt
  | Skip :
  | Real :
  | Real64 :
  | Int :
  | Text :
  END
END SetKind ;

(* Pow10F32 answers 10^k, for k the number of digits after the point.
   It is exact in F32 up to k = 10: 10^10 is 2^10 * 5^10, and
   5^10 = 9765625 fits in the 24-bit significand.  10^11 does not,
   which is where the fast path below stops.  The chain is ordered by
   how often each k occurs in instrument data. *)
PROCEDURE Pow10F32 (k: I64) : F32 =
BEGIN
  IF k = 3 THEN RETURN 1000.0 END ;
  IF k = 2 THEN RETURN 100.0 END ;
  IF k = 1 THEN RETURN 10.0 END ;
  IF k = 0 THEN RETURN 1.0 END ;
  IF k = 4 THEN RETURN 10000.0 END ;
  IF k = 5 THEN RETURN 100000.0 END ;
  IF k = 6 THEN RETURN 1000000.0 END ;
  IF k = 7 THEN RETURN 10000000.0 END ;
  IF k = 8 THEN RETURN 100000000.0 END ;
  IF k = 9 THEN RETURN 1000000000.0 END ;
  RETURN 10000000000.0
END Pow10F32 ;

(* FastF32 is FieldF32's exact path, on its own.  It answers TRUE and
   sets r for a field [-]ddd[.ddd] with 1 to 7 digits and at most 10
   of them after the point.  It answers FALSE for anything else, and r
   keeps its value.

   THE FAST PATH IS NOT AN APPROXIMATION.  Seven digits keep the
   mantissa below 2^24, so F32 holds it exactly.  Pow10F32 is exact up
   to 10^10.  IEEE 754 then rounds the quotient once, correctly.  The
   answer is the value strtof gives, not a value near it.  The driver
   checks this: csv_driver.c compares all 34.2 million fields of the
   FLUXNET file against strtof.  On that file 98.8% of the fields
   take this path.

   IsNumber's grammar accepts all of these fields too.  So Parse tries
   FastF32 first, and asks CNumber and IsNumber only when it declines.
   This order saves a second scan of each field: the FLUXNET parse went
   from 0.99 to 0.81 s on host1 (2026-10-31). *)
PROCEDURE FastF32 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64 ; VAR r: F32)
  : BOOL
  RAISES IndexError =
VAR
  i, stop, c, mant, k, digs : I64 ;
  neg, dot : BOOL ;
BEGIN
  i := ofs ;
  stop := ofs + n ;
  neg := FALSE ;
  IF i < stop THEN
    IF I64 (b[i]) = 45 THEN
      neg := TRUE ;
      i := i + 1
    END
  END ;
  mant := 0 ;
  k := 0 ;
  digs := 0 ;
  dot := FALSE ;
  WHILE i < stop DO
    c := I64 (b[i]) ;
    IF c >= 48 AND c <= 57 THEN
      (* An eighth digit is one too many for an exact F32 mantissa.
         The early RETURN also keeps mant from overflowing on a long
         run of digits. *)
      IF digs >= 7 THEN RETURN FALSE END ;
      mant := mant * 10 + (c - 48) ;
      digs := digs + 1 ;
      IF dot THEN k := k + 1 END
    ELSIF c = 46 AND NOT dot THEN
      dot := TRUE
    ELSE
      RETURN FALSE
    END ;
    i := i + 1
  END ;
  IF digs = 0 OR k > 10 THEN RETURN FALSE END ;
  r := F32 (mant) / Pow10F32 (k) ;
  IF neg THEN r := -r END ;
  RETURN TRUE
END FastF32 ;

(* FieldF32 parses one field.  It tries FastF32 first.

   Everything else goes to strtof on a pointer INTO the buffer:
   exponent notation, longer mantissas, any character the fast loop
   does not know.  Nothing is copied.  The buffer carries a zero byte
   past its end, and a delimiter or a newline follows every field.
   Either one stops strtof. *)
PROCEDURE FieldF32 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64) : F32
  RAISES IndexError =
VAR
  v : SLICE OF BYTE ;
  r : F32 ;
BEGIN
  IF FastF32 (b, ofs, n, r) THEN RETURN r END ;
  v := SLICE (b, ofs, n) ;
  RETURN F32 (StrToF32 (ADR (v)))
END FieldF32 ;

(* THE WIDE FIELD GOES STRAIGHT THROUGH strtod, with none of the fast
   path FieldF32 keeps.  Since 2026-10-25 it goes through the
   runtime's m9_strtod, which is Eisel-Lemire where it decides and
   strtod where it does not, the same value either way (glibc's strtod
   was 44% of a CSV read).  That fast path exists because a float32
   result is a single rounding whichever way it is reached.  A float64
   one is not, and a hand-rolled mantissa would be an ulp out on the
   values this exists for.  That is the same finding the SOCAT
   longitude produced from the other side. *)
(* IS THIS FIELD A NUMBER AT ALL?

   strtod answers 0 for text, so a column declared Real that carries a
   word read back as a real ZERO.  That zero is indistinguishable from
   a measured one, and silently wrong.  The ICOS ocean store found it:
   a comment column that pandas' duplicate-name mangling let past the
   drop rule became a float array, and 551 sentences read as 0.0 where
   pandas' `to_numeric(errors='coerce')` says NaN.

   So a field the caller declared numeric is parsed only if it LOOKS
   numeric, and is missing otherwise, which is what an empty field
   already answers.  IsNumber is deliberately narrower than strtod:
   `0x10` is not a number here, and pandas agrees.                  *)
PROCEDURE IsNumber (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64) : BOOL
  RAISES IndexError =
VAR
  i, e, digits : I64 ;
  c : I64 ;
BEGIN
  i := ofs ; e := ofs + n ;
  WHILE i < e AND (I64 (b[i]) = 32 OR I64 (b[i]) = 9) DO i := i + 1 END ;
  WHILE e > i AND (I64 (b[e - 1]) = 32 OR I64 (b[e - 1]) = 9) DO
    e := e - 1
  END ;
  IF i >= e THEN RETURN FALSE END ;
  IF I64 (b[i]) = 43 OR I64 (b[i]) = 45 THEN i := i + 1 END ;
  IF i >= e THEN RETURN FALSE END ;
  (* nan / inf / infinity, which strtod takes and pandas takes too *)
  IF Word (b, i, e, 'nan') OR Word (b, i, e, 'inf')
     OR Word (b, i, e, 'infinity') THEN
    RETURN TRUE
  END ;
  digits := 0 ;
  WHILE i < e AND IsDigit (b[i]) DO i := i + 1 ; digits := digits + 1 END ;
  IF i < e AND I64 (b[i]) = 46 THEN
    i := i + 1 ;
    WHILE i < e AND IsDigit (b[i]) DO i := i + 1 ; digits := digits + 1 END
  END ;
  IF digits = 0 THEN RETURN FALSE END ;
  IF i < e THEN
    c := I64 (b[i]) ;
    IF c # 101 AND c # 69 THEN RETURN FALSE END ;
    i := i + 1 ;
    IF i < e THEN
      IF I64 (b[i]) = 43 OR I64 (b[i]) = 45 THEN i := i + 1 END
    END ;
    digits := 0 ;
    WHILE i < e AND IsDigit (b[i]) DO i := i + 1 ; digits := digits + 1 END ;
    IF digits = 0 THEN RETURN FALSE END
  END ;
  RETURN i = e
END IsNumber ;

(* Word asks whether the octets at i..e, lower-cased, equal a
   lower-case ASCII word. *)
PROCEDURE Word (RO b: SLICE OF BYTE ; i: I64 ; e: I64 ; RO w: STR)
  : BOOL
  RAISES IndexError =
VAR k, c : I64 ;
BEGIN
  IF e - i # Text.BLen (w) THEN RETURN FALSE END ;
  FOR k := 0 TO Text.BLen (w) - 1 DO
    c := I64 (b[i + k]) ;
    IF c >= 65 AND c <= 90 THEN c := c + 32 END ;
    IF c # I64 (Text.BAt (w, k)) THEN RETURN FALSE END
  END ;
  RETURN TRUE
EXCEPT
| ValueRange : RETURN FALSE
END Word ;

PROCEDURE FieldF64 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64) : F64
  RAISES IndexError =
VAR v : SLICE OF BYTE ;
BEGIN
  v := SLICE (b, ofs, n) ;
  RETURN F64 (StrToF64 (ADR (v)))
END FieldF64 ;

PROCEDURE FieldI64 (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64 ;
                    row, col: I64) : I64
  RAISES RangeError, IndexError =
VAR
  i, v : I64 ;
  neg : BOOL ;
BEGIN
  v := 0 ;
  neg := FALSE ;
  i := ofs ;
  IF n > 0 THEN
    IF I64 (b[i]) = 45 THEN
      neg := TRUE ;
      i := i + 1
    END
  END ;
  WHILE i < ofs + n DO
    IF NOT IsDigit (b[i]) THEN RAISE RangeError (row, col) END ;
    (* checked multiply and add: a column of digits longer than an
       I64 raises Overflow here rather than wrapping into a
       plausible year *)
    v := v * 10 + (I64 (b[i]) - 48) ;
    i := i + 1
  END ;
  IF neg THEN RETURN -v END ;
  RETURN v
END FieldI64 ;

(* CompactStamp reads the packed digit layouts, YYYYMMDDhhmm and
   YYYYMMDDhhmmss. *)
PROCEDURE CompactStamp (v: I64 ; withSeconds: BOOL) : Time.Instant
  RAISES ValueRange =
VAR c : Time.Civil ;
BEGIN
  c.second := 0.0 ;
  IF withSeconds THEN
    c.second := F64 (v MOD 100) ;
    v := v DIV 100
  END ;
  c.minute := v MOD 100 ;
  v := v DIV 100 ;
  c.hour := v MOD 100 ;
  v := v DIV 100 ;
  c.day := v MOD 100 ;
  v := v DIV 100 ;
  c.month := v MOD 100 ;
  c.year := v DIV 100 ;
  RETURN Time.FromCivil (c)
END CompactStamp ;

(* IsoStamp reads an RFC 3339 stamp.  Time.ParseIso wants a text, so
   the field is copied, into a pool of this call's own: the copy is
   gone at END.  Until 2026-11-15 it went into the caller's pool and
   stayed, a copy a row; a pool is also nothing two threads share. *)
PROCEDURE IsoStamp (RO b: SLICE OF BYTE ; ofs: I64 ; n: I64) : Time.Instant
  RAISES ValueRange, IndexError =
VAR scratch : POOL ;
BEGIN
  RETURN Time.ParseIso (DynStr.Chars (scratch, SLICE (b, ofs, n)))
END IsoStamp ;

PROCEDURE FieldStamp (RO b: SLICE OF BYTE ;
                      ofs: I64 ; n: I64 ; format: I64 ;
                      utcOffset: F64 ; row, col: I64) : Time.Instant
  RAISES RangeError, ValueRange, IndexError =
VAR
  t : Time.Instant ;
BEGIN
  IF format = StampIso THEN
    (* an ISO 8601 stamp carries its own zone, so the caller's offset
       does not apply to it and is not applied *)
    RETURN IsoStamp (b, ofs, n)
  END ;
  IF format = StampEpoch THEN
    t.t := F64 (FieldI64 (b, ofs, n, row, col)) ;
    RETURN t
  END ;
  IF format = StampYmdHms THEN
    IF n # 14 THEN RAISE RangeError (row, col) END ;
    RETURN Time.AddSeconds (
      CompactStamp (FieldI64 (b, ofs, n, row, col), TRUE), -utcOffset)
  END ;
  IF n # 12 THEN RAISE RangeError (row, col) END ;
  RETURN Time.AddSeconds (
    CompactStamp (FieldI64 (b, ofs, n, row, col), FALSE), -utcOffset)
END FieldStamp ;

(* ParseBand parses the rows of one band: from where its first row
   starts, until it has stored its last.  It is the reader's one
   loop.  With one band it is the whole file. *)
PROCEDURE ParseBand (VAR t: PTR Table ; band: I64)
  RAISES ParseError, RangeError, ValueRange, IndexError =
VAR
  i, c, row, limit, start, len, nb, ofs, k : I64 ;
  f : F32 ;
  d : F64 ;
  v : SLICE OF BYTE ;
  h : Held ;
  inQuote, atEnd, known : BOOL ;
BEGIN
  nb := LEN (t.buf) ;
  i := t.bFrom[band] ;
  row := t.bRow[band] ;
  limit := t.bRowEnd[band] ;
  IF row >= limit THEN RETURN END ;
  c := 0 ;
  start := i ;
  inQuote := FALSE ;
  WHILE i <= nb DO
    (* a field ends at a delimiter, a newline, or the end of the file:
       one test per byte and no lookahead.  Inside quotes the first
       two do not count, which is the whole cost of the option. *)
    IF t.opt.quoted AND i < nb THEN
      IF I64 (t.buf[i]) = 34 THEN inQuote := NOT inQuote END
    END ;
    atEnd := FALSE ;
    IF NOT inQuote THEN
      IF i = nb THEN
        atEnd := TRUE
      ELSIF I64 (t.buf[i]) = t.delim OR I64 (t.buf[i]) = 10 THEN
        atEnd := TRUE
      END
    END ;
    IF atEnd THEN
      len := i - start ;
      IF len > 0 THEN
        IF I64 (t.buf[start + len - 1]) = 13 THEN len := len - 1 END
      END ;
      ofs := start ;
      IF t.opt.quoted THEN Unquote (t.buf, ofs, len) END ;
      IF c < t.ncols THEN
        CASE t.kinds[c] OF
        | Real64 :
          (* Use the runtime's one pass (the grammar and the value)
             or, where it declines, IsNumber and FieldF64 as
             before. *)
          k := 0 ;
          IF len > 0 THEN
            v := SLICE (t.buf, ofs, len) ;
            k := I64 (CFieldF64 (ADR (v), C.SSizeT (len), ADR (h)))
          END ;
          IF k = 1 THEN
            d := h.v
          ELSIF k = 0 OR len = 0 OR NOT IsNumber (t.buf, ofs, len) THEN
            d := NaN
          ELSE
            d := FieldF64 (t.buf, ofs, len)
          END ;
          IF k # 0 AND len > 0 AND t.opt.hasMissing THEN
            IF d = F64 (t.opt.missing) THEN d := NaN END
          END ;
          t.dcols[c][row] := d
        | Real :
          (* FastF32 decides most fields in one scan.  The rest go
             through the recogniser, then FieldF32. *)
          IF len > 0 AND FastF32 (t.buf, ofs, len, f) THEN
            known := TRUE
          ELSE
            k := 0 ;
            IF len > 0 THEN
              v := SLICE (t.buf, ofs, len) ;
              k := I64 (CNumber (ADR (v), C.SSizeT (len)))
            END ;
            known := NOT (len = 0 OR k = 0
                          OR (k < 0 AND NOT IsNumber (t.buf, ofs, len))) ;
            IF known THEN f := FieldF32 (t.buf, ofs, len) END
          END ;
          IF NOT known THEN
            t.fcols[c][row] := NaN
          ELSE
            IF t.opt.hasMissing THEN
              IF f = t.opt.missing THEN f := NaN END
            END ;
            t.fcols[c][row] := f
          END
        | Int :
          IF len > 0 THEN
            t.icols[c][row] := FieldI64 (t.buf, ofs, len, row, c)
          END
        | Stamp :
          IF len > 0 THEN
            t.scols[c][row] := FieldStamp (t.buf, ofs, len,
              t.formats[c], t.opt.utcOffset, row, c)
          END
        | Text :
          t.tofs[c][row] := ofs ;
          t.tlen[c][row] := len
        | Skip :
        END
      END ;
      c := c + 1 ;
      start := i + 1 ;
      IF i = nb THEN
        EXIT
      END ;
      IF I64 (t.buf[i]) = 10 THEN
        IF c # t.ncols THEN
          RAISE ParseError ('wrong number of fields', row + 2, c)
        END ;
        row := row + 1 ;
        c := 0 ;
        IF row >= limit THEN EXIT END
      END
    END ;
    i := i + 1
  END ;
END ParseBand ;

PROCEDURE Parse (VAR pool: POOL ; VAR t: PTR Table)
  RAISES ParseError, RangeError, ValueRange, IndexError =
VAR
  c, k : I64 ;
BEGIN
  FOR c := 0 TO t.ncols - 1 DO
    CASE t.kinds[c] OF
    | Real64 :
      t.dcols[c] := NEW (pool, F64, t.nrows)
    | Real :
      t.fcols[c] := NEW (pool, F32, t.nrows)
    | Int :
      t.icols[c] := NEW (pool, I64, t.nrows)
    | Stamp :
      t.scols[c] := NEW (pool, Time.Instant, t.nrows)
    | Text :
      t.tofs[c] := NEW (pool, I64, t.nrows) ;
      t.tlen[c] := NEW (pool, I64, t.nrows)
    | Skip :
    END
  END ;

  IF t.nbands = 1 THEN
    (* one thread: the whole file, and an exception as it comes *)
    ParseBand (t, 0)
  ELSE
    FOR k := 0 TO t.nbands - 1 DO t.bErr[k] := ErrNone END ;
    IF NOT RunBands (pool, t, OpFill) THEN
      (* the first bad row is in the lowest band that failed *)
      FOR k := 0 TO t.nbands - 1 DO
        IF t.bErr[k] = ErrFields THEN
          RAISE ParseError ('wrong number of fields', t.bErrA[k], t.bErrB[k])
        ELSIF t.bErr[k] = ErrRange THEN
          RAISE RangeError (t.bErrA[k], t.bErrB[k])
        ELSIF t.bErr[k] = ErrValue THEN
          RAISE ValueRange
        ELSIF t.bErr[k] = ErrIndex THEN
          RAISE IndexError (t.bErrA[k], t.bErrB[k])
        END
      END ;
      RAISE ValueRange
    END
  END ;
  t.parsed := TRUE
END Parse ;

PROCEDURE ColF64 (t: PTR Table ; c: I64) : SLICE OF F64
  RAISES IndexError =
BEGIN
  RETURN t.dcols[c]
END ColF64 ;

PROCEDURE ColF32 (t: PTR Table ; c: I64) : SLICE OF F32
  RAISES IndexError =
BEGIN
  RETURN t.fcols[c]
END ColF32 ;

PROCEDURE ColI64 (t: PTR Table ; c: I64) : SLICE OF I64
  RAISES IndexError =
BEGIN
  RETURN t.icols[c]
END ColI64 ;

PROCEDURE ColStamp (t: PTR Table ; c: I64) : SLICE OF Time.Instant
  RAISES IndexError =
BEGIN
  RETURN t.scols[c]
END ColStamp ;

PROCEDURE TextAt (VAR pool: POOL ; t: PTR Table ; c, row: I64) : STR
  RAISES IndexError, ValueRange =
VAR
  raw : SLICE OF BYTE ;
  keep : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  raw := SLICE (t.buf, t.tofs[c][row], t.tlen[c][row]) ;
  IF NOT t.opt.quoted THEN
    RETURN DynStr.Chars (pool, raw)
  END ;
  (* undouble "" inside a quoted field.  The header used to declare
     'no doubled "" escapes' as a narrowing.  Frame.WriteCsv writes
     them (it must: a note containing a quote has no other legal
     spelling), and its round-trip gate widened this. *)
  n := 0 ;
  i := 0 ;
  WHILE i < LEN (raw) DO
    n := n + 1 ;
    IF I64 (raw[i]) = 34 AND i + 1 < LEN (raw)
       AND I64 (raw[i + 1]) = 34 THEN
      i := i + 2
    ELSE
      i := i + 1
    END
  END ;
  IF n = LEN (raw) THEN
    RETURN DynStr.Chars (pool, raw)
  END ;
  keep := NEW (pool, BYTE, n) ;
  n := 0 ;
  i := 0 ;
  WHILE i < LEN (raw) DO
    keep[n] := raw[i] ;
    n := n + 1 ;
    IF I64 (raw[i]) = 34 AND i + 1 < LEN (raw)
       AND I64 (raw[i + 1]) = 34 THEN
      i := i + 2
    ELSE
      i := i + 1
    END
  END ;
  RETURN DynStr.Chars (pool, keep)
END TextAt ;

(* ---- the UTF twins ---- *)

PROCEDURE NameUtf (VAR pool: POOL ; t: PTR Table ; c: I64) : UTF
  RAISES IndexError, ValueRange =
VAR raw : SLICE OF BYTE ;
BEGIN
  raw := SLICE (t.buf, t.nameOfs[c], t.nameLen[c]) ;
  RETURN UTF (pool, raw)
END NameUtf ;

PROCEDURE TextAtUtf (VAR pool: POOL ; t: PTR Table ; c, row: I64) : UTF
  RAISES IndexError, ValueRange =
VAR
  scratch : POOL ;
  raw, keep : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  raw := SLICE (t.buf, t.tofs[c][row], t.tlen[c][row]) ;
  IF NOT t.opt.quoted THEN RETURN UTF (pool, raw) END ;
  (* "" undoubled, as TextAt does *)
  keep := NEW (scratch, BYTE, LEN (raw)) ;
  n := 0 ;
  i := 0 ;
  WHILE i < LEN (raw) DO
    keep[n] := raw[i] ;
    n := n + 1 ;
    IF I64 (raw[i]) = 34 AND i + 1 < LEN (raw) AND I64 (raw[i + 1]) = 34 THEN
      i := i + 2
    ELSE
      i := i + 1
    END
  END ;
  keep := SLICE (keep, 0, n) ;
  RETURN UTF (pool, keep)
END TextAtUtf ;

PROCEDURE FindUtf (t: PTR Table ; RO name: UTF) : I64 =
VAR
  o : SLICE OF BYTE ;
  c, i : I64 ;
  same : BOOL ;
BEGIN
  o := OCTETS (name) ;
  FOR c := 0 TO t.ncols - 1 DO
    IF t.nameLen[c] = LEN (o) THEN
      same := TRUE ;
      FOR i := 0 TO LEN (o) - 1 DO
        IF t.buf[t.nameOfs[c] + i] # o[i] THEN same := FALSE END
      END ;
      IF same THEN RETURN c END
    END
  END ;
  RETURN -1
END FindUtf ;

END Csv.
