DEFINITION MODULE Text ;

(* Slice-of-CHAR utilities: search, trim, split, join, case.

   Written because the reinventions had started again.  DynStr.Eq
   exists at all because Json, ZarrStore and Http had each grown a
   private slice-equality; since then Gen grew StartsW and FindCh,
   M9c grew BaseName, and Http grew its own header scan.  That is the
   ledger's "inventory before manufacturing" firing for the second
   time, so this module is the inventory.

   Everything that can return a VIEW returns a view.  Trim and the
   pieces from Split are sub-slices of the caller's own storage: no
   copy, no allocation, no pool argument.  Only the procedures that
   must build something new -- Join, Lower, Upper, and since
   2026-09-27 Cat, Keep and Fields -- take a pool, and their names say
   they are making rather than looking.  (This paragraph named a
   `Slice` procedure and an RO result annotation until 2026-09-27;
   neither exists: `SLICE (s, start, len)` is the language's, and a
   view is written through or not by the mode of the parameter it
   came from.)

   Case folding is ASCII ONLY and says so in its name's absence: there
   is no Unicode case table here, because a wrong one is worse than
   none and the corpus has no caller that needs Turkish dotless i. *)

PROCEDURE Eq (RO a: STR ; RO b: STR) : BOOL ;
  (* character-by-character equality, length first.  The same
     function as DynStr.Eq and deliberately so: this module is the
     inventory, and a caller who has Text imported should not have to
     import DynStr as well to compare two slices.                   *)

PROCEDURE Compare (RO a: STR ; RO b: STR) : I64 ;
  (* -1, 0 or 1: the order Sort.Strs sorts by -- code point by code
     point from the first, and the shorter first where one is a
     prefix of the other.  `<' on two strings is refused by design
     (par 2.3); this is the ordered comparison, for timestamps and
     names (an ISO 8601 timestamp orders as text).  2026-10-09.      *)

PROCEDURE Find (RO hay: STR ; RO needle: STR) : I64 ;
  (* first index, or -1.  An empty needle is found at 0, which is the
     convention every other language settled on and the one that
     makes Find/Slice compose without a special case.               *)

PROCEDURE FindChar (RO s: STR ; c: CHAR) : I64 ;
PROCEDURE LastChar (RO s: STR ; c: CHAR) : I64 ;
  (* first and last index of c, or -1 when it does not occur.  -1
     rather than LEN (s) because -1 cannot be mistaken for a position
     and will not silently index anything: the M2 habit of answering
     a past-the-end index is how a not-found becomes a read.

       c -- one scalar, not a set of them.  A search for any of
            several characters is a loop the caller writes, because
            M9 has no set type (report par 9.4) and inventing one
            here would hide that.                                   *)

PROCEDURE Contains (RO hay: STR ; RO needle: STR) : BOOL ;
PROCEDURE StartsWith (RO s: STR ; RO prefix: STR) : BOOL ;
PROCEDURE EndsWith (RO s: STR ; RO suffix: STR) : BOOL ;
  (* the three yes/no forms.  An EMPTY needle, prefix or suffix is
     always present, which follows from Find's empty-needle rule
     above and is the answer that makes a loop over a possibly-empty
     separator terminate.  Contains is Find (...) >= 0 and says so
     rather than making every caller write it; Gen and M9c had both
     grown a private StartsW before this module existed.            *)

PROCEDURE IndexOf (RO among: SLICE OF STR ; RO s: STR) : I64 ;
PROCEDURE OneOf (RO s: STR ; RO among: SLICE OF STR) : BOOL ;
  (* membership in a list of strings: the index of the first element
     equal to s, or -1; and the yes/no form.  A linear search, which
     is what the chain of comparisons it replaces was.

       among -- usually a constant table (report par 2.2.4):
                  CONST Units = ['ppm', 'ppb', 'ppt'] ;
                  ... IF Text.OneOf (u, Units) THEN ...
                A table is lent whole to an RO parameter and to
                nothing else, which is why this one is RO.  The
                compiler held 29 such lists as `Eq (n, 'a') OR Eq
                (n, 'b') OR ...`, one of them 96 names long, when
                these two were written (2026-10-01).                *)

PROCEDURE Trim (RO s: STR) : STR ;
PROCEDURE TrimLeft (RO s: STR) : STR ;
PROCEDURE TrimRight (RO s: STR) : STR ;
  (* blanks, tabs, CR and LF.  A VIEW of s, not a copy.            *)

PROCEDURE CountChar (RO s: STR ; c: CHAR) : I64 ;
  (* how many times c occurs.  Split allocates CountChar + 1 pieces,
     which is what this is for: sizing the vector before filling it,
     in one pass each, with no growable array in between.           *)

PROCEDURE Split (RO s: STR ; sep: CHAR) : SLICE OF STR ;
  (* n separators give n+1 pieces, empties included: 'a,,b' splits
     into three, and ',' into two empty ones.  Dropping empties is a
     different function, and callers that want it can say so; a split
     that silently loses fields is how CSV readers corrupt data.
     The PIECES are views into s -- only the vector is allocated.   *)

PROCEDURE Fields (RO s: STR ; sep: CHAR) : SLICE OF STR ;
  (* Split without the empty pieces: `a,,b,` gives [a, b], which is
     C's strtok and awk's default, where Split gives [a, '', b, ''].
     The ONEFlux port carried this beside Split (Common.Tokens) *)

PROCEDURE Keep (VAR pool: POOL ; RO s: STR) : STR ;
  (* a COPY of s in pool.  The one thing to do with a string that
     dies with its frame -- a `+` result, a view of a scratch buffer
     -- before storing it in a record that outlives the frame.  The
     ONEFlux port carried these six lines in six modules and the bugs
     were the forgotten ones (par 2.3). *)

PROCEDURE Cat (VAR pool: POOL ; RO a: STR ; RO b: STR) : STR ;
  (* a + b, in pool rather than in the frame: for the result that is
     stored, where `+` is for the result that is used *)

PROCEDURE Join (RO parts: SLICE OF STR ; RO sep: STR) : STR ;
  (* the inverse of Split, and exact: Join (Split (s, c), c) is s
     again, because Split keeps its empties.

       parts -- BORROWED and copied out of; the result is new
                storage in the caller's frame (par 4.3) and shares
                nothing with them, so the
                pieces may be views of a buffer the caller is about
                to reuse.
       sep   -- placed BETWEEN pieces, so an empty parts gives an
                empty result and a one-element parts gives that
                element with no separator at all.                   *)

PROCEDURE Lower (RO s: STR) : STR ;
PROCEDURE Upper (RO s: STR) : STR ;
  (* ASCII A..Z only; every other scalar passes through untouched *)

PROCEDURE Replace (RO s: STR ; RO old: STR ; RO by: STR) : STR ;
  (* s with every occurrence of `old' replaced by `by': found left to
     right, and never overlapping, so 'aaaa' with 'aa' replaced is
     two replacements and not three.  Python's str.replace.  An
     EMPTY old occurs nowhere here and s comes back as it was;
     Python finds it between every two characters, which is nobody's
     meaning.  A copy either way: the answer shares nothing with s. *)

PROCEDURE Match (RO pattern: STR ; RO s: STR) : BOOL ;
  (* does the WHOLE of s fit the shell pattern?  Python's
     fnmatch.fnmatchcase, case-sensitive:

       *        any run of characters, none included
       ?        any one character
       [abc]    one of those; [a-c] one in that range; [!abc] one
                that is not; a ] straight after the [ or the [! is a
                member, and so is a - at either end
       a [ that no ] closes, and every other character, stand for
       themselves.  There is no escape character.

     A range written backwards, [c-a], holds nothing.  The / is a
     character like any other here; System.Glob is what knows about
     directories. *)

PROCEDURE ToBase64 (RO b: SLICE OF BYTE) : STR ;
  (* RFC 4648 base64 of the octets, padded with =, no line breaks:
     Python's base64.b64encode.  Octets to TEXT: a key in a header, a
     token in a URL (not URL-safe; that alphabet is not here), a mail
     body line *)

PROCEDURE ToBase64Url (RO b: SLICE OF BYTE) : STR ;
  (* RFC 4648 section 5, base64url WITHOUT padding: `-' and `_' for
     `+' and `/', no `=' -- what ICOS object ids, JWTs and URL tokens
     use; Python's base64.urlsafe_b64encode (b).rstrip (b'=')
     (cp-kernel's issue 19, 2026-10-09). *)

PROCEDURE FromBase64Url (RO s: STR) : SLICE OF BYTE RAISES ValueRange ;
  (* the octets back from base64url, padding optional: a length of 1
     mod 4 cannot be, and any character outside the url alphabet (a
     `+' or `/' included) RAISES ValueRange, as does `=' anywhere but
     at the end of a padded group. *)

PROCEDURE FromBase64 (RO s: STR) : SLICE OF BYTE RAISES ValueRange ;
  (* the octets back, STRICTLY -- Python's base64.b64decode (s,
     validate=True): a character outside the alphabet, a blank, a line
     break, a length that is not a multiple of four, padding that is
     not one or two = at the very end, each RAISES ValueRange.  What
     Python takes is taken: the unused low bits before a = are not
     held to zero *)

END Text.


IMPLEMENTATION MODULE Text ;

IMPORT DynStr ;

CONST
  (* a table, not CHR (ORD (c) +- 32): CHR is a checked conversion
     and would put a RAISES ValueRange on two total functions.
     Indexing is checked too, but IndexError is predeclared and needs
     no declaration, and 0..25 cannot reach it. *)
  LowerAlpha = 'abcdefghijklmnopqrstuvwxyz' ;
  UpperAlpha = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' ;

PROCEDURE Eq (RO a: STR ; RO b: STR) : BOOL =
BEGIN
  RETURN DynStr.Eq (a, b)
END Eq ;

PROCEDURE StartsWith (RO s: STR ; RO prefix: STR) : BOOL =
BEGIN
  IF LEN (prefix) > LEN (s) THEN RETURN FALSE END ;
  RETURN DynStr.Eq (SLICE (s, 0, LEN (prefix)), prefix)
END StartsWith ;

PROCEDURE EndsWith (RO s: STR ; RO suffix: STR) : BOOL =
BEGIN
  IF LEN (suffix) > LEN (s) THEN RETURN FALSE END ;
  RETURN DynStr.Eq (SLICE (s, LEN (s) - LEN (suffix), LEN (suffix)),
                    suffix)
END EndsWith ;

PROCEDURE Find (RO hay: STR ; RO needle: STR) : I64 =
VAR i : I64 ;
BEGIN
  IF LEN (needle) = 0 THEN RETURN 0 END ;
  IF LEN (needle) > LEN (hay) THEN RETURN -1 END ;
  FOR i := 0 TO LEN (hay) - LEN (needle) DO
    IF DynStr.Eq (SLICE (hay, i, LEN (needle)), needle) THEN
      RETURN i
    END
  END ;
  RETURN -1
END Find ;

PROCEDURE Contains (RO hay: STR ; RO needle: STR) : BOOL =
BEGIN
  RETURN Find (hay, needle) >= 0
END Contains ;

PROCEDURE IndexOf (RO among: SLICE OF STR ; RO s: STR) : I64 =
VAR i : I64 ;
BEGIN
  (* the length is compared here, before the call: most of a list
     differs from s in length, and the compiler's own lists cost it
     4.5% of its generation time until this line (measured) *)
  FOR i := 0 TO LEN (among) - 1 DO
    IF LEN (among[i]) = LEN (s) THEN
      IF Eq (among[i], s) THEN RETURN i END
    END
  END ;
  RETURN -1
END IndexOf ;

PROCEDURE OneOf (RO s: STR ; RO among: SLICE OF STR) : BOOL =
BEGIN
  RETURN IndexOf (among, s) >= 0
END OneOf ;

PROCEDURE FindChar (RO s: STR ; c: CHAR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN RETURN i END
  END ;
  RETURN -1
END FindChar ;

PROCEDURE LastChar (RO s: STR ; c: CHAR) : I64 =
VAR i, found : I64 ;
BEGIN
  found := -1 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN found := i END
  END ;
  RETURN found
END LastChar ;

PROCEDURE CountChar (RO s: STR ; c: CHAR) : I64 =
VAR i, n : I64 ;
BEGIN
  n := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN n := n + 1 END
  END ;
  RETURN n
END CountChar ;

PROCEDURE Blank (c: CHAR) : BOOL =
BEGIN
  RETURN c = ' ' OR c = 09C OR c = 0DC OR c = 0AC
END Blank ;

PROCEDURE TrimLeft (RO s: STR) : STR =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (s) DO
    IF NOT Blank (s[i]) THEN EXIT END ;
    i := i + 1
  END ;
  RETURN SLICE (s, i, LEN (s) - i)
END TrimLeft ;

PROCEDURE TrimRight (RO s: STR) : STR =
VAR n : I64 ;
BEGIN
  n := LEN (s) ;
  WHILE n > 0 DO
    IF NOT Blank (s[n - 1]) THEN EXIT END ;
    n := n - 1
  END ;
  RETURN SLICE (s, 0, n)
END TrimRight ;

PROCEDURE Trim (RO s: STR) : STR =
BEGIN
  RETURN TrimLeft (TrimRight (s))
END Trim ;

PROCEDURE Split (RO s: STR ; sep: CHAR) : SLICE OF STR =
VAR
  parts : SLICE OF STR ;
  i, start, n : I64 ;
BEGIN
  n := CountChar (s, sep) + 1 ;
  parts := NEW (STR, n) ;
  n := 0 ;
  start := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = sep THEN
      (* a view into s: only the vector above was allocated *)
      parts[n] := SLICE (s, start, i - start) ;
      n := n + 1 ;
      start := i + 1
    END
  END ;
  parts[n] := SLICE (s, start, LEN (s) - start) ;
  RETURN parts
END Split ;

PROCEDURE Fields (RO s: STR ; sep: CHAR) : SLICE OF STR =
VAR
  parts : SLICE OF STR ;
  i, start, n : I64 ;
BEGIN
  parts := NEW (STR, CountChar (s, sep) + 1) ;
  n := 0 ;
  start := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = sep THEN
      IF i > start THEN
        parts[n] := SLICE (s, start, i - start) ;
        n := n + 1
      END ;
      start := i + 1
    END
  END ;
  IF LEN (s) > start THEN
    parts[n] := SLICE (s, start, LEN (s) - start) ;
    n := n + 1
  END ;
  RETURN SLICE (parts, 0, n)
END Fields ;

PROCEDURE Keep (VAR pool: POOL ; RO s: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
BEGIN
  r := NEW (pool, CHAR, LEN (s)) ;
  FOR i := 0 TO LEN (s) - 1 DO r[i] := s[i] END ;
  RETURN r
END Keep ;

PROCEDURE Compare (RO a: STR ; RO b: STR) : I64 =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (a) AND i < LEN (b) DO
    IF a[i] < b[i] THEN RETURN -1 END ;
    IF a[i] > b[i] THEN RETURN 1 END ;
    i := i + 1
  END ;
  IF LEN (a) < LEN (b) THEN RETURN -1 END ;
  IF LEN (a) > LEN (b) THEN RETURN 1 END ;
  RETURN 0
END Compare ;

PROCEDURE Cat (VAR pool: POOL ; RO a: STR ; RO b: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
BEGIN
  r := NEW (pool, CHAR, LEN (a) + LEN (b)) ;
  FOR i := 0 TO LEN (a) - 1 DO r[i] := a[i] END ;
  FOR i := 0 TO LEN (b) - 1 DO r[LEN (a) + i] := b[i] END ;
  RETURN r
END Cat ;

PROCEDURE Join (RO parts: SLICE OF STR ; RO sep: STR) : STR =
VAR
  s : STR ;
  i : I64 ;
BEGIN
  (* `+` extends the arena's top allocation in place (par 2.3), so
     this is one growing string, not a copy per piece *)
  s := '' ;
  FOR i := 0 TO LEN (parts) - 1 DO
    IF i > 0 THEN s := s + sep END ;
    s := s + parts[i]
  END ;
  RETURN s
END Join ;

PROCEDURE Lower (RO s: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR i := 0 TO LEN (s) - 1 DO
    c := s[i] ;
    IF c >= 'A' AND c <= 'Z' THEN c := LowerAlpha[ORD (c) - 65] END ;
    r := r + c
  END ;
  RETURN r
END Lower ;

PROCEDURE Upper (RO s: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR i := 0 TO LEN (s) - 1 DO
    c := s[i] ;
    IF c >= 'a' AND c <= 'z' THEN c := UpperAlpha[ORD (c) - 97] END ;
    r := r + c
  END ;
  RETURN r
END Upper ;

PROCEDURE Replace (RO s: STR ; RO old: STR ; RO by: STR) : STR =
VAR
  r : STR ;
  i, n, m : I64 ;
BEGIN
  n := LEN (s) ;
  m := LEN (old) ;
  r := '' ;
  IF m = 0 THEN RETURN r + s END ;
  i := 0 ;
  WHILE i < n DO
    IF i + m <= n AND DynStr.Eq (SLICE (s, i, m), old) THEN
      r := r + by ;
      i := i + m
    ELSE
      r := r + s[i] ;
      i := i + 1
    END
  END ;
  RETURN r
END Replace ;

(* ---- Match ---- *)

(* the ] that closes the set opened by the [ at i, or -1 when none
   does and the [ is a character like any other.  A ] met straight
   after the [ or the [! is a member and closes nothing. *)
PROCEDURE SetEnd (RO pat: STR ; i: I64) : I64 =
VAR j, n : I64 ;
BEGIN
  n := LEN (pat) ;
  j := i + 1 ;
  IF j < n AND pat[j] = '!' THEN j := j + 1 END ;
  IF j < n AND pat[j] = ']' THEN j := j + 1 END ;
  WHILE j < n AND pat[j] # ']' DO j := j + 1 END ;
  IF j >= n THEN RETURN -1 END ;
  RETURN j
END SetEnd ;

(* is c among the members pat[a .. b - 1]?  Read left to right: a
   character with a - and another after it is a range, anything else
   is itself -- so a - at either end is a hyphen, and so is one that
   follows a range. *)
PROCEDURE InSet (RO pat: STR ; a, b: I64 ; c: CHAR) : BOOL =
VAR q : I64 ;
BEGIN
  q := a ;
  WHILE q < b DO
    IF q + 2 < b AND pat[q + 1] = '-' THEN
      IF pat[q] <= c AND c <= pat[q + 2] THEN RETURN TRUE END ;
      q := q + 3
    ELSE
      IF pat[q] = c THEN RETURN TRUE END ;
      q := q + 1
    END
  END ;
  RETURN FALSE
END InSet ;

(* how much of the pattern from p on takes the one character c: 0
   when it does not.  pat[p] is not a star. *)
PROCEDURE Takes (RO pat: STR ; p: I64 ; c: CHAR) : I64 =
VAR
  e, a : I64 ;
  negated : BOOL ;
BEGIN
  IF pat[p] = '?' THEN RETURN 1 END ;
  IF pat[p] = '[' THEN
    e := SetEnd (pat, p) ;
    IF e >= 0 THEN
      a := p + 1 ;
      negated := pat[a] = '!' ;
      IF negated THEN a := a + 1 END ;
      IF InSet (pat, a, e, c) # negated THEN RETURN e + 1 - p END ;
      RETURN 0
    END
  END ;
  IF pat[p] = c THEN RETURN 1 END ;
  RETURN 0
END Takes ;

PROCEDURE Match (RO pattern: STR ; RO s: STR) : BOOL =
VAR
  p, i, np, ns, step : I64 ;
  starP, starI : I64 ;         (* the last star, and what it has taken *)
BEGIN
  np := LEN (pattern) ;
  ns := LEN (s) ;
  p := 0 ;
  i := 0 ;
  starP := -1 ;
  starI := 0 ;
  LOOP
    IF p < np AND pattern[p] = '*' THEN
      (* take nothing yet, and remember where to come back to *)
      starP := p ;
      starI := i ;
      p := p + 1
    ELSE
      step := 0 ;
      IF p < np AND i < ns THEN step := Takes (pattern, p, s[i]) END ;
      IF step > 0 THEN
        p := p + step ;
        i := i + 1
      ELSIF p = np AND i = ns THEN
        RETURN TRUE
      ELSIF starP >= 0 AND starI < ns THEN
        (* the last star takes one character more *)
        starI := starI + 1 ;
        i := starI ;
        p := starP + 1
      ELSE
        RETURN FALSE
      END
    END
  END
END Match ;

(* ---- base64 ------------------------------------------------------- *)

PROCEDURE ToBase64 (RO b: SLICE OF BYTE) : STR =
VAR
  s, B64 : STR ;
  i, o, v, n : I64 ;
BEGIN
  (* a string, indexed: a table of 'A' .. '/' would be one of STRs *)
  B64 := 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/' ;
  n := (LEN (b) + 2) DIV 3 ;
  s := NEW (CHAR, 4 * n) ;
  o := 0 ;
  i := 0 ;
  WHILE i + 3 <= LEN (b) DO
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 + I64 (b[i + 2]) ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := B64[(v DIV 64) MOD 64] ;
    s[o + 3] := B64[v MOD 64] ;
    i := i + 3 ;
    o := o + 4
  END ;
  IF i + 1 = LEN (b) THEN
    v := I64 (b[i]) * 65536 ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := '=' ;
    s[o + 3] := '='
  ELSIF i + 2 = LEN (b) THEN
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := B64[(v DIV 64) MOD 64] ;
    s[o + 3] := '='
  END ;
  RETURN s
END ToBase64 ;

PROCEDURE ToBase64Url (RO b: SLICE OF BYTE) : STR =
VAR
  s, t : STR ;
  i, n : I64 ;
BEGIN
  s := ToBase64 (b) ;
  n := LEN (s) ;
  WHILE n > 0 AND s[n - 1] = '=' DO n := n - 1 END ;
  t := NEW (CHAR, n) ;
  FOR i := 0 TO n - 1 DO
    IF s[i] = '+' THEN t[i] := '-'
    ELSIF s[i] = '/' THEN t[i] := '_'
    ELSE t[i] := s[i]
    END
  END ;
  RETURN t
END ToBase64Url ;

PROCEDURE FromBase64Url (RO s: STR) : SLICE OF BYTE RAISES ValueRange =
VAR
  t : STR ;
  i, n, pad : I64 ;
BEGIN
  (* into the standard alphabet with its padding, then strictly *)
  n := LEN (s) ;
  IF n > 0 AND s[n - 1] = '=' THEN
    IF n MOD 4 # 0 THEN RAISE ValueRange END ;
    pad := 0
  ELSE
    IF n MOD 4 = 1 THEN RAISE ValueRange END ;
    pad := (4 - n MOD 4) MOD 4
  END ;
  t := NEW (CHAR, n + pad) ;
  FOR i := 0 TO n - 1 DO
    IF s[i] = '+' OR s[i] = '/' THEN RAISE ValueRange END ;
    IF s[i] = '-' THEN t[i] := '+'
    ELSIF s[i] = '_' THEN t[i] := '/'
    ELSE t[i] := s[i]
    END
  END ;
  FOR i := n TO n + pad - 1 DO t[i] := '=' END ;
  RETURN FromBase64 (t)
END FromBase64Url ;

PROCEDURE B64Val (c: CHAR) : I64 =
  (* the alphabet's value of c, -1 for a character outside it *)
BEGIN
  IF c >= 'A' AND c <= 'Z' THEN RETURN ORD (c) - 65 END ;
  IF c >= 'a' AND c <= 'z' THEN RETURN ORD (c) - 97 + 26 END ;
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 + 52 END ;
  IF c = '+' THEN RETURN 62 END ;
  IF c = '/' THEN RETURN 63 END ;
  RETURN -1
END B64Val ;

PROCEDURE FromBase64 (RO s: STR) : SLICE OF BYTE RAISES ValueRange =
VAR
  out : SLICE OF BYTE ;
  i, o, n, pad, v, k, a : I64 ;
BEGIN
  IF LEN (s) MOD 4 # 0 THEN RAISE ValueRange END ;
  pad := 0 ;
  IF LEN (s) >= 1 AND s[LEN (s) - 1] = '=' THEN pad := 1 END ;
  IF LEN (s) >= 2 AND s[LEN (s) - 2] = '=' AND pad = 1 THEN pad := 2 END ;
  n := LEN (s) DIV 4 * 3 - pad ;
  out := NEW (BYTE, n) ;
  o := 0 ;
  i := 0 ;
  WHILE i < LEN (s) DO
    v := 0 ;
    FOR k := 0 TO 3 DO
      IF s[i + k] = '=' THEN
        (* only in the last group, and only as its last one or two *)
        IF i + 4 < LEN (s) OR k < 4 - pad THEN RAISE ValueRange END ;
        a := 0
      ELSE
        a := B64Val (s[i + k]) ;
        IF a < 0 THEN RAISE ValueRange END
      END ;
      v := v * 64 + a
    END ;
    IF o < n THEN out[o] := BYTE (v DIV 65536) END ;
    IF o + 1 < n THEN out[o + 1] := BYTE ((v DIV 256) MOD 256) END ;
    IF o + 2 < n THEN out[o + 2] := BYTE (v MOD 256) END ;
    o := o + 3 ;
    i := i + 4
  END ;
  RETURN out
END FromBase64 ;

END Text.
