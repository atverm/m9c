PROCEDURE Eq (RO a: STR ; RO b: STR) : BOOL =
BEGIN
  RETURN DynStr.Eq (a, b)
END Eq ;

PROCEDURE StartsWith (RO s: STR ; RO prefix: STR) : BOOL =
BEGIN
  IF LEN (prefix) > LEN (s) THEN RETURN FALSE END ;
  RETURN DynStr.Eq (SLICE (s, 0, LEN (prefix)), prefix)
END StartsWith ;

PROCEDURE EndsWith (RO s: STR ; RO suffix: STR) : BOOL =
BEGIN
  IF LEN (suffix) > LEN (s) THEN RETURN FALSE END ;
  RETURN DynStr.Eq (SLICE (s, LEN (s) - LEN (suffix), LEN (suffix)),
                    suffix)
END EndsWith ;

PROCEDURE Find (RO hay: STR ; RO needle: STR) : I64 =
VAR i : I64 ;
BEGIN
  IF LEN (needle) = 0 THEN RETURN 0 END ;
  IF LEN (needle) > LEN (hay) THEN RETURN -1 END ;
  FOR i := 0 TO LEN (hay) - LEN (needle) DO
    IF DynStr.Eq (SLICE (hay, i, LEN (needle)), needle) THEN
      RETURN i
    END
  END ;
  RETURN -1
END Find ;

PROCEDURE Contains (RO hay: STR ; RO needle: STR) : BOOL =
BEGIN
  RETURN Find (hay, needle) >= 0
END Contains ;

PROCEDURE IndexOf (RO among: SLICE OF STR ; RO s: STR) : I64 =
VAR i : I64 ;
BEGIN
  (* the length is compared here, before the call: most of a list
     differs from s in length, and the compiler's own lists cost it
     4.5% of its generation time until this line (measured) *)
  FOR i := 0 TO LEN (among) - 1 DO
    IF LEN (among[i]) = LEN (s) THEN
      IF Eq (among[i], s) THEN RETURN i END
    END
  END ;
  RETURN -1
END IndexOf ;

PROCEDURE OneOf (RO s: STR ; RO among: SLICE OF STR) : BOOL =
BEGIN
  RETURN IndexOf (among, s) >= 0
END OneOf ;

PROCEDURE FindChar (RO s: STR ; c: CHAR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN RETURN i END
  END ;
  RETURN -1
END FindChar ;

PROCEDURE LastChar (RO s: STR ; c: CHAR) : I64 =
VAR i, found : I64 ;
BEGIN
  found := -1 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN found := i END
  END ;
  RETURN found
END LastChar ;

PROCEDURE CountChar (RO s: STR ; c: CHAR) : I64 =
VAR i, n : I64 ;
BEGIN
  n := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = c THEN n := n + 1 END
  END ;
  RETURN n
END CountChar ;

PROCEDURE Blank (c: CHAR) : BOOL =
BEGIN
  RETURN c = ' ' OR c = 09C OR c = 0DC OR c = 0AC
END Blank ;

PROCEDURE TrimLeft (RO s: STR) : STR =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (s) DO
    IF NOT Blank (s[i]) THEN EXIT END ;
    i := i + 1
  END ;
  RETURN SLICE (s, i, LEN (s) - i)
END TrimLeft ;

PROCEDURE TrimRight (RO s: STR) : STR =
VAR n : I64 ;
BEGIN
  n := LEN (s) ;
  WHILE n > 0 DO
    IF NOT Blank (s[n - 1]) THEN EXIT END ;
    n := n - 1
  END ;
  RETURN SLICE (s, 0, n)
END TrimRight ;

PROCEDURE Trim (RO s: STR) : STR =
BEGIN
  RETURN TrimLeft (TrimRight (s))
END Trim ;

PROCEDURE Split (RO s: STR ; sep: CHAR) : SLICE OF STR =
VAR
  parts : SLICE OF STR ;
  i, start, n : I64 ;
BEGIN
  n := CountChar (s, sep) + 1 ;
  parts := NEW (STR, n) ;
  n := 0 ;
  start := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = sep THEN
      (* a view into s: only the vector above was allocated *)
      parts[n] := SLICE (s, start, i - start) ;
      n := n + 1 ;
      start := i + 1
    END
  END ;
  parts[n] := SLICE (s, start, LEN (s) - start) ;
  RETURN parts
END Split ;

PROCEDURE Fields (RO s: STR ; sep: CHAR) : SLICE OF STR =
VAR
  parts : SLICE OF STR ;
  i, start, n : I64 ;
BEGIN
  parts := NEW (STR, CountChar (s, sep) + 1) ;
  n := 0 ;
  start := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = sep THEN
      IF i > start THEN
        parts[n] := SLICE (s, start, i - start) ;
        n := n + 1
      END ;
      start := i + 1
    END
  END ;
  IF LEN (s) > start THEN
    parts[n] := SLICE (s, start, LEN (s) - start) ;
    n := n + 1
  END ;
  RETURN SLICE (parts, 0, n)
END Fields ;

PROCEDURE Keep (VAR pool: POOL ; RO s: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
BEGIN
  r := NEW (pool, CHAR, LEN (s)) ;
  FOR i := 0 TO LEN (s) - 1 DO r[i] := s[i] END ;
  RETURN r
END Keep ;

PROCEDURE Compare (RO a: STR ; RO b: STR) : I64 =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (a) AND i < LEN (b) DO
    IF a[i] < b[i] THEN RETURN -1 END ;
    IF a[i] > b[i] THEN RETURN 1 END ;
    i := i + 1
  END ;
  IF LEN (a) < LEN (b) THEN RETURN -1 END ;
  IF LEN (a) > LEN (b) THEN RETURN 1 END ;
  RETURN 0
END Compare ;

PROCEDURE Cat (VAR pool: POOL ; RO a: STR ; RO b: STR) : STR =
VAR
  r : STR ;
  i : I64 ;
BEGIN
  r := NEW (pool, CHAR, LEN (a) + LEN (b)) ;
  FOR i := 0 TO LEN (a) - 1 DO r[i] := a[i] END ;
  FOR i := 0 TO LEN (b) - 1 DO r[LEN (a) + i] := b[i] END ;
  RETURN r
END Cat ;

PROCEDURE Join (RO parts: SLICE OF STR ; RO sep: STR) : STR =
VAR
  s : STR ;
  i : I64 ;
BEGIN
  (* `+` extends the arena's top allocation in place (par 2.3), so
     this is one growing string, not a copy per piece *)
  s := '' ;
  FOR i := 0 TO LEN (parts) - 1 DO
    IF i > 0 THEN s := s + sep END ;
    s := s + parts[i]
  END ;
  RETURN s
END Join ;

(* where c is in an ascending table, or -1: a bisection *)
PROCEDURE CaseFind (RO from: SLICE OF I64 ; c: I64) : I64 =
VAR lo, hi, mid : I64 ;
BEGIN
  lo := 0 ;
  hi := LEN (from) - 1 ;
  WHILE lo <= hi DO
    mid := (lo + hi) DIV 2 ;
    IF from[mid] = c THEN RETURN mid END ;
    IF from[mid] < c THEN lo := mid + 1 ELSE hi := mid - 1 END
  END ;
  RETURN -1
END CaseFind ;

PROCEDURE Lower (RO s: STR) : STR =
VAR
  r : STR ;
  i, k, j : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR i := 0 TO LEN (s) - 1 DO
    c := s[i] ;
    IF c >= 'A' AND c <= 'Z' THEN
      r := r + LowerAlpha[ORD (c) - 65]
    ELSIF ORD (c) < 128 THEN
      r := r + c
    ELSE
      k := CaseFind (LowFrom, ORD (c)) ;
      IF k < 0 THEN
        r := r + c
      ELSE
        FOR j := LowAt[k] TO LowAt[k + 1] - 1 DO r := r + LowTo[j] END
      END
    END
  END ;
  RETURN r
END Lower ;

PROCEDURE Upper (RO s: STR) : STR =
VAR
  r : STR ;
  i, k, j : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR i := 0 TO LEN (s) - 1 DO
    c := s[i] ;
    IF c >= 'a' AND c <= 'z' THEN
      r := r + UpperAlpha[ORD (c) - 97]
    ELSIF ORD (c) < 128 THEN
      r := r + c
    ELSE
      k := CaseFind (UpFrom, ORD (c)) ;
      IF k < 0 THEN
        r := r + c
      ELSE
        FOR j := UpAt[k] TO UpAt[k + 1] - 1 DO r := r + UpTo[j] END
      END
    END
  END ;
  RETURN r
END Upper ;

PROCEDURE Replace (RO s: STR ; RO old: STR ; RO by: STR) : STR =
VAR
  r : STR ;
  i, n, m : I64 ;
BEGIN
  n := LEN (s) ;
  m := LEN (old) ;
  r := '' ;
  IF m = 0 THEN RETURN r + s END ;
  i := 0 ;
  WHILE i < n DO
    IF i + m <= n AND DynStr.Eq (SLICE (s, i, m), old) THEN
      r := r + by ;
      i := i + m
    ELSE
      r := r + s[i] ;
      i := i + 1
    END
  END ;
  RETURN r
END Replace ;

(* ---- Match ---- *)

(* the ] that closes the set opened by the [ at i, or -1 when none
   does and the [ is a character like any other.  A ] met straight
   after the [ or the [! is a member and closes nothing. *)
PROCEDURE SetEnd (RO pat: STR ; i: I64) : I64 =
VAR j, n : I64 ;
BEGIN
  n := LEN (pat) ;
  j := i + 1 ;
  IF j < n AND pat[j] = '!' THEN j := j + 1 END ;
  IF j < n AND pat[j] = ']' THEN j := j + 1 END ;
  WHILE j < n AND pat[j] # ']' DO j := j + 1 END ;
  IF j >= n THEN RETURN -1 END ;
  RETURN j
END SetEnd ;

(* is c among the members pat[a .. b - 1]?  Read left to right: a
   character with a - and another after it is a range, anything else
   is itself -- so a - at either end is a hyphen, and so is one that
   follows a range. *)
PROCEDURE InSet (RO pat: STR ; a, b: I64 ; c: CHAR) : BOOL =
VAR q : I64 ;
BEGIN
  q := a ;
  WHILE q < b DO
    IF q + 2 < b AND pat[q + 1] = '-' THEN
      IF pat[q] <= c AND c <= pat[q + 2] THEN RETURN TRUE END ;
      q := q + 3
    ELSE
      IF pat[q] = c THEN RETURN TRUE END ;
      q := q + 1
    END
  END ;
  RETURN FALSE
END InSet ;

PROCEDURE AllIn (RO s: STR ; RO set: STR) : BOOL =
VAR
  i, a : I64 ;
  neg : BOOL ;
BEGIN
  IF LEN (s) = 0 THEN RETURN FALSE END ;
  a := 0 ;
  neg := LEN (set) > 1 AND set[0] = '!' ;
  IF neg THEN a := 1 END ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF InSet (set, a, LEN (set), s[i]) = neg THEN RETURN FALSE END
  END ;
  RETURN TRUE
END AllIn ;

PROCEDURE AllDigits (RO s: STR) : BOOL =
BEGIN
  RETURN AllIn (s, '0-9')
END AllDigits ;

PROCEDURE AllLower (RO s: STR) : BOOL =
BEGIN
  RETURN AllIn (s, 'a-z')
END AllLower ;

PROCEDURE AllUpper (RO s: STR) : BOOL =
BEGIN
  RETURN AllIn (s, 'A-Z')
END AllUpper ;

PROCEDURE AllAlnum (RO s: STR) : BOOL =
BEGIN
  RETURN AllIn (s, 'a-zA-Z0-9')
END AllAlnum ;

(* how much of the pattern from p on takes the one character c: 0
   when it does not.  pat[p] is not a star. *)
PROCEDURE Takes (RO pat: STR ; p: I64 ; c: CHAR) : I64 =
VAR
  e, a : I64 ;
  negated : BOOL ;
BEGIN
  IF pat[p] = '?' THEN RETURN 1 END ;
  IF pat[p] = '[' THEN
    e := SetEnd (pat, p) ;
    IF e >= 0 THEN
      a := p + 1 ;
      negated := pat[a] = '!' ;
      IF negated THEN a := a + 1 END ;
      IF InSet (pat, a, e, c) # negated THEN RETURN e + 1 - p END ;
      RETURN 0
    END
  END ;
  IF pat[p] = c THEN RETURN 1 END ;
  RETURN 0
END Takes ;

PROCEDURE Match (RO pattern: STR ; RO s: STR) : BOOL =
VAR
  p, i, np, ns, step : I64 ;
  starP, starI : I64 ;         (* the last star, and what it has taken *)
BEGIN
  np := LEN (pattern) ;
  ns := LEN (s) ;
  p := 0 ;
  i := 0 ;
  starP := -1 ;
  starI := 0 ;
  LOOP
    IF p < np AND pattern[p] = '*' THEN
      (* take nothing yet, and remember where to come back to *)
      starP := p ;
      starI := i ;
      p := p + 1
    ELSE
      step := 0 ;
      IF p < np AND i < ns THEN step := Takes (pattern, p, s[i]) END ;
      IF step > 0 THEN
        p := p + step ;
        i := i + 1
      ELSIF p = np AND i = ns THEN
        RETURN TRUE
      ELSIF starP >= 0 AND starI < ns THEN
        (* the last star takes one character more *)
        starI := starI + 1 ;
        i := starI ;
        p := starP + 1
      ELSE
        RETURN FALSE
      END
    END
  END
END Match ;

(* ---- base64 ------------------------------------------------------- *)

PROCEDURE ToBase64 (RO b: SLICE OF BYTE) : STR =
VAR
  s, B64 : STR ;
  i, o, v, n : I64 ;
BEGIN
  (* a string, indexed: a table of 'A' .. '/' would be one of STRs *)
  B64 := 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/' ;
  n := (LEN (b) + 2) DIV 3 ;
  s := NEW (CHAR, 4 * n) ;
  o := 0 ;
  i := 0 ;
  WHILE i + 3 <= LEN (b) DO
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 + I64 (b[i + 2]) ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := B64[(v DIV 64) MOD 64] ;
    s[o + 3] := B64[v MOD 64] ;
    i := i + 3 ;
    o := o + 4
  END ;
  IF i + 1 = LEN (b) THEN
    v := I64 (b[i]) * 65536 ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := '=' ;
    s[o + 3] := '='
  ELSIF i + 2 = LEN (b) THEN
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 ;
    s[o] := B64[v DIV 262144] ;
    s[o + 1] := B64[(v DIV 4096) MOD 64] ;
    s[o + 2] := B64[(v DIV 64) MOD 64] ;
    s[o + 3] := '='
  END ;
  RETURN s
END ToBase64 ;

PROCEDURE ToBase64Url (RO b: SLICE OF BYTE) : STR =
VAR
  s, t : STR ;
  i, n : I64 ;
BEGIN
  s := ToBase64 (b) ;
  n := LEN (s) ;
  WHILE n > 0 AND s[n - 1] = '=' DO n := n - 1 END ;
  t := NEW (CHAR, n) ;
  FOR i := 0 TO n - 1 DO
    IF s[i] = '+' THEN t[i] := '-'
    ELSIF s[i] = '/' THEN t[i] := '_'
    ELSE t[i] := s[i]
    END
  END ;
  RETURN t
END ToBase64Url ;

PROCEDURE FromBase64Url (RO s: STR) : SLICE OF BYTE RAISES ValueRange =
VAR
  t : STR ;
  i, n, pad : I64 ;
BEGIN
  (* into the standard alphabet with its padding, then strictly *)
  n := LEN (s) ;
  IF n > 0 AND s[n - 1] = '=' THEN
    IF n MOD 4 # 0 THEN RAISE ValueRange END ;
    pad := 0
  ELSE
    IF n MOD 4 = 1 THEN RAISE ValueRange END ;
    pad := (4 - n MOD 4) MOD 4
  END ;
  t := NEW (CHAR, n + pad) ;
  FOR i := 0 TO n - 1 DO
    IF s[i] = '+' OR s[i] = '/' THEN RAISE ValueRange END ;
    IF s[i] = '-' THEN t[i] := '+'
    ELSIF s[i] = '_' THEN t[i] := '/'
    ELSE t[i] := s[i]
    END
  END ;
  FOR i := n TO n + pad - 1 DO t[i] := '=' END ;
  RETURN FromBase64 (t)
END FromBase64Url ;

PROCEDURE B64Val (c: CHAR) : I64 =
  (* the alphabet's value of c, -1 for a character outside it *)
BEGIN
  IF c >= 'A' AND c <= 'Z' THEN RETURN ORD (c) - 65 END ;
  IF c >= 'a' AND c <= 'z' THEN RETURN ORD (c) - 97 + 26 END ;
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 + 52 END ;
  IF c = '+' THEN RETURN 62 END ;
  IF c = '/' THEN RETURN 63 END ;
  RETURN -1
END B64Val ;

PROCEDURE FromBase64 (RO s: STR) : SLICE OF BYTE RAISES ValueRange =
VAR
  out : SLICE OF BYTE ;
  i, o, n, pad, v, k, a : I64 ;
BEGIN
  IF LEN (s) MOD 4 # 0 THEN RAISE ValueRange END ;
  pad := 0 ;
  IF LEN (s) >= 1 AND s[LEN (s) - 1] = '=' THEN pad := 1 END ;
  IF LEN (s) >= 2 AND s[LEN (s) - 2] = '=' AND pad = 1 THEN pad := 2 END ;
  n := LEN (s) DIV 4 * 3 - pad ;
  out := NEW (BYTE, n) ;
  o := 0 ;
  i := 0 ;
  WHILE i < LEN (s) DO
    v := 0 ;
    FOR k := 0 TO 3 DO
      IF s[i + k] = '=' THEN
        (* only in the last group, and only as its last one or two *)
        IF i + 4 < LEN (s) OR k < 4 - pad THEN RAISE ValueRange END ;
        a := 0
      ELSE
        a := B64Val (s[i + k]) ;
        IF a < 0 THEN RAISE ValueRange END
      END ;
      v := v * 64 + a
    END ;
    IF o < n THEN out[o] := BYTE (v DIV 65536) END ;
    IF o + 1 < n THEN out[o + 1] := BYTE ((v DIV 256) MOD 256) END ;
    IF o + 2 < n THEN out[o + 2] := BYTE (v MOD 256) END ;
    o := o + 3 ;
    i := i + 4
  END ;
  RETURN out
END FromBase64 ;

(* ---- UTF (docs/utf8-plan.md, U2): ordinary M9 over the builtins
   UTF (x), STR (u) and OCTETS (u) ---- *)

PROCEDURE BLen (RO u: UTF) : I64 =
BEGIN
  RETURN LEN (OCTETS (u))
END BLen ;

PROCEDURE BIs (RO u: UTF ; i: I64 ; c: CHAR) : BOOL =
BEGIN
  IF ORD (c) > 127 THEN RETURN FALSE END ;
  RETURN I64 (BAt (u, i)) = ORD (c)
END BIs ;

PROCEDURE BAt (RO u: UTF ; i: I64) : BYTE =
VAR o : SLICE OF BYTE ;
BEGIN
  o := OCTETS (u) ;
  RETURN o[i]
END BAt ;

PROCEDURE BChar (RO u: UTF ; i: I64) : CHAR =
VAR o : SLICE OF BYTE ;
BEGIN
  o := OCTETS (u) ;
  RETURN CHR (I64 (o[i]))
EXCEPT
| ValueRange : RAISE IndexError (i, 256)   (* an octet is a scalar: unreachable *)
END BChar ;

(* a continuation octet, 10xxxxxx *)
PROCEDURE IsCont (b: BYTE) : BOOL =
BEGIN
  RETURN I64 (b) >= 128 AND I64 (b) < 192
END IsCont ;

PROCEDURE CpCount (RO u: UTF) : I64 =
VAR o : SLICE OF BYTE ;
BEGIN
  (* bytes minus continuation bytes, counted eight at a time in the
     runtime (m9_utf_cpcount): the byte loop here ran at 650 MB/s on
     text where every fifth character is two bytes *)
  o := OCTETS (u) ;
  IF LEN (o) = 0 THEN RETURN 0 END ;
  RETURN I64 (CCpCount (ADR (o), C.SSizeT (LEN (o))))
END CpCount ;

(* a scalar a UTF holds: every decoded value is one, so CHR cannot fail
   here; the handler is the checker's due, not a path *)
PROCEDURE Scalar (v: I64) : CHAR =
BEGIN
  RETURN CHR (v)
EXCEPT
| ValueRange : RETURN 0FFFDC
END Scalar ;

PROCEDURE NextCp (RO u: UTF ; VAR at: I64) : CHAR =
VAR
  o : SLICE OF BYTE ;
  b0, v, k, j : I64 ;
BEGIN
  o := OCTETS (u) ;
  IF at < 0 OR at >= LEN (o) THEN RAISE IndexError (at, LEN (o)) END ;
  IF IsCont (o[at]) THEN RAISE IndexError (at, LEN (o)) END ;
  b0 := I64 (o[at]) ;
  IF b0 < 128 THEN
    at := at + 1 ;
    RETURN Scalar (b0)
  ELSIF b0 < 224 THEN
    v := b0 - 192 ; k := 1
  ELSIF b0 < 240 THEN
    v := b0 - 224 ; k := 2
  ELSE
    v := b0 - 240 ; k := 3
  END ;
  FOR j := 1 TO k DO v := v * 64 + (I64 (o[at + j]) - 128) END ;
  at := at + k + 1 ;
  RETURN Scalar (v)
END NextCp ;

PROCEDURE CpAt (RO u: UTF ; x: I64) : CHAR =
VAR
  at, i : I64 ;
  c : CHAR ;
BEGIN
  IF x < 0 THEN RAISE IndexError (x, CpCount (u)) END ;
  at := 0 ;
  i := 0 ;
  WHILE at < BLen (u) DO
    c := NextCp (u, at) ;
    IF i = x THEN RETURN c END ;
    i := i + 1
  END ;
  RAISE IndexError (x, i)
END CpAt ;

PROCEDURE ToUtf (RO s: STR) : UTF =
BEGIN
  RETURN UTF (s)
END ToUtf ;

PROCEDURE FromUtf (RO u: UTF) : STR =
BEGIN
  RETURN STR (u)
END FromUtf ;

PROCEDURE FromUtf8 (RO b: SLICE OF BYTE) : UTF RAISES ValueRange =
BEGIN
  RETURN UTF (b)
END FromUtf8 ;

PROCEDURE EqUtf (RO a: UTF ; RO b: UTF) : BOOL =
VAR
  x, y : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  x := OCTETS (a) ;
  y := OCTETS (b) ;
  IF LEN (x) # LEN (y) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (x) - 1 DO
    IF x[i] # y[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END EqUtf ;

PROCEDURE CompareUtf (RO a: UTF ; RO b: UTF) : I64 =
VAR
  x, y : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  x := OCTETS (a) ;
  y := OCTETS (b) ;
  n := LEN (x) ;
  IF LEN (y) < n THEN n := LEN (y) END ;
  FOR i := 0 TO n - 1 DO
    IF I64 (x[i]) < I64 (y[i]) THEN RETURN -1 END ;
    IF I64 (x[i]) > I64 (y[i]) THEN RETURN 1 END
  END ;
  IF LEN (x) < LEN (y) THEN RETURN -1 END ;
  IF LEN (x) > LEN (y) THEN RETURN 1 END ;
  RETURN 0
END CompareUtf ;

(* the class of c in the grapheme tables: Grapheme_Cluster_Break (the
   Gcb* codes) + 16 Indic_Conjunct_Break (the InCb* codes), 0 where the
   tables hold nothing *)
CONST
  GcbOther = 0 ; GcbCR = 1 ; GcbLF = 2 ; GcbControl = 3 ; GcbExtend = 4 ;
  GcbZWJ = 5 ; GcbRI = 6 ; GcbPrepend = 7 ; GcbSpacingMark = 8 ;
  GcbL = 9 ; GcbV = 10 ; GcbT = 11 ; GcbLV = 12 ; GcbLVT = 13 ;
  GcbExtPict = 14 ;
  InCbLinker = 1 ; InCbConsonant = 2 ; InCbExtend = 3 ;

PROCEDURE GrClass (c: CHAR) : I64 =
VAR lo, hi, mid, v : I64 ;
BEGIN
  v := ORD (c) ;
  lo := 0 ;
  hi := LEN (GcbLo) - 1 ;
  WHILE lo <= hi DO
    mid := (lo + hi) DIV 2 ;
    IF v < GcbLo[mid] THEN hi := mid - 1
    ELSIF v > GcbHi[mid] THEN lo := mid + 1
    ELSE RETURN GcbCls[mid]
    END
  END ;
  RETURN GcbOther
END GrClass ;

PROCEDURE IsCtl (g: I64) : BOOL =
BEGIN
  RETURN g = GcbControl OR g = GcbCR OR g = GcbLF
END IsCtl ;

(* GB3 to GB13 between a cluster's last code point (class p) and the
   next (class q); conj says GB9c's consonant-linker run is open, zwj
   that the cluster ends GB11's pictograph Extend* ZWJ, ri how many
   regional indicators end it *)
PROCEDURE Joins (p: I64 ; q: I64 ; conj: BOOL ; zwj: BOOL ; ri: I64) : BOOL =
VAR pg, qg : I64 ;
BEGIN
  pg := p MOD 16 ;
  qg := q MOD 16 ;
  IF pg = GcbCR AND qg = GcbLF THEN RETURN TRUE END ;                (* GB3 *)
  IF IsCtl (pg) OR IsCtl (qg) THEN RETURN FALSE END ;                (* GB4, GB5 *)
  IF pg = GcbL AND (qg = GcbL OR qg = GcbV OR qg = GcbLV OR qg = GcbLVT) THEN
    RETURN TRUE                                                     (* GB6 *)
  END ;
  IF (pg = GcbLV OR pg = GcbV) AND (qg = GcbV OR qg = GcbT) THEN RETURN TRUE END ;  (* GB7 *)
  IF (pg = GcbLVT OR pg = GcbT) AND qg = GcbT THEN RETURN TRUE END ;  (* GB8 *)
  IF qg = GcbExtend OR qg = GcbZWJ OR qg = GcbSpacingMark THEN RETURN TRUE END ;  (* GB9, GB9a *)
  IF pg = GcbPrepend THEN RETURN TRUE END ;                          (* GB9b *)
  IF conj AND q DIV 16 = InCbConsonant THEN RETURN TRUE END ;        (* GB9c *)
  IF zwj AND qg = GcbExtPict THEN RETURN TRUE END ;                  (* GB11 *)
  IF pg = GcbRI AND qg = GcbRI AND ri MOD 2 = 1 THEN RETURN TRUE END ;  (* GB12, GB13 *)
  RETURN FALSE                                                       (* GB999 *)
END Joins ;

PROCEDURE NextGr (RO u: UTF ; VAR at: I64) : UTF =
VAR
  start, next, ri, linked : I64 ;
  p, q : I64 ;
  pict, zwj : BOOL ;
BEGIN
  start := at ;
  p := GrClass (NextCp (u, at)) ;
  (* linked: 0 no consonant run, 1 a consonant and InCB Extend after
     it, 2 a Linker among them (GB9c's left side) *)
  IF p DIV 16 = InCbConsonant THEN linked := 1 ELSE linked := 0 END ;
  (* pict: the cluster so far ends ExtPict Extend*; zwj: ... ZWJ *)
  pict := p MOD 16 = GcbExtPict ;
  zwj := FALSE ;
  IF p MOD 16 = GcbRI THEN ri := 1 ELSE ri := 0 END ;
  WHILE at < BLen (u) DO
    next := at ;
    q := GrClass (NextCp (u, next)) ;
    IF NOT Joins (p, q, linked = 2, zwj, ri) THEN
      RETURN SLICE (u, start, at - start)
    END ;
    IF q DIV 16 = InCbConsonant THEN linked := 1
    ELSIF linked > 0 AND q DIV 16 = InCbLinker THEN linked := 2
    ELSIF linked > 0 AND q DIV 16 = InCbExtend THEN (* the run goes on *)
    ELSE linked := 0
    END ;
    zwj := pict AND q MOD 16 = GcbZWJ ;
    IF q MOD 16 = GcbExtPict THEN pict := TRUE
    ELSIF q MOD 16 # GcbExtend THEN pict := FALSE
    END ;
    IF q MOD 16 = GcbRI THEN ri := ri + 1 ELSE ri := 0 END ;
    p := q ;
    at := next
  END ;
  RETURN SLICE (u, start, at - start)
END NextGr ;

PROCEDURE GrCount (RO u: UTF) : I64 =
VAR at, n : I64 ; g : UTF ;
BEGIN
  at := 0 ;
  n := 0 ;
  WHILE at < BLen (u) DO
    g := NextGr (u, at) ;
    n := n + 1
  END ;
  RETURN n
END GrCount ;

PROCEDURE GrAt (RO u: UTF ; x: I64) : UTF =
VAR at, i : I64 ; g : UTF ;
BEGIN
  IF x < 0 THEN RAISE IndexError (x, GrCount (u)) END ;
  at := 0 ;
  i := 0 ;
  WHILE at < BLen (u) DO
    g := NextGr (u, at) ;
    IF i = x THEN RETURN g END ;
    i := i + 1
  END ;
  RAISE IndexError (x, i)
END GrAt ;

(* ---- the UTF twins: octet work over OCTETS (u) ---- *)

(* the first offset >= from where n occurs in h, or -1; an empty n at
   from (Find's convention) *)
PROCEDURE OctFind (RO h: SLICE OF BYTE ; RO n: SLICE OF BYTE ; from: I64) : I64 =
BEGIN
  (* the C library's memmem through the runtime (m9_utf_find), a
     portable loop where there is none; the double loop that stood here
     ran at 1,500 MB/s on the M4 *)
  IF LEN (n) = 0 THEN RETURN from END ;
  IF from < 0 OR from + LEN (n) > LEN (h) THEN RETURN -1 END ;
  RETURN I64 (CFind (ADR (h), C.SSizeT (LEN (h)), ADR (n), C.SSizeT (LEN (n)), C.SSizeT (from)))
END OctFind ;

(* c as a UTF *)
PROCEDURE CharUtf (c: CHAR) : UTF =
VAR one : STR ;
BEGIN
  one := '' + c ;
  RETURN UTF (one)
END CharUtf ;

PROCEDURE FindUtf (RO hay: UTF ; RO needle: UTF) : I64 =
BEGIN
  RETURN OctFind (OCTETS (hay), OCTETS (needle), 0)
END FindUtf ;

PROCEDURE FindCharUtf (RO s: UTF ; c: CHAR) : I64 =
BEGIN
  RETURN OctFind (OCTETS (s), OCTETS (CharUtf (c)), 0)
END FindCharUtf ;

PROCEDURE LastCharUtf (RO s: UTF ; c: CHAR) : I64 =
VAR at, last : I64 ; cu : UTF ;
BEGIN
  cu := CharUtf (c) ;
  last := -1 ;
  at := OctFind (OCTETS (s), OCTETS (cu), 0) ;
  WHILE at >= 0 DO
    last := at ;
    at := OctFind (OCTETS (s), OCTETS (cu), at + 1)
  END ;
  RETURN last
END LastCharUtf ;

PROCEDURE ContainsUtf (RO hay: UTF ; RO needle: UTF) : BOOL =
BEGIN
  RETURN FindUtf (hay, needle) >= 0
END ContainsUtf ;

PROCEDURE StartsWithUtf (RO s: UTF ; RO prefix: UTF) : BOOL =
BEGIN
  IF BLen (prefix) > BLen (s) THEN RETURN FALSE END ;
  RETURN EqUtf (SLICE (s, 0, BLen (prefix)), prefix)
EXCEPT
| IndexError : RETURN FALSE
END StartsWithUtf ;

PROCEDURE EndsWithUtf (RO s: UTF ; RO suffix: UTF) : BOOL =
BEGIN
  IF BLen (suffix) > BLen (s) THEN RETURN FALSE END ;
  RETURN EqUtf (SLICE (s, BLen (s) - BLen (suffix), BLen (suffix)), suffix)
EXCEPT
| IndexError : RETURN FALSE
END EndsWithUtf ;

PROCEDURE CountCharUtf (RO s: UTF ; c: CHAR) : I64 =
VAR at, n : I64 ; cu : UTF ;
BEGIN
  cu := CharUtf (c) ;
  n := 0 ;
  at := OctFind (OCTETS (s), OCTETS (cu), 0) ;
  WHILE at >= 0 DO
    n := n + 1 ;
    at := OctFind (OCTETS (s), OCTETS (cu), at + BLen (cu))
  END ;
  RETURN n
END CountCharUtf ;

(* blanks, tabs, CR and LF, as Trim's -- all ASCII, so a trimmed end is
   a character boundary *)
PROCEDURE OctBlank (b: BYTE) : BOOL =
BEGIN
  RETURN I64 (b) = 32 OR I64 (b) = 9 OR I64 (b) = 13 OR I64 (b) = 10
END OctBlank ;

PROCEDURE TrimLeftUtf (RO s: UTF) : UTF =
VAR o : SLICE OF BYTE ; i : I64 ;
BEGIN
  o := OCTETS (s) ;
  i := 0 ;
  WHILE i < LEN (o) AND OctBlank (o[i]) DO i := i + 1 END ;
  RETURN SLICE (s, i, LEN (o) - i)
EXCEPT
| IndexError : RETURN s
END TrimLeftUtf ;

PROCEDURE TrimRightUtf (RO s: UTF) : UTF =
VAR o : SLICE OF BYTE ; n : I64 ;
BEGIN
  o := OCTETS (s) ;
  n := LEN (o) ;
  WHILE n > 0 AND OctBlank (o[n - 1]) DO n := n - 1 END ;
  RETURN SLICE (s, 0, n)
EXCEPT
| IndexError : RETURN s
END TrimRightUtf ;

PROCEDURE TrimUtf (RO s: UTF) : UTF =
BEGIN
  RETURN TrimRightUtf (TrimLeftUtf (s))
END TrimUtf ;

PROCEDURE SplitUtf (RO s: UTF ; sep: CHAR) : SLICE OF UTF =
VAR
  parts : SLICE OF UTF ;
  cu : UTF ;
  at, start, n, w : I64 ;
BEGIN
  cu := CharUtf (sep) ;
  w := BLen (cu) ;
  parts := NEW (UTF, CountCharUtf (s, sep) + 1) ;
  n := 0 ;
  start := 0 ;
  at := OctFind (OCTETS (s), OCTETS (cu), 0) ;
  WHILE at >= 0 DO
    parts[n] := SLICE (s, start, at - start) ;
    n := n + 1 ;
    start := at + w ;
    at := OctFind (OCTETS (s), OCTETS (cu), start)
  END ;
  parts[n] := SLICE (s, start, BLen (s) - start) ;
  RETURN parts
EXCEPT
| IndexError : RETURN NEW (UTF, 0)
END SplitUtf ;

PROCEDURE FieldsUtf (RO s: UTF ; sep: CHAR) : SLICE OF UTF =
VAR
  all, parts : SLICE OF UTF ;
  i, n : I64 ;
BEGIN
  all := SplitUtf (s, sep) ;
  n := 0 ;
  FOR i := 0 TO LEN (all) - 1 DO
    IF BLen (all[i]) > 0 THEN n := n + 1 END
  END ;
  parts := NEW (UTF, n) ;
  n := 0 ;
  FOR i := 0 TO LEN (all) - 1 DO
    IF BLen (all[i]) > 0 THEN parts[n] := all[i] ; n := n + 1 END
  END ;
  RETURN parts
END FieldsUtf ;

(* the octets of parts and seps, sized once and COPYed: a UTF + copies
   every time, so a join by + would be quadratic *)
PROCEDURE JoinUtf (RO parts: SLICE OF UTF ; RO sep: UTF) : UTF =
VAR
  b : SLICE OF BYTE ;
  i, n, at : I64 ;
BEGIN
  n := 0 ;
  FOR i := 0 TO LEN (parts) - 1 DO
    IF i > 0 THEN n := n + BLen (sep) END ;
    n := n + BLen (parts[i])
  END ;
  b := NEW (BYTE, n) ;
  at := 0 ;
  FOR i := 0 TO LEN (parts) - 1 DO
    IF i > 0 THEN
      COPY (SLICE (b, at, BLen (sep)), OCTETS (sep)) ;
      at := at + BLen (sep)
    END ;
    COPY (SLICE (b, at, BLen (parts[i])), OCTETS (parts[i])) ;
    at := at + BLen (parts[i])
  END ;
  RETURN UTF (b)
EXCEPT
| ValueRange : RETURN ''
END JoinUtf ;

PROCEDURE ReplaceUtf (RO s: UTF ; RO old: UTF ; RO by: UTF) : UTF =
VAR
  b : SLICE OF BYTE ;
  at, from, n, k : I64 ;
BEGIN
  IF BLen (old) = 0 THEN RETURN UTF (s) END ;
  k := 0 ;
  at := FindUtf (s, old) ;
  WHILE at >= 0 DO
    k := k + 1 ;
    at := OctFind (OCTETS (s), OCTETS (old), at + BLen (old))
  END ;
  b := NEW (BYTE, BLen (s) + k * (BLen (by) - BLen (old))) ;
  n := 0 ;
  from := 0 ;
  at := FindUtf (s, old) ;
  WHILE at >= 0 DO
    COPY (SLICE (b, n, at - from), SLICE (OCTETS (s), from, at - from)) ;
    n := n + at - from ;
    COPY (SLICE (b, n, BLen (by)), OCTETS (by)) ;
    n := n + BLen (by) ;
    from := at + BLen (old) ;
    at := OctFind (OCTETS (s), OCTETS (old), from)
  END ;
  COPY (SLICE (b, n, BLen (s) - from), SLICE (OCTETS (s), from, BLen (s) - from)) ;
  RETURN UTF (b)
EXCEPT
| ValueRange : RETURN UTF (s)
END ReplaceUtf ;

PROCEDURE LowerUtf (RO s: UTF) : UTF =
  (* Lower over the characters of a UTF, built by + (which grows in
     place); it had decoded and called Lower, which under the rehearsed
     switch is itself (2026-10-24) *)
VAR
  r : UTF ;
  k, j : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR c IN s DO
    IF c >= 'A' AND c <= 'Z' THEN
      r := r + CpAt (LowerAlpha, ORD (c) - 65)
    ELSIF ORD (c) < 128 THEN
      r := r + c
    ELSE
      k := CaseFind (LowFrom, ORD (c)) ;
      IF k < 0 THEN
        r := r + c
      ELSE
        FOR j := LowAt[k] TO LowAt[k + 1] - 1 DO r := r + CpAt (LowTo, j) END
      END
    END
  END ;
  RETURN r
END LowerUtf ;

PROCEDURE UpperUtf (RO s: UTF) : UTF =
VAR
  r : UTF ;
  k, j : I64 ;
  c : CHAR ;
BEGIN
  r := '' ;
  FOR c IN s DO
    IF c >= 'a' AND c <= 'z' THEN
      r := r + CpAt (UpperAlpha, ORD (c) - 97)
    ELSIF ORD (c) < 128 THEN
      r := r + c
    ELSE
      k := CaseFind (UpFrom, ORD (c)) ;
      IF k < 0 THEN
        r := r + c
      ELSE
        FOR j := UpAt[k] TO UpAt[k + 1] - 1 DO r := r + CpAt (UpTo, j) END
      END
    END
  END ;
  RETURN r
END UpperUtf ;

PROCEDURE IndexOfUtf (RO among: SLICE OF UTF ; RO s: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (among) - 1 DO
    IF EqUtf (among[i], s) THEN RETURN i END
  END ;
  RETURN -1
END IndexOfUtf ;

PROCEDURE OneOfUtf (RO s: UTF ; RO among: SLICE OF UTF) : BOOL =
BEGIN
  RETURN IndexOfUtf (among, s) >= 0
END OneOfUtf ;

PROCEDURE KeepUtf (VAR pool: POOL ; RO s: UTF) : UTF =
BEGIN
  RETURN UTF (pool, s)
END KeepUtf ;

PROCEDURE CatUtf (VAR pool: POOL ; RO a: UTF ; RO b: UTF) : UTF =
BEGIN
  RETURN UTF (pool, a + b)
END CatUtf ;

(* ---- the UTF twins of Match and AllIn (stage 4a, 2026-10-24): the
   same automaton over byte offsets, every character read by NextCp so
   that `?' and a bracket take a whole code point *)

PROCEDURE Oc (RO u: UTF ; i: I64) : I64 =
  (* octet i of u as a number *)
BEGIN
  RETURN I64 (BAt (u, i))
END Oc ;

PROCEDURE SetEndUtf (RO pat: UTF ; i: I64) : I64 =
  (* the offset of the ] closing the [ at i, or -1; the three ASCII
     octets read never occur inside a multi-byte sequence *)
VAR j, n : I64 ;
BEGIN
  n := BLen (pat) ;
  j := i + 1 ;
  IF j < n AND Oc (pat, j) = 33 THEN j := j + 1 END ;     (* ! *)
  IF j < n AND Oc (pat, j) = 93 THEN j := j + 1 END ;     (* ] *)
  WHILE j < n AND Oc (pat, j) # 93 DO j := j + 1 END ;
  IF j >= n THEN RETURN -1 END ;
  RETURN j
END SetEndUtf ;

PROCEDURE InSetUtf (RO pat: UTF ; a, b: I64 ; c: CHAR) : BOOL =
  (* is c in the bracket's members between offsets a and b: a range
     x-y compares code points; a - at the end is a member *)
VAR
  q, q2, q3 : I64 ;
  x, y : CHAR ;
BEGIN
  q := a ;
  WHILE q < b DO
    q2 := q ;
    x := NextCp (pat, q2) ;
    IF q2 + 1 < b AND Oc (pat, q2) = 45 THEN                (* - *)
      q3 := q2 + 1 ;
      y := NextCp (pat, q3) ;
      IF x <= c AND c <= y THEN RETURN TRUE END ;
      q := q3
    ELSE
      IF x = c THEN RETURN TRUE END ;
      q := q2
    END
  END ;
  RETURN FALSE
END InSetUtf ;

PROCEDURE TakesUtf (RO pat: UTF ; p: I64 ; c: CHAR) : I64 =
  (* how many OCTETS of the pattern at p the character c satisfies:
     0 when it does not *)
VAR
  e, a, q : I64 ;
  negated : BOOL ;
  pc : CHAR ;
BEGIN
  IF Oc (pat, p) = 63 THEN RETURN 1 END ;                  (* ? *)
  IF Oc (pat, p) = 91 THEN                                 (* [ *)
    e := SetEndUtf (pat, p) ;
    IF e >= 0 THEN
      a := p + 1 ;
      negated := Oc (pat, a) = 33 ;
      IF negated THEN a := a + 1 END ;
      IF InSetUtf (pat, a, e, c) # negated THEN RETURN e + 1 - p END ;
      RETURN 0
    END
  END ;
  q := p ;
  pc := NextCp (pat, q) ;
  IF pc = c THEN RETURN q - p END ;
  RETURN 0
END TakesUtf ;

PROCEDURE MatchUtf (RO pattern: UTF ; RO s: UTF) : BOOL =
VAR
  p, i, i2, np, ns, step : I64 ;
  starP, starI : I64 ;         (* the last star, and what it has taken *)
  c : CHAR ;
BEGIN
  np := BLen (pattern) ;
  ns := BLen (s) ;
  p := 0 ;
  i := 0 ;
  starP := -1 ;
  starI := 0 ;
  LOOP
    IF p < np AND Oc (pattern, p) = 42 THEN                (* * *)
      starP := p ;
      starI := i ;
      p := p + 1
    ELSE
      step := 0 ;
      i2 := i ;
      IF p < np AND i < ns THEN
        c := NextCp (s, i2) ;
        step := TakesUtf (pattern, p, c)
      END ;
      IF step > 0 THEN
        p := p + step ;
        i := i2
      ELSIF p = np AND i = ns THEN
        RETURN TRUE
      ELSIF starP >= 0 AND starI < ns THEN
        (* the last star takes one character more *)
        c := NextCp (s, starI) ;
        i := starI ;
        p := starP + 1
      ELSE
        RETURN FALSE
      END
    END
  END
END MatchUtf ;

PROCEDURE AllInUtf (RO s: UTF ; RO set: UTF) : BOOL =
VAR
  a : I64 ;
  neg : BOOL ;
  c : CHAR ;
BEGIN
  IF BLen (s) = 0 THEN RETURN FALSE END ;
  a := 0 ;
  neg := BLen (set) > 1 AND Oc (set, 0) = 33 ;             (* ! *)
  IF neg THEN a := 1 END ;
  FOR c IN s DO
    IF InSetUtf (set, a, BLen (set), c) = neg THEN RETURN FALSE END
  END ;
  RETURN TRUE
END AllInUtf ;

PROCEDURE AllDigitsUtf (RO s: UTF) : BOOL =
BEGIN
  RETURN AllInUtf (s, '0-9')
END AllDigitsUtf ;

PROCEDURE AllLowerUtf (RO s: UTF) : BOOL =
BEGIN
  RETURN AllInUtf (s, 'a-z')
END AllLowerUtf ;

PROCEDURE AllUpperUtf (RO s: UTF) : BOOL =
BEGIN
  RETURN AllInUtf (s, 'A-Z')
END AllUpperUtf ;

PROCEDURE AllAlnumUtf (RO s: UTF) : BOOL =
BEGIN
  RETURN AllInUtf (s, 'a-zA-Z0-9')
END AllAlnumUtf ;

(* ---- the base64 twins: the text side built as octets and validated
   once by UTF (o) -- it is ASCII by construction *)

PROCEDURE B64ValB (b: I64) : I64 =
  (* the value of a base64 alphabet octet, -1 outside it *)
BEGIN
  IF b >= 65 AND b <= 90 THEN RETURN b - 65 END ;          (* A-Z *)
  IF b >= 97 AND b <= 122 THEN RETURN b - 71 END ;         (* a-z *)
  IF b >= 48 AND b <= 57 THEN RETURN b + 4 END ;           (* 0-9 *)
  IF b = 43 THEN RETURN 62 END ;                           (* + *)
  IF b = 47 THEN RETURN 63 END ;                           (* / *)
  RETURN -1
END B64ValB ;

PROCEDURE ToBase64Utf (RO b: SLICE OF BYTE) : UTF =
VAR
  alpha, pad : UTF ;
  a, eq, o : SLICE OF BYTE ;
  i, p, v, n : I64 ;
BEGIN
  alpha := 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/' ;
  pad := '=' ;
  a := OCTETS (alpha) ;
  eq := OCTETS (pad) ;
  n := (LEN (b) + 2) DIV 3 ;
  o := NEW (BYTE, 4 * n) ;
  p := 0 ;
  i := 0 ;
  WHILE i + 3 <= LEN (b) DO
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 + I64 (b[i + 2]) ;
    o[p] := a[v DIV 262144] ;
    o[p + 1] := a[(v DIV 4096) MOD 64] ;
    o[p + 2] := a[(v DIV 64) MOD 64] ;
    o[p + 3] := a[v MOD 64] ;
    i := i + 3 ;
    p := p + 4
  END ;
  IF i + 1 = LEN (b) THEN
    v := I64 (b[i]) * 65536 ;
    o[p] := a[v DIV 262144] ;
    o[p + 1] := a[(v DIV 4096) MOD 64] ;
    o[p + 2] := eq[0] ;
    o[p + 3] := eq[0]
  ELSIF i + 2 = LEN (b) THEN
    v := I64 (b[i]) * 65536 + I64 (b[i + 1]) * 256 ;
    o[p] := a[v DIV 262144] ;
    o[p + 1] := a[(v DIV 4096) MOD 64] ;
    o[p + 2] := a[(v DIV 64) MOD 64] ;
    o[p + 3] := eq[0]
  END ;
  RETURN UTF (o)
EXCEPT
| ValueRange :
    (* o is ASCII by construction; the validation cannot refuse it,
       and if it ever did the fault is this procedure's, not the
       caller's -- a trap, as DynUtf.View's is *)
    RAISE IndexError
END ToBase64Utf ;

PROCEDURE ToBase64UrlUtf (RO b: SLICE OF BYTE) : UTF =
VAR
  s, marks : UTF ;
  so, m, t : SLICE OF BYTE ;
  i, n : I64 ;
BEGIN
  marks := '-_=' ;
  m := OCTETS (marks) ;
  s := ToBase64Utf (b) ;
  so := OCTETS (s) ;
  n := LEN (so) ;
  WHILE n > 0 AND I64 (so[n - 1]) = 61 DO n := n - 1 END ;   (* = *)
  t := NEW (BYTE, n) ;
  FOR i := 0 TO n - 1 DO
    IF I64 (so[i]) = 43 THEN t[i] := m[0]                  (* + to - *)
    ELSIF I64 (so[i]) = 47 THEN t[i] := m[1]               (* / to _ *)
    ELSE t[i] := so[i]
    END
  END ;
  RETURN UTF (t)
EXCEPT
| ValueRange :
    RAISE IndexError                     (* as in ToBase64Utf: ASCII *)
END ToBase64UrlUtf ;

PROCEDURE FromBase64Oct (RO s: SLICE OF BYTE) : SLICE OF BYTE RAISES ValueRange =
  (* FromBase64 over the text's octets *)
VAR
  out : SLICE OF BYTE ;
  i, o, n, pad, v, k, a : I64 ;
BEGIN
  IF LEN (s) MOD 4 # 0 THEN RAISE ValueRange END ;
  pad := 0 ;
  IF LEN (s) >= 1 AND I64 (s[LEN (s) - 1]) = 61 THEN pad := 1 END ;
  IF LEN (s) >= 2 AND I64 (s[LEN (s) - 2]) = 61 AND pad = 1 THEN pad := 2 END ;
  n := LEN (s) DIV 4 * 3 - pad ;
  out := NEW (BYTE, n) ;
  o := 0 ;
  i := 0 ;
  WHILE i < LEN (s) DO
    v := 0 ;
    FOR k := 0 TO 3 DO
      IF I64 (s[i + k]) = 61 THEN
        (* only in the last group, and only as its last one or two *)
        IF i + 4 < LEN (s) OR k < 4 - pad THEN RAISE ValueRange END ;
        a := 0
      ELSE
        a := B64ValB (I64 (s[i + k])) ;
        IF a < 0 THEN RAISE ValueRange END
      END ;
      v := v * 64 + a
    END ;
    IF o < n THEN out[o] := BYTE (v DIV 65536) END ;
    IF o + 1 < n THEN out[o + 1] := BYTE ((v DIV 256) MOD 256) END ;
    IF o + 2 < n THEN out[o + 2] := BYTE (v MOD 256) END ;
    o := o + 3 ;
    i := i + 4
  END ;
  RETURN out
END FromBase64Oct ;

PROCEDURE FromBase64Utf (RO s: UTF) : SLICE OF BYTE RAISES ValueRange =
BEGIN
  RETURN FromBase64Oct (OCTETS (s))
END FromBase64Utf ;

PROCEDURE FromBase64UrlUtf (RO s: UTF) : SLICE OF BYTE RAISES ValueRange =
VAR
  marks : UTF ;
  so, m, t : SLICE OF BYTE ;
  i, n, pad : I64 ;
BEGIN
  (* into the standard alphabet with its padding, then strictly *)
  marks := '+/=' ;
  m := OCTETS (marks) ;
  so := OCTETS (s) ;
  n := LEN (so) ;
  IF n > 0 AND I64 (so[n - 1]) = 61 THEN
    IF n MOD 4 # 0 THEN RAISE ValueRange END ;
    pad := 0
  ELSE
    IF n MOD 4 = 1 THEN RAISE ValueRange END ;
    pad := (4 - n MOD 4) MOD 4
  END ;
  t := NEW (BYTE, n + pad) ;
  FOR i := 0 TO n - 1 DO
    IF I64 (so[i]) = 43 OR I64 (so[i]) = 47 THEN RAISE ValueRange END ;
    IF I64 (so[i]) = 45 THEN t[i] := m[0]                  (* - to + *)
    ELSIF I64 (so[i]) = 95 THEN t[i] := m[1]               (* _ to / *)
    ELSE t[i] := so[i]
    END
  END ;
  FOR i := n TO n + pad - 1 DO t[i] := m[2] END ;
  RETURN FromBase64Oct (t)
END FromBase64UrlUtf ;

END Text.


UNSAFE DEFINITION MODULE FOR "C" ctext ;

(* runtime/m9rt.c (m9rt.h): a UTF's code points counted eight bytes at
   a time, and memmem over its bytes.  No LINK: the runtime's.
   REENTRANT: pure functions of their arguments. *)

PROCEDURE CCpCount = "m9_utf_cpcount_p" (p: C.ConstPtr ; n: C.SSizeT) : C.SSizeT
  [REENTRANT] ;
PROCEDURE CFind = "m9_utf_find" (h: C.ConstPtr ; hn: C.SSizeT ;
                                 n: C.ConstPtr ; nn: C.SSizeT ;
                                 from: C.SSizeT) : C.SSizeT [REENTRANT] ;

END ctext.
