MODULE M9c ;

(* The compiler, as a program.

     m9c FILE.m9 [DEP.m9 ...]

   reads FILE.m9, reads each dependency's definitions, and writes
   NAME.h and NAME.c beside the working directory.  Lex, Parse, Ast,
   Print and Gen are all M9; this module is the last piece that made
   them a tool rather than a library, and it is itself compiled by
   the toolchain it completes.

   One module per invocation, deliberately: Gen is STATEFUL and holds
   exactly one module's registries, so a batch mode would need either
   a reset path nobody has tested or a second instance the language
   has no syntax for.  A process is the reset.

   It CHECKS before it generates.  A compiler that translates what it
   knows to be wrong is a translator, and m9c was one until Sem.m9
   existed to connect: a program with a semantic error now produces
   diagnostics on stderr and no output files, and exits nonzero.

   Dependencies are loaded for two different consumers, and they want
   two different closures.  The checker wants the TRANSITIVE one: a
   cross-module name that has not been loaded is indistinguishable
   from one that does not exist, however far away it lives.  The
   generator wants only the DIRECT imports, because what it does with
   a registered unit is emit an #include, and a header that includes
   its dependencies' dependencies describes somebody else's
   interface.  Conflating the two put Lex, Print and Text into M9c.h
   the first time imports were resolved automatically.              *)

IMPORT Io ;
IMPORT Text ;
IMPORT Ast ;
IMPORT Parse ;
IMPORT Gen ;
IMPORT Sem ;
IMPORT Doc ;
IMPORT Review ;
IMPORT Lex ;
IMPORT DynUtf ;
IMPORT System ;

VAR
  pool : POOL ;
  selfTime : I64 ;          (* Older: this binary's mtime, read once *)
  failed : BOOL ;
  (* THE COMMAND BEING COMPOSED, AS A LIST OF WORDS -- never as one
     string.  Until 2026-09-06 m9c composed a shell line for Io.Run
     (system ()), quoting every path, and had to REFUSE a name with a
     quote in it because no quoting rule covers every shell.  Now the
     words go to System.Exec as they are: no shell, nothing quoted,
     nothing to refuse -- and the same code runs on Windows, where
     the shell is a different program with different rules.  What -v
     prints is these words joined by spaces, which is a display and
     not what runs. *)
  words  : SLICE OF UTF ;
  nwords : I64 ;

  (* what the command line asked for *)
  doCompile : BOOL ;      (* -c : hand the C to a C compiler   *)
  exe       : UTF ;       (* -o : link, and call the result this *)
  doLink    : BOOL ;
  keepC     : BOOL ;      (* --keep-c : leave the C behind      *)
  verbose   : BOOL ;      (* -v : show the command handed to cc  *)
  doVersion : BOOL ;      (* --version, or a bare -v with no file *)
  utfStr    : BOOL ;      (* --utf-str : STR is the UTF type, the switch rehearsed *)
  noUnsafe  : BOOL ;      (* --no-unsafe : refuse UNSAFE and
                             FOR "C" units outside the trusted
                             library directories *)
  nunsafe   : I64 ;       (* how many such units were refused *)
  ccFrom    : I64 ;       (* first argument after --, or 0      *)
  (* --ar and --so: the closure as a LIBRARY rather than a program.
     Same closure, same objects, a different last step -- ar for the
     archive, cc -shared for the object.

     WHEN --pic IS ACTUALLY NEEDED, measured rather than assumed.  It
     was put here believing every member of a shared object has to be
     built -fPIC, and that is only half true: m9c compiles with -flto,
     so a `-c` object is LTO IR and the code generation happens at
     LINK time -- where -shared asks for position-independent code and
     gets it.  A closure built with plain `m9c -c` therefore goes into
     a .so and works.  Put anything after -- and LTO goes with the
     rest of the defaults; then the object really is machine code, and
     ld refuses it with
       relocation R_X86_64_PC32 against `m9_exc_IndexError'
       can not be used when making a shared object; recompile with -fPIC
     Both halves are checked in m9c.sh, because the working case is
     the one an assumption would have got wrong. *)
  lib       : UTF ;       (* --ar / --so : the library to build  *)
  doAr      : BOOL ;
  doSo      : BOOL ;
  doPic     : BOOL ;      (* --pic : compile position-independent *)
  doCheck   : BOOL ;      (* --check : check, write NOTHING.  The
                             language server's flag: an editor wants
                             the diagnostics without .h/.c appearing
                             beside the file it is editing -- the
                             generated-header-shadows trap, armed by
                             every keystroke *)
  doReview  : BOOL ;      (* --review : --check, and then the page of
                             what was proved and what a person
                             decided, on stdout.  Only for a program
                             the checker and the generator accept: a
                             review of what does not exist is the
                             same lie --doc refuses to tell *)
  doDoc     : BOOL ;      (* --doc : write NAME.md and nothing else *)
  doJson    : BOOL ;      (* --json : with --doc, NAME.json as well *)
  debug     : BOOL ;      (* -g : debug info, and keep the C it names *)
  doMake    : BOOL ;      (* --make : rebuild stale dependencies first *)
  doRun     : BOOL ;      (* --run FILE.m9 ARG... : build into the
                             cache, then BECOME the program *)
  runAt     : I64 ;       (* argv index of FILE.m9 after --run; its
                             arguments are everything after it *)
  outDir    : UTF ;       (* --out-dir : where NAME.h and NAME.c go *)
  doCell    : BOOL ;      (* --cell FILE.m9 : build for the notebook
                             session (runtime/m9session.c) and print
                             what to load; docs/notebook-state-plan.md *)
  cellProgram : BOOL ;    (* the cell is a MODULE (a program), not a
                             library module (a state cell) *)
  cellPath  : UTF ;       (* the cell's own shared object *)
  pfxSpec   : SLICE OF UTF ;  (* --prefix MOD=NAME: a state cell's
                                 generation (Gen.SetPrefix) *)
  npfxSpec  : I64 ;
  doShow    : BOOL ;      (* --show: FILE holds an EXPRESSION, shown by
                             the NbShow procedure for its type;
                             docs/kernel-show-plan.md *)
  doTypeOf  : BOOL ;      (* --type-of: what --show asks a child m9c --
                             the expression's type, on stdout *)
  lineShift : I64 ;       (* lines the wrapper puts before the
                             expression; taken off every diagnostic *)
  shiftPath : UTF ;       (* the file whose parse errors it applies to *)

  (* --run's cache.  Every module's source is hashed as it is parsed,
     so the key of an object is what it was compiled FROM -- its own
     text and the text of everything it imports, however far down --
     and never a modification time.  See RunKeys. *)
  srcNames, srcHashes : SLICE OF UTF ;
  nsrc      : I64 ;
  keys      : SLICE OF UTF ;  (* parallel to order[]: each module's key *)
  ident     : UTF ;       (* this compiler, its C compiler and runtime *)
  cacheRoot : UTF ;
  work      : UTF ;       (* cacheRoot/tmp/PID: this run's scratch *)
  binPath   : UTF ;       (* cacheRoot/bin/NAME-KEY *)

  (* where to look for an imported module's source *)
  dirs   : SLICE OF UTF ;
  trusts : SLICE OF BOOL ;  (* dirs[i] came from $M9LIBRARY or the
                               installed library: its units may be
                               UNSAFE / FOR "C" under --no-unsafe *)
  ndirs  : I64 ;
  (* WHERE THIS COMPILER IS: the directory above the executable's --
     /usr for /usr/bin/m9c, the unpacked zip for bin\m9c.exe, the
     source tree for out/m9c -- which is what the installed places
     are RELATIVE to (see Locate).  Empty when the platform cannot
     say, and then the constants below are all there is. *)
  prefix  : UTF ;
  windows : BOOL ;   (* System.Os: ';' separates $M9LIBRARY, and the
                        C compiler is gcc, bundled or on PATH *)
  macos   : BOOL ;   (* System.Os: cc is Apple clang and the linker
                        is ld64, neither of which takes gcc's or GNU
                        ld's words, and OpenSSL is not the system's
                        (see OsslDir) *)
  (* module names already loaded, so a diamond is loaded once and a
     cycle terminates rather than recurring *)
  loaded  : SLICE OF UTF ;
  nloaded : I64 ;
  (* THE BUILD ORDER, WHICH IS NOT THE LOAD ORDER.  loaded[] is
     filled PRE-order -- a name is marked before its own imports are
     walked, which is what makes a cycle terminate -- and reversing
     pre-order is a topological sort for a TREE and not for a DAG:
     with A importing B and C, and C importing B, pre-order is
     A, B, C and the reverse builds C before the B it needs.  Kind is
     imported by nearly everything, so it was marked first and came
     LAST, and `m9c --make -c Sampler.m9` from an empty directory
     failed with nine `Kind.h: No such file` and then SUCCEEDED when
     run again (measured 2026-08-25).  order[] is appended POST-order
     instead -- a module is added once everything it imports is in --
     and MakeAll walks it forward. *)
  order  : SLICE OF UTF ;
  norder : I64 ;
  (* the import graph, recorded as it is walked: edgeFrom[i] imports
     edgeTo[i].  The ORDER is computed from this afterwards, by a
     post-order walk, because the order things are LOADED in cannot
     answer it -- see BuildOrder. *)
  edgeFrom, edgeTo : SLICE OF UTF ;
  nedge : I64 ;
  visiting : SLICE OF UTF ;
  (* the import graph has a cycle -- two definitions importing each
     other, allowed (Alex, 2026-10-22): every header of the build is
     then written before any module of it is compiled *)
  importCycle : BOOL ;
  nvisit : I64 ;
  (* roots of the deps that WERE named, so the gaps they leave can be
     filled once the named ones are all in, in the order given *)
  depRoots : SLICE OF Ast.Kid ;
  mainRoot : Ast.Kid ;        (* the file on the command line: its own FOR "C"
                                 units name what they link too (2026-10-10) *)
  depNames : SLICE OF UTF ;   (* parallel: whose root that is, so
                                 FillGaps can order it once its own
                                 subtree has been walked *)
  depFar   : SLICE OF BOOL ;  (* parallel: reached only through another
                                 module (LoadIndirect), so its LINK
                                 words go on the line only when their
                                 libraries are there (LinkWords) *)
  ndeps    : I64 ;
  nmissing : I64 ;
  readNotText : BOOL ;        (* TryRead's last file was there, and not UTF-8 *)
  (* the module being compiled: its own object is not a dependency *)
  modName  : UTF ;

CONST
  (* Where a package puts the standard modules, the last resort when
     this compiler cannot say where it is itself (Locate).  A
     constant rather than a build-time substitution because M9 has no
     -D and inventing one for a single string would be a language
     feature bought with a packaging problem.  A distribution that
     disagrees can set $M9LIBRARY, which is searched first anyway. *)
  StdLib = '/usr/lib/m9' ;

  (* Kept by hand in step with debian/changelog: the compiler is the
     one artifact that cannot read its own package version, and a
     generated file would drag the build system into the bootstrap. *)
  Version = '0.25.4' ;
  (* and where its runtime lives, which --help quotes so that the
     example a user copies out of it actually compiles *)
  StdInclude = '/usr/include/m9' ;
  (* the installed runtime archive, linked when there are no runtime
     sources beside the header that was included *)
  StdArchive = '/usr/lib/libm9rt.a' ;

(* the module name a path denotes: last segment, minus the suffix.
   Neither separator is assumed absent -- this compiler is built on
   Windows and run under WSL in the same afternoon.                 *)
(* the byte at offset i of u, as a number: the scanners below read ASCII
   structure -- separators, digits, `:`, `=`, `.so` -- where a byte IS
   the character *)
PROCEDURE B (RO u: UTF ; i: I64) : I64 =
BEGIN
  RETURN I64 (Text.BAt (u, i))
END B ;

PROCEDURE BaseName (RO path: UTF) : UTF =
VAR
  i, start, stop : I64 ;
BEGIN
  start := 0 ;
  stop := Text.BLen (path) ;
  FOR i := 0 TO Text.BLen (path) - 1 DO
    IF B (path, i) = ORD ('/') THEN start := i + 1 END ;
    IF B (path, i) = 92 THEN start := i + 1 END      (* backslash *)
  END ;
  IF stop - start > 3 THEN
    IF Text.Eq (SLICE (path, stop - 3, 3), '.m9') THEN
      stop := stop - 3
    END
  END ;
  RETURN SLICE (path, start, stop - start)
END BaseName ;

(* Every m9c diagnostic goes to STDERR, which is what --help has been
   promising and what half of these were not doing: the missing-module
   message landed on stdout beside the generated text, so a harness
   capturing errors saw nothing and a harness capturing output saw
   both.  One composer, so there is one place for it to be true. *)
PROCEDURE Diag (RO a: UTF ; RO b: UTF ; RO c: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.Append (d, b) ;
  DynUtf.Append (d, c) ;
  Io.ErrLine (DynUtf.ViewIn (pool, d))
END Diag ;

PROCEDURE DiagN (RO a: UTF ; n: I64 ; RO b: UTF ; RO c: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.AppendI64 (d, n) ;
  DynUtf.Append (d, b) ;
  DynUtf.Append (d, c) ;
  Io.ErrLine (DynUtf.ViewIn (pool, d))
END DiagN ;

(* FILE:LINE:COL: what: message -- the parser's errors carry a column
   where the generator's carry only a line, because a parser knows
   which token it was looking at *)
PROCEDURE Diag2 (RO a: UTF ; ln: I64 ; cl: I64 ; RO b: UTF ; RO c: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.AppendI64 (d, ln) ;
  DynUtf.AppendChar (d, ':') ;
  DynUtf.AppendI64 (d, cl) ;
  DynUtf.Append (d, b) ;
  DynUtf.Append (d, c) ;
  Io.ErrLine (DynUtf.ViewIn (pool, d))
END Diag2 ;

PROCEDURE Suffix (RO name: UTF ; RO ext: UTF) : UTF =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, name) ;
  DynUtf.Append (d, ext) ;
  RETURN DynUtf.ViewIn (pool, d)
END Suffix ;

(* ---- finding a module's source ----

   IMPORT names a MODULE, not a file, and until now the caller had to
   translate: every dependency spelled out as a path, transitively,
   in an order that worked.  A search path lets m9c do that
   translation, which is the whole of what a build system was doing
   here.

   Three sources, in order: -I DIR (repeatable, leftmost first),
   $M9LIBRARY (colon-separated, as PATH is), and the directory the
   main file came from.  That last one is why `m9c corpus/M9c.m9`
   needs no -I at all: a module's neighbours are almost always its
   imports.

   FROM u IMPORT ... is deliberately NOT resolved.  Its u is a
   foreign unit -- csock, cblosc -- declared inside some module and
   backed by C, so there is no u.m9 to find and guessing there would
   invent files.                                                    *)

PROCEDURE DirAdd (RO KEPT d: UTF ; trusted: BOOL) =
VAR
  nb : SLICE OF UTF ;
  tb : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  IF Text.BLen (d) = 0 THEN RETURN END ;
  IF ndirs = LEN (dirs) THEN
    nb := NEW (pool, UTF, 2 * LEN (dirs) + 8) ;
    tb := NEW (pool, BOOL, 2 * LEN (dirs) + 8) ;
    FOR i := 0 TO ndirs - 1 DO nb[i] := dirs[i] ; tb[i] := trusts[i] END ;
    dirs := nb ;
    trusts := tb
  END ;
  dirs[ndirs] := d ;
  trusts[ndirs] := trusted ;
  ndirs := ndirs + 1
END DirAdd ;

(* separated the way PATH is on the platform, because that is the
   convention the shell already taught everyone: ':' here, and ';'
   on Windows, where a path of its own carries a ':' two characters
   in (C:\m9\lib\m9) *)
PROCEDURE DirAddPath (RO KEPT s: UTF ; trusted: BOOL) =
VAR
  i, start : I64 ;
  sep : CHAR ;
BEGIN
  IF windows THEN sep := ';' ELSE sep := ':' END ;
  start := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) = ORD (sep) THEN
      DirAdd (SLICE (s, start, i - start), trusted) ;
      start := i + 1
    END
  END ;
  DirAdd (SLICE (s, start, Text.BLen (s) - start), trusted)
END DirAddPath ;

(* the directory a path came from, empty when it names no directory *)
(* the text of a file, or '' when it cannot be read as text *)
PROCEDURE TextOf (RO path: UTF) : UTF =
BEGIN
  RETURN UTF (pool, Io.ReadFileUtf (path))
EXCEPT
| Io.IOError (m) : RETURN ''
| ValueRange : RETURN ''
END TextOf ;

(* a NAME.h beside the module's source that is not the header just
   written to another directory: a C driver there includes "NAME.h"
   and a quoted include searches the including file's directory first,
   so it reads the stale one (2026-09-15: `implicit declaration of
   Mod_m9init'; the owed ledger since).  Said, not refused -- the file
   is not m9c's to delete. *)
PROCEDURE StaleBeside (RO main, outDir, name: UTF ; RO fresh: UTF) RAISES ValueRange =
VAR src, there : UTF ;
BEGIN
  src := DirOf (main) ;
  IF Text.BLen (src) = 0 THEN src := '.' END ;
  IF Text.Eq (src, outDir) THEN RETURN END ;
  there := Join (src, Suffix (name, '.h')) ;
  IF NOT Io.Exists (there) THEN RETURN END ;
  IF Text.Eq (TextOf (there), fresh) THEN RETURN END ;
  Diag ('m9c: ', there, Cat (' is not the header just written to ',
        Cat (Join (outDir, Suffix (name, '.h')),
             '; a C file beside it that includes it reads the old one -- delete it')))
END StaleBeside ;

PROCEDURE DirOf (RO path: UTF) : UTF =
VAR i, cut : I64 ;
BEGIN
  cut := 0 ;
  FOR i := 0 TO Text.BLen (path) - 1 DO
    IF B (path, i) = ORD ('/') THEN cut := i + 1 END ;
    IF B (path, i) = 92 THEN cut := i + 1 END        (* backslash *)
  END ;
  IF cut = 0 THEN RETURN '' END ;
  RETURN SLICE (path, 0, cut - 1)
END DirOf ;

(* ---- where this compiler is ----

   The installed places are RELATIVE TO THE EXECUTABLE when the
   platform can say where that is: <prefix>/lib/m9, <prefix>/include/m9
   and <prefix>/lib/libm9rt.a, with prefix the directory ABOVE the
   executable's.  For /usr/bin/m9c that is /usr, which is exactly the
   package's layout, so nothing moves for an installed compiler.
   What it buys is a tree that can be MOVED: `./build.sh /opt/m9`
   gives /opt/m9/usr/bin/m9c, which finds its own library at
   /opt/m9/usr/lib/m9 with no variable set; and the Windows zip
   (docs/windows-plan.md) is bin\m9c.exe beside lib\m9, runtime\ and
   ucrt64\, and a zip cannot ask anyone to set a variable.  The zip's
   runtime\ is also a source tree's, so out/m9c finds THIS tree's
   m9rt.h ahead of an installed one -- the stale-runtime trap
   AddRuntime describes, closed from the other side.
   The constants stay as the last resort, and for a location the
   platform cannot answer (System.Executable is '') they are all
   there is.  Paths are joined with '/' throughout: a Windows path
   with mixed separators (C:\m9/lib/m9) is accepted by the system
   and by gcc alike, and one spelling beats two. *)
PROCEDURE Locate () RAISES ValueRange =
BEGIN
  windows := Text.Eq (System.Os (), 'windows') ;
  macos := Text.Eq (System.Os (), 'macos') ;
  prefix := DirOf (DirOf (System.ExecutableUtf (pool)))
END Locate ;

(* this compiler's own library directory, or the package's *)
PROCEDURE LibDir () : UTF =
BEGIN
  IF Text.BLen (prefix) = 0 THEN RETURN StdLib END ;
  RETURN Cat (prefix, '/lib/m9')
END LibDir ;

(* its own installed headers, or the package's *)
PROCEDURE IncDir () : UTF =
BEGIN
  IF Text.BLen (prefix) = 0 THEN RETURN StdInclude END ;
  RETURN Cat (prefix, '/include/m9')
END IncDir ;

(* its own runtime archive, or the package's *)
PROCEDURE RtArchive () : UTF =
BEGIN
  IF Text.BLen (prefix) = 0 THEN RETURN StdArchive END ;
  RETURN Cat (prefix, '/lib/libm9rt.a')
END RtArchive ;

(* THE LIBRARY THE SEARCH PATH ENDS WITH: this compiler's own when it
   has one, the package's otherwise -- one or the other, never both,
   so a relocated tree does not quietly pick modules out of
   /usr/lib/m9 when its own library lacks one.  For /usr/bin/m9c the
   two are the same string; for out/m9c, whose tree has no lib/m9,
   it is the package's, as it always was. *)
PROCEDURE LibPlace () : UTF RAISES ValueRange =
BEGIN
  IF Io.Exists (LibDir ()) THEN RETURN LibDir () END ;
  RETURN StdLib
END LibPlace ;

(* where THIS m9c would take its headers from, for --help; the
   package's place when it would find none *)
PROCEDURE IncPlace () : UTF RAISES ValueRange =
VAR r : UTF ;
BEGIN
  r := RtDir () ;
  IF Text.BLen (r) = 0 THEN RETURN StdInclude END ;
  RETURN r
END IncPlace ;

(* the bundled tool when the zip carries it, the PATH one otherwise.
   Windows and macOS: a Linux package depends on gcc and does not ship
   one.  On macOS the system's cc is clang under gcc's name, which
   takes neither --param nor a nested function, so an install that
   wants gcc's code carries gcc -- <prefix>/gcc/bin, a directory of
   its own because nothing about that gcc's layout depends on the
   name, as ucrt64's does. *)
PROCEDURE Bundled (RO tool: UTF ; RO fallback: UTF) : UTF
  RAISES ValueRange =
VAR p : UTF ;
BEGIN
  IF windows AND Text.BLen (prefix) > 0 THEN
    p := Cat (prefix, Cat ('/ucrt64/bin/', tool)) ;
    IF Io.Exists (p) THEN RETURN p END
  END ;
  IF macos AND Text.BLen (prefix) > 0 THEN
    p := Cat (prefix, Cat ('/gcc/bin/', tool)) ;
    IF Io.Exists (p) THEN RETURN p END
  END ;
  RETURN fallback
END Bundled ;

(* the bundled gcc's own bin when the zip carries one; empty
   otherwise (Linux, or a tree without a ucrt64\ beside lib\).
   THE DIRECTORY IS NAMED ucrt64 BECAUSE gcc SAYS SO.  MSYS2's gcc is
   configured with /ucrt64/include as its system header directory
   and relocates that, from wherever gcc.exe finds itself, to
   bin\..\..\ucrt64\include -- the LAST component is kept.  Under
   any other name (measured with `gcc.exe -xc -E -v -`: "ignoring
   nonexistent directory /ucrt64/include") string.h is not found and
   nothing compiles.  The library paths are relative and do not care;
   the headers do. *)
PROCEDURE GccBin () : UTF RAISES ValueRange =
VAR p : UTF ;
BEGIN
  IF windows AND Text.BLen (prefix) > 0 THEN
    p := Cat (prefix, '/ucrt64/bin') ;
    IF Io.Exists (p) THEN RETURN p END
  END ;
  RETURN ''
END GccBin ;

(* whether path names something inside dir: dir is a prefix of it
   and a separator follows.  Nothing is normalised -- both sides were
   composed here from the same prefix, so a spelling of the user's
   own ($CC with backslashes) is simply not under it, which is the
   answer wanted: that gcc runs with the PATH it was given. *)
PROCEDURE Under (RO path: UTF ; RO dir: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF Text.BLen (path) <= Text.BLen (dir) THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (dir) - 1 DO
    IF B (path, i) # B (dir, i) THEN RETURN FALSE END
  END ;
  RETURN B (path, Text.BLen (dir)) = ORD ('/') OR B (path, Text.BLen (dir)) = 92
END Under ;

(* '/' to the platform's separator, for a value handed to the SYSTEM
   rather than to gcc: prefix arrives with backslashes from
   GetModuleFileName and gains '/ucrt64/bin' here, and a PATH entry is
   the one place the mixed spelling would be seen by a user. *)
PROCEDURE Native (RO s: UTF) : UTF =
BEGIN
  IF NOT windows THEN RETURN s END ;
  RETURN Text.Replace (s, '/', '\')
END Native ;

(* THE BUNDLED gcc NEEDS ITS OWN bin ON PATH, and m9c puts it there
   for the child rather than asking the user to.  MSYS2's cc1.exe,
   lto1.exe and ld.exe import DLLs (libgmp, libmpfr, libisl, libzstd,
   libwinpthread ...) that live in ucrt64\bin beside gcc.exe, while
   they themselves live in lib\gcc\...\16.2.0 -- and the loader
   searches the directory of the program being STARTED, the system
   ones and then PATH, never the bin of the gcc.exe that started it.
   So with ucrt64\bin absent from PATH, gcc.exe runs, cc1 cannot load, and gcc
   exits 1 with nothing said (measured under wine).  The entry goes
   FIRST, so the bundled binutils beat another gcc's on the machine;
   and it is added only for a program under that directory, so a $CC
   of the user's own runs with the PATH it was given.  Exec merges
   the override over the inherited environment (case-insensitively
   on Windows, where it is Path as often as PATH). *)
PROCEDURE ChildEnv (RO prog: UTF) : SLICE OF UTF RAISES ValueRange =
VAR
  bin : UTF ;
  env : SLICE OF UTF ;
BEGIN
  bin := GccBin () ;
  IF Text.BLen (bin) > 0 AND Under (prog, bin) THEN
    env := NEW (pool, UTF, 1) ;
    env[0] := Cat ('PATH=', Cat (Native (bin),
                                 Cat (';', Io.EnvUtf (pool, 'PATH')))) ;
    RETURN env
  END ;
  RETURN NEW (pool, UTF, 0)
END ChildEnv ;

PROCEDURE Join (RO d: UTF ; RO f: UTF) : UTF =
VAR s : PTR DynUtf.DString IN pool ;
BEGIN
  IF Text.BLen (d) = 0 THEN RETURN f END ;
  s := DynUtf.New (pool) ;
  DynUtf.Append (s, d) ;
  DynUtf.AppendChar (s, '/') ;
  DynUtf.Append (s, f) ;
  RETURN DynUtf.ViewIn (pool, s)
END Join ;

(* a candidate that does not read is not an error, it is the next
   candidate -- so the handler answers "no" rather than propagating,
   and only the exhausted search is diagnosed *)
PROCEDURE TryRead (RO path: UTF ; VAR ok: BOOL) : UTF =
BEGIN
  ok := TRUE ;
  readNotText := FALSE ;
  RETURN UTF (pool, Io.ReadFileUtf (path))
EXCEPT
| Io.IOError (p) :
    ok := FALSE ;
    RETURN ''
| ValueRange :
    (* it exists and is not text: that IS worth saying, because a
       silent skip here would look identical to a missing file *)
    Diag ('m9c: not text: ', path, ' -- a source is UTF-8, and this file is not') ;
    ok := FALSE ;
    readNotText := TRUE ;
    RETURN ''
END TryRead ;

(* the first NAME.m9 on the search path, with its source already
   read -- searching and reading are the same act, so doing them
   twice would be two answers about one file *)
(* the rehearsed switch (--utf-str) serves DynStr from DynUtf.m9 --
   decision 4 of docs/utf8-stage4-plan.md: at the switch DynStr keeps
   its name with DynUtf's body.  The unit's name is rewritten in the
   text (DynUtf.m9 names itself nowhere else) and the result written
   under the cache as DynStr.m9, so a dependency build by path and a
   diagnostic's file name both see a DynStr.m9 whose lines are
   DynUtf.m9's. *)
PROCEDURE Aliased (RO src: UTF ; RO from: UTF ; RO to: UTF ;
                   VAR path: UTF ; VAR ok: BOOL) : UTF =
VAR dir, text : UTF ;
BEGIN
  text := Text.Replace (src, from, to) ;
  dir := Join (CacheRoot (), 'utfstr') ;
  MkDirs (dir) ;
  path := Join (dir, Suffix (to, '.m9')) ;
  Io.WriteFile (path, text) ;
  RETURN text
EXCEPT
| Io.IOError (p) :
    Diag ('m9c: cannot write the aliased ', to, ' under the cache') ;
    ok := FALSE ;
    RETURN ''
| ValueRange :
    ok := FALSE ;
    RETURN ''
END Aliased ;

PROCEDURE FindModule (RO name: UTF ; VAR path: UTF ; VAR ok: BOOL ;
                      VAR trusted: BOOL) : UTF =
VAR
  i : I64 ;
  cand, src, want : UTF ;
BEGIN
  trusted := FALSE ;
  want := name ;
  IF utfStr AND Text.Eq (name, 'DynStr') THEN want := 'DynUtf' END ;
  FOR i := 0 TO ndirs - 1 DO
    cand := Join (dirs[i], Suffix (want, '.m9')) ;
    src := TryRead (cand, ok) ;
    IF ok THEN
      path := cand ;
      trusted := trusts[i] ;
      IF NOT Text.Eq (want, name) THEN
        RETURN Aliased (src, want, name, path, ok)
      END ;
      RETURN src
    END
  END ;
  ok := FALSE ;
  path := '' ;
  RETURN ''
END FindModule ;

(* the file a generator error's line is in: main, or the definition of
   the imported module the generator read it from (Gen.ErrModAt).
   Until 2026-10-29 every error named main, so an imported type's line
   was printed under the importer's name *)
PROCEDURE ErrFile (RO m: UTF ; RO main: UTF) : UTF =
VAR
  path, src : UTF ;
  ok, trusted : BOOL ;
BEGIN
  IF Text.BLen (m) = 0 THEN RETURN main END ;
  src := FindModule (m, path, ok, trusted) ;
  IF ok THEN RETURN path END ;
  RETURN Suffix (m, '.m9')
END ErrFile ;

PROCEDURE IsLoaded (RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nloaded - 1 DO
    IF Text.Eq (loaded[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsLoaded ;

PROCEDURE MarkLoaded (RO KEPT name: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF nloaded = LEN (loaded) THEN
    nb := NEW (pool, UTF, 2 * LEN (loaded) + 8) ;
    FOR i := 0 TO nloaded - 1 DO nb[i] := loaded[i] END ;
    loaded := nb
  END ;
  loaded[nloaded] := name ;
  nloaded := nloaded + 1
END MarkLoaded ;

(* a module whose own imports are all in order[] already: the build
   may reach it now.  Called once per module, at the point where that
   became true -- after the recursion in LoadIndirect, and after a
   kept root's subtree is walked in FillGaps -- so a duplicate would
   be a mistake in the caller rather than something to absorb
   quietly; it is refused by not appending it twice, and the FIRST
   position is the one that is right. *)
PROCEDURE AddEdge (RO KEPT a: UTF ; RO KEPT b: UTF) =
VAR
  nf, nt : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF nedge = LEN (edgeFrom) THEN
    nf := NEW (pool, UTF, 2 * LEN (edgeFrom) + 16) ;
    nt := NEW (pool, UTF, 2 * LEN (edgeFrom) + 16) ;
    FOR i := 0 TO nedge - 1 DO nf[i] := edgeFrom[i] ; nt[i] := edgeTo[i] END ;
    edgeFrom := nf ;
    edgeTo := nt
  END ;
  edgeFrom[nedge] := a ;
  edgeTo[nedge] := b ;
  nedge := nedge + 1
END AddEdge ;

PROCEDURE Ordered (RO KEPT name: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  FOR i := 0 TO norder - 1 DO
    IF Text.Eq (order[i], name) THEN RETURN END
  END ;
  IF norder = LEN (order) THEN
    nb := NEW (pool, UTF, 2 * LEN (order) + 8) ;
    FOR i := 0 TO norder - 1 DO nb[i] := order[i] END ;
    order := nb
  END ;
  order[norder] := name ;
  norder := norder + 1
END Ordered ;

PROCEDURE IsVisiting (RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nvisit - 1 DO
    IF Text.Eq (visiting[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsVisiting ;

PROCEDURE PushVisit (RO KEPT name: UTF) =
VAR nb : SLICE OF UTF ; i : I64 ;
BEGIN
  IF nvisit = LEN (visiting) THEN
    nb := NEW (pool, UTF, 2 * LEN (visiting) + 8) ;
    FOR i := 0 TO nvisit - 1 DO nb[i] := visiting[i] END ;
    visiting := nb
  END ;
  visiting[nvisit] := name ;
  nvisit := nvisit + 1
END PushVisit ;

PROCEDURE IsOrdered (RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO norder - 1 DO
    IF Text.Eq (order[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsOrdered ;

(* POST-ORDER over the recorded import graph: a module is appended
   once everything it imports has been.  This is computed from the
   GRAPH rather than from the order modules were loaded in, because
   loading is pre-order and a shared module can be reached first as
   somebody's direct import and only later as their dependency --
   `IMPORT Mid ; IMPORT Base ;` with Mid importing Base put Base
   after Mid and the build failed on the first run.  A cycle stops at
   the visiting mark: M9 does not forbid mutual imports, and a
   compiler should not acquire the rule by recursing for ever. *)
PROCEDURE OrderDfs (RO KEPT name: UTF) =
VAR i : I64 ;
BEGIN
  IF IsOrdered (name) THEN RETURN END ;
  IF IsVisiting (name) THEN importCycle := TRUE ; RETURN END ;
  PushVisit (name) ;
  FOR i := 0 TO nedge - 1 DO
    IF Text.Eq (edgeFrom[i], name) THEN OrderDfs (edgeTo[i]) END
  END ;
  Ordered (name)
END OrderDfs ;

(* every loaded module, deepest first *)
PROCEDURE BuildOrder () =
VAR i : I64 ;
BEGIN
  nvisit := 0 ;
  FOR i := 0 TO nloaded - 1 DO
    nvisit := 0 ;
    OrderDfs (loaded[i])
  END
END BuildOrder ;

(* ---- driving the C compiler ----

   m9c emits C11 and, with -c or -o, hands it to a C compiler.  It is
   not a build system: everything after -- goes to that compiler
   verbatim, because m9c cannot know where this project keeps its
   runtime or its dependency objects, and guessing is how a tool
   starts being fought rather than used.

   Without -c the C stays, as it always did.  With -c or -o the C is
   a BY-PRODUCT and goes away once the object exists, unless --keep-c
   says otherwise.  The header does NOT go away under -c: it is the
   module's interface, and the next module's generated C includes it.
   Under -o nothing downstream remains, so both go.                 *)

(* ---- the command, NOT THROUGH A SHELL ----

   A command is the program's name and a list of words, and that list
   is exactly what the operating system starts a process with -- the
   shell is the thing in between that takes ONE string apart into
   those words, by rules that differ between /bin/sh, cmd.exe and
   PowerShell, and that made a file called it's.m9 unbuildable.
   System.Exec skips the middle: the words go as they are.  Nothing
   is quoted because nothing is parsed.

   The words are collected in a module-level slice rather than passed
   around, because every command here is composed in one procedure
   from top to bottom and read once by Run.                        *)
PROCEDURE NewCommand () =
BEGIN
  IF LEN (words) = 0 THEN words := NEW (pool, UTF, 32) END ;
  nwords := 0
END NewCommand ;

PROCEDURE Word (RO KEPT s: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF nwords = LEN (words) THEN
    nb := NEW (pool, UTF, 2 * LEN (words) + 8) ;
    FOR i := 0 TO nwords - 1 DO nb[i] := words[i] END ;
    words := nb
  END ;
  words[nwords] := s ;
  nwords := nwords + 1
END Word ;

(* the command as -v shows it: the words joined by single spaces.  A
   display only -- it is not what runs, so a word holding a space
   prints ambiguously and runs correctly. *)
PROCEDURE Line (RO prog: UTF) : UTF =
VAR
  d : PTR DynUtf.DString IN pool ;
  i : I64 ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, prog) ;
  FOR i := 0 TO nwords - 1 DO
    DynUtf.AppendChar (d, ' ') ;
    DynUtf.Append (d, words[i])
  END ;
  RETURN DynUtf.ViewIn (pool, d)
END Line ;

(* run prog with the words, forward what it wrote to the streams it
   wrote it to, answer its status.  cc's diagnostics arrive whole
   rather than interleaved with ours, which is the one visible
   difference from the shell days and a small price for it.
   A program that cannot start is -1 with its name said: the module
   handler's wording for Io.IOError is about files, not programs.
   The environment is the caller's, plus PATH for the bundled gcc
   (ChildEnv); -v prints the command and not the environment, since
   the command line is what the relocation gate anchors on. *)
PROCEDURE Run (RO prog: UTF) : I64 RAISES ValueRange =
VAR
  r : System.ResultUtf ;
BEGIN
  IF verbose THEN Diag ('m9c: ', Line (prog), '') END ;
  r := System.ExecUtf (pool, prog, SLICE (words, 0, nwords), '',
                       ChildEnv (prog)) ;
  IF Text.BLen (r.out) > 0 THEN Io.Write (r.out) END ;
  IF Text.BLen (r.err) > 0 THEN Io.Err (r.err) END ;
  RETURN r.status
EXCEPT
| Io.IOError (p) :
    Diag ('m9c: cannot run ', UTF (p), '') ;
    RETURN -1
END Run ;

(* $CC when set; else, on Windows, the gcc the zip bundles at
   <prefix>/ucrt64/bin/gcc.exe or a gcc on PATH (there is no `cc` on
   Windows); else cc.  It is the compiler's NAME -- a word, found on
   PATH or given as a path -- and not a command line: with no shell
   to split it, CC='gcc -m32' would be looked up as one program
   called "gcc -m32".  Flags go after --, where they always went. *)
PROCEDURE CcName () : UTF RAISES ValueRange =
VAR v : UTF ;
BEGIN
  v := Io.EnvUtf (pool, 'CC') ;
  IF Text.BLen (v) > 0 THEN RETURN v END ;
  IF windows THEN RETURN Bundled ('gcc.exe', 'gcc') END ;
  IF macos THEN RETURN Bundled ('gcc', 'cc') END ;
  RETURN 'cc'
END CcName ;

(* the archiver beside that gcc, or ar on PATH; no $AR, because the
   archiver that matches the compiler is the one to use and nobody
   has asked for another *)
PROCEDURE ArName () : UTF RAISES ValueRange =
BEGIN
  IF windows THEN RETURN Bundled ('ar.exe', 'ar') END ;
  (* gcc-ar, not ar: the objects are -flto's, and the system's ar
     writes an index that does not see into them *)
  IF macos THEN RETURN Bundled ('gcc-ar', 'ar') END ;
  RETURN 'ar'
END ArName ;

(* ---- the flags nobody should have to type ----

   m9c is not a build system, and the way that was stated -- every
   include path and every object after -- -- meant the shortest real
   command was four flags long and three of them were the same every
   time.  Being unwilling to guess is not the same as being unwilling
   to LOOK.

   So when nothing follows --, m9c supplies what it can establish by
   looking: where its runtime actually is, and which objects the
   import closure it just resolved implies.  When something DOES
   follow --, none of this happens: the caller has taken the line
   over, and a default silently added underneath a flag someone chose
   is worse than no default at all.                                 *)

(* the runtime's headers: $M9RUNTIME; else beside this compiler --
   <prefix>/runtime, which is the zip's layout and a source tree's,
   then <prefix>/include/m9, the package's -- else the package's
   place by its constant, else a source tree from the working
   directory.  Probed rather than assumed, because this compiler runs
   from /usr/bin and from a build directory on the same afternoon. *)
PROCEDURE RtBase () : UTF RAISES ValueRange =
VAR v : UTF ;
BEGIN
  v := Io.EnvUtf (pool, 'M9RUNTIME') ;
  IF Text.BLen (v) > 0 THEN
    (* set is not the same as right.  A variable naming a directory
       with no m9rt.h in it is answered by the compiler that read the
       variable, not by cc failing over an include three steps later
       -- and then the search continues, because a wrong answer that
       has been said out loud is not a reason to stop looking. *)
    IF Io.Exists (Cat (v, '/m9rt.h')) THEN RETURN v END ;
    Diag ('m9c: $M9RUNTIME names ', v, ', which has no m9rt.h in it')
  END ;
  IF Text.BLen (prefix) > 0 THEN
    v := Cat (prefix, '/runtime') ;
    IF Io.Exists (Cat (v, '/m9rt.h')) THEN RETURN v END ;
    v := IncDir () ;
    IF Io.Exists (Cat (v, '/m9rt.h')) THEN RETURN v END
  END ;
  IF Io.Exists (Cat (StdInclude, '/m9rt.h')) THEN RETURN StdInclude END ;
  IF Io.Exists ('runtime/m9rt.h') THEN RETURN 'runtime' END ;
  IF Io.Exists ('../runtime/m9rt.h') THEN RETURN '../runtime' END ;
  RETURN ''
END RtBase ;

(* the runtime directory -- and for --cell, which compiles the runtime
   as a shared object and needs its SOURCES, its own package's source
   tree when the headers' directory holds none: <prefix>/share/m9/
   runtime (build.sh installs it), the prefix being this compiler's --
   /usr for /usr/bin/m9c.  NOT a system path besides: a relocated m9c
   reaching /usr/share/m9/runtime would compile ANOTHER install's
   runtime under its own header (the m9c gate's case (c) built so on
   zoefii once the 0.15.0 package was installed, 2026-10-05).  Only
   --cell: an ordinary link takes the archive, and sources beside the
   header would have it compile m9rt.c on every link.  Until
   2026-10-05 an installed m9c answered every --cell with `needs the
   runtime sources beside m9rt.h' -- the notebook session did not work
   from a package. *)
PROCEDURE RtDir () : UTF RAISES ValueRange =
VAR base, v : UTF ;
BEGIN
  base := RtBase () ;
  IF doCell AND NOT Io.Exists (Cat (base, '/m9rt.c')) AND Text.BLen (prefix) > 0 THEN
    v := Cat (prefix, '/share/m9/runtime') ;
    IF Io.Exists (Cat (v, '/m9rt.h')) AND Io.Exists (Cat (v, '/m9rt.c')) THEN RETURN v END
  END ;
  RETURN base
END RtDir ;

(* two strings, joined -- the one composition this module needs often
   enough to name *)
PROCEDURE Cat (RO a: UTF ; RO b: UTF) : UTF =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.Append (d, b) ;
  RETURN DynUtf.ViewIn (pool, d)
END Cat ;

(* The runtime itself, to link.  What is linked must be the runtime
   whose HEADER was included, or the program is built from two
   versions of one library: the installed archive underneath this
   repository's m9rt.h is how a newly added m9_exists became an
   undefined reference at link time instead of a missing declaration
   at compile time.  So the sources beside the header win, and the
   installed archive answers only when there are none.
   Both translation units go in, because that is what the archive
   contains and a program should not behave differently depending on
   which of the two m9c happened to find. *)
PROCEDURE AddRuntime (RO rt: UTF) : BOOL RAISES ValueRange =
VAR a : UTF ;
BEGIN
  IF Io.Exists (Cat (rt, '/m9rt.c')) THEN
    Word (Cat (rt, '/m9rt.c')) ;
    IF Io.Exists (Cat (rt, '/tcpshim.c')) THEN
      Word (Cat (rt, '/tcpshim.c'))
    END ;
    (* the TLS half of csock, over OpenSSL.  Http binds tls_connect/
       read/write/close unconditionally, so a program that makes ANY
       request -- over plain http included -- referenced four symbols
       the flagless link never supplied and failed on them (measured
       against the installed 0.11.0 package, 2026-09-28; the tutorial's
       chapter 11 had named the shim by hand).  Not on Windows: the
       shim is OpenSSL and does not build under mingw (the SChannel
       question is open), so there the line stays as it was. *)
    IF NOT windows AND Io.Exists (Cat (rt, '/tlsshim.c')) THEN
      Word (Cat (rt, '/tlsshim.c'))
    END ;
    (* fmt_g, Plot's %.4g twin: pure libc, so it always travels --
       without it the FLAGLESS link could never build a program that
       plots, and every gate had quietly hand-linked the shim (found
       by m9edit's first figure, 2026-09-02) *)
    IF Io.Exists (Cat (rt, '/fmtshim.c')) THEN
      Word (Cat (rt, '/fmtshim.c'))
    END ;
    RETURN TRUE
  END ;
  (* the archive: this compiler's own when it has one (a relocated
     install, DESTDIR somewhere other than /), which needs its
     directory named because the linker does not search it; the
     package's otherwise, which the linker finds by itself *)
  a := RtArchive () ;
  IF Io.Exists (a) THEN
    IF NOT Text.Eq (a, StdArchive) THEN
      Word (Cat ('-L', Cat (prefix, '/lib')))
    END ;
    Word ('-lm9rt') ;
    RETURN TRUE
  END ;
  IF Io.Exists (StdArchive) THEN
    Word ('-lm9rt') ;
    RETURN TRUE
  END ;
  Diag ('m9c: m9rt.h is in ', rt, ', but there is no runtime to') ;
  Diag ('  link beside it and no ', a, '.') ;
  Io.ErrLine ('  name one yourself after --') ;
  RETURN FALSE
END AddRuntime ;

(* WHERE OPENSSL IS, ON macOS.  The system ships LibreSSL's dylibs
   and no headers, so there is no place cc finds by itself: this
   compiler's own prefix first (an install that carries its OpenSSL
   beside its runtime, as the Windows zip carries its gcc), then
   Homebrew's two prefixes.  Empty when none of them has ssl.h, and
   then the line names no directory and cc says what is missing. *)
PROCEDURE OsslDir () : UTF RAISES ValueRange =
BEGIN
  IF Text.BLen (prefix) > 0
     AND Io.Exists (Cat (prefix, '/include/openssl/ssl.h')) THEN
    RETURN prefix
  END ;
  IF Io.Exists ('/opt/homebrew/opt/openssl@3/include/openssl/ssl.h') THEN
    RETURN '/opt/homebrew/opt/openssl@3'
  END ;
  IF Io.Exists ('/usr/local/opt/openssl@3/include/openssl/ssl.h') THEN
    RETURN '/usr/local/opt/openssl@3'
  END ;
  RETURN ''
END OsslDir ;

(* What Apple's cc needs said that gcc does not, after the defaults:
   the generated C parenthesises every comparison and assigns a FOR
   variable to itself, both of which clang warns about by default and
   gcc does not (gcc ignores a -Wno- it does not know, so CC=gcc on
   macOS is unharmed); and the directory OpenSSL's headers are in,
   for the tlsshim.c that travels as a source. *)
PROCEDURE MacFlags () RAISES ValueRange =
VAR o : UTF ;
BEGIN
  IF NOT macos THEN RETURN END ;
  Word ('-Wno-parentheses-equality') ;
  Word ('-Wno-self-assign') ;
  o := OsslDir () ;
  IF Text.BLen (o) > 0 THEN Word (Cat ('-I', Cat (o, '/include'))) END
END MacFlags ;

(* -ffp-contract=off: a * b + c is two roundings, as the source says,
   on every machine.  gcc's default lets it FUSE the two into one
   rounding where the target has the instruction -- not baseline
   x86-64, always arm64 -- so the same program printed other digits on
   the MacBook: Plot.RenderTaylor's tick coordinates differed in the
   fourth digit (51 fmadd in C18Taylor) and tutdiff failed there.
   Alex, 2026-10-05: the flag, not a stated difference.  On baseline
   x86-64 it changes no instruction (measured: identical objects). *)
PROCEDURE FpWords () =
BEGIN
  Word ('-ffp-contract=off')
END FpWords ;

(* The system libraries the runtime needs, after it on the line: libm,
   which Fmt and Time need and which is never wrong to name; on POSIX
   OpenSSL, because tlsshim.c is a member of the runtime there (the
   sources beside the header and the installed archive alike since
   0.12) and Http references its four symbols from every request path;
   and on Windows Winsock, because tcpshim.c is a member of the runtime
   on every platform and there its socket calls live in ws2_32 rather
   than in the C library.  A program that opens no socket pays nothing
   for the names: --as-needed keeps libssl and libcrypto out of a
   binary that referenced nothing in them (Ubuntu's ld already does
   this by default, Fedora's and Arch's do not), and an import library
   gives up only what is referenced. *)
(* One word a FOR "C" unit's LINK clause names (par 7), onto the
   line, once: a word ending in `.c' is a shim SOURCE beside the
   runtime (pgshim.c), found where the runtime's own sources are --
   RtDir, else the package's <prefix>/share/m9/runtime; a word that
   begins with `-' goes to the linker as it is, except that
   `-l:libNAME.so.N' -- GNU ld's spelling for a library whose
   development package is not installed (Debian's libblosc1 without
   libblosc-dev) -- is `-lNAME' where ld64 and mingw's ld are the
   linker; any other word is a library name, `-lNAME'. *)
PROCEDURE LinkWord (RO rt: UTF ; RO KEPT w: UTF ; VAR seen: SLICE OF UTF ;
                    VAR nseen: I64) RAISES ValueRange =
VAR
  i, n, at : I64 ;
  v : UTF ;
BEGIN
  FOR i := 0 TO nseen - 1 DO IF Text.Eq (seen[i], w) THEN RETURN END END ;
  IF nseen = LEN (seen) THEN RETURN END ;
  seen[nseen] := w ;
  nseen := nseen + 1 ;
  n := Text.BLen (w) ;
  IF n = 0 THEN RETURN END ;
  IF n > 2 AND B (w, n - 2) = ORD ('.') AND B (w, n - 1) = ORD ('c') THEN
    v := Cat (rt, Cat ('/', w)) ;
    IF NOT Io.Exists (v) AND Text.BLen (prefix) > 0 THEN
      v := Cat (prefix, Cat ('/share/m9/runtime/', w))
    END ;
    IF NOT Io.Exists (v) THEN
      Diag ('m9c: a foreign unit links ', w, ', which is not beside the runtime')
    END ;
    Word (v) ;
    RETURN
  END ;
  IF B (w, 0) = ORD ('-') THEN
    IF (macos OR windows) AND n > 6 AND B (w, 1) = ORD ('l') AND B (w, 2) = ORD (':') AND
       B (w, 3) = ORD ('l') AND B (w, 4) = ORD ('i') AND B (w, 5) = ORD ('b') THEN
      at := -1 ;
      FOR i := 6 TO n - 3 DO
        IF at < 0 AND B (w, i) = ORD ('.') AND B (w, i + 1) = ORD ('s') AND B (w, i + 2) = ORD ('o') THEN at := i END
      END ;
      IF at > 6 THEN
        Word (Cat ('-l', SLICE (w, 6, at - 6))) ;
        RETURN
      END
    END ;
    Word (w) ;
    RETURN
  END ;
  Word (Cat ('-l', w))
END LinkWord ;

(* What the closure's FOR "C" units link (their LINK clauses), before
   the system libraries: the modules m9c resolved a moment ago say
   what they bind, so a program that imports NetCDF, Grib, ZarrStore
   or Pg links flagless, runs under --run and loads as a cell --
   until 2026-10-09 each of them was a hand link line and `--run'
   could not run C8Zarr, C10Icos or C14Flux (the owed list's first
   item).  On macOS Homebrew's lib is named once when a unit links
   anything, as OpenSSL's is: that is where blosc and netCDF live
   there and the linker does not look by itself. *)
(* Is the library a LINK word names on THIS machine?  Asked of the C
   compiler, which answers a file it would link with its full path and
   one it would not with the bare name (`cc -print-file-name=F').  A
   shim source or another flag has nothing to look for: TRUE.  On
   macOS Homebrew's lib is looked in as well -- m9c names it on the
   line.  On Windows only the STATIC archive counts: the zip ships one
   for what a program should carry (OpenSSL, zlib, zstd) and import
   libraries for the rest, and a program linked against an import
   library does not START without the DLL beside it (measured
   2026-10-10: a Frame program that never calls NetCDF, given
   -lnetcdf, exits 53 under wine where 0.20.0's ran). *)
PROCEDURE LibFound (RO w: UTF) : BOOL RAISES ValueRange =
VAR
  n, i, at : I64 ;
  name, file : UTF ;
BEGIN
  n := Text.BLen (w) ;
  IF n = 0 THEN RETURN TRUE END ;
  IF n > 2 AND B (w, n - 2) = ORD ('.') AND B (w, n - 1) = ORD ('c') THEN RETURN TRUE END ;
  name := '' ;
  file := '' ;
  IF n > 3 AND B (w, 0) = ORD ('-') AND B (w, 1) = ORD ('l') AND B (w, 2) = ORD (':') THEN
    file := SLICE (w, 3, n - 3) ;
    (* -l:libNAME.so.N: the NAME, for the platforms that spell it -lNAME *)
    IF Text.BLen (file) > 6 AND B (file, 0) = ORD ('l') AND B (file, 1) = ORD ('i') AND B (file, 2) = ORD ('b') THEN
      at := -1 ;
      FOR i := 3 TO Text.BLen (file) - 3 DO
        IF at < 0 AND B (file, i) = ORD ('.') AND B (file, i + 1) = ORD ('s') AND B (file, i + 2) = ORD ('o') THEN at := i END
      END ;
      IF at > 3 THEN name := SLICE (file, 3, at - 3) END
    END
  ELSIF n > 2 AND B (w, 0) = ORD ('-') AND B (w, 1) = ORD ('l') THEN
    name := SLICE (w, 2, n - 2)
  ELSIF B (w, 0) = ORD ('-') THEN
    RETURN TRUE
  ELSE
    name := w
  END ;
  IF windows THEN
    RETURN Text.BLen (name) > 0 AND CcFinds (Cat ('lib', Cat (name, '.a')))
  END ;
  IF macos THEN
    IF Text.BLen (name) = 0 THEN RETURN FALSE END ;
    IF Io.Exists (Cat ('/opt/homebrew/lib/lib', Cat (name, '.dylib'))) THEN RETURN TRUE END ;
    IF InLibraryPath (name) THEN RETURN TRUE END ;
    RETURN CcFinds (Cat ('lib', Cat (name, '.dylib'))) OR CcFinds (Cat ('lib', Cat (name, '.a')))
  END ;
  IF Text.BLen (file) > 0 THEN RETURN CcFinds (file) END ;
  RETURN CcFinds (Cat ('lib', Cat (name, '.so'))) OR CcFinds (Cat ('lib', Cat (name, '.a')))
END LibFound ;

(* is libNAME.dylib or libNAME.a in a directory of $LIBRARY_PATH?  The
   linker searches them, but Apple clang's -print-file-name does not:
   under `cc' a keg-only Homebrew library (libpq in
   /opt/homebrew/opt/libpq/lib) read as absent and an indirectly reached
   unit's LINK words were dropped -- the heatpump server lost pgshim.c
   and -lpq while a program importing Pg directly linked (2026-10-25;
   the installed m9c runs its prefix's gcc, whose -print-file-name does
   search it, and linked) *)
PROCEDURE InLibraryPath (RO name: UTF) : BOOL RAISES ValueRange =
VAR
  lp, dir : UTF ;
  i, from : I64 ;
BEGIN
  lp := Io.EnvUtf (pool, 'LIBRARY_PATH') ;
  from := 0 ;
  FOR i := 0 TO Text.BLen (lp) DO
    IF i = Text.BLen (lp) OR B (lp, i) = ORD (':') THEN
      IF i > from THEN
        dir := SLICE (lp, from, i - from) ;
        IF Io.ExistsUtf (Cat (dir, Cat ('/lib', Cat (name, '.dylib')))) OR
           Io.ExistsUtf (Cat (dir, Cat ('/lib', Cat (name, '.a')))) THEN
          RETURN TRUE
        END
      END ;
      from := i + 1
    END
  END ;
  RETURN FALSE
END InLibraryPath ;

PROCEDURE CcFinds (RO file: UTF) : BOOL RAISES ValueRange =
VAR
  r : System.ResultUtf ;
  args : SLICE OF UTF ;
  cc, got : UTF ;
  n : I64 ;
BEGIN
  cc := CcName () ;
  args := NEW (pool, UTF, 1) ;
  args[0] := Cat ('-print-file-name=', file) ;
  r := System.ExecUtf (pool, cc, args, '', ChildEnv (cc)) ;
  IF r.status # 0 THEN RETURN FALSE END ;
  n := Text.BLen (r.out) ;
  WHILE n > 0 AND (B (r.out, n - 1) = 10 OR B (r.out, n - 1) = 13 OR B (r.out, n - 1) = 32) DO
    n := n - 1
  END ;
  got := SLICE (r.out, 0, n) ;
  RETURN NOT Text.Eq (got, file) AND Io.Exists (got)
EXCEPT
| Io.IOError (p) : RETURN FALSE
END CcFinds ;

(* every library a unit's LINK clause names is found *)
PROCEDURE UnitFound (l: PTR Ast.Node) : BOOL RAISES ValueRange =
VAR m : I64 ;
BEGIN
  FOR m := 0 TO l.nkids - 1 DO
    IF l.kids[m] IS SOME ws THEN
      IF NOT LibFound (ws.au) THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END UnitFound ;

PROCEDURE LinkWords () RAISES ValueRange =
VAR
  i, j, k, m, nseen : I64 ;
  rt : UTF ;
  seen : SLICE OF UTF ;
  any, far : BOOL ;
  rk : Ast.Kid ;
BEGIN
  rt := RtDir () ;
  seen := NEW (pool, UTF, 64) ;    (* module pool: LinkWord keeps the words in it *)
  nseen := 0 ;
  any := FALSE ;
  (* -1 is the program itself: a LINK on its own FOR "C" unit was
     never read, so `LINK "z"' there linked nothing (cp-kernel's
     finding on 0.20.0) *)
  FOR i := -1 TO ndeps - 1 DO
    IF i < 0 THEN
      rk := mainRoot ;
      far := FALSE
    ELSE
      rk := depRoots[i] ;
      far := depFar[i]
    END ;
    IF rk IS SOME r THEN
      FOR j := 0 TO r.nkids - 1 DO
        IF r.kids[j] IS SOME u THEN
          IF u.kind = Ast.NDefinition AND Text.BLen (u.bu) > 0 THEN
            FOR k := 0 TO u.nkids - 1 DO
              IF u.kids[k] IS SOME l THEN
                (* a unit reached only through another module's
                   implementation links when its libraries are here:
                   Frame reaches NetCDF so, and a Frame program that
                   never calls it links without libnetcdf -- the
                   linker drops the unused calls -- while one that
                   reaches Parquet's zstd needs -lzstd on the line *)
                IF l.kind = Ast.NLinkList AND far AND NOT UnitFound (l) THEN
                  IF verbose THEN
                    Diag ('m9c: not linking what ', u.au,
                          ' names: reached through another module, and not on this machine')
                  END
                ELSIF l.kind = Ast.NLinkList THEN
                  FOR m := 0 TO l.nkids - 1 DO
                    IF l.kids[m] IS SOME ws THEN
                      IF macos AND NOT any THEN
                        any := TRUE ;
                        IF Io.Exists ('/opt/homebrew/lib') THEN Word ('-L/opt/homebrew/lib') END
                      END ;
                      LinkWord (rt, ws.au, seen, nseen)
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END LinkWords ;

PROCEDURE SystemLibs () RAISES ValueRange =
VAR o : UTF ;
BEGIN
  LinkWords () ;
  IF macos THEN
    (* ld64 has no --as-needed; -dead_strip_dylibs is its word for
       the same thing, and against static archives neither is needed *)
    o := OsslDir () ;
    IF Text.BLen (o) > 0 THEN Word (Cat ('-L', Cat (o, '/lib'))) END ;
    Word ('-Wl,-dead_strip_dylibs') ;
    (* AND THE CODE NOTHING REACHES, which on Linux -flto removes by
       itself: the linker plugin tells gcc what the program uses, and
       a Frame that never reaches NetCDF links without libnetcdf
       (the tutorial's chapter 7 depends on it).  Apple's ld takes no
       plugin, so gcc's LTO must keep every external function, NetCDF's
       stay, and the link wants 44 nc_ symbols -- measured 2026-09-29.
       ld's own dead stripping removes them, and with them the
       references; the system's cc did not need it and is not hurt. *)
    Word ('-Wl,-dead_strip') ;
    Word ('-lssl') ;
    Word ('-lcrypto')
  ELSIF NOT windows THEN
    Word ('-Wl,--as-needed') ;
    Word ('-lssl') ;
    Word ('-lcrypto')
  END ;
  Word ('-lm') ;
  IF windows THEN Word ('-lws2_32') END
END SystemLibs ;

(* IS THIS OBJECT OLDER THAN WHAT IT WAS MADE FROM?

   The comparison is deliberately shallow -- the object against its
   own source -- because m9c rebuilds the whole closure in dependency
   order, so a module whose DEPENDENCY is rebuilt is reached on the
   same pass and its own source is not what changed.  What that does
   not catch is a source untouched while its dependency's INTERFACE
   moved; the pass below handles that by rebuilding in order and
   letting each rebuilt header push the next comparison over. *)
PROCEDURE Older (RO obj: UTF ; RO src: UTF) : BOOL
  RAISES ValueRange =
VAR to, ts : I64 ;
BEGIN
  to := Io.ModTime (obj) ;
  IF to < 0 THEN RETURN TRUE END ;        (* no object at all *)
  (* an object older than THIS COMPILER is stale whatever its source
     says: a generator change moves the ABI, and a build directory
     from before it kept a stale .h/.o and failed on `implicit
     declaration of Mod_m9init' (2026-09-15) until 2026-10-08.  The
     binary's mtime is what --run's key uses too. *)
  IF selfTime = 0 THEN selfTime := Io.ModTime (System.ExecutableUtf (pool)) END ;
  IF to < selfTime THEN RETURN TRUE END ;
  ts := Io.ModTime (src) ;
  IF ts < 0 THEN RETURN FALSE END ;       (* no source to be older than *)
  RETURN to < ts
END Older ;

(* whether the header at h was generated in this run's mode: Gen's
   first line says `with --utf-str' under the switch and nothing
   without it.  A header generated the other way is stale whatever the
   mtimes say -- maillists' cplists built with --utf-str in a directory
   a plain build had left took the plain Fmt.h as current, and cc
   refused the importers (2026-10-25).  A header that cannot be read is
   left to the tests beside this one. *)
PROCEDURE SameMode (RO h: UTF) : BOOL =
VAR first : UTF ; nl : I64 ;
BEGIN
  first := Io.ReadFileUtf (h) ;
  nl := Text.FindChar (first, 0AC) ;
  IF nl >= 0 THEN first := SLICE (first, 0, nl) END ;
  RETURN Text.Contains (first, ' with --utf-str ') = utfStr
EXCEPT
| Io.IOError, ValueRange : RETURN TRUE
END SameMode ;

(* Rebuild one dependency by RE-INVOKING THIS COMPILER.

   Not by recursing in-process: m9c holds exactly one module's
   registries and a process is the reset, which is the rule stated at
   the top of this file and the reason `one module per run` is in the
   help.  A subprocess is that rule honoured rather than worked
   around.

   The flags that must travel are the ones that change what the
   object IS -- the search path, -g, --pic -- and not the ones that
   describe this invocation: -o, --ar, --so and --doc are about the
   final artifact and a dependency has none.

   THIS compiler is the one re-invoked: the executable's resolved
   path, not argv[0], which is whatever the caller typed and, for a
   bare `m9c`, a name to be looked up on a PATH the child may not
   share.  Where the platform cannot answer, argv[0] is the fallback
   it always was. *)
(* a module's header and C only, where -c would put them (MakeAll,
   for an import cycle) *)
PROCEDURE MakeHeader (RO name: UTF ; RO KEPT path: UTF) : BOOL
  RAISES ValueRange, IndexError =
VAR
  self : UTF ;
  i, rc : I64 ;
BEGIN
  self := System.ExecutableUtf (pool) ;
  IF Text.BLen (self) = 0 THEN self := Io.ArgUtf (pool, 0) END ;
  NewCommand () ;
  Word ('--out-dir') ;
  IF Text.BLen (outDir) > 0 THEN Word (outDir) ELSE Word ('.') END ;
  IF utfStr THEN Word ('--utf-str') END ;
  FOR i := 0 TO ndirs - 1 DO Word (Cat ('-I', dirs[i])) END ;
  Word (path) ;
  IF verbose THEN Diag ('m9c: header ', name, '') END ;
  rc := Run (self) ;
  IF rc # 0 THEN
    Diag ('m9c: could not generate ', name, '') ;
    RETURN FALSE
  END ;
  RETURN TRUE
END MakeHeader ;

PROCEDURE MakeDep (RO name: UTF ; RO KEPT path: UTF) : BOOL
  RAISES ValueRange, IndexError =
VAR
  self : UTF ;
  i, rc : I64 ;
BEGIN
  self := System.ExecutableUtf (pool) ;
  IF Text.BLen (self) = 0 THEN self := Io.ArgUtf (pool, 0) END ;
  NewCommand () ;
  Word ('-c') ;
  IF debug THEN Word ('-g') END ;
  IF doPic THEN Word ('--pic') END ;
  IF utfStr THEN Word ('--utf-str') END ;   (* the dependency is compiled the same way *)
  FOR i := 0 TO ndirs - 1 DO Word (Cat ('-I', dirs[i])) END ;
  Word (path) ;
  IF ccFrom > 0 THEN
    Word ('--') ;
    FOR i := ccFrom TO Io.ArgCount () - 1 DO Word (Io.ArgUtf (pool, i)) END
  END ;
  IF verbose THEN Diag ('m9c: make ', name, '') END ;
  rc := Run (self) ;
  IF rc # 0 THEN
    Diag ('m9c: could not build dependency ', name, '') ;
    RETURN FALSE
  END ;
  RETURN TRUE
END MakeDep ;

(* THE CLOSURE, REBUILT IN DEPENDENCY ORDER.

   order[] is POST-order -- a module is appended once everything it
   imports is already in it -- so walking it FORWARD builds leaves
   first, which is the order a dependent needs.  (It used to walk
   loaded[] in reverse, which is pre-order reversed: right for a tree
   and wrong for a diamond.  See order[]'s own comment.)

   This exists because the hand-maintained order in every build
   script this project has kept getting it wrong, and the failures
   are indistinguishable from real bugs: an Advance compiled against
   the previous kind pass's Random.h is a float against a double, and
   the only reason that was not a wrong ANSWER is that -flto happened
   to catch it at link time. *)
PROCEDURE MakeAll () : BOOL
  RAISES ValueRange, IndexError =
VAR
  trustDummy : BOOL ;
  i : I64 ;
  nm, path, src, o : UTF ;
  found, ok, dirty : BOOL ;
BEGIN
  ok := TRUE ;
  (* ONCE ANYTHING HAS BEEN REBUILT, EVERYTHING AFTER IT IS TOO.

     Staleness is not transitive on its own: change Base.m9 and the
     module in the MIDDLE of Base -> Mid -> Top is still newer than
     its own source, so a rule that only compares a module against
     its own source leaves Mid holding code compiled against the old
     Base.  Measured, with Base flipped from F64 to F32: Base.o and
     Top.o were rebuilt and Mid.o was not.

     This loop runs in dependency order -- deepest first, which is
     what order[] is -- so anything that could depend on a rebuilt
     module comes after it, and rebuilding the
     rest of the closure is enough.  CONSERVATIVE, deliberately: a
     module later in the closure that does NOT depend on the changed
     one is rebuilt anyway.  Being exact would need a per-module
     import list rather than the flat closure, and the cost of being
     wrong here is a stale object, while the cost of being
     over-eager is a second of cc. *)
  dirty := FALSE ;
  (* an import cycle: every module's header first (MakeHeader), so the
     compile of one member finds its partner's -- a clean build failed
     on the partner's missing header, a second one passed on the first
     one's leftovers (2026-10-22) *)
  IF importCycle THEN
    FOR i := 0 TO norder - 1 DO
      nm := order[i] ;
      IF NOT Text.Eq (nm, modName) THEN
        src := FindModule (nm, path, found, trustDummy) ;
        IF found AND Text.BLen (src) >= 0 THEN
          IF NOT MakeHeader (nm, path) THEN ok := FALSE END
        END
      END
    END ;
    IF NOT ok THEN RETURN FALSE END
  END ;
  FOR i := 0 TO norder - 1 DO
    nm := order[i] ;
    IF NOT Text.Eq (nm, modName) THEN
      (* FindModule ANSWERS THE SOURCE and sets the path through a
         VAR parameter.  Assigning its result to `path` type-checks
         perfectly and stats the file's contents, which is never a
         file, so nothing ever looked stale.  The result is named and
         discarded here because M9 refuses a dropped function
         result -- which is what made the mistake visible at all. *)
      src := FindModule (nm, path, found, trustDummy) ;
      IF found THEN
        o := Cat (nm, '.o') ;
        (* the header is a product too: a build directory whose
           generated headers were deleted but whose objects stayed
           regenerated only the stale module and failed on a fresh
           one's missing DynStr.h (2026-10-09) *)
        IF Text.BLen (src) >= 0 AND (dirty OR Older (o, path) OR
                               NOT Io.Exists (Join (outDir, Cat (nm, '.h'))) OR
                               NOT SameMode (Join (outDir, Cat (nm, '.h')))) THEN
          dirty := TRUE ;
          IF NOT MakeDep (nm, path) THEN ok := FALSE END
        END
      END
    END
  END ;
  RETURN ok
END MakeAll ;

(* Every module the closure reached except this one, as an object.
   These are not guessed: they are exactly the modules m9c resolved,
   parsed and checked a moment ago, so the list cannot disagree with
   what the program imports.
   A missing one is NAMED, with the command that makes it, because
   'undefined reference to DynStr_Append' is the C linker explaining
   our omission in its own vocabulary. *)
PROCEDURE AddObjects () : BOOL RAISES ValueRange =
VAR
  i, nmiss : I64 ;
  o : UTF ;
BEGIN
  nmiss := 0 ;
  FOR i := 0 TO nloaded - 1 DO
    IF NOT Text.Eq (loaded[i], modName) THEN
      o := Cat (loaded[i], '.o') ;
      IF Io.Exists (o) THEN
        Word (o)
      ELSE
        Diag ('m9c: ', o, ' is missing; build it first with') ;
        Diag ('         m9c -c ', loaded[i], '') ;
        nmiss := nmiss + 1
      END
    END
  END ;
  RETURN nmiss = 0
END AddObjects ;

PROCEDURE Compile (RO name: UTF) : BOOL
  RAISES ValueRange, IndexError =
VAR
  cfile, out, rt : UTF ;
  i, rc : I64 ;
BEGIN
  cfile := Suffix (name, '.c') ;
  (* a library run compiles like -c: the object is a member, and the
     library itself is built by the step after this one *)
  IF doLink THEN out := exe ELSE out := Suffix (name, '.o') END ;
  NewCommand () ;
  IF NOT doLink THEN Word ('-c') END ;

  rt := RtDir () ;
  IF ccFrom > 0 THEN
    (* the caller has taken the command line over; nothing is added
       underneath a flag someone chose *)
    FOR i := ccFrom TO Io.ArgCount () - 1 DO Word (Io.ArgUtf (pool, i)) END
  ELSE
    IF Text.BLen (rt) = 0 THEN
      Io.ErrLine ('m9c: cannot find the M9 runtime headers.') ;
      Io.ErrLine ('  looked for m9rt.h in $M9RUNTIME, ' ) ;
      IF Text.BLen (prefix) > 0 THEN
        Diag ('  ', Cat (prefix, '/runtime'), ',') ;
        Diag ('  ', IncDir (), ',')
      END ;
      Diag ('  ', StdInclude, ', runtime/ and ../runtime/.') ;
      Io.ErrLine ('  give the paths yourself after --') ;
      RETURN FALSE
    END ;
    (* -O2, because a compiler that ships -O0 by default is not what
       anybody wants and nobody was told they had to ask.  Found by
       porting a Fortran kernel: the M9 build came out THIRTEEN
       TIMES slower than the Fortran, and the whole of that was the
       missing flag -- the same C at -O2 is 3.4x faster, and every
       number in docs/bench.md was measured with cc invoked by hand.
       A program built by m9c should not be slower than the same
       program built by the same compiler by somebody who knew. *)
    Word ('-O2') ;
    FpWords () ;
    (* -flto, for the same reason and with a bigger number.  An M9
       program is MANY translation units by construction -- one per
       module, plus the runtime -- and every checked call that costs
       anything crosses one of those boundaries: Math.Pow's domain
       test, m9_raise, the module procedures themselves.  Without
       LTO none of them can be inlined and the checks are paid in
       full, at a call.

       Measured on the port's kernel: 0.0134s -> 0.0088s, which is
       FASTER than the gfortran original's 0.0097s, and still bit
       identical to it (14/14 checks).  It costs 2% of build time
       (m9c itself: 5.51s -> 5.63s) and gives back 7% of the binary
       (469,448 -> 436,808 bytes).

       This is also what makes the checks affordable in general, and
       it is why the descriptor-hoisting work this replaced was
       dropped: hoisting the GRID descriptor into locals by hand,
       ON TOP of LTO, was worth 3% (0.0088 -> 0.0085).  LTO already
       does it.  See the port's README. *)
    (* =auto on macOS, which is what the measurement further down
       says Linux wants and has not been given: the platform is new,
       so there is no build whose flags this changes, and the bundled
       gcc warns about serial LTRANS jobs on every link of two
       partitions without it (measured 2026-09-29: 1.25 s and the
       warning, 1.03 s and quiet).  Apple's cc takes the spelling. *)
    IF macos THEN Word ('-flto=auto') ELSE Word ('-flto') END ;
    (* ON WINDOWS, ONE LTO PARTITION.  gcc runs its LTRANS stage in
       parallel through a Makefile it writes and a `make` it looks
       for on PATH; the bundled ucrt64\ carries no make (MSYS2 ships
       it as a separate package), so every link of two or more
       partitions falls back to serial and says so --
         lto-wrapper.exe: warning: using serial compilation of 2 LTRANS jobs
       -- on hello world, every time.  -flto=auto and -flto=4 warn
       just the same THERE, measured under wine: with no make, the
       job count cannot help.  One partition has nothing to
       parallelise and so nothing to warn about, and it was serial
       anyway.  Measured on two real links under wine, and it goes
       BOTH WAYS, which is why neither number is claimed as the rule:
       m9c's own link 21.1 s -> 19.8 s and 945,222 -> 922,650 bytes
       (one partition inlines across the whole program), m9setup's
       4.4 s -> 4.4 s and 151,466 -> 152,935.  Under a percent or two
       either side of nothing; what it buys is the warning's absence.

       AND THE FIRST VERSION OF THIS COMMENT SAID "not on Linux,
       where a jobserver or the CPU count is found and the note never
       appears".  THAT WAS WRONG, and a two-partition Linux link
       found it the same day: plain -flto IS -flto=1, so gcc 15 warns
       there too, with /usr/bin/make right where it looks.  Measured
       on one program, gcc 15, 24 cores:
         -flto                 1737 ms  117,784 B  warns
         -flto=1               1732 ms  117,784 B  warns
         -flto=auto            1357 ms  117,784 B  quiet
         -flto -partition=one  1771 ms  119,720 B  quiet
       So Linux wants -flto=auto -- quieter, 22% off the link, same
       bytes -- and Windows cannot use it, having no make to run the
       jobs.  The Linux half is NOT changed here: it is every build's
       flags, it belongs in its own commit with its own measurement,
       and it is in the owed ledger.  The tutor gate's log has been
       carrying that warning unnoticed for as long as it has existed,
       which is the other half of the finding. *)
    IF windows THEN Word ('-flto-partition=one') END ;
    (* AND THE INLINER'S BUDGET, because the checks spend it.  gcc
       auto-inlines only functions under max-inline-insns-auto,
       default 15, and a checked M9 body rarely fits: every access
       carries its bounds test and every checked op its overflow
       test, so the small helpers a hot loop calls -- measured on
       the port's vertical transform, where Lerp and HeightStep are
       called per grid point -- stay CALLS, and each call
       re-marshals its GRID descriptors.  At 200 the transform runs
       2.4x faster (1.033 s -> 0.424 s a field, checksum identical),
       which is MORE than removing the checks outright buys (0.563):
       the checks were never the cost; the inlining they suppressed
       was.  Binary +27%, build time the same to the second.  clang
       ignores the flag with a warning, so $CC=clang still builds.
       Two words, as cc receives them: the shell used to split them
       and there is no shell now. *)
    (* not to the system's cc on macOS, which is clang and says so
       on every build; the bundled gcc, and a $CC, get it as ever *)
    IF NOT (macos AND Text.Eq (CcName (), 'cc')) THEN
      Word ('--param') ;
      Word ('max-inline-insns-auto=200')
    END ;
    MacFlags () ;
    (* -fPIC only when asked, and --so asks.  Not the default,
       because on x86-64 it costs an indirection on every global and
       the overwhelming majority of these objects go into a program
       or an archive, where it buys nothing. *)
    IF doPic THEN Word ('-fPIC') END ;
    (* -g ADDS, and changes nothing else.  Not -O0: silently dropping
       the optimisation under a flag that says "debug information" is
       flag-dependent semantics, which is the thing this language
       refuses by name.  The line tables are optimised-code line
       tables, and a caller who wants -O0 takes the line over. *)
    IF debug THEN Word ('-g') END ;
    (* -iquote, never -I: on a case-insensitive filesystem a generated
       Time.h on the angled path answers #include <time.h>, and the
       failure that produces is a missing struct definition rather
       than a missing file *)
    Word ('-iquote') ;
    Word (rt) ;
    Word ('-iquote') ;
    Word ('.')
  END ;

  Word (cfile) ;

  (* the link line, when m9c is supplying it: the closure's objects,
     the runtime, and the system libraries the runtime needs *)
  IF doLink AND ccFrom = 0 THEN
    IF NOT AddObjects () THEN RETURN FALSE END ;
    IF NOT AddRuntime (rt) THEN RETURN FALSE END ;
    SystemLibs ()
  END ;

  Word ('-o') ;
  Word (out) ;
  rc := Run (CcName ()) ;
  IF rc # 0 THEN
    Io.ErrLine ('m9c: the C compiler reported errors') ;
    RETURN FALSE
  END ;
  RETURN TRUE
END Compile ;

(* The closure, as a library instead of a program.

   THE SAME OBJECTS AND THE SAME RULE.  --ar and --so name exactly
   what -o would have linked -- the modules m9c resolved, parsed and
   checked a moment ago -- so a library cannot hold a different set
   of modules from the program built from the same command line.  A
   missing object is NAMED with the command that makes it, here as
   there.

   WHAT GOES IN, AND WHAT DOES NOT.  An archive holds M9 modules and
   nothing else: the runtime is its own deliverable and already has
   its own archive, and burying a copy of it inside every library is
   how two versions of m9rt end up in one link.  A SHARED object is
   different -- it has to resolve its own symbols at load time -- so
   the runtime and -lm go into that one, exactly as they go into an
   executable.

   THE HEADERS ARE THE OTHER HALF and are always kept.  A library
   without them is a file nobody can call: `m9c --ar libm9.a M9c.m9`
   leaves M9c.h beside it, and the -c runs that built the closure
   left theirs.  That pair -- the archive and the headers -- is what
   "distribute the compiler without sources" means. *)
PROCEDURE Archive (RO name: UTF) : BOOL
  RAISES ValueRange, IndexError =
VAR
  prog, rt : UTF ;
  i, rc : I64 ;
BEGIN
  NewCommand () ;
  IF doAr THEN
    (* r replace, c create without saying so, s write the index --
       the three every archive wants and the ones ar has meant since
       before any of this *)
    prog := ArName () ;
    Word ('rcs') ;
    Word (lib)
  ELSE
    prog := CcName () ;
    Word ('-shared') ;
    IF ccFrom > 0 THEN
      (* the caller took the line over at the compile step and keeps
         it here: adding underneath a chosen flag is worse than
         adding nothing *)
      FOR i := ccFrom TO Io.ArgCount () - 1 DO Word (Io.ArgUtf (pool, i)) END
    ELSE
      (* -fPIC AGAIN, and this is the one that is easy to miss: the
         runtime arrives as SOURCES, so this command compiles m9rt.c
         and tcpshim.c on the way through, and gcc does NOT imply
         -fPIC from -shared.  Without it the members are all position
         independent and the link still fails, on
           relocation R_X86_64_PC32 against `stderr@@GLIBC_2.2.5'
         out of a temporary object nobody named.  Measured, not
         guessed: that is exactly what the first --so run said. *)
      Word ('-O2') ;
      FpWords () ;
      IF macos THEN Word ('-flto=auto') ELSE Word ('-flto') END ;
      IF windows THEN Word ('-flto-partition=one') END ;
      MacFlags () ;
      Word ('-fPIC') ;
      Word ('-iquote') ;
      Word (RtDir ()) ;
      Word ('-iquote') ;
      Word ('.')
    END ;
    Word ('-o') ;
    Word (lib)
  END ;
  Word (Suffix (name, '.o')) ;
  IF NOT AddObjects () THEN RETURN FALSE END ;
  IF doSo AND ccFrom = 0 THEN
    rt := RtDir () ;
    IF Text.BLen (rt) = 0 THEN
      Io.ErrLine ('m9c: cannot find the M9 runtime headers.') ;
      RETURN FALSE
    END ;
    IF NOT AddRuntime (rt) THEN RETURN FALSE END ;
    SystemLibs ()
  END ;
  rc := Run (prog) ;
  IF rc # 0 THEN
    IF doAr THEN
      Io.ErrLine ('m9c: ar reported errors')
    ELSE
      Io.ErrLine ('m9c: the C compiler reported errors building the') ;
      Io.ErrLine ('  shared object.  If it said') ;
      Io.ErrLine ('    relocation R_X86_64_PC32 ... recompile with -fPIC') ;
      Io.ErrLine ('  then a member was compiled without position') ;
      Io.ErrLine ('  independence, which happens when the closure was') ;
      Io.ErrLine ('  built with its own flags after -- (m9c own defaults') ;
      Io.ErrLine ('  include -flto, and an LTO object is made position') ;
      Io.ErrLine ('  independent when the shared object is linked).') ;
      Io.ErrLine ('  Rebuild those modules asking for it:') ;
      Io.ErrLine ('    m9c -c --pic MODULE')
    END ;
    RETURN FALSE
  END ;
  RETURN TRUE
END Archive ;

(* a by-product that will not delete is worth a word, not a raise:
   the object it came from was still built *)
PROCEDURE Drop (RO path: UTF) RAISES ValueRange =
BEGIN
  IF NOT Io.Remove (path) THEN
    Io.ErrLine ('m9c: could not remove the generated C') ;
    Io.ErrLine (path)
  END
END Drop ;

(* Written out rather than generated from a table: there are six
   lines of it, and a help text that drifts from the behaviour is
   worse than none.  Exit codes are part of the interface, so they
   are documented here and not only in the source.               *)
(* What the language IS, before what the flags do.  Someone typing
   --help cold has no reason to know either, and a compiler that opens
   with its option table assumes a reader it has not earned.  Four
   sentences: the family, the promise, the price, the shape.  Every
   claim here is one the repository can show -- the 3% is measured,
   not adjectival. *)
PROCEDURE About () =
BEGIN
  Io.WriteLine ('m9c -- the M9 compiler.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('M9 is a Wirth-family language (Modula-2, Oberon) for') ;
  Io.WriteLine ('code that is written quickly and audited slowly: data') ;
  Io.WriteLine ('science, finance, research infrastructure.  It reads') ;
  Io.WriteLine ('like a bank statement and refuses to compile the') ;
  Io.WriteLine ('mistakes those programs actually make.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('It is designed for code an AI agent writes and a') ;
  Io.WriteLine ('person is answerable for.  A generator is fluent and') ;
  Io.WriteLine ('confident and has no memory of what went wrong last') ;
  Io.WriteLine ('time, so the checks below are the ones that catch what') ;
  Io.WriteLine ('fluency misses: a width that silently truncated, a') ;
  Io.WriteLine ('case arm nobody wrote, a failure never declared, a') ;
  Io.WriteLine ('pointer read without asking.  Each is refused at') ;
  Io.WriteLine ('compile time, so the reviewer reads the intent instead') ;
  Io.WriteLine ('of hunting for the omission -- and what the compiler') ;
  Io.WriteLine ('accepts, it has proved, rather than found plausible.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  Exact-width types only (I64, F64, U8 ...), and no') ;
  Io.WriteLine ('  implicit conversion between any two of them.') ;
  Io.WriteLine ('  Bounds and overflow checks are SEMANTICS, not flags:') ;
  Io.WriteLine ('  there is no switch to turn them off, and they cost') ;
  Io.WriteLine ('  about 3% -- measured, on this compiler, twice.') ;
  Io.WriteLine ('  No NIL.  OPT plus IS SOME, so a pointer that might') ;
  Io.WriteLine ('  be absent cannot be read without asking.') ;
  Io.WriteLine ('  Every exception a procedure can raise is in its') ;
  Io.WriteLine ('  signature, and the checker proves the list complete.') ;
  Io.WriteLine ('  CASE over a variant record must cover every arm.') ;
  Io.WriteLine ('  Memory is POOLs and owned pointers, with borrows') ;
  Io.WriteLine ('  checked at the parameter -- no collector, no free()') ;
  Io.WriteLine ('  you can get wrong.') ;
  Io.WriteLine ('  Foreign C is declared, typed, and marked [SERIAL] or') ;
  Io.WriteLine ('  [REENTRANT]; calling a serial one from a thread is a') ;
  Io.WriteLine ('  compile error.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Every one of those rules exists because a real program') ;
  Io.WriteLine ('failed without it, and the language report says which.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('m9c emits C11 and hands it to a C compiler, so an M9') ;
  Io.WriteLine ('program links against anything C links against.') ;
  Io.WriteLine ('')
END About ;

PROCEDURE Help () RAISES ValueRange =
BEGIN
  About () ;
  Io.WriteLine ('usage: m9c [options] FILE.m9 [DEP.m9 ...] [-- CCFLAGS]') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Checks FILE.m9 and writes NAME.h and NAME.c into the') ;
  Io.WriteLine ('working directory, where NAME is the file base name.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Imports are resolved against the search path, so the') ;
  Io.WriteLine ('dependencies usually need not be named at all.  A') ;
  Io.WriteLine ('DEP.m9 given anyway wins over the path: a path someone') ;
  Io.WriteLine ('typed is a statement about which file they meant.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('The path is -I directories (leftmost first), then') ;
  Io.WriteLine ('$M9LIBRARY (separated as $PATH is), then the') ;
  Io.WriteLine ("directory FILE.m9 itself came from -- a module's") ;
  Io.WriteLine ('neighbours are almost always its imports -- and last') ;
  Io.WriteLine ('the installed library, if there is one.  This m9c') ;
  Io.WriteLine ('looks for its own library beside itself first, and') ;
  Io.WriteLine ("for the package's when it has none:") ;
  Io.WriteLine ('') ;
  Io.Write ('  ') ;
  Io.WriteLine (LibPlace ()) ;
  Io.WriteLine ('') ;
  Io.WriteLine ('FROM u IMPORT ... is not resolved: u is a foreign unit') ;
  Io.WriteLine ('backed by C, so there is no u.m9 and looking for one') ;
  Io.WriteLine ('would invent it.  Those still come from --.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('One module per run.  The compiler holds exactly one') ;
  Io.WriteLine ("module's registries, and a process is the reset.") ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Nothing is written if the checker rejects the program.') ;
  Io.WriteLine ('Diagnostics go to stderr, output files to disk, and') ;
  Io.WriteLine ('the exit status is 0 on success and 1 on any error.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  -I DIR, -IDIR    look for imported modules here') ;
  Io.WriteLine ('  -c               compile NAME.c to NAME.o with the') ;
  Io.WriteLine ('                   C compiler ($CC, or cc)') ;
  Io.WriteLine ('  -o EXE           compile and link, naming the result') ;
  Io.WriteLine ('  --ar LIB.a       compile, then archive the closure') ;
  Io.WriteLine ('  --so LIB.so      compile, then link the closure into') ;
  Io.WriteLine ('                   a shared object (implies --pic)') ;
  Io.WriteLine ('  --make           rebuild the stale part of the') ;
  Io.WriteLine ('                   import closure, deepest first:') ;
  Io.WriteLine ('                   older than its source, or') ;
  Io.WriteLine ('                   downstream of something rebuilt') ;
  Io.WriteLine ('  --run FILE.m9 [ARG ...]') ;
  Io.WriteLine ('                   build FILE.m9 into the cache and') ;
  Io.WriteLine ('                   run it with the ARGs; the last') ;
  Io.WriteLine ('                   option, only -I, -v and --no-unsafe') ;
  Io.WriteLine ('                   before it') ;
  Io.WriteLine ('  --cell FILE.m9   build FILE.m9 and its closure as shared') ;
  Io.WriteLine ('                   objects for the notebook session and') ;
  Io.WriteLine ('                   print what it loads; Linux and macOS') ;
  Io.WriteLine ('  --show           before --run or --cell: FILE holds an') ;
  Io.WriteLine ('                   expression, shown by the procedure') ;
  Io.WriteLine ('                   for its type (a notebook cell)') ;
  Io.WriteLine ('  --prefix MOD=NAME') ;
  Io.WriteLine ('                   emit module MOD under the C name NAME:') ;
  Io.WriteLine ('                   a notebook state cell run again') ;
  Io.WriteLine ('  --out-dir DIR    write NAME.h and NAME.c into DIR;') ;
  Io.WriteLine ('                   not with -c, -o, --ar, --so, --doc') ;
  Io.WriteLine ('  -g               debug information; keeps the C') ;
  Io.WriteLine ('                   it names, and changes nothing') ;
  Io.WriteLine ('                   else -- still -O2, still -flto') ;
  Io.WriteLine ('  --check          check only, the generator included; write nothing') ;
  Io.WriteLine ('  --utf-str        STR is the UTF-8 text type: the switch of') ;
  Io.WriteLine ('                   docs/utf8-stage4-plan.md, rehearsed') ;
  Io.WriteLine ('  --review         --check, then print the review page:') ;
  Io.WriteLine ('                   what was proved, what a person') ;
  Io.WriteLine ('                   decided, what is trusted') ;
  Io.WriteLine ('  --doc            write NAME.md, the DEFINITION') ;
  Io.WriteLine ('                   module as documentation, and') ;
  Io.WriteLine ('                   nothing else') ;
  Io.WriteLine ('  --json           with --doc, also NAME.json: the') ;
  Io.WriteLine ('                   same declarations as data, for') ;
  Io.WriteLine ('                   tools that look a name up') ;
  Io.WriteLine ('  --pic            compile position-independent; only') ;
  Io.WriteLine ('                   needed for a --so member built with') ;
  Io.WriteLine ('                   its own flags after --') ;
  Io.WriteLine ('  -k, --keep-c     keep the generated C afterwards') ;
  Io.WriteLine ('  --no-unsafe      refuse UNSAFE and FOR "C" units') ;
  Io.WriteLine ('                   everywhere but $M9LIBRARY and the') ;
  Io.WriteLine ('                   installed library -- the language') ;
  Io.WriteLine ('                   wall for running untrusted code') ;
  Io.WriteLine ('  -v, --verbose    show the command handed to the') ;
  Io.WriteLine ('                   C compiler; a bare -v with no') ;
  Io.WriteLine ('                   file prints the version instead') ;
  Io.WriteLine ('  --version        print the version and exit') ;
  Io.WriteLine ('  --               pass everything after this to the') ;
  Io.WriteLine ('                   C compiler, verbatim -- and turn') ;
  Io.WriteLine ('                   OFF every default below') ;
  Io.WriteLine ('  -?, -h, --help, --usage') ;
  Io.WriteLine ('                   this text') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Without -c or -o the C is the output and stays.  With') ;
  Io.WriteLine ('either, it is a by-product and is removed once the') ;
  Io.WriteLine ('object exists, unless --keep-c.  -c keeps NAME.h even') ;
  Io.WriteLine ("so: it is the module's interface, and the next") ;
  Io.WriteLine ('module includes it.  -o removes both, since nothing') ;
  Io.WriteLine ('downstream is left to include anything.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('With nothing after --, m9c supplies the flags it') ;
  Io.WriteLine ('can establish by LOOKING rather than guessing:') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('    -O2, because a compiler that ships an') ;
  Io.WriteLine ('    unoptimised build by default is not what') ;
  Io.WriteLine ('    anybody wants and nobody was told to ask') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('    -flto, because an M9 program is many') ;
  Io.WriteLine ('    translation units by construction and every') ;
  Io.WriteLine ('    checked call crosses one: without it the') ;
  Io.WriteLine ('    checks are paid at a call.  Worth 34% on a') ;
  Io.WriteLine ('    real kernel, 2% of build time, -7% of binary') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('    the includes, as -iquote RT and -iquote .,') ;
  Io.WriteLine ('    where RT is $M9RUNTIME when it is set, else the') ;
  Io.WriteLine ("    runtime beside this compiler (its own tree's or") ;
  Io.WriteLine ("    install's), else the package's headers, else") ;
  Io.WriteLine ('    runtime/ or ../runtime/ from here') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('    and, when linking, one object per module in the') ;
  Io.WriteLine ('    import closure it has just resolved, plus the') ;
  Io.WriteLine ('    runtime -- its sources when they are beside the') ;
  Io.WriteLine ('    header that was included, else the installed') ;
  Io.WriteLine ("    archive -- then what the closure's FOR 'C' units") ;
  Io.WriteLine ('    LINK (a library name as -lNAME, a -word as it is,') ;
  Io.WriteLine ('    a shim .c beside the runtime; NetCDF, Grib,') ;
  Io.WriteLine ('    ZarrStore and Pg name theirs), then -lssl -lcrypto') ;
  Io.WriteLine ('    (as-needed; the runtime carries the TLS shim Http') ;
  Io.WriteLine ('    binds) and -lm') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('--doc checks the module and then writes NAME.md') ;
  Io.WriteLine ('instead of C: the module comment, then every') ;
  Io.WriteLine ('exported name with its signature and its own') ;
  Io.WriteLine ('comment.  It still CHECKS -- documentation for a') ;
  Io.WriteLine ('program the checker rejects describes a program') ;
  Io.WriteLine ('that does not exist -- and it fails if a') ;
  Io.WriteLine ('documented parameter is not in its signature,') ;
  Io.WriteLine ('which is drift rather than a gap.  How MUCH is') ;
  Io.WriteLine ('documented is reported under -v and never gated.') ;
  Io.WriteLine ('--json (which implies --doc) also writes NAME.json:') ;
  Io.WriteLine ('every exported name with its kind, line, parameters') ;
  Io.WriteLine ('and their modes, result, RAISES and comment, as') ;
  Io.WriteLine ('data -- so "does M.P exist and what does it take"') ;
  Io.WriteLine ('is a lookup and not a guess.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('--run is for programs run often and edited often.') ;
  Io.WriteLine ('Each module is compiled once, at -O2 without -flto,') ;
  Io.WriteLine ('into $M9CACHE (else ~/.cache/m9, %LOCALAPPDATA%\m9') ;
  Io.WriteLine ('on Windows), keyed by its source text and its') ;
  Io.WriteLine ("imports'; a program whose text has not changed is") ;
  Io.WriteLine ('run straight from the cache, and one that has is') ;
  Io.WriteLine ('checked and compiled alone.  The program replaces') ;
  Io.WriteLine ('m9c: its exit status is the status, and it is told') ;
  Io.WriteLine ('FILE.m9 as its own name.  On Linux and macOS a file') ;
  Io.WriteLine ('beginning  #!/usr/bin/m9c --run  is a script.  The') ;
  Io.WriteLine ('cache is never cleaned; removing it is always safe.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('--ar and --so take that same closure and make a') ;
  Io.WriteLine ('LIBRARY of it instead of a program.  The archive') ;
  Io.WriteLine ('holds M9 modules only -- the runtime is its own') ;
  Io.WriteLine ('deliverable and has its own archive, and a copy of it') ;
  Io.WriteLine ('inside every library is two m9rt in one link.  A') ;
  Io.WriteLine ('shared object resolves its own symbols, so that one') ;
  Io.WriteLine ('does get the runtime and -lm.  Both keep the headers:') ;
  Io.WriteLine ('a library without them is a file nobody can call.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('A missing object is named, with the command that') ;
  Io.WriteLine ('makes it, because the C linker would report our') ;
  Io.WriteLine ('omission in its own vocabulary.  Put anything after') ;
  Io.WriteLine ('-- and none of this happens: a default added') ;
  Io.WriteLine ('underneath a flag someone chose is worse than no') ;
  Io.WriteLine ('default at all.') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Examples, from the top of a source tree:') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  m9c corpus/Json.m9') ;
  Io.WriteLine ('  cc -c -iquote runtime -iquote . Json.c') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  m9c -c corpus/DynStr.m9') ;
  Io.WriteLine ('  m9c -c corpus/Io.m9') ;
  Io.WriteLine ('  m9c -o hello corpus/Hello.m9') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('Installed, a module NAME is enough: the library is') ;
  Io.Write ('  ') ;
  Io.WriteLine (LibPlace ()) ;
  Io.WriteLine ('and the runtime headers are in') ;
  Io.Write ('  ') ;
  Io.WriteLine (IncPlace ()) ;
  Io.WriteLine ('so neither is typed:') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  m9c -c DynStr') ;
  Io.WriteLine ('  m9c -c Io') ;
  Io.WriteLine ('  m9c -o hello hello.m9') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('The compiler as a library, headers beside it, and') ;
  Io.WriteLine ('then a program built against it with no M9 source in') ;
  Io.WriteLine ('sight:') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  for m in DynStr Text Io Lex Ast Parse Print Sem Gen') ;
  Io.WriteLine ('  do m9c -c corpus/$m.m9 ; done') ;
  Io.WriteLine ('  m9c --ar libm9.a corpus/M9c.m9') ;
  Io.WriteLine ('  cc prog.c libm9.a -lm9rt -lssl -lcrypto -lm') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('And when a default is wrong, take the line over:') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('  m9c -c corpus/Json.m9 -- -O2 -iquote runtime') ;
  Io.WriteLine ('') ;
  Io.WriteLine ('See m9c(1) for the whole story.') ;
  Io.WriteLine ('M9 -- checks are semantics, not flags.')
END Help ;

(* One pass over the command line, before anything is read.  Options
   set flags, -- ends them, and everything else is a source file; a
   file is recognised by not being an option rather than by its
   suffix, so a path that starts with a dash is a diagnosable mistake
   and not a silently ignored argument.                             *)
(* -Idir joined.  Guarded here rather than at each call site: a
   predicate that raises on the empty string is one every caller has
   to remember, and the reminder is a bug waiting. *)
PROCEDURE IsDashI (RO a: UTF) : BOOL =
BEGIN
  IF Text.BLen (a) < 3 THEN RETURN FALSE END ;
  RETURN Text.StartsWith (a, '-I')
END IsDashI ;

(* where `=' is in s, or -1 *)
PROCEDURE EqAt (RO s: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) = ORD ('=') THEN RETURN i END
  END ;
  RETURN -1
END EqAt ;

(* --prefix MOD=NAME, kept as written: it goes to the generator, to
   every child build, and into the keys *)
PROCEDURE AddPrefix (RO KEPT spec: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF npfxSpec = LEN (pfxSpec) THEN
    nb := NEW (pool, UTF, 2 * npfxSpec + 4) ;
    FOR i := 0 TO npfxSpec - 1 DO nb[i] := pfxSpec[i] END ;
    pfxSpec := nb
  END ;
  pfxSpec[npfxSpec] := spec ;
  npfxSpec := npfxSpec + 1
END AddPrefix ;

(* the C prefix --prefix gave module m, or empty *)
PROCEDURE PrefixOf (RO m: UTF) : UTF =
VAR i, e : I64 ;
BEGIN
  FOR i := 0 TO npfxSpec - 1 DO
    e := EqAt (pfxSpec[i]) ;
    IF Text.Eq (SLICE (pfxSpec[i], 0, e), m) THEN
      RETURN SLICE (pfxSpec[i], e + 1, Text.BLen (pfxSpec[i]) - e - 1)
    END
  END ;
  RETURN ''
END PrefixOf ;

PROCEDURE ScanArgs () RAISES ValueRange, IndexError =
VAR
  i : I64 ;
  a : UTF ;
BEGIN
  i := 1 ;
  WHILE i < Io.ArgCount () DO
    a := Io.ArgUtf (pool, i) ;
    IF Text.Eq (a, '--') THEN
      ccFrom := i + 1 ;
      RETURN
    ELSIF Text.Eq (a, '-c') THEN
      doCompile := TRUE
    ELSIF Text.Eq (a, '-k') OR Text.Eq (a, '--keep-c') THEN
      keepC := TRUE
    ELSIF Text.Eq (a, '--no-unsafe') THEN
      noUnsafe := TRUE
    ELSIF Text.Eq (a, '--utf-str') THEN
      (* set the moment it is read: --run and --cell leave the option
         loop before the validation below, and compile the closure
         in-process *)
      utfStr := TRUE ;
      Sem.SetStrUtf (TRUE) ;
      Gen.SetStrUtf (TRUE)
    ELSIF Text.Eq (a, '-v') OR Text.Eq (a, '--verbose') THEN
      verbose := TRUE
    ELSIF Text.Eq (a, '--version') THEN
      doVersion := TRUE
    ELSIF Text.Eq (a, '-o') THEN
      IF i + 1 >= Io.ArgCount () THEN
        Io.ErrLine ('m9c: -o wants a name') ;
        failed := TRUE ;
        RETURN
      END ;
      exe := Io.ArgUtf (pool, i + 1) ;
      doLink := TRUE ;
      doCompile := TRUE ;
      i := i + 1
    ELSIF Text.Eq (a, '--pic') THEN
      doPic := TRUE
    ELSIF Text.Eq (a, '--check') THEN
      doCheck := TRUE
    ELSIF Text.Eq (a, '--review') THEN
      (* implies --check: the page is printed for a program that
         exists, and nothing is written beside it *)
      doReview := TRUE ;
      doCheck := TRUE
    ELSIF Text.Eq (a, '--doc') THEN
      doDoc := TRUE
    ELSIF Text.Eq (a, '--json') THEN
      (* implies --doc: the JSON is the same gather rendered twice,
         and a run that wrote the data without the page would be a
         run whose two documents could not be compared *)
      doJson := TRUE ;
      doDoc := TRUE
    ELSIF Text.Eq (a, '--make') THEN
      doMake := TRUE
    ELSIF Text.Eq (a, '--show') THEN
      doShow := TRUE
    ELSIF Text.Eq (a, '--type-of') THEN
      doTypeOf := TRUE
    ELSIF Text.Eq (a, '--cell') THEN
      (* --run's twin for the notebook session: the file follows *)
      IF i + 1 >= Io.ArgCount () THEN
        Io.ErrLine ('m9c: --cell wants a file') ;
        failed := TRUE ;
        RETURN
      END ;
      doCell := TRUE ;
      runAt := i + 1 ;
      RETURN
    ELSIF Text.Eq (a, '--run') THEN
      (* the LAST option: the file follows, and every word after the
         file is the program's, whatever it looks like -- a script's
         `-v` is not this compiler's *)
      IF i + 1 >= Io.ArgCount () THEN
        Io.ErrLine ('m9c: --run wants a file') ;
        failed := TRUE ;
        RETURN
      END ;
      doRun := TRUE ;
      runAt := i + 1 ;
      RETURN
    ELSIF Text.Eq (a, '--prefix') THEN
      IF i + 1 >= Io.ArgCount () OR EqAt (Io.ArgUtf (pool, i + 1)) < 1 THEN
        Io.ErrLine ('m9c: --prefix wants MODULE=NAME') ;
        failed := TRUE ;
        RETURN
      END ;
      AddPrefix (Io.ArgUtf (pool, i + 1)) ;
      i := i + 1
    ELSIF Text.Eq (a, '--out-dir') THEN
      IF i + 1 >= Io.ArgCount () THEN
        Io.ErrLine ('m9c: --out-dir wants a directory') ;
        failed := TRUE ;
        RETURN
      END ;
      outDir := Io.ArgUtf (pool, i + 1) ;
      i := i + 1
    ELSIF Text.Eq (a, '-g') THEN
      (* -g IMPLIES --keep-c, and it has to.  The debug information
         names NAME.c, so dropping NAME.c leaves a debugger pointing
         at a file that is not there -- which is what -g meant before
         this flag existed, when the only way to ask was to take the
         whole cc line over with --. *)
      debug := TRUE ;
      keepC := TRUE
    ELSIF Text.Eq (a, '--ar') OR Text.Eq (a, '--so') THEN
      IF i + 1 >= Io.ArgCount () THEN
        Diag ('m9c: ', a, ' wants a library name') ;
        failed := TRUE ;
        RETURN
      END ;
      IF Text.BLen (lib) > 0 THEN
        Io.ErrLine ('m9c: one library per run, and two were named') ;
        failed := TRUE ;
        RETURN
      END ;
      lib := Io.ArgUtf (pool, i + 1) ;
      doCompile := TRUE ;
      IF Text.Eq (a, '--ar') THEN
        doAr := TRUE
      ELSE
        doSo := TRUE ;
        (* free on the LTO path and necessary off it, so it is not
           worth making the caller remember which one they are on *)
        doPic := TRUE
      END ;
      i := i + 1
    ELSIF Text.Eq (a, '-I') THEN
      IF i + 1 >= Io.ArgCount () THEN
        Io.ErrLine ('m9c: -I wants a directory') ;
        failed := TRUE ;
        RETURN
      END ;
      DirAdd (Io.ArgUtf (pool, i + 1), FALSE) ;
      i := i + 1
    ELSIF Text.BLen (a) > 2 AND IsDashI (a) THEN
      (* -Idir joined, as cc spells it: the habit is older than this
         compiler and arguing with it costs more than honouring it *)
      DirAdd (SLICE (a, 2, Text.BLen (a) - 2), FALSE)
    ELSIF Text.BLen (a) > 1 AND B (a, 0) = ORD ('-') THEN
      (* an option nobody declared was taken for a source file and
         said `cannot find: --frobnicate' (the review's F6) *)
      Io.ErrLine (Cat ('m9c: unknown option ', Cat (a, " -- 'm9c --help' lists them"))) ;
      failed := TRUE ;
      RETURN
    END ;
    i := i + 1
  END
END ScanArgs ;

(* the i'th source file on the command line, or empty when there is
   no i'th one.  Options are skipped here rather than compacted into
   a list, because the language has no growable STR array in this
   module and an index walk needs neither.                          *)
PROCEDURE SourceAt (n: I64) : UTF RAISES ValueRange, IndexError =
VAR
  i, seen : I64 ;
  a : UTF ;
BEGIN
  seen := 0 ;
  i := 1 ;
  WHILE i < Io.ArgCount () DO
    a := Io.ArgUtf (pool, i) ;
    IF Text.Eq (a, '--') THEN RETURN '' END ;
    IF Text.Eq (a, '--run') OR Text.Eq (a, '--cell') THEN
      (* the one source, and nothing after it is another *)
      IF n = seen AND i + 1 < Io.ArgCount () THEN
        RETURN Io.ArgUtf (pool, i + 1)
      END ;
      RETURN ''
    END ;
    IF Text.Eq (a, '-o') OR Text.Eq (a, '-I') OR
       Text.Eq (a, '--ar') OR Text.Eq (a, '--so') OR
       Text.Eq (a, '--out-dir') OR Text.Eq (a, '--prefix') THEN
      i := i + 1
    ELSIF Text.Eq (a, '-c') OR Text.Eq (a, '-k') OR
          Text.Eq (a, '--keep-c') OR Text.Eq (a, '-v') OR
          Text.Eq (a, '--verbose') OR Text.Eq (a, '--pic') OR
          Text.Eq (a, '--doc') OR Text.Eq (a, '-g') OR
          Text.Eq (a, '--json') OR Text.Eq (a, '--check') OR
          Text.Eq (a, '--review') OR
          Text.Eq (a, '--make') OR
          Text.Eq (a, '--show') OR Text.Eq (a, '--type-of') OR
          Text.Eq (a, '--no-unsafe') OR Text.Eq (a, '--utf-str') OR
          IsDashI (a) THEN
      i := i
    ELSE
      IF seen = n THEN RETURN a END ;
      seen := seen + 1
    END ;
    i := i + 1
  END ;
  RETURN ''
END SourceAt ;

PROCEDURE IsHelp (RO a: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (a, '--help') OR Text.Eq (a, '-h') OR
         Text.Eq (a, '-?') OR Text.Eq (a, '--usage')
END IsHelp ;

PROCEDURE Complain (RO what: UTF ; RO path: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, what) ;
  DynUtf.Append (d, ': ') ;
  Diag ('m9c: ', DynUtf.ViewIn (pool, d), path) ;
  failed := TRUE
END Complain ;

(* ---- --run: the cache ----

   `m9c --run Prog.m9 ARG...` is what a script interpreter is from the
   outside and is not one inside: the program is checked and compiled
   exactly as -o would, then this process BECOMES it.  What makes it
   fast enough to be typed is that nothing is compiled twice.  Measured
   before it was built (2026-10-04): checking costs 0.01 s, a flagless
   link 1.0 to 1.5 s, almost all of it -flto -- and compiling only the
   program at -O2 against objects compiled once, 0.15 s.

   Everything lives under one directory (CacheRoot):
     mod/NAME-KEY/NAME.h, NAME.o   a module, compiled once
     rt-KEY/*.o                    the runtime, compiled once
     bin/NAME-KEY                  a program, linked once
     tmp/PID/                      this run's scratch
   A KEY is a hash of the TEXT a thing was compiled from -- the
   module's source and the source of everything it imports, however
   far down, since a header includes its imports' headers -- and of
   this compiler, its C compiler and its runtime (Ident).  Never a
   modification time: an edit that is undone is the old key again, and
   a copied file is not a changed one.  A program whose key has a
   binary is run without being checked again, because the same text
   through the same compiler has the same verdict and the binary exists
   only because that verdict was yes.

   No -flto here, deliberately: LTO is what made the flagless link take
   a second, and an object compiled once for every program cannot be
   LTO IR without paying it again at every link.  -O2 and the inliner
   budget stay.  Concurrent runs are safe because every file reaches
   its place by Rename, which is atomic, and two runs that build the
   same key build the same bytes.  Nothing is ever evicted: removing
   the directory is always safe. *)

(* a hash of text: two polynomial residues and the length, written out
   as digits.  Not cryptographic -- a cache key has to tell an edit
   from the original, not resist an attacker who can already write
   the source.  The moduli keep every product inside I64: 131 times
   2^55 and 257 times 2^54 are both under 2^63. *)
PROCEDURE Hash (RO s: UTF) : UTF =
VAR
  d : PTR DynUtf.DString IN pool ;
  i, a, b : I64 ;
BEGIN
  a := 7 ;
  b := 11 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    a := (a * 131 + B (s, i)) MOD 36028797018963913 ;
    b := (b * 257 + B (s, i)) MOD 18014398509481951
  END ;
  d := DynUtf.New (pool) ;
  DynUtf.AppendI64 (d, a) ;
  DynUtf.AppendChar (d, 'x') ;
  DynUtf.AppendI64 (d, b) ;
  DynUtf.AppendChar (d, 'n') ;
  DynUtf.AppendI64 (d, Text.BLen (s)) ;
  RETURN DynUtf.ViewIn (pool, d)
END Hash ;

(* a module's source, hashed as it is parsed: ParseText calls this for
   every file the closure reads, the main one included *)
PROCEDURE Remember (RO name: UTF ; RO src: UTF) =
VAR
  nn, nh : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF nsrc = LEN (srcNames) THEN
    nn := NEW (pool, UTF, 2 * LEN (srcNames) + 16) ;
    nh := NEW (pool, UTF, 2 * LEN (srcNames) + 16) ;
    FOR i := 0 TO nsrc - 1 DO nn[i] := srcNames[i] ; nh[i] := srcHashes[i] END ;
    srcNames := nn ;
    srcHashes := nh
  END ;
  srcNames[nsrc] := Suffix (name, '') ;
  srcHashes[nsrc] := Hash (src) ;
  nsrc := nsrc + 1
END Remember ;

PROCEDURE SrcHash (RO name: UTF) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nsrc - 1 DO
    IF Text.Eq (srcNames[i], name) THEN RETURN srcHashes[i] END
  END ;
  RETURN '?'
END SrcHash ;

(* the key of a module: Ident, then every module reachable from it by
   import, each with its source's hash, in the order a depth-first
   walk meets them -- which the import lists fix, so the same sources
   give the same string *)
PROCEDURE ClosureKey (RO top: UTF) : UTF =
VAR
  seen, stack : SLICE OF UTF ;
  nseen, nstack, i, j : I64 ;
  cur : UTF ;
  dup : BOOL ;
  d : PTR DynUtf.DString IN pool ;
BEGIN
  seen := NEW (pool, UTF, nedge + 2) ;
  stack := NEW (pool, UTF, nedge + 2) ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, ident) ;
  seen[0] := Suffix (top, '') ;
  stack[0] := seen[0] ;
  nseen := 1 ;
  nstack := 1 ;
  WHILE nstack > 0 DO
    nstack := nstack - 1 ;
    cur := stack[nstack] ;
    DynUtf.AppendChar (d, ';') ;
    DynUtf.Append (d, cur) ;
    DynUtf.AppendChar (d, '=') ;
    DynUtf.Append (d, SrcHash (cur)) ;
    IF Text.BLen (PrefixOf (cur)) > 0 THEN
      DynUtf.AppendChar (d, '@') ;
      DynUtf.Append (d, PrefixOf (cur))
    END ;
    FOR i := 0 TO nedge - 1 DO
      IF Text.Eq (edgeFrom[i], cur) THEN
        dup := FALSE ;
        FOR j := 0 TO nseen - 1 DO
          IF Text.Eq (seen[j], edgeTo[i]) THEN dup := TRUE END
        END ;
        IF NOT dup THEN
          seen[nseen] := edgeTo[i] ;
          nseen := nseen + 1 ;
          stack[nstack] := edgeTo[i] ;
          nstack := nstack + 1
        END
      END
    END
  END ;
  RETURN Hash (DynUtf.ViewIn (pool, d))
END ClosureKey ;

(* where the cache is: $M9CACHE, else the platform's cache directory
   -- %LOCALAPPDATA% on Windows, $XDG_CACHE_HOME, ~/.cache -- each
   with m9 under it; empty when none of them is set *)
PROCEDURE CacheRoot () : UTF RAISES ValueRange =
VAR v : UTF ;
BEGIN
  v := Io.EnvUtf (pool, 'M9CACHE') ;
  IF Text.BLen (v) > 0 THEN RETURN v END ;
  IF windows THEN
    v := Io.EnvUtf (pool, 'LOCALAPPDATA') ;
    IF Text.BLen (v) > 0 THEN RETURN Join (v, 'm9') END
  END ;
  v := Io.EnvUtf (pool, 'XDG_CACHE_HOME') ;
  IF Text.BLen (v) > 0 THEN RETURN Join (v, 'm9') END ;
  v := Io.EnvUtf (pool, 'HOME') ;
  IF Text.BLen (v) > 0 THEN RETURN Join (v, '.cache/m9') END ;
  RETURN ''
END CacheRoot ;

(* a directory and every directory above it that is missing.  The
   levels above may refuse (a drive letter, a root this user cannot
   write and that exists anyway); only the last one has to succeed. *)
PROCEDURE TryMkDir (RO path: UTF) =
BEGIN
  Io.MkDir (path)
EXCEPT
| Io.IOError (p) :
    RETURN
| ValueRange :
    RETURN
END TryMkDir ;

PROCEDURE MkDirs (RO path: UTF) RAISES ValueRange, Io.IOError =
VAR i : I64 ;
BEGIN
  FOR i := 1 TO Text.BLen (path) - 1 DO
    IF B (path, i) = ORD ('/') OR B (path, i) = 92 THEN TryMkDir (SLICE (path, 0, i)) END
  END ;
  Io.MkDir (path)
END MkDirs ;

(* this compiler as a cache key: its version and its binary's time,
   so a rebuilt m9c in a source tree is a new key without a version
   bump, and the C compiler and runtime it would use *)
PROCEDURE Ident () : UTF RAISES ValueRange =
VAR
  d : PTR DynUtf.DString IN pool ;
  self : UTF ;
BEGIN
  self := System.ExecutableUtf (pool) ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, Version) ;
  DynUtf.AppendChar (d, ' ') ;
  DynUtf.AppendI64 (d, Io.ModTime (self)) ;
  DynUtf.AppendChar (d, ' ') ;
  DynUtf.Append (d, CcName ()) ;
  DynUtf.AppendChar (d, ' ') ;
  DynUtf.Append (d, RtDir ()) ;
  (* and the shape of what RunFlags makes, so an object compiled
     without its own sections is never linked by --gc-sections *)
  DynUtf.Append (d, ' sections') ;
  (* the rehearsed switch compiles every module another way *)
  IF utfStr THEN DynUtf.Append (d, ' utf-str') END ;
  RETURN DynUtf.ViewIn (pool, d)
END Ident ;

(* where module order[i] is cached *)
PROCEDURE ModDir (i: I64) : UTF RAISES IndexError =
BEGIN
  (* --cell's objects are position independent and live apart *)
  IF doCell THEN
    RETURN Join (Join (cacheRoot, 'modpic'), Cat (order[i], Cat ('-', keys[i])))
  END ;
  RETURN Join (Join (cacheRoot, 'mod'), Cat (order[i], Cat ('-', keys[i])))
END ModDir ;

(* the C compiler's flags for everything --run compiles: m9c's own
   defaults without -flto (see the section's comment) *)
PROCEDURE RunFlags () RAISES ValueRange =
BEGIN
  Word ('-O2') ;
  FpWords () ;
  IF NOT (macos AND Text.Eq (CcName (), 'cc')) THEN
    Word ('--param') ;
    Word ('max-inline-insns-auto=200')
  END ;
  (* EACH FUNCTION IN A SECTION OF ITS OWN, so that the link can drop
     what nothing calls -- RunGcWords.  Without -flto nothing else
     removes the code a program never reaches, and a module that binds
     a C library the program does not use still names its symbols:
     every program importing Frame failed to link under --run on
     NetCDF's nc_* (measured 2026-10-04, C7Series), where the flagless
     -flto link drops them.  Not on macOS: ld64's -dead_strip, which
     SystemLibs already gives that link, works on atoms and needs no
     sections. *)
  IF NOT macos THEN
    Word ('-ffunction-sections') ;
    Word ('-fdata-sections')
  END ;
  IF doCell THEN Word ('-fPIC') END ;
  MacFlags ()
END RunFlags ;

(* a shared object of the objects on the line so far, its symbols left
   to the session to resolve: on macOS ld64 must be told so *)
PROCEDURE SharedWords () =
BEGIN
  Word ('-shared') ;
  IF macos THEN
    Word ('-undefined') ;
    Word ('dynamic_lookup')
  END
END SharedWords ;

(* the link's half of the above: drop the sections nothing reaches,
   and with them their references into libraries nobody linked *)
PROCEDURE RunGcWords () =
BEGIN
  IF NOT macos THEN Word ('-Wl,--gc-sections') END
END RunGcWords ;

(* every cached module's directory on the include path, then the
   scratch directory, where this run's fresh headers are *)
PROCEDURE RunIncludes (RO KEPT rt: UTF) RAISES IndexError =
VAR i : I64 ;
BEGIN
  Word ('-iquote') ;
  Word (rt) ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) THEN
      Word ('-iquote') ;
      Word (ModDir (i))
    END
  END ;
  Word ('-iquote') ;
  Word (work)
END RunIncludes ;

(* hand over to the binary: argv[0] is the source as it was named,
   the way a script is told its own path, and the rest are the words
   after it on this command line *)
PROCEDURE Launch () RAISES ValueRange, IndexError =
VAR
  args : SLICE OF UTF ;
  i, n : I64 ;
BEGIN
  n := Io.ArgCount () - runAt - 1 ;
  args := NEW (pool, UTF, n) ;
  FOR i := 0 TO n - 1 DO args[i] := Io.ArgUtf (pool, runAt + 1 + i) END ;
  System.BecomeUtf (binPath, Io.ArgUtf (pool, runAt), args) ;
  Diag ('m9c: could not start ', binPath, '') ;
  failed := TRUE ;
  Io.Halt (1)
EXCEPT
| Io.IOError (p) :
    Diag ('m9c: could not start ', UTF (p), '') ;
    failed := TRUE ;
    Io.Halt (1)
END Launch ;

(* the keys, the scratch directory and the binary's name; when the
   binary is already there, nothing else is needed and Launch does not
   come back *)
PROCEDURE RunKeys () RAISES ValueRange, IndexError, Io.IOError =
VAR
  i : I64 ;
  d : PTR DynUtf.DString IN pool ;
BEGIN
  cacheRoot := CacheRoot () ;
  IF Text.BLen (cacheRoot) = 0 THEN
    Io.ErrLine ('m9c: --run has no cache directory: set $M9CACHE') ;
    failed := TRUE ;
    Io.Halt (1)
  END ;
  ident := Ident () ;
  keys := NEW (pool, UTF, norder + 1) ;
  FOR i := 0 TO norder - 1 DO keys[i] := ClosureKey (order[i]) END ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, 'tmp/') ;
  DynUtf.AppendI64 (d, System.ProcessId ()) ;
  work := Join (cacheRoot, DynUtf.ViewIn (pool, d)) ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, 'bin/') ;
  DynUtf.Append (d, modName) ;
  DynUtf.AppendChar (d, '-') ;
  DynUtf.Append (d, ClosureKey (modName)) ;
  IF windows THEN DynUtf.Append (d, '.exe') END ;
  binPath := Join (cacheRoot, DynUtf.ViewIn (pool, d)) ;
  IF doCell THEN
    d := DynUtf.New (pool) ;
    IF cellProgram THEN DynUtf.Append (d, 'cells/') ELSE DynUtf.Append (d, 'modpic/') END ;
    DynUtf.Append (d, modName) ;
    DynUtf.AppendChar (d, '-') ;
    DynUtf.Append (d, ClosureKey (modName)) ;
    DynUtf.Append (d, '/lib') ;
    DynUtf.Append (d, modName) ;
    DynUtf.Append (d, '.so') ;
    cellPath := Join (cacheRoot, DynUtf.ViewIn (pool, d)) ;
    (* warm only when the runtime and the host of THIS key are there
       too: a changed m9session.c is a new runtime key, and a cell
       built before it named a host nobody had built (2026-10-04) *)
    IF Io.Exists (cellPath) AND
       Io.Exists (Join (RtCacheDir (RtDir ()), 'm9session')) AND
       Io.Exists (Join (RtCacheDir (RtDir ()), 'libm9rt.so')) THEN
      CellReport () ;
      Io.Halt (0)
    END ;
    RETURN
  END ;
  IF Io.Exists (binPath) THEN Launch () END
END RunKeys ;

(* one module of the closure, into the cache: its C by THIS compiler
   run again (one module per process, as --make does it), into the
   scratch directory; compiled there; and then its header and its
   object renamed into its own directory, the object last, because
   the object's presence is what says the directory is complete *)
(* is module i of the order built in the cache already? *)
PROCEDURE CacheHas (i: I64) : BOOL RAISES ValueRange, IndexError =
BEGIN
  IF doCell THEN
    RETURN Io.Exists (Join (ModDir (i), Cat ('lib', Suffix (order[i], '.so'))))
  END ;
  RETURN Io.Exists (Join (ModDir (i), Suffix (order[i], '.o')))
END CacheHas ;

(* module i's C and header into work: the first half of CacheModule,
   run for every module ahead of the compiles when the import graph
   has a cycle, so that a member finds its partner's header *)
PROCEDURE CacheGen (i: I64) : BOOL RAISES ValueRange, IndexError, Io.IOError =
VAR
  self, path, src, nm : UTF ;
  found, trusted : BOOL ;
  j, rc : I64 ;
BEGIN
  nm := order[i] ;
  src := FindModule (nm, path, found, trusted) ;
  IF NOT found OR Text.BLen (src) < 0 THEN
    Diag ('m9c: cannot find ', nm, ' again') ;
    RETURN FALSE
  END ;
  self := System.ExecutableUtf (pool) ;
  IF Text.BLen (self) = 0 THEN self := Io.ArgUtf (pool, 0) END ;
  NewCommand () ;
  Word ('--out-dir') ;
  Word (work) ;
  IF noUnsafe THEN Word ('--no-unsafe') END ;
  IF utfStr THEN Word ('--utf-str') END ;   (* the module is generated the same way *)
  FOR j := 0 TO npfxSpec - 1 DO
    Word ('--prefix') ;
    Word (pfxSpec[j])
  END ;
  FOR j := 0 TO ndirs - 1 DO Word (Cat ('-I', dirs[j])) END ;
  Word (path) ;
  rc := Run (self) ;
  IF rc # 0 THEN
    Diag ('m9c: could not generate ', nm, '') ;
    RETURN FALSE
  END ;
  RETURN TRUE
END CacheGen ;

(* an import cycle: every uncached module's header first (CacheGen) --
   a clean build failed on a partner's missing header, a second one
   passed on the first one's leftovers (2026-10-22) *)
PROCEDURE CacheGenAll () : BOOL RAISES ValueRange, IndexError, Io.IOError =
VAR i : I64 ;
BEGIN
  IF NOT importCycle THEN RETURN TRUE END ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) AND NOT CacheHas (i) THEN
      IF NOT CacheGen (i) THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END CacheGenAll ;

PROCEDURE CacheModule (i: I64 ; RO KEPT rt: UTF) : BOOL
  RAISES ValueRange, IndexError, Io.IOError =
VAR
  dir, nm : UTF ;
  rc : I64 ;
BEGIN
  nm := order[i] ;
  dir := ModDir (i) ;
  IF CacheHas (i) THEN RETURN TRUE END ;
  (* generated already when the graph has a cycle (CacheGenAll) *)
  IF NOT importCycle THEN
    IF NOT CacheGen (i) THEN RETURN FALSE END
  END ;
  NewCommand () ;
  RunFlags () ;
  Word ('-c') ;
  RunIncludes (rt) ;
  Word (Join (work, Suffix (nm, '.c'))) ;
  Word ('-o') ;
  Word (Join (work, Suffix (nm, '.o'))) ;
  rc := Run (CcName ()) ;
  IF rc # 0 THEN
    Diag ('m9c: the C compiler reported errors in ', nm, '') ;
    RETURN FALSE
  END ;
  IF doCell THEN
    NewCommand () ;
    SharedWords () ;
    Word (Join (work, Suffix (nm, '.o'))) ;
    Word ('-o') ;
    Word (Join (work, Cat ('lib', Suffix (nm, '.so')))) ;
    rc := Run (CcName ()) ;
    IF rc # 0 THEN
      Diag ('m9c: could not make a shared object of ', nm, '') ;
      RETURN FALSE
    END
  END ;
  MkDirs (dir) ;
  Io.Rename (Join (work, Suffix (nm, '.h')), Join (dir, Suffix (nm, '.h'))) ;
  Io.Rename (Join (work, Suffix (nm, '.o')), Join (dir, Suffix (nm, '.o'))) ;
  IF doCell THEN
    Io.Rename (Join (work, Cat ('lib', Suffix (nm, '.so'))),
               Join (dir, Cat ('lib', Suffix (nm, '.so'))))
  END ;
  Drop (Join (work, Suffix (nm, '.c'))) ;
  RETURN TRUE
END CacheModule ;

(* THE RUNTIME, compiled once per key into rt-KEY/.  Its four sources
   (m9rt and the three shims the flagless link carries, AddRuntime);
   the TLS shim is OpenSSL and does not build under mingw, so not on
   Windows, as there.  Answers the directory, or empty when there are
   no runtime sources to compile -- an installed compiler, whose
   archive the link names as the flagless link does. *)
PROCEDURE RtSource (i: I64) : UTF =
BEGIN
  CASE i OF
  | 0 : RETURN 'm9rt'
  | 1 : RETURN 'tcpshim'
  | 2 : RETURN 'fmtshim'
  ELSE  RETURN 'tlsshim'
  END
END RtSource ;

PROCEDURE RtWanted (RO rt: UTF ; i: I64) : BOOL RAISES ValueRange =
BEGIN
  IF windows AND i = 3 THEN RETURN FALSE END ;
  RETURN Io.Exists (Cat (rt, Cat ('/', Suffix (RtSource (i), '.c'))))
END RtWanted ;

(* where the runtime of this key is cached: rt-KEY, or rtpic-KEY for
   --cell, whose key also covers the session host's source *)
PROCEDURE RtCacheDir (RO rt: UTF) : UTF RAISES ValueRange =
VAR
  d : PTR DynUtf.DString IN pool ;
  found : BOOL ;
  i : I64 ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, ident) ;
  DynUtf.Append (d, TryRead (Cat (rt, '/m9rt.h'), found)) ;
  FOR i := 0 TO 3 DO
    IF RtWanted (rt, i) THEN
      DynUtf.Append (d, TryRead (Cat (rt, Cat ('/', Suffix (RtSource (i), '.c'))), found))
    END
  END ;
  IF doCell THEN
    DynUtf.Append (d, TryRead (Cat (rt, '/m9session.c'), found)) ;
    RETURN Join (cacheRoot, Cat ('rtpic-', Hash (DynUtf.ViewIn (pool, d))))
  END ;
  RETURN Join (cacheRoot, Cat ('rt-', Hash (DynUtf.ViewIn (pool, d))))
END RtCacheDir ;

PROCEDURE CacheRuntime (RO KEPT rt: UTF ; VAR ok: BOOL) : UTF
  RAISES ValueRange, Io.IOError =
VAR
  dir, c, o, tmp : UTF ;
  i, rc : I64 ;
BEGIN
  ok := TRUE ;
  IF NOT Io.Exists (Cat (rt, '/m9rt.c')) THEN RETURN '' END ;
  dir := RtCacheDir (rt) ;
  FOR i := 0 TO 3 DO
    IF RtWanted (rt, i) THEN
      c := Cat (rt, Cat ('/', Suffix (RtSource (i), '.c'))) ;
      o := Join (dir, Suffix (RtSource (i), '.o')) ;
      IF NOT Io.Exists (o) THEN
        tmp := Join (work, Suffix (RtSource (i), '.o')) ;
        NewCommand () ;
        RunFlags () ;
        Word ('-c') ;
        Word ('-iquote') ;
        Word (rt) ;
        Word (c) ;
        Word ('-o') ;
        Word (tmp) ;
        rc := Run (CcName ()) ;
        IF rc # 0 THEN
          Diag ('m9c: the C compiler reported errors in ', c, '') ;
          ok := FALSE ;
          RETURN ''
        END ;
        MkDirs (dir) ;
        Io.Rename (tmp, o)
      END
    END
  END ;
  IF doCell THEN
    IF NOT CacheSession (rt, dir) THEN ok := FALSE ; RETURN '' END
  END ;
  RETURN dir
END CacheRuntime ;

(* --cell's runtime: one shared object of the runtime's objects and the
   system libraries they need, loaded first; and the session host, a
   plain C program that loads the rest (runtime/m9session.c) *)
PROCEDURE CacheSession (RO KEPT rt: UTF ; RO dir: UTF) : BOOL
  RAISES ValueRange, Io.IOError =
VAR
  i, rc : I64 ;
  tmp : UTF ;
BEGIN
  IF NOT Io.Exists (Join (dir, 'libm9rt.so')) THEN
    tmp := Join (work, 'libm9rt.so') ;
    NewCommand () ;
    SharedWords () ;
    FOR i := 0 TO 3 DO
      IF RtWanted (rt, i) THEN Word (Join (dir, Suffix (RtSource (i), '.o'))) END
    END ;
    SystemLibs () ;
    (* AND libm KEPT: SystemLibs links it --as-needed, the runtime calls
       nothing in it, and so the session never loaded it -- libMath.so
       then failed on `undefined symbol: exp' (2026-10-04).  Loaded with
       the runtime, globally, it answers every module after. *)
    IF NOT macos THEN
      Word ('-Wl,--no-as-needed') ;
      Word ('-lm')
    END ;
    Word ('-o') ;
    Word (tmp) ;
    rc := Run (CcName ()) ;
    IF rc # 0 THEN
      Io.ErrLine ('m9c: could not make the runtime a shared object') ;
      RETURN FALSE
    END ;
    Io.Rename (tmp, Join (dir, 'libm9rt.so'))
  END ;
  IF NOT Io.Exists (Join (dir, 'm9session')) THEN
    IF NOT Io.Exists (Cat (rt, '/m9session.c')) THEN
      Diag ('m9c: no session host beside the runtime: ', rt, '/m9session.c') ;
      RETURN FALSE
    END ;
    tmp := Join (work, 'm9session') ;
    NewCommand () ;
    Word ('-O2') ;
    Word ('-iquote') ;
    Word (rt) ;
    Word (Cat (rt, '/m9session.c')) ;
    IF NOT macos THEN Word ('-ldl') END ;
    Word ('-o') ;
    Word (tmp) ;
    rc := Run (CcName ()) ;
    IF rc # 0 THEN
      Io.ErrLine ('m9c: the C compiler reported errors in m9session.c') ;
      RETURN FALSE
    END ;
    Io.Rename (tmp, Join (dir, 'm9session'))
  END ;
  RETURN TRUE
END CacheSession ;

(* WHAT THE SESSION LOADS, one line each, fields by tab: the host; the
   runtime; every module of the closure in dependency order; and the
   cell -- STATE with its init symbol, or PROGRAM with the renamed main.
   The kernel sends LOAD for what is not loaded yet, then INIT or RUN. *)
PROCEDURE CellLine (RO a, b, c: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, a) ;
  DynUtf.AppendChar (d, 09C) ;
  DynUtf.Append (d, b) ;
  IF Text.BLen (c) > 0 THEN
    DynUtf.AppendChar (d, 09C) ;
    DynUtf.Append (d, c)
  END ;
  Io.WriteLine (DynUtf.ViewIn (pool, d))
END CellLine ;

PROCEDURE CellReport () RAISES ValueRange, IndexError =
VAR
  rt, rdir : UTF ;
  i : I64 ;
BEGIN
  rt := RtDir () ;
  rdir := RtCacheDir (rt) ;
  CellLine ('HOST', Join (rdir, 'm9session'), '') ;
  CellLine ('LIB', Join (rdir, 'libm9rt.so'), '') ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) THEN
      CellLine ('LIB', Join (ModDir (i), Cat ('lib', Suffix (order[i], '.so'))), '')
    END
  END ;
  IF cellProgram THEN
    CellLine ('PROGRAM', cellPath, 'm9_cell_main')
  ELSE
    (* the initialiser under the generation's prefix, when it has one *)
    IF Text.BLen (PrefixOf (modName)) > 0 THEN
      CellLine ('STATE', cellPath, Suffix (PrefixOf (modName), '_m9init'))
    ELSE
      CellLine ('STATE', cellPath, Suffix (modName, '_m9init'))
    END
  END
END CellReport ;

(* the cell: every module of its closure as a shared object, the runtime
   and the host, then the cell itself -- a state cell where a module of
   its key would be (modpic/NAME-KEY/, header beside it), so that a later
   cell importing it loads THIS object and not a second copy; a program
   cell into cells/NAME-KEY/, its main renamed m9_cell_main *)
PROCEDURE CellBuild (RO name: UTF) : BOOL
  RAISES ValueRange, IndexError, Io.IOError =
VAR
  rt, rtObjs, so : UTF ;
  ok : BOOL ;
  i, rc : I64 ;
BEGIN
  rt := RtDir () ;
  IF Text.BLen (rt) = 0 THEN
    Io.ErrLine ('m9c: cannot find the M9 runtime headers.') ;
    RETURN FALSE
  END ;
  IF NOT CacheGenAll () THEN RETURN FALSE END ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) THEN
      IF NOT CacheModule (i, rt) THEN RETURN FALSE END
    END
  END ;
  rtObjs := CacheRuntime (rt, ok) ;
  IF NOT ok OR Text.BLen (rtObjs) = 0 THEN
    Io.ErrLine ('m9c: --cell needs the runtime sources beside m9rt.h') ;
    RETURN FALSE
  END ;
  NewCommand () ;
  RunFlags () ;
  IF cellProgram THEN Word ('-Dmain=m9_cell_main') END ;
  Word ('-c') ;
  RunIncludes (rt) ;
  Word (Join (work, Suffix (name, '.c'))) ;
  Word ('-o') ;
  Word (Join (work, Suffix (name, '.o'))) ;
  rc := Run (CcName ()) ;
  IF rc # 0 THEN
    Io.ErrLine ('m9c: the C compiler reported errors') ;
    RETURN FALSE
  END ;
  so := Join (work, Cat ('lib', Suffix (name, '.so'))) ;
  NewCommand () ;
  SharedWords () ;
  Word (Join (work, Suffix (name, '.o'))) ;
  Word ('-o') ;
  Word (so) ;
  rc := Run (CcName ()) ;
  IF rc # 0 THEN
    Io.ErrLine ('m9c: could not make the cell a shared object') ;
    RETURN FALSE
  END ;
  MkDirs (DirOf (cellPath)) ;
  IF NOT cellProgram THEN
    Io.Rename (Join (work, Suffix (name, '.h')), Join (DirOf (cellPath), Suffix (name, '.h'))) ;
    Io.Rename (Join (work, Suffix (name, '.o')), Join (DirOf (cellPath), Suffix (name, '.o')))
  ELSE
    Drop (Join (work, Suffix (name, '.h'))) ;
    Drop (Join (work, Suffix (name, '.o')))
  END ;
  Io.Rename (so, cellPath) ;
  Drop (Join (work, Suffix (name, '.c'))) ;
  RETURN TRUE
END CellBuild ;

(* the program: every module of the closure into the cache, then the
   program's own C -- which the caller has just written into the
   scratch directory -- compiled and linked against them, and renamed
   to its key *)
PROCEDURE RunBuild (RO name: UTF) : BOOL
  RAISES ValueRange, IndexError, Io.IOError =
VAR
  rt, rtObjs, tmp : UTF ;
  ok : BOOL ;
  i, rc : I64 ;
BEGIN
  rt := RtDir () ;
  IF Text.BLen (rt) = 0 THEN
    Io.ErrLine ('m9c: cannot find the M9 runtime headers.') ;
    RETURN FALSE
  END ;
  IF NOT CacheGenAll () THEN RETURN FALSE END ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) THEN
      IF NOT CacheModule (i, rt) THEN RETURN FALSE END
    END
  END ;
  rtObjs := CacheRuntime (rt, ok) ;
  IF NOT ok THEN RETURN FALSE END ;
  tmp := Join (work, name) ;
  IF windows THEN tmp := Cat (tmp, '.exe') END ;
  NewCommand () ;
  RunFlags () ;
  RunIncludes (rt) ;
  Word (Join (work, Suffix (name, '.c'))) ;
  FOR i := 0 TO norder - 1 DO
    IF NOT Text.Eq (order[i], modName) THEN
      Word (Join (ModDir (i), Suffix (order[i], '.o')))
    END
  END ;
  IF Text.BLen (rtObjs) = 0 THEN
    IF NOT AddRuntime (rt) THEN RETURN FALSE END
  ELSE
    FOR i := 0 TO 3 DO
      IF RtWanted (rt, i) THEN
        Word (Join (rtObjs, Suffix (RtSource (i), '.o')))
      END
    END
  END ;
  RunGcWords () ;
  SystemLibs () ;
  Word ('-o') ;
  Word (tmp) ;
  rc := Run (CcName ()) ;
  Drop (Join (work, Suffix (name, '.c'))) ;
  Drop (Join (work, Suffix (name, '.h'))) ;
  IF rc # 0 THEN
    Io.ErrLine ('m9c: the C compiler reported errors') ;
    RETURN FALSE
  END ;
  Io.Rename (tmp, binPath) ;
  RETURN TRUE
END RunBuild ;

(* parse text that has already been read; NONE when it did not parse,
   having said why.  Split from ParseFile because the search path
   reads a candidate to find out whether it exists, and reading it
   twice would be two answers about one file. *)
(* the document, and the coverage line that goes with it.

   MEASURED AND REPORTED, NEVER GATED: a threshold on documentation
   makes `(* obvious *)` a rational move, so this prints the way
   fmt_driver prints its disagreement rate and no more.  The one
   thing that IS an error is drift -- a `name --` line naming
   something that is not a parameter -- because that is the doc and
   the signature disagreeing rather than a gap, and it is said in the
   document as well as counted. *)
PROCEDURE DocText (root: PTR Ast.Node ; RO name: UTF) : UTF
  RAISES IndexError =
VAR
  st : Doc.Stats ;
  txt : UTF ;
  d : PTR DynUtf.DString IN pool ;
BEGIN
  txt := Doc.Text (pool, root, name, st) ;
  IF verbose THEN
    (* ONE LINE, and shaped so a gate can add it up: docdiff sums
       these across the library rather than recomputing what the
       tool already measured. *)
    d := DynUtf.New (pool) ;
    DynUtf.Append (d, 'doc ') ;
    DynUtf.Append (d, name) ;
    DynUtf.Append (d, ' procs ') ;
    DynUtf.AppendI64 (d, st.procsDoc) ;
    DynUtf.AppendChar (d, '/') ;
    DynUtf.AppendI64 (d, st.procs) ;
    DynUtf.Append (d, ' others ') ;
    DynUtf.AppendI64 (d, st.othersDoc) ;
    DynUtf.AppendChar (d, '/') ;
    DynUtf.AppendI64 (d, st.others) ;
    DynUtf.Append (d, ' paramlines ') ;
    DynUtf.AppendI64 (d, st.paramsDoc) ;
    DynUtf.Append (d, ' drift ') ;
    DynUtf.AppendI64 (d, st.unknownParam) ;
    Io.ErrLine (DynUtf.ViewIn (pool, d))
  END ;
  IF st.unknownParam > 0 THEN
    DiagN ('m9c: ', st.unknownParam,
           ' documented parameters are not in their signature, in ',
           name) ;
    failed := TRUE
  END ;
  RETURN txt
END DocText ;

(* the same declarations as data.  A fresh Stats, so that the counts
   -v reports come from the page once and not twice. *)
PROCEDURE JsonText (root: PTR Ast.Node ; RO name: UTF) : UTF
  RAISES IndexError =
VAR st : Doc.Stats ;
BEGIN
  st.mods := 0 ; st.modsDoc := 0 ; st.procs := 0 ; st.procsDoc := 0 ;
  st.others := 0 ; st.othersDoc := 0 ; st.params := 0 ; st.paramsDoc := 0 ;
  st.banners := 0 ; st.unattached := 0 ; st.unknownParam := 0 ;
  RETURN Doc.Json (pool, root, name, st)
END JsonText ;

(* the review page, with the checker's own counts handed to it.  The
   page module is a client of the tree and does not import Sem; this
   is where the two meet, as a driver is where Delim meets Zip. *)
PROCEDURE ReviewText (root: PTR Ast.Node ; RO name: UTF) : UTF =
VAR
  st : SLICE OF Review.Stat ;
  tw, sc, ss, ad : SLICE OF UTF ;
  d : PTR DynUtf.DString IN pool ;
  i, j, n : I64 ;
BEGIN
  n := Sem.StatKinds ;
  st := NEW (pool, Review.Stat, n) ;
  FOR i := 0 TO n - 1 DO
    st[i].name := Sem.StatName (i) ;
    st[i].checked := Sem.StatChecked (i) ;
    st[i].skipped := Sem.StatSkipped (i) ;
    (* the lines of the first sites passed over, as the page prints
       them; `...' when the checker met more than it kept *)
    d := DynUtf.New (pool) ;
    FOR j := 0 TO Sem.StatLines (i) - 1 DO
      IF j > 0 THEN DynUtf.Append (d, ', ') END ;
      DynUtf.AppendI64 (d, Sem.StatLine (i, j))
    END ;
    IF Sem.StatSkipped (i) > Sem.StatLines (i) THEN
      DynUtf.Append (d, ', ...')
    END ;
    st[i].lines := DynUtf.ViewIn (pool, d)
  END ;
  tw := NEW (pool, UTF, Sem.ThreadWrites ()) ;
  FOR i := 0 TO LEN (tw) - 1 DO tw[i] := Sem.ThreadWrite (i) END ;
  sc := NEW (pool, UTF, Sem.StaleCalls ()) ;
  FOR i := 0 TO LEN (sc) - 1 DO sc[i] := Sem.StaleCall (i) END ;
  ss := NEW (pool, UTF, Sem.StrSites ()) ;
  FOR i := 0 TO LEN (ss) - 1 DO ss[i] := Sem.StrSite (i) END ;
  ad := NEW (pool, UTF, Sem.AdrSites ()) ;
  FOR i := 0 TO LEN (ad) - 1 DO ad[i] := Sem.AdrSite (i) END ;
  RETURN Review.Page (root, name, TRUE, st, tw, sc, ss, ad)
END ReviewText ;

PROCEDURE ParseText (RO src: UTF ; RO path: UTF) : Ast.Kid
  RAISES ValueRange =
VAR
  p : Parse.Parser ;
  root : PTR Ast.Node IN pool ;
  i : I64 ;
BEGIN
  Parse.Init (p, src) ;
  root := Parse.File (pool, p) ;
  (* disarm, never clear: Collect (FALSE) keeps what it gathered, so
     the main file's comments survive while every dependency parsed
     after this goes past uncollected.  Armed by the caller, because
     only the caller knows which file is the main one. *)
  Lex.Collect (FALSE) ;
  IF p.nerr > 0 THEN
    (* each error with its line and column, the way the generator's
       have been printed since 2026-08-29.  A count alone was the
       parser's half of the same defect and cost the same bisects:
       one `<>` in a file gave `981 parse errors` and no line. *)
    i := 0 ;
    WHILE i < p.nkept AND i < 8 DO
      IF lineShift > 0 AND Text.Eq (path, shiftPath) AND p.errs[i].line > lineShift THEN
        Diag2 (Cat (path, ':'), p.errs[i].line - lineShift, p.errs[i].col,
               ': parse: ', p.errs[i].msg)
      ELSE
        Diag2 (Cat (path, ':'), p.errs[i].line, p.errs[i].col,
               ': parse: ', p.errs[i].msg)
      END ;
      i := i + 1
    END ;
    DiagN ('m9c: ', p.nerr, ' parse errors in ', path) ;
    failed := TRUE ;
    RETURN NONE
  END ;
  Remember (BaseName (path), src) ;
  RETURN SOME (root)
END ParseText ;

PROCEDURE ParseFile (RO path: UTF) : Ast.Kid
  RAISES Io.IOError, ValueRange =
BEGIN
  RETURN ParseText (UTF (pool, Io.ReadFileUtf (path)), path)
END ParseFile ;

(* The two consumers want different closures, and conflating them is
   what put Lex, Print and Text into M9c.h the first time this ran.

   The CHECKER wants the transitive closure: a cross-module name that
   has not been loaded is indistinguishable from one that does not
   exist, and that is true however far away the name lives.

   The GENERATOR wants only what this module imports DIRECTLY, because
   what it does with a registered unit is emit an #include for it, and
   a header that includes its dependencies' dependencies is describing
   somebody else's interface.                                        *)
PROCEDURE Absorb (VAR root: PTR Ast.Node ; forGen: BOOL) =
VAR i : I64 ;
BEGIN
  Sem.LoadFile (root) ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF forGen THEN
        Gen.LoadExtern (u)
      ELSE
        (* THE THIRD CLOSURE.  An indirect dependency contributes no
           #include -- this module names nothing in it -- but its
           declarations must be REGISTERED, because a DIRECT
           dependency's signature may be written in its types:
           Qvsat.Ew answers a Kind.FlexFloat, and VertTransform has
           no business importing Kind in order to call it.

           Without this the generator answered an unknown type, and
           an unknown type under an arithmetic operator used to
           become integer arithmetic over doubles.  Three modules had
           grown an IMPORT for a type they never name before this
           was worth fixing rather than working around. *)
        Gen.LoadExternDeep (u)
      END
    END
  END
END Absorb ;

(* remember a root so its own imports can be walked later *)
PROCEDURE Keep (KEPT root: PTR Ast.Node ; RO KEPT name: UTF ; far: BOOL) =
VAR
  nb : SLICE OF Ast.Kid ;
  nn : SLICE OF UTF ;
  nf : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  IF ndeps = LEN (depRoots) THEN
    nb := NEW (pool, Ast.Kid, 2 * LEN (depRoots) + 8) ;
    nn := NEW (pool, UTF, 2 * LEN (depRoots) + 8) ;
    nf := NEW (pool, BOOL, 2 * LEN (depRoots) + 8) ;
    FOR i := 0 TO ndeps - 1 DO
      nb[i] := depRoots[i] ;
      nn[i] := depNames[i] ;
      nf[i] := depFar[i]
    END ;
    depRoots := nb ;
    depNames := nn ;
    depFar := nf
  END ;
  depRoots[ndeps] := SOME (root) ;
  depNames[ndeps] := name ;
  depFar[ndeps] := far ;
  ndeps := ndeps + 1
END Keep ;

(* --no-unsafe: the language wall of the sandbox story
   (docs/tutorial-plan.md).  A unit from a TRUSTED directory --
   $M9LIBRARY or the installed library (LibPlace) -- may be UNSAFE or
   FOR "C":
   that is the shipped library's own audited foreign boundary.  A
   unit from anywhere else (the main file, a named dependency, -I
   directories, the main file's neighbours) may not, and is refused
   BY NAME before anything is generated -- so an OS sandbox around
   this compiler is the second wall, never the only one.
   The refusal is POSITIONED, FILE:LINE:COL: no-unsafe: MSG, the
   parser's shape: it used to say `m9c: --no-unsafe: foreign unit U
   in PATH`, and the two programs that republish --check's lines
   (m9lsp, m9edit) accept only positioned lines, so a cell with a
   foreign unit came back rejected with ZERO findings.  Diag.Parse
   reads this line now, and a pointer at the unit beats a name.     *)
PROCEDURE ScanUnsafe (root: PTR Ast.Node ; RO path: UTF ;
                      trusted: BOOL) RAISES ValueRange =
VAR i : I64 ;
BEGIN
  IF NOT noUnsafe THEN RETURN END ;
  IF trusted THEN RETURN END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF Text.BLen (u.bu) > 0 THEN
        Diag2 (Cat (path, ':'), u.line, u.col,
               ': no-unsafe: foreign unit ', u.au) ;
        nunsafe := nunsafe + 1 ;
        failed := TRUE
      ELSIF u.f1 THEN
        Diag2 (Cat (path, ':'), u.line, u.col,
               ': no-unsafe: UNSAFE unit ', u.au) ;
        nunsafe := nunsafe + 1 ;
        failed := TRUE
      END
    END
  END
END ScanUnsafe ;

(* the source of a module named by an IMPORT, or a diagnosis *)
PROCEDURE Fetch (RO name: UTF ; VAR path: UTF ; VAR ok: BOOL ;
                 VAR trusted: BOOL) : UTF =
BEGIN
  RETURN FindModule (name, path, ok, trusted)
END Fetch ;

PROCEDURE Missing (RO name: UTF) =
BEGIN
  Diag ('m9c: cannot find module ', name,
        ' on the search path (-I, $M9LIBRARY)') ;
  nmissing := nmissing + 1 ;
  failed := TRUE
END Missing ;

(* directly imported: registered for the generator too.  No recursion
   here, deliberately -- every direct import must be registered before
   any indirect one is even looked at, or a module reached first
   through a dependency would be marked loaded and then skipped when
   the main module asks for it by name, and its #include would go
   missing.  Two passes cost one walk and remove that whole class. *)
PROCEDURE LoadDirect (RO KEPT name: UTF) RAISES ValueRange =
VAR
  path, src : UTF ;
  ok, trusted : BOOL ;
BEGIN
  IF IsLoaded (name) THEN RETURN END ;
  MarkLoaded (name) ;
  src := Fetch (name, path, ok, trusted) ;
  IF NOT ok THEN Missing (name) ; RETURN END ;
  IF ParseText (src, path) IS SOME root THEN
    ScanUnsafe (root, path, trusted) ;
    Absorb (root, TRUE) ;
    Keep (root, name, FALSE)
    (* NOT Ordered here: this deliberately does not recurse, so the
       module's own imports are not in order[] yet.  FillGaps adds it
       once it has walked this root's subtree. *)
  END
END LoadDirect ;

PROCEDURE LoadIndirect (RO KEPT name: UTF) RAISES ValueRange ;

(* every module an import walk reaches.  The name is marked BEFORE the
   recursion, which is what makes a cycle terminate instead of
   recurring: M9 has no rule against mutual imports and the compiler
   should not acquire one by crashing. *)
PROCEDURE WalkImports (root: PTR Ast.Node ; direct: BOOL ; RO KEPT owner: UTF)
  RAISES ValueRange =
VAR i, j, k : I64 ;
BEGIN
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      FOR j := 0 TO u.nkids - 1 DO
        IF u.kids[j] IS SOME imp THEN
          (* NImportList only: a FROM names a foreign unit declared
             inside some module, so there is no file to find and
             looking for one would invent it *)
          IF imp.kind = Ast.NImportList THEN
            IF imp.kids[0] IS SOME ids THEN
              FOR k := 0 TO ids.nkids - 1 DO
                IF ids.kids[k] IS SOME id THEN
                  (* the EDGE is recorded whatever happens next: a
                     module already loaded is still imported, and the
                     order is computed from the graph, not from who
                     got here first *)
                  IF Text.BLen (owner) > 0 THEN AddEdge (owner, id.au) END ;
                  IF direct THEN
                    LoadDirect (id.au)
                  ELSE
                    LoadIndirect (id.au)
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END WalkImports ;

(* reached only through another module: the checker needs it, the
   generated header does not name it.  Post-order, so its own
   dependencies are registered before it is. *)
PROCEDURE LoadIndirect (RO KEPT name: UTF) RAISES ValueRange =
VAR
  path, src : UTF ;
  ok, trusted : BOOL ;
BEGIN
  IF IsLoaded (name) THEN RETURN END ;
  MarkLoaded (name) ;
  src := Fetch (name, path, ok, trusted) ;
  IF NOT ok THEN Missing (name) ; RETURN END ;
  IF ParseText (src, path) IS SOME root THEN
    ScanUnsafe (root, path, trusted) ;
    WalkImports (root, FALSE, name) ;
    Absorb (root, FALSE) ;
    (* kept, so LinkWords sees its FOR "C" units: a LINK reached only
       through another module's IMPLEMENTATION (NbCells -> Parquet ->
       czstd) left its library off the line until 2026-10-10.  FAR:
       its words go on only when their libraries are there *)
    Keep (root, name, TRUE)
  END
END LoadIndirect ;

(* A dependency named on the command line: still supported, and it
   wins over the search path, because a path someone typed is a
   statement about which file they meant -- and about the ORDER,
   which is why this does not recurse.  Post-order resolution would
   register a named module's own imports ahead of it and reshuffle
   the generated includes; a fully-named command line must still
   produce the same bytes it always did.  Its root is kept so that
   the gaps it leaves can be filled afterwards. *)
PROCEDURE LoadDep (RO KEPT path: UTF) RAISES Io.IOError, ValueRange =
BEGIN
  IF IsLoaded (BaseName (path)) THEN RETURN END ;
  MarkLoaded (BaseName (path)) ;
  IF ParseFile (path) IS SOME root THEN
    ScanUnsafe (root, path, FALSE) ;
    Absorb (root, TRUE) ;
    Keep (root, BaseName (path), FALSE)
  END
END LoadDep ;

(* What the command line did not name.  Two passes, and the order is
   the point: everything the main module imports directly is
   registered first, so the generated header includes exactly those;
   only then is the rest of the closure pulled in for the checker.

   A command line that named every direct import therefore gets
   nothing added to the generated C at all, which is what keeps the
   bytes identical to the ones the FPC oracle produced.             *)
PROCEDURE FillGaps (mainRoot: PTR Ast.Node) RAISES ValueRange =
VAR i, upto : I64 ;
BEGIN
  WalkImports (mainRoot, TRUE, modName) ;
  upto := ndeps ;
  FOR i := 0 TO upto - 1 DO
    IF depRoots[i] IS SOME r THEN WalkImports (r, FALSE, depNames[i]) END
  END ;
  WalkImports (mainRoot, FALSE, modName) ;
  (* the closure is complete, so the graph is: compute the build
     order from it.  Anything marked loaded whose source was not
     found or whose parse failed has no edges and simply orders
     itself; MakeAll skips what FindModule cannot find. *)
  BuildOrder ()
END FillGaps ;

(* the diagnostics, then a refusal.  A compiler that translates what
   it knows to be wrong is a translator; this is the line between the
   two, and until now m9c was on the wrong side of it. *)
(* a checker message, `LINE:COL ctx: msg`, with lineShift taken off
   its line: an expression cell's wrapper is not the reader's text *)
PROCEDURE Unshift (RO m: UTF) : UTF =
VAR
  i, n : I64 ;
  scratch : POOL ;
  d : PTR DynUtf.DString IN scratch ;
BEGIN
  IF lineShift = 0 THEN RETURN m END ;
  i := 0 ;
  n := 0 ;
  WHILE i < Text.BLen (m) AND B (m, i) >= ORD ('0') AND B (m, i) <= ORD ('9') DO
    n := n * 10 + (B (m, i) - 48) ;
    i := i + 1
  END ;
  IF i = 0 OR i >= Text.BLen (m) OR B (m, i) # ORD (':') THEN RETURN m END ;
  d := DynUtf.New (scratch) ;
  IF n > lineShift THEN
    DynUtf.AppendI64 (d, n - lineShift) ;
    DynUtf.Append (d, SLICE (m, i, Text.BLen (m) - i))
  ELSE
    (* on the wrapper's own line: a message about the statement as a
       whole, which is the cell's expression from its start *)
    i := i + 1 ;
    WHILE i < Text.BLen (m) AND B (m, i) >= ORD ('0') AND B (m, i) <= ORD ('9') DO i := i + 1 END ;
    DynUtf.Append (d, '1:1') ;
    DynUtf.Append (d, SLICE (m, i, Text.BLen (m) - i))
  END ;
  RETURN DynUtf.View (d)
END Unshift ;

(* does hay hold needle?  Small strings, a naive scan *)
PROCEDURE Holds (RO hay, needle: UTF) : BOOL =
VAR i, j : I64 ;
BEGIN
  FOR i := 0 TO Text.BLen (hay) - Text.BLen (needle) DO
    j := 0 ;
    WHILE j < Text.BLen (needle) AND B (hay, i + j) = B (needle, j) DO j := j + 1 END ;
    IF j = Text.BLen (needle) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Holds ;

(* a checker diagnostic, `LINE:COL CTX: MSG', in the FILE:LINE:COL:
   shape the parser's and every tool's: `X.m9:12:14: X.F: MSG'.  The
   checker's own text stays as it is -- the twins compare it (semdiff,
   probediff) -- and only what m9c prints carries the file (Alex,
   2026-10-22, the review's tier 3: checker messages had no file) *)
PROCEDURE Located (RO path: UTF ; RO m: UTF) : UTF =
VAR i, j : I64 ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (m) AND B (m, i) >= ORD ('0') AND B (m, i) <= ORD ('9') DO i := i + 1 END ;
  IF i > 0 AND i < Text.BLen (m) AND B (m, i) = ORD (':') THEN
    j := i + 1 ;
    WHILE j < Text.BLen (m) AND B (m, j) >= ORD ('0') AND B (m, j) <= ORD ('9') DO j := j + 1 END ;
    IF j > i + 1 AND j < Text.BLen (m) AND B (m, j) = ORD (' ') THEN
      RETURN path + ':' + SLICE (m, 0, j) + ': ' + SLICE (m, j + 1, Text.BLen (m) - j - 1)
    END
  END ;
  RETURN path + ': ' + m
END Located ;

PROCEDURE Report () : BOOL RAISES IndexError =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO Sem.ErrCount () - 1 DO
    Io.ErrLine (Located (main, Unshift (Sem.ErrAt (i))))
  END ;
  (* the region judgement's shadow findings, under M9_REGIONS=1
     (docs/region-plan.md): listed, never a refusal *)
  FOR i := 0 TO Sem.RegionCount () - 1 DO
    Io.ErrLine (Unshift (Sem.RegionAt (i)))
  END ;
  RETURN Sem.ErrCount () > 0
END Report ;

(* ---- --show: an expression cell (docs/kernel-show-plan.md) ----

   The expression is wrapped in a program whose heading takes line 1
   and whose expression starts line 2, column 1.  Its imports are the
   first names of its dotted names that are modules the import path
   finds -- read from TOKENS, so nothing in a string or a comment
   counts -- because decision 24 wants every module named imported
   and a cell of one expression has nowhere to say so. *)
PROCEDURE ShowImports (RO expr: UTF ; withShow: BOOL) : UTF RAISES ValueRange =
VAR
  lx : Lex.Lexer ;
  tk, prev, cur : Lex.Token ;
  out, path, k : UTF ;
  ok, trusted, afterDot : BOOL ;
  seen : PTR DynUtf.DString IN pool ;
BEGIN
  out := '' ;
  seen := DynUtf.New (pool) ;
  DynUtf.Append (seen, ' ') ;
  IF withShow THEN
    out := 'IMPORT NbShow ; ' ;
    DynUtf.Append (seen, 'NbShow ')
  END ;
  Lex.Init (lx, expr) ;
  afterDot := FALSE ;
  Lex.Next (lx, cur) ;
  LOOP
    k := UTF (Lex.KindName (cur.kind)) ;
    IF Text.Eq (k, 'EOF') OR Text.Eq (k, 'Error') THEN EXIT END ;
    prev := cur ;
    Lex.Next (lx, cur) ;
    IF Text.Eq (Lex.KindName (prev.kind), 'Ident') AND NOT afterDot AND
       Text.Eq (Lex.KindName (cur.kind), 'Dot') THEN
      IF NOT Holds (DynUtf.ViewIn (pool, seen), ' ' + prev.text + ' ') THEN
        DynUtf.Append (seen, prev.text + ' ') ;
        tk := prev ;
        k := FindModule (tk.text, path, ok, trusted) ;
        IF ok THEN out := out + 'IMPORT ' + tk.text + ' ; ' END
      END
    END ;
    afterDot := Text.Eq (Lex.KindName (prev.kind), 'Dot')
  END ;
  RETURN out
END ShowImports ;

(* the NbShow call for a type, as the text before and after the
   expression; FALSE for a type nothing shows *)
PROCEDURE ShowCall (RO ty: UTF ; VAR pre, post: UTF) : BOOL =
BEGIN
  post := ')' ;
  IF Text.Eq (ty, 'I64') OR Text.Eq (ty, 'an integer literal') THEN
    pre := 'NbShow.Int ('
  ELSIF Text.Eq (ty, 'I32') OR Text.Eq (ty, 'I16') OR Text.Eq (ty, 'BYTE') THEN
    pre := 'NbShow.Int (I64 (' ;
    post := '))'
  ELSIF Text.Eq (ty, 'F64') OR Text.Eq (ty, 'a real literal') THEN
    pre := 'NbShow.Real ('
  ELSIF Text.Eq (ty, 'F32') THEN
    pre := 'NbShow.Real (F64 (' ;
    post := '))'
  ELSIF Text.Eq (ty, 'BOOL') THEN
    pre := 'NbShow.Bool ('
  ELSIF Text.Eq (ty, 'CHAR') THEN
    pre := 'NbShow.Char ('
  ELSIF Text.Eq (ty, 'SLICE OF CHAR') OR Text.Eq (ty, 'STR') THEN
    pre := 'NbShow.Str ('
  ELSIF Text.Eq (ty, 'SLICE OF I64') THEN
    pre := 'NbShow.Ints ('
  ELSIF Text.Eq (ty, 'SLICE OF F64') THEN
    pre := 'NbShow.Reals ('
  ELSIF Text.Eq (ty, 'SLICE OF BOOL') THEN
    pre := 'NbShow.Bools ('
  ELSIF Text.Eq (ty, 'SLICE OF SLICE OF CHAR') OR Text.Eq (ty, 'SLICE OF STR') THEN
    pre := 'NbShow.Strs ('
  ELSIF Text.Eq (ty, 'GRID 2 OF F64') THEN
    pre := 'NbShow.Grid ('
  ELSIF Text.Eq (ty, 'PTR Frame.Fr') THEN
    pre := 'NbShow.Table ('
  ELSIF Text.Eq (ty, 'PTR Frame.Ts') THEN
    pre := 'NbShow.Series ('
  ELSE
    RETURN FALSE
  END ;
  RETURN TRUE
END ShowCall ;

(* the program's handlers and the imports their names need: one arm
   for each exception the expression raises, each saying so.  A
   program body must handle what it raises, and M9 has no catch-all
   (report par 5), so the checker's list is the only honest one. *)
PROCEDURE ShowHandlers (RO raises: UTF ; VAR imports: UTF) : UTF =
VAR
  out, nm, q : UTF ;
  i, j, k : I64 ;
BEGIN
  out := '' ;
  i := 0 ;
  WHILE i < Text.BLen (raises) DO
    WHILE i < Text.BLen (raises) AND B (raises, i) = ORD (' ') DO i := i + 1 END ;
    j := i ;
    WHILE j < Text.BLen (raises) AND B (raises, j) # ORD (' ') DO j := j + 1 END ;
    IF j > i THEN
      nm := SLICE (raises, i, j - i) ;
      IF Text.BLen (out) = 0 THEN out := ' EXCEPT' END ;
      out := out + ' | ' + nm + " : NbShow.Raised ('" + nm + "')" ;
      k := 0 ;
      WHILE k < Text.BLen (nm) AND B (nm, k) # ORD ('.') DO k := k + 1 END ;
      IF k < Text.BLen (nm) THEN
        q := SLICE (nm, 0, k) ;
        IF NOT Holds (imports, 'IMPORT ' + q + ' ;') THEN
          imports := imports + 'IMPORT ' + q + ' ; '
        END
      END
    END ;
    i := j
  END ;
  RETURN out
END ShowHandlers ;

(* the expression's type, from a child m9c run with this command
   line and --type-of in place of --show ... --run/--cell: the checker
   keeps module state and checks one file a process *)
PROCEDURE ShowProbe (VAR raises: UTF) : UTF RAISES ValueRange =
VAR
  self, a, ty : UTF ;
  i, nl : I64 ;
  r : System.ResultUtf ;
BEGIN
  self := System.ExecutableUtf (pool) ;
  IF Text.BLen (self) = 0 THEN self := Io.ArgUtf (pool, 0) END ;
  nwords := 0 ;
  i := 1 ;
  WHILE i < Io.ArgCount () DO
    a := Io.ArgUtf (pool, i) ;
    IF Text.Eq (a, '--run') OR Text.Eq (a, '--cell') THEN
      Word ('--type-of') ;
      Word (Io.ArgUtf (pool, i + 1)) ;
      i := Io.ArgCount ()
    ELSIF NOT Text.Eq (a, '--show') THEN
      Word (a)
    END ;
    i := i + 1
  END ;
  r := System.ExecUtf (pool, self, SLICE (words, 0, nwords), '', ChildEnv (self)) ;
  IF Text.BLen (r.err) > 0 THEN Io.Err (r.err) END ;
  IF r.status # 0 THEN
    failed := TRUE ;
    Io.Halt (1)
  END ;
  (* two lines: the type, then the exceptions it raises *)
  ty := r.out ;
  WHILE Text.BLen (ty) > 0 AND (B (ty, Text.BLen (ty) - 1) = 10 OR B (ty, Text.BLen (ty) - 1) = 13) DO
    ty := SLICE (ty, 0, Text.BLen (ty) - 1)
  END ;
  raises := '' ;
  nl := 0 ;
  WHILE nl < Text.BLen (ty) AND B (ty, nl) # 10 DO nl := nl + 1 END ;
  IF nl < Text.BLen (ty) THEN
    raises := SLICE (ty, nl + 1, Text.BLen (ty) - nl - 1) ;
    ty := SLICE (ty, 0, nl)
  END ;
  RETURN ty
EXCEPT
| Io.IOError (p) :
    Diag ('m9c: cannot run ', UTF (p), '') ;
    failed := TRUE ;
    Io.Halt (1) ;
    RETURN ''
END ShowProbe ;

VAR
  i : I64 ;
  main, name, mainSrc : UTF ;
  rgEnv : UTF ;              (* M9_REGIONS: the region judgement's shadow *)
  irEnv : UTF ;              (* M9_IRCHECK: the IR lowering's first step *)
  found, mainTrust, built : BOOL ;
  showExpr, showType, showPre, showPost, showRaises, showImps, showArms : UTF ;

BEGIN
  (* first, because --help and every default below ask where this
     compiler is *)
  Locate () ;
  IF Io.ArgCount () < 2 THEN
    (* no arguments is a mistake and exits 1; asking for help is not
       and exits 0.  Conflating the two is why scripts check output
       instead of status. *)
    Io.WriteLine ('usage: m9c FILE.m9 [DEP.m9 ...]') ;
    Io.WriteLine ("try 'm9c --help'") ;
    failed := TRUE
  ELSIF IsHelp (Io.ArgUtf (pool, 1)) THEN
    Help ()
  ELSE
    ScanArgs () ;
    (* a refused argument has been said; nothing after it is meant *)
    IF failed THEN Io.Halt (1) END ;
    (* --doc writes documentation and nothing else.  Combining it
       with a flag that produces an object or a program is not a
       thing to guess at -- one of the two was meant -- so it is
       refused rather than silently favoured. *)
    IF doDoc AND (doCompile OR doLink OR Text.BLen (lib) > 0) THEN
      Io.ErrLine ('m9c: --doc writes documentation, not objects;') ;
      Io.ErrLine ('  it cannot be combined with -c, -o, --ar or --so') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    IF doReview AND (doCompile OR doLink OR Text.BLen (lib) > 0 OR doDoc) THEN
      Io.ErrLine ('m9c: --review checks and prints a page, and writes nothing;') ;
      Io.ErrLine ('  it cannot be combined with -c, -o, --ar, --so or --doc') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    IF doCheck AND (doCompile OR doLink OR Text.BLen (lib) > 0 OR doDoc) THEN
      Io.ErrLine ('m9c: --check writes nothing at all;') ;
      Io.ErrLine ('  it cannot be combined with -c, -o, --ar, --so or --doc') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    (* --run builds where its cache says and runs what it built: an
       object, a library, a document or a kept C file named on the
       same line would be a second answer to "what is the output" *)
    IF (doRun OR doCell) AND (doCompile OR doLink OR Text.BLen (lib) > 0 OR doDoc OR
                  doCheck OR doMake OR debug OR keepC OR ccFrom > 0 OR
                  Text.BLen (outDir) > 0) THEN
      Io.ErrLine ('m9c: --run builds into its cache and runs the program;') ;
      Io.ErrLine ('  only -I, -v and --no-unsafe may come before it') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    IF Text.BLen (outDir) > 0 AND (doCompile OR doLink OR Text.BLen (lib) > 0 OR doDoc) THEN
      Io.ErrLine ('m9c: --out-dir places the generated C;') ;
      Io.ErrLine ('  it cannot be combined with -c, -o, --ar, --so or --doc') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    main := SourceAt (0) ;
    (* -v is verbose, and has been since the first supplied-flags
       test depended on its output -- but a bare `m9c -v` has nothing
       to be verbose ABOUT, so it answers the version, which is what
       everyone typing it wants.  --version says so unconditionally. *)
    IF doVersion OR (verbose AND Text.BLen (main) = 0) THEN
      Io.WriteLine ('m9c ' + Version) ;
      Io.Halt (0)
    END ;
    IF Text.BLen (main) = 0 THEN
      Io.ErrLine ('m9c: no source file') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    name := BaseName (main) ;
    modName := name ;

    (* -I first (leftmost wins), then $M9LIBRARY, then the main
       file's own directory: a module's neighbours are almost always
       its imports, which is why `m9c corpus/M9c.m9` needs no -I *)
    DirAddPath (Io.EnvUtf (pool, 'M9LIBRARY'), TRUE) ;
    (* AND A BARE FILENAME NAMES THIS DIRECTORY.  DirOf answers empty
       for `Top.m9` -- it names no directory -- and DirAdd drops an
       empty string, so `m9c --make -o top Top.m9`, run in the very
       directory the imports sit in, could not find them while
       `m9c ... ./Top.m9` and `-I.` both could.  The rule says "the
       directory FILE.m9 came from", and for a bare name that is the
       current one; saying so here rather than in DirOf keeps
       DirOf's own answer (empty means no directory) true. *)
    IF Text.BLen (DirOf (main)) = 0 THEN DirAdd ('.', FALSE)
    ELSE DirAdd (DirOf (main), FALSE) END ;
    (* Last, and only as a fallback: where the standard modules are
       installed -- beside this compiler when it has a library of its
       own, the package's place otherwise (LibPlace).  An installed
       compiler that cannot find its own library without the user
       exporting a variable is a compiler nobody installs twice.  In
       a source tree the directory does not exist and this costs one
       failed open. *)
    DirAdd (LibPlace (), TRUE) ;

    (* the main file goes through the path too, if it does not read
       as given.  So `m9c Json.m9` and even `m9c Json` work with a
       library set, and the argument can be a module rather than a
       path -- which is what a module compiler ought to accept. *)
    mainSrc := TryRead (main, found) ;
    (* there, and not text: said once by TryRead, and nothing to search
       for -- the path search read it again and then said `cannot find'
       (2026-10-10) *)
    IF NOT found AND readNotText THEN Io.Halt (1) END ;
    (* a PATH that is not there is not there: `m9c --check
       no/such/dir/Text.m9' checked the library's Text and exited 0
       (the review's F6).  Only a bare module name is searched for. *)
    IF NOT found AND (Text.BLen (DirOf (main)) > 0 OR
                      (Text.BLen (main) > 0 AND B (main, 0) = ORD ('/'))) THEN
      Complain ('cannot read', main) ;
      Io.Halt (1)
    END ;
    IF NOT found THEN
      mainSrc := FindModule (name, main, found, mainTrust) ;
      IF NOT found THEN
        Complain ('cannot find', SourceAt (0)) ;
        Io.Halt (1)
      END
    END ;

    (* --show / --type-of: the file holds an expression, and what is
       compiled is the program around it (see ShowImports) *)
    IF doShow AND NOT (doRun OR doCell) THEN
      Io.ErrLine ('m9c: --show runs what it shows: --show --run FILE or --show --cell FILE') ;
      failed := TRUE ;
      Io.Halt (1)
    END ;
    IF doShow OR doTypeOf THEN
      showExpr := mainSrc ;
      lineShift := 1 ;
      shiftPath := main ;
      IF doTypeOf THEN
        Sem.ShowType ('ShowValue') ;
        mainSrc := 'MODULE ' + name + ' ; ' + ShowImports (showExpr, FALSE) +
                   'VAR ShowValue : BOOL ; BEGIN ShowValue :=' + 0AC + showExpr + 0AC +
                   'END ' + name + '.' + 0AC
      ELSE
        showType := ShowProbe (showRaises) ;
        IF Text.Eq (showType, '<void>') THEN
          Io.ErrLine ('m9c: this has no value: a call of a procedure that answers') ;
          Io.ErrLine ('  nothing, so it cannot be shown; write it in a program cell') ;
          failed := TRUE ;
          Io.Halt (1)
        END ;
        IF Text.BLen (showType) = 0 THEN
          (* the checker's softness: a name it cannot resolve has no
             type and no diagnostic -- `Math.Nosuch` passes --check
             and only the generator refuses it (the owed list) *)
          Io.ErrLine ('m9c: the checker could not type this expression -- is every') ;
          Io.ErrLine ('  name in it declared? -- so it cannot be shown') ;
          failed := TRUE ;
          Io.Halt (1)
        END ;
        IF NOT ShowCall (showType, showPre, showPost) THEN
          Io.ErrLine ('m9c: cannot show a value of type ' + showType +
                      '; write a program cell that prints it') ;
          failed := TRUE ;
          Io.Halt (1)
        END ;
        showImps := ShowImports (showExpr, TRUE) ;
        showArms := ShowHandlers (showRaises, showImps) ;
        mainSrc := 'MODULE ' + name + ' ; ' + showImps +
                   'BEGIN ' + showPre + 0AC + showExpr + 0AC + showPost +
                   showArms + ' END ' + name + '.' + 0AC
      END
    END ;

    (* the main module is loaded by name too, so that a cyclic or
       self-naming import stops here rather than recurring *)
    MarkLoaded (name) ;

    i := 1 ;
    WHILE Text.BLen (SourceAt (i)) > 0 DO
      LoadDep (SourceAt (i)) ;
      i := i + 1
    END ;

    (* armed for the MAIN file's parse and no other.  ParseText
       disarms as it returns, so the dependencies FillGaps pulls in
       below do not add their comments to this module's. *)
    IF doDoc THEN Lex.Collect (TRUE) END ;
    IF ParseText (mainSrc, main) IS SOME root THEN
      mainRoot := SOME (root) ;
      ScanUnsafe (root, main, FALSE) ;
      (* whatever the command line did not name, the search path
         finds: IMPORT names a module and m9c can now translate that
         to a file, which was the last job a build system was doing
         here *)
      FillGaps (root) ;
      (* every module that could not be found is reported, and then
         this stops: without a module's source everything after it is
         guesswork, and the fourteen generator errors that followed
         the first time were all one problem said fourteen times. *)
      IF nmissing > 0 THEN Io.Halt (1) END ;
      (* --no-unsafe refusals stop here too, all of them named
         first, and nothing generated after *)
      IF nunsafe > 0 THEN Io.Halt (1) END ;
      (* --run: an unchanged program is run from here, unchecked
         because unchanged (see the cache's comment); a changed one is
         checked as any other and its C written to the scratch *)
      IF doRun OR doCell THEN
        IF doCell THEN
          cellProgram := FALSE ;
          FOR i := 0 TO root.nkids - 1 DO
            IF root.kids[i] IS SOME cu THEN
              IF cu.kind = Ast.NProgram THEN cellProgram := TRUE END
            END
          END ;
          IF windows THEN
            Io.ErrLine ('m9c: --cell needs fork and dlopen: Linux and macOS only') ;
            failed := TRUE ;
            Io.Halt (1)
          END
        END ;
        RunKeys () ;
        outDir := work
      END ;
      (* THE CLOSURE IS REBUILT BEFORE ANYTHING IS CHECKED AGAINST
         IT.  m9c has always known which modules it needs -- it
         resolved, read and parsed them a moment ago -- and has
         always been willing to NAME the command that builds a
         missing one.  Running it is the same knowledge acted on.
         Ordering these by hand in a build script has been wrong
         repeatedly, and a stale object is indistinguishable from a
         real difference until something like -flto happens to
         notice. *)
      IF doMake THEN
        IF NOT MakeAll () THEN
          failed := TRUE ;
          Io.Halt (1)
        END
      END ;
      Sem.LoadFile (root) ;
      rgEnv := Io.EnvUtf (pool, 'M9_REGIONS') ;
      Sem.SetRegions (Text.BLen (rgEnv) = 1 AND B (rgEnv, 0) = ORD ('1')) ;
      Sem.CheckFile (root) ;
      IF Report () THEN
        DiagN ('m9c: ', Sem.ErrCount (), ' errors in ', main) ;
        failed := TRUE ;
        Io.Halt (1)
      END ;
      IF doTypeOf THEN
        Io.WriteLine (Sem.ShownType ()) ;
        Io.WriteLine (Sem.ShownRaises ()) ;
        Io.Halt (0)
      END ;
      FOR i := 0 TO root.nkids - 1 DO
        IF root.kids[i] IS SOME u THEN Gen.LoadUnit (u) END
      END ;
      (* --check used to stop HERE, before the generator -- so the
         dozen constructs the checker accepts and the generator
         refuses (OPT over a value type, CASE over a call, EXCEPT and
         FINALLY on one block, ...) never reached the editor, and a
         file the LSP called clean failed at the build.  Since
         2026-09-27 (docs/agent-review-2026-09-27.md F4) --check runs
         the generator too and stops before anything is written. *)
      (* --doc STILL CHECKS, and stops here.  Documentation for a
         program the checker rejects is a lie about a program that
         does not exist, and everything above this line is what makes
         it true.  What it does NOT do is generate: no C, no object,
         no cc, and the header is not this module's business. *)
      IF doDoc THEN
        Io.WriteFile (Suffix (name, '.md'), DocText (root, name)) ;
        IF doJson THEN
          Io.WriteFile (Suffix (name, '.json'), JsonText (root, name))
        END ;
        RETURN
      END ;
      (* -g debugs the M9, not the C it became.  The directives are
         emitted only under -g, so without it the generated C is the
         byte-for-byte article gendiff and the bootstrap compare. *)
      IF debug THEN Gen.SetDebugSource (main) END ;
      FOR i := 0 TO npfxSpec - 1 DO
        Gen.SetPrefix (SLICE (pfxSpec[i], 0, EqAt (pfxSpec[i])),
                       SLICE (pfxSpec[i], EqAt (pfxSpec[i]) + 1,
                              Text.BLen (pfxSpec[i]) - EqAt (pfxSpec[i]) - 1))
      END ;
      irEnv := Io.EnvUtf (pool, 'M9_IRCHECK') ;
      Gen.SetIrCheck (Text.BLen (irEnv) = 1 AND B (irEnv, 0) = ORD ('1')) ;
      Gen.Emit (name) ;
      (* the IR lowering's first step: where the tree and the emitter
         disagree on what can raise (docs/ir-plan.md), on stderr *)
      IF Text.BLen (Gen.IrReport ()) > 0 THEN
        Io.ErrLine (Cat ('m9c: ircheck ', Cat (name, ':'))) ;
        Io.ErrLine (Gen.IrReport ())
      END ;
      IF Gen.Errs () > 0 THEN
        (* each error with its line, the way g1 always did on the
           host side -- a count alone cost a bisect every time, and
           then cost one inside the tutorial *)
        i := 0 ;
        WHILE i < Gen.Errs () AND i < 8 DO
          DiagN (Cat (ErrFile (Gen.ErrModAt (i), main), ':'), Gen.ErrLineAt (i), ': gen: ',
                 Gen.ErrMsgAt (i)) ;
          i := i + 1
        END ;
        DiagN ('m9c: ', Gen.Errs (), ' generator errors in ', main) ;
        failed := TRUE
      ELSIF doCheck THEN
        (* the stop with empty hands: every diagnostic the build would
           print has been printed, the exit code says whether the
           program exists, and nothing appears on disk.  What an
           editor asks. *)
        IF doReview THEN
          (* and what a REVIEWER asks: the checker and the generator
             have both accepted the program, so the page may say
             `proved' *)
          Io.Write (ReviewText (root, name))
        END ;
        RETURN
      ELSE
        (* the scratch is made only for a program that will be built,
           and goes again before the program starts: empty, which is
           what every file in it leaving by Rename or Drop makes it *)
        IF doRun OR doCell THEN
          MkDirs (work) ;
          MkDirs (Join (cacheRoot, 'mod')) ;
          MkDirs (Join (cacheRoot, 'bin'))
        END ;
        Io.WriteFile (Join (outDir, Suffix (name, '.h')), Gen.HText ()) ;
        Io.WriteFile (Join (outDir, Suffix (name, '.c')), Gen.CText ()) ;
        IF NOT doRun AND NOT doCell THEN
          StaleBeside (main, outDir, name, Gen.HText ())
        END ;
        (* said under -v: a stale NAME.h beside a driver beats the fresh
           one (a quoted include searches the including directory first),
           and where the fresh one went is the first thing to know *)
        IF verbose THEN
          Diag ('m9c: wrote ', Join (outDir, Suffix (name, '.h')),
                Cat (' and ', Join (outDir, Suffix (name, '.c'))))
        END ;
        IF doRun THEN
          built := RunBuild (name) ;
          (* a failed build may leave what it was working on, for
             whoever reads the diagnostics; a good one leaves nothing *)
          IF NOT Io.Remove (work) AND built THEN
            Diag ('m9c: could not remove ', work, '')
          END ;
          IF built THEN Launch () ELSE failed := TRUE END
        ELSIF doCell THEN
          built := CellBuild (name) ;
          IF NOT Io.Remove (work) AND built THEN
            Diag ('m9c: could not remove ', work, '')
          END ;
          IF built THEN CellReport () ELSE failed := TRUE END
        ELSIF doCompile THEN
          IF Compile (name) THEN
            (* the C was a by-product and the object exists, so it
               goes -- but the HEADER only goes when linking, because
               under -c it is still this module's interface and the
               next module's generated C includes it.  A LIBRARY
               keeps it for the same reason a -c run does, and more
               so: the header is how anybody calls the library. *)
            IF NOT keepC THEN
              Drop (Suffix (name, '.c')) ;
              IF doLink THEN Drop (Suffix (name, '.h')) END
            END ;
            IF Text.BLen (lib) > 0 THEN
              IF NOT Archive (name) THEN failed := TRUE END
            END
          ELSE
            failed := TRUE
          END
        END
      END
    END
  END ;
  IF failed THEN Io.Halt (1) END
EXCEPT
| Io.IOError (path) :
    Complain ('cannot read or write', UTF (path)) ;
    Io.Halt (1)
| ValueRange :
    Complain ('source is not text', main) ;
    Io.Halt (1)
| IndexError :
    Complain ('missing argument', main) ;
    Io.Halt (1)
END M9c.
