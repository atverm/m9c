    3434129695, 1946996346, 1723425172, 3724871409] ;
PROCEDURE CrcRun (c: I64 ; RO b: SLICE OF BYTE) : I64 RAISES ValueRange ;

PROCEDURE Crc32 (RO b: SLICE OF BYTE) : I64 RAISES ValueRange =
BEGIN
  RETURN Bits.Xor (CrcRun (4294967295, b), 4294967295)
END Crc32 ;

(* the raw state carried over `b': begun at all ones, finished by the
   same, so that a member read in pieces is summed as a whole *)
PROCEDURE CrcRun (c: I64 ; RO b: SLICE OF BYTE) : I64 RAISES ValueRange =
VAR i, n : I64 ;
BEGIN
  n := LEN (b) ;
  i := 0 ;
  WHILE i + 4 <= n DO
    c := Bits.Xor (c, I64 (b[i]) + 256 * I64 (b[i + 1]) + 65536 * I64 (b[i + 2])
                      + 16777216 * I64 (b[i + 3])) ;
    c := Bits.Xor (Bits.Xor (Crc3[Bits.And (c, 255)],
                             Crc2[Bits.And (Bits.Shr (c, 8), 255)]),
                   Bits.Xor (Crc1[Bits.And (Bits.Shr (c, 16), 255)],
                             Crc0[Bits.Shr (c, 24)])) ;
    i := i + 4
  END ;
  WHILE i < n DO
    c := Bits.Xor (Crc0[Bits.And (Bits.Xor (c, I64 (b[i])), 255)],
                   Bits.Shr (c, 8)) ;
    i := i + 1
  END ;
  RETURN c
END CrcRun ;

(* ---- a member of an archive ---- *)

PROCEDURE OpenMember (VAR pool: POOL ; KEPT a: PTR Archive ; i: I64 ;
                      block: I64) : PTR Member IN pool
  RAISES Error, Io.IOError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  m : PTR Member IN pool ;
  lh : SLICE OF BYTE ;
BEGIN
  IF i < 0 OR i >= a.n THEN RAISE IndexError END ;
  IF a.e[i].method # Stored AND a.e[i].method # Deflated THEN
    RAISE Error ('compression method not supported: ' + a.e[i].name)
  END ;
  IF block <= 0 THEN block := DefaultBlock END ;
  (* the decoder is not begun with less than LowWater at hand, and the
     buffer must hold that beside a read *)
  IF block < 4 * LowWater THEN block := 4 * LowWater END ;

  (* the DATA offset comes from the LOCAL header, whose name and extra
     lengths differ from the central directory's -- a classic way to
     read a member off by a few bytes *)
  lh := Io.ReadFileAt (scratch, a.path, a.e[i].hdrOff, 30) ;
  IF LEN (lh) < 30 OR U (lh, 0, 4) # SigLoc THEN
    RAISE Error ('the local header is missing for ' + a.e[i].name)
  END ;
  m := NEW (pool, Member) ;
  m.path := a.path ;
  m.name := a.e[i].name ;
  m.stored := a.e[i].method = Stored ;
  m.dataOff := a.e[i].hdrOff + 30 + U (lh, 26, 2) + U (lh, 28, 2) ;
  m.cLeft := a.e[i].csize ;
  m.done := FALSE ;
  m.crc := 4294967295 ;
  m.want := a.e[i].crc ;
  m.made := 0 ;
  m.usize := a.e[i].usize ;
  IF NOT m.stored THEN
    InflInit (pool, m.z) ;
    m.z.inb := NEW (pool, BYTE, block)
  END ;
  RETURN m
END OpenMember ;

(* more compressed bytes into the decoder's buffer when it is running
   low: what is left unread moves to the front and the file fills the
   rest *)
PROCEDURE Fill (VAR m: PTR Member)
  RAISES Io.IOError, ValueRange =
VAR
  scratch : POOL ;
  got : SLICE OF BYTE ;
  want, k, keep : I64 ;
BEGIN
  keep := m.z.inLen - m.z.inPos ;
  IF keep >= LowWater OR m.cLeft = 0 THEN
    m.z.last := m.cLeft = 0 ;
    RETURN
  END ;
  FOR k := 0 TO keep - 1 DO m.z.inb[k] := m.z.inb[m.z.inPos + k] END ;
  want := LEN (m.z.inb) - keep ;
  IF want > m.cLeft THEN want := m.cLeft END ;
  got := Io.ReadFileAt (scratch, m.path, m.dataOff, want) ;
  FOR k := 0 TO LEN (got) - 1 DO m.z.inb[keep + k] := got[k] END ;
  m.z.inPos := 0 ;
  m.z.inLen := keep + LEN (got) ;
  m.dataOff := m.dataOff + LEN (got) ;
  m.cLeft := m.cLeft - LEN (got) ;
  (* a file shorter than its directory says is the end all the same *)
  IF LEN (got) = 0 THEN m.cLeft := 0 END ;
  m.z.last := m.cLeft = 0
END Fill ;

(* the member's end: what was read is held to the CRC-32 and the
   length its directory states, as zipfile holds it (2026-10-03; until
   then only gzip's trailer was checked).  A bit turned mid-stream
   usually still DECODES, to other bytes; this is what says so. *)
PROCEDURE Finished (VAR m: PTR Member) RAISES Error, ValueRange =
BEGIN
  m.done := TRUE ;
  IF m.made # m.usize THEN
    RAISE Error ('the length of ' + m.name + ' is not what its directory states')
  END ;
  IF Bits.Xor (m.crc, 4294967295) # m.want THEN
    RAISE Error ('the CRC of ' + m.name + ' does not match its bytes')
  END
END Finished ;

PROCEDURE Read (VAR m: PTR Member ; VAR dst: SLICE OF BYTE) : I64
  RAISES Error, Io.IOError, ValueRange =
VAR
  scratch : POOL ;
  got : SLICE OF BYTE ;
  want, k, out, prev : I64 ;
BEGIN
  IF m.done OR LEN (dst) = 0 THEN RETURN 0 END ;

  IF m.stored THEN
    want := LEN (dst) ;
    IF want > m.cLeft THEN want := m.cLeft END ;
    IF want = 0 THEN Finished (m) ; RETURN 0 END ;
    got := Io.ReadFileAt (scratch, m.path, m.dataOff, want) ;
    FOR k := 0 TO LEN (got) - 1 DO dst[k] := got[k] END ;
    m.dataOff := m.dataOff + LEN (got) ;
    m.cLeft := m.cLeft - LEN (got) ;
    m.crc := CrcRun (m.crc, got) ;
    m.made := m.made + LEN (got) ;
    IF LEN (got) = 0 THEN Finished (m) END ;
    RETURN LEN (got)
  END ;

  out := 0 ;
  LOOP
    Fill (m) ;
    prev := out ;
    out := Step (m.z, dst, out) ;
    IF m.z.bad THEN RAISE Error ('the deflate stream is corrupt') END ;
    IF m.z.short THEN RAISE Error ('the member ends mid-stream') END ;
    m.crc := CrcRun (m.crc, SLICE (dst, prev, out - prev)) ;
    m.made := m.made + out - prev ;
    IF m.z.state = StDone THEN
      Finished (m) ;
      RETURN out
    END ;
    IF out = LEN (dst) THEN RETURN out END
  END
END Read ;

PROCEDURE Close (VAR m: PTR Member) =
BEGIN
  m.done := TRUE
END Close ;

(* ---- gzip ---- *)

(* where the header of the member at `at' ends and its deflate stream
   begins (RFC 1952): ten fixed bytes, then whatever the flags say *)
PROCEDURE GzHeader (RO data: SLICE OF BYTE ; at: I64) : I64
  RAISES Error, IndexError =
VAR
  n, flags, p : I64 ;
BEGIN
  n := LEN (data) ;
  IF n - at < 18 THEN RAISE Error ('the gzip stream stops inside a header') END ;
  IF I64 (data[at]) # 31 OR I64 (data[at + 1]) # 139 THEN
    IF at = 0 THEN RAISE Error ('not gzip: it does not begin 1F 8B') END ;
    RAISE Error ('bytes after the last gzip member')
  END ;
  IF I64 (data[at + 2]) # 8 THEN
    RAISE Error ('a gzip method other than deflate')
  END ;
  flags := I64 (data[at + 3]) ;
  p := at + 10 ;
  IF (flags DIV 4) MOD 2 = 1 THEN              (* FEXTRA: a length, and that many *)
    p := p + 2 + U (data, p, 2)
  END ;
  IF (flags DIV 8) MOD 2 = 1 THEN              (* FNAME: to a zero byte *)
    WHILE p < n AND I64 (data[p]) # 0 DO p := p + 1 END ;
    p := p + 1
  END ;
  IF (flags DIV 16) MOD 2 = 1 THEN             (* FCOMMENT: likewise *)
    WHILE p < n AND I64 (data[p]) # 0 DO p := p + 1 END ;
    p := p + 1
  END ;
  IF (flags DIV 2) MOD 2 = 1 THEN p := p + 2 END ;   (* FHCRC *)
  IF p > n THEN RAISE Error ('the gzip stream stops inside a header') END ;
  RETURN p
END GzHeader ;

PROCEDURE GunzipBytes (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  z : Infl ;
  first, buf, grown, out : SLICE OF BYTE ;
  n, at, total, start, room, k, crc, size : I64 ;
  direct : BOOL ;
BEGIN
  n := LEN (data) ;
  (* the last four bytes are the length of the last member: exact for
     a file of one, which is nearly every file, and then the buffer
     this begins with IS the answer -- so it is made in the caller's
     pool.  Deflate cannot expand by more than 1032, and a length
     that claims more is not believed.

     ONE BYTE MORE than the length: the decoder stops at a full
     buffer before it has read the symbol that ends the block, and a
     buffer of exactly the length was therefore full and not done --
     it grew, and the answer was copied twice (seen in a profile,
     2026-10-02: two byte loops, a quarter of the run). *)
  room := 4096 ;
  IF n >= 18 THEN
    size := U (data, n - 4, 4) ;
    IF size >= room AND size <= 1032 * n THEN room := size + 1 END
  END ;
  first := NEW (pool, BYTE, room) ;
  buf := first ;
  direct := TRUE ;
  InflInit (scratch, z) ;
  z.inb := data ;
  z.inLen := n ;
  z.last := TRUE ;
  z.whole := TRUE ;
  at := 0 ;
  total := 0 ;
  WHILE at < n DO
    at := GzHeader (data, at) ;
    start := total ;
    InflReset (z) ;
    z.inPos := at ;
    LOOP
      total := Step (z, buf, total) ;
      IF z.bad THEN RAISE Error ('the gzip stream is corrupt') END ;
      IF z.short THEN RAISE Error ('the gzip stream stops inside a member') END ;
      IF z.state = StDone THEN EXIT END ;
      (* neither done nor wrong: the buffer is full, and grows *)
      IF total < LEN (buf) THEN RAISE Error ('the gzip stream is corrupt') END ;
      grown := NEW (scratch, BYTE, 2 * LEN (buf)) ;
      FOR k := 0 TO total - 1 DO grown[k] := buf[k] END ;
      buf := grown ;
      direct := FALSE
    END ;
    InflFinish (z) ;
    at := z.inPos ;
    IF n - at < 8 THEN RAISE Error ('the gzip stream stops before its trailer') END ;
    crc := U (data, at, 4) ;
    size := U (data, at + 4, 4) ;
    at := at + 8 ;
    IF Crc32 (SLICE (buf, start, total - start)) # crc THEN
      RAISE Error ('the gzip CRC does not match the bytes')
    END ;
    IF (total - start) MOD 4294967296 # size THEN
      RAISE Error ('the gzip length does not match the bytes')
    END
  END ;
  IF direct THEN RETURN SLICE (first, 0, total) END ;
  (* several members, so that the last one's length was not the
     whole: a copy of the right size *)
  out := NEW (pool, BYTE, total) ;
  FOR k := 0 TO total - 1 DO out[k] := buf[k] END ;
  RETURN out
END GunzipBytes ;

PROCEDURE Gunzip (VAR pool: POOL ; RO path: STR) : SLICE OF BYTE
  RAISES Error, Io.IOError, ValueRange =
VAR scratch : POOL ;
BEGIN
  RETURN GunzipBytes (pool, Io.ReadFileBytes (scratch, path))
END Gunzip ;

(* ---- compressing ----------------------------------------------------

   The stream is ONE block in the fixed code.  Earlier occurrences are
   found through a table of the last place each three-byte beginning
   was seen and a chain from each place to the one before it with the
   same beginning; MaxChain of them are tried, nearest first, and the
   longest match wins.  Fixed code only, no lazy matching: a third of
   what zlib does, for the data this is for. *)

CONST
  HashSize = 32768 ;
  MaxChain = 24 ;
  MinMatch = 3 ;
  MaxMatch = 258 ;

TYPE
  (* the bytes written and the bits not yet a byte *)
  Sink = RECORD
    buf : SLICE OF BYTE ;
    n : I64 ;
    hold, bits : I64 ;
  END ;

(* the low n bits of v, the lowest first *)
PROCEDURE PutBits (VAR o: Sink ; v, n: I64) RAISES ValueRange =
BEGIN
  o.hold := Bits.Or (o.hold, Bits.Shl (v, o.bits)) ;
  o.bits := o.bits + n ;
  WHILE o.bits >= 8 DO
    o.buf[o.n] := BYTE (Bits.And (o.hold, 255)) ;
    o.n := o.n + 1 ;
    o.hold := Bits.Shr (o.hold, 8) ;
    o.bits := o.bits - 8
  END
END PutBits ;

(* a Huffman code of n bits: its HIGHEST bit goes out first *)
PROCEDURE PutCode (VAR o: Sink ; code, n: I64) RAISES ValueRange =
VAR r, i : I64 ;
BEGIN
  r := 0 ;
  FOR i := 0 TO n - 1 DO
    r := r * 2 + Bits.And (Bits.Shr (code, i), 1)
  END ;
  PutBits (o, r, n)
END PutCode ;

(* a literal, the end of the block, or a length symbol, in the fixed
   code *)
PROCEDURE PutSym (VAR o: Sink ; sym: I64) RAISES ValueRange =
BEGIN
  IF sym < 144 THEN PutCode (o, 48 + sym, 8)
  ELSIF sym < 256 THEN PutCode (o, 400 + sym - 144, 9)
  ELSIF sym < 280 THEN PutCode (o, sym - 256, 7)
  ELSE PutCode (o, 192 + sym - 280, 8)
  END
END PutSym ;

(* a copy of len bytes from dist back: the length's symbol and extra
   bits, then the distance's *)
PROCEDURE PutMatch (VAR o: Sink ; len, dist: I64) RAISES ValueRange =
VAR s, d : I64 ;
BEGIN
  s := 28 ;
  WHILE LBase[s] > len DO s := s - 1 END ;
  PutSym (o, 257 + s) ;
  PutBits (o, len - LBase[s], LExt[s]) ;
  d := 29 ;
  WHILE DBase[d] > dist DO d := d - 1 END ;
  PutCode (o, d, 5) ;
  PutBits (o, dist - DBase[d], DExt[d])
END PutMatch ;

PROCEDURE Hash3 (RO b: SLICE OF BYTE ; i: I64) : I64 RAISES ValueRange =
BEGIN
  RETURN Bits.And (Bits.Xor (Bits.Xor (Bits.Shl (I64 (b[i]), 10),
                                        Bits.Shl (I64 (b[i + 1]), 5)),
                             I64 (b[i + 2])),
                   HashSize - 1)
END Hash3 ;

(* the stream in the fixed code, into scratch storage of the size it
   can at most need: nine bits a byte and the block's two ends *)
PROCEDURE FixedBlock (VAR pool: POOL ; RO data: SLICE OF BYTE ;
                      VAR o: Sink)
  RAISES ValueRange =
VAR
  head, prev : SLICE OF I64 ;
  n, i, h, cand, tries, len, best, bestAt, limit, k, stop : I64 ;
BEGIN
  n := LEN (data) ;
  o.buf := NEW (pool, BYTE, n + n DIV 8 + 16) ;
  o.n := 0 ;
  o.hold := 0 ;
  o.bits := 0 ;
  (* a place is kept as itself plus one, so that zero is "none" *)
  head := NEW (pool, I64, HashSize) ;
  prev := NEW (pool, I64, WinSize) ;
  PutBits (o, 1, 1) ;                   (* the last block *)
  PutBits (o, 1, 2) ;                   (* in the fixed code *)
  i := 0 ;
  WHILE i < n DO
    best := 0 ;
    bestAt := 0 ;
    IF i + MinMatch <= n THEN
      h := Hash3 (data, i) ;
      limit := n - i ;
      IF limit > MaxMatch THEN limit := MaxMatch END ;
      cand := head[h] - 1 ;
      tries := 0 ;
      WHILE cand >= 0 AND i - cand <= WinSize AND tries < MaxChain DO
        len := 0 ;
        WHILE len < limit AND data[cand + len] = data[i + len] DO
          len := len + 1
        END ;
        IF len > best THEN
          best := len ;
          bestAt := cand
        END ;
        IF best >= limit THEN
          tries := MaxChain
        ELSE
          tries := tries + 1 ;
          k := prev[Bits.And (cand, WinMask)] - 1 ;
          (* a chain runs backwards; an entry that does not is one the
             ring has since given to a later place *)
          IF k >= cand THEN cand := -1 ELSE cand := k END
        END
      END
    END ;
    IF best >= MinMatch THEN
      PutMatch (o, best, i - bestAt) ;
      stop := i + best
    ELSE
      PutSym (o, I64 (data[i])) ;
      stop := i + 1
    END ;
    (* every place passed is entered, so that later bytes find it *)
    WHILE i < stop DO
      IF i + MinMatch <= n THEN
        h := Hash3 (data, i) ;
        prev[Bits.And (i, WinMask)] := head[h] ;
        head[h] := i + 1
      END ;
      i := i + 1
    END
  END ;
  PutSym (o, 256) ;
  IF o.bits > 0 THEN PutBits (o, 0, 8 - o.bits) END
END FixedBlock ;

(* the same bytes as stored blocks of at most 65535: five bytes of
   header each *)
PROCEDURE StoredBlocks (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES ValueRange =
VAR
  out : SLICE OF BYTE ;
  n, at, len, w, k, last : I64 ;
BEGIN
  n := LEN (data) ;
  out := NEW (pool, BYTE, n + 5 * (n DIV 65535 + 1)) ;
  at := 0 ;
  w := 0 ;
  LOOP
    len := n - at ;
    IF len > 65535 THEN len := 65535 END ;
    IF at + len = n THEN last := 1 ELSE last := 0 END ;
    out[w] := BYTE (last) ;
    out[w + 1] := BYTE (len MOD 256) ;
    out[w + 2] := BYTE (len DIV 256) ;
    out[w + 3] := BYTE (255 - len MOD 256) ;
    out[w + 4] := BYTE (255 - len DIV 256) ;
    w := w + 5 ;
    FOR k := 0 TO len - 1 DO out[w + k] := data[at + k] END ;
    w := w + len ;
    at := at + len ;
    IF last = 1 THEN EXIT END
  END ;
  RETURN SLICE (out, 0, w)
END StoredBlocks ;

(* the stream with `front` bytes of room before it and `back` after,
   for a wrapping to fill; the stream begins at out[front] *)
PROCEDURE Packed (VAR pool: POOL ; RO data: SLICE OF BYTE ;
                  front, back: I64) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  scratch : POOL ;
  o : Sink ;
  body, out : SLICE OF BYTE ;
  k : I64 ;
BEGIN
  FixedBlock (scratch, data, o) ;
  body := SLICE (o.buf, 0, o.n) ;
  IF o.n > LEN (data) + 5 * (LEN (data) DIV 65535 + 1) THEN
    body := StoredBlocks (scratch, data)
  END ;
  out := NEW (pool, BYTE, front + LEN (body) + back) ;
  FOR k := 0 TO LEN (body) - 1 DO out[front + k] := body[k] END ;
  RETURN out
END Packed ;

PROCEDURE Deflate (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES ValueRange =
BEGIN
  RETURN Packed (pool, data, 0, 0)
END Deflate ;

PROCEDURE Adler32 (RO b: SLICE OF BYTE) : I64 =
VAR a, s, i, stop, n : I64 ;
BEGIN
  a := 1 ;
  s := 0 ;
  n := LEN (b) ;
  i := 0 ;
  WHILE i < n DO
    (* the sums are brought back under 65521 every 5552 bytes: zlib's
       number, the most a 32-bit sum can take.  These are 64 bits and
       could take far more; it is only how often the remainder is
       taken *)
    stop := i + 5552 ;
    IF stop > n THEN stop := n END ;
    WHILE i < stop DO
      a := a + I64 (b[i]) ;
      s := s + a ;
      i := i + 1
    END ;
    a := a MOD 65521 ;
    s := s MOD 65521
  END ;
  RETURN s * 65536 + a
END Adler32 ;

(* v as n bytes at out[at], the lowest first or the highest first *)
PROCEDURE PutLow (VAR out: SLICE OF BYTE ; at, v, n: I64) RAISES ValueRange =
VAR k : I64 ;
BEGIN
  FOR k := 0 TO n - 1 DO
    out[at + k] := BYTE (v MOD 256) ;
    v := v DIV 256
  END
END PutLow ;

PROCEDURE PutHigh (VAR out: SLICE OF BYTE ; at, v, n: I64) RAISES ValueRange =
VAR k : I64 ;
BEGIN
  FOR k := n - 1 TO 0 BY -1 DO
    out[at + k] := BYTE (v MOD 256) ;
    v := v DIV 256
  END
END PutHigh ;

PROCEDURE Compress (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES ValueRange =
VAR out : SLICE OF BYTE ;
BEGIN
  out := Packed (pool, data, 2, 4) ;
  (* deflate with a 32 K window; the second byte makes the two a
     multiple of 31, and says "fastest" of the level *)
  out[0] := BYTE (120) ;
  out[1] := BYTE (1) ;
  PutHigh (out, LEN (out) - 4, Adler32 (data), 4) ;
  RETURN out
END Compress ;

PROCEDURE Decompress (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  z : Infl ;
  buf, grown, out : SLICE OF BYTE ;
  n, total, k, at : I64 ;
BEGIN
  n := LEN (data) ;
  IF n < 6 THEN RAISE Error ('the zlib stream stops inside its header') END ;
  IF I64 (data[0]) MOD 16 # 8 OR
     (I64 (data[0]) * 256 + I64 (data[1])) MOD 31 # 0 THEN
    RAISE Error ('not zlib: its first two bytes are not a zlib header')
  END ;
  IF (I64 (data[1]) DIV 32) MOD 2 = 1 THEN
    RAISE Error ('the zlib stream asks for a preset dictionary')
  END ;
  (* the whole of the answer stays in one buffer, as in GunzipBytes,
     and the buffer grows when it is full *)
  buf := NEW (scratch, BYTE, 4 * n + 4096) ;
  InflInit (scratch, z) ;
  z.inb := data ;
  z.inLen := n ;
  z.last := TRUE ;
  z.whole := TRUE ;
  InflReset (z) ;
  z.inPos := 2 ;
  total := 0 ;
  LOOP
    total := Step (z, buf, total) ;
    IF z.bad THEN RAISE Error ('the zlib stream is corrupt') END ;
    IF z.short THEN RAISE Error ('the zlib stream stops inside its data') END ;
    IF z.state = StDone THEN EXIT END ;
    IF total < LEN (buf) THEN RAISE Error ('the zlib stream is corrupt') END ;
    grown := NEW (scratch, BYTE, 2 * LEN (buf)) ;
    FOR k := 0 TO total - 1 DO grown[k] := buf[k] END ;
    buf := grown
  END ;
  InflFinish (z) ;
  at := z.inPos ;
  IF n - at < 4 THEN
    RAISE Error ('the zlib stream stops before its checksum')
  END ;
  out := NEW (pool, BYTE, total) ;
  FOR k := 0 TO total - 1 DO out[k] := buf[k] END ;
  IF Adler32 (out) # ((I64 (data[at]) * 256 + I64 (data[at + 1])) * 256
                      + I64 (data[at + 2])) * 256 + I64 (data[at + 3]) THEN
    RAISE Error ('the zlib checksum does not match the bytes')
  END ;
  IF at + 4 # n THEN RAISE Error ('bytes after the zlib stream') END ;
  RETURN out
END Decompress ;

PROCEDURE Gzip (VAR pool: POOL ; RO data: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES ValueRange =
VAR
  out : SLICE OF BYTE ;
  crc : I64 ;
BEGIN
  out := Packed (pool, data, 10, 8) ;
  out[0] := BYTE (31) ;
  out[1] := BYTE (139) ;
  out[2] := BYTE (8) ;                  (* deflate *)
  (* no flags, no time, no extra flags: bytes 3 to 8 stay zero *)
  out[9] := BYTE (255) ;                (* written on no system in particular *)
  crc := Crc32 (data) ;
  PutLow (out, LEN (out) - 8, crc, 4) ;
  PutLow (out, LEN (out) - 4, LEN (data) MOD 4294967296, 4) ;
  RETURN out
END Gzip ;


(* ---- writing an archive (2026-10-07) ------------------------------- *)

CONST
  Max32 = 4294967295 ;
  MaxMembers = 65535 ;
  MaxName = 65535 ;
  LocHdr = 30 ;
  CenHdr = 46 ;
  EocdLen = 22 ;

TYPE
  WEntry = RECORD
    name : SLICE OF BYTE ;       (* UTF-8, as written *)
    data : SLICE OF BYTE ;       (* as stored: deflated or the bytes *)
    method, crc, usize, dosTime, dosDate : I64 ;
  END ;

  Writer = RECORD
    e : SLICE OF WEntry ;
    n : I64 ;
    dosTime, dosDate : I64 ;     (* for the members added next *)
  END ;

PROCEDURE NewWriter (VAR pool: POOL) : PTR Writer IN pool =
VAR w : PTR Writer IN pool ;
BEGIN
  w := NEW (pool, Writer) ;
  w.e := NEW (pool, WEntry, 8) ;
  w.n := 0 ;
  w.dosTime := 0 ;               (* 1980-01-01 00:00:00 *)
  w.dosDate := 33 ;
  RETURN w
END NewWriter ;

PROCEDURE SetTime (VAR w: PTR Writer ; year, month, day, hour, minute,
                   second: I64) RAISES Error =
BEGIN
  IF year < 1980 OR year > 2107 OR month < 1 OR month > 12 OR day < 1 OR
     day > 31 OR hour < 0 OR hour > 23 OR minute < 0 OR minute > 59 OR
     second < 0 OR second > 59 THEN
    RAISE Error ('not a time a zip can hold (1980..2107, a calendar date, a time of day)')
  END ;
  w.dosDate := (year - 1980) * 512 + month * 32 + day ;
  w.dosTime := hour * 2048 + minute * 32 + second DIV 2
END SetTime ;

PROCEDURE Kept (VAR w: PTR Writer ; RO b: SLICE OF BYTE) : SLICE OF BYTE =
  (* a copy in the writer's pool *)
VAR
  c : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  c := NEW (w, BYTE, LEN (b)) ;
  FOR i := 0 TO LEN (b) - 1 DO c[i] := b[i] END ;
  RETURN c
END Kept ;

PROCEDURE SameBytes (RO a, b: SLICE OF BYTE) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF a[i] # b[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END SameBytes ;

PROCEDURE Laid (w: PTR Writer) : I64 =
  (* the bytes of the local headers and data so far *)
VAR i, t : I64 ;
BEGIN
  t := 0 ;
  FOR i := 0 TO w.n - 1 DO
    t := t + LocHdr + LEN (w.e[i].name) + LEN (w.e[i].data)
  END ;
  RETURN t
END Laid ;

PROCEDURE AddBytes (VAR w: PTR Writer ; RO name: STR ;
                    RO data: SLICE OF BYTE ; deflate: BOOL)
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  nm, packed : SLICE OF BYTE ;
  more : SLICE OF WEntry ;
  i : I64 ;
BEGIN
  IF LEN (name) = 0 THEN RAISE Error ('a member needs a name') END ;
  nm := DynStr.Utf8 (scratch, name) ;
  IF LEN (nm) > MaxName THEN
    RAISE Error ('a member name over 65535 octets: ' + SLICE (name, 0, 40) + '...')
  END ;
  FOR i := 0 TO w.n - 1 DO
    IF SameBytes (w.e[i].name, nm) THEN
      RAISE Error ('a member named twice: ' + name)
    END
  END ;
  IF w.n = MaxMembers THEN RAISE Error ('more than 65535 members') END ;
  IF LEN (data) > Max32 THEN RAISE Error ('a member past 4 GB (ZIP64 is not written): ' + name) END ;
  IF deflate THEN packed := Deflate (scratch, data) ELSE packed := data END ;
  IF LEN (packed) > Max32 THEN RAISE Error ('a member past 4 GB (ZIP64 is not written): ' + name) END ;
  IF Laid (w) + LocHdr + LEN (nm) + LEN (packed) + (w.n + 1) * CenHdr + EocdLen > Max32 THEN
    RAISE Error ('an archive past 4 GB (ZIP64 is not written)')
  END ;
  IF w.n = LEN (w.e) THEN
    more := NEW (w, WEntry, 2 * w.n) ;
    FOR i := 0 TO w.n - 1 DO more[i] := w.e[i] END ;
    w.e := more
  END ;
  w.e[w.n].name := Kept (w, nm) ;
  w.e[w.n].data := Kept (w, packed) ;
  IF deflate THEN w.e[w.n].method := Deflated ELSE w.e[w.n].method := Stored END ;
  w.e[w.n].crc := Crc32 (data) ;
  w.e[w.n].usize := LEN (data) ;
  w.e[w.n].dosTime := w.dosTime ;
  w.e[w.n].dosDate := w.dosDate ;
  w.n := w.n + 1
END AddBytes ;

PROCEDURE AddFile (VAR w: PTR Writer ; RO name: STR ; RO path: STR ;
                   deflate: BOOL)
  RAISES Error, Io.IOError, ValueRange =
VAR scratch : POOL ;
BEGIN
  AddBytes (w, name, Io.ReadFileBytes (scratch, path), deflate)
END AddFile ;

PROCEDURE Finish (VAR w: PTR Writer) : SLICE OF BYTE
  RAISES Error, ValueRange =
VAR
  out : SLICE OF BYTE ;
  i, j, at, cdAt, cdLen, hdrOff : I64 ;
BEGIN
  cdLen := 0 ;
  FOR i := 0 TO w.n - 1 DO cdLen := cdLen + CenHdr + LEN (w.e[i].name) END ;
  cdAt := Laid (w) ;
  out := NEW (w, BYTE, cdAt + cdLen + EocdLen) ;
  at := 0 ;
  FOR i := 0 TO w.n - 1 DO
    PutLow (out, at, SigLoc, 4) ;
    PutLow (out, at + 4, 20, 2) ;                       (* version needed: 2.0 *)
    PutLow (out, at + 6, 2048, 2) ;                     (* bit 11: UTF-8 names *)
    PutLow (out, at + 8, w.e[i].method, 2) ;
    PutLow (out, at + 10, w.e[i].dosTime, 2) ;
    PutLow (out, at + 12, w.e[i].dosDate, 2) ;
    PutLow (out, at + 14, w.e[i].crc, 4) ;
    PutLow (out, at + 18, LEN (w.e[i].data), 4) ;
    PutLow (out, at + 22, w.e[i].usize, 4) ;
    PutLow (out, at + 26, LEN (w.e[i].name), 2) ;
    PutLow (out, at + 28, 0, 2) ;                       (* no extra field *)
    at := at + LocHdr ;
    FOR j := 0 TO LEN (w.e[i].name) - 1 DO out[at + j] := w.e[i].name[j] END ;
    at := at + LEN (w.e[i].name) ;
    FOR j := 0 TO LEN (w.e[i].data) - 1 DO out[at + j] := w.e[i].data[j] END ;
    at := at + LEN (w.e[i].data)
  END ;
  hdrOff := 0 ;
  FOR i := 0 TO w.n - 1 DO
    PutLow (out, at, SigCen, 4) ;
    PutLow (out, at + 4, 20, 2) ;                       (* made by 2.0, MS-DOS attributes *)
    PutLow (out, at + 6, 20, 2) ;
    PutLow (out, at + 8, 2048, 2) ;
    PutLow (out, at + 10, w.e[i].method, 2) ;
    PutLow (out, at + 12, w.e[i].dosTime, 2) ;
    PutLow (out, at + 14, w.e[i].dosDate, 2) ;
    PutLow (out, at + 16, w.e[i].crc, 4) ;
    PutLow (out, at + 20, LEN (w.e[i].data), 4) ;
    PutLow (out, at + 24, w.e[i].usize, 4) ;
    PutLow (out, at + 28, LEN (w.e[i].name), 2) ;
    PutLow (out, at + 30, 0, 2) ;                       (* extra *)
    PutLow (out, at + 32, 0, 2) ;                       (* comment *)
    PutLow (out, at + 34, 0, 2) ;                       (* disk *)
    PutLow (out, at + 36, 0, 2) ;                       (* internal attributes *)
    PutLow (out, at + 38, 0, 4) ;                       (* external attributes *)
    PutLow (out, at + 42, hdrOff, 4) ;
    at := at + CenHdr ;
    FOR j := 0 TO LEN (w.e[i].name) - 1 DO out[at + j] := w.e[i].name[j] END ;
    at := at + LEN (w.e[i].name) ;
    hdrOff := hdrOff + LocHdr + LEN (w.e[i].name) + LEN (w.e[i].data)
  END ;
  PutLow (out, at, SigEocd, 4) ;
  PutLow (out, at + 4, 0, 2) ;
  PutLow (out, at + 6, 0, 2) ;
  PutLow (out, at + 8, w.n, 2) ;
  PutLow (out, at + 10, w.n, 2) ;
  PutLow (out, at + 12, cdLen, 4) ;
  PutLow (out, at + 16, cdAt, 4) ;
  PutLow (out, at + 20, 0, 2) ;
  RETURN out
END Finish ;

PROCEDURE WriteTo (VAR w: PTR Writer ; RO path: STR)
  RAISES Error, Io.IOError, ValueRange =
BEGIN
  Io.WriteFileBytes (path, Finish (w))
END WriteTo ;

END Zip.
