DEFINITION MODULE Grib ;

(* ecCodes: GRIB 1 and GRIB 2 messages, read.

   Written for the FLEXPART port, whose wind fields arrive this way.
   The model's own usage is the specification for this surface --
   grib_open_file, grib_new_from_file, grib_get_int, grib_get_real,
   grib_get_size, grib_get_string, grib_multi_support_on and
   grib_release, wrapped in a grib_check that halts.  What is here is
   those, and nothing yet for writing: no caller has asked.

   WHAT THE BINDING FIXES ABOUT THE C API.

   ecCodes reports through an int and expects every caller to test
   it; FLEXPART tests it 111 times through a macro that stops the
   program.  Here a bad code is an Error carrying the operation, the
   key it was reading, the library's own message and the number.  A
   reader that halts cannot be tested, and a reader of somebody
   else's data will meet a bad message eventually.

   A KEY THAT IS NOT THERE is not an error in the same sense as a
   corrupt file, so Has answers the question without raising.  GRIB
   is a format where the sensible thing to do about a missing key is
   usually to try another one.

   THREADS, AND THE ANNOTATION IS SPLIT BECAUSE THE MEASUREMENT SAID
   SO.  This module used to declare everything [SERIAL] on the
   argument that ecCodes has a process-wide context and the Debian
   build compiles its mutexes out -- the blosc museum piece.  The
   argument was never tested, and when it was it did not hold.

   What was measured (2026-08-25, port/flexpart/gribcold_probe.c).
   Debian's libeccodes really does have ZERO pthread_mutex
   relocations, and in the 2.48 source the mutex is an empty class
   when GRIB_PTHREADS=0.  So the decode runs unprotected, and the
   probe tries hard to catch it: the index is built from the GRIB
   headers WITHOUT ecCodes, so the first library call in the process
   is made by N threads at once; a barrier releases them at that
   instant; round-robin makes them load different code tables
   together.  **100 fresh processes at 24 threads on a global field
   and 60 on a nested one: 0 wrong values, 0 crashes**, with peak RSS
   146 -> 170 MB, which is thread stacks and not duplicated caches.

   The source says why.  What a DECODE shares is append-only caches
   -- the action-file list, the code tables, the key-name tries --
   and per-handle counters; losing a race there costs a duplicate
   parse or a leaked entry, not a wrong value.  What a FILE WALK
   shares is the file pool and the multi-field state, which are
   mutated in place.

   So: the accessors and FromBytes are [REENTRANT], and Open, Close,
   Next, Count and MultiSupport stay [SERIAL].  Two conditions come
   with it, and a caller who ignores them is on their own -- decode
   ONE file serially first so that no lazy initialisation ever
   happens concurrently (Windfields.Readwind reads its first field
   with threads = 1 for exactly this reason), and hold parallel
   decoding to a differential test, because 160 clean runs of two
   message shapes is an argument and not a proof.                   *)

TYPE
  File ;                          (* an open GRIB file *)
  Message ;                       (* one decoded message from it *)

  Index = RECORD                  (* where each message begins *)
    n : I64 ;
    off : SLICE OF I64 ;
    len : SLICE OF I64 ;
  END ;

EXCEPTION
  Error (RO op: STR ; RO key: STR ; RO detail: STR ; code: I64) ;
  SizeError (got, want: I64) ;

PROCEDURE Open (VAR pool: POOL ; RO path: STR) : PTR File IN pool
  RAISES Error, ValueRange ;
PROCEDURE Close (VAR f: PTR File) ;
  (* closing a file nobody can read from cannot fail in a way a
     caller could act on, so this does not raise                     *)

PROCEDURE Count (f: PTR File) : I64 RAISES Error ;
  (* how many messages the file holds.  Rewinds nothing: ecCodes
     counts by scanning, so a call in the middle of a read walk is a
     mistake the C API will not tell you about, and neither can this
     -- stated because it is the one sharp edge left.               *)

PROCEDURE Next (VAR pool: POOL ; f: PTR File ; VAR ok: BOOL)
  : PTR Message IN pool RAISES Error ;
  (* the next message, with ok FALSE at end of file.  End of file is
     not an error: it is how a walk stops.                           *)

PROCEDURE BuildIndex (VAR pool: POOL ; RO data: SLICE OF BYTE) : Index
  RAISES Error, ValueRange, IndexError ;
  (* where every message in a file begins and how long it is, found
     by walking the GRIB HEADERS ALONE -- no ecCodes, no handle, no
     definitions.  "GRIB" at the start, the edition in byte 7, the
     total length in bytes 8..15 (edition 2) or 4..6 (edition 1), and
     "7777" at the end, which is checked rather than assumed: a
     length that does not land on the trailer is a corrupt file and
     is refused here instead of becoming a wrong answer later.

     WHY IT EXISTS.  ecCodes' own walk builds a handle per message to
     find the next one -- 0.134 s of a 0.379 s Readwind on a global
     ERA5 field -- and a handle can only be built by one thread at a
     time in a library whose file pool is a process-wide singleton.
     An index costs a few milliseconds, needs no library at all, and
     hands each message to whichever thread wants it.               *)

PROCEDURE FromBytes (VAR pool: POOL ; RO data: SLICE OF BYTE ;
                     off, len: I64) : PTR Message IN pool
  RAISES Error, ValueRange, IndexError ;
  (* one message, decoded from bytes already in memory rather than
     read from a file.  Answers the same Message a walk answers, so
     every accessor below works on it unchanged.

     This is the [REENTRANT] half of the module -- see THREADS.     *)

PROCEDURE Release (VAR m: PTR Message) ;
  (* every message a walk takes must be released, and the handle is
     the library's, not the pool's.  A message used after Release is
     the use-after-free this language is supposed to make hard, and
     it is the reason Release takes VAR and clears the handle: the
     next call answers a diagnosis rather than reading freed memory. *)

PROCEDURE Has (m: PTR Message ; RO key: STR) : BOOL RAISES ValueRange ;
PROCEDURE GetI64 (m: PTR Message ; RO key: STR) : I64
  RAISES Error, ValueRange ;
PROCEDURE GetF64 (m: PTR Message ; RO key: STR) : F64
  RAISES Error, ValueRange ;
PROCEDURE GetStr (VAR pool: POOL ; m: PTR Message ; RO key: STR) : STR
  RAISES Error, ValueRange ;
PROCEDURE Size (m: PTR Message ; RO key: STR) : I64
  RAISES Error, ValueRange ;
  (* the number of elements a key holds -- for `values`, the number
     of grid points *)

PROCEDURE Values (m: PTR Message ; out: SLICE OF F64)
  RAISES Error, SizeError, ValueRange ;
  (* the decoded field.  LEN (out) must be Size (m, 'values'), and is
     checked here rather than trusted: the C call takes a length by
     pointer and will happily write what the caller claimed there
     was room for.                                                   *)

PROCEDURE Floats (m: PTR Message ; RO key: STR ; out: SLICE OF F32)
  RAISES Error, SizeError, ValueRange ;
  (* the same, into single precision, because that is what some
     readers do and it is not the same answer.  FLEXPART's buffer is
     `real(kind=4) :: zsec4` and it reads through
     grib_get_real4_array, so every value the model sees has been
     rounded to float32 first.

     Measured on 20 messages of an ERA5 file: 31,461 of 1,303,200
     values differ from the double read, by at most one float32 ULP.
     A port that reads doubles here cannot be held to the original
     bit for bit, so the port reads floats and says why.            *)

PROCEDURE Doubles (m: PTR Message ; RO key: STR ; out: SLICE OF F64)
  RAISES Error, SizeError, ValueRange ;
  (* any double array, by key, with the same length check.  `values`
     is the common one and has its own name above; this is for the
     others -- `pv`, the vertical coordinate coefficients, which
     FLEXPART's gridcheck reads to build akm and bkm.               *)

PROCEDURE ReadGrid2 (VAR pool: POOL ; m: PTR Message)
  : GRID 2 OF F64 RAISES Error, SizeError, ValueRange ;
  (* the field as Nj by Ni, the shape the message declares.  Latitude
     first, because that is the order the values are stored in and
     the order every GRIB tool prints them.                          *)

PROCEDURE MultiSupport (on: BOOL) ;
  (* GRIB 2 multi-field messages: several fields in one message, off
     by default in ecCodes and turned on by every model that reads
     ECMWF data.  A process-wide switch, which is why it takes no
     handle and why the module is honest about that.                 *)

END Grib.


UNSAFE DEFINITION MODULE FOR "C" cgrib ;

(* libeccodes, verbatim, plus the two libc calls its file API
   obliges: ecCodes takes a FILE *, so a caller must fopen.

   [SERIAL] on what mutates the process-wide context -- the file
   pool, the multi-field switch, the counting walk.  [REENTRANT] on
   the accessors and on building a handle from bytes, which share
   only append-only caches.  Measured, not assumed: see THREADS in
   the definition above.                                            *)

PROCEDURE COpen = "fopen" (path: C.ConstPtr ; mode: C.ConstPtr)
  : C.MutPtr  [SERIAL] ;
PROCEDURE CClose = "fclose" (f: C.MutPtr) : C.Int  [SERIAL] ;
PROCEDURE CLen = "m9_cstrlen" (s: C.ConstPtr) : C.SSizeT  [REENTRANT] ;
  (* the runtime's shim, not strlen itself: C.ConstPtr is
     `const void *` and string.h has already declared strlen with
     `const char *`, so the foreign declaration would collide *)

PROCEDURE NewFromFile = "codes_grib_handle_new_from_file"
  (ctx: C.MutPtr ; f: C.MutPtr ; err: C.MutPtr) : C.MutPtr  [SERIAL] ;
PROCEDURE HandleDelete = "codes_handle_delete" (h: C.MutPtr) : C.Int
  [REENTRANT] ;
PROCEDURE CountInFile = "codes_count_in_file"
  (ctx: C.MutPtr ; f: C.MutPtr ; n: C.MutPtr) : C.Int  [SERIAL] ;
PROCEDURE NewFromMessage = "codes_handle_new_from_message"
  (ctx: C.MutPtr ; data: C.ConstPtr ; n: C.SizeT) : C.MutPtr
  [REENTRANT] ;
  (* the bytes stay the caller's and must outlive the handle: ecCodes
     does not copy them.  Grib.FromBytes keeps that promise by taking
     the whole file's slice and never freeing it first.             *)

PROCEDURE GetLong = "codes_get_long"
  (h: C.MutPtr ; key: C.ConstPtr ; v: C.MutPtr) : C.Int  [REENTRANT] ;
  (* the out parameter is a C long.  On LP64 that is int64_t, which
     is what C.SSizeT maps to; the same ABI identity Http states for
     ssize_t.  A 32-bit long would need its own type, and this says
     so rather than discovering it on a platform nobody tested.     *)
PROCEDURE GetDouble = "codes_get_double"
  (h: C.MutPtr ; key: C.ConstPtr ; v: C.MutPtr) : C.Int  [REENTRANT] ;
PROCEDURE GetSize = "codes_get_size"
  (h: C.MutPtr ; key: C.ConstPtr ; n: C.MutPtr) : C.Int  [REENTRANT] ;
PROCEDURE GetString = "codes_get_string"
  (h: C.MutPtr ; key: C.ConstPtr ; v: C.MutPtr ; n: C.MutPtr) : C.Int
  [REENTRANT] ;
PROCEDURE GetDoubleArray = "codes_get_double_array"
  (h: C.MutPtr ; key: C.ConstPtr ; v: C.MutPtr ; n: C.MutPtr) : C.Int
  [REENTRANT] ;
PROCEDURE GetFloatArray = "codes_get_float_array"
  (h: C.MutPtr ; key: C.ConstPtr ; v: C.MutPtr ; n: C.MutPtr) : C.Int
  [REENTRANT] ;
PROCEDURE IsDefined = "codes_is_defined"
  (h: C.MutPtr ; key: C.ConstPtr) : C.Int  [REENTRANT] ;
PROCEDURE MultiOn = "codes_grib_multi_support_on" (ctx: C.MutPtr)
  [SERIAL] ;
PROCEDURE MultiOff = "codes_grib_multi_support_off" (ctx: C.MutPtr)
  [SERIAL] ;
PROCEDURE ErrMessage = "grib_get_error_message" (code: C.Int)
  : C.ConstPtr  [SERIAL] ;
PROCEDURE CCopy = "memcpy" (d: C.MutPtr ; s: C.ConstPtr ; n: C.SizeT)
  : C.MutPtr  [REENTRANT] ;

END cgrib.


UNSAFE IMPLEMENTATION MODULE Grib ;

(* UNSAFE for one reason: ADR at the C boundary.  Grep ADR.         *)

IMPORT DynStr ;
FROM cgrib IMPORT COpen, CClose, CLen, CCopy, NewFromFile, HandleDelete,
                  CountInFile, GetLong, GetDouble, GetSize, GetString,
                  GetDoubleArray, GetFloatArray, IsDefined, MultiOn, MultiOff,
                  ErrMessage, NewFromMessage ;

CONST
  MaxStr = 1024 ;
  Nowhere = 0 ;                (* the default context, as a null ctx *)

TYPE
  File = RECORD
    fp : C.MutPtr ;
    path : STR ;
    open : BOOL ;
  END ;

  Message = RECORD
    h : C.MutPtr ;
    live : BOOL ;
  END ;

PROCEDURE Message2 (VAR pool: POOL ; code: I64) : STR
  RAISES ValueRange =
VAR
  p : C.ConstPtr ;
  q : C.MutPtr ;
  n : I64 ;
  b : SLICE OF BYTE ;
BEGIN
  p := ErrMessage (C.Int (code)) ;
  n := I64 (CLen (p)) ;
  IF n > MaxStr THEN n := MaxStr END ;
  b := NEW (pool, BYTE, n + 1) ;
  q := CCopy (ADR (b), p, C.SizeT (n)) ;
  RETURN DynStr.Chars (pool, SLICE (b, 0, n))
END Message2 ;

PROCEDURE Fail (RO op: STR ; RO key: STR ; code: I64) RAISES Error =
VAR
  scratch : POOL ;
  detail : STR ;
BEGIN
  detail := '' ;
  BEGIN
    detail := Message2 (scratch, code)
  EXCEPT
  | ValueRange :
      detail := ''
  END ;
  RAISE Error (op, key, detail, code)
END Fail ;

PROCEDURE Check (RO op: STR ; RO key: STR ; code: I64) RAISES Error =
BEGIN
  IF code # 0 THEN Fail (op, key, code) END
END Check ;

PROCEDURE Null () : C.MutPtr =
BEGIN
  RETURN C.MutPtr (Nowhere)
END Null ;

PROCEDURE Open (VAR pool: POOL ; RO path: STR) : PTR File IN pool
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  pb, mb : SLICE OF BYTE ;
  f : PTR File IN pool ;
  fp : C.MutPtr ;
BEGIN
  pb := DynStr.Bytes (scratch, path, TRUE) ;
  mb := DynStr.Bytes (scratch, 'rb', TRUE) ;
  fp := COpen (ADR (pb), ADR (mb)) ;
  IF C.SSizeT (fp) = C.SSizeT (Null ()) THEN
    (* fopen answers NULL and sets errno; the path is the useful half
       and errno is not read here, so the code is 0 and the message
       says what was attempted *)
    Fail ('fopen', path, 0)
  END ;
  f := NEW (pool, File) ;
  f.fp := fp ;
  f.path := path ;
  f.open := TRUE ;
  RETURN f
END Open ;

PROCEDURE Close (VAR f: PTR File) =
VAR rc : C.Int ;
BEGIN
  IF NOT f.open THEN RETURN END ;
  f.open := FALSE ;
  rc := CClose (f.fp)
END Close ;

PROCEDURE Count (f: PTR File) : I64 RAISES Error =
VAR n : ARRAY 1 OF I32 ;
BEGIN
  Check ('codes_count_in_file', '',
    I64 (CountInFile (Null (), f.fp, ADR (n)))) ;
  RETURN I64 (n[0])
END Count ;

PROCEDURE Next (VAR pool: POOL ; f: PTR File ; VAR ok: BOOL)
  : PTR Message IN pool RAISES Error =
VAR
  err : ARRAY 1 OF I32 ;
  h : C.MutPtr ;
  m : PTR Message IN pool ;
BEGIN
  ok := FALSE ;
  m := NEW (pool, Message) ;
  m.live := FALSE ;
  err[0] := 0 ;
  h := NewFromFile (Null (), f.fp, ADR (err)) ;
  IF I64 (err[0]) # 0 THEN
    Check ('codes_grib_handle_new_from_file', '', I64 (err[0]))
  END ;
  IF C.SSizeT (h) = C.SSizeT (Null ()) THEN
    RETURN m                          (* end of file, and ok is FALSE *)
  END ;
  m.h := h ;
  m.live := TRUE ;
  ok := TRUE ;
  RETURN m
END Next ;

PROCEDURE Byte (RO d: SLICE OF BYTE ; i: I64) : I64
  RAISES IndexError, ValueRange =
BEGIN
  RETURN I64 (d[i])
END Byte ;

PROCEDURE MsgAt (RO d: SLICE OF BYTE ; p: I64 ; VAR len: I64) : BOOL
  RAISES IndexError, ValueRange =
VAR ed, i : I64 ;
BEGIN
  (* a GRIB message header, and nothing else read.  The trailer is
     CHECKED rather than assumed: a length that does not land on
     "7777" means this is not a message start, so the walk steps on
     by one byte instead of accepting a wrong offset.  That is what
     makes an index safe to hand to a decoder -- a wrong entry
     cannot survive to become a wrong field. *)
  len := 0 ;
  IF p + 16 > LEN (d) THEN RETURN FALSE END ;
  IF Byte (d, p) # 71 THEN RETURN FALSE END ;        (* G *)
  IF Byte (d, p + 1) # 82 THEN RETURN FALSE END ;    (* R *)
  IF Byte (d, p + 2) # 73 THEN RETURN FALSE END ;    (* I *)
  IF Byte (d, p + 3) # 66 THEN RETURN FALSE END ;    (* B *)
  ed := Byte (d, p + 7) ;
  IF ed = 2 THEN
    FOR i := 8 TO 15 DO len := len * 256 + Byte (d, p + i) END
  ELSIF ed = 1 THEN
    FOR i := 4 TO 6 DO len := len * 256 + Byte (d, p + i) END
  ELSE
    RETURN FALSE
  END ;
  IF len < 16 THEN RETURN FALSE END ;
  IF p + len > LEN (d) THEN RETURN FALSE END ;
  IF Byte (d, p + len - 4) # 55 THEN RETURN FALSE END ;   (* 7 *)
  IF Byte (d, p + len - 3) # 55 THEN RETURN FALSE END ;
  IF Byte (d, p + len - 2) # 55 THEN RETURN FALSE END ;
  IF Byte (d, p + len - 1) # 55 THEN RETURN FALSE END ;
  RETURN TRUE
END MsgAt ;

PROCEDURE BuildIndex (VAR pool: POOL ; RO data: SLICE OF BYTE) : Index
  RAISES Error, ValueRange, IndexError =
VAR ix : Index ; p, len, n : I64 ;
BEGIN
  (* two walks: one to count, one to fill.  Walking is a jump per
     message, so counting twice costs nothing measurable and the
     alternative is a growable vector nobody else here needs. *)
  n := 0 ;
  p := 0 ;
  WHILE p + 16 <= LEN (data) DO
    IF MsgAt (data, p, len) THEN
      n := n + 1 ;
      p := p + len
    ELSE
      p := p + 1
    END
  END ;
  IF n = 0 THEN
    RAISE Error ('BuildIndex', '', 'no GRIB message in this data', 0)
  END ;
  ix.n := n ;
  ix.off := NEW (pool, I64, n) ;
  ix.len := NEW (pool, I64, n) ;
  n := 0 ;
  p := 0 ;
  WHILE p + 16 <= LEN (data) DO
    IF MsgAt (data, p, len) THEN
      ix.off[n] := p ;
      ix.len[n] := len ;
      n := n + 1 ;
      p := p + len
    ELSE
      p := p + 1
    END
  END ;
  RETURN ix
END BuildIndex ;

PROCEDURE FromBytes (VAR pool: POOL ; RO data: SLICE OF BYTE ;
                     off, len: I64) : PTR Message IN pool
  RAISES Error, ValueRange, IndexError =
VAR
  m : PTR Message IN pool ;
  h : C.MutPtr ;
  sub : SLICE OF BYTE ;
BEGIN
  (* the sub-slice is what makes this expressible: ADR of a slice is
     its pointer, so ADR (SLICE (data, off, len)) is the address of
     the message without any pointer arithmetic in the language. *)
  sub := SLICE (data, off, len) ;
  h := NewFromMessage (Null (), ADR (sub), C.SizeT (len)) ;
  IF C.SSizeT (h) = C.SSizeT (Null ()) THEN
    Fail ('codes_handle_new_from_message', '', 0)
  END ;
  m := NEW (pool, Message) ;
  m.h := h ;
  m.live := TRUE ;
  RETURN m
END FromBytes ;

PROCEDURE Release (VAR m: PTR Message) =
VAR rc : C.Int ;
BEGIN
  IF NOT m.live THEN RETURN END ;
  m.live := FALSE ;
  rc := HandleDelete (m.h) ;
  m.h := Null ()
END Release ;

PROCEDURE Dead (RO op: STR ; RO key: STR) RAISES Error =
BEGIN
  Fail (op, key, -1)
END Dead ;

PROCEDURE Has (m: PTR Message ; RO key: STR) : BOOL RAISES ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
BEGIN
  IF NOT m.live THEN RETURN FALSE END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  RETURN I64 (IsDefined (m.h, ADR (kb))) # 0
END Has ;

PROCEDURE GetI64 (m: PTR Message ; RO key: STR) : I64
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
  v : ARRAY 1 OF I64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_long', key) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  Check ('codes_get_long', key,
    I64 (GetLong (m.h, ADR (kb), ADR (v)))) ;
  RETURN v[0]
END GetI64 ;

PROCEDURE GetF64 (m: PTR Message ; RO key: STR) : F64
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
  v : ARRAY 1 OF F64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_double', key) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  Check ('codes_get_double', key,
    I64 (GetDouble (m.h, ADR (kb), ADR (v)))) ;
  RETURN v[0]
END GetF64 ;

PROCEDURE Size (m: PTR Message ; RO key: STR) : I64
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
  n : ARRAY 1 OF U64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_size', key) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  Check ('codes_get_size', key,
    I64 (GetSize (m.h, ADR (kb), ADR (n)))) ;
  RETURN I64 (n[0])
END Size ;

PROCEDURE GetStr (VAR pool: POOL ; m: PTR Message ; RO key: STR) : STR
  RAISES Error, ValueRange =
VAR
  scratch : POOL ;
  kb, buf : SLICE OF BYTE ;
  n : ARRAY 1 OF U64 ;
  len : I64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_string', key) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  buf := NEW (scratch, BYTE, MaxStr + 1) ;
  n[0] := U64 (MaxStr) ;
  Check ('codes_get_string', key,
    I64 (GetString (m.h, ADR (kb), ADR (buf), ADR (n)))) ;
  (* ecCodes answers the length INCLUDING the terminator, and pads
     with it; trusting the number without looking is how a caller
     ends up with a NUL inside a string *)
  len := I64 (n[0]) ;
  IF len > 0 THEN len := len - 1 END ;
  WHILE len > 0 DO
    IF buf[len - 1] # 0 THEN EXIT END ;
    len := len - 1
  END ;
  RETURN DynStr.Chars (pool, SLICE (buf, 0, len))
END GetStr ;

PROCEDURE Values (m: PTR Message ; out: SLICE OF F64)
  RAISES Error, SizeError, ValueRange =
BEGIN
  Doubles (m, 'values', out)
END Values ;

PROCEDURE Doubles (m: PTR Message ; RO key: STR ; out: SLICE OF F64)
  RAISES Error, SizeError, ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
  n : ARRAY 1 OF U64 ;
  want : I64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_double_array', key) END ;
  want := Size (m, key) ;
  IF LEN (out) # want THEN RAISE SizeError (LEN (out), want) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  n[0] := U64 (LEN (out)) ;
  Check ('codes_get_double_array', key,
    I64 (GetDoubleArray (m.h, ADR (kb), ADR (out), ADR (n))))
END Doubles ;

PROCEDURE Floats (m: PTR Message ; RO key: STR ; out: SLICE OF F32)
  RAISES Error, SizeError, ValueRange =
VAR
  scratch : POOL ;
  kb : SLICE OF BYTE ;
  n : ARRAY 1 OF U64 ;
  want : I64 ;
BEGIN
  IF NOT m.live THEN Dead ('codes_get_float_array', key) END ;
  want := Size (m, key) ;
  IF LEN (out) # want THEN RAISE SizeError (LEN (out), want) END ;
  kb := DynStr.Bytes (scratch, key, TRUE) ;
  n[0] := U64 (LEN (out)) ;
  Check ('codes_get_float_array', key,
    I64 (GetFloatArray (m.h, ADR (kb), ADR (out), ADR (n))))
END Floats ;

PROCEDURE ReadGrid2 (VAR pool: POOL ; m: PTR Message)
  : GRID 2 OF F64 RAISES Error, SizeError, ValueRange =
VAR
  scratch : POOL ;
  flat : SLICE OF F64 ;
  g : GRID 2 OF F64 ;
  ni, nj, i, j : I64 ;
BEGIN
  ni := GetI64 (m, 'Ni') ;
  nj := GetI64 (m, 'Nj') ;
  flat := NEW (scratch, F64, ni * nj) ;
  Values (m, flat) ;
  g := NEW (pool, F64, nj, ni) ;
  (* the copy a `GRID (s, nj, ni)` view form would remove; the values
     are already in this order, which is the annoying part *)
  FOR j := 0 TO nj - 1 DO
    FOR i := 0 TO ni - 1 DO
      g[j, i] := flat[j * ni + i]
    END
  END ;
  RETURN g
END ReadGrid2 ;

PROCEDURE MultiSupport (on: BOOL) =
BEGIN
  IF on THEN MultiOn (Null ()) ELSE MultiOff (Null ()) END
END MultiSupport ;

END Grib.
