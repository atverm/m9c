DEFINITION MODULE System ;

(* The process, seen from inside: what it was called with, how big it
   is and what the machine offers, the pools it is holding, and other
   programs run with their output collected.

   Nothing here is inferred.  A flag is a flag because the caller
   asked for it by name; a pool is listed because the runtime carved
   a block for it; a program is run with the arguments given, through
   no shell, and both of its streams come back as strings.          *)

IMPORT Io ;

TYPE
  Memory = RECORD
    resident, peak : I64 ;    (* this process, bytes: now, and high water *)
    total, available : I64 ;  (* the machine's RAM, bytes: all of it, and
                                 what a new allocation could still get *)
  END ;

  PoolInfo = RECORD
    used, capacity, blocks : I64 ;   (* bytes carved, bytes held, blocks *)
  END ;

  Result = RECORD
    status : I64 ;            (* the exit status; minus the signal number
                                 when the program was killed by one *)
    out, err : STR ;          (* everything it wrote, each stream whole *)
    stopped : BOOL ;          (* it ran past the limit and was stopped:
                                 what it had written by then is above,
                                 and status is the kill.  Never TRUE
                                 from Exec, which sets no limit. *)
  END ;

EXCEPTION NoPool (i, n: I64) ;

PROCEDURE Os () : STR ;
  (* the platform this program is running on, as a VALUE: 'linux',
     'windows', 'macos', or 'posix' for another Unix.  M9 has no
     conditional compilation by design, so a program that must branch
     on the platform -- a path separator, where a library lives --
     asks at run time and both branches stay in the text where a
     reviewer can read them. *)
PROCEDURE Executable (VAR pool: POOL) : STR RAISES ValueRange ;
  (* the running executable's resolved path, as the kernel knows it,
     or empty when the system will not say.  NOT Program, which is
     how the program was CALLED and may be a bare name found on PATH:
     this is where the binary IS, which is what a tool that ships
     beside its own library needs to find it.  On Io's path wire,
     bytes as CHARs, so the answer can be handed to Io as it is. *)

PROCEDURE Cores () : I64 ;
  (* processors this process may run on right now *)

PROCEDURE Mem () : Memory ;

PROCEDURE PoolCount () : I64 ;
  (* pools holding at least one block.  A pool with nothing carved
     from it costs nothing and is not a pool the runtime knows. *)
PROCEDURE PoolAt (i: I64) : PoolInfo RAISES NoPool ;
  (* pool i of PoolCount, oldest first.  The runtime groups its live
     blocks by the pool that carved them, so a pool that leaked --
     freed with its owner rather than by name -- is listed for what
     it is: blocks still held. *)
PROCEDURE PoolBytes () : I64 ;
  (* capacity held by every live pool together *)

PROCEDURE Exec (VAR pool: POOL ; RO prog: STR ; RO args: SLICE OF STR ;
                RO input: STR ; RO env: SLICE OF STR)
  : Result RAISES ValueRange, Io.IOError ;
  (* run prog with args -- directly, no shell, so an argument is an
     argument and not a command -- feed it `input` on stdin (the
     empty string is an immediate end-of-file, never this program's
     own stdin), wait for it, and collect both streams whole.  `env`
     is NAME=VALUE overrides MERGED over the inherited environment:
     [ 'LC_ALL=C' ] pins one variable and keeps the rest, so PATH
     still finds the program.  Pass no input and no env with '' and an
     empty slice.  IOError when it could not be started at all (not
     found, not executable); a program that starts and fails answers
     with its status.  stdin and both streams are pumped together, so
     a large input and a large output do not deadlock.  It waits as
     long as the program takes: ExecWithin is the one that does not. *)

PROCEDURE ExecWithin (VAR pool: POOL ; RO prog: STR ; RO args: SLICE OF STR ;
                      RO input: STR ; RO env: SLICE OF STR ; seconds: F64)
  : Result RAISES ValueRange, Io.IOError ;
  (* Exec, with a deadline over the whole run -- starting it, both
     streams, and its exit.  When the time is up the program AND
     EVERYTHING IT STARTED are killed (its own process group on
     POSIX, a job object on Windows), `stopped` answers TRUE, and
     what the program had written by then is still in `out` and
     `err`: a bounded run reports, it does not vanish.

     The children matter as much as the child.  A program that has
     exited while something it started still holds its stdout is the
     case that waits forever without this, because what is waited on
     is the STREAMS ending and not the exit.

     `seconds` not greater than zero is no limit at all, which is
     exactly Exec.  A bounded run is put in a group of its own so
     that it can be killed whole, and a group of its own no longer
     receives the terminal's Ctrl-C: that is the price of the bound,
     and it is why an unbounded run is not given one. *)

PROCEDURE Program (VAR pool: POOL) : STR RAISES ValueRange, IndexError ;
  (* argv[0]: how this program was invoked *)
PROCEDURE Args (VAR pool: POOL) : SLICE OF STR RAISES ValueRange, IndexError ;
  (* the arguments after the program name, all of them, in order *)

(* Three views of the arguments, one convention: an option is a word
   beginning with '-', a value is attached with '=' (`--out=result.nc`,
   never `--out result.nc`, because then no rule could say whether
   the next word is a value or a file), and a bare `--` ends the
   options so that everything after it is positional whatever it
   looks like.  The convention is small enough to state in full,
   which is the point. *)
PROCEDURE Flag (RO name: STR) : BOOL RAISES ValueRange, IndexError ;
  (* is the word `name` (say `--verbose`) among the options *)
PROCEDURE Value (RO name: STR ; RO dflt: STR) : STR
  RAISES ValueRange, IndexError ;
  (* the text after `name=` in the first option that carries it, else
     dflt: Value (pool, '--out', 'a.nc') *)
PROCEDURE Positional (VAR pool: POOL) : SLICE OF STR
  RAISES ValueRange, IndexError ;
  (* every argument that is not an option, in order *)

PROCEDURE Glob (RO pattern: STR) : SLICE OF STR RAISES ValueRange ;
  (* the paths that exist and fit the pattern, SORTED by code point:
     Python's glob.glob, which answers them in the order the
     filesystem happens to hold, sorted.  The pattern is cut at its
     slashes and each piece is a Text.Match pattern for one name:
     `data/*/L2_[0-9][0-9].nc'.  A piece with no star, question mark
     or bracket is just a name.

     As in every shell, a name that begins with a dot is found only
     by a piece that begins with one.  A pattern that matches nothing
     answers an empty slice, and so does one that looks in a
     directory that is not there: nothing found is not a failure.
     A pattern that ENDS in a slash asks for directories only; they
     are answered without it.  There is no `**'. *)

END System.

UNSAFE DEFINITION MODULE FOR "C" csys ;

PROCEDURE NCpu = "m9_cores" () : C.Int  [REENTRANT] ;
PROCEDURE OsCode = "m9_os" () : C.Int  [REENTRANT] ;
  (* 1 linux, 2 windows, 3 macos, 0 another POSIX; Os spells them *)
PROCEDURE ExePath = "m9_exe_path" (buf: C.MutPtr ; cap: C.Int) : C.Int
  [REENTRANT] ;
  (* the executable's path as bytes into buf, its length; -1 when the
     system will not say *)
PROCEDURE MemInfo = "m9_meminfo" (buf: C.MutPtr)  [REENTRANT] ;
  (* four int64 into buf: resident, peak, total, available *)
PROCEDURE PoolN = "m9_pool_count" () : C.SSizeT  [REENTRANT] ;
PROCEDURE PoolI = "m9_pool_info" (i: C.SSizeT ; buf: C.MutPtr) : C.Int
  [REENTRANT] ;
  (* three int64 into buf: used, capacity, blocks; 0 when i is out of
     range.  Both take the registry's own lock. *)
PROCEDURE ExecStart = "m9_exec" (argv: C.ConstPtr ; n: C.Int ;
                                 input: C.ConstPtr ; inlen: C.SSizeT ;
                                 env: C.ConstPtr ; envn: C.Int ;
                                 limitMs: C.SSizeT) : C.Int
  [REENTRANT] ;
  (* n NUL-terminated UTF-8 strings back to back, the program first;
     inlen bytes of stdin (0 = an immediate EOF); envn NUL-terminated
     NAME=VALUE strings, each merged over the inherited environment;
     limitMs milliseconds for the whole run, after which the child
     and its children are killed (0 or less: no limit, and then
     nothing is done differently).  Answers a handle, or -1 when it
     could not start.  The slot table is under its own lock, so two
     threads may run programs at once. *)
PROCEDURE ExecStatus = "m9_exec_status" (h: C.Int) : C.Int  [REENTRANT] ;
PROCEDURE ExecStopped = "m9_exec_stopped" (h: C.Int) : C.Int  [REENTRANT] ;
  (* 1 when the limit ran out and the run was killed *)
PROCEDURE ExecLen = "m9_exec_len" (h: C.Int ; which: C.Int) : C.SSizeT
  [REENTRANT] ;
PROCEDURE ExecCopy = "m9_exec_copy" (h: C.Int ; which: C.Int ;
                                     buf: C.MutPtr ; cap: C.SSizeT)
  : C.SSizeT  [REENTRANT] ;
PROCEDURE ExecRelease = "m9_exec_release" (h: C.Int)  [REENTRANT] ;

END csys.

UNSAFE IMPLEMENTATION MODULE System ;

IMPORT Io ;
IMPORT DynStr ;
IMPORT Text ;
FROM csys IMPORT NCpu, OsCode, ExePath, MemInfo, PoolN, PoolI, ExecStart,
                 ExecStatus, ExecStopped, ExecLen, ExecCopy, ExecRelease ;

CONST
  Out = 1 ;
  Err = 2 ;
  MaxPath = 4096 ;   (* Io's MaxEnv; a longer path is no answer *)

(* the runtime answers a number so that the words appear here, once
   each, in the one place a reader looks for them *)
PROCEDURE Os () : STR =
BEGIN
  CASE I64 (OsCode ()) OF
  | 1 : RETURN 'linux'
  | 2 : RETURN 'windows'
  | 3 : RETURN 'macos'
  ELSE  RETURN 'posix'
  END
END Os ;

PROCEDURE Executable (VAR pool: POOL) : STR RAISES ValueRange =
VAR
  scratch : POOL ;
  buf : SLICE OF BYTE ;
  n : I64 ;
BEGIN
  buf := NEW (scratch, BYTE, MaxPath) ;
  n := I64 (ExePath (ADR (buf), C.Int (MaxPath))) ;
  IF n < 0 THEN RETURN '' END ;
  RETURN DynStr.Chars (pool, SLICE (buf, 0, n))
END Executable ;

PROCEDURE Cores () : I64 =
BEGIN
  RETURN I64 (NCpu ())
END Cores ;

PROCEDURE Mem () : Memory =
VAR
  m : ARRAY 4 OF I64 ;
  r : Memory ;
BEGIN
  MemInfo (ADR (m)) ;
  r.resident := m[0] ;
  r.peak := m[1] ;
  r.total := m[2] ;
  r.available := m[3] ;
  RETURN r
END Mem ;

PROCEDURE PoolCount () : I64 =
BEGIN
  RETURN I64 (PoolN ())
END PoolCount ;

PROCEDURE PoolAt (i: I64) : PoolInfo RAISES NoPool =
VAR
  m : ARRAY 3 OF I64 ;
  r : PoolInfo ;
BEGIN
  IF I64 (PoolI (C.SSizeT (i), ADR (m))) = 0 THEN
    RAISE NoPool (i, PoolCount ())
  END ;
  r.used := m[0] ;
  r.capacity := m[1] ;
  r.blocks := m[2] ;
  RETURN r
END PoolAt ;

PROCEDURE PoolBytes () : I64 =
VAR
  m : ARRAY 3 OF I64 ;
  i, total : I64 ;
BEGIN
  total := 0 ;
  i := 0 ;
  WHILE I64 (PoolI (C.SSizeT (i), ADR (m))) # 0 DO
    total := total + m[1] ;
    i := i + 1
  END ;
  RETURN total
END PoolBytes ;

(* one string as UTF-8 into the argument block, then its terminator
   -- which is already there, since pool storage is zero *)
PROCEDURE Put (VAR scratch: POOL ; VAR block: SLICE OF BYTE ; VAR k: I64 ;
               RO s: STR) RAISES ValueRange =
VAR
  b : SLICE OF BYTE ;
  j : I64 ;
BEGIN
  b := DynStr.Utf8 (scratch, s) ;
  FOR j := 0 TO LEN (b) - 1 DO
    block[k] := b[j] ;
    k := k + 1
  END ;
  k := k + 1
END Put ;

PROCEDURE Stream (VAR pool: POOL ; h, which: I64) : STR RAISES ValueRange =
VAR
  scratch : POOL ;
  b : SLICE OF BYTE ;
  n : I64 ;
BEGIN
  n := I64 (ExecLen (C.Int (h), C.Int (which))) ;
  b := NEW (scratch, BYTE, n + 1) ;
  n := I64 (ExecCopy (C.Int (h), C.Int (which), ADR (b), C.SSizeT (n))) ;
  RETURN DynStr.FromUtf8 (pool, SLICE (b, 0, n))
END Stream ;

PROCEDURE ExecWithin (VAR pool: POOL ; RO prog: STR ; RO args: SLICE OF STR ;
                      RO input: STR ; RO env: SLICE OF STR ; seconds: F64)
  : Result RAISES ValueRange, Io.IOError =
VAR
  scratch : POOL ;
  block, eblock, inb, b : SLICE OF BYTE ;
  total, etotal, i, k, h, ms : I64 ;
  r : Result ;
BEGIN
  (* the limit in milliseconds, and a limit that was asked for is
     never rounded away to none: half a millisecond is a very short
     deadline, not an unbounded run *)
  ms := 0 ;
  IF seconds > 0.0 THEN
    ms := I64 (seconds * 1000.0) ;
    IF ms < 1 THEN ms := 1 END
  END ;
  (* the argument block: every string as UTF-8, each followed by its NUL *)
  b := DynStr.Utf8 (scratch, prog) ;
  total := LEN (b) + 1 ;
  FOR i := 0 TO LEN (args) - 1 DO
    b := DynStr.Utf8 (scratch, args[i]) ;
    total := total + LEN (b) + 1
  END ;
  block := NEW (scratch, BYTE, total) ;
  k := 0 ;
  Put (scratch, block, k, prog) ;
  FOR i := 0 TO LEN (args) - 1 DO Put (scratch, block, k, args[i]) END ;

  (* stdin as UTF-8 bytes, and the env overrides as a block of their own *)
  inb := DynStr.Utf8 (scratch, input) ;
  etotal := 0 ;
  FOR i := 0 TO LEN (env) - 1 DO
    b := DynStr.Utf8 (scratch, env[i]) ;
    etotal := etotal + LEN (b) + 1
  END ;
  eblock := NEW (scratch, BYTE, etotal) ;
  k := 0 ;
  FOR i := 0 TO LEN (env) - 1 DO Put (scratch, eblock, k, env[i]) END ;

  h := I64 (ExecStart (ADR (block), C.Int (LEN (args) + 1),
                       ADR (inb), C.SSizeT (LEN (inb)),
                       ADR (eblock), C.Int (LEN (env)), C.SSizeT (ms))) ;
  IF h < 0 THEN RAISE Io.IOError (prog) END ;
  r.status := I64 (ExecStatus (C.Int (h))) ;
  r.stopped := I64 (ExecStopped (C.Int (h))) # 0 ;
  r.out := Stream (pool, h, Out) ;
  r.err := Stream (pool, h, Err) ;
  ExecRelease (C.Int (h)) ;
  RETURN r
END ExecWithin ;

PROCEDURE Exec (VAR pool: POOL ; RO prog: STR ; RO args: SLICE OF STR ;
                RO input: STR ; RO env: SLICE OF STR)
  : Result RAISES ValueRange, Io.IOError =
BEGIN
  RETURN ExecWithin (pool, prog, args, input, env, 0.0)
END Exec ;

PROCEDURE Program (VAR pool: POOL) : STR RAISES ValueRange, IndexError =
BEGIN
  RETURN Io.Arg (pool, 0)
END Program ;

PROCEDURE Args (VAR pool: POOL) : SLICE OF STR RAISES ValueRange, IndexError =
VAR
  a : SLICE OF STR ;
  i, n : I64 ;
BEGIN
  n := Io.ArgCount () ;
  IF n < 1 THEN n := 1 END ;
  a := NEW (pool, STR, n - 1) ;
  FOR i := 1 TO n - 1 DO a[i - 1] := Io.Arg (pool, i) END ;
  RETURN a
END Args ;

(* an option: begins with '-' and comes before the bare `--` *)
PROCEDURE IsOption (RO a: STR) : BOOL =
BEGIN
  RETURN LEN (a) > 1 AND a[0] = '-'
END IsOption ;

PROCEDURE Flag (RO name: STR) : BOOL RAISES ValueRange, IndexError =
VAR
  scratch : POOL ;
  a : SLICE OF STR ;
  i : I64 ;
BEGIN
  a := Args (scratch) ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF Text.Eq (a[i], '--') THEN RETURN FALSE END ;
    IF Text.Eq (a[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Flag ;

(* a copy of s that lives in pool, for an answer that must outlive
   the frame it was found in *)
PROCEDURE Dup (RO s: STR) : STR =
VAR
  r : STR ;
  j : I64 ;
BEGIN
  r := NEW (CHAR, LEN (s)) ;
  FOR j := 0 TO LEN (s) - 1 DO r[j] := s[j] END ;
  RETURN r
END Dup ;

PROCEDURE Value (RO name: STR ; RO dflt: STR) : STR
  RAISES ValueRange, IndexError =
VAR
  scratch : POOL ;
  a : SLICE OF STR ;
  prefix : STR ;
  i : I64 ;
BEGIN
  prefix := name + '=' ;
  a := Args (scratch) ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF Text.Eq (a[i], '--') THEN RETURN Dup (dflt) END ;
    IF Text.StartsWith (a[i], prefix) THEN
      RETURN Dup (SLICE (a[i], LEN (prefix), LEN (a[i]) - LEN (prefix)))
    END
  END ;
  RETURN Dup (dflt)
END Value ;

PROCEDURE Positional (VAR pool: POOL) : SLICE OF STR
  RAISES ValueRange, IndexError =
VAR
  a, p : SLICE OF STR ;
  i, n : I64 ;
  rest : BOOL ;
BEGIN
  a := Args (pool) ;
  n := 0 ;
  rest := FALSE ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF rest THEN n := n + 1
    ELSIF Text.Eq (a[i], '--') THEN rest := TRUE
    ELSIF NOT IsOption (a[i]) THEN n := n + 1
    END
  END ;
  p := NEW (pool, STR, n) ;
  n := 0 ;
  rest := FALSE ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF rest THEN p[n] := a[i] ; n := n + 1
    ELSIF Text.Eq (a[i], '--') THEN rest := TRUE
    ELSIF NOT IsOption (a[i]) THEN p[n] := a[i] ; n := n + 1
    END
  END ;
  RETURN p
END Positional ;

(* ---- Glob ---- *)

PROCEDURE HasMagic (RO s: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = '*' OR s[i] = '?' OR s[i] = '[' THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasMagic ;

PROCEDURE Joined (RO dir, name: STR) : STR =
BEGIN
  IF LEN (dir) = 0 THEN RETURN name + '' END ;
  IF dir[LEN (dir) - 1] = '/' THEN RETURN dir + name END ;
  RETURN dir + '/' + name
END Joined ;

(* the names in a directory, and none where it is not one *)
PROCEDURE Entries (VAR pool: POOL ; RO dir: STR) : SLICE OF STR =
BEGIN
  IF LEN (dir) = 0 THEN RETURN Io.ListDir (pool, '.') END ;
  RETURN Io.ListDir (pool, dir)
EXCEPT
| Io.IOError : RETURN NEW (pool, STR, 0)
| ValueRange : RETURN NEW (pool, STR, 0)
END Entries ;

(* can it be listed?  Io has no question for this, and listing is the
   one a directory answers and a file does not *)
PROCEDURE IsDir (RO path: STR) : BOOL =
VAR
  scratch : POOL ;
  names : SLICE OF STR ;
BEGIN
  names := Io.ListDir (scratch, path) ;
  RETURN TRUE
EXCEPT
| Io.IOError : RETURN FALSE
| ValueRange : RETURN FALSE
END IsDir ;

(* a name beginning with a dot is hidden from a piece that does not *)
PROCEDURE Fits (RO piece, name: STR) : BOOL =
BEGIN
  IF LEN (name) > 0 AND name[0] = '.' THEN
    IF LEN (piece) = 0 OR piece[0] # '.' THEN RETURN FALSE END
  END ;
  RETURN Text.Match (piece, name)
END Fits ;

(* every path of dirs taken one piece of the pattern further *)
PROCEDURE Expand (RO dirs: SLICE OF STR ; RO piece: STR) : SLICE OF STR =
VAR
  scratch : POOL ;
  names, out : SLICE OF STR ;
  d, k, n : I64 ;
BEGIN
  IF NOT HasMagic (piece) THEN
    out := NEW (STR, LEN (dirs)) ;
    FOR d := 0 TO LEN (dirs) - 1 DO out[d] := Joined (dirs[d], piece) END ;
    RETURN out
  END ;
  (* counted, then written: a slice does not grow *)
  n := 0 ;
  FOR d := 0 TO LEN (dirs) - 1 DO
    names := Entries (scratch, dirs[d]) ;
    FOR k := 0 TO LEN (names) - 1 DO
      IF Fits (piece, names[k]) THEN n := n + 1 END
    END
  END ;
  out := NEW (STR, n) ;
  n := 0 ;
  FOR d := 0 TO LEN (dirs) - 1 DO
    names := Entries (scratch, dirs[d]) ;
    FOR k := 0 TO LEN (names) - 1 DO
      IF Fits (piece, names[k]) AND n < LEN (out) THEN
        out[n] := Joined (dirs[d], names[k]) ;
        n := n + 1
      END
    END
  END ;
  RETURN out
END Expand ;

(* by code point, and of two that agree as far as the shorter goes,
   the shorter first.  Sort.Strs orders the same way; it is not
   imported because the compiler links System, and would then link
   Sort and Math in every place it is built by hand. *)
PROCEDURE Before (RO a, b: STR) : BOOL =
VAR i, n : I64 ;
BEGIN
  n := LEN (a) ;
  IF LEN (b) < n THEN n := LEN (b) END ;
  FOR i := 0 TO n - 1 DO
    IF a[i] < b[i] THEN RETURN TRUE END ;
    IF a[i] > b[i] THEN RETURN FALSE END
  END ;
  RETURN LEN (a) < LEN (b)
END Before ;

PROCEDURE Glob (RO pattern: STR) : SLICE OF STR RAISES ValueRange =
VAR
  pieces, found, out : SLICE OF STR ;
  held : STR ;
  i, k, n : I64 ;
  any, spelled, there, dirsOnly : BOOL ;
BEGIN
  pieces := Text.Split (pattern, '/') ;
  found := NEW (STR, 1) ;
  IF LEN (pattern) > 0 AND pattern[0] = '/' THEN
    found[0] := '/'
  ELSE
    found[0] := ''
  END ;
  any := FALSE ;
  spelled := FALSE ;
  FOR i := 0 TO LEN (pieces) - 1 DO
    IF LEN (pieces[i]) > 0 THEN
      found := Expand (found, pieces[i]) ;
      spelled := NOT HasMagic (pieces[i]) ;
      any := TRUE
    END
  END ;
  IF NOT any AND LEN (found[0]) = 0 THEN RETURN NEW (STR, 0) END ;
  (* a last piece that was matched is there; one that was spelled out
     has yet to be looked for.  And a pattern that ends in a slash
     asks for directories. *)
  n := LEN (found) ;
  dirsOnly := any AND pattern[LEN (pattern) - 1] = '/' ;
  IF spelled OR dirsOnly THEN
    n := 0 ;
    FOR k := 0 TO LEN (found) - 1 DO
      IF dirsOnly THEN
        there := IsDir (found[k])
      ELSE
        there := Io.Exists (found[k])
      END ;
      IF there THEN
        found[n] := found[k] ;
        n := n + 1
      END
    END
  END ;
  out := NEW (STR, n) ;
  FOR k := 0 TO n - 1 DO out[k] := found[k] END ;
  FOR i := 1 TO n - 1 DO
    held := out[i] ;
    k := i ;
    WHILE k > 0 AND Before (held, out[k - 1]) DO
      out[k] := out[k - 1] ;
      k := k - 1
    END ;
    out[k] := held
  END ;
  RETURN out
END Glob ;

END System.
