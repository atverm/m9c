DEFINITION MODULE Parquet ;

(* A Parquet subset for Frame.m9: flat schemas.  pyarrow is the oracle
   both ways: files pyarrow wrote are read value-exact against what
   pyarrow reads from them (corpus/ParquetTest.m9), files this module
   writes are read back by pyarrow (runtime/test/columnar.sh).

   THE READER reads what pyarrow and polars write with their DEFAULTS:
   several row groups, several data pages a chunk (version 1 or 2), a
   dictionary page with RLE_DICTIONARY indices (and PLAIN_DICTIONARY,
   its old name), PLAIN values, RLE booleans, and pages compressed
   with SNAPPY, GZIP or ZSTD or not at all.  Everything outside that is
   refused BY NAME -- a codec (brotli, lz4), an encoding (the DELTA
   family, BYTE_STREAM_SPLIT), a nesting, a repeated column -- because
   a half-read Parquet file is a numbers-shaped lie.  An OPTIONAL
   column's null is the arm's own missing value, the mapping CSV import
   applies to an empty field; a null BOOLEAN is refused, BOOL keeping
   no missing value.  Strings are UTF-8 both ways.

   THE WRITER emits one row group, one PLAIN data page a column, no
   dictionary, compressed as Options.codec asks (none by default).
   Its columns are REQUIRED by default: Frame's missing values live in
   the data (NaN, the sentinels), not as Parquet nulls, so no
   definition levels are written.  Asked for (`Options.nulls`,
   WriteOpt), every numeric column is OPTIONAL and a missing cell is a
   NULL -- what pyarrow writes from pandas, and what a reader that
   knows no sentinel needs. *)

IMPORT Faults ;

IMPORT Frame ;
IMPORT Io ;

PROCEDURE Write (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;

PROCEDURE WriteTs (VAR pool: POOL ; ts: PTR Frame.Ts ; RO path: STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;
  (* the time axis becomes an INT64 column 'time' (epoch seconds),
     and the resolution, convention and description ride in the
     file-level key_value_metadata, so TsRead answers the same
     frame back *)

PROCEDURE WriteX (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR ;
                  RO kvK: SLICE OF STR ; RO kvV: SLICE OF STR ;
                  RO nsCols: SLICE OF STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;
  (* Write plus two things a data service needs: file-level
     key_value_metadata pairs (the zarr proxy rides its JSON-LD
     data passport under 'data_passport', as pyarrow's writer
     does), and INT64 columns named in nsCols annotated as
     TIMESTAMP(NANOS, adjusted-to-UTC) -- pyarrow then reads a real
     timestamp[ns] column, not a bare integer.                      *)

PROCEDURE BytesX (VAR pool: POOL ; f: PTR Frame.Fr ;
                  RO kvK: SLICE OF STR ; RO kvV: SLICE OF STR ;
                  RO nsCols: SLICE OF STR) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, Overflow, IndexError ;
  (* WriteX's document, IN MEMORY, for a caller that is answering a
     request rather than filling a directory.  The whole file was
     already assembled in a buffer before WriteX touched the disk;
     this hands that buffer over instead, so a server does not need a
     per-request temp file it must then read back and remove.  No
     Io.IOError, because nothing is opened.                          *)

CONST
  (* Options.codec: how the writer compresses each page.  The numbers
     are the format's own (parquet.thrift CompressionCodec).  SNAPPY is
     pyarrow's default; GZIP is the RFC 1952 wrapping of Zip's plain
     compressor -- smaller than snappy, slower to write, and larger
     than zlib's level 6 would make it; ZSTD is libzstd at its default
     level 3, polars' default codec.  Snappy and gzip are written in
     M9; zstd is the system's libzstd, so a program importing Parquet
     links it (LINK below). *)
  CodecNone = 0 ;
  CodecSnappy = 1 ;
  CodecGzip = 2 ;
  CodecZstd = 6 ;

TYPE
  Options = RECORD
    kvK, kvV : SLICE OF STR ;   (* file-level key_value_metadata *)
    nsCols : SLICE OF STR ;     (* INT64 as TIMESTAMP(NANOS, UTC) *)
    usCols : SLICE OF STR ;     (* INT64 as TIMESTAMP(MICROS, local) *)
    i8Cols : SLICE OF STR ;     (* an I16 or I32 column as INT_8 *)
    nulls : BOOL ;              (* missing cells as Parquet nulls *)
    codec : I64 ;               (* CodecNone, CodecSnappy, CodecGzip, CodecZstd *)
  END ;
  (* what WriteX takes, and three things a dataframe written for
     pandas and pyarrow needs, found by the cp-kernel's time series
     renditions (2026-10-09), which pyarrow writes from pandas:

       usCols -- INT64 columns (microseconds since the epoch)
                 annotated TIMESTAMP(MICROS, isAdjustedToUTC false):
                 pandas' naive datetime64[us], a time WITHOUT a zone
                 said.  nsCols, which says UTC, is the other one;
                 a column in both is BadArg.
       i8Cols -- I16 or I32 columns written as INT32 annotated
                 INT_8, which pyarrow reads as int8: Frame has no
                 signed 8-bit arm (BYTE is unsigned, written UINT_8).
                 A value outside -128 .. 127 is BadArg, the column
                 named; a missing cell is not looked at when nulls.
       nulls  -- every column but BOOL and STR is OPTIONAL, and a
                 cell that is the column's missing value (or NaN, in
                 a real column) is a NULL: definition levels, one
                 bit-packed run, and the value left out.  FALSE
                 writes WriteX's bytes.

       codec  -- every page compressed so, and said in the column's
                 metadata; another number is BadArg.

     A zeroed record is WriteX with nothing asked: empty slices,
     nulls FALSE, CodecNone.  Every name in usCols and i8Cols must be a column
     of the frame of the right kind, or BadArg says which (nsCols is
     not held to the frame, as WriteX never held it).               *)

PROCEDURE WriteOpt (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR ;
                    RO o: Options)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;

PROCEDURE BytesOpt (VAR pool: POOL ; f: PTR Frame.Fr ; RO o: Options)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, Overflow, IndexError ;
  (* WriteOpt's document in memory, as BytesX is WriteX's *)

PROCEDURE Read (VAR pool: POOL ; RO path: STR) : PTR Frame.Fr
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;

PROCEDURE TsRead (VAR pool: POOL ; RO path: STR) : PTR Frame.Ts
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError ;

END Parquet.


UNSAFE DEFINITION MODULE FOR "C" czstd LINK "-l:libzstd.so.1" ;

(* libzstd's one-shot calls: each makes and frees its own context, so
   any number of threads may call them at once.  An error is a size_t
   near 2 ** 64, which I64 () refuses with ValueRange. *)

PROCEDURE ZstdDecompress = "ZSTD_decompress"
  (dst: C.MutPtr ; cap: C.SizeT ; src: C.ConstPtr ; n: C.SizeT)
  : C.SizeT  [REENTRANT] ;

PROCEDURE ZstdCompress = "ZSTD_compress"
  (dst: C.MutPtr ; cap: C.SizeT ; src: C.ConstPtr ; n: C.SizeT ;
   level: C.Int) : C.SizeT  [REENTRANT] ;

PROCEDURE ZstdBound = "ZSTD_compressBound" (n: C.SizeT) : C.SizeT
  [REENTRANT] ;

END czstd.


UNSAFE IMPLEMENTATION MODULE Parquet ;

(* UNSAFE for one reason: ADR at the libzstd boundary.  Grep ADR. *)

FROM czstd IMPORT ZstdDecompress, ZstdCompress, ZstdBound ;

IMPORT Faults ;

IMPORT DynStr ;
IMPORT Zip ;

(* ---- thrift compact protocol type codes ---- *)

CONST
  CtStop = 0 ;
  CtTrue = 1 ;
  CtFalse = 2 ;
  CtByte = 3 ;
  CtI16 = 4 ;
  CtI32 = 5 ;
  CtI64 = 6 ;
  CtDouble = 7 ;
  CtBinary = 8 ;
  CtList = 9 ;
  CtSet = 10 ;
  CtMap = 11 ;
  CtStruct = 12 ;

  (* parquet physical types *)
  PtBoolean = 0 ;
  PtInt32 = 1 ;
  PtInt64 = 2 ;
  PtInt96 = 3 ;
  PtFloat = 4 ;
  PtDouble = 5 ;
  PtByteArray = 6 ;
  PtFixed = 7 ;

  (* converted types this subset speaks *)
  CvUtf8 = 0 ;
  CvUint8 = 11 ;
  CvInt8 = 15 ;
  CvInt16 = 16 ;

  EncPlain = 0 ;
  EncPlainDict = 2 ;       (* RLE_DICTIONARY's old name, the same bytes *)
  EncRle = 3 ;
  EncBitPacked = 4 ;
  EncRleDict = 8 ;

  (* page types *)
  PgData = 0 ;
  PgIndex = 1 ;
  PgDict = 2 ;
  PgDataV2 = 3 ;

  (* what a Sink gathers *)
  SkF64 = 0 ;
  SkF32 = 1 ;
  SkI64 = 2 ;
  SkI32 = 3 ;
  SkI16 = 4 ;
  SkByte = 5 ;
  SkBool = 6 ;
  SkStr = 7 ;

  SnapBad = 'a damaged snappy page' ;
  RunBad = 'damaged levels or dictionary indices' ;

(* ---- a growing byte buffer ---- *)

TYPE
  Buf = RECORD
    b : SLICE OF BYTE ;
    n : I64 ;
  END ;

PROCEDURE NewBuf (VAR pool: POOL ; cap: I64) : Buf =
VAR u : Buf ;
  none : SLICE OF STR ;
BEGIN
  u.b := NEW (pool, BYTE, cap) ;
  u.n := 0 ;
  RETURN u
END NewBuf ;

PROCEDURE Room (VAR u: Buf ; k: I64) =
VAR
  big : SLICE OF BYTE ;
  i, c : I64 ;
BEGIN
  IF u.n + k <= LEN (u.b) THEN RETURN END ;
  c := 2 * LEN (u.b) ;
  WHILE c < u.n + k DO c := 2 * c END ;
  big := NEW (u, BYTE, c) ;
  FOR i := 0 TO u.n - 1 DO
    big[i] := u.b[i]
  END ;
  u.b := big
END Room ;

PROCEDURE P8 (VAR pool: POOL ; VAR u: Buf ; v: I64)
  RAISES ValueRange =
BEGIN
  Room (u, 1) ;
  u.b[u.n] := BYTE (v) ;
  u.n := u.n + 1
END P8 ;

PROCEDURE PLE (VAR pool: POOL ; VAR u: Buf ; v, k: I64)
  RAISES ValueRange =
  (* k little-endian bytes of a NONNEGATIVE v *)
VAR i, x : I64 ;
BEGIN
  x := v ;
  FOR i := 1 TO k DO
    P8 (pool, u, x MOD 256) ;
    x := x DIV 256
  END
END PLE ;

PROCEDURE PBytes (VAR pool: POOL ; VAR u: Buf ; RO s: SLICE OF BYTE) =
VAR i : I64 ;
BEGIN
  Room (u, LEN (s)) ;
  FOR i := 0 TO LEN (s) - 1 DO
    u.b[u.n + i] := s[i]
  END ;
  u.n := u.n + LEN (s)
END PBytes ;

PROCEDURE PVar (VAR pool: POOL ; VAR u: Buf ; v: I64)
  RAISES ValueRange =
  (* unsigned LEB128 of a nonnegative v *)
VAR x : I64 ;
BEGIN
  x := v ;
  WHILE x >= 128 DO
    P8 (pool, u, x MOD 128 + 128) ;
    x := x DIV 128
  END ;
  P8 (pool, u, x)
END PVar ;

PROCEDURE Zig (v: I64) : I64 RAISES Overflow =
  (* zigzag without shifts: 2v for v >= 0, -2v-1 below *)
BEGIN
  IF v >= 0 THEN RETURN 2 * v END ;
  RETURN -2 * v - 1
END Zig ;

(* a thrift field header: delta-encoded id, then the payload the
   caller writes.  `last` is the running field id of the struct. *)
PROCEDURE PField (VAR pool: POOL ; VAR u: Buf ; VAR last: I64 ;
                  id, ct: I64)
  RAISES ValueRange =
BEGIN
  P8 (pool, u, (id - last) * 16 + ct) ;
  last := id
END PField ;

PROCEDURE PI32F (VAR pool: POOL ; VAR u: Buf ; VAR last: I64 ;
                 id, v: I64)
  RAISES ValueRange, Overflow =
BEGIN
  PField (pool, u, last, id, CtI32) ;
  PVar (pool, u, Zig (v))
END PI32F ;

PROCEDURE PI64F (VAR pool: POOL ; VAR u: Buf ; VAR last: I64 ;
                 id, v: I64)
  RAISES ValueRange, Overflow =
BEGIN
  PField (pool, u, last, id, CtI64) ;
  PVar (pool, u, Zig (v))
END PI64F ;

PROCEDURE PStrRaw (VAR pool: POOL ; VAR u: Buf ; RO s: STR)
  RAISES ValueRange, Faults.BadArg =
  (* thrift binary carries BYTES: the text goes out as UTF-8, and
     the length prefix is the BYTE length, not the scalar count --
     the ASCII-only refusal fell when the zarr proxy's passports
     (accented citation names) and station ids met this writer      *)
VAR
  bb : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  bb := DynStr.Utf8 (pool, s) ;
  PVar (pool, u, LEN (bb)) ;
  Room (u, LEN (bb)) ;
  FOR i := 0 TO LEN (bb) - 1 DO
    u.b[u.n + i] := bb[i]
  END ;
  u.n := u.n + LEN (bb)
END PStrRaw ;

PROCEDURE PStrF (VAR pool: POOL ; VAR u: Buf ; VAR last: I64 ;
                 id: I64 ; RO s: STR)
  RAISES ValueRange, Faults.BadArg =
BEGIN
  PField (pool, u, last, id, CtBinary) ;
  PStrRaw (pool, u, s)
END PStrF ;

PROCEDURE PListF (VAR pool: POOL ; VAR u: Buf ; VAR last: I64 ;
                  id, elemCt, count: I64)
  RAISES ValueRange =
BEGIN
  PField (pool, u, last, id, CtList) ;
  IF count < 15 THEN
    P8 (pool, u, count * 16 + elemCt)
  ELSE
    P8 (pool, u, 15 * 16 + elemCt) ;
    PVar (pool, u, count)
  END
END PListF ;

(* ---- the writer ---- *)

PROCEDURE ColPhys (k: I64) : I64 =
  (* physical type from a Frame kind code.  The kind travels as an
     integer because Frame's cross-module face predates the generator
     learning to CASE a cross-module variant (2026-09-15); a CASE over
     Frame.Data would do now and would make this total.  Ledgered. *)
BEGIN
  IF k = Frame.KindF64 THEN RETURN PtDouble END ;
  IF k = Frame.KindF32 THEN RETURN PtFloat END ;
  IF k = Frame.KindI64 THEN RETURN PtInt64 END ;
  IF k = Frame.KindStr THEN RETURN PtByteArray END ;
  IF k = Frame.KindBool THEN RETURN PtBoolean END ;
  RETURN PtInt32
END ColPhys ;

PROCEDURE ColConv (k: I64) : I64 =
  (* the converted_type, or -1 for none *)
BEGIN
  IF k = Frame.KindI16 THEN RETURN CvInt16 END ;
  IF k = Frame.KindByte THEN RETURN CvUint8 END ;
  IF k = Frame.KindStr THEN RETURN CvUtf8 END ;
  RETURN -1
END ColConv ;

PROCEDURE Kept (RO skip: SLICE OF BOOL ; r: I64) : BOOL
  RAISES IndexError =
  (* row r has a value to write: an empty mask skips nothing *)
BEGIN
  RETURN LEN (skip) = 0 OR NOT skip[r]
END Kept ;

PROCEDURE Missing (VAR pool: POOL ; f: PTR Frame.Fr ; RO name: STR ;
                   k: I64) : SLICE OF BOOL
  RAISES Faults.BadArg =
  (* which cells of a numeric column are missing: the column's own
     missing value, or NaN in a real column whatever that value is
     (Frame: a NaN in a real column is ALWAYS missing).  BOOL and STR
     columns have none: an empty mask. *)
VAR
  m : SLICE OF BOOL ;
  v64 : SLICE OF F64 ;
  v32 : SLICE OF F32 ;
  vi64 : SLICE OF I64 ;
  vi32 : SLICE OF I32 ;
  vi16 : SLICE OF I16 ;
  vb : SLICE OF BYTE ;
  m64 : F64 ;
  m32 : F32 ;
  mi64 : I64 ;
  mi32 : I32 ;
  mi16 : I16 ;
  mb : BYTE ;
  r : I64 ;
BEGIN
  IF k = Frame.KindBool OR k = Frame.KindStr THEN RETURN NEW (pool, BOOL, 0) END ;
  m := NEW (pool, BOOL, Frame.Rows (f)) ;
  IF k = Frame.KindF64 THEN
    v64 := Frame.ColF64 (f, name) ;
    m64 := Frame.MissF64 (f, name) ;
    FOR r := 0 TO LEN (v64) - 1 DO
      m[r] := NOT (v64[r] = v64[r]) OR v64[r] = m64
    END
  ELSIF k = Frame.KindF32 THEN
    v32 := Frame.ColF32 (f, name) ;
    m32 := Frame.MissF32 (f, name) ;
    FOR r := 0 TO LEN (v32) - 1 DO
      m[r] := NOT (v32[r] = v32[r]) OR v32[r] = m32
    END
  ELSIF k = Frame.KindI64 THEN
    vi64 := Frame.ColI64 (f, name) ;
    mi64 := Frame.MissI64 (f, name) ;
    FOR r := 0 TO LEN (vi64) - 1 DO m[r] := vi64[r] = mi64 END
  ELSIF k = Frame.KindI32 THEN
    vi32 := Frame.ColI32 (f, name) ;
    mi32 := Frame.MissI32 (f, name) ;
    FOR r := 0 TO LEN (vi32) - 1 DO m[r] := vi32[r] = mi32 END
  ELSIF k = Frame.KindI16 THEN
    vi16 := Frame.ColI16 (f, name) ;
    mi16 := Frame.MissI16 (f, name) ;
    FOR r := 0 TO LEN (vi16) - 1 DO m[r] := vi16[r] = mi16 END
  ELSE
    vb := Frame.ColBytes (f, name) ;
    mb := Frame.MissByte (f, name) ;
    FOR r := 0 TO LEN (vb) - 1 DO m[r] := vb[r] = mb END
  END ;
  RETURN m
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg ('internal: column vanished')
| Frame.WrongType : RAISE Faults.BadArg ('internal: column type changed')
| IndexError : RAISE Faults.BadArg ('internal: a column shorter than the frame')
END Missing ;

PROCEDURE PutValues (VAR pool: POOL ; VAR u: Buf ; f: PTR Frame.Fr ;
                     RO name: STR ; k: I64 ; RO skip: SLICE OF BOOL)
  RAISES ValueRange, Overflow, IndexError, Faults.BadArg =
  (* the PLAIN values of the rows skip does not mark; BOOL and STR
     columns are never handed a mask *)
VAR
  r, x : I64 ;
  v64 : SLICE OF F64 ;
  v32 : SLICE OF F32 ;
  vi64 : SLICE OF I64 ;
  vi32 : SLICE OF I32 ;
  vi16 : SLICE OF I16 ;
  vb : SLICE OF BYTE ;
  vbo : SLICE OF BOOL ;
  vs : SLICE OF STR ;
  b : I64 ;
BEGIN
  IF k = Frame.KindF64 THEN
    v64 := Frame.ColF64 (f, name) ;
    Room (u, 8 * LEN (v64)) ;
    FOR r := 0 TO LEN (v64) - 1 DO
      IF Kept (skip, r) THEN
        F64.ToBytesLE (v64[r], SLICE (u.b, u.n, 8)) ;
        u.n := u.n + 8
      END
    END
  ELSIF k = Frame.KindF32 THEN
    v32 := Frame.ColF32 (f, name) ;
    Room (u, 4 * LEN (v32)) ;
    FOR r := 0 TO LEN (v32) - 1 DO
      IF Kept (skip, r) THEN
        F32.ToBytesLE (v32[r], SLICE (u.b, u.n, 4)) ;
        u.n := u.n + 4
      END
    END
  ELSIF k = Frame.KindI64 THEN
    vi64 := Frame.ColI64 (f, name) ;
    FOR r := 0 TO LEN (vi64) - 1 DO
      (* two's complement LE: negatives via the 2^63 split, no
         shifts needed *)
      x := vi64[r] ;
      IF NOT Kept (skip, r) THEN
      ELSIF x >= 0 THEN
        PLE (pool, u, x MOD 4294967296, 4) ;
        PLE (pool, u, x DIV 4294967296, 4)
      ELSE
        x := x + 1 + 9223372036854775807 ;   (* x + 2^63 *)
        PLE (pool, u, x MOD 4294967296, 4) ;
        PLE (pool, u, x DIV 4294967296 + 2147483648, 4)
      END
    END
  ELSIF k = Frame.KindI32 THEN
    vi32 := Frame.ColI32 (f, name) ;
    FOR r := 0 TO LEN (vi32) - 1 DO
      IF Kept (skip, r) THEN
        x := I64 (vi32[r]) ;
        IF x < 0 THEN x := x + 4294967296 END ;
        PLE (pool, u, x, 4)
      END
    END
  ELSIF k = Frame.KindI16 THEN
    vi16 := Frame.ColI16 (f, name) ;
    FOR r := 0 TO LEN (vi16) - 1 DO
      IF Kept (skip, r) THEN
        x := I64 (vi16[r]) ;
        IF x < 0 THEN x := x + 4294967296 END ;
        PLE (pool, u, x, 4)
      END
    END
  ELSIF k = Frame.KindByte THEN
    vb := Frame.ColBytes (f, name) ;
    FOR r := 0 TO LEN (vb) - 1 DO
      IF Kept (skip, r) THEN PLE (pool, u, I64 (vb[r]), 4) END
    END
  ELSIF k = Frame.KindBool THEN
    vbo := Frame.ColBools (f, name) ;
    (* PLAIN booleans are BIT-PACKED, LSB first, zero-padded *)
    x := 0 ;
    b := 1 ;
    FOR r := 0 TO LEN (vbo) - 1 DO
      IF vbo[r] THEN x := x + b END ;
      b := b * 2 ;
      IF b = 256 THEN
        P8 (pool, u, x) ;
        x := 0 ;
        b := 1
      END
    END ;
    IF b > 1 THEN P8 (pool, u, x) END
  ELSE
    vs := Frame.ColStrs (f, name) ;
    FOR r := 0 TO LEN (vs) - 1 DO
      PStrVal (pool, u, vs[r])
    END
  END
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg ('internal: column vanished')
| Frame.WrongType : RAISE Faults.BadArg ('internal: column type changed')
END PutValues ;

PROCEDURE PStrVal (VAR pool: POOL ; VAR u: Buf ; RO s: STR)
  RAISES ValueRange =
  (* a PLAIN BYTE_ARRAY value: 4-byte BYTE length, then UTF-8 --
     the length must count the encoded bytes, not the scalars      *)
VAR
  bb : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  bb := DynStr.Utf8 (pool, s) ;
  PLE (pool, u, LEN (bb), 4) ;
  Room (u, LEN (bb)) ;
  FOR i := 0 TO LEN (bb) - 1 DO
    u.b[u.n + i] := bb[i]
  END ;
  u.n := u.n + LEN (bb)
END PStrVal ;

PROCEDURE PageFor (VAR pool: POOL ; f: PTR Frame.Fr ;
                   RO name: STR ; k: I64 ; optional: BOOL ;
                   RO skip: SLICE OF BOOL ; codec: I64 ;
                   VAR unc: I64) : Buf
  RAISES ValueRange, Overflow, IndexError, Faults.BadArg =
  (* one DATA_PAGE: thrift PageHeader, then PLAIN values.  An
     OPTIONAL column's values are preceded by its definition levels
     (max level 1): a 4-byte length, then ONE bit-packed run of the
     RLE/bit-packed hybrid -- header (groups * 2 + 1), groups of
     eight levels a byte, LSB first, the last group zero-padded (the
     format allows it: num_values says where the levels end) -- and
     only the present values follow.  The levels and the values are
     compressed TOGETHER by the codec (a version 1 page); unc answers
     the page's size uncompressed, header included, for the column's
     total_uncompressed_size. *)
VAR
  vals, page, lv : Buf ;
  packed : SLICE OF BYTE ;
  last, last2, r, x, b : I64 ;
BEGIN
  vals := NewBuf (pool, 64) ;
  IF optional THEN
    lv := NewBuf (pool, 16) ;
    PVar (pool, lv, ((Frame.Rows (f) + 7) DIV 8) * 2 + 1) ;
    x := 0 ;
    b := 1 ;
    FOR r := 0 TO Frame.Rows (f) - 1 DO
      IF Kept (skip, r) THEN x := x + b END ;
      b := b * 2 ;
      IF b = 256 THEN
        P8 (pool, lv, x) ;
        x := 0 ;
        b := 1
      END
    END ;
    IF b > 1 THEN P8 (pool, lv, x) END ;
    PLE (pool, vals, lv.n, 4) ;
    PBytes (pool, vals, SLICE (lv.b, 0, lv.n))
  END ;
  PutValues (pool, vals, f, name, k, skip) ;
  IF codec = CodecSnappy THEN
    packed := SnappyEncode (pool, SLICE (vals.b, 0, vals.n))
  ELSIF codec = CodecGzip THEN
    packed := Zip.Gzip (pool, SLICE (vals.b, 0, vals.n))
  ELSIF codec = CodecZstd THEN
    packed := ZstdEncode (pool, SLICE (vals.b, 0, vals.n))
  ELSE
    packed := SLICE (vals.b, 0, vals.n)
  END ;
  page := NewBuf (pool, LEN (packed) + 64) ;
  last := 0 ;
  PI32F (pool, page, last, 1, PgData) ;         (* type DATA_PAGE *)
  PI32F (pool, page, last, 2, vals.n) ;         (* uncompressed *)
  PI32F (pool, page, last, 3, LEN (packed)) ;   (* compressed *)
  PField (pool, page, last, 5, CtStruct) ;      (* data_page_header *)
  last2 := 0 ;
  PI32F (pool, page, last2, 1, Frame.Rows (f)) ;
  PI32F (pool, page, last2, 2, EncPlain) ;
  PI32F (pool, page, last2, 3, EncRle) ;
  PI32F (pool, page, last2, 4, EncRle) ;
  P8 (pool, page, CtStop) ;                     (* end DataPageHeader *)
  P8 (pool, page, CtStop) ;                     (* end PageHeader *)
  unc := page.n + vals.n ;
  PBytes (pool, page, packed) ;
  RETURN page
END PageFor ;

(* ---- snappy, the writing half: a literal until four bytes are seen
   again within 64 KiB, then a copy of as many as match (2-byte
   offsets, at most 64 a copy).  The hash table holds the last
   position + 1 of each four-byte hash.  Any decoder reads it: held by
   pyarrow's (columnar.sh) and by SnappyDecode (ParquetTest). ---- *)

PROCEDURE SnappyEncode (VAR pool: POOL ; RO d: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES ValueRange, IndexError =
VAR
  u : Buf ;
  table : SLICE OF I64 ;
  n, i, lit, cand, h, len, x, y : I64 ;
BEGIN
  n := LEN (d) ;
  u := NewBuf (pool, n DIV 2 + 16) ;
  PVar (pool, u, n) ;
  table := NEW (pool, I64, 16384) ;
  i := 0 ;
  lit := 0 ;
  WHILE i + 4 <= n DO
    x := I64 (d[i]) + 256 * I64 (d[i + 1]) + 65536 * I64 (d[i + 2])
         + 16777216 * I64 (d[i + 3]) ;
    h := ((x * 506832829) MOD 4294967296) DIV 262144 ;
    cand := table[h] - 1 ;
    table[h] := i + 1 ;
    y := -1 ;
    IF cand >= 0 AND i - cand <= 65535 THEN
      y := I64 (d[cand]) + 256 * I64 (d[cand + 1]) + 65536 * I64 (d[cand + 2])
           + 16777216 * I64 (d[cand + 3])
    END ;
    IF y = x THEN
      len := 4 ;
      WHILE i + len < n AND d[cand + len] = d[i + len] DO
        len := len + 1
      END ;
      SnapLiteral (pool, u, d, lit, i - lit) ;
      SnapCopy (pool, u, i - cand, len) ;
      i := i + len ;
      lit := i
    ELSE
      i := i + 1
    END
  END ;
  SnapLiteral (pool, u, d, lit, n - lit) ;
  RETURN SLICE (u.b, 0, u.n)
END SnappyEncode ;

PROCEDURE SnapLiteral (VAR pool: POOL ; VAR u: Buf ; RO d: SLICE OF BYTE ;
                       start, len: I64)
  RAISES ValueRange =
BEGIN
  IF len = 0 THEN RETURN END ;
  IF len <= 60 THEN
    P8 (pool, u, (len - 1) * 4)
  ELSIF len <= 256 THEN
    P8 (pool, u, 60 * 4) ;
    PLE (pool, u, len - 1, 1)
  ELSIF len <= 65536 THEN
    P8 (pool, u, 61 * 4) ;
    PLE (pool, u, len - 1, 2)
  ELSIF len <= 16777216 THEN
    P8 (pool, u, 62 * 4) ;
    PLE (pool, u, len - 1, 3)
  ELSE
    P8 (pool, u, 63 * 4) ;
    PLE (pool, u, len - 1, 4)
  END ;
  PBytes (pool, u, SLICE (d, start, len))
END SnapLiteral ;

PROCEDURE SnapCopy (VAR pool: POOL ; VAR u: Buf ; off, len: I64)
  RAISES ValueRange =
VAR left, k : I64 ;
BEGIN
  left := len ;
  WHILE left > 0 DO
    k := left ;
    IF k > 64 THEN k := 64 END ;
    P8 (pool, u, (k - 1) * 4 + 2) ;
    PLE (pool, u, off, 2) ;
    left := left - k
  END
END SnapCopy ;

PROCEDURE SchemaElem (VAR pool: POOL ; VAR u: Buf ; RO name: STR ;
                      k: I64 ; ns, us, i8, optional: BOOL)
  RAISES ValueRange, Overflow, Faults.BadArg =
  (* ns and us are each a TIMESTAMP logical type: NANOS said UTC,
     MICROS said local.  Neither has a converted_type here: the
     legacy TIMESTAMP_MICROS means adjusted-to-UTC, and a reader
     that prefers it would put a zone on a time that has none. *)
VAR last, l2, l3, l4 : I64 ;
BEGIN
  last := 0 ;
  PI32F (pool, u, last, 1, ColPhys (k)) ;       (* type *)
  IF optional THEN
    PI32F (pool, u, last, 3, 1)                 (* OPTIONAL *)
  ELSE
    PI32F (pool, u, last, 3, 0)                 (* REQUIRED *)
  END ;
  PStrF (pool, u, last, 4, name) ;
  IF i8 THEN
    PI32F (pool, u, last, 6, CvInt8)
  ELSIF ColConv (k) >= 0 THEN
    PI32F (pool, u, last, 6, ColConv (k))
  END ;
  IF ns OR us THEN
    (* logicalType = TIMESTAMP { isAdjustedToUTC, unit } --
       SchemaElement field 10, nested unions as one-field structs,
       an empty unit struct inside (MICROS is the union's field 2,
       NANOS its field 3).  Bools in a compact struct are the field
       header's type: CtTrue / CtFalse, no payload. *)
    PField (pool, u, last, 10, CtStruct) ;
    l2 := 0 ;
    PField (pool, u, l2, 8, CtStruct) ;         (* TIMESTAMP *)
    l3 := 0 ;
    IF ns THEN
      PField (pool, u, l3, 1, CtTrue)           (* utc-adjusted *)
    ELSE
      PField (pool, u, l3, 1, CtFalse)          (* local: no zone *)
    END ;
    PField (pool, u, l3, 2, CtStruct) ;         (* unit *)
    l4 := 0 ;
    IF ns THEN
      PField (pool, u, l4, 3, CtStruct)         (* NANOS *)
    ELSE
      PField (pool, u, l4, 2, CtStruct)         (* MICROS *)
    END ;
    P8 (pool, u, CtStop) ;                      (* empty unit struct *)
    P8 (pool, u, CtStop) ;                      (* end TimeUnit *)
    P8 (pool, u, CtStop) ;                      (* end TimestampType *)
    P8 (pool, u, CtStop)                        (* end LogicalType *)
  END ;
  P8 (pool, u, CtStop)
END SchemaElem ;

PROCEDURE InList (RO name: STR ; RO xs: SLICE OF STR) : BOOL
  RAISES ValueRange, IndexError =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (xs) - 1 DO
    IF DynStr.Eq (xs[i], name) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END InList ;

PROCEDURE MetaKV (VAR pool: POOL ; VAR u: Buf ; RO k, v: STR)
  RAISES ValueRange, Faults.BadArg =
VAR last : I64 ;
BEGIN
  last := 0 ;
  PStrF (pool, u, last, 1, k) ;
  PStrF (pool, u, last, 2, v) ;
  P8 (pool, u, CtStop)
END MetaKV ;

PROCEDURE I64Text (v: I64) : STR
  RAISES ValueRange, Overflow =
VAR pool : POOL ;
    d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendI64 (d, v) ;
  RETURN DynStr.View (d)
END I64Text ;

PROCEDURE WriteAny (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR ;
                    withTs: BOOL ; ts: PTR Frame.Ts ; RO o: Options)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
BEGIN
  Io.WriteFileBytes (path, AnyBytes (pool, f, withTs, ts, o))
END WriteAny ;

PROCEDURE CheckNames (f: PTR Frame.Fr ; RO what: STR ;
                      RO xs: SLICE OF STR ; k1, k2: I64)
  RAISES Faults.BadArg, IndexError =
  (* every name in xs is a column of kind k1 or k2 *)
VAR
  i, k : I64 ;
BEGIN
  FOR i := 0 TO LEN (xs) - 1 DO
    IF Frame.Find (f, xs[i]) < 0 THEN
      RAISE Faults.BadArg (what + ' names no column: ' + xs[i])
    END ;
    k := KindQ (f, xs[i]) ;
    IF k # k1 AND k # k2 THEN
      RAISE Faults.BadArg (what + ' names a column of another kind: ' + xs[i])
    END
  END
END CheckNames ;

PROCEDURE CheckI8 (f: PTR Frame.Fr ; RO name: STR ; k: I64 ;
                   RO skip: SLICE OF BOOL)
  RAISES Faults.BadArg, IndexError =
  (* every value to be written fits INT_8; a skipped (null) cell is
     not a value *)
VAR
  vi32 : SLICE OF I32 ;
  vi16 : SLICE OF I16 ;
  r, x : I64 ;
BEGIN
  IF k = Frame.KindI32 THEN
    vi32 := Frame.ColI32 (f, name) ;
    FOR r := 0 TO LEN (vi32) - 1 DO
      x := I64 (vi32[r]) ;
      IF Kept (skip, r) AND (x < -128 OR x > 127) THEN
        RAISE Faults.BadArg ('a value outside INT_8 in column ' + name)
      END
    END
  ELSE
    vi16 := Frame.ColI16 (f, name) ;
    FOR r := 0 TO LEN (vi16) - 1 DO
      x := I64 (vi16[r]) ;
      IF Kept (skip, r) AND (x < -128 OR x > 127) THEN
        RAISE Faults.BadArg ('a value outside INT_8 in column ' + name)
      END
    END
  END
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg ('internal: column vanished')
| Frame.WrongType : RAISE Faults.BadArg ('internal: column type changed')
END CheckI8 ;

PROCEDURE AnyBytes (VAR pool: POOL ; f: PTR Frame.Fr ;
                    withTs: BOOL ; ts: PTR Frame.Ts ; RO o: Options)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, Overflow, IndexError =
VAR
  out, meta, page : Buf ;
  pages : SLICE OF Buf ;
  offs, kinds, uncs : SLICE OF I64 ;
  names : SLICE OF STR ;
  opt : SLICE OF BOOL ;
  skip : SLICE OF BOOL ;
  c, nc, last, lastRg, lastCc, lastCm, i, kvn : I64 ;
  conv : Frame.Conv ;
BEGIN
  (* nsCols is not held to the frame: WriteX never did, and a caller
     naming a column it did not add got a file, not a refusal *)
  CheckNames (f, 'usCols', o.usCols, Frame.KindI64, Frame.KindI64) ;
  CheckNames (f, 'i8Cols', o.i8Cols, Frame.KindI32, Frame.KindI16) ;
  FOR i := 0 TO LEN (o.usCols) - 1 DO
    IF InList (o.usCols[i], o.nsCols) THEN
      RAISE Faults.BadArg ('a column in both nsCols and usCols: ' + o.usCols[i])
    END
  END ;
  IF o.codec # CodecNone AND o.codec # CodecSnappy AND o.codec # CodecGzip
     AND o.codec # CodecZstd THEN
    RAISE Faults.BadArg ('codec ' + I64Text (o.codec)
                         + ': CodecNone, CodecSnappy, CodecGzip or CodecZstd')
  END ;
  nc := Frame.Cols (f) ;
  out := NewBuf (pool, 4096) ;
  PBytes (pool, out, MagicBytes ()) ;
  pages := NEW (pool, Buf, nc) ;
  offs := NEW (pool, I64, nc) ;
  uncs := NEW (pool, I64, nc) ;
  names := NEW (pool, STR, nc) ;
  kinds := NEW (pool, I64, nc) ;
  opt := NEW (pool, BOOL, nc) ;
  FOR c := 0 TO nc - 1 DO
    names[c] := Frame.NameAt (f, c) ;
    kinds[c] := KindQ (f, names[c]) ;
    (* BOOL and STR are never null: Frame keeps no missing value for
       a BOOL (it refuses a null one by name), and an empty string is
       a value, not a missing one *)
    opt[c] := o.nulls AND kinds[c] # Frame.KindBool AND kinds[c] # Frame.KindStr ;
    IF opt[c] THEN
      skip := Missing (pool, f, names[c], kinds[c])
    ELSE
      skip := NEW (pool, BOOL, 0)
    END ;
    IF InList (names[c], o.i8Cols) THEN
      CheckI8 (f, names[c], kinds[c], skip)
    END ;
    offs[c] := out.n ;
    page := PageFor (pool, f, names[c], kinds[c], opt[c], skip, o.codec, uncs[c]) ;
    pages[c] := page ;
    PBytes (pool, out, SLICE (page.b, 0, page.n))
  END ;

  meta := NewBuf (pool, 1024) ;
  last := 0 ;
  PI32F (pool, meta, last, 1, 1) ;              (* version *)
  PListF (pool, meta, last, 2, CtStruct, nc + 1) ;   (* schema *)
  (* the root element: name + num_children *)
  lastRg := 0 ;
  PStrF (pool, meta, lastRg, 4, 'schema') ;
  PI32F (pool, meta, lastRg, 5, nc) ;
  P8 (pool, meta, CtStop) ;
  FOR c := 0 TO nc - 1 DO
    SchemaElem (pool, meta, names[c], kinds[c],
                InList (names[c], o.nsCols), InList (names[c], o.usCols),
                InList (names[c], o.i8Cols), opt[c])
  END ;
  PI64F (pool, meta, last, 3, Frame.Rows (f)) ; (* num_rows *)
  PListF (pool, meta, last, 4, CtStruct, 1) ;   (* row_groups *)
  lastRg := 0 ;
  PListF (pool, meta, lastRg, 1, CtStruct, nc) ;
  FOR c := 0 TO nc - 1 DO
    lastCc := 0 ;
    PI64F (pool, meta, lastCc, 2, offs[c]) ;    (* file_offset *)
    PField (pool, meta, lastCc, 3, CtStruct) ;  (* meta_data *)
    lastCm := 0 ;
    PI32F (pool, meta, lastCm, 1, ColPhys (kinds[c])) ;
    PListF (pool, meta, lastCm, 2, CtI32, 2) ;
    PVar (pool, meta, Zig (EncPlain)) ;
    PVar (pool, meta, Zig (EncRle)) ;
    PListF (pool, meta, lastCm, 3, CtBinary, 1) ;
    PStrRaw (pool, meta, names[c]) ;
    PI32F (pool, meta, lastCm, 4, o.codec) ;
    PI64F (pool, meta, lastCm, 5, Frame.Rows (f)) ;
    PI64F (pool, meta, lastCm, 6, uncs[c]) ;     (* total_uncompressed_size *)
    PI64F (pool, meta, lastCm, 7, pages[c].n) ;  (* total_compressed_size *)
    PI64F (pool, meta, lastCm, 9, offs[c]) ;    (* data_page_offset *)
    P8 (pool, meta, CtStop) ;                   (* end ColumnMetaData *)
    P8 (pool, meta, CtStop)                     (* end ColumnChunk *)
  END ;
  PI64F (pool, meta, lastRg, 2, out.n - 4) ;    (* total_byte_size *)
  PI64F (pool, meta, lastRg, 3, Frame.Rows (f)) ;
  P8 (pool, meta, CtStop) ;                     (* end RowGroup *)
  IF LEN (o.kvK) # LEN (o.kvV) THEN
    RAISE Faults.BadArg ('key_value_metadata: keys and values differ in number')
  END ;
  kvn := LEN (o.kvK) ;
  IF withTs THEN kvn := kvn + 3 END ;
  IF kvn > 0 THEN
    PListF (pool, meta, last, 5, CtStruct, kvn) ;
    IF withTs THEN
      conv := Frame.TsConv (ts) ;
      MetaKV (pool, meta, 'frame_resolution_seconds',
              I64Text (Frame.TsRes (ts))) ;
      MetaKV (pool, meta, 'frame_time_convention',
              Frame.ConvName (conv)) ;
      MetaKV (pool, meta, 'description', Frame.TsDescr (ts))
    END ;
    FOR i := 0 TO LEN (o.kvK) - 1 DO
      MetaKV (pool, meta, o.kvK[i], o.kvV[i])
    END
  END ;
  P8 (pool, meta, CtStop) ;                     (* end FileMetaData *)

  PBytes (pool, out, SLICE (meta.b, 0, meta.n)) ;
  PLE (pool, out, meta.n, 4) ;
  PBytes (pool, out, MagicBytes ()) ;
  RETURN SLICE (out.b, 0, out.n)
END AnyBytes ;

PROCEDURE MagicBytes () : SLICE OF BYTE =
VAR m : SLICE OF BYTE ;
BEGIN
  m := NEW (BYTE, 4) ;
  m[0] := 80 ; m[1] := 65 ; m[2] := 82 ; m[3] := 49 ;   (* PAR1 *)
  RETURN m
END MagicBytes ;

PROCEDURE Write (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
VAR o : Options ;
BEGIN
  WriteAny (pool, f, path, FALSE, NIL9 (pool), o)
END Write ;

PROCEDURE WriteX (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR ;
                  RO kvK: SLICE OF STR ; RO kvV: SLICE OF STR ;
                  RO nsCols: SLICE OF STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
VAR o : Options ;
BEGIN
  o.kvK := kvK ;
  o.kvV := kvV ;
  o.nsCols := nsCols ;
  WriteAny (pool, f, path, FALSE, NIL9 (pool), o)
END WriteX ;

PROCEDURE WriteOpt (VAR pool: POOL ; f: PTR Frame.Fr ; RO path: STR ;
                    RO o: Options)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
BEGIN
  WriteAny (pool, f, path, FALSE, NIL9 (pool), o)
END WriteOpt ;

PROCEDURE BytesOpt (VAR pool: POOL ; f: PTR Frame.Fr ; RO o: Options)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, Overflow, IndexError =
BEGIN
  RETURN AnyBytes (pool, f, FALSE, NIL9 (pool), o)
END BytesOpt ;

PROCEDURE NIL9 (VAR pool: POOL) : PTR Frame.Ts =
  (* a placeholder Ts nothing reads: WriteAny only touches ts when
     withTs is TRUE.  M9 has no NIL, which is the point; this is an
     honest empty object instead. *)
VAR
  f : PTR Frame.Fr IN pool ;
  t : SLICE OF I64 ;
BEGIN
  f := Frame.New (pool, 1) ;
  t := NEW (pool, I64, 1) ;
  RETURN Frame.NewTs (pool, f, t, 1, Frame.ConvStart (), '')
EXCEPT
| Faults.SizeError : RAISE Overflow    (* unreachable *)
| Frame.Disorder : RAISE Overflow
| Faults.BadArg : RAISE Overflow
END NIL9 ;

PROCEDURE WriteTs (VAR pool: POOL ; ts: PTR Frame.Ts ; RO path: STR)
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
VAR
  f2 : PTR Frame.Fr IN pool ;
  o : Options ;
  c : I64 ;
BEGIN
  (* time first, then the data columns, in one flat frame *)
  f2 := Frame.New (pool, Frame.Rows (Frame.TsFrame (ts))) ;
  Frame.AddI64 (pool, f2, 'time', Frame.TsTime (ts),
                -9223372036854775807 - 1) ;
  FOR c := 0 TO Frame.Cols (Frame.TsFrame (ts)) - 1 DO
    AddCopy (pool, f2, Frame.TsFrame (ts),
             Frame.NameAt (Frame.TsFrame (ts), c))
  END ;
  WriteAny (pool, f2, path, TRUE, ts, o)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('internal: ts frame sizes disagree')
| Frame.Duplicate : RAISE Faults.BadArg ('a column is already named time')
END WriteTs ;

PROCEDURE AddCopy (VAR pool: POOL ; VAR dst: PTR Frame.Fr ;
                   src: PTR Frame.Fr ; RO name: STR)
  RAISES Faults.SizeError, Frame.Duplicate, IndexError, Faults.BadArg =
VAR k : I64 ;
BEGIN
  k := KindQ (src, name) ;
  IF k = Frame.KindF64 THEN
    Frame.AddF64 (pool, dst, name, Frame.ColF64 (src, name),
                  Frame.MissF64 (src, name))
  ELSIF k = Frame.KindF32 THEN
    Frame.AddF32 (pool, dst, name, Frame.ColF32 (src, name),
                  Frame.MissF32 (src, name))
  ELSIF k = Frame.KindI64 THEN
    Frame.AddI64 (pool, dst, name, Frame.ColI64 (src, name),
                  Frame.MissI64 (src, name))
  ELSIF k = Frame.KindI32 THEN
    Frame.AddI32 (pool, dst, name, Frame.ColI32 (src, name),
                  Frame.MissI32 (src, name))
  ELSIF k = Frame.KindI16 THEN
    Frame.AddI16 (pool, dst, name, Frame.ColI16 (src, name),
                  Frame.MissI16 (src, name))
  ELSIF k = Frame.KindByte THEN
    Frame.AddBytes (pool, dst, name, Frame.ColBytes (src, name),
                    Frame.MissByte (src, name))
  ELSIF k = Frame.KindBool THEN
    Frame.AddBools (pool, dst, name, Frame.ColBools (src, name))
  ELSE
    Frame.AddStrs (pool, dst, name, Frame.ColStrs (src, name))
  END
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg ('internal: column vanished')
| Frame.WrongType : RAISE Faults.BadArg ('internal: column type changed')
END AddCopy ;

PROCEDURE KindQ (f: PTR Frame.Fr ; RO name: STR) : I64
  RAISES Faults.BadArg =
BEGIN
  RETURN Frame.KindOf (f, name)
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg ('internal: column vanished')
END KindQ ;

(* ---- the reader ---- *)

TYPE
  Rd = RECORD
    b : SLICE OF BYTE ;
    at : I64 ;
  END ;

PROCEDURE R8 (VAR r: Rd) : I64 RAISES Faults.BadArg =
BEGIN
  IF r.at >= LEN (r.b) THEN RAISE Faults.BadArg ('truncated metadata') END ;
  r.at := r.at + 1 ;
  RETURN I64 (r.b[r.at - 1])
END R8 ;

PROCEDURE RVar (VAR r: Rd) : I64 RAISES Faults.BadArg, Overflow =
VAR v, m, b : I64 ;
BEGIN
  v := 0 ;
  m := 1 ;
  b := R8 (r) ;
  WHILE b >= 128 DO
    v := v + (b - 128) * m ;
    m := m * 128 ;
    b := R8 (r)
  END ;
  RETURN v + b * m
END RVar ;

PROCEDURE RZig (VAR r: Rd) : I64 RAISES Faults.BadArg, Overflow =
VAR k : I64 ;
BEGIN
  k := RVar (r) ;
  IF k MOD 2 = 0 THEN RETURN k DIV 2 END ;
  RETURN -(k DIV 2) - 1
END RZig ;

PROCEDURE RSkipBytes (VAR r: Rd ; k: I64) RAISES Faults.BadArg =
BEGIN
  IF r.at + k > LEN (r.b) THEN RAISE Faults.BadArg ('truncated metadata') END ;
  r.at := r.at + k
END RSkipBytes ;

PROCEDURE RSkip (VAR r: Rd ; ct: I64) RAISES Faults.BadArg, Overflow =
  (* skip one value of compact type ct, recursively *)
VAR n, i, et, hdr : I64 ;
BEGIN
  IF ct = CtTrue OR ct = CtFalse THEN
    RETURN
  ELSIF ct = CtByte THEN
    RSkipBytes (r, 1)
  ELSIF ct = CtI16 OR ct = CtI32 OR ct = CtI64 THEN
    n := RVar (r)
  ELSIF ct = CtDouble THEN
    RSkipBytes (r, 8)
  ELSIF ct = CtBinary THEN
    n := RVar (r) ;
    RSkipBytes (r, n)
  ELSIF ct = CtList OR ct = CtSet THEN
    hdr := R8 (r) ;
    n := hdr DIV 16 ;
    et := hdr MOD 16 ;
    IF n = 15 THEN n := RVar (r) END ;
    FOR i := 1 TO n DO
      RSkip (r, et)
    END
  ELSIF ct = CtStruct THEN
    RSkipStruct (r)
  ELSE
    RAISE Faults.BadArg ('thrift type unsupported')
  END
END RSkip ;

PROCEDURE RSkipStruct (VAR r: Rd) RAISES Faults.BadArg, Overflow =
VAR b, ct, delta, dummy : I64 ;
BEGIN
  b := R8 (r) ;
  WHILE b # CtStop DO
    delta := b DIV 16 ;
    ct := b MOD 16 ;
    IF delta = 0 THEN
      dummy := RZig (r)     (* long-form field id *)
    END ;
    RSkip (r, ct) ;
    b := R8 (r)
  END
END RSkipStruct ;

(* one struct field header; answers FALSE at stop *)
PROCEDURE RField (VAR r: Rd ; VAR last: I64 ; VAR id, ct: I64) : BOOL
  RAISES Faults.BadArg, Overflow =
VAR b, delta : I64 ;
BEGIN
  b := R8 (r) ;
  IF b = CtStop THEN RETURN FALSE END ;
  delta := b DIV 16 ;
  ct := b MOD 16 ;
  IF delta = 0 THEN
    id := RZig (r)
  ELSE
    id := last + delta
  END ;
  last := id ;
  RETURN TRUE
END RField ;

PROCEDURE RStr (VAR pool: POOL ; VAR r: Rd) : STR
  RAISES Faults.BadArg, Overflow, ValueRange =
VAR
  n, i : I64 ;
  s : SLICE OF CHAR ;
BEGIN
  n := RVar (r) ;
  IF r.at + n > LEN (r.b) THEN RAISE Faults.BadArg ('truncated string') END ;
  s := DynStr.FromUtf8 (pool, SLICE (r.b, r.at, n)) ;
  r.at := r.at + n ;
  RETURN s
END RStr ;

TYPE
  ColInfo = RECORD
    name : STR ;
    phys : I64 ;
    conv : I64 ;           (* converted_type, -1 none *)
    optional : BOOL ;
  END ;

  Chunk = RECORD           (* one column of one row group *)
    codec : I64 ;
    nvals : I64 ;          (* values, nulls counted *)
    off : I64 ;            (* data_page_offset *)
    dictOff : I64 ;        (* dictionary_page_offset, -1 none *)
  END ;

  Meta = RECORD
    rows : I64 ;
    ncols : I64 ;
    cols : SLICE OF ColInfo ;
    ngroups : I64 ;
    chunks : SLICE OF Chunk ;   (* group g, column c: g * ncols + c *)
    kvKeys : SLICE OF STR ;
    kvVals : SLICE OF STR ;
    nkv : I64 ;
  END ;

PROCEDURE ReadSchema (VAR pool: POOL ; VAR r: Rd ; VAR m: Meta)
  RAISES Faults.BadArg, Overflow, ValueRange =
VAR
  hdr, n, i, last, id, ct, children, rep : I64 ;
  first : BOOL ;
  ci : ColInfo ;
BEGIN
  hdr := R8 (r) ;
  n := hdr DIV 16 ;
  IF n = 15 THEN n := RVar (r) END ;
  IF hdr MOD 16 # CtStruct THEN RAISE Faults.BadArg ('schema shape') END ;
  m.cols := NEW (pool, ColInfo, n) ;
  m.ncols := 0 ;
  first := TRUE ;
  FOR i := 1 TO n DO
    ci.name := '' ;
    ci.phys := -1 ;
    ci.conv := -1 ;
    ci.optional := FALSE ;
    children := 0 ;
    rep := 0 ;
    last := 0 ;
    WHILE RField (r, last, id, ct) DO
      IF id = 1 AND ct = CtI32 THEN
        ci.phys := RZig (r)
      ELSIF id = 3 AND ct = CtI32 THEN
        rep := RZig (r) ;          (* REQUIRED 0, OPTIONAL 1, REPEATED 2 *)
        ci.optional := rep = 1
      ELSIF id = 4 AND ct = CtBinary THEN
        ci.name := RStr (pool, r)
      ELSIF id = 5 AND ct = CtI32 THEN
        children := RZig (r)
      ELSIF id = 6 AND ct = CtI32 THEN
        ci.conv := RZig (r)
      ELSE
        RSkip (r, ct)
      END
    END ;
    IF first THEN
      first := FALSE
      (* the root: children counted, nothing else kept *)
    ELSE
      IF children > 0 THEN RAISE Faults.BadArg ('nested schema') END ;
      IF rep = 2 THEN RAISE Faults.BadArg ('a repeated column: ' + ci.name) END ;
      m.cols[m.ncols] := ci ;
      m.ncols := m.ncols + 1
    END
  END
END ReadSchema ;

PROCEDURE ReadMeta (VAR pool: POOL ; RO whole: SLICE OF BYTE)
  : Meta
  RAISES Faults.BadArg, Overflow, ValueRange, IndexError =
VAR
  r : Rd ;
  m : Meta ;
  mlen, last, id, ct, hdr, n, g, i : I64 ;
BEGIN
  IF LEN (whole) < 12 THEN RAISE Faults.BadArg ('not a parquet file') END ;
  IF NOT (I64 (whole[0]) = 80 AND I64 (whole[1]) = 65
          AND I64 (whole[2]) = 82 AND I64 (whole[3]) = 49) THEN
    RAISE Faults.BadArg ('missing PAR1 magic')
  END ;
  mlen := I64 (whole[LEN (whole) - 8])
          + 256 * I64 (whole[LEN (whole) - 7])
          + 65536 * I64 (whole[LEN (whole) - 6])
          + 16777216 * I64 (whole[LEN (whole) - 5]) ;
  IF mlen > LEN (whole) - 12 THEN RAISE Faults.BadArg ('truncated metadata') END ;
  r.b := SLICE (whole, LEN (whole) - 8 - mlen, mlen) ;
  r.at := 0 ;
  m.rows := 0 ;
  m.ncols := 0 ;
  m.cols := NEW (pool, ColInfo, 0) ;
  m.ngroups := 0 ;
  m.chunks := NEW (pool, Chunk, 0) ;
  m.nkv := 0 ;
  m.kvKeys := NEW (pool, STR, 8) ;
  m.kvVals := NEW (pool, STR, 8) ;
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 2 AND ct = CtList THEN
      ReadSchema (pool, r, m)
    ELSIF id = 3 AND ct = CtI64 THEN
      m.rows := RZig (r)
    ELSIF id = 4 AND ct = CtList THEN
      (* every row group: a column of the frame is its chunks, one
         per group, in order (the schema, field 2, came first) *)
      hdr := R8 (r) ;
      n := hdr DIV 16 ;
      IF n = 15 THEN n := RVar (r) END ;
      m.ngroups := n ;
      m.chunks := NEW (pool, Chunk, n * m.ncols) ;
      FOR g := 0 TO n - 1 DO
        ReadRowGroup (r, m, g)
      END
    ELSIF id = 5 AND ct = CtList THEN
      hdr := R8 (r) ;
      n := hdr DIV 16 ;
      IF n = 15 THEN n := RVar (r) END ;
      FOR i := 1 TO n DO
        ReadKV (pool, r, m)
      END
    ELSE
      RSkip (r, ct)
    END
  END ;
  RETURN m
END ReadMeta ;

PROCEDURE ReadKV (VAR pool: POOL ; VAR r: Rd ; VAR m: Meta)
  RAISES Faults.BadArg, Overflow, ValueRange, IndexError =
VAR last, id, ct : I64 ;
BEGIN
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 1 AND ct = CtBinary THEN
      m.kvKeys[m.nkv] := RStr (pool, r)
    ELSIF id = 2 AND ct = CtBinary THEN
      m.kvVals[m.nkv] := RStr (pool, r)
    ELSE
      RSkip (r, ct)
    END
  END ;
  IF m.nkv < LEN (m.kvKeys) - 1 THEN
    m.nkv := m.nkv + 1
  END
END ReadKV ;

PROCEDURE ReadRowGroup (VAR r: Rd ; VAR m: Meta ; g: I64)
  RAISES Faults.BadArg, Overflow, IndexError =
VAR
  last, id, ct, hdr, n, c : I64 ;
BEGIN
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 1 AND ct = CtList THEN
      hdr := R8 (r) ;
      n := hdr DIV 16 ;
      IF n = 15 THEN n := RVar (r) END ;
      IF n # m.ncols THEN RAISE Faults.BadArg ('column count mismatch') END ;
      FOR c := 0 TO n - 1 DO
        ReadChunk (r, m, g * m.ncols + c)
      END
    ELSE
      RSkip (r, ct)
    END
  END
END ReadRowGroup ;

PROCEDURE ReadChunk (VAR r: Rd ; VAR m: Meta ; k: I64)
  RAISES Faults.BadArg, Overflow, IndexError =
VAR
  last, id, ct, last2, id2, ct2 : I64 ;
BEGIN
  m.chunks[k].codec := CodecNone ;
  m.chunks[k].nvals := 0 ;
  m.chunks[k].off := 0 ;
  m.chunks[k].dictOff := -1 ;
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 3 AND ct = CtStruct THEN
      last2 := 0 ;
      WHILE RField (r, last2, id2, ct2) DO
        IF id2 = 4 AND ct2 = CtI32 THEN
          m.chunks[k].codec := RZig (r)
        ELSIF id2 = 5 AND ct2 = CtI64 THEN
          m.chunks[k].nvals := RZig (r)
        ELSIF id2 = 9 AND ct2 = CtI64 THEN
          m.chunks[k].off := RZig (r)
        ELSIF id2 = 11 AND ct2 = CtI64 THEN
          m.chunks[k].dictOff := RZig (r)
        ELSE
          RSkip (r, ct2)
        END
      END
    ELSE
      RSkip (r, ct)
    END
  END
END ReadChunk ;

PROCEDURE CodecName (c: I64) : STR =
BEGIN
  IF c = 3 THEN RETURN 'codec 3 (lzo)' END ;
  IF c = 4 THEN RETURN 'codec 4 (brotli)' END ;
  IF c = 5 THEN RETURN 'codec 5 (lz4, the Hadoop framing)' END ;
  IF c = 7 THEN RETURN 'codec 7 (lz4_raw)' END ;
  RETURN 'an unknown codec'
END CodecName ;

PROCEDURE EncName (e: I64) : STR =
BEGIN
  IF e = EncBitPacked THEN RETURN 'encoding 4 (BIT_PACKED)' END ;
  IF e = 5 THEN RETURN 'encoding 5 (DELTA_BINARY_PACKED)' END ;
  IF e = 6 THEN RETURN 'encoding 6 (DELTA_LENGTH_BYTE_ARRAY)' END ;
  IF e = 7 THEN RETURN 'encoding 7 (DELTA_BYTE_ARRAY)' END ;
  IF e = 9 THEN RETURN 'encoding 9 (BYTE_STREAM_SPLIT)' END ;
  RETURN 'an unknown encoding'
END EncName ;

(* ---- the bytes a page holds ---- *)

PROCEDURE LEb (RO b: SLICE OF BYTE ; at, k: I64) : I64
  RAISES IndexError =
  (* k little-endian bytes from b[at], unsigned; the caller has held
     at + k to LEN (b) *)
VAR i, v, m : I64 ;
BEGIN
  v := 0 ;
  m := 1 ;
  FOR i := 0 TO k - 1 DO
    v := v + I64 (b[at + i]) * m ;
    m := m * 256
  END ;
  RETURN v
END LEb ;

PROCEDURE Need (RO b: SLICE OF BYTE ; at, k: I64) RAISES Faults.BadArg =
BEGIN
  IF k < 0 OR at < 0 OR at + k > LEN (b) THEN
    RAISE Faults.BadArg ('truncated page')
  END
END Need ;

PROCEDURE PageBytes (VAR pool: POOL ; codec: I64 ; RO body: SLICE OF BYTE ;
                     size: I64) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* a COMPRESSED page's bytes as they were before the codec, held to
     the size its header says; an uncompressed page the caller takes
     as it is *)
VAR out : SLICE OF BYTE ;
BEGIN
  IF codec = CodecSnappy THEN
    out := SnappyDecode (pool, body)
  ELSIF codec = CodecGzip THEN
    out := GunzipQ (pool, body)
  ELSIF codec = CodecZstd THEN
    out := ZstdDecode (pool, body, size)
  ELSE
    RAISE Faults.BadArg (CodecName (codec))
  END ;
  IF LEN (out) # size THEN
    RAISE Faults.BadArg ('a page whose bytes are not the size its header says')
  END ;
  RETURN out
END PageBytes ;

PROCEDURE GunzipQ (VAR pool: POOL ; RO body: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange =
BEGIN
  RETURN Zip.GunzipBytes (pool, body)
EXCEPT
| Zip.Error (msg) : RAISE Faults.BadArg ('a gzip page: ' + msg)
END GunzipQ ;

PROCEDURE ZstdDecode (VAR pool: POOL ; RO body: SLICE OF BYTE ; size: I64)
  : SLICE OF BYTE
  RAISES Faults.BadArg =
VAR
  out : SLICE OF BYTE ;
  got : I64 ;
BEGIN
  IF size < 0 THEN RAISE Faults.BadArg ('a page without its size') END ;
  out := NEW (pool, BYTE, size) ;
  got := I64 (ZstdDecompress (ADR (out), C.SizeT (size), ADR (body), C.SizeT (LEN (body)))) ;
  IF got # size THEN RAISE Faults.BadArg ('a damaged zstd page') END ;
  RETURN out
EXCEPT
| ValueRange : RAISE Faults.BadArg ('a damaged zstd page')
END ZstdDecode ;

PROCEDURE ZstdEncode (VAR pool: POOL ; RO d: SLICE OF BYTE) : SLICE OF BYTE
  RAISES Faults.BadArg =
VAR
  out : SLICE OF BYTE ;
  cap, got : I64 ;
BEGIN
  cap := I64 (ZstdBound (C.SizeT (LEN (d)))) ;
  out := NEW (pool, BYTE, cap) ;
  got := I64 (ZstdCompress (ADR (out), C.SizeT (cap), ADR (d), C.SizeT (LEN (d)), C.Int (3))) ;
  IF got > cap THEN RAISE Faults.BadArg ('libzstd refused a page') END ;
  RETURN SLICE (out, 0, got)
EXCEPT
| ValueRange : RAISE Faults.BadArg ('libzstd refused a page')
END ZstdEncode ;

(* ---- snappy, the raw format (no framing): what Parquet's SNAPPY is.
   An uncompressed length as a varint, then elements: a LITERAL (the
   tag's two low bits 0; a length up to 60 in the tag, else in the 1
   to 4 bytes after it) or a COPY of earlier output, by an offset of
   11, 16 or 32 bits and a length.  github.com/google/snappy,
   format_description.txt. ---- *)

PROCEDURE SnappyDecode (VAR pool: POOL ; RO s: SLICE OF BYTE)
  : SLICE OF BYTE
  RAISES Faults.BadArg, IndexError =
  (* every length and offset held to what is there: a damaged page
     is refused, never read or written past *)
VAR
  out : SLICE OF BYTE ;
  at, n, m, k, o, tag, kind, len, off, i : I64 ;
BEGIN
  at := 0 ;
  n := 0 ;
  m := 1 ;
  LOOP
    IF at >= LEN (s) OR m > 34359738368 THEN RAISE Faults.BadArg (SnapBad) END ;
    k := I64 (s[at]) ;
    at := at + 1 ;
    n := n + (k MOD 128) * m ;
    IF k < 128 THEN EXIT END ;
    m := m * 128
  END ;
  out := NEW (pool, BYTE, n) ;
  o := 0 ;
  WHILE at < LEN (s) DO
    tag := I64 (s[at]) ;
    at := at + 1 ;
    kind := tag MOD 4 ;
    IF kind = 0 THEN
      len := tag DIV 4 + 1 ;
      IF len > 60 THEN
        k := len - 60 ;
        IF at + k > LEN (s) THEN RAISE Faults.BadArg (SnapBad) END ;
        len := LEb (s, at, k) + 1 ;
        at := at + k
      END ;
      IF at + len > LEN (s) OR o + len > n THEN RAISE Faults.BadArg (SnapBad) END ;
      FOR i := 0 TO len - 1 DO
        out[o + i] := s[at + i]
      END ;
      at := at + len ;
      o := o + len
    ELSE
      IF kind = 1 THEN
        IF at + 1 > LEN (s) THEN RAISE Faults.BadArg (SnapBad) END ;
        len := (tag DIV 4) MOD 8 + 4 ;
        off := (tag DIV 32) * 256 + I64 (s[at]) ;
        at := at + 1
      ELSIF kind = 2 THEN
        IF at + 2 > LEN (s) THEN RAISE Faults.BadArg (SnapBad) END ;
        len := tag DIV 4 + 1 ;
        off := LEb (s, at, 2) ;
        at := at + 2
      ELSE
        IF at + 4 > LEN (s) THEN RAISE Faults.BadArg (SnapBad) END ;
        len := tag DIV 4 + 1 ;
        off := LEb (s, at, 4) ;
        at := at + 4
      END ;
      IF off = 0 OR off > o OR o + len > n THEN RAISE Faults.BadArg (SnapBad) END ;
      (* forward, a byte at a time: a copy may overlap its own output *)
      FOR i := 0 TO len - 1 DO
        out[o + i] := out[o - off + i]
      END ;
      o := o + len
    END
  END ;
  IF o # n THEN RAISE Faults.BadArg (SnapBad) END ;
  RETURN out
END SnappyDecode ;

(* ---- the RLE / bit-packed hybrid: definition levels, dictionary
   indices and RLE booleans.  A run is a varint header: even, an RLE
   run of header/2 copies of one value in (width + 7) DIV 8 bytes;
   odd, header/2 groups of eight values bit-packed, LSB first. ---- *)

PROCEDURE HVar (RO b: SLICE OF BYTE ; VAR at: I64 ; end: I64) : I64
  RAISES Faults.BadArg, IndexError =
VAR v, m, k : I64 ;
BEGIN
  v := 0 ;
  m := 1 ;
  LOOP
    IF at >= end OR m > 34359738368 THEN RAISE Faults.BadArg (RunBad) END ;
    k := I64 (b[at]) ;
    at := at + 1 ;
    v := v + (k MOD 128) * m ;
    IF k < 128 THEN EXIT END ;
    m := m * 128
  END ;
  RETURN v
END HVar ;

PROCEDURE Hybrid (VAR pool: POOL ; RO b: SLICE OF BYTE ; VAR at: I64 ;
                  end, width, n: I64) : SLICE OF I64
  RAISES Faults.BadArg, IndexError =
  (* n values of width bits from b[at], not past b[end]; at is left
     after the last byte read *)
VAR
  v : SLICE OF I64 ;
  got, hdr, cnt, groups, x, i, nb, top, acc, have, mul : I64 ;
BEGIN
  IF width < 0 OR width > 32 THEN RAISE Faults.BadArg ('a bit width beyond 32') END ;
  IF end > LEN (b) THEN RAISE Faults.BadArg (RunBad) END ;
  v := NEW (pool, I64, n) ;
  top := 1 ;
  FOR i := 1 TO width DO top := top * 2 END ;
  nb := (width + 7) DIV 8 ;
  got := 0 ;
  WHILE got < n DO
    hdr := HVar (b, at, end) ;
    IF hdr < 2 THEN RAISE Faults.BadArg (RunBad) END ;   (* an empty run *)
    IF hdr MOD 2 = 0 THEN
      cnt := hdr DIV 2 ;
      IF at + nb > end THEN RAISE Faults.BadArg (RunBad) END ;
      x := LEb (b, at, nb) ;
      at := at + nb ;
      IF x >= top THEN RAISE Faults.BadArg (RunBad) END ;
      FOR i := 1 TO cnt DO
        IF got < n THEN
          v[got] := x ;
          got := got + 1
        END
      END
    ELSE
      groups := hdr DIV 2 ;
      IF groups > (end - at) THEN RAISE Faults.BadArg (RunBad) END ;
      IF at + groups * width > end THEN RAISE Faults.BadArg (RunBad) END ;
      acc := 0 ;
      have := 0 ;
      mul := 1 ;            (* 2 ** have *)
      FOR i := 1 TO groups * 8 DO
        WHILE have < width DO
          acc := acc + I64 (b[at]) * mul ;
          at := at + 1 ;
          mul := mul * 256 ;
          have := have + 8
        END ;
        x := acc MOD top ;
        acc := acc DIV top ;
        mul := mul DIV top ;
        have := have - width ;
        IF got < n THEN
          v[got] := x ;
          got := got + 1
        END
      END
    END
  END ;
  RETURN v
END Hybrid ;

(* ---- one column's values, gathered over its chunks and pages ---- *)

TYPE
  Sink = RECORD
    kind : I64 ;           (* SkF64 .. SkStr *)
    f64 : SLICE OF F64 ;
    f32 : SLICE OF F32 ;
    i64 : SLICE OF I64 ;
    i32 : SLICE OF I32 ;
    i16 : SLICE OF I16 ;
    by : SLICE OF BYTE ;
    bo : SLICE OF BOOL ;
    s : SLICE OF STR ;
    n : I64 ;              (* rows *)
    at : I64 ;             (* the next row *)
  END ;

PROCEDURE NewSink (VAR pool: POOL ; RO ci: ColInfo ; rows: I64) : Sink
  RAISES Faults.BadArg =
VAR k : Sink ;
BEGIN
  k.n := rows ;
  k.at := 0 ;
  IF ci.phys = PtDouble THEN
    k.kind := SkF64 ;
    k.f64 := NEW (pool, F64, rows)
  ELSIF ci.phys = PtFloat THEN
    k.kind := SkF32 ;
    k.f32 := NEW (pool, F32, rows)
  ELSIF ci.phys = PtInt64 THEN
    k.kind := SkI64 ;
    k.i64 := NEW (pool, I64, rows)
  ELSIF ci.phys = PtInt32 AND ci.conv = CvInt16 THEN
    k.kind := SkI16 ;
    k.i16 := NEW (pool, I16, rows)
  ELSIF ci.phys = PtInt32 AND ci.conv = CvUint8 THEN
    k.kind := SkByte ;
    k.by := NEW (pool, BYTE, rows)
  ELSIF ci.phys = PtInt32 THEN
    k.kind := SkI32 ;
    k.i32 := NEW (pool, I32, rows)
  ELSIF ci.phys = PtBoolean THEN
    k.kind := SkBool ;
    k.bo := NEW (pool, BOOL, rows)
  ELSIF ci.phys = PtByteArray THEN
    k.kind := SkStr ;
    k.s := NEW (pool, STR, rows)
  ELSE
    RAISE Faults.BadArg ('physical type unsupported: ' + ci.name)
  END ;
  RETURN k
END NewSink ;

PROCEDURE Room1 (VAR k: Sink) RAISES Faults.BadArg =
BEGIN
  IF k.at >= k.n THEN
    RAISE Faults.BadArg ('a column with more values than the file has rows')
  END
END Room1 ;

PROCEDURE Put (VAR pool: POOL ; VAR k: Sink ; RO b: SLICE OF BYTE ;
               VAR p: I64)
  RAISES Faults.BadArg, ValueRange, IndexError =
  (* one PLAIN value from b[p] into the next row; p moves past it *)
VAR x, lo, hi, n : I64 ;
BEGIN
  Room1 (k) ;
  IF k.kind = SkF64 THEN
    Need (b, p, 8) ;
    k.f64[k.at] := F64.FromBytesLE (SLICE (b, p, 8)) ;
    p := p + 8
  ELSIF k.kind = SkF32 THEN
    Need (b, p, 4) ;
    k.f32[k.at] := F32.FromBytesLE (SLICE (b, p, 4)) ;
    p := p + 4
  ELSIF k.kind = SkI64 THEN
    Need (b, p, 8) ;
    lo := LEb (b, p, 4) ;
    hi := LEb (b, p + 4, 4) ;
    IF hi >= 2147483648 THEN
      k.i64[k.at] := (hi - 4294967296) * 4294967296 + lo
    ELSE
      k.i64[k.at] := hi * 4294967296 + lo
    END ;
    p := p + 8
  ELSIF k.kind = SkStr THEN
    Need (b, p, 4) ;
    n := LEb (b, p, 4) ;
    p := p + 4 ;
    Need (b, p, n) ;
    k.s[k.at] := DynStr.FromUtf8 (pool, SLICE (b, p, n)) ;
    p := p + n
  ELSIF k.kind = SkBool THEN
    RAISE Faults.BadArg ('a boolean from a dictionary')
  ELSE
    Need (b, p, 4) ;
    x := LEb (b, p, 4) ;
    p := p + 4 ;
    IF k.kind = SkByte THEN
      k.by[k.at] := BYTE (x)
    ELSE
      IF x >= 2147483648 THEN x := x - 4294967296 END ;
      IF k.kind = SkI16 THEN
        k.i16[k.at] := I16 (x)
      ELSE
        k.i32[k.at] := I32 (x)
      END
    END
  END ;
  k.at := k.at + 1
END Put ;

PROCEDURE PutBool (VAR k: Sink ; x: BOOL) RAISES Faults.BadArg =
BEGIN
  Room1 (k) ;
  k.bo[k.at] := x ;
  k.at := k.at + 1
END PutBool ;

PROCEDURE PutMissing (VAR k: Sink ; RO name: STR) RAISES Faults.BadArg =
  (* a null: the arm's own missing value, as CSV import gives an
     empty field *)
BEGIN
  Room1 (k) ;
  IF k.kind = SkF64 THEN
    k.f64[k.at] := NaN
  ELSIF k.kind = SkF32 THEN
    k.f32[k.at] := NaN
  ELSIF k.kind = SkI64 THEN
    k.i64[k.at] := -9223372036854775807 - 1
  ELSIF k.kind = SkI32 THEN
    k.i32[k.at] := -2147483647 - 1
  ELSIF k.kind = SkI16 THEN
    k.i16[k.at] := -32768
  ELSIF k.kind = SkByte THEN
    k.by[k.at] := 255
  ELSIF k.kind = SkStr THEN
    k.s[k.at] := ''
  ELSE
    (* a boolean has no missing value to substitute *)
    RAISE Faults.BadArg (name)
  END ;
  k.at := k.at + 1
END PutMissing ;

PROCEDURE DictPos (VAR pool: POOL ; RO d: SLICE OF BYTE ; RO ci: ColInfo ;
                   n: I64) : SLICE OF I64
  RAISES Faults.BadArg, IndexError =
  (* where each of a PLAIN dictionary's n entries begins *)
VAR
  pos : SLICE OF I64 ;
  i, p, w : I64 ;
BEGIN
  IF n < 0 THEN RAISE Faults.BadArg ('a dictionary of fewer than no entries') END ;
  pos := NEW (pool, I64, n) ;
  w := 0 ;
  IF ci.phys = PtDouble OR ci.phys = PtInt64 THEN
    w := 8
  ELSIF ci.phys = PtFloat OR ci.phys = PtInt32 THEN
    w := 4
  ELSIF ci.phys # PtByteArray THEN
    RAISE Faults.BadArg ('a dictionary of booleans: ' + ci.name)
  END ;
  p := 0 ;
  FOR i := 0 TO n - 1 DO
    pos[i] := p ;
    IF w > 0 THEN
      p := p + w
    ELSE
      Need (d, p, 4) ;
      p := p + 4 + LEb (d, p, 4)
    END
  END ;
  Need (d, 0, p) ;
  RETURN pos
END DictPos ;

PROCEDURE ReadDph (VAR r: Rd ; VAR nvals, enc: I64)
  RAISES Faults.BadArg, Overflow =
  (* a DataPageHeader or a DictionaryPageHeader: both say num_values
     as field 1 and the encoding as field 2 *)
VAR last, id, ct : I64 ;
BEGIN
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 1 AND ct = CtI32 THEN
      nvals := RZig (r)
    ELSIF id = 2 AND ct = CtI32 THEN
      enc := RZig (r)
    ELSE
      RSkip (r, ct)
    END
  END
END ReadDph ;

PROCEDURE ReadDph2 (VAR r: Rd ; VAR nvals, enc, defLen, repLen: I64 ;
                    VAR packed: BOOL)
  RAISES Faults.BadArg, Overflow =
  (* a DataPageHeaderV2: the levels' lengths are said here, because
     the levels are stored uncompressed ahead of the values *)
VAR last, id, ct : I64 ;
BEGIN
  last := 0 ;
  WHILE RField (r, last, id, ct) DO
    IF id = 1 AND ct = CtI32 THEN
      nvals := RZig (r)
    ELSIF id = 4 AND ct = CtI32 THEN
      enc := RZig (r)
    ELSIF id = 5 AND ct = CtI32 THEN
      defLen := RZig (r)
    ELSIF id = 6 AND ct = CtI32 THEN
      repLen := RZig (r)
    ELSIF id = 7 AND (ct = CtTrue OR ct = CtFalse) THEN
      packed := ct = CtTrue
    ELSE
      RSkip (r, ct)
    END
  END
END ReadDph2 ;

PROCEDURE ReadColumn (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                      RO whole: SLICE OF BYTE ; RO m: Meta ; c: I64)
  RAISES Faults.BadArg, Overflow, ValueRange, IndexError =
  (* column c over every row group: in each chunk an optional
     dictionary page, then data pages (version 1 or 2) until the
     chunk's values are all read.  A value is PLAIN or an index into
     the dictionary (RLE_DICTIONARY, and PLAIN_DICTIONARY, its old
     name); a boolean is PLAIN or RLE.  A null is the arm's missing
     value.  Any other encoding or codec is refused by name. *)
VAR
  ci : ColInfo ;
  ch : Chunk ;
  k : Sink ;
  r : Rd ;
  g, got, last, id, ct, ptype, uncomp, comp, nv, enc, defLen, repLen : I64 ;
  p, q, i, j, w, np, bacc, bleft : I64 ;
  packed, haveDict : BOOL ;
  body, data, dict : SLICE OF BYTE ;
  dpos, lv, idx : SLICE OF I64 ;
  present : SLICE OF BOOL ;
BEGIN
  ci := m.cols[c] ;
  k := NewSink (pool, ci, m.rows) ;
  dict := NEW (pool, BYTE, 0) ;
  dpos := NEW (pool, I64, 0) ;
  FOR g := 0 TO m.ngroups - 1 DO
    ch := m.chunks[g * m.ncols + c] ;
    r.b := whole ;
    r.at := ch.off ;
    IF ch.dictOff >= 4 AND ch.dictOff < ch.off THEN r.at := ch.dictOff END ;
    haveDict := FALSE ;
    got := 0 ;
    WHILE got < ch.nvals DO
      ptype := -1 ;
      uncomp := -1 ;
      comp := -1 ;
      nv := -1 ;
      enc := -1 ;
      defLen := 0 ;
      repLen := 0 ;
      packed := TRUE ;
      last := 0 ;
      WHILE RField (r, last, id, ct) DO
        IF id = 1 AND ct = CtI32 THEN
          ptype := RZig (r)
        ELSIF id = 2 AND ct = CtI32 THEN
          uncomp := RZig (r)
        ELSIF id = 3 AND ct = CtI32 THEN
          comp := RZig (r)
        ELSIF (id = 5 OR id = 7) AND ct = CtStruct THEN
          ReadDph (r, nv, enc)
        ELSIF id = 8 AND ct = CtStruct THEN
          ReadDph2 (r, nv, enc, defLen, repLen, packed)
        ELSE
          RSkip (r, ct)
        END
      END ;
      Need (whole, r.at, comp) ;
      IF uncomp < 0 THEN RAISE Faults.BadArg ('a page without its size') END ;
      body := SLICE (whole, r.at, comp) ;
      r.at := r.at + comp ;

      IF ptype = PgDict THEN
        IF enc # EncPlain AND enc # EncPlainDict THEN
          RAISE Faults.BadArg ('a dictionary page that is not PLAIN')
        END ;
        IF ch.codec = CodecNone THEN
          dict := body
        ELSE
          dict := PageBytes (pool, ch.codec, body, uncomp)
        END ;
        dpos := DictPos (pool, dict, ci, nv) ;
        haveDict := TRUE

      ELSIF ptype = PgData OR ptype = PgDataV2 THEN
        IF nv < 0 THEN RAISE Faults.BadArg ('a data page without its count') END ;
        lv := NEW (pool, I64, 0) ;
        IF ptype = PgData THEN
          IF ch.codec = CodecNone THEN
            data := body
          ELSE
            data := PageBytes (pool, ch.codec, body, uncomp)
          END ;
          p := 0 ;
          IF ci.optional THEN
            Need (data, 0, 4) ;
            w := LEb (data, 0, 4) ;
            Need (data, 4, w) ;
            q := 4 ;
            lv := Hybrid (pool, data, q, 4 + w, 1, nv) ;
            p := 4 + w
          END
        ELSE
          IF repLen # 0 THEN RAISE Faults.BadArg ('repetition levels (nested data)') END ;
          IF defLen < 0 OR defLen > comp OR uncomp < defLen THEN
            RAISE Faults.BadArg ('truncated page')
          END ;
          IF ci.optional THEN
            q := 0 ;
            lv := Hybrid (pool, body, q, defLen, 1, nv)
          END ;
          IF packed AND ch.codec # CodecNone THEN
            data := PageBytes (pool, ch.codec, SLICE (body, defLen, comp - defLen),
                               uncomp - defLen)
          ELSE
            data := SLICE (body, defLen, comp - defLen)
          END ;
          p := 0
        END ;
        present := NEW (pool, BOOL, nv) ;
        np := 0 ;
        FOR i := 0 TO nv - 1 DO
          present[i] := NOT ci.optional OR lv[i] = 1 ;
          IF present[i] THEN np := np + 1 END
        END ;

        IF enc = EncPlain AND ci.phys = PtBoolean THEN
          bacc := 0 ;
          bleft := 0 ;
          FOR i := 0 TO nv - 1 DO
            IF present[i] THEN
              IF bleft = 0 THEN
                Need (data, p, 1) ;
                bacc := I64 (data[p]) ;
                p := p + 1 ;
                bleft := 8
              END ;
              PutBool (k, bacc MOD 2 = 1) ;
              bacc := bacc DIV 2 ;
              bleft := bleft - 1
            ELSE
              PutMissing (k, ci.name)
            END
          END
        ELSIF enc = EncPlain THEN
          FOR i := 0 TO nv - 1 DO
            IF present[i] THEN
              Put (pool, k, data, p)
            ELSE
              PutMissing (k, ci.name)
            END
          END
        ELSIF enc = EncRleDict OR enc = EncPlainDict THEN
          IF NOT haveDict THEN
            RAISE Faults.BadArg ('a dictionary-encoded page without its dictionary')
          END ;
          idx := NEW (pool, I64, 0) ;
          IF np > 0 THEN
            Need (data, p, 1) ;
            w := I64 (data[p]) ;
            p := p + 1 ;
            idx := Hybrid (pool, data, p, LEN (data), w, np)
          END ;
          j := 0 ;
          FOR i := 0 TO nv - 1 DO
            IF present[i] THEN
              IF idx[j] >= LEN (dpos) THEN
                RAISE Faults.BadArg ('a dictionary index beyond the dictionary')
              END ;
              q := dpos[idx[j]] ;
              Put (pool, k, dict, q) ;
              j := j + 1
            ELSE
              PutMissing (k, ci.name)
            END
          END
        ELSIF enc = EncRle AND ci.phys = PtBoolean THEN
          (* RLE booleans carry their length, as v1 levels do *)
          Need (data, p, 4) ;
          w := LEb (data, p, 4) ;
          Need (data, p + 4, w) ;
          q := p + 4 ;
          idx := Hybrid (pool, data, q, p + 4 + w, 1, np) ;
          j := 0 ;
          FOR i := 0 TO nv - 1 DO
            IF present[i] THEN
              PutBool (k, idx[j] = 1) ;
              j := j + 1
            ELSE
              PutMissing (k, ci.name)
            END
          END
        ELSE
          RAISE Faults.BadArg (EncName (enc) + ' in column ' + ci.name)
        END ;
        got := got + nv

      ELSIF ptype # PgIndex THEN
        RAISE Faults.BadArg ('page type unsupported')
      END
    END
  END ;
  IF k.at # m.rows THEN
    RAISE Faults.BadArg ('column ' + ci.name + ' holds another number of values than the file has rows')
  END ;
  AddSink (pool, f, ci.name, k)
END ReadColumn ;

PROCEDURE AddSink (VAR pool: POOL ; VAR f: PTR Frame.Fr ; RO name: STR ;
                   KEPT k: Sink)
  RAISES Faults.BadArg =
BEGIN
  IF k.kind = SkF64 THEN
    AddF64Q (pool, f, name, k.f64)
  ELSIF k.kind = SkF32 THEN
    AddF32Q (pool, f, name, k.f32)
  ELSIF k.kind = SkI64 THEN
    AddI64Q (pool, f, name, k.i64)
  ELSIF k.kind = SkI32 THEN
    AddI32Q (pool, f, name, k.i32)
  ELSIF k.kind = SkI16 THEN
    AddI16Q (pool, f, name, k.i16)
  ELSIF k.kind = SkByte THEN
    AddBytesQ (pool, f, name, k.by)
  ELSIF k.kind = SkBool THEN
    AddBoolsQ (pool, f, name, k.bo)
  ELSE
    AddStrsQ (pool, f, name, k.s)
  END
END AddSink ;

(* Add* with Frame's refusals converted: the caller of Read wants
   Parquet's exceptions, not Frame's internals *)
PROCEDURE AddF64Q (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                   RO name: STR ; KEPT v: SLICE OF F64)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddF64 (pool, f, name, v, NaN)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddF64Q ;

PROCEDURE AddF32Q (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                   RO name: STR ; KEPT v: SLICE OF F32)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddF32 (pool, f, name, v, NaN)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddF32Q ;

PROCEDURE AddI64Q (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                   RO name: STR ; KEPT v: SLICE OF I64)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddI64 (pool, f, name, v, -9223372036854775807 - 1)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddI64Q ;

PROCEDURE AddI32Q (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                   RO name: STR ; KEPT v: SLICE OF I32)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddI32 (pool, f, name, v, -2147483647 - 1)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddI32Q ;

PROCEDURE AddI16Q (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                   RO name: STR ; KEPT v: SLICE OF I16)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddI16 (pool, f, name, v, -32768)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddI16Q ;

PROCEDURE AddBytesQ (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                     RO name: STR ; KEPT v: SLICE OF BYTE)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddBytes (pool, f, name, v, 255)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddBytesQ ;

PROCEDURE AddBoolsQ (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                     RO name: STR ; KEPT v: SLICE OF BOOL)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddBools (pool, f, name, v)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddBoolsQ ;

PROCEDURE AddStrsQ (VAR pool: POOL ; VAR f: PTR Frame.Fr ;
                    RO name: STR ; KEPT v: SLICE OF STR)
  RAISES Faults.BadArg =
BEGIN
  Frame.AddStrs (pool, f, name, v)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('column length mismatch')
| Frame.Duplicate : RAISE Faults.BadArg (name)
END AddStrsQ ;

PROCEDURE BytesX (VAR pool: POOL ; f: PTR Frame.Fr ;
                  RO kvK: SLICE OF STR ; RO kvV: SLICE OF STR ;
                  RO nsCols: SLICE OF STR) : SLICE OF BYTE
  RAISES Faults.BadArg, ValueRange, Overflow, IndexError =
VAR o : Options ;
BEGIN
  o.kvK := kvK ;
  o.kvV := kvV ;
  o.nsCols := nsCols ;
  RETURN AnyBytes (pool, f, FALSE, NIL9 (pool), o)
END BytesX ;

PROCEDURE Read (VAR pool: POOL ; RO path: STR) : PTR Frame.Fr
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
VAR
  whole : SLICE OF BYTE ;
  m : Meta ;
  f : PTR Frame.Fr IN pool ;
  c : I64 ;
BEGIN
  whole := Io.ReadFileBytes (pool, path) ;
  m := ReadMeta (pool, whole) ;
  f := NewQ (pool, m.rows) ;
  FOR c := 0 TO m.ncols - 1 DO
    ReadColumn (pool, f, whole, m, c)
  END ;
  RETURN f
END Read ;

PROCEDURE NewQ (VAR pool: POOL ; rows: I64) : PTR Frame.Fr
  RAISES Faults.BadArg =
BEGIN
  RETURN Frame.New (pool, rows)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('negative row count')
END NewQ ;

PROCEDURE TsRead (VAR pool: POOL ; RO path: STR) : PTR Frame.Ts
  RAISES Io.IOError, Faults.BadArg, ValueRange, Overflow, IndexError =
VAR
  whole : SLICE OF BYTE ;
  m : Meta ;
  f, ft : PTR Frame.Fr IN pool ;
  c, i, res, g, r : I64 ;
  tsec : SLICE OF I64 ;
  conv : Frame.Conv ;
  descr : STR ;
BEGIN
  whole := Io.ReadFileBytes (pool, path) ;
  m := ReadMeta (pool, whole) ;
  f := NewQ (pool, m.rows) ;
  ft := NewQ (pool, m.rows) ;
  tsec := NEW (pool, I64, 0) ;
  FOR c := 0 TO m.ncols - 1 DO
    IF EqS (m.cols[c].name, 'time') THEN
      (* the axis is the Ts record's, not a data column: read it
         into a frame of its own and take the slice *)
      ReadColumn (pool, ft, whole, m, c) ;
      tsec := ColI64Q (ft, 'time')
    ELSE
      ReadColumn (pool, f, whole, m, c)
    END
  END ;
  IF LEN (tsec) = 0 THEN RAISE Faults.BadArg ('no time column') END ;
  conv := Frame.ConvStart () ;
  res := 0 ;
  descr := '' ;
  FOR i := 0 TO m.nkv - 1 DO
    IF EqS (m.kvKeys[i], 'frame_resolution_seconds') THEN
      res := TextI64 (m.kvVals[i])
    ELSIF EqS (m.kvKeys[i], 'frame_time_convention') THEN
      IF EqS (m.kvVals[i], 'end') THEN
        conv := Frame.ConvEnd ()
      ELSIF EqS (m.kvVals[i], 'mid') THEN
        conv := Frame.ConvMid ()
      END
    ELSIF EqS (m.kvKeys[i], 'description') THEN
      descr := m.kvVals[i]
    END
  END ;
  IF res = 0 THEN
    (* a foreign file: the smallest gap, the stated default *)
    FOR r := 1 TO m.rows - 1 DO
      g := tsec[r] - tsec[r - 1] ;
      IF g > 0 AND (res = 0 OR g < res) THEN res := g END
    END ;
    IF res = 0 THEN res := 1 END
  END ;
  RETURN NewTsQ (pool, f, tsec, res, conv, descr)
END TsRead ;

PROCEDURE NewTsQ (VAR pool: POOL ; KEPT f: PTR Frame.Fr ;
                  KEPT t: SLICE OF I64 ; res: I64 ; conv: Frame.Conv ;
                  RO descr: STR) : PTR Frame.Ts
  RAISES Faults.BadArg =
BEGIN
  RETURN Frame.NewTs (pool, f, t, res, conv, descr)
EXCEPT
| Faults.SizeError : RAISE Faults.BadArg ('time length mismatch')
| Frame.Disorder : RAISE Faults.BadArg ('time axis disorder')
| Faults.BadArg : RAISE Faults.BadArg ('bad resolution')
END NewTsQ ;

PROCEDURE ColI64Q (f: PTR Frame.Fr ; RO name: STR) : SLICE OF I64
  RAISES Faults.BadArg =
BEGIN
  RETURN Frame.ColI64 (f, name)
EXCEPT
| Frame.Unknown : RAISE Faults.BadArg (name)
| Frame.WrongType : RAISE Faults.BadArg ('time is not int64')
END ColI64Q ;

PROCEDURE EqS (RO a, b: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF a[i] # b[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END EqS ;

PROCEDURE TextI64 (RO s: STR) : I64 RAISES Faults.BadArg, Overflow =
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  IF LEN (s) = 0 THEN RAISE Faults.BadArg ('empty number') END ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] < '0' OR s[i] > '9' THEN RAISE Faults.BadArg (s) END ;
    v := v * 10 + (ORD (s[i]) - 48)
  END ;
  RETURN v
END TextI64 ;

END Parquet.
