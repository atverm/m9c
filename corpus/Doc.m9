DEFINITION MODULE Doc ;

(* Doc reads the DEFINITION module as documentation.

   M9 already puts the whole contract of a module in one place, and
   the corpus already writes prose under every declaration there.
   Nothing read those comments until now: the lexer threw them away
   before a token was made, so there was nothing in the tree to
   print.  Lex.Collect is the side channel that keeps them; this is
   the client that gives them meaning.

   Doc is AN ORDINARY CLIENT, on purpose, after the OpenApi precedent.
   OpenApi describes HttpServer's routes through the public accessors
   and has no privileged access, which is what makes "the server cannot
   disagree with its documentation" a checkable claim rather than a
   promise.  The same applies here.  This module reads Ast and Lex
   through their published surfaces.  It renders signatures through
   Print, the same procedure Sem uses to decide whether two declarations
   are the same declaration.  It adds no opinion of its own about what
   M9 syntax looks like.

   THE CONVENTION IS THE INDENT, and it was measured rather than
   invented.  In a DEFINITION module:

     - an INDENTED comment belongs to the declaration above it;
     - a comment at COLUMN 1 is a section banner and belongs to
       nothing;
     - the first comment of the unit, before any declaration, is the
       module's own.

   Over the corpus that rule attaches every comment correctly.  The
   seven it declines to attach are all at column 1 and all really are
   banners: Print's `*Text` group heading, NetCDF's `---- reading
   ----`, Math's single-precision divider.  A rule that ignored the
   indent would have mis-attributed every one of them.

   A doc block is PROSE.  It may end with a blank line followed by a
   run of `name -- what it is` lines, one per parameter.  The block is
   optional, and no parameter need appear.  Every name in one must be
   a parameter of that procedure.  Doc checks this, and it is the one
   thing a caller can get wrong that this module reports as an error
   rather than as a gap.  The blank line is required because three
   comments in the corpus contain a mid-paragraph phrase of that
   shape and are not parameter blocks. *)

IMPORT Ast ;

TYPE
  (* Stats is measured, never a gate.  A threshold on documentation
     makes `(* obvious *)` a rational move, so this is reported like
     the Fmt-against-printf rate: a number every run, and the tool
     that prints it does not fail on it.

     unknownParam is the exception and is meant to be.  A `name --`
     line naming something that is not a parameter is DRIFT, not
     omission: the doc and the signature have disagreed.  That is the
     asymmetry mandiff already enforces between --help and the manual
     page. *)
  Stats = RECORD
    mods, modsDoc : I64 ;          (* definition units, and documented *)
    procs, procsDoc : I64 ;        (* exported procedures, likewise *)
    others, othersDoc : I64 ;      (* types, consts, exceptions *)
    params, paramsDoc : I64 ;      (* named parameters, and explained *)
    banners : I64 ;                (* column-1 comments, owned by nobody *)
    unattached : I64 ;             (* indented, but nothing above it *)
    unknownParam : I64 ;           (* a `name --` naming no parameter *)
  END ;

PROCEDURE Json (VAR pool: POOL ; root: PTR Ast.Node ; RO modName: UTF ;
                VAR st: Stats) : UTF
  RAISES IndexError ;
  (* Json answers the same declarations as DATA.  The answer is one
     object: "module", "doc" (the module's own comment, or null), and
     "declarations".  For every exported name "declarations" gives
     its "kind" (procedure, type, const, var, exception), "name",
     "line" and "doc".  For a procedure it also gives the rendered
     "signature", the "params" as a list of {names, mode, type} with
     mode one of "", "VAR", "OWN", "RO", the "result" (null for a
     proper procedure), the "raises" list, and the "attrib" (null, or
     the bracketed word).  Every string is the one Text prints, so a
     tool that reads this and a person who reads the page are reading
     the same document.  The gather is shared and the renderers
     differ.

     It exists so that "does M.P exist, and what does it take" is a
     tool call and not a grep.  The one class of error a fluent
     generator makes most is a real name it did not look up, or a
     guessed one.  A table copied into a prompt drifts in a day
     (docs/skills-plan.md par 1, par 4). *)

PROCEDURE Text (VAR pool: POOL ; root: PTR Ast.Node ; RO modName: UTF ;
                VAR st: Stats) : UTF
  RAISES IndexError ;
  (* Text answers the Markdown reference for one file, and its
     measurements.

       root     -- the NFile node Parse.File answered, for a source
                   that was lexed with Lex.Collect ARMED.  Without
                   that there are no comments to attach and every
                   declaration reports as undocumented.  The
                   emptiness would be silent, which is why the caller
                   arms it and this cannot.
       modName  -- what to call the module in the heading.
       st       -- ACCUMULATED into, not reset, so a caller
                   documenting a whole library sums as it goes.

     Only DEFINITION units are read.  An IMPLEMENTATION comment is a
     note to whoever maintains the code, not part of the contract,
     and publishing it would be publishing the wrong thing. *)

END Doc.


IMPLEMENTATION MODULE Doc ;

IMPORT DynStr ;
IMPORT Text ;
IMPORT Print ;
IMPORT Lex ;

CONST
  MaxAnchor = 4096 ;

TYPE
  (* An Anchor is a declaration a comment can attach to. *)
  Anchor = RECORD
    line : I64 ;
    kind : I64 ;
    name : UTF ;
    sig : UTF ;                    (* rendered; empty for non-procs *)
    params : UTF ;                 (* names, space-separated *)
    doc : UTF ;
    hasDoc : BOOL ;                (* a comment of its own *)
    shared : BOOL ;                (* covered by an adjacent group *)
    (* These fields hold the same signature as DATA, rendered once
       at Collect so the JSON never re-walks the tree: the params
       array text, the result type ('' for a proper procedure), the
       raises array text, the attribute word ('' for none). *)
    paramsJson : UTF ;
    resultText : UTF ;
    raisesJson : UTF ;
    attribText : UTF ;
    deprecated : UTF ;    (* [DEPRECATED 'text']'s text, '' for none *)
  END ;

(* Doc keeps NO MODULE STATE, deliberately.  The anchor table was a
   module array in the first draft.  The FPC checker refused it with
   `module-level state requires STATEFUL on the definition`, while
   the self-hosted one said nothing.  That is how the hole in
   Sem.m9's CheckConformance was found.  Both reject it now, and the
   right answer was never STATEFUL: this module is a pure function
   from a tree to text, and the table belongs in the caller's pool
   like everything else it builds. *)

(* ---- rendering, through Print rather than beside it ---- *)

PROCEDURE Qual (k: Ast.Kid) : UTF =
VAR pool : POOL ;
    d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  IF k IS SOME q THEN
    DynStr.Append (d, q.au) ;
    IF Text.BLen (q.bu) > 0 THEN
      DynStr.AppendChar (d, '.') ;
      DynStr.Append (d, q.bu)
    END
  END ;
  RETURN DynStr.View (d)
END Qual ;

(* SigText renders name (params) : ret RAISES ... [ATTR].  It is the
   same shape Sem.SigOf builds for def/impl conformance, and for the
   same reason: the printer is what decides what a declaration says. *)
PROCEDURE SigText (VAR pool: POOL ; p: PTR Ast.Node) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, p.au) ;
  DynStr.Append (d, ' (') ;
  IF p.nkids > 0 THEN
    DynStr.Append (d, Print.ParamsTextUtf (p.kids[0]))
  END ;
  DynStr.AppendChar (d, ')') ;
  IF p.nkids > 1 THEN
    IF p.kids[1] IS SOME rt THEN
      DynStr.Append (d, ' : ') ;
      DynStr.Append (d, Print.TypeTextUtf (pool, p.kids[1]))
    END
  END ;
  IF p.nkids > 2 THEN
    IF p.kids[2] IS SOME rs THEN
      DynStr.Append (d, ' RAISES ') ;
      FOR i := 0 TO rs.nkids - 1 DO
        IF i > 0 THEN DynStr.Append (d, ', ') END ;
        DynStr.Append (d, Qual (rs.kids[i]))
      END
    END
  END ;
  (* [DEPRECATED] gets a line of its own on the page, not the
     heading *)
  IF p.nkids > 3 THEN
    IF p.kids[3] IS SOME at THEN
      IF NOT Text.Eq (at.au, 'DEPRECATED') THEN
        DynStr.Append (d, ' [') ;
        DynStr.Append (d, at.au) ;
        DynStr.AppendChar (d, ']')
      END
    END
  END ;
  RETURN DynStr.ViewIn (pool, d)
END SigText ;

(* ParamNames answers every parameter NAME, space-separated and
   space-delimited, so a membership test is a substring search for
   ' name '. *)
PROCEDURE ParamNames (VAR pool: POOL ; p: PTR Ast.Node) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i, j : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendChar (d, ' ') ;
  IF p.nkids > 0 THEN
    IF p.kids[0] IS SOME pl THEN
      FOR i := 0 TO pl.nkids - 1 DO
        IF pl.kids[i] IS SOME pm THEN
          IF pm.nkids > 0 THEN
            IF pm.kids[0] IS SOME il THEN
              FOR j := 0 TO il.nkids - 1 DO
                IF il.kids[j] IS SOME id THEN
                  DynStr.Append (d, id.au) ;
                  DynStr.AppendChar (d, ' ')
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN DynStr.ViewIn (pool, d)
END ParamNames ;

(* ---- the signature as data ---- *)

(* HexDigit reads a table, not CHR.  CHR raises ValueRange, and that
   exception would climb through every renderer into Collect, which
   the page's own path never raises.  The checker said so, which is
   the point of the checker.  Indexing raises only IndexError, already
   carried. *)
PROCEDURE HexDigit (v: I64) : CHAR RAISES IndexError =
BEGIN
  RETURN Text.CpAt ('0123456789abcdef', v)
END HexDigit ;

(* B answers the byte at offset i of u, as a number.  The scans below
   read ASCII structure (the LF, a space, a comma, letters and
   digits), where a byte IS the character. *)
PROCEDURE B (RO u: UTF ; i: I64) : I64 =
BEGIN
  RETURN I64 (Text.BAt (u, i))
END B ;

(* JsonStr appends a JSON string literal: the quotes, the two characters
   that must be escaped, and the three controls a comment can carry.
   Anything else below 0x20 cannot come out of the lexer's comment
   channel, but is escaped rather than assumed away. *)
PROCEDURE JsonStr (VAR d: PTR DynStr.DString ; RO s: UTF)
  RAISES IndexError =
VAR i, c, start : I64 ;
BEGIN
  DynStr.AppendChar (d, '"') ;
  start := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    c := B (s, i) ;
    IF c = 34 OR c = 92 OR c < 32 THEN
      (* This appends the run since the last escape, then the escape.
         A byte past 0x7F is part of a character and stays in its
         run. *)
      DynStr.Append (d, SLICE (s, start, i - start)) ;
      IF c = 34 THEN DynStr.Append (d, '\"')
      ELSIF c = 92 THEN DynStr.Append (d, '\\')
      ELSIF c = 10 THEN DynStr.Append (d, '\n')
      ELSIF c = 13 THEN DynStr.Append (d, '\r')
      ELSIF c = 9 THEN DynStr.Append (d, '\t')
      ELSE
        DynStr.Append (d, '\u00') ;
        DynStr.AppendChar (d, HexDigit (c DIV 16)) ;
        DynStr.AppendChar (d, HexDigit (c MOD 16))
      END ;
      start := i + 1
    END
  END ;
  DynStr.Append (d, SLICE (s, start, Text.BLen (s) - start)) ;
  DynStr.AppendChar (d, '"')
END JsonStr ;

(* ParamsJson answers the parameter list as
   `[{"names":[..],"mode":"VAR","type":".."}]`.  It reads the same
   nodes Print.EParams prints: f1 is VAR, f2 OWN, f3 RO, kids[0] the
   names, kids[1] the type. *)
(* FieldsJson answers an EXCEPTION's fields in the shape of
   ParamsJson's entries, the mode "" (a payload is read through a
   binder).  kids[0] is a field sequence of groups, each an
   identifier list and a type. *)
PROCEDURE FieldsJson (VAR pool: POOL ; x: PTR Ast.Node) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i, j : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendChar (d, '[') ;
  IF x.nkids > 0 THEN
    IF x.kids[0] IS SOME fs THEN
      FOR i := 0 TO fs.nkids - 1 DO
        IF fs.kids[i] IS SOME g THEN
          IF i > 0 THEN DynStr.AppendChar (d, ',') END ;
          DynStr.Append (d, '{"names":[') ;
          IF g.kids[0] IS SOME il THEN
            FOR j := 0 TO il.nkids - 1 DO
              IF il.kids[j] IS SOME id THEN
                IF j > 0 THEN DynStr.AppendChar (d, ',') END ;
                JsonStr (d, id.au)
              END
            END
          END ;
          DynStr.Append (d, '],"mode":"","type":') ;
          JsonStr (d, Print.TypeTextUtf (pool, g.kids[1])) ;
          DynStr.AppendChar (d, '}')
        END
      END
    END
  END ;
  DynStr.AppendChar (d, ']') ;
  RETURN DynStr.ViewIn (pool, d)
END FieldsJson ;

PROCEDURE ParamsJson (VAR pool: POOL ; p: PTR Ast.Node) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i, j : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendChar (d, '[') ;
  IF p.nkids > 0 THEN
    IF p.kids[0] IS SOME pl THEN
      FOR i := 0 TO pl.nkids - 1 DO
        IF pl.kids[i] IS SOME pm THEN
          IF i > 0 THEN DynStr.AppendChar (d, ',') END ;
          DynStr.Append (d, '{"names":[') ;
          IF pm.nkids > 0 THEN
            IF pm.kids[0] IS SOME il THEN
              FOR j := 0 TO il.nkids - 1 DO
                IF il.kids[j] IS SOME id THEN
                  IF j > 0 THEN DynStr.AppendChar (d, ',') END ;
                  JsonStr (d, id.au)
                END
              END
            END
          END ;
          DynStr.Append (d, '],"mode":') ;
          IF pm.f1 THEN
            DynStr.Append (d, '"VAR"')
          ELSIF pm.f2 THEN
            DynStr.Append (d, '"OWN"')
          ELSIF pm.f3 THEN
            DynStr.Append (d, '"RO"')
          ELSE
            DynStr.Append (d, '""')
          END ;
          DynStr.Append (d, ',"type":') ;
          IF pm.nkids > 1 THEN
            JsonStr (d, Print.TypeTextUtf (pool, pm.kids[1]))
          ELSE
            DynStr.Append (d, '""')
          END ;
          DynStr.AppendChar (d, '}')
        END
      END
    END
  END ;
  DynStr.AppendChar (d, ']') ;
  RETURN DynStr.ViewIn (pool, d)
END ParamsJson ;

PROCEDURE ResultText (VAR pool: POOL ; p: PTR Ast.Node) : UTF
  RAISES IndexError =
BEGIN
  IF p.nkids > 1 THEN
    IF p.kids[1] IS SOME rt THEN
      RETURN Print.TypeTextUtf (pool, p.kids[1])
    END
  END ;
  RETURN ''
END ResultText ;

PROCEDURE RaisesJson (VAR pool: POOL ; p: PTR Ast.Node) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendChar (d, '[') ;
  IF p.nkids > 2 THEN
    IF p.kids[2] IS SOME rs THEN
      FOR i := 0 TO rs.nkids - 1 DO
        IF i > 0 THEN DynStr.AppendChar (d, ',') END ;
        JsonStr (d, Qual (rs.kids[i]))
      END
    END
  END ;
  DynStr.AppendChar (d, ']') ;
  RETURN DynStr.ViewIn (pool, d)
END RaisesJson ;

PROCEDURE AttribText (p: PTR Ast.Node) : UTF RAISES IndexError =
BEGIN
  IF p.nkids > 3 THEN
    IF p.kids[3] IS SOME at THEN
      IF NOT Text.Eq (at.au, 'DEPRECATED') THEN RETURN at.au END
    END
  END ;
  RETURN ''
END AttribText ;

(* DepText answers the text of a [DEPRECATED 'text'] attribute, and ''
   for any other attribute or none (report par 3.9). *)
PROCEDURE DepText (k: Ast.Kid) : UTF =
BEGIN
  IF k IS SOME at THEN
    IF Text.Eq (at.au, 'DEPRECATED') THEN RETURN at.bu END
  END ;
  RETURN ''
END DepText ;

(* ---- anchors ---- *)

PROCEDURE IsDecl (k: I64) : BOOL =
BEGIN
  RETURN k = Ast.NProcDecl OR k = Ast.NTypeDecl OR
         k = Ast.NConstDecl OR k = Ast.NVarDecl OR k = Ast.NExcDecl
END IsDecl ;

PROCEDURE Collect (VAR pool: POOL ; KEPT n: PTR Ast.Node ;
                   VAR anch: SLICE OF Anchor ; VAR nanch: I64)
  RAISES IndexError =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NVarDecl THEN
    (* `VAR a, b : T` is ONE declaration of several names, kept in
       its identlist.  Each name gets an anchor, its type as
       resultText.  n.au is empty here, and every exported variable
       read as a nameless entry until decision 28 made one worth
       completing. *)
    IF n.nkids > 1 THEN
      IF n.kids[0] IS SOME ids THEN
        FOR i := 0 TO ids.nkids - 1 DO
          IF ids.kids[i] IS SOME id THEN
            IF nanch < LEN (anch) THEN
              anch[nanch].line := n.line ;
              anch[nanch].kind := n.kind ;
              anch[nanch].name := id.au ;
              anch[nanch].sig := '' ;
              anch[nanch].params := ' ' ;
              anch[nanch].doc := '' ;
              anch[nanch].hasDoc := FALSE ;
              anch[nanch].shared := FALSE ;
              anch[nanch].paramsJson := '[]' ;
              anch[nanch].resultText := Print.TypeTextUtf (pool, n.kids[1]) ;
              anch[nanch].raisesJson := '[]' ;
              IF n.f3 THEN                        (* VAR RO *)
                anch[nanch].attribText := 'RO'
              ELSE
                anch[nanch].attribText := ''
              END ;
              anch[nanch].deprecated := '' ;
              nanch := nanch + 1
            END
          END
        END
      END
    END ;
    RETURN
  END ;
  IF IsDecl (n.kind) AND nanch < LEN (anch) THEN
    anch[nanch].line := n.line ;
    anch[nanch].kind := n.kind ;
    anch[nanch].name := n.au ;
    anch[nanch].sig := '' ;
    anch[nanch].params := ' ' ;
    anch[nanch].doc := '' ;
    anch[nanch].hasDoc := FALSE ;
    anch[nanch].shared := FALSE ;
    anch[nanch].paramsJson := '[]' ;
    anch[nanch].resultText := '' ;
    anch[nanch].raisesJson := '[]' ;
    anch[nanch].attribText := '' ;
    anch[nanch].deprecated := '' ;
    IF n.kind = Ast.NConstDecl AND n.nkids > 1 THEN
      anch[nanch].deprecated := DepText (n.kids[1])
    END ;
    IF n.kind = Ast.NExcDecl THEN
      (* The payload goes in as a procedure's params: a handler arm
         needs the arity and the types (cp-kernel's issue 11,
         2026-10-09). *)
      anch[nanch].paramsJson := FieldsJson (pool, n)
    END ;
    IF n.kind = Ast.NProcDecl THEN
      anch[nanch].sig := SigText (pool, n) ;
      anch[nanch].params := ParamNames (pool, n) ;
      anch[nanch].paramsJson := ParamsJson (pool, n) ;
      anch[nanch].resultText := ResultText (pool, n) ;
      anch[nanch].raisesJson := RaisesJson (pool, n) ;
      anch[nanch].attribText := AttribText (n) ;
      anch[nanch].deprecated := DepText (n.kids[3])
    END ;
    nanch := nanch + 1
  END ;
  (* a VarDecl's names live in an identlist, and a procedure's body
     is not here at all in a DEFINITION unit, so a plain recursive
     walk finds exactly the declarations and nothing else *)
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME k THEN Collect (pool, k, anch, nanch) END
  END
END Collect ;

(* Owner answers the anchor a comment at `line` belongs to, or -1. *)
PROCEDURE Owner (RO anch: SLICE OF Anchor ; nanch, line: I64) : I64 =
VAR i, best : I64 ;
BEGIN
  best := -1 ;
  FOR i := 0 TO nanch - 1 DO
    IF anch[i].line <= line THEN best := i END
  END ;
  RETURN best
END Owner ;

(* ---- the comment body ---- *)

(* Body strips the delimiters and the common indent, so the prose can
   be re-flowed into Markdown without carrying M9's column 3 with
   it. *)
PROCEDURE Body (VAR pool: POOL ; RO t: UTF) : UTF =
VAR
  d : PTR DynStr.DString IN pool ;
  i, n, ind, run, col, start : I64 ;
  atLineStart, counting : BOOL ;
BEGIN
  n := Text.BLen (t) ;
  i := 0 ;
  IF n >= 2 THEN i := 2 END ;                  (* past the opener *)
  IF n >= 4 THEN n := n - 2 END ;              (* before the closer *)

  (* This finds the common indent of the CONTINUATION lines.  The
     first line begins right after the opener and has none, so it
     says nothing about the block.  A blank line says nothing either.
     The rest gives the margin the source used.  Removing it leaves
     the RELATIVE indentation, which makes a parameter block still
     look like one. *)
  ind := -1 ;
  run := 0 ;
  counting := FALSE ;
  FOR i := i TO n - 1 DO
    IF B (t, i) = 10 THEN
      counting := TRUE ;
      run := 0
    ELSIF counting THEN
      IF B (t, i) = 32 THEN
        run := run + 1
      ELSE
        IF ind < 0 OR run < ind THEN ind := run END ;
        counting := FALSE
      END
    END
  END ;
  IF ind < 0 THEN ind := 0 END ;

  d := DynStr.New (pool) ;
  i := 0 ;
  IF Text.BLen (t) >= 2 THEN i := 2 END ;
  atLineStart := FALSE ;
  col := 0 ;
  start := i ;                  (* the run not yet appended *)
  WHILE i < n DO
    IF B (t, i) = 10 THEN
      atLineStart := TRUE ;
      col := 0
    ELSIF atLineStart AND B (t, i) = 32 AND col < ind THEN
      (* drop the margin: the run before the space, not the space *)
      DynStr.Append (d, SLICE (t, start, i - start)) ;
      start := i + 1 ;
      col := col + 1
    ELSE
      atLineStart := FALSE
    END ;
    i := i + 1
  END ;
  DynStr.Append (d, SLICE (t, start, n - start)) ;
  RETURN Text.Trim (DynStr.ViewIn (pool, d))
END Body ;

(* IsIdentList asks: is everything before the ' -- ' an identifier,
   or a comma-list of them?  This separates a parameter line from a
   sentence, and it is not optional.  M9 prose uses ' -- ' as an
   em-dash constantly, so without it

       Too wide is never truncated -- it overflows the field

   reads as a parameter called `Too wide is never truncated`.  Six
   comments across the corpus did exactly that.  One of them, Plot's
   `... IS module\n state, and ...`, even produced an
   identifier-shaped `state`.  That is why the test runs on the
   block's FIRST line and rejects the whole block rather than
   skipping lines one at a time. *)
PROCEDURE IsIdentList (RO s: UTF) : BOOL =
VAR
  i, n : I64 ;
  fresh : BOOL ;
BEGIN
  n := Text.BLen (s) ;
  IF n = 0 THEN RETURN FALSE END ;
  fresh := TRUE ;
  FOR i := 0 TO n - 1 DO
    IF fresh THEN
      IF NOT ((B (s, i) >= ORD ('A') AND B (s, i) <= ORD ('Z')) OR
              (B (s, i) >= ORD ('a') AND B (s, i) <= ORD ('z'))) THEN RETURN FALSE END ;
      fresh := FALSE
    ELSIF B (s, i) = ORD (',') THEN
      fresh := TRUE
    ELSIF B (s, i) = ORD (' ') THEN
      (* A space counts only as the separator after a comma: `a, b`
         is a list and `two words` is a sentence. *)
      IF i + 1 < n THEN
        IF B (s, i - 1) # ORD (',') THEN RETURN FALSE END
      END
    ELSIF NOT ((B (s, i) >= ORD ('A') AND B (s, i) <= ORD ('Z')) OR
               (B (s, i) >= ORD ('a') AND B (s, i) <= ORD ('z')) OR
               (B (s, i) >= ORD ('0') AND B (s, i) <= ORD ('9'))) THEN
      RETURN FALSE
    END
  END ;
  RETURN NOT fresh
END IsIdentList ;

(* ParamStart finds the parameter block, if there is one: a blank
   line, then a run of lines whose first word is followed by ' -- '.
   The blank line is required, because three comments in the corpus
   contain that shape MID-PARAGRAPH and are prose, not parameter
   lists. *)
PROCEDURE IsParamLine (RO ln: UTF) : BOOL =
VAR
  t : UTF ;
  dash : I64 ;
BEGIN
  t := Text.Trim (ln) ;
  dash := Text.Find (t, ' -- ') ;
  IF dash <= 0 THEN RETURN FALSE END ;
  RETURN IsIdentList (Text.Trim (SLICE (t, 0, dash)))
END IsParamLine ;

PROCEDURE ParamStart (RO b: UTF) : I64 =
VAR
  i, lineStart, blank : I64 ;
BEGIN
  blank := -1 ;
  i := 0 ;
  lineStart := 0 ;
  WHILE i < Text.BLen (b) DO
    IF B (b, i) = 10 THEN
      (* an empty or blank line resets the candidate *)
      IF Text.BLen (Text.Trim (SLICE (b, lineStart, i - lineStart))) = 0 THEN
        blank := i + 1
      ELSIF blank >= 0 THEN
        (* This is the first non-blank line after a blank.  Is it
           `name -- ...`? *)
        IF IsParamLine (SLICE (b, lineStart, i - lineStart)) THEN
          RETURN blank
        END ;
        blank := -1
      END ;
      lineStart := i + 1
    END ;
    i := i + 1
  END ;
  IF blank >= 0 AND lineStart < Text.BLen (b) THEN
    IF IsParamLine (SLICE (b, lineStart, Text.BLen (b) - lineStart)) THEN
      RETURN blank
    END
  END ;
  RETURN -1
END ParamStart ;

(* CheckParams checks every `name` at the head of a `name -- ...`
   line in the block.

   names is the union over the GROUP, not just the owning
   declaration: a comment placed after a run of declarations
   documents all of them, so Io's

       PROCEDURE WriteLine (RO s: STR) ;
       PROCEDURE Write (RO s: STR) ;
       PROCEDURE WriteI64 (v: I64) ;
         (* ... s -- ... *)

   legitimately names `s`, which is a parameter of the first two and
   not of the third.  Checking against the owner alone reported eight
   false drifts across the corpus, all of this shape. *)
PROCEDURE CheckParams (VAR d: PTR DynStr.DString ;
                       RO b: UTF ; start: I64 ; RO names: UTF ;
                       VAR st: Stats) =
VAR
  i, lineStart, dash : I64 ;
  ln, nm : UTF ;
BEGIN
  i := start ;
  lineStart := start ;
  WHILE i <= Text.BLen (b) DO
    IF i = Text.BLen (b) OR B (b, i) = 10 THEN
      ln := Text.Trim (SLICE (b, lineStart, i - lineStart)) ;
      dash := Text.Find (ln, ' -- ') ;
      IF dash > 0 AND IsParamLine (ln) THEN
        nm := Text.Trim (SLICE (ln, 0, dash)) ;
        (* `a, b -- both of them` names two; only the first is
           checked, which is the honest limit and is stated *)
        IF Text.FindChar (nm, ',') >= 0 THEN
          nm := Text.Trim (SLICE (nm, 0, Text.FindChar (nm, ','))) 
        END ;
        IF Text.BLen (nm) > 0 THEN
          st.paramsDoc := st.paramsDoc + 1 ;
          IF NOT Text.Contains (names, Cat3 (' ', nm, ' ')) THEN
            st.unknownParam := st.unknownParam + 1 ;
            (* The drift is SAID IN THE DOCUMENT, not merely counted.
               The document is what a reader sees, and a name that no
               longer exists in the signature is exactly the drift they
               would otherwise believe. *)
            DynStr.Append (d, '**drift: `') ;
            DynStr.Append (d, nm) ;
            DynStr.Append (d, '` is documented but is not a ') ;
            DynStr.Append (d, 'parameter here**') ;
            DynStr.AppendChar (d, 0AC)
          END
        END
      END ;
      lineStart := i + 1
    END ;
    i := i + 1
  END
END CheckParams ;

PROCEDURE Cat3 (RO a: UTF ; RO b: UTF ; RO c: UTF) : UTF =
VAR d : PTR DynStr.DString IN HEAP ;
BEGIN
  d := DynStr.New (HEAP) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  DynStr.Append (d, c) ;
  RETURN DynStr.ViewIn (HEAP, d)
END Cat3 ;

PROCEDURE CountWords (RO s: UTF) : I64 =
VAR i, n : I64 ;
BEGIN
  n := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) # 32 THEN
      IF i = 0 THEN n := n + 1
      ELSIF B (s, i - 1) = 32 THEN n := n + 1 END
    END
  END ;
  RETURN n
END CountWords ;

(* HasUtfTwin asks whether the module declares name + Utf, a UTF
   twin. *)
PROCEDURE HasUtfTwin (RO anch: SLICE OF Anchor ; nanch: I64 ; RO name: UTF) : BOOL =
VAR i, n : I64 ;
BEGIN
  n := Text.BLen (name) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (name, n - 3, 3), 'Utf') THEN RETURN FALSE END
  END ;
  FOR i := 0 TO nanch - 1 DO
    IF anch[i].kind = Ast.NProcDecl AND Text.BLen (anch[i].name) = n + 3 THEN
      IF Text.Eq (SLICE (anch[i].name, 0, n), name) AND
         Text.Eq (SLICE (anch[i].name, n, 3), 'Utf') THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
EXCEPT
| IndexError : RETURN FALSE
END HasUtfTwin ;

(* TwinOver gives every procedure X whose module declares XUtf the
   heading XUtf has, under X's name, and XUtf's text.  Since the
   switch a call of X is XUtf's (Sem.UtfTwin), so X's own heading
   describes a procedure no call reaches.  --json published
   `ReadFile (VAR pool: POOL ; RO path: STR)' while a call took one
   argument, and an agent reading it wrote the refused form (m9fun,
   2026-11-01).  XUtf keeps its own entry: it is callable by that
   name too. *)
PROCEDURE TwinOver (VAR pool: POOL ; VAR anch: SLICE OF Anchor ; nanch: I64) RAISES IndexError =
VAR i, j, n : I64 ;
  tw : UTF ;
BEGIN
  FOR i := 0 TO nanch - 1 DO
    IF anch[i].kind = Ast.NProcDecl AND HasUtfTwin (anch, nanch, anch[i].name) THEN
      tw := Text.Keep (pool, anch[i].name + 'Utf') ;
      n := Text.BLen (tw) ;
      FOR j := 0 TO nanch - 1 DO
        IF anch[j].kind = Ast.NProcDecl AND Text.Eq (anch[j].name, tw) THEN
          (* the twin's heading starts with its own name; X's is put
             in its place *)
          IF Text.StartsWith (anch[j].sig, tw) THEN
            anch[i].sig := Text.Keep (pool, anch[i].name + SLICE (anch[j].sig, n, Text.BLen (anch[j].sig) - n))
          ELSE
            anch[i].sig := anch[j].sig
          END ;
          anch[i].params := anch[j].params ;
          anch[i].paramsJson := anch[j].paramsJson ;
          anch[i].resultText := anch[j].resultText ;
          anch[i].raisesJson := anch[j].raisesJson ;
          anch[i].attribText := anch[j].attribText ;
          (* A member of a documented group keeps the group's text:
             it names the group's parameters, and taking the twin's
             own text took X out of the group (Io's Write beside
             WriteI64). *)
          IF NOT anch[i].shared THEN
            anch[i].doc := anch[j].doc ;
            anch[i].hasDoc := anch[j].hasDoc
          END
        END
      END
    END
  END
END TwinOver ;

PROCEDURE KindWord (k: I64) : UTF =
BEGIN
  IF k = Ast.NProcDecl THEN RETURN 'PROCEDURE' END ;
  IF k = Ast.NTypeDecl THEN RETURN 'TYPE' END ;
  IF k = Ast.NConstDecl THEN RETURN 'CONST' END ;
  IF k = Ast.NVarDecl THEN RETURN 'VAR' END ;
  RETURN 'EXCEPTION'
END KindWord ;

(* GroupParams answers the parameters of every declaration this
   comment documents: the owner, plus the run of `shared`
   declarations immediately above it. *)
PROCEDURE GroupParams (RO anch: SLICE OF Anchor ;
                       nanch, owner: I64) : UTF
  RAISES IndexError =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, anch[owner].params) ;
  i := owner - 1 ;
  WHILE i >= 0 DO
    IF anch[i].shared THEN
      DynStr.Append (d, anch[i].params) ;
      i := i - 1
    ELSE
      i := -1
    END
  END ;
  RETURN DynStr.View (d)
END GroupParams ;

(* ---- the gather, shared by both renderers ---- *)

(* UpTo answers the line the next unit starts on, or "forever".  A
   unit owns the comments from its own line down to there. *)
PROCEDURE UpTo (root: PTR Ast.Node ; u: I64) : I64 RAISES IndexError =
VAR i, upTo : I64 ;
BEGIN
  upTo := 0 ;
  FOR i := u + 1 TO root.nkids - 1 DO
    IF upTo = 0 THEN
      IF root.kids[i] IS SOME nx THEN upTo := nx.line END
    END
  END ;
  IF upTo = 0 THEN upTo := 1000000000 END ;
  RETURN upTo
END UpTo ;

(* Gather collects every declaration of one DEFINITION unit with its
   comment attached, the module's own comment, and the group-sharing
   marks.  Text and Json both start here, so they cannot disagree
   about which comment belongs to what.  Only the rendering differs
   between them. *)
PROCEDURE Gather (VAR pool: POOL ; KEPT unit: PTR Ast.Node ; upTo: I64 ;
                  VAR anch: SLICE OF Anchor ; VAR nanch: I64 ;
                  VAR modDoc: UTF ; VAR haveMod: BOOL ; VAR st: Stats)
  RAISES IndexError =
VAR
  i, o : I64 ;
  c : Lex.Comment ;
BEGIN
  nanch := 0 ;
  Collect (pool, unit, anch, nanch) ;

  modDoc := '' ;
  haveMod := FALSE ;
  FOR i := 0 TO Lex.ComCount () - 1 DO
    c := Lex.ComAt (i) ;
    IF c.line >= unit.line AND c.line < upTo THEN
      o := Owner (anch, nanch, c.line) ;
      IF o < 0 THEN
        IF NOT haveMod THEN
          modDoc := Body (pool, c.text) ;
          haveMod := TRUE
        ELSE
          st.unattached := st.unattached + 1
        END
      ELSIF c.col = 1 THEN
        st.banners := st.banners + 1
      ELSIF anch[o].hasDoc THEN
        st.unattached := st.unattached + 1
      ELSE
        anch[o].doc := Body (pool, c.text) ;
        anch[o].hasDoc := TRUE
      END
    END
  END ;

  (* A group comment after the last member of an adjacent run
     documents the whole run: Text.FindChar/LastChar, Math's
     trigonometric block.  Adjacent means the declarations sit
     within two lines of each other, which is what a group looks
     like and what a separated declaration does not. *)
  (* the names of one VAR declaration share its comment, which
     Owner gave to the last of them *)
  FOR i := nanch - 2 TO 0 BY -1 DO
    IF anch[i].kind = Ast.NVarDecl AND anch[i + 1].kind = Ast.NVarDecl AND
       anch[i].line = anch[i + 1].line AND anch[i + 1].hasDoc AND
       NOT anch[i].hasDoc THEN
      anch[i].doc := anch[i + 1].doc ;
      anch[i].hasDoc := TRUE
    END
  END ;
  FOR i := nanch - 2 TO 0 BY -1 DO
    IF NOT anch[i].hasDoc AND NOT anch[i].shared THEN
      IF anch[i + 1].hasDoc OR anch[i + 1].shared THEN
        IF anch[i + 1].line - anch[i].line <= 2 THEN
          anch[i].shared := TRUE
        END
      END
    END
  END ;
  (* last, once every comment is attached: a twin's heading and text *)
  TwinOver (pool, anch, nanch)
END Gather ;

PROCEDURE KindJson (k: I64) : UTF =
BEGIN
  IF k = Ast.NProcDecl THEN RETURN 'procedure' END ;
  IF k = Ast.NTypeDecl THEN RETURN 'type' END ;
  IF k = Ast.NConstDecl THEN RETURN 'const' END ;
  IF k = Ast.NVarDecl THEN RETURN 'var' END ;
  RETURN 'exception'
END KindJson ;

PROCEDURE Json (VAR pool: POOL ; root: PTR Ast.Node ; RO modName: UTF ;
                VAR st: Stats) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i, u, nanch : I64 ;
  anch : SLICE OF Anchor ;
  modDoc : UTF ;
  haveMod, first : BOOL ;
BEGIN
  anch := NEW (pool, Anchor, MaxAnchor) ;
  d := DynStr.New (pool) ;
  DynStr.Append (d, '{"module":') ;
  JsonStr (d, modName) ;
  DynStr.Append (d, ',"doc":') ;

  (* the first DEFINITION unit is the module; a file holds one *)
  first := TRUE ;
  FOR u := 0 TO root.nkids - 1 DO
    IF root.kids[u] IS SOME unit THEN
      IF unit.kind = Ast.NDefinition AND first THEN
        first := FALSE ;
        Gather (pool, unit, UpTo (root, u), anch, nanch,
                modDoc, haveMod, st) ;
        st.mods := st.mods + 1 ;
        IF haveMod THEN
          st.modsDoc := st.modsDoc + 1 ;
          JsonStr (d, modDoc)
        ELSE
          DynStr.Append (d, 'null')
        END ;
        DynStr.Append (d, ',"declarations":[') ;
        FOR i := 0 TO nanch - 1 DO
          IF i > 0 THEN DynStr.AppendChar (d, ',') END ;
          IF anch[i].kind = Ast.NProcDecl THEN
            st.procs := st.procs + 1 ;
            IF anch[i].hasDoc THEN st.procsDoc := st.procsDoc + 1 END
          ELSE
            st.others := st.others + 1 ;
            IF anch[i].hasDoc THEN st.othersDoc := st.othersDoc + 1 END
          END ;
          DynStr.Append (d, '{"kind":') ;
          JsonStr (d, KindJson (anch[i].kind)) ;
          DynStr.Append (d, ',"name":') ;
          JsonStr (d, anch[i].name) ;
          DynStr.Append (d, ',"line":') ;
          DynStr.AppendI64 (d, anch[i].line) ;
          IF Text.BLen (anch[i].deprecated) > 0 THEN
            DynStr.Append (d, ',"deprecated":') ;
            JsonStr (d, anch[i].deprecated)
          END ;
          IF anch[i].kind = Ast.NProcDecl THEN
            DynStr.Append (d, ',"signature":') ;
            JsonStr (d, anch[i].sig) ;
            DynStr.Append (d, ',"params":') ;
            DynStr.Append (d, anch[i].paramsJson) ;
            DynStr.Append (d, ',"result":') ;
            IF Text.BLen (anch[i].resultText) > 0 THEN
              JsonStr (d, anch[i].resultText)
            ELSE
              DynStr.Append (d, 'null')
            END ;
            DynStr.Append (d, ',"raises":') ;
            DynStr.Append (d, anch[i].raisesJson) ;
            DynStr.Append (d, ',"attrib":') ;
            IF Text.BLen (anch[i].attribText) > 0 THEN
              JsonStr (d, anch[i].attribText)
            ELSE
              DynStr.Append (d, 'null')
            END
          END ;
          IF anch[i].kind = Ast.NExcDecl THEN
            DynStr.Append (d, ',"params":') ;
            DynStr.Append (d, anch[i].paramsJson)
          END ;
          IF anch[i].kind = Ast.NVarDecl THEN
            DynStr.Append (d, ',"type":') ;
            JsonStr (d, anch[i].resultText) ;
            DynStr.Append (d, ',"ro":') ;
            IF Text.BLen (anch[i].attribText) > 0 THEN
              DynStr.Append (d, 'true')
            ELSE
              DynStr.Append (d, 'false')
            END
          END ;
          DynStr.Append (d, ',"doc":') ;
          IF anch[i].hasDoc THEN
            JsonStr (d, anch[i].doc)
          ELSE
            DynStr.Append (d, 'null')
          END ;
          DynStr.Append (d, ',"shared":') ;
          IF anch[i].shared THEN
            DynStr.Append (d, 'true')
          ELSE
            DynStr.Append (d, 'false')
          END ;
          DynStr.AppendChar (d, '}')
        END ;
        DynStr.AppendChar (d, ']')
      END
    END
  END ;
  IF first THEN
    (* A file with no definition unit at all is still a document,
       and an honest one. *)
    DynStr.Append (d, 'null,"declarations":[]')
  END ;
  DynStr.AppendChar (d, '}') ;
  DynStr.AppendChar (d, 0AC) ;
  RETURN DynStr.ViewIn (pool, d)
END Json ;

PROCEDURE Text (VAR pool: POOL ; root: PTR Ast.Node ; RO modName: UTF ;
                VAR st: Stats) : UTF
  RAISES IndexError =
VAR
  d : PTR DynStr.DString IN pool ;
  i, u, ps, nanch : I64 ;
  anch : SLICE OF Anchor ;
  modDoc : UTF ;
  haveMod : BOOL ;
  b : UTF ;
BEGIN
  anch := NEW (pool, Anchor, MaxAnchor) ;
  d := DynStr.New (pool) ;
  DynStr.Append (d, '# ') ;
  DynStr.Append (d, modName) ;
  DynStr.AppendChar (d, 0AC) ;

  (* a PROGRAM exports nothing: its page said only its name until
     2026-10-08, and a reader took the bare heading for a page that
     had failed to render *)
  FOR u := 0 TO root.nkids - 1 DO
    IF root.kids[u] IS SOME unit THEN
      IF unit.kind = Ast.NProgram THEN
        DynStr.AppendChar (d, 0AC) ;
        DynStr.Append (d, 'A program (`MODULE ') ;
        DynStr.Append (d, modName) ;
        DynStr.Append (d, '`): nothing to import, run it.') ;
        DynStr.AppendChar (d, 0AC)
      END
    END
  END ;

  FOR u := 0 TO root.nkids - 1 DO
    IF root.kids[u] IS SOME unit THEN
      IF unit.kind = Ast.NDefinition THEN
        Gather (pool, unit, UpTo (root, u), anch, nanch,
                modDoc, haveMod, st) ;

        st.mods := st.mods + 1 ;
        IF haveMod THEN st.modsDoc := st.modsDoc + 1 END ;
        IF Text.BLen (modDoc) > 0 THEN
          DynStr.AppendChar (d, 0AC) ;
          DynStr.Append (d, modDoc) ;
          DynStr.AppendChar (d, 0AC)
        END ;

        FOR i := 0 TO nanch - 1 DO
          IF anch[i].kind = Ast.NProcDecl THEN
            st.procs := st.procs + 1 ;
            IF anch[i].hasDoc THEN st.procsDoc := st.procsDoc + 1 END ;
            st.params := st.params + CountWords (anch[i].params)
          ELSE
            st.others := st.others + 1 ;
            IF anch[i].hasDoc THEN st.othersDoc := st.othersDoc + 1 END
          END ;

          DynStr.AppendChar (d, 0AC) ;
          DynStr.Append (d, '### ') ;
          IF anch[i].kind = Ast.NProcDecl THEN
            DynStr.Append (d, anch[i].sig)
          ELSE
            DynStr.Append (d, KindWord (anch[i].kind)) ;
            DynStr.AppendChar (d, ' ') ;
            DynStr.Append (d, anch[i].name)
          END ;
          DynStr.AppendChar (d, 0AC) ;
          DynStr.AppendChar (d, 0AC) ;
          (* A name whose module declares name + Utf is that twin since
             the switch: a call of it is the twin's (Sem.UtfTwin), and
             TwinOver gave this entry the twin's heading and text.  The
             page says so from the declarations, so no comment has to
             remember it. *)
          IF anch[i].kind = Ast.NProcDecl AND HasUtfTwin (anch, nanch, anch[i].name) THEN
            DynStr.Append (d, 'Since 0.26 a call of ') ;
            DynStr.Append (d, anch[i].name) ;
            DynStr.Append (d, ' is ') ;
            DynStr.Append (d, anch[i].name) ;
            DynStr.Append (d, 'Utf, whose heading this is.') ;
            DynStr.AppendChar (d, 0AC) ;
            DynStr.AppendChar (d, 0AC)
          END ;
          IF Text.BLen (anch[i].deprecated) > 0 THEN
            DynStr.Append (d, '**Deprecated** (report par 3.9): write `') ;
            DynStr.Append (d, anch[i].deprecated) ;
            DynStr.Append (d, '` instead.  The name goes in the next release.') ;
            DynStr.AppendChar (d, 0AC) ;
            DynStr.AppendChar (d, 0AC)
          END ;

          IF anch[i].hasDoc THEN
            b := anch[i].doc ;
            ps := ParamStart (b) ;
            IF ps >= 0 AND anch[i].kind = Ast.NProcDecl THEN
              CheckParams (d, b, ps,
                           GroupParams (anch, nanch, i), st)
            END ;
            DynStr.Append (d, b) ;
            DynStr.AppendChar (d, 0AC)
          ELSIF anch[i].shared THEN
            DynStr.Append (d, '_(documented with the group below)_') ;
            DynStr.AppendChar (d, 0AC)
          ELSE
            DynStr.Append (d, '_(undocumented)_') ;
            DynStr.AppendChar (d, 0AC)
          END
        END
      END
    END
  END ;
  RETURN DynStr.ViewIn (pool, d)
END Text ;

END Doc.
