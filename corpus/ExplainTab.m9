DEFINITION MODULE ExplainTab ;

(* GENERATED by tools/MkDiagnose.m9 from probes/ -- do not edit.
   One entry a refusal probe: its name, its message, the message
   as an Explain pattern, and the cause and fix of
   docs/diagnose.md.  m9c prints the fix under a refusal and
   `m9c --explain NAME` the entry.  runtime/test/diagdiff.sh holds
   this file to the probes. *)

PROCEDURE Count () : I64 ;
PROCEDURE Name (i: I64) : STR RAISES IndexError ;
PROCEDURE Message (i: I64) : STR RAISES IndexError ;
PROCEDURE Pattern (i: I64) : STR RAISES IndexError ;
PROCEDURE Cause (i: I64) : STR RAISES IndexError ;
PROCEDURE Fix (i: I64) : STR RAISES IndexError ;

END ExplainTab.

