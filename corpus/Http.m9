(* SPDX-License-Identifier: GPL-3.0-or-later WITH Classpath-exception-2.0 *)
DEFINITION MODULE Http ;

(* Http speaks HTTP over TCP and TLS: a one-shot HTTP/1.0 GET, a URL
   fetcher that follows redirects to a file or a string, and Request,
   the general form with a method, headers and a body.  The M2 version
   returned -1 for every kind of transport failure and parked the
   payload behind an ADDRESS; here each failure RAISES with its name,
   and the payload lands in a slice the caller sized or in the caller's
   pool. *)

IMPORT Io ;
  (* Http imports Io for Io.IOError, which GetToFile raises when the
     DISK refuses.  A definition that names another module's
     exception must import it.  m9c accepts one that does not, while
     the bootstrap generator answers `unknown exception in handler`
     from the implementation, half a file away. *)

EXCEPTION
  TransportError (RO msg: STR) ;

PROCEDURE Get (RO host: STR ; port: I64 ;
               RO path: STR ;
               body: SLICE OF BYTE ;
               VAR bodyLen: I64) : I64
  RAISES TransportError, ValueRange ;
  (* Get returns the HTTP status; body receives the WHOLE response
     body and bodyLen says how long it is.  Get is Content-Length-honest
     since 2026-09-27: the body is read to its declared length, or chunk
     by chunk, or to the close.  One that does not fit in `body` is
     REFUSED BY NAME (TransportError, bodyLen 0) rather than cut to fit.
     The old reader truncated silently at LEN (body) and at an
     undocumented 4 MB ceiling, which surfaced three layers up as a
     blosc error.  A host and a path go out as their UTF-8 octets, as
     curl sends them (2026-10-31).  Before that a character past 255
     raised ValueRange.  Http has no IDN: a host past ASCII is looked
     up as its octets.                                                *)

PROCEDURE GetTls (RO host: STR ; port: I64 ;
                  RO path: STR ;
                  body: SLICE OF BYTE ;
                  VAR bodyLen: I64) : I64
  RAISES TransportError, ValueRange ;
  (* GetTls makes the same request over TLS.  It is a separate NAME
     rather than a BOOL argument: `Get (host, 443, path, TRUE, body,
     n)` says nothing at the call site, and this is not a flag anyone
     should be able to pass by accident.

     The certificate IS verified: chain and hostname, in the
     handshake, by tlsshim.c.  A client that skips that is worse than
     a plain socket because it looks encrypted, so there is no option
     here to turn it off.  Failure to verify arrives as
     TransportError like any other failure to connect: a caller
     cannot proceed either way, and the two are not usefully
     distinguished at this layer.                                   *)

(* ---- fetching a URL: redirects, chunked bodies, and the disk ------

   Get and GetTls above are the one-shot form: you name the host, the
   port and the path, and the whole body lands in a slice you sized.
   That is HTTP/1.0 and it is enough for a probe.  It is not enough to
   fetch data from a repository, and every gap below was MEASURED on
   the ICOS Carbon Portal rather than anticipated:

   * `https://doi.org/<doi>` answers 302 to another HOST, so a
     redirect must be followed and the connection remade;
   * `/licence_accept?ids=...` answers 302 with a RELATIVE Location
     and a Set-Cookie the next request must carry;
   * doi.org's 302 AND the crosscite 200 behind it both arrive
     `Transfer-Encoding: chunked`, so a decoder is mandatory rather
     than defensive;
   * `Accept` decides what a metadata endpoint answers at all: the
     same collection URL gives 200 for `application/json` and
     **406 Not Acceptable** for `application/ld+json`;
   * and the objects are files, so the body goes to the DISK in
     blocks rather than into a buffer the size of the download.

   The cookie handling is deliberately NARROW and the definition says
   so: a `Set-Cookie` on a response is carried, name and value only,
   as the `Cookie` of the NEXT request in the SAME redirect chain.
   It does no domain matching, no path matching, no expiry, and keeps
   nothing between calls.  That is exactly the licence handshake and
   nothing more; a caller who needs a cookie jar does not have one
   here.                                                           *)

CONST
  MaxHop = 5 ;                    (* redirects followed before refusing *)

PROCEDURE GetToFile (VAR pool: POOL ; RO url: STR ; RO accept: STR ;
                     RO cookie: STR ; RO dest: STR ; VAR bytes: I64)
  : I64
  RAISES TransportError, Io.IOError, ValueRange ;
  (* GetToFile GETs `url`, following redirects, and writes the body
     to `dest` in blocks: the peak is one block and not one download.
     It answers the FINAL status.  `bytes` is what was written, which
     is 0 unless the status is 200.  On any other status NOTHING is
     written: `dest` is left as it was (until 2026-10-09 a 404's page
     landed there and read as the file on the next run).  `accept`
     and `cookie` are sent when they are not empty. *)

PROCEDURE GetText (VAR pool: POOL ; RO url: STR ; RO accept: STR ;
                   RO cookie: STR ; cap: I64 ; VAR status: I64) : STR
  RAISES TransportError, ValueRange ;
  (* GetText does the same, for a document small enough to hold: the
     body decoded from UTF-8, refused BY NAME past `cap` octets rather
     than truncated.  A truncated JSON document is a parse error three
     layers away from its cause. *)

(* ---- any request: a method, the caller's headers, a body ------------

   GetToFile and GetText are GETs shaped by one repository's habits.
   Request is the general form: any method, the caller's own header
   lines, a body of octets, and the response's status, headers and
   body back.  That is what a POST or a PUT to a REST service needs.
   It follows NO redirect: a 3xx comes back as itself with its Location
   among the response headers, because re-sending a POST to wherever a
   server points is the caller's decision, not this module's, and the
   GET forms above already follow when following is right.

   Header lines travel as ONE string in both directions: `Name: value`
   lines separated by a line feed, a final line feed allowed.  The
   request's `headers` are sent verbatim after the lines this module
   writes itself (Host, Accept-Encoding: identity, Connection: close,
   and Content-Length whenever there is a body or the method is not
   GET or HEAD).  `respHeaders` are the response's lines as received,
   status line excluded, and Header picks one out by name.  A `Host:`
   line among `headers` (the name in any case) REPLACES the one this
   module would write from the URL and goes out in its place, first
   after the request line.  The connection still goes to the URL's
   host and port: a client on loopback asking as a public name, which
   the server's host map then judges (since 2026-10-30, zarrm9's mcpd;
   until then it went out as a second Host line).  The lines are one
   string rather than a SLICE OF STR (which Text.Split answers)
   because it is the shape a caller reads from a file or writes with
   `+`, it needs no pool to build, and it crosses to a C caller as one
   slice rather than a slice of slices.                              *)

PROCEDURE Request (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                   RO headers: STR ; RO body: SLICE OF BYTE ;
                   cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : SLICE OF BYTE
  RAISES TransportError, ValueRange ;
  (* Request makes one request over http or https, `url` absolute.
     It answers the response body as octets, refused BY NAME past
     `cap` of them.  A HEAD, a 1xx, a 204 and a 304 carry no body, and
     none is waited for: a Content-Length on a HEAD describes the GET
     it stands for, not bytes that follow. *)

PROCEDURE RequestText (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                       RO headers: STR ; RO text: STR ; cap: I64 ;
                       VAR status: I64 ; VAR respHeaders: STR) : STR
  RAISES TransportError, ValueRange ;
  (* RequestText does the same with text both ways: `text` goes out as
     UTF-8 and the body comes back decoded from it, `cap` counting
     octets.  Nothing is assumed about the content type; name it in
     `headers`. *)

PROCEDURE Header (RO headers: STR ; RO name: STR) : STR
  RAISES ValueRange ;
  (* Header answers the value of the first line named `name`, with
     the surrounding blanks removed.  The name is compared without
     regard to case, the colon not part of the name.  Header answers
     '' when there is no such line, which an absent header and an
     empty one share. *)

PROCEDURE UrlEncode (RO s: STR) : STR RAISES ValueRange ;
  (* UrlEncode answers s as a URL component: its UTF-8 octets, each one
     outside A-Z a-z 0-9 - . _ ~ written %XX in upper-case hex.  It is
     Python's urllib.parse.quote (s, safe=''), held to it by HttpTest: a
     blank is %20, a slash %2F, so the answer can stand anywhere in a
     URL. *)

PROCEDURE UrlDecode (RO s: STR) : STR RAISES ValueRange ;
  (* UrlDecode is the inverse: every %XX an octet, the octets of a run
     decoded as UTF-8, STRICTLY.  An invalid sequence RAISES ValueRange,
     as Python's unquote (s, errors='strict') raises.  A % that is not
     followed by two hex digits is kept as it stands, and so is a +:
     this is a URL's decoding, not a form's, and Python's unquote does
     the same. *)

(* ---- a Client: one kept connection and a cookie jar ----------------

   Request opens a connection per call and says so (Connection:
   close).  A Client KEEPS one: the next Send to the same scheme,
   host and port rides the connection the last response left open,
   and reconnects otherwise.  Keeping takes HTTP/1.1, no Connection:
   close from either side, and the body framed by a length or by chunks
   rather than by the close.  A kept connection the server dropped while
   it was idle is found out on the first read, and the request goes
   again on a fresh connection, once, and only when no byte of a
   response had arrived, so nothing is ever answered twice.  Kept counts
   the requests that rode a kept connection, which is what a gate can
   measure.  Send follows no redirect, like Request.

   The jar keeps RFC 6265's rules as far as a data client needs them.
   A Set-Cookie's name and value are stored with its Domain (absent:
   this host only; present: the host must be in that domain, or the
   cookie is ignored), its Path (absent: the request's directory),
   its Max-Age or Expires (a past one deletes; an unparseable Expires
   makes a session cookie) and Secure (sent over https only).  A
   cookie of the same name, domain and path replaces its predecessor
   in place.  The Cookie header lists the matching ones longest path
   first, then in the order they arrived.  HttpOnly and SameSite are
   accepted and ignored: they constrain a browser's scripts, and
   there are none here.  The jar holds JarMax cookies and drops the
   oldest when it is full; it lives as long as the Client, in the
   pool the Client was made in, and is not persisted.

   The pool every call takes is the Client's own, exactly as
   DynStr.Append's is the string's: the kept connection's buffer, the
   jar's text and the response body are carved from it.            *)

CONST
  JarMax = 256 ;

TYPE
  Conn = RECORD
    (* A Conn is one connection, read through a buffer, so the header
       parser and the body reader can take bytes without either
       owning the socket's arithmetic.  It is exported only because
       Client holds one; nothing outside this module reads its
       fields. *)
    secure : BOOL ;
    fd : I64 ;
    buf : SLICE OF BYTE ;
    at : I64 ;                    (* next unread byte in buf *)
    n : I64 ;                     (* bytes held *)
    eof : BOOL ;
    gotAny : BOOL ;               (* a byte of THIS response arrived *)
  END ;

  Cookie = RECORD
    name, value, domain, path : STR ;
    hostOnly, secure : BOOL ;
    expires : F64 ;               (* seconds since the epoch; 0 = session *)
  END ;

  Client = RECORD
    cookies : SLICE OF Cookie ;   (* the jar: the first `n` are live *)
    n : I64 ;
    c : Conn ;                    (* the kept connection, when `open` *)
    open : BOOL ;
    secure : BOOL ;
    host : STR ;
    port : I64 ;
    kept : I64 ;                  (* requests answered on a kept connection *)
  END ;

PROCEDURE NewClient (VAR pool: POOL) : PTR Client IN pool ;
  (* NewClient answers an empty jar and no connection, owned by
     pool. *)

PROCEDURE Send (VAR pool: POOL ; VAR cl: PTR Client ; RO method: STR ;
                RO url: STR ; RO headers: STR ; RO body: SLICE OF BYTE ;
                cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : SLICE OF BYTE
  RAISES TransportError, ValueRange ;
  (* Send is Request through the Client: the jar's matching cookies go
     out in a Cookie header before `headers`, every Set-Cookie that
     comes back is kept, and the connection is kept when the server
     allows it.  Everything else (the header string, the body, `cap`,
     no redirect followed) is Request's contract. *)

PROCEDURE SendText (VAR pool: POOL ; VAR cl: PTR Client ; RO method: STR ;
                    RO url: STR ; RO headers: STR ; RO text: STR ;
                    cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : STR
  RAISES TransportError, ValueRange ;
  (* SendText is Send with text both ways, as RequestText is to
     Request. *)

PROCEDURE CloseClient (VAR cl: PTR Client)
  RAISES ValueRange ;
  (* CloseClient closes the kept connection, if any; the jar stays.  A
     Client whose pool dies with a connection open leaks a descriptor,
     so a long-lived program closes what it opened. *)

PROCEDURE Kept (cl: PTR Client) : I64 ;
  (* Kept answers how many Sends so far were answered over a
     connection kept from the Send before: a measurement, not a
     promise. *)

PROCEDURE CookieValue (cl: PTR Client ; RO name: STR) : STR
  RAISES ValueRange ;
  (* CookieValue answers the value of the first live cookie named
     `name`, whatever its domain and path; '' when there is none. *)

(* ---- trying again: retry with backoff (2026-10-02) -----------------

   A repository answers 503 for a minute while it restarts, or 429
   because forty jobs asked at once, and a program that fetches four
   hundred files should not die at file 212 for it.  RequestRetry is
   Request made again while that is worth doing, with a wait that
   doubles.

   The rules are urllib3's `Retry`: what Python's requests does when
   it is given `Retry (total = n, backoff_factor = f, status_forcelist
   = [429, 500, 502, 503, 504])`.  The three procedures a rule is
   made of are exported, so that the rules are held to urllib3 by a
   test and a caller with a loop of its own can use them:

   * WHAT is tried again: a request whose method is idempotent (GET,
     HEAD, PUT, DELETE, OPTIONS, TRACE) and whose answer is 429, 500,
     502, 503 or 504, or 413 with a Retry-After.  A POST is never
     sent twice on a status.
   * HOW LONG is waited: nothing before the first retry, then
     factor * 2, factor * 4, ... seconds, never more than MaxWait.
     When the answer carries a Retry-After that says more than zero,
     that is waited instead.
   * a TRANSPORT failure is tried again when the connection was never
     made, whatever the method (nothing was sent), and, for an
     idempotent method, when it was made and no byte of an answer
     came back.

   These are the stated differences from urllib3.  A Retry-After
   LONGER than MaxWait is not waited for and not defied: the answer
   goes back to the caller as it is (urllib3 sleeps however long it
   is told).  A Retry-After that is neither a count nor a date is no
   Retry-After (urllib3 raises).  A failure after part of an answer
   has arrived is not tried again (urllib3 retries a read error).
   From here it cannot be told from an answer that will fail the
   same way every time, one larger than `cap`, say. *)

CONST
  MaxWait = 120.0 ;               (* seconds; urllib3's backoff_max *)

PROCEDURE Backoff (failures: I64 ; factor: F64) : F64 ;
  (* Backoff answers the seconds to wait after `failures` failures in
     a row: 0.0 after the first, then factor * 2 ^ (failures - 1), at
     most MaxWait.  It answers 0.0 for a factor that is not
     positive. *)

PROCEDURE Retryable (RO method: STR ; status: I64 ;
                     hasRetryAfter: BOOL) : BOOL
  RAISES ValueRange ;
  (* Retryable says whether a request by this method, answered with
     this status, is worth making again.  The method is read without
     regard to case. *)

PROCEDURE RetryAfter (RO headers: STR ; now: F64) : F64
  RAISES ValueRange ;
  (* RetryAfter answers the seconds a response asks to be left alone:
     its Retry-After header as a count of seconds, or as an HTTP date
     measured from `now` (seconds since the epoch) and 0.0 when that
     date is past.  It answers -1.0 when there is no such header or it
     is neither.  A count of more than fifteen digits answers 1.0e15,
     which is more than MaxWait like every count that long. *)

PROCEDURE RequestRetry (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                        RO headers: STR ; RO body: SLICE OF BYTE ;
                        cap: I64 ; retries: I64 ; factor: F64 ;
                        VAR status: I64 ; VAR respHeaders: STR ;
                        VAR tries: I64) : SLICE OF BYTE
  RAISES TransportError, ValueRange ;
  (* RequestRetry makes Request at most 1 + retries times; `tries` says
     how many it took.  The answer is the LAST one's, whatever its
     status: a 503 that outlived the retries comes back as a 503, and a
     transport failure that did is raised as it would have been the
     first time.  Each try is a connection of its own. *)


(* ---- a multipart/form-data body (cp-kernel's issue 17, 2026-10-09) ----

   The iRODS HTTP API writes data objects ONLY as multipart/form-data,
   and a caller composing the boundary, every part's
   Content-Disposition line and the CRLFs by hand got a 400 with no
   body for one CRLF wrong.  Parts are COPIED into the form's pool as
   they are added, so the caller's buffers may be reused at once. *)

TYPE
  Form ;                          (* opaque; lives in a POOL *)

PROCEDURE NewForm (VAR pool: POOL) : PTR Form IN pool ;

PROCEDURE FormField (VAR f: PTR Form ; RO name: STR ; RO value: STR)
  RAISES ValueRange ;
  (* FormField adds a text field, its value as UTF-8. *)

PROCEDURE FormBytes (VAR f: PTR Form ; RO name: STR ; RO fileName: STR ;
                     RO contentType: STR ; RO b: SLICE OF BYTE) ;
  (* FormBytes adds a file part: `fileName' in its Content-Disposition,
     `contentType' as its Content-Type (application/octet-stream when
     empty). *)

PROCEDURE FormBody (VAR pool: POOL ; f: PTR Form) : SLICE OF BYTE
  RAISES ValueRange ;
  (* FormBody answers the body, RFC 7578: every part opened by CRLF `--'
     boundary CRLF, its headers, a blank line and its octets, the whole
     closed by `--' boundary `--' CRLF.  A name or file name is written
     as UTF-8 between double quotes, a `"', CR or LF in it
     percent-encoded as HTML forms do.  The boundary occurs in no part,
     so the body is the same bytes for the same parts. *)

PROCEDURE FormType (f: PTR Form) : STR RAISES ValueRange ;
  (* FormType answers the request's Content-Type: multipart/form-data
     with that boundary.  It is one header line's value for Request's
     `headers'. *)


PROCEDURE FormatDate (secs: I64) : STR RAISES ValueRange ;
  (* FormatDate answers the IMF-fixdate of RFC 9110 par 5.6.7 for a
     second since the epoch, `Sun, 06 Nov 1994 08:49:37 GMT': what a
     Date or a Last-Modified header carries.  It takes years 1 to
     9999; outside them it raises ValueRange.  TimeTest holds it to
     java.time's formatter (2026-10-10, cp-kernel's proposal;
     HttpServer wrote its Date header with a private copy of this,
     which now calls it). *)

END Http.


UNSAFE DEFINITION MODULE FOR "C" csock ;

PROCEDURE Connect = "tcp_connect" (host: C.ConstPtr ; port: C.Int)
  : C.Int  [SERIAL] ;
  (* The shim resolves and connects.  Connect is SERIAL until its
     thread safety is audited, not asserted: REENTRANT is a claim, not
     a default. *)

(* The three I/O calls are the shim's, not libc's: a socket is a
   descriptor on POSIX and read/write/close serve, but on Windows it
   is a handle the C runtime does not know, so the shim spells them
   recv/send/closesocket there and the generated C names neither.  *)
PROCEDURE Read = "tcp_read" (fd: C.Int ; buf: C.MutPtr ; n: C.SizeT)
  : C.SSizeT  [REENTRANT] ;

PROCEDURE Write = "tcp_write" (fd: C.Int ; buf: C.ConstPtr ; n: C.SizeT)
  : C.SSizeT  [REENTRANT] ;

PROCEDURE Close = "tcp_close" (fd: C.Int) : C.Int  [REENTRANT] ;

(* These calls bind TLS, from tlsshim.c.  The handle is an int for the
   same reason the socket is: a small non-negative number, -1 for
   failure, and no SSL * crossing the boundary.

   The calls are [REENTRANT] SINCE 2026-08-30, and the tag names the
   shim's design rather than a hope.  It said [SERIAL] before,
   LOAD-BEARING and not conservative: OpenSSL 3 is thread-safe per SSL
   object, but the shim's slot table was not, so eight concurrent HTTPS
   fetches would have raced it.  runtime/tlsshim.c now claims and
   releases slots under a mutex, held for the bookkeeping only, never
   across a handshake, a read or a write.  It shares ONE SSL_CTX built
   under pthread_once instead of re-reading the system CA bundle per
   connection.  Two threads using ONE handle is still a caller's bug, as
   it is for a plain fd.  runtime/test/threads.sh gates this: it fetches
   concurrently over a real TLS server and compares every byte.       *)

PROCEDURE TlsConnect = "tls_connect" (host: C.ConstPtr ; port: C.Int)
  : C.Int  [REENTRANT] ;

PROCEDURE TlsRead = "tls_read" (h: C.Int ; buf: C.MutPtr ; n: C.SizeT)
  : C.SSizeT  [REENTRANT] ;

PROCEDURE TlsWrite = "tls_write" (h: C.Int ; buf: C.ConstPtr ;
                                  n: C.SizeT)
  : C.SSizeT  [REENTRANT] ;

PROCEDURE TlsClose = "tls_close" (h: C.Int) : C.Int  [REENTRANT] ;

(* NowSec reads the wall clock, for a cookie's Max-Age and Expires:
   the same m9_now Time binds.  It is bound here rather than imported
   so that Http's closure stays DynStr and Io.  Time would bring Fmt,
   and every driver that links Http.c would have to grow two objects
   for one comparison against now. *)
PROCEDURE NowSec = "m9_now" () : C.Double  [REENTRANT] ;

(* SleepMs is the wait between two tries of RequestRetry: the same
   m9_sleep_ms Time binds, here for the reason NowSec is. *)
PROCEDURE SleepMs = "m9_sleep_ms" (ms: C.SSizeT)  [REENTRANT] ;

END csock.


UNSAFE IMPLEMENTATION MODULE Http ;

IMPORT Text ;

(* Http is UNSAFE for one reason: ADR at the foreign boundary.
   Everything else is checked code; the audit surface is this file,
   grep ADR.                                                         *)

FROM csock IMPORT Connect, Read, Write, Close ;
FROM csock IMPORT TlsConnect, TlsRead, TlsWrite, TlsClose, NowSec, SleepMs ;
IMPORT DynStr ;
IMPORT Io ;

PROCEDURE CrLf (VAR d: PTR DynStr.DString) =
BEGIN
  DynStr.AppendChar (d, 0DC) ;
  DynStr.AppendChar (d, 0AC)
END CrLf ;

(* ---- the URL fetcher --------------------------------------------- *)

CONST
  IoBlock = 65536 ;               (* one socket read, and the peak *)
  HdrMax = 16384 ;                (* a response header block *)

PROCEDURE ConnRead (VAR c: Conn) : I64
  RAISES ValueRange =
VAR got : I64 ;
BEGIN
  IF c.eof THEN RETURN 0 END ;
  IF c.secure THEN
    got := I64 (TlsRead (C.Int (c.fd), ADR (c.buf), C.SizeT (LEN (c.buf))))
  ELSE
    got := I64 (Read (C.Int (c.fd), ADR (c.buf), C.SizeT (LEN (c.buf))))
  END ;
  IF got <= 0 THEN c.eof := TRUE ; c.at := 0 ; c.n := 0 ; RETURN 0 END ;
  c.at := 0 ; c.n := got ;
  c.gotAny := TRUE ;
  RETURN got
END ConnRead ;

(* ConnByte answers one byte, or -1 at end of stream. *)
PROCEDURE ConnByte (VAR c: Conn) : I64
  RAISES ValueRange, IndexError =
VAR v : I64 ;
BEGIN
  IF c.at >= c.n THEN
    IF ConnRead (c) = 0 THEN RETURN -1 END
  END ;
  v := I64 (c.buf[c.at]) ;
  c.at := c.at + 1 ;
  RETURN v
END ConnByte ;

PROCEDURE CloseConn (VAR c: Conn)
  RAISES ValueRange =
VAR rc : I64 ;
BEGIN
  IF c.fd < 0 THEN RETURN END ;
  IF c.secure THEN
    rc := I64 (TlsClose (C.Int (c.fd)))
  ELSE
    rc := I64 (Close (C.Int (c.fd)))
  END ;
  c.fd := -1
END CloseConn ;

PROCEDURE Lower (c: I64) : I64 =
BEGIN
  IF c >= 65 AND c <= 90 THEN RETURN c + 32 END ;
  RETURN c
END Lower ;

(* `name` is lower-case and includes its colon *)
PROCEDURE HeaderIs (RO line: STR ; RO name: STR) : BOOL
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  IF Text.BLen (line) < Text.BLen (name) THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (name) - 1 DO
    IF Lower (I64 (Text.BAt (line, i))) # I64 (Text.BAt (name, i)) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END HeaderIs ;

PROCEDURE HeaderVal (RO line: STR ; skip: I64) : STR
  RAISES ValueRange =
VAR a, b : I64 ;
BEGIN
  a := skip ;
  WHILE a < Text.BLen (line) AND (Text.BIs (line, a, ' ') OR I64 (Text.BAt (line, a)) = 9) DO
    a := a + 1
  END ;
  b := Text.BLen (line) ;
  WHILE b > a AND (Text.BIs (line, b - 1, ' ') OR I64 (Text.BAt (line, b - 1)) = 9) DO
    b := b - 1
  END ;
  RETURN SLICE (line, a, b - a)
END HeaderVal ;

PROCEDURE Digits (RO s: STR) : I64
  RAISES ValueRange =
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF I64 (Text.BAt (s, i)) < ORD ('0') OR I64 (Text.BAt (s, i)) > ORD ('9') THEN RETURN v END ;
    v := v * 10 + (I64 (Text.BAt (s, i)) - 48)
  END ;
  RETURN v
END Digits ;

PROCEDURE HexVal (RO s: STR) : I64
  RAISES ValueRange =
VAR i, v, c : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    c := Lower (I64 (Text.BAt (s, i))) ;
    IF c >= 48 AND c <= 57 THEN v := v * 16 + (c - 48)
    ELSIF c >= 97 AND c <= 102 THEN v := v * 16 + (c - 87)
    ELSE RETURN v END
  END ;
  RETURN v
END HexVal ;

(* Line reads one CRLF-terminated line, LF tolerated alone.  It
   answers -1 at end of stream.  A line of UTF-8 octets is its text,
   as a request goes out as its text's octets (Alex, 2026-10-31).  A
   line that is not UTF-8 keeps one CHAR per octet.  So a Location
   comes back out as the octets it came in as. *)
PROCEDURE Line (VAR c: Conn ; VAR out: STR) : I64
  RAISES ValueRange, IndexError =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  v, n : I64 ;
  ascii : BOOL ;
BEGIN
  ascii := TRUE ;
  d := DynStr.New (pool) ;
  n := 0 ;
  LOOP
    v := ConnByte (c) ;
    IF v < 0 THEN
      IF n = 0 THEN RETURN -1 END ;
      EXIT
    END ;
    IF v = 10 THEN EXIT END ;
    IF v # 13 THEN DynStr.AppendChar (d, CHR (v)) END ;
    IF v > 127 THEN ascii := FALSE END ;
    n := n + 1 ;
    IF n > HdrMax THEN RETURN -2 END
  END ;
  out := DynStr.View (d) ;
  IF NOT ascii THEN
    out := DynStr.Decoded (pool, DynStr.Bytes (pool, out, FALSE))
  END ;
  RETURN Text.BLen (out)
END Line ;

(* SplitUrl takes scheme, host, port and path out of an absolute URL,
   or a path out of a relative one resolved against `baseHost`. *)
PROCEDURE SplitUrl (VAR pool: POOL ; RO url: STR ; VAR secure: BOOL ;
                    VAR host: STR ; VAR port: I64 ; VAR path: STR)
  RAISES TransportError, ValueRange =
VAR i, j, colon : I64 ;  rest : STR ;
BEGIN
  IF Text.BLen (url) > 8 AND Text.Eq (SLICE (url, 0, 8), 'https://') THEN
    secure := TRUE ; port := 443 ; rest := SLICE (url, 8, Text.BLen (url) - 8)
  ELSIF Text.BLen (url) > 7 AND Text.Eq (SLICE (url, 0, 7), 'http://') THEN
    secure := FALSE ; port := 80 ; rest := SLICE (url, 7, Text.BLen (url) - 7)
  ELSE
    RAISE TransportError ('not an http or https URL')
  END ;
  i := 0 ;
  WHILE i < Text.BLen (rest) AND NOT Text.BIs (rest, i, '/') DO i := i + 1 END ;
  host := SLICE (rest, 0, i) ;
  IF i >= Text.BLen (rest) THEN
    path := Cat1 (pool, '/')
  ELSE
    path := SLICE (rest, i, Text.BLen (rest) - i)
  END ;
  colon := -1 ;
  IF Text.BLen (host) > 0 AND Text.BIs (host, 0, '[') THEN
    (* An IPv6 literal comes in brackets (RFC 3986 par 3.2.2).  Its own
       colons are not the port's.  The host answered is the address
       without the brackets, which is what the resolver takes.
       HostLine puts them back for the Host header. *)
    j := 1 ;
    WHILE j < Text.BLen (host) AND NOT Text.BIs (host, j, ']') DO j := j + 1 END ;
    IF j >= Text.BLen (host) THEN RAISE TransportError ('an IPv6 host without its ]') END ;
    IF j + 1 < Text.BLen (host) THEN
      IF NOT Text.BIs (host, j + 1, ':') THEN RAISE TransportError ('text after an IPv6 host') END ;
      port := Digits (SLICE (host, j + 2, Text.BLen (host) - j - 2))
    END ;
    host := SLICE (host, 1, j - 1)
  ELSE
    FOR j := 0 TO Text.BLen (host) - 1 DO
      IF Text.BIs (host, j, ':') THEN colon := j END
    END ;
    IF colon >= 0 THEN
      port := Digits (SLICE (host, colon + 1, Text.BLen (host) - colon - 1)) ;
      host := SLICE (host, 0, colon)
    END
  END ;
  IF Text.BLen (host) = 0 THEN RAISE TransportError ('no host in the URL') END
END SplitUrl ;

(* HostLine appends the Host header's value for host and port (RFC
   9112 par 3.2).  The port goes out unless it is the scheme's
   default: 80 for http, 443 for https.  A host with a colon is an
   IPv6 address and goes in brackets.  Until 2026-10-31 the port never
   went out, and a server on 8080 saw a request for port 80. *)
PROCEDURE HostLine (VAR d: PTR DynStr.DString ; RO host: STR ; port: I64 ;
                    secure: BOOL) =
BEGIN
  IF Text.Find (host, ':') >= 0 THEN
    DynStr.AppendChar (d, '[') ;
    DynStr.Append (d, host) ;
    DynStr.AppendChar (d, ']')
  ELSE
    DynStr.Append (d, host)
  END ;
  IF (secure AND port # 443) OR (NOT secure AND port # 80) THEN
    DynStr.AppendChar (d, ':') ;
    DynStr.AppendI64 (d, port)
  END
END HostLine ;

PROCEDURE Cat1 (VAR pool: POOL ; RO a: STR) : STR
  RAISES ValueRange =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  (* Cat1 answers a copy in pool, not a view of the builder.  That is
     the same under the switch, where the builder is DynUtf's
     (2026-10-24). *)
  d := DynStr.New (pool) ;
  DynStr.Append (d, a) ;
  RETURN DynStr.ViewIn (pool, d)
END Cat1 ;

(* Pull reads up to `want` bytes out of the connection into `out`,
   answering how many; 0 means the stream has ended.  It is
   block-wise on purpose: a 500 MB object read a byte at a time
   through ConnByte would spend its time in the buffer arithmetic. *)
PROCEDURE Pull (VAR c: Conn ; VAR out: SLICE OF BYTE ; at: I64 ;
                want: I64) : I64
  RAISES ValueRange, IndexError =
VAR i, have : I64 ;
BEGIN
  IF want <= 0 THEN RETURN 0 END ;
  IF c.at >= c.n THEN
    IF ConnRead (c) = 0 THEN RETURN 0 END
  END ;
  have := c.n - c.at ;
  IF have > want THEN have := want END ;
  FOR i := 0 TO have - 1 DO out[at + i] := c.buf[c.at + i] END ;
  c.at := c.at + have ;
  RETURN have
END Pull ;

(* SendAll puts every byte of `data` onto the connection.  write(2)
   on a blocking socket may stop short: a signal, a full send buffer
   under TLS.  The one-shot forms above accept a short write silently
   because a 60-byte GET never sees one.  A POST body is as long as
   the caller made it, so this loops until the last byte is gone.  A
   write that sends nothing raises TransportError. *)
PROCEDURE SendAll (VAR c: Conn ; RO data: SLICE OF BYTE)
  RAISES TransportError, ValueRange =
VAR at, n : I64 ;
BEGIN
  at := 0 ;
  WHILE at < LEN (data) DO
    IF c.secure THEN
      n := I64 (TlsWrite (C.Int (c.fd),
                          ADR (SLICE (data, at, LEN (data) - at)),
                          C.SizeT (LEN (data) - at)))
    ELSE
      n := I64 (Write (C.Int (c.fd),
                       ADR (SLICE (data, at, LEN (data) - at)),
                       C.SizeT (LEN (data) - at)))
    END ;
    IF n <= 0 THEN RAISE TransportError ('send failed') END ;
    at := at + n
  END
END SendAll ;

(* ---- ONE request, and the response it produces ---------------------

   Every public form fills a Req, opens or reuses a Conn and calls
   Once; the two records are what a parameter list that had grown to
   nineteen names became.  The body has three sinks: `toFile` streams
   it to `dest` a block at a time, `toSink` copies it into the
   caller's slice and REFUSES BY NAME what does not fit, and otherwise
   it accumulates in `pool` up to `cap` octets.  `keep` asks to keep
   the connection; rs.keepable answers whether the server allowed it,
   and Once closes the connection whenever the answer is no.        *)

TYPE
  Req = RECORD
    method, host, path, extra, accept, cookie, dest : STR ;
    port : I64 ;                  (* the URL's, for the Host line *)
    body : SLICE OF BYTE ;
    toFile, toSink, keepHdrs, keep : BOOL ;
    cap : I64 ;
  END ;

  Resp = RECORD
    status, bytes : I64 ;
    loc, setCookie, hdrs, text : STR ;
    keepable : BOOL ;
  END ;

(* OpenConn makes a fresh connection to host:port.  The read buffer is
   carved from `pool` the first time and kept across reconnections of
   the same Conn, which is how a Client pays for it once. *)
PROCEDURE OpenConn (VAR pool: POOL ; VAR c: Conn ; secure: BOOL ;
                    RO host: STR ; port: I64)
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  hz : SLICE OF BYTE ;
BEGIN
  hz := DynStr.Wire (scratch, host, TRUE) ;
  c.secure := secure ;
  c.at := 0 ; c.n := 0 ; c.eof := FALSE ; c.gotAny := FALSE ;
  IF LEN (c.buf) = 0 THEN c.buf := NEW (pool, BYTE, IoBlock) END ;
  IF secure THEN
    c.fd := I64 (TlsConnect (ADR (hz), C.Int (port)))
  ELSE
    c.fd := I64 (Connect (ADR (hz), C.Int (port)))
  END ;
  IF c.fd < 0 THEN RAISE TransportError ('connect failed') END
END OpenConn ;

(* ExtraHost finds the line of `extra' whose name is Host, any case.
   It answers its offset, and its length without the line end in n;
   -1 when there is none. *)
PROCEDURE ExtraHost (RO extra: STR ; VAR n: I64) : I64 =
VAR k, i : I64 ;
BEGIN
  n := 0 ;
  k := 0 ;
  WHILE k < Text.BLen (extra) DO
    i := k ;
    WHILE i < Text.BLen (extra) AND I64 (Text.BAt (extra, i)) # 10 DO i := i + 1 END ;
    IF i - k >= 5 THEN
      IF (Text.BIs (extra, k, 'h') OR Text.BIs (extra, k, 'H')) AND (Text.BIs (extra, k + 1, 'o') OR Text.BIs (extra, k + 1, 'O')) AND
         (Text.BIs (extra, k + 2, 's') OR Text.BIs (extra, k + 2, 'S')) AND (Text.BIs (extra, k + 3, 't') OR Text.BIs (extra, k + 3, 'T')) AND
         Text.BIs (extra, k + 4, ':') THEN
        n := i - k ;
        IF I64 (Text.BAt (extra, i - 1)) = 13 THEN n := n - 1 END ;
        RETURN k
      END
    END ;
    k := i + 1
  END ;
  RETURN -1
EXCEPT
| IndexError : RETURN -1
| ValueRange : RETURN -1
END ExtraHost ;

PROCEDURE Once (VAR pool: POOL ; VAR c: Conn ; RO rq: Req ;
                VAR sink: SLICE OF BYTE ; VAR rs: Resp)
  RAISES TransportError, Io.IOError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  req : PTR DynStr.DString IN scratch ;
  acc : PTR DynStr.DString IN pool ;
  hd : PTR DynStr.DString IN scratch ;
  blk : SLICE OF BYTE ;
  line, val : STR ;
  n, ln, clen, want, got, held, sunk, i, k : I64 ;
  chunked, first, opened, noBody, ended, done : BOOL ;
  http11, connClose, connKeep : BOOL ;
  hk, hn : I64 ;
BEGIN
  rs.status := 0 ; rs.bytes := 0 ; rs.loc := '' ; rs.setCookie := '' ;
  rs.hdrs := '' ; rs.text := '' ; rs.keepable := FALSE ;
  done := FALSE ;
  c.gotAny := FALSE ;

  BEGIN
    req := DynStr.New (scratch) ;
    DynStr.Append (req, rq.method) ;
    DynStr.Append (req, ' ') ;
    DynStr.Append (req, rq.path) ;
    DynStr.Append (req, ' HTTP/1.1') ;
    CrLf (req) ;
    (* This writes the caller's own Host line, when it gives one, in
       place of the URL's (the definition). *)
    hk := ExtraHost (rq.extra, hn) ;
    IF hk >= 0 THEN
      DynStr.Append (req, SLICE (rq.extra, hk, hn))
    ELSE
      DynStr.Append (req, 'Host: ') ;
      HostLine (req, rq.host, rq.port, c.secure)
    END ;
    CrLf (req) ;
    (* This asks for identity BY NAME: a server that decided to gzip
       would hand back bytes this module does not decode, and the
       failure would look like corrupt data rather than a missing
       feature. *)
    DynStr.Append (req, 'Accept-Encoding: identity') ;
    CrLf (req) ;
    IF rq.keep THEN
      DynStr.Append (req, 'Connection: keep-alive')
    ELSE
      (* This is one request per connection, so a body with no
         framing at all ends at the close. *)
      DynStr.Append (req, 'Connection: close')
    END ;
    CrLf (req) ;
    IF Text.BLen (rq.accept) > 0 THEN
      DynStr.Append (req, 'Accept: ') ;
      DynStr.Append (req, rq.accept) ;
      CrLf (req)
    END ;
    IF Text.BLen (rq.cookie) > 0 THEN
      DynStr.Append (req, 'Cookie: ') ;
      DynStr.Append (req, rq.cookie) ;
      CrLf (req)
    END ;
    (* The caller's own lines go out one per line feed, as given; a
       carriage return before the line feed is tolerated, not
       doubled. *)
    k := 0 ;
    WHILE k < Text.BLen (rq.extra) DO
      i := k ;
      WHILE i < Text.BLen (rq.extra) AND I64 (Text.BAt (rq.extra, i)) # 10 DO i := i + 1 END ;
      n := i - k ;
      IF n > 0 AND I64 (Text.BAt (rq.extra, i - 1)) = 13 THEN n := n - 1 END ;
      IF n > 0 AND k # hk THEN
        DynStr.Append (req, SLICE (rq.extra, k, n)) ;
        CrLf (req)
      END ;
      k := i + 1
    END ;
    (* a body is framed by its length; a bodiless POST says 0 so the
       server does not wait for one *)
    IF LEN (rq.body) > 0 OR
       NOT (Text.Eq (rq.method, 'GET') OR Text.Eq (rq.method, 'HEAD')) THEN
      DynStr.Append (req, 'Content-Length: ') ;
      DynStr.AppendI64 (req, LEN (rq.body)) ;
      CrLf (req)
    END ;
    CrLf (req) ;
    (* The request goes out as its text's UTF-8 octets, as curl sends
       a UTF-8 path. *)
    SendAll (c, OCTETS (DynStr.View (req))) ;
    SendAll (c, rq.body) ;

    (* ---- the status line and the headers ---- *)
    ln := Line (c, line) ;
    IF ln < 12 THEN RAISE TransportError ('short response') END ;
    http11 := Text.BIs (line, 7, '1') ;
    rs.status := (I64 (Text.BAt (line, 9)) - 48) * 100 + (I64 (Text.BAt (line, 10)) - 48) * 10
                 + (I64 (Text.BAt (line, 11)) - 48) ;
    clen := -1 ; chunked := FALSE ; connClose := FALSE ; connKeep := FALSE ;
    hd := DynStr.New (scratch) ;
    LOOP
      ln := Line (c, line) ;
      IF ln = -2 THEN RAISE TransportError ('header line too long') END ;
      IF ln <= 0 THEN EXIT END ;
      IF rq.keepHdrs THEN
        DynStr.Append (hd, line) ;
        DynStr.AppendChar (hd, 0AC)
      END ;
      IF HeaderIs (line, 'content-length:') THEN
        clen := Digits (HeaderVal (line, 15))
      ELSIF HeaderIs (line, 'transfer-encoding:') THEN
        (* chunked is the only one this speaks; anything else is
           refused rather than read as though it were identity. *)
        IF HeaderIs (HeaderVal (line, 18), 'chunked') THEN
          chunked := TRUE
        ELSE
          RAISE TransportError ('unsupported transfer-encoding')
        END
      ELSIF HeaderIs (line, 'connection:') THEN
        val := HeaderVal (line, 11) ;
        IF HeaderIs (val, 'close') THEN connClose := TRUE END ;
        IF HeaderIs (val, 'keep-alive') THEN connKeep := TRUE END
      ELSIF HeaderIs (line, 'location:') THEN
        rs.loc := Cat1 (pool, HeaderVal (line, 9))
      ELSIF HeaderIs (line, 'set-cookie:') THEN
        (* This keeps name=value only, up to the first ';': the
           narrowing the GET forms state.  A Client reads the whole
           line from hdrs. *)
        val := HeaderVal (line, 11) ;
        i := 0 ;
        WHILE i < Text.BLen (val) AND NOT Text.BIs (val, i, ';') DO i := i + 1 END ;
        rs.setCookie := Cat1 (pool, SLICE (val, 0, i))
      END
    END ;
    IF rq.keepHdrs THEN rs.hdrs := Cat1 (pool, DynStr.View (hd)) END ;

    (* ---- the body ---- *)
    opened := FALSE ; ended := FALSE ; sunk := 0 ;
    acc := DynStr.New (pool) ;
    blk := NEW (scratch, BYTE, IoBlock) ;
    held := 0 ;
    want := clen ;
    IF chunked THEN want := 0 END ;
    (* No body follows a HEAD's headers, nor a 1xx, 204 or 304 (RFC
       9110 par 6.4.1), whatever Content-Length says.  Waiting for one
       would hang until the server tires of the connection. *)
    noBody := Text.Eq (rq.method, 'HEAD') OR rs.status < 200 OR
              rs.status = 204 OR rs.status = 304 ;
    IF noBody THEN chunked := FALSE ; want := 0 END ;
    first := TRUE ;
    LOOP
      IF chunked AND want = 0 THEN
        IF NOT first THEN
          ln := Line (c, line)          (* the chunk's CRLF *)
        END ;
        first := FALSE ;
        ln := Line (c, line) ;
        IF ln < 0 THEN EXIT END ;
        i := 0 ;
        WHILE i < Text.BLen (line) AND NOT Text.BIs (line, i, ';') DO i := i + 1 END ;
        want := HexVal (SLICE (line, 0, i)) ;
        IF want = 0 THEN ended := TRUE ; EXIT END
      END ;
      IF want < 0 THEN
        got := Pull (c, blk, held, IoBlock - held)   (* to end of stream *)
      ELSE
        n := IoBlock - held ;
        IF n > want THEN n := want END ;
        got := Pull (c, blk, held, n) ;
        want := want - got
      END ;
      IF got = 0 AND (want <= 0 OR c.eof) THEN
        IF NOT chunked THEN EXIT END ;
        IF want > 0 THEN EXIT END
      END ;
      IF got = 0 AND NOT chunked THEN EXIT END ;
      held := held + got ;
      rs.bytes := rs.bytes + got ;
      IF rq.toFile AND rs.status = 200 THEN
        (* Only a 200's body reaches dest: a 404's error page written
           there read as the fixture on the next run (cp-kernel's
           issue 7, 2026-10-09).  Any other status drains the body
           and leaves dest as it was. *)
        IF held >= IoBlock THEN
          IF opened THEN
            Io.AppendFileBytes (rq.dest, SLICE (blk, 0, held))
          ELSE
            Io.WriteFileBytes (rq.dest, SLICE (blk, 0, held)) ;
            opened := TRUE
          END ;
          held := 0
        END
      ELSIF rq.toSink THEN
        (* This is the honest one-shot reader: a body that does not
           fit is refused, never cut to fit. *)
        IF sunk + held > LEN (sink) THEN
          RAISE TransportError ('the body is larger than the buffer')
        END ;
        FOR i := 0 TO held - 1 DO sink[sunk + i] := blk[i] END ;
        sunk := sunk + held ;
        held := 0
      ELSE
        IF rs.bytes > rq.cap THEN
          RAISE TransportError ('the document is larger than the cap')
        END ;
        FOR i := 0 TO held - 1 DO
          DynStr.AppendChar (acc, CHR (I64 (blk[i])))
        END ;
        held := 0
      END
    END ;
    (* a body that stopped short of what its framing promised is not
       the body: the connection was lost, and the bytes that did come
       are a prefix nobody asked for.  Until 2026-10-02 they were
       answered as a 200 of ten bytes where a hundred were stated, as
       measured.  Python raises IncompleteRead. *)
    IF chunked AND NOT ended THEN
      RAISE TransportError ('the body ended before its last chunk')
    END ;
    IF NOT chunked AND clen >= 0 AND want > 0 THEN
      RAISE TransportError ('the body ended before its Content-Length')
    END ;
    IF rq.toFile THEN
      IF rs.status # 200 THEN
        rs.bytes := 0
      ELSIF opened THEN
        Io.AppendFileBytes (rq.dest, SLICE (blk, 0, held))
      ELSE
        Io.WriteFileBytes (rq.dest, SLICE (blk, 0, held))
      END
    ELSIF NOT rq.toSink THEN
      rs.text := DynStr.ViewIn (pool, acc)
    END ;
    (* This reads the trailer after the last chunk, through its empty
       line.  If it were left unread, the next response on a kept
       connection would begin with a blank line and read as `short
       response`. *)
    IF ended THEN
      LOOP
        ln := Line (c, line) ;
        IF ln <= 0 THEN EXIT END
      END
    END ;
    rs.keepable := rq.keep AND NOT connClose AND (http11 OR connKeep)
                   AND (chunked OR clen >= 0 OR noBody) AND NOT c.eof ;
    done := TRUE
  FINALLY
    (* The connection is closed on success unless it is being kept,
       and on RAISE always.  A connection that failed mid-response has
       nothing on it a next request could use. *)
    IF NOT (done AND rs.keepable) THEN CloseConn (c) END
  END
END Once ;

(* ---- following the chain ------------------------------------------ *)
PROCEDURE Follow (VAR pool: POOL ; RO url: STR ; RO accept: STR ;
                  RO cookie: STR ; RO dest: STR ; toFile: BOOL ;
                  cap: I64 ; VAR bytes: I64 ; VAR text: STR) : I64
  RAISES TransportError, Io.IOError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  c : Conn ;
  rq : Req ;
  rs : Resp ;
  secure : BOOL ;
  host, path, ck : STR ;
  port, hop : I64 ;
  none : SLICE OF BYTE ;
BEGIN
  ck := cookie ;
  SplitUrl (pool, url, secure, host, port, path) ;
  rq.method := 'GET' ; rq.extra := '' ; rq.body := none ;
  rq.accept := accept ; rq.dest := dest ; rq.toFile := toFile ;
  rq.toSink := FALSE ; rq.keepHdrs := FALSE ; rq.keep := FALSE ;
  rq.cap := cap ;
  FOR hop := 0 TO MaxHop DO
    rq.host := host ; rq.port := port ; rq.path := path ; rq.cookie := ck ;
    OpenConn (scratch, c, secure, host, port) ;
    Once (pool, c, rq, none, rs) ;
    bytes := rs.bytes ; text := rs.text ;
    IF rs.status < 300 OR rs.status > 399 OR Text.BLen (rs.loc) = 0 THEN
      RETURN rs.status
    END ;
    IF hop = MaxHop THEN
      RAISE TransportError ('too many redirects')
    END ;
    (* A RELATIVE Location keeps the CURRENT ORIGIN -- scheme, host
       AND PORT.  The origin is carried as three values rather than
       re-spelled as a URL and re-parsed, because the first version
       did re-spell it and DROPPED THE PORT: against a fixture on
       18991 the licence redirect went to port 80 and answered
       `connect failed`, which reads like the server being down. *)
    IF Text.BIs (rs.loc, 0, '/') THEN
      path := rs.loc
    ELSE
      SplitUrl (pool, rs.loc, secure, host, port, path)
    END ;
    IF Text.BLen (rs.setCookie) > 0 THEN ck := rs.setCookie END
  END ;
  RETURN rs.status
END Follow ;

(* ---- the one-shot forms --------------------------------------------

   Get and GetTls are Once in sink mode over a connection of their
   own: HTTP/1.1 with Connection: close, Content-Length honoured,
   chunked decoded, and a body the caller's slice cannot hold refused
   by name.  Before 2026-09-27 this was a separate HTTP/1.0 reader
   with a 4 MB receive buffer that truncated silently.             *)
PROCEDURE Fetch (secure: BOOL ; RO host: STR ; port: I64 ;
                 RO path: STR ;
                 body: SLICE OF BYTE ;
                 VAR bodyLen: I64) : I64
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  c : Conn ;
  rq : Req ;
  rs : Resp ;
  sink, none : SLICE OF BYTE ;
BEGIN
  bodyLen := 0 ;
  rq.method := 'GET' ; rq.host := host ; rq.port := port ; rq.path := path ;
  rq.extra := '' ; rq.accept := '' ; rq.cookie := '' ; rq.dest := '' ;
  rq.body := none ; rq.toFile := FALSE ; rq.toSink := TRUE ;
  rq.keepHdrs := FALSE ; rq.keep := FALSE ; rq.cap := 0 ;
  sink := body ;
  OpenConn (scratch, c, secure, host, port) ;
  Once (scratch, c, rq, sink, rs) ;
  bodyLen := rs.bytes ;
  RETURN rs.status
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
| Io.IOError (p) : RAISE TransportError ('unexpected file error')
END Fetch ;

PROCEDURE Get (RO host: STR ; port: I64 ;
               RO path: STR ;
               body: SLICE OF BYTE ;
               VAR bodyLen: I64) : I64
  RAISES TransportError, ValueRange =
BEGIN
  RETURN Fetch (FALSE, host, port, path, body, bodyLen)
END Get ;

PROCEDURE GetTls (RO host: STR ; port: I64 ;
                  RO path: STR ;
                  body: SLICE OF BYTE ;
                  VAR bodyLen: I64) : I64
  RAISES TransportError, ValueRange =
BEGIN
  RETURN Fetch (TRUE, host, port, path, body, bodyLen)
END GetTls ;

(* ---- the general request ------------------------------------------ *)

PROCEDURE Request (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                   RO headers: STR ; RO body: SLICE OF BYTE ;
                   cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : SLICE OF BYTE
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  c : Conn ;
  rq : Req ;
  rs : Resp ;
  secure : BOOL ;
  host, path : STR ;
  port : I64 ;
  none : SLICE OF BYTE ;
BEGIN
  IF Text.BLen (method) = 0 THEN RAISE TransportError ('no method') END ;
  SplitUrl (pool, url, secure, host, port, path) ;
  rq.method := method ; rq.host := host ; rq.port := port ; rq.path := path ;
  rq.extra := headers ; rq.body := body ;
  rq.accept := '' ; rq.cookie := '' ; rq.dest := '' ;
  rq.toFile := FALSE ; rq.toSink := FALSE ; rq.keepHdrs := TRUE ;
  rq.keep := FALSE ; rq.cap := cap ;
  OpenConn (scratch, c, secure, host, port) ;
  Once (pool, c, rq, none, rs) ;
  status := rs.status ; respHeaders := rs.hdrs ;
  (* the accumulator holds octets, one per scalar *)
  RETURN DynStr.Bytes (pool, rs.text, FALSE)
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
| Io.IOError (p) : RAISE TransportError ('unexpected file error')
END Request ;

PROCEDURE GetToFile (VAR pool: POOL ; RO url: STR ; RO accept: STR ;
                     RO cookie: STR ; RO dest: STR ; VAR bytes: I64)
  : I64
  RAISES TransportError, Io.IOError, ValueRange =
VAR text : STR ;
BEGIN
  RETURN Follow (pool, url, accept, cookie, dest, TRUE, 0, bytes, text)
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
END GetToFile ;

PROCEDURE GetText (VAR pool: POOL ; RO url: STR ; RO accept: STR ;
                   RO cookie: STR ; cap: I64 ; VAR status: I64) : STR
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  text : STR ;
  bytes : I64 ;
BEGIN
  status := Follow (pool, url, accept, cookie, '', FALSE, cap, bytes,
                    text) ;
  (* the accumulator holds OCTETS, one per scalar; the document is
     UTF-8 and the caller wants text *)
  RETURN UTF (pool, DynStr.Bytes (scratch, text, FALSE))
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
| Io.IOError (p) : RAISE TransportError ('unexpected file error')
END GetText ;

PROCEDURE RequestText (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                       RO headers: STR ; RO text: STR ; cap: I64 ;
                       VAR status: I64 ; VAR respHeaders: STR) : STR
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  raw : SLICE OF BYTE ;
BEGIN
  raw := Request (pool, method, url, headers, OCTETS (text),
                  cap, status, respHeaders) ;
  RETURN UTF (pool, raw)
END RequestText ;

PROCEDURE Header (RO headers: STR ; RO name: STR) : STR
  RAISES ValueRange =
VAR
  k, i, colon, j : I64 ;
  line : STR ;
  same : BOOL ;
BEGIN
  k := 0 ;
  WHILE k < Text.BLen (headers) DO
    i := k ;
    WHILE i < Text.BLen (headers) AND I64 (Text.BAt (headers, i)) # 10 DO i := i + 1 END ;
    line := SLICE (headers, k, i - k) ;
    colon := 0 ;
    WHILE colon < Text.BLen (line) AND NOT Text.BIs (line, colon, ':') DO colon := colon + 1 END ;
    IF colon > 0 AND colon = Text.BLen (name) AND colon < Text.BLen (line) THEN
      same := TRUE ;
      FOR j := 0 TO colon - 1 DO
        IF Lower (I64 (Text.BAt (line, j))) # Lower (I64 (Text.BAt (name, j))) THEN
          same := FALSE
        END
      END ;
      IF same THEN RETURN HeaderVal (line, colon + 1) END
    END ;
    k := i + 1
  END ;
  RETURN ''
END Header ;

(* ---- the Client ---------------------------------------------------- *)

PROCEDURE NewClient (VAR pool: POOL) : PTR Client IN pool =
VAR cl : PTR Client IN pool ;
BEGIN
  cl := NEW (pool, Client) ;
  cl.cookies := NEW (pool, Cookie, 8) ;
  cl.n := 0 ;
  cl.open := FALSE ; cl.secure := FALSE ; cl.host := '' ; cl.port := 0 ;
  cl.kept := 0 ;
  cl.c.fd := -1 ;
  RETURN cl
END NewClient ;

PROCEDURE EqNoCase (RO a: STR ; RO b: STR) : BOOL
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  IF Text.BLen (a) # Text.BLen (b) THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (a) - 1 DO
    IF Lower (I64 (Text.BAt (a, i))) # Lower (I64 (Text.BAt (b, i))) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END EqNoCase ;

(* InDomain follows RFC 6265 5.1.3: host is domain, or ends with '.'
   followed by it. *)
PROCEDURE InDomain (RO host: STR ; RO domain: STR) : BOOL
  RAISES ValueRange =
VAR d : I64 ;
BEGIN
  IF EqNoCase (host, domain) THEN RETURN TRUE END ;
  d := Text.BLen (host) - Text.BLen (domain) ;
  IF d < 2 THEN RETURN FALSE END ;
  IF NOT Text.BIs (host, d - 1, '.') THEN RETURN FALSE END ;
  RETURN EqNoCase (SLICE (host, d, Text.BLen (domain)), domain)
END InDomain ;

(* OnPath follows RFC 6265 5.1.4: the request path is the cookie's,
   or extends it at a '/' boundary. *)
PROCEDURE OnPath (RO reqPath: STR ; RO cpath: STR) : BOOL
  RAISES ValueRange =
BEGIN
  IF Text.BLen (cpath) = 0 THEN RETURN TRUE END ;
  IF Text.BLen (cpath) > Text.BLen (reqPath) THEN RETURN FALSE END ;
  IF NOT Text.Eq (SLICE (reqPath, 0, Text.BLen (cpath)), cpath) THEN
    RETURN FALSE
  END ;
  IF Text.BLen (cpath) = Text.BLen (reqPath) THEN RETURN TRUE END ;
  IF Text.BIs (cpath, Text.BLen (cpath) - 1, '/') THEN RETURN TRUE END ;
  RETURN Text.BIs (reqPath, Text.BLen (cpath), '/')
END OnPath ;

(* PathOnly answers the path without its query. *)
PROCEDURE PathOnly (RO path: STR) : STR
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (path) AND NOT Text.BIs (path, i, '?') DO i := i + 1 END ;
  RETURN SLICE (path, 0, i)
END PathOnly ;

(* DefaultPath follows RFC 6265 5.1.4: it answers up to but not
   including the last '/', or '/'. *)
PROCEDURE DefaultPath (RO path: STR) : STR
  RAISES ValueRange =
VAR i, last : I64 ;  p : STR ;
BEGIN
  p := PathOnly (path) ;
  IF Text.BLen (p) = 0 OR NOT Text.BIs (p, 0, '/') THEN RETURN '/' END ;
  last := 0 ;
  FOR i := 0 TO Text.BLen (p) - 1 DO
    IF Text.BIs (p, i, '/') THEN last := i END
  END ;
  IF last = 0 THEN RETURN '/' END ;
  RETURN SLICE (p, 0, last)
END DefaultPath ;

PROCEDURE AllDigits (RO s: STR) : BOOL
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  IF Text.BLen (s) = 0 THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF I64 (Text.BAt (s, i)) < ORD ('0') OR I64 (Text.BAt (s, i)) > ORD ('9') THEN RETURN FALSE END
  END ;
  RETURN TRUE
END AllDigits ;

(* MonthOf answers 1..12 from the first three letters of a month
   name, 0 otherwise. *)
PROCEDURE MonthOf (RO tok: STR) : I64
  RAISES ValueRange =
VAR m : STR ;
BEGIN
  IF Text.BLen (tok) < 3 THEN RETURN 0 END ;
  m := SLICE (tok, 0, 3) ;
  IF EqNoCase (m, 'jan') THEN RETURN 1 END ;
  IF EqNoCase (m, 'feb') THEN RETURN 2 END ;
  IF EqNoCase (m, 'mar') THEN RETURN 3 END ;
  IF EqNoCase (m, 'apr') THEN RETURN 4 END ;
  IF EqNoCase (m, 'may') THEN RETURN 5 END ;
  IF EqNoCase (m, 'jun') THEN RETURN 6 END ;
  IF EqNoCase (m, 'jul') THEN RETURN 7 END ;
  IF EqNoCase (m, 'aug') THEN RETURN 8 END ;
  IF EqNoCase (m, 'sep') THEN RETURN 9 END ;
  IF EqNoCase (m, 'oct') THEN RETURN 10 END ;
  IF EqNoCase (m, 'nov') THEN RETURN 11 END ;
  IF EqNoCase (m, 'dec') THEN RETURN 12 END ;
  RETURN 0
END MonthOf ;

(* TimeOf reads hh:mm:ss, each one or two digits. *)
PROCEDURE TimeOf (RO tok: STR ; VAR hh: I64 ; VAR mm: I64 ;
                  VAR ss: I64) : BOOL
  RAISES ValueRange =
VAR a, b : I64 ;
BEGIN
  a := 0 ;
  WHILE a < Text.BLen (tok) AND NOT Text.BIs (tok, a, ':') DO a := a + 1 END ;
  IF a >= Text.BLen (tok) THEN RETURN FALSE END ;
  b := a + 1 ;
  WHILE b < Text.BLen (tok) AND NOT Text.BIs (tok, b, ':') DO b := b + 1 END ;
  IF b >= Text.BLen (tok) THEN RETURN FALSE END ;
  IF NOT (AllDigits (SLICE (tok, 0, a)) AND
          AllDigits (SLICE (tok, a + 1, b - a - 1)) AND
          AllDigits (SLICE (tok, b + 1, Text.BLen (tok) - b - 1))) THEN
    RETURN FALSE
  END ;
  IF a > 2 OR b - a - 1 > 2 OR Text.BLen (tok) - b - 1 > 2 THEN RETURN FALSE END ;
  hh := Digits (SLICE (tok, 0, a)) ;
  mm := Digits (SLICE (tok, a + 1, b - a - 1)) ;
  ss := Digits (SLICE (tok, b + 1, Text.BLen (tok) - b - 1)) ;
  RETURN TRUE
END TimeOf ;

(* DaysFromCivil answers days since 1970-01-01 of a proleptic
   Gregorian date: Howard Hinnant's algorithm, the same one
   Time.DaysFromCivil carries.  It is a local copy rather than an
   import, because Time would bring Fmt into every link line that
   names Http.c, for one comparison. *)
PROCEDURE DaysFromCivil (y: I64 ; m: I64 ; d: I64) : I64 =
VAR yy, era, yoe, doy, doe, mp : I64 ;
BEGIN
  yy := y ;
  IF m <= 2 THEN yy := yy - 1 END ;
  IF yy >= 0 THEN era := yy DIV 400 ELSE era := (yy - 399) DIV 400 END ;
  yoe := yy - era * 400 ;
  IF m > 2 THEN mp := m - 3 ELSE mp := m + 9 END ;
  doy := (153 * mp + 2) DIV 5 + d - 1 ;
  doe := yoe * 365 + yoe DIV 4 - yoe DIV 100 + doy ;
  RETURN era * 146097 + doe - 719468
END DaysFromCivil ;

(* an HTTP-date -- `Sun, 06 Nov 1994 08:49:37 GMT`, or the older
   `Sunday, 06-Nov-94 08:49:37 GMT` -- as seconds since the epoch,
   the tolerant way RFC 6265 5.1.1 prescribes: the fields are found
   by shape (a time, a day, a month name, a year) in any order and
   whatever surrounds them is skipped.  -1.0 when they are not all
   there or make no date. *)
PROCEDURE FormatDate (secs: I64) : STR RAISES ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  days, rem, z, era, doe, yoe, y, doy, mp, dd, m, wd : I64 ;
BEGIN
  days := secs DIV 86400 ;
  rem := secs MOD 86400 ;
  IF rem < 0 THEN
    rem := rem + 86400 ;
    days := days - 1
  END ;
  wd := (days + 4) MOD 7 ;               (* 0 = Sunday; 1970-01-01, day 0,
                                            was a Thursday *)
  IF wd < 0 THEN wd := wd + 7 END ;
  (* This is Hinnant's days-to-civil, as Time.CivilFromDays.  It is
     repeated so that Http's closure stays DynStr and Io. *)
  z := days + 719468 ;
  era := z DIV 146097 ;
  IF z < 0 AND z MOD 146097 # 0 THEN era := era - 1 END ;
  doe := z - era * 146097 ;
  yoe := (doe - doe DIV 1460 + doe DIV 36524 - doe DIV 146096) DIV 365 ;
  y := yoe + era * 400 ;
  doy := doe - (365 * yoe + yoe DIV 4 - yoe DIV 100) ;
  mp := (5 * doy + 2) DIV 153 ;
  dd := doy - (153 * mp + 2) DIV 5 + 1 ;
  IF mp < 10 THEN m := mp + 3 ELSE m := mp - 9 END ;
  IF m <= 2 THEN y := y + 1 END ;
  IF y < 1 OR y > 9999 THEN RAISE ValueRange END ;
  d := DynStr.New (scratch) ;
  DynStr.Append (d, SLICE ('SunMonTueWedThuFriSat', 3 * wd, 3)) ;
  DynStr.Append (d, ', ') ;
  Two (d, dd) ;
  DynStr.AppendChar (d, ' ') ;
  DynStr.Append (d, SLICE ('JanFebMarAprMayJunJulAugSepOctNovDec', 3 * (m - 1), 3)) ;
  DynStr.AppendChar (d, ' ') ;
  IF y < 1000 THEN DynStr.AppendChar (d, '0') END ;
  IF y < 100 THEN DynStr.AppendChar (d, '0') END ;
  IF y < 10 THEN DynStr.AppendChar (d, '0') END ;
  DynStr.AppendI64 (d, y) ;
  DynStr.AppendChar (d, ' ') ;
  Two (d, rem DIV 3600) ;
  DynStr.AppendChar (d, ':') ;
  Two (d, (rem MOD 3600) DIV 60) ;
  DynStr.AppendChar (d, ':') ;
  Two (d, rem MOD 60) ;
  DynStr.Append (d, ' GMT') ;
  RETURN DynStr.View (d)
END FormatDate ;

PROCEDURE Two (VAR d: PTR DynStr.DString ; v: I64) =
BEGIN
  IF v < 10 THEN DynStr.AppendChar (d, '0') END ;
  DynStr.AppendI64 (d, v)
END Two ;

PROCEDURE HttpDate (RO s: STR) : F64
  RAISES ValueRange =
VAR
  i, j, day, month, year, hh, mm, ss : I64 ;
  tok : STR ;
  haveDay, haveMonth, haveYear, haveTime : BOOL ;
BEGIN
  day := 0 ; month := 0 ; year := 0 ; hh := 0 ; mm := 0 ; ss := 0 ;
  haveDay := FALSE ; haveMonth := FALSE ; haveYear := FALSE ;
  haveTime := FALSE ;
  i := 0 ;
  LOOP
    WHILE i < Text.BLen (s) AND (Text.BIs (s, i, ' ') OR Text.BIs (s, i, ',') OR Text.BIs (s, i, '-') OR
                            I64 (Text.BAt (s, i)) = 9) DO
      i := i + 1
    END ;
    j := i ;
    WHILE j < Text.BLen (s) AND NOT (Text.BIs (s, j, ' ') OR Text.BIs (s, j, ',') OR Text.BIs (s, j, '-') OR
                                I64 (Text.BAt (s, j)) = 9) DO
      j := j + 1
    END ;
    IF j = i THEN EXIT END ;
    tok := SLICE (s, i, j - i) ;
    i := j ;
    IF NOT haveTime AND TimeOf (tok, hh, mm, ss) THEN
      haveTime := TRUE
    ELSIF NOT haveDay AND Text.BLen (tok) <= 2 AND AllDigits (tok) THEN
      day := Digits (tok) ; haveDay := TRUE
    ELSIF NOT haveMonth AND MonthOf (tok) > 0 THEN
      month := MonthOf (tok) ; haveMonth := TRUE
    ELSIF NOT haveYear AND (Text.BLen (tok) = 2 OR Text.BLen (tok) = 4) AND
          AllDigits (tok) THEN
      year := Digits (tok) ; haveYear := TRUE
    END
  END ;
  IF NOT (haveDay AND haveMonth AND haveYear AND haveTime) THEN
    RETURN -1.0
  END ;
  IF year >= 70 AND year <= 99 THEN year := year + 1900 END ;
  IF year < 70 THEN year := year + 2000 END ;
  IF year < 1601 OR day < 1 OR day > 31 OR hh > 23 OR mm > 59 OR
     ss > 59 THEN
    RETURN -1.0
  END ;
  RETURN F64 (DaysFromCivil (year, month, day)) * 86400.0
         + F64 (hh * 3600 + mm * 60 + ss)
END HttpDate ;

PROCEDURE Find (cl: PTR Client ; RO name: STR ; RO domain: STR ;
                RO path: STR) : I64
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO cl.n - 1 DO
    IF Text.Eq (cl.cookies[i].name, name) AND
       EqNoCase (cl.cookies[i].domain, domain) AND
       Text.Eq (cl.cookies[i].path, path) THEN
      RETURN i
    END
  END ;
  RETURN -1
END Find ;

PROCEDURE Remove (VAR cl: PTR Client ; k: I64) =
VAR i : I64 ;
BEGIN
  FOR i := k TO cl.n - 2 DO cl.cookies[i] := cl.cookies[i + 1] END ;
  cl.n := cl.n - 1
END Remove ;

(* Grow makes room for one more: it doubles the slice up to JarMax,
   and past that the oldest cookie leaves. *)
PROCEDURE Grow (VAR cl: PTR Client) =
VAR
  nw : SLICE OF Cookie ;
  i, n2 : I64 ;
BEGIN
  IF cl.n < LEN (cl.cookies) THEN RETURN END ;
  IF LEN (cl.cookies) >= JarMax THEN
    Remove (cl, 0) ;
    RETURN
  END ;
  n2 := 2 * LEN (cl.cookies) ;
  IF n2 > JarMax THEN n2 := JarMax END ;
  nw := NEW (cl, Cookie, n2) ;
  FOR i := 0 TO cl.n - 1 DO nw[i] := cl.cookies[i] END ;
  cl.cookies := nw
END Grow ;

(* Store puts one Set-Cookie line (after the header name) into the
   jar, RFC 6265 5.2 and 5.3 as the definition states them. *)
PROCEDURE Store (VAR pool: POOL ; VAR cl: PTR Client ; RO line: STR ;
                 RO host: STR ; RO reqPath: STR ; now: F64)
  RAISES ValueRange =
VAR
  i, j, eq, k : I64 ;
  name, value, domain, path, attr, aval : STR ;
  hostOnly, secure, haveMaxAge : BOOL ;
  expires, t : F64 ;
  ck : Cookie ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (line) AND NOT Text.BIs (line, i, ';') DO i := i + 1 END ;
  eq := 0 ;
  WHILE eq < i AND NOT Text.BIs (line, eq, '=') DO eq := eq + 1 END ;
  IF eq >= i THEN RETURN END ;                 (* no '=': not a cookie *)
  name := HeaderVal (SLICE (line, 0, eq), 0) ;
  value := HeaderVal (SLICE (line, eq + 1, i - eq - 1), 0) ;
  IF Text.BLen (name) = 0 THEN RETURN END ;
  domain := '' ; path := '' ; hostOnly := TRUE ; secure := FALSE ;
  expires := 0.0 ; haveMaxAge := FALSE ;
  WHILE i < Text.BLen (line) DO
    i := i + 1 ;                                (* past the ';' *)
    j := i ;
    WHILE j < Text.BLen (line) AND NOT Text.BIs (line, j, ';') DO j := j + 1 END ;
    attr := HeaderVal (SLICE (line, i, j - i), 0) ;
    k := 0 ;
    WHILE k < Text.BLen (attr) AND NOT Text.BIs (attr, k, '=') DO k := k + 1 END ;
    IF k < Text.BLen (attr) THEN
      aval := HeaderVal (SLICE (attr, k + 1, Text.BLen (attr) - k - 1), 0)
    ELSE
      aval := ''
    END ;
    attr := SLICE (attr, 0, k) ;
    IF EqNoCase (attr, 'domain') THEN
      IF Text.BLen (aval) > 0 AND Text.BIs (aval, 0, '.') THEN
        aval := SLICE (aval, 1, Text.BLen (aval) - 1)
      END ;
      IF Text.BLen (aval) > 0 THEN domain := aval ; hostOnly := FALSE END
    ELSIF EqNoCase (attr, 'path') THEN
      IF Text.BLen (aval) > 0 AND Text.BIs (aval, 0, '/') THEN path := aval END
    ELSIF EqNoCase (attr, 'max-age') THEN
      (* Max-Age wins over Expires whichever came first; zero or
         negative means gone already *)
      IF Text.BLen (aval) > 0 THEN
        IF Text.BIs (aval, 0, '-') OR Digits (aval) = 0 THEN
          expires := 1.0
        ELSE
          expires := now + F64 (Digits (aval))
        END ;
        haveMaxAge := TRUE
      END
    ELSIF EqNoCase (attr, 'expires') THEN
      IF NOT haveMaxAge THEN
        t := HttpDate (aval) ;
        IF t >= 0.0 THEN
          expires := t ;
          IF t < 1.0 THEN expires := 1.0 END
        END
      END
    ELSIF EqNoCase (attr, 'secure') THEN
      secure := TRUE
    END ;
    i := j
  END ;
  IF hostOnly THEN
    domain := host
  ELSIF NOT InDomain (host, domain) THEN
    RETURN                                      (* not ours to keep *)
  END ;
  IF Text.BLen (path) = 0 THEN path := DefaultPath (reqPath) END ;
  k := Find (cl, name, domain, path) ;
  IF expires > 0.0 AND expires <= now THEN
    (* an expired cookie deletes its predecessor and is not kept *)
    IF k >= 0 THEN Remove (cl, k) END ;
    RETURN
  END ;
  ck.name := Cat1 (pool, name) ;
  ck.value := Cat1 (pool, value) ;
  ck.domain := Cat1 (pool, domain) ;
  ck.path := Cat1 (pool, path) ;
  ck.hostOnly := hostOnly ; ck.secure := secure ; ck.expires := expires ;
  IF k >= 0 THEN
    cl.cookies[k] := ck ;
    RETURN
  END ;
  Grow (cl) ;
  cl.cookies[cl.n] := ck ;
  cl.n := cl.n + 1
END Store ;

PROCEDURE Matches (cl: PTR Client ; i: I64 ; secure: BOOL ;
                   RO host: STR ; RO p: STR) : BOOL
  RAISES ValueRange =
BEGIN
  IF cl.cookies[i].secure AND NOT secure THEN RETURN FALSE END ;
  IF cl.cookies[i].hostOnly THEN
    IF NOT EqNoCase (cl.cookies[i].domain, host) THEN RETURN FALSE END
  ELSIF NOT InDomain (host, cl.cookies[i].domain) THEN
    RETURN FALSE
  END ;
  RETURN OnPath (p, cl.cookies[i].path)
END Matches ;

(* CookieHeader answers the Cookie header line for this request, with
   its line feed, or ''.  Expired cookies leave the jar first, and the
   matches go longest path first, ties in arrival order (RFC 6265
   5.4). *)
PROCEDURE CookieHeader (VAR cl: PTR Client ;
                        secure: BOOL ; RO host: STR ; RO reqPath: STR ;
                        now: F64) : STR
  RAISES ValueRange =
VAR
  pool : POOL ;
  d : PTR DynStr.DString IN pool ;
  sent : ARRAY JarMax OF BOOL ;
  i, best, count : I64 ;
  p : STR ;
BEGIN
  i := 0 ;
  WHILE i < cl.n DO
    IF cl.cookies[i].expires > 0.0 AND cl.cookies[i].expires <= now THEN
      Remove (cl, i)
    ELSE
      i := i + 1
    END
  END ;
  p := PathOnly (reqPath) ;
  FOR i := 0 TO JarMax - 1 DO sent[i] := FALSE END ;
  d := DynStr.New (pool) ;
  count := 0 ;
  LOOP
    best := -1 ;
    FOR i := 0 TO cl.n - 1 DO
      IF NOT sent[i] AND Matches (cl, i, secure, host, p) THEN
        IF best < 0 OR
           Text.BLen (cl.cookies[i].path) > Text.BLen (cl.cookies[best].path) THEN
          best := i
        END
      END
    END ;
    IF best < 0 THEN EXIT END ;
    sent[best] := TRUE ;
    IF count = 0 THEN
      DynStr.Append (d, 'Cookie: ')
    ELSE
      DynStr.Append (d, '; ')
    END ;
    DynStr.Append (d, cl.cookies[best].name) ;
    DynStr.AppendChar (d, '=') ;
    DynStr.Append (d, cl.cookies[best].value) ;
    count := count + 1
  END ;
  IF count = 0 THEN RETURN '' END ;
  DynStr.AppendChar (d, 0AC) ;
  RETURN DynStr.View (d)
END CookieHeader ;

(* Attempt is Once on the Client's connection, answering FALSE
   instead of raising when a KEPT connection failed before a byte of a
   response arrived.  The server closed it while idle, and the request
   can go again. *)
PROCEDURE Attempt (VAR pool: POOL ; VAR c: Conn ; RO rq: Req ;
                   VAR sink: SLICE OF BYTE ; VAR rs: Resp ;
                   fresh: BOOL) : BOOL
  RAISES TransportError, Io.IOError, ValueRange, IndexError =
BEGIN
  Once (pool, c, rq, sink, rs) ;
  RETURN TRUE
EXCEPT
| TransportError (m) :
    IF fresh OR c.gotAny THEN RAISE TransportError (m) END ;
    RETURN FALSE
END Attempt ;

PROCEDURE Send (VAR pool: POOL ; VAR cl: PTR Client ; RO method: STR ;
                RO url: STR ; RO headers: STR ; RO body: SLICE OF BYTE ;
                cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : SLICE OF BYTE
  RAISES TransportError, ValueRange =
VAR
  rq : Req ;
  rs : Resp ;
  secure, fresh, ok : BOOL ;
  host, path, ck : STR ;
  port, tries, i, k : I64 ;
  none : SLICE OF BYTE ;
  now : F64 ;
BEGIN
  IF Text.BLen (method) = 0 THEN RAISE TransportError ('no method') END ;
  SplitUrl (pool, url, secure, host, port, path) ;
  now := F64 (NowSec ()) ;
  ck := CookieHeader (cl, secure, host, path, now) ;
  rq.method := method ; rq.host := host ; rq.port := port ; rq.path := path ;
  rq.extra := ck + headers ;
  rq.body := body ; rq.accept := '' ; rq.cookie := '' ; rq.dest := '' ;
  rq.toFile := FALSE ; rq.toSink := FALSE ; rq.keepHdrs := TRUE ;
  rq.keep := TRUE ; rq.cap := cap ;
  tries := 0 ;
  fresh := FALSE ;
  LOOP
    fresh := FALSE ;
    IF NOT cl.open OR cl.secure # secure OR cl.port # port OR
       NOT EqNoCase (cl.host, host) THEN
      IF cl.open THEN CloseConn (cl.c) ; cl.open := FALSE END ;
      OpenConn (pool, cl.c, secure, host, port) ;
      cl.open := TRUE ; cl.secure := secure ; cl.port := port ;
      cl.host := Cat1 (pool, host) ;
      fresh := TRUE
    ELSE
      (* nothing of the last response may be left unread; anything
         that is was not part of it *)
      cl.c.at := 0 ; cl.c.n := 0 ; cl.c.eof := FALSE
    END ;
    ok := Attempt (pool, cl.c, rq, none, rs, fresh) ;
    IF ok THEN EXIT END ;
    cl.open := FALSE ;
    tries := tries + 1 ;
    IF tries > 1 THEN RAISE TransportError ('connection lost') END
  END ;
  IF NOT fresh THEN cl.kept := cl.kept + 1 END ;
  cl.open := rs.keepable ;
  (* This puts every Set-Cookie line into the jar. *)
  k := 0 ;
  WHILE k < Text.BLen (rs.hdrs) DO
    i := k ;
    WHILE i < Text.BLen (rs.hdrs) AND I64 (Text.BAt (rs.hdrs, i)) # 10 DO i := i + 1 END ;
    IF HeaderIs (SLICE (rs.hdrs, k, i - k), 'set-cookie:') THEN
      Store (pool, cl, HeaderVal (SLICE (rs.hdrs, k, i - k), 11), host,
             path, now)
    END ;
    k := i + 1
  END ;
  status := rs.status ; respHeaders := rs.hdrs ;
  RETURN DynStr.Bytes (pool, rs.text, FALSE)
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
| Io.IOError (p) : RAISE TransportError ('unexpected file error')
END Send ;

PROCEDURE SendText (VAR pool: POOL ; VAR cl: PTR Client ; RO method: STR ;
                    RO url: STR ; RO headers: STR ; RO text: STR ;
                    cap: I64 ; VAR status: I64 ; VAR respHeaders: STR)
  : STR
  RAISES TransportError, ValueRange =
VAR
  scratch : POOL ;
  raw : SLICE OF BYTE ;
BEGIN
  raw := Send (pool, cl, method, url, headers, OCTETS (text),
               cap, status, respHeaders) ;
  RETURN UTF (pool, raw)
END SendText ;

PROCEDURE CloseClient (VAR cl: PTR Client)
  RAISES ValueRange =
BEGIN
  IF cl.open THEN CloseConn (cl.c) END ;
  cl.open := FALSE
END CloseClient ;

PROCEDURE Kept (cl: PTR Client) : I64 =
BEGIN
  RETURN cl.kept
END Kept ;

PROCEDURE CookieValue (cl: PTR Client ; RO name: STR) : STR
  RAISES ValueRange =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO cl.n - 1 DO
    IF Text.Eq (cl.cookies[i].name, name) THEN
      RETURN cl.cookies[i].value
    END
  END ;
  RETURN ''
END CookieValue ;

(* ---- trying again -------------------------------------------------- *)

PROCEDURE Backoff (failures: I64 ; factor: F64) : F64 =
VAR
  w : F64 ;
  k : I64 ;
BEGIN
  IF failures <= 1 OR NOT (factor > 0.0) THEN RETURN 0.0 END ;
  (* The wait is doubled, which is exact, and no further than the
     ceiling: two to the power of some hundreds is not a number to
     compute first. *)
  w := factor ;
  k := 1 ;
  WHILE k < failures AND w < MaxWait DO
    w := w * 2.0 ;
    k := k + 1
  END ;
  IF w > MaxWait THEN RETURN MaxWait END ;
  RETURN w
END Backoff ;

(* Idempotent answers TRUE for the methods RFC 9110 calls idempotent:
   asking twice is asking once. *)
PROCEDURE Idempotent (RO method: STR) : BOOL
  RAISES ValueRange =
BEGIN
  RETURN EqNoCase (method, 'GET') OR EqNoCase (method, 'HEAD') OR
         EqNoCase (method, 'PUT') OR EqNoCase (method, 'DELETE') OR
         EqNoCase (method, 'OPTIONS') OR EqNoCase (method, 'TRACE')
END Idempotent ;

PROCEDURE Retryable (RO method: STR ; status: I64 ;
                     hasRetryAfter: BOOL) : BOOL
  RAISES ValueRange =
BEGIN
  IF NOT Idempotent (method) THEN RETURN FALSE END ;
  IF status = 429 OR status = 500 OR status = 502 OR status = 503 OR
     status = 504 THEN
    RETURN TRUE
  END ;
  (* The server says a 413 is too large NOW, and when to come
     back. *)
  RETURN hasRetryAfter AND status = 413
END Retryable ;

PROCEDURE RetryAfter (RO headers: STR ; now: F64) : F64
  RAISES ValueRange =
VAR
  v : STR ;
  at : F64 ;
  n : I64 ;
BEGIN
  v := Header (headers, 'retry-after') ;
  IF Text.BLen (v) = 0 THEN RETURN -1.0 END ;
  IF AllDigits (v) THEN
    IF Text.BLen (v) > 15 THEN RETURN 1.0e15 END ;
    n := Digits (v) ;
    RETURN F64 (n)
  END ;
  at := HttpDate (v) ;
  IF at < 0.0 THEN RETURN -1.0 END ;
  IF at <= now THEN RETURN 0.0 END ;
  RETURN at - now
END RetryAfter ;

(* Shot makes one try, on a connection of its own.  It answers FALSE
   when the transport failed, with the reason: `made` says whether the
   connection was made (so the request may have gone out), and
   `answered` whether a byte of an answer came back. *)
PROCEDURE Shot (VAR pool: POOL ; RO rq: Req ; secure: BOOL ; port: I64 ;
                VAR rs: Resp ; VAR made: BOOL ; VAR answered: BOOL ;
                VAR why: STR) : BOOL
  RAISES Io.IOError, ValueRange, IndexError =
VAR
  scratch : POOL ;
  c : Conn ;
  none : SLICE OF BYTE ;
BEGIN
  made := FALSE ;
  answered := FALSE ;
  OpenConn (scratch, c, secure, rq.host, port) ;
  made := TRUE ;
  Once (pool, c, rq, none, rs) ;
  RETURN TRUE
EXCEPT
| TransportError (m) :
    why := m ;
    answered := c.gotAny ;
    RETURN FALSE
END Shot ;

PROCEDURE RequestRetry (VAR pool: POOL ; RO method: STR ; RO url: STR ;
                        RO headers: STR ; RO body: SLICE OF BYTE ;
                        cap: I64 ; retries: I64 ; factor: F64 ;
                        VAR status: I64 ; VAR respHeaders: STR ;
                        VAR tries: I64) : SLICE OF BYTE
  RAISES TransportError, ValueRange =
VAR
  rq : Req ;
  rs : Resp ;
  secure, ok, made, answered, again, has : BOOL ;
  host, path, why, ra : STR ;
  port, failures, ms : I64 ;
  wait, after : F64 ;
BEGIN
  tries := 0 ;
  IF Text.BLen (method) = 0 THEN RAISE TransportError ('no method') END ;
  SplitUrl (pool, url, secure, host, port, path) ;
  rq.method := method ; rq.host := host ; rq.port := port ; rq.path := path ;
  rq.extra := headers ; rq.body := body ;
  rq.accept := '' ; rq.cookie := '' ; rq.dest := '' ;
  rq.toFile := FALSE ; rq.toSink := FALSE ; rq.keepHdrs := TRUE ;
  rq.keep := FALSE ; rq.cap := cap ;
  failures := 0 ;
  why := '' ;
  LOOP
    tries := tries + 1 ;
    ok := Shot (pool, rq, secure, port, rs, made, answered, why) ;
    IF ok THEN
      ra := Header (rs.hdrs, 'retry-after') ;
      has := Text.BLen (ra) > 0 ;
      again := Retryable (method, rs.status, has) ;
      after := RetryAfter (rs.hdrs, F64 (NowSec ())) ;
      (* the last answer is the answer: not worth asking again, no
         tries left, or told to stay away for longer than this waits *)
      IF NOT again OR tries > retries OR after > MaxWait THEN EXIT END ;
      failures := failures + 1 ;
      wait := Backoff (failures, factor) ;
      IF after > 0.0 THEN wait := after END
    ELSE
      again := NOT made ;
      IF made AND NOT answered THEN again := Idempotent (method) END ;
      IF NOT again OR tries > retries THEN RAISE TransportError (why) END ;
      failures := failures + 1 ;
      wait := Backoff (failures, factor)
    END ;
    IF wait > 0.0 THEN
      ms := I64 (wait * 1000.0 + 0.5) ;
      SleepMs (C.SSizeT (ms))
    END
  END ;
  status := rs.status ; respHeaders := rs.hdrs ;
  (* the accumulator holds octets, one per scalar *)
  RETURN DynStr.Bytes (pool, rs.text, FALSE)
EXCEPT
| IndexError : RAISE TransportError ('a malformed response')
| Io.IOError (p) : RAISE TransportError ('unexpected file error')
END RequestRetry ;

(* ---- URL components -------------------------------------------------- *)

PROCEDURE Unreserved (b: I64) : BOOL =
  (* Unreserved follows RFC 3986 par 2.3, which is quote's `always
     safe' set. *)
BEGIN
  RETURN (b >= 65 AND b <= 90) OR (b >= 97 AND b <= 122) OR
         (b >= 48 AND b <= 57) OR b = 45 OR b = 46 OR b = 95 OR b = 126
END Unreserved ;

PROCEDURE HexDigit (v: I64) : CHAR RAISES ValueRange =
BEGIN
  IF v < 10 THEN RETURN CHR (48 + v) END ;
  RETURN CHR (55 + v)                     (* 'A' .. 'F' *)
END HexDigit ;

PROCEDURE HexOf (c: CHAR) : I64 =
  (* HexOf answers a hex digit's value, -1 for anything else. *)
BEGIN
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 END ;
  IF c >= 'A' AND c <= 'F' THEN RETURN ORD (c) - 55 END ;
  IF c >= 'a' AND c <= 'f' THEN RETURN ORD (c) - 87 END ;
  RETURN -1
END HexOf ;

PROCEDURE UrlEncode (RO s: STR) : STR RAISES ValueRange =
VAR
  scratch : POOL ;
  u : SLICE OF BYTE ;
  r : STR ;
  i, b : I64 ;
BEGIN
  u := OCTETS (s) ;
  r := '' ;
  FOR i := 0 TO LEN (u) - 1 DO
    b := I64 (u[i]) ;
    IF Unreserved (b) THEN
      r := r + CHR (b)
    ELSE
      r := r + '%' + HexDigit (b DIV 16) + HexDigit (b MOD 16)
    END
  END ;
  RETURN r
END UrlEncode ;

PROCEDURE UrlDecode (RO s: STR) : STR RAISES ValueRange =
  (* UrlDecode puts every byte of s into one octet buffer: a %XX as
     the octet it names, any other byte as itself.  It decodes the
     buffer STRICTLY once at the end.  That gives the same answer as
     decoding each run of %-octets on its own.  A %XX triple is ASCII,
     so a run ends at a character boundary of s.  A byte of s copied
     whole can never complete a run's dangling sequence.  The tool's
     BChar at the byte appended to r would have made a character of
     each octet. *)
VAR
  run : SLICE OF BYTE ;
  i, n, hi, lo : I64 ;
BEGIN
  run := NEW (BYTE, Text.BLen (s) + 1) ;
  n := 0 ;
  i := 0 ;
  WHILE i < Text.BLen (s) DO
    hi := -1 ;
    lo := -1 ;
    IF Text.BIs (s, i, '%') AND i + 2 < Text.BLen (s) THEN
      hi := HexOf (Text.BChar (s, i + 1)) ;
      lo := HexOf (Text.BChar (s, i + 2))
    END ;
    IF hi >= 0 AND lo >= 0 THEN
      run[n] := BYTE (hi * 16 + lo) ;
      i := i + 3
    ELSE
      run[n] := Text.BAt (s, i) ;
      i := i + 1
    END ;
    n := n + 1
  END ;
  RETURN UTF (SLICE (run, 0, n))
END UrlDecode ;


(* ---- multipart/form-data (2026-10-09) -------------------------------- *)

TYPE
  Part = RECORD
    name, file, ctype : STR ;
    data : SLICE OF BYTE ;
    isFile : BOOL ;
  END ;

  Form = RECORD
    parts : SLICE OF Part ;
    n : I64 ;
  END ;

  Octets = SLICE OF BYTE ;

PROCEDURE NewForm (VAR pool: POOL) : PTR Form IN pool =
VAR f : PTR Form IN pool ;
BEGIN
  f := NEW (pool, Form) ;
  f.parts := NEW (pool, Part, 4) ;
  f.n := 0 ;
  RETURN f
END NewForm ;

(* NextPart answers the next part, the table grown in the form's own
   pool. *)
PROCEDURE NextPart (VAR f: PTR Form) : I64 =
VAR
  np : SLICE OF Part ;
  i : I64 ;
BEGIN
  IF f.n = LEN (f.parts) THEN
    np := NEW (f, Part, 2 * LEN (f.parts) + 4) ;
    FOR i := 0 TO f.n - 1 DO np[i] := f.parts[i] END ;
    f.parts := np
  END ;
  f.n := f.n + 1 ;
  RETURN f.n - 1
END NextPart ;

PROCEDURE KeepStr (VAR f: PTR Form ; RO s: STR) : STR =
  (* KeepStr answers a copy in the Form's own pool, where NEW (f, T)
     allocates. *)
BEGIN
  RETURN UTF (f, s)
END KeepStr ;

PROCEDURE KeepBytes (VAR f: PTR Form ; RO b: SLICE OF BYTE) : SLICE OF BYTE =
VAR
  c : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  c := NEW (f, BYTE, LEN (b)) ;
  FOR i := 0 TO LEN (b) - 1 DO c[i] := b[i] END ;
  RETURN c
END KeepBytes ;

PROCEDURE FormField (VAR f: PTR Form ; RO name: STR ; RO value: STR)
  RAISES ValueRange =
VAR
  scratch : POOL ;
  k : I64 ;
BEGIN
  k := NextPart (f) ;
  f.parts[k].name := KeepStr (f, name) ;
  f.parts[k].file := '' ;
  f.parts[k].ctype := '' ;
  f.parts[k].data := KeepBytes (f, OCTETS (value)) ;
  f.parts[k].isFile := FALSE
END FormField ;

PROCEDURE FormBytes (VAR f: PTR Form ; RO name: STR ; RO fileName: STR ;
                     RO contentType: STR ; RO b: SLICE OF BYTE) =
VAR k : I64 ;
BEGIN
  k := NextPart (f) ;
  f.parts[k].name := KeepStr (f, name) ;
  f.parts[k].file := KeepStr (f, fileName) ;
  f.parts[k].ctype := KeepStr (f, contentType) ;
  f.parts[k].data := KeepBytes (f, b) ;
  f.parts[k].isFile := TRUE
END FormBytes ;

(* Occurs asks whether the ASCII text `needle' occurs in `hay'. *)
PROCEDURE Occurs (RO hay: SLICE OF BYTE ; RO needle: STR) : BOOL =
VAR i, j : I64 ; same : BOOL ;
BEGIN
  FOR i := 0 TO LEN (hay) - Text.BLen (needle) DO
    same := TRUE ;
    j := 0 ;
    WHILE same AND j < Text.BLen (needle) DO
      IF I64 (hay[i + j]) # I64 (Text.BAt (needle, j)) THEN same := FALSE END ;
      j := j + 1
    END ;
    IF same THEN RETURN TRUE END
  END ;
  RETURN FALSE
END Occurs ;

(* Boundary answers the first of m9-form-boundary-0, -1, ... that no
   part holds. *)
PROCEDURE Boundary (f: PTR Form) : STR =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  k, i : I64 ;
  clean : BOOL ;
BEGIN
  k := 0 ;
  LOOP
    d := DynStr.New (scratch) ;
    DynStr.Append (d, 'm9-form-boundary-') ;
    DynStr.AppendI64 (d, k) ;
    clean := TRUE ;
    FOR i := 0 TO f.n - 1 DO
      IF Occurs (f.parts[i].data, DynStr.View (d)) THEN clean := FALSE END
    END ;
    IF clean THEN RETURN DynStr.View (d) END ;
    k := k + 1
  END
END Boundary ;

(* Quoted writes a name between double quotes, as HTML forms write
   it. *)
PROCEDURE Quoted (VAR d: PTR DynStr.DString ; RO s: STR) =
VAR c : CHAR ;
BEGIN
  DynStr.AppendChar (d, '"') ;
  FOR c IN s DO                   (* by character: the same under the switch *)
    IF c = '"' THEN DynStr.Append (d, '%22')
    ELSIF c = 0DC THEN DynStr.Append (d, '%0D')
    ELSIF c = 0AC THEN DynStr.Append (d, '%0A')
    ELSE DynStr.AppendChar (d, c)
    END
  END ;
  DynStr.AppendChar (d, '"')
END Quoted ;

PROCEDURE FormType (f: PTR Form) : STR RAISES ValueRange =
BEGIN
  RETURN 'multipart/form-data; boundary=' + Boundary (f)
END FormType ;

PROCEDURE FormBody (VAR pool: POOL ; f: PTR Form) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  heads : SLICE OF Octets ;
  tail : SLICE OF BYTE ;
  out : SLICE OF BYTE ;
  bnd : STR ;
  i, j, o, total : I64 ;
BEGIN
  bnd := Boundary (f) ;
  heads := NEW (scratch, Octets, f.n) ;
  total := 0 ;
  FOR i := 0 TO f.n - 1 DO
    d := DynStr.New (scratch) ;
    DynStr.Append (d, '--') ;
    DynStr.Append (d, bnd) ;
    DynStr.Append (d, '' + 0DC + 0AC) ;
    DynStr.Append (d, 'Content-Disposition: form-data; name=') ;
    Quoted (d, f.parts[i].name) ;
    IF f.parts[i].isFile THEN
      DynStr.Append (d, '; filename=') ;
      Quoted (d, f.parts[i].file) ;
      DynStr.Append (d, '' + 0DC + 0AC) ;
      DynStr.Append (d, 'Content-Type: ') ;
      IF Text.BLen (f.parts[i].ctype) = 0 THEN
        DynStr.Append (d, 'application/octet-stream')
      ELSE
        DynStr.Append (d, f.parts[i].ctype)
      END
    END ;
    DynStr.Append (d, '' + 0DC + 0AC + 0DC + 0AC) ;
    heads[i] := OCTETS (DynStr.View (d)) ;
    (* This writes the part's octets and the CRLF that ends them. *)
    total := total + LEN (heads[i]) + LEN (f.parts[i].data) + 2
  END ;
  tail := OCTETS ('--' + bnd + '--' + 0DC + 0AC) ;
  total := total + LEN (tail) ;
  out := NEW (pool, BYTE, total) ;
  o := 0 ;
  FOR i := 0 TO f.n - 1 DO
    FOR j := 0 TO LEN (heads[i]) - 1 DO out[o] := heads[i][j] ; o := o + 1 END ;
    FOR j := 0 TO LEN (f.parts[i].data) - 1 DO out[o] := f.parts[i].data[j] ; o := o + 1 END ;
    out[o] := 13 ;
    out[o + 1] := 10 ;
    o := o + 2
  END ;
  FOR j := 0 TO LEN (tail) - 1 DO out[o] := tail[j] ; o := o + 1 END ;
  RETURN out
END FormBody ;

END Http.
