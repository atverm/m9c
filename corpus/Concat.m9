MODULE Concat ;

(* `+` on strings, and the pool the answer lands in.

   Concatenation ALLOCATES, and in M9 an allocation names its pool --
   which is why this operator did not exist for a long time: `a + b`
   has nowhere to put the result.  docs/pools.md refused a default
   pool as "a leak by construction".

   The revisit that produced HEAP was evidence, not taste.  Five
   programs in this repository -- Gen.m9, Sem.m9, M9c.m9, Logger.m9
   and the ICOS demo -- had each declared a module-scope POOL and
   never freed it, because a compiler and a converter are programs
   whose storage dies with the process.  The default pool was already
   here, hand-rolled, five times.  HEAP is that pool with a name, so
   that `PTR T IN HEAP` still says which pool and a program that must
   not grow can grep for the one word that makes it.

   AND THAT WAS SUPERSEDED ON 2026-09-01: `+` now lands in the
   PROCEDURE'S FRAME, an arena created lazily and freed on every exit,
   with the RETURN expression built in the caller's frame so a
   function may answer with a string.  HEAP is still a pool with a
   name, still never freed, and still where a `+` goes when a C caller
   entered without a frame -- but it is no longer where composition
   lands by default.  What forced it: HEAP being never freed is right
   for a tool and wrong for a server loop, and the corpus voted with
   its feet -- Gen.m9 carried 321 hand-rolled concatenation helpers
   against ONE `+`, and the zarr proxy banned the operator outright on
   its request path.  docs/frame-pools.md has the measurements.

   DynStr is still for ACCUMULATION where `+` is for composition.  `s := s + x` in a loop copies the whole
   string every time; the loop below is three iterations and says so.

   This module is small on purpose: it is the executable half of the
   report's paragraph, run by runtime/test/build.sh.               *)

IMPORT Io ;
IMPORT DynStr ;

CONST
  Bar = 07CC ;  (* '|', U+007C.  A CHAR constant -- one code point --
                   joined to a string as `s + Bar` the way a char
                   literal is, par 2.2 *)

PROCEDURE Greeting (RO who: STR) : STR =
BEGIN
  (* the answer outlives this frame, which is exactly the case a
     frame-scoped pool could not serve *)
  RETURN 'hello, ' + who + '!'
END Greeting ;

(* `+` may grow its left operand IN PLACE when that operand ends at
   the top of the arena -- what makes `s := s + x` linear.  A VIEW of
   the top string that stops short of its end must not be grown: the
   rest of the string is still there and still read.  Until 2026-10-05
   the runtime compared the ends rounded up to the arena's alignment,
   took SLICE (ds, 0, 3) of a four-character ds for all of it, and
   wrote the point over ds[3]: this answered '276..'.  Found by
   Fmt.Short, whose layout is exactly this expression. *)
PROCEDURE Point (RO a, b: STR) : STR =
VAR ds, out : STR ;
BEGIN
  ds := a + b ;
  (* in THIS frame, where ds is the top: a RETURN expression is built
     in the caller's arena and would not show it *)
  out := SLICE (ds, 0, 3) + '.' + SLICE (ds, 3, 1) ;
  RETURN out
END Point ;

VAR
  s : STR ;
  d : PTR DynStr.DString ;
  n : I64 ;

BEGIN
  Io.WriteLine (Greeting ('world')) ;
  s := '' ;
  FOR n := 1 TO 3 DO
    s := s + 'ab'
  END ;
  Io.WriteLine (s) ;
  Io.WriteI64 (LEN (s)) ;
  Io.WriteLine ('') ;
  (* HEAP is a pool like any other, so it can be passed by name *)
  d := DynStr.New (HEAP) ;
  DynStr.Append (d, 'via heap') ;
  Io.WriteLine (DynStr.View (d)) ;
  (* a CHAR joins as one code point, from a literal or a CONST *)
  Io.WriteLine ('a' + Bar + 'b' + Bar + 'c') ;
  Io.WriteLine (Point ('27', '67'))
END Concat.
