MODULE ShareUse ;

(* A SHARED answer of a call that can raise, held to its own output
   (gendiff and the driver suite): `b := Make (n)' where Make answers
   SHARED PTR Box and may RAISE.  The generator stores the answer and
   reads the error slot BEFORE the share copy; until 2026-10-03 it
   emitted m9_share_copy (Make (n, err)) with the test after, so a
   refused Make handed NULL to the copy, and a program whose handler
   should have run died with SIGSEGV (found by ZarrStoreTest).  The
   runtime tolerates a NULL since, so what gendiff greps is the ORDER
   in the C; what build.sh runs is the handler.

   The fixture for the owed-ledger item, 2026-10-03.  Not installed;
   gendiff and build.sh run it.                                     *)

IMPORT Io ;

TYPE
  Box = RECORD n : I64 END ;
  Store = (Fs, Irods) ;             (* CASE labels spelled Store.Fs (issue 13) *)

EXCEPTION Empty ;

VAR
  y0 : F64 ;                       (* named like POSIX's Bessel function: escaped in the C *)
  b : SHARED PTR Box ;
  c : SHARED PTR Box ;
  p : STR ;                        (* a module variable named like a binder below *)

PROCEDURE Make (n: I64) : SHARED PTR Box RAISES Empty =
VAR p : PTR Box ;
BEGIN
  IF n = 0 THEN RAISE Empty END ;
  p := NEW (OWN, Box) ;
  p.n := n ;
  RETURN SHARED (p)
END Make ;

(* a raising call NESTED AS AN ARGUMENT (par 5, 2026-10-08): Use must
   not run on what Count answered when it raised.  Until then F (G (x))
   was one C expression under one guard, and Use printed `used 0'
   before the handler ran. *)
PROCEDURE Count (n: I64) : I64 RAISES Empty =
BEGIN
  IF n = 0 THEN RAISE Empty END ;
  RETURN n * 2
END Count ;

PROCEDURE Use (n: I64) =
BEGIN
  Io.Write ('used ') ; Io.WriteI64 (n) ; Io.WriteLine ('')
END Use ;

PROCEDURE Nest (n: I64) =
BEGIN
  Use (Count (n))
EXCEPT
| Empty : Io.WriteLine ('Empty raised before Use ran')
END Nest ;

(* F32 of a double beyond F32's range is ValueRange, not an infinity
   (2026-10-08): the C cast gave inf and the program went on *)
PROCEDURE Narrow (x: F64) =
VAR f : F32 ;
BEGIN
  f := F32 (x) ;
  Io.WriteLine ('narrowed')
EXCEPT
| ValueRange : Io.WriteLine ('ValueRange on narrowing')
END Narrow ;

VAR big : U64 ;      (* a literal past 2^63 is spelled UINT64_C in C *)

PROCEDURE Try (n: I64) =
BEGIN
  b := Make (n) ;
  Io.Write ('made ') ; Io.WriteI64 (b.n) ; Io.WriteLine ('')
EXCEPT
| Empty : Io.WriteLine ('Empty raised, handled')
END Try ;

(* a binder named like a module variable is the binder (the generator
   looked the module variable up first until 2026-10-03 and refused
   `p.n' as a selection through a non-record) *)
PROCEDURE Peek (o: OPT SHARED PTR Box) : I64 =
BEGIN
  IF o IS SOME p THEN RETURN p.n END ;
  RETURN -1
END Peek ;

(* GRID (s, n0, n1) lays a grid over a slice's storage (par 2.2.1,
   2026-10-08): the extents must multiply to the slice's length, or
   IndexError -- and the grid answered then is empty, so nothing can
   be read through it *)
PROCEDURE GridOf (n0, n1: I64) =
VAR
  s : SLICE OF F64 ;
  g : GRID 2 OF F64 ;
  i : I64 ;
BEGIN
  s := NEW (F64, 6) ;
  FOR i := 0 TO 5 DO s[i] := 1.0 END ;
  s[5] := 7.0 ;
  g := GRID (s, n0, n1) ;
  Io.Write ('grid ') ; Io.WriteI64 (LEN (g, 0)) ; Io.Write ('x') ;
  Io.WriteI64 (LEN (g, 1)) ; Io.Write (' [1,2]=') ;
  Io.WriteI64 (I64 (g[1, 2])) ; Io.WriteLine ('')
EXCEPT
| IndexError (i, n) :
    (* the predeclared payload, typed and bound since 2026-10-09: the
       index and the length as the check saw them -- here GRID's
       product of extents and the slice's length *)
    Io.Write ('IndexError on GRID: ') ; Io.WriteI64 (i) ; Io.Write (' of ') ;
    Io.WriteI64 (n) ; Io.WriteLine ('')
| ValueRange : Io.WriteLine ('ValueRange')
END GridOf ;

(* a CASE over an enumeration with QUALIFIED labels -- cp-kernel's
   Store.m9 dispatch; the checker accepted it and the generator said
   `CASE label form unsupported yet' until 2026-10-09 (issue 13) *)
PROCEDURE Dispatch (s: Store) =
BEGIN
  CASE s OF
  | Store.Fs : Io.Write ('fs ')
  | Store.Irods : Io.WriteLine ('irods')
  END
END Dispatch ;

(* octets on standard output through the buffer Write uses: the line
   reads in the order it was written (issue 18) *)
PROCEDURE Octets () =
VAR b : SLICE OF BYTE ;
BEGIN
  b := NEW (BYTE, 2) ;
  b[0] := 98 ;
  b[1] := 32 ;
  Io.Write ('bytes: a ') ;
  Io.WriteBytes (b) ;
  Io.WriteLine ('c')
END Octets ;

(* IS SOME and IS NONE as BOOL expressions, no binder (issue 4) *)
PROCEDURE Flags () =
VAR
  o : OPT PTR Box ;
  c : PTR Box ;
  some, none : BOOL ;
BEGIN
  o := NONE ;
  some := o IS SOME ;
  none := o IS NONE ;
  IF NOT some AND none THEN Io.WriteLine ('absent: none') END ;
  c := NEW (Box) ;
  c.n := 3 ;
  o := SOME (c) ;
  IF (o IS SOME) AND NOT (o IS NONE) THEN Io.WriteLine ('present') END
END Flags ;

(* a string literal beyond ASCII, and a one-character one to a CHAR:
   the source is UTF-8 and a literal holds scalars (2026-10-09) *)
PROCEDURE Accents () =
VAR ch : CHAR ;
BEGIN
  ch := 'é' ;
  Io.WriteLine ('déjà ' + ch + ' ' + 2082C)
END Accents ;

BEGIN
  p := 'module' ;
  Try (3) ;
  Try (0) ;
  c := b ;
  Io.Write ('copied ') ; Io.WriteI64 (c.n) ; Io.WriteLine ('') ;
  Io.Write ('peeked ') ; Io.WriteI64 (Peek (SOME (b))) ; Io.WriteLine ('') ;
  Nest (5) ;
  Nest (0) ;
  Narrow (1.5) ;
  Narrow (1.0e300) ;
  big := 18446744073709551615 ;
  IF big = 18446744073709551615 THEN Io.WriteLine ('big') END ;
  GridOf (2, 3) ;
  GridOf (4, 2) ;
  y0 := 1.0 ;
  IF y0 > 0.0 THEN Io.WriteLine ('bessel') END ;
  Accents () ;
  Flags () ;
  Dispatch (Store.Fs) ;
  Dispatch (Store.Irods) ;
  Octets ()
END ShareUse.
