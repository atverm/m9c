DEFINITION MODULE Diag ;

(* Diag -- the compiler's diagnostics as data.

   Three programs republish what `m9c --check` prints: m9lsp over the
   Language Server Protocol, m9edit as JSON for its page, and the
   tutorial's cells next.  Each had carried its own copy of the line
   parser, and the two copies had already drifted by a shape: the
   `--no-unsafe` refusal, which carried no position at all, was
   dropped by both -- a check that failed with ZERO findings.  This
   module is the one parser, the one runner, and the one JSON
   renderer, so a shape m9c gains is learned in one place.

   THE RULE IT KEEPS: no second scanner.  Nothing here lexes or
   parses M9; `LexJson` runs the compiler's own Lex, and `Check`
   runs the compiler itself and reads its lines back.  The corpus
   refuted an editor-side relexer the day a phantom comment ate
   fifty-four lines of Gen.m9.                                       *)

IMPORT DynStr ;
IMPORT DynUtf ;

TYPE
  Finding = RECORD
    line, col : I64 ;         (* 1-based, exactly as m9c prints them *)
    msg : UTF
  END ;

PROCEDURE Parse (RO line: UTF ; VAR f: Finding) : BOOL ;
  (* one line of m9c's output as a finding, when it carries a
     position.  Two shapes, m9c's own:
       LINE:COL MSG            the checker's
       FILE:LINE:COL: MSG      the parser's (`parse: ...`) and the
                               --no-unsafe refusal (`no-unsafe: ...`)
       FILE:LINE: gen: MSG     the generator's, which has no column
                               and is answered at column 1
     The second is found by the leftmost `:D+:D+: `, so a path may
     hold colons and a message may quote source text; the third by
     the leftmost `:D+: gen: `.  msg keeps the prefix (`parse: `,
     `gen: `) and is a view into line, hence KEPT.  FALSE for
     anything else -- the summaries.  The generator's shape was
     dropped on purpose until 2026-09-27, when --check began to run
     the generator (docs/agent-review-2026-09-27.md F4): before that
     a construct the checker accepts and the generator refuses was
     invisible to every editor.                                      *)

PROCEDURE One (VAR pool: POOL ; line, col: I64 ; RO msg: STR)
  : SLICE OF Finding ;
  (* a single finding, as a slice: what a caller answers for a
     refusal of its own (a buffer with no MODULE line, a path it will
     not hand to a shell).  msg is copied into pool.                 *)

PROCEDURE OneUtf (VAR pool: POOL ; line, col: I64 ; RO msg: UTF)
  : SLICE OF Finding ;
  (* One for a UTF message, copied into pool the same way.            *)

PROCEDURE Check (VAR pool: POOL ; RO m9c: STR ; RO flags: STR ;
                 RO dir: STR ; RO file: STR ; RO outFile: STR)
  : SLICE OF Finding RAISES ValueRange, IndexError ;
  (* run `(cd 'DIR' && M9C FLAGS --check 'FILE') > 'OUTFILE' 2>&1`
     and answer every finding it printed, in order; an indented line
     after a finding continues its message (the signature mismatch
     prints both signatures under it, each on a line).  dir may be
     empty (no cd); outFile is a path as seen from THIS process,
     which is where it is read back.  Exit 0 answers no finding
     without reading anything.  A nonzero exit that printed NO
     positioned line answers ONE finding at 1:1 carrying the
     output's first line (or the exit code when there was none), so
     a refusal is never silent -- that was the --no-unsafe hole.  A
     path holding a quote is answered the same way, unrun: m9c's own
     rule at its own link step.                                      *)

PROCEDURE DocJson (VAR pool: POOL ; RO m9c: STR ; RO flags: STR ;
                   RO workDir: STR ; RO name: STR) : STR
  RAISES ValueRange, IndexError ;
  (* the m9c --json gather for module `name`, cached as
     WORKDIR/docs/NAME.json -- the hovers' food, m9edit's and the
     tutorial's, so the name gate lives here and cannot drift:
     letters and digits only, under 64.  Composes
       mkdir -p 'DOCS' && cd 'DOCS' &&
         test -f NAME.json || M9C FLAGS --json NAME > dc.txt 2>&1
     and answers the file's text.  '' means "no document" -- a
     refused name, a workDir holding a quote (unrun, m9c's own
     rule), or a module the compiler does not know -- and the
     server answers its 404 without inventing one.                  *)

PROCEDURE Json (VAR pool: POOL ; RO fs: SLICE OF Finding) : STR
  RAISES ValueRange, IndexError ;
  (* the cell shape:
       {"ok":true,"diags":[]}
       {"ok":false,"diags":[{"line":L,"col":C,"msg":"..."},...]}
     ok is exactly "no finding".                                     *)

PROCEDURE LexJson (RO src: STR) : STR
  RAISES ValueRange, IndexError ;
  (* the compiler's own tokens and comments, for a page that paints:
       {"tokens":[[kind,line,col,len],...],
        "comments":[{"line":L,"col":C,"text":"..."},...]}
     kind is Lex's stable code (0 is EOF and is not listed; 1 is an
     error token), len the token's text length in CHARs.            *)

PROCEDURE JStr (VAR d: PTR DynStr.DString ; RO s: STR)
  RAISES ValueRange ;
  (* a JSON string literal appended to d: the escapes RFC 8259
     requires and no others -- `"` and `\` backslashed, controls as
     \u00XX, everything else as it is.  Json.m9 keeps its emitter
     private; this is the shared home its three copies were owed.   *)

PROCEDURE JStrUtf (VAR d: PTR DynUtf.DString ; RO s: UTF)
  RAISES ValueRange ;
  (* JStr for a UTF-8 builder and text: the same escapes, byte by
     byte -- a byte past 0x7F is part of a character and goes as it
     is.                                                            *)

END Diag.

IMPLEMENTATION MODULE Diag ;

IMPORT DynStr ;
IMPORT DynUtf ;
IMPORT Io ;
IMPORT Lex ;
IMPORT Text ;

(* ---- JSON out ---- *)

PROCEDURE JStr (VAR d: PTR DynStr.DString ; RO s: STR)
  RAISES ValueRange =
VAR i, c : I64 ;
BEGIN
  DynStr.AppendChar (d, 022C) ;
  FOR i := 0 TO LEN (s) - 1 DO
    c := ORD (s[i]) ;
    IF c = 0x22 OR c = 0x5C THEN
      DynStr.AppendChar (d, 05CC) ;
      DynStr.AppendChar (d, s[i])
    ELSIF c < 0x20 THEN
      DynStr.Append (d, '\u00') ;
      DynStr.AppendChar (d, HexDigit (c DIV 16)) ;
      DynStr.AppendChar (d, HexDigit (c MOD 16))
    ELSE
      DynStr.AppendChar (d, s[i])
    END
  END ;
  DynStr.AppendChar (d, 022C)
END JStr ;

PROCEDURE JStrUtf (VAR d: PTR DynUtf.DString ; RO s: UTF)
  RAISES ValueRange =
VAR i, c, start : I64 ;
BEGIN
  DynUtf.AppendChar (d, 022C) ;
  start := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    c := B (s, i) ;
    IF c = 0x22 OR c = 0x5C OR c < 0x20 THEN
      (* the run since the last escape, then the escape *)
      DynUtf.Append (d, SLICE (s, start, i - start)) ;
      IF c < 0x20 THEN
        DynUtf.Append (d, '\u00') ;
        DynUtf.AppendChar (d, HexDigit (c DIV 16)) ;
        DynUtf.AppendChar (d, HexDigit (c MOD 16))
      ELSE
        DynUtf.AppendChar (d, 05CC) ;
        DynUtf.AppendChar (d, CHR (c))
      END ;
      start := i + 1
    END
  END ;
  DynUtf.Append (d, SLICE (s, start, Text.BLen (s) - start)) ;
  DynUtf.AppendChar (d, 022C)
END JStrUtf ;

PROCEDURE HexDigit (v: I64) : CHAR RAISES ValueRange =
BEGIN
  IF v < 10 THEN RETURN CHR (ORD ('0') + v) END ;
  RETURN CHR (ORD ('a') + v - 10)
END HexDigit ;

(* ---- the line parser ---- *)

(* the byte at offset i of u, as a number: the line parser reads ASCII
   structure -- digits, `:`, a space -- where a byte IS the character *)
PROCEDURE B (RO u: UTF ; i: I64) : I64 =
BEGIN
  RETURN I64 (Text.BAt (u, i))
END B ;

(* the leading I64 of s from position i; i walks past it *)
PROCEDURE TakeI64 (RO s: UTF ; VAR i: I64 ; VAR v: I64) : BOOL =
VAR any : BOOL ;
BEGIN
  v := 0 ;
  any := FALSE ;
  WHILE i < Text.BLen (s) AND B (s, i) >= 48 AND B (s, i) <= 57 DO
    v := v * 10 + (B (s, i) - 48) ;
    i := i + 1 ;
    any := TRUE
  END ;
  RETURN any
END TakeI64 ;

PROCEDURE Parse (RO line: UTF ; VAR f: Finding) : BOOL =
VAR i, j, ln, cl : I64 ;
BEGIN
  (* LINE:COL MSG *)
  i := 0 ;
  IF TakeI64 (line, i, ln) AND i < Text.BLen (line) AND B (line, i) = ORD (':') THEN
    i := i + 1 ;
    IF TakeI64 (line, i, cl) AND i < Text.BLen (line) AND B (line, i) = ORD (' ') THEN
      f.line := ln ;
      f.col := cl ;
      f.msg := SLICE (line, i + 1, Text.BLen (line) - i - 1) ;
      RETURN TRUE
    END
  END ;
  (* FILE:LINE:COL: MSG -- the leftmost colon that opens :D+:D+:
     followed by a space; something must precede it, the file *)
  i := 1 ;
  WHILE i < Text.BLen (line) DO
    IF B (line, i) = ORD (':') THEN
      j := i + 1 ;
      IF TakeI64 (line, j, ln) AND j < Text.BLen (line) AND B (line, j) = ORD (':') THEN
        j := j + 1 ;
        IF TakeI64 (line, j, cl) AND j + 1 < Text.BLen (line) AND
           B (line, j) = ORD (':') AND B (line, j + 1) = ORD (' ') THEN
          f.line := ln ;
          f.col := cl ;
          f.msg := SLICE (line, j + 2, Text.BLen (line) - j - 2) ;
          RETURN TRUE
        END
      END
    END ;
    i := i + 1
  END ;
  (* FILE:LINE: gen: MSG -- the generator's, no column *)
  i := 1 ;
  WHILE i < Text.BLen (line) DO
    IF B (line, i) = ORD (':') THEN
      j := i + 1 ;
      IF TakeI64 (line, j, ln) AND j + 6 < Text.BLen (line) AND
         B (line, j) = ORD (':') AND B (line, j + 1) = ORD (' ') AND B (line, j + 2) = ORD ('g') AND
         B (line, j + 3) = ORD ('e') AND B (line, j + 4) = ORD ('n') AND B (line, j + 5) = ORD (':') AND
         B (line, j + 6) = ORD (' ') THEN
        f.line := ln ;
        f.col := 1 ;
        f.msg := SLICE (line, j + 2, Text.BLen (line) - j - 2) ;
        RETURN TRUE
      END
    END ;
    i := i + 1
  END ;
  RETURN FALSE
END Parse ;

PROCEDURE One (VAR pool: POOL ; line, col: I64 ; RO msg: STR)
  : SLICE OF Finding =
VAR fs : SLICE OF Finding ;
BEGIN
  fs := NEW (pool, Finding, 1) ;
  fs[0].line := line ;
  fs[0].col := col ;
  fs[0].msg := UTF (pool, msg) ;
  RETURN fs
END One ;

PROCEDURE OneUtf (VAR pool: POOL ; line, col: I64 ; RO msg: UTF)
  : SLICE OF Finding =
VAR fs : SLICE OF Finding ;
BEGIN
  fs := NEW (pool, Finding, 1) ;
  fs[0].line := line ;
  fs[0].col := col ;
  fs[0].msg := UTF (pool, msg) ;
  RETURN fs
END OneUtf ;

(* ---- the runner ---- *)

PROCEDURE HasQuote (RO s: STR) : BOOL =
BEGIN
  RETURN Text.FindChar (s, 027C) >= 0
END HasQuote ;

PROCEDURE Quoted (VAR d: PTR DynUtf.DString ; RO s: UTF) =
BEGIN
  DynUtf.AppendChar (d, 027C) ;
  DynUtf.Append (d, s) ;
  DynUtf.AppendChar (d, 027C)
END Quoted ;

(* the captured output, or empty when there was none to read *)
PROCEDURE OutText (VAR pool: POOL ; RO path: STR) : UTF =
BEGIN
  RETURN UTF (pool, Io.ReadFileUtf (UTF (path)))
EXCEPT
| Io.IOError (p) :
    RETURN ''
| ValueRange :
    RETURN ''
END OutText ;

PROCEDURE Check (VAR pool: POOL ; RO m9c: STR ; RO flags: STR ;
                 RO dir: STR ; RO file: STR ; RO outFile: STR)
  : SLICE OF Finding RAISES ValueRange, IndexError =
VAR
  scratch : POOL ;
  cmd : PTR DynUtf.DString IN scratch ;
  d : PTR DynUtf.DString IN pool ;
  fs : SLICE OF Finding ;
  text, line : UTF ;
  rc, i, j, n, nl, mstart : I64 ;
BEGIN
  IF HasQuote (dir) OR HasQuote (file) OR HasQuote (outFile) THEN
    RETURN One (pool, 1, 1, 'a path containing a quote is not checked')
  END ;
  cmd := DynUtf.New (scratch) ;
  DynUtf.AppendChar (cmd, '(') ;
  IF LEN (dir) > 0 THEN
    DynUtf.Append (cmd, 'cd ') ;
    Quoted (cmd, UTF (dir)) ;
    DynUtf.Append (cmd, ' && ')
  END ;
  DynUtf.AppendStr (cmd, m9c) ;
  IF LEN (flags) > 0 THEN
    DynUtf.AppendChar (cmd, ' ') ;
    DynUtf.AppendStr (cmd, flags)
  END ;
  DynUtf.Append (cmd, ' --check ') ;
  Quoted (cmd, UTF (file)) ;
  DynUtf.Append (cmd, ') > ') ;
  Quoted (cmd, UTF (outFile)) ;
  DynUtf.Append (cmd, ' 2>&1') ;
  rc := Io.Run (STR (DynUtf.View (cmd))) ;
  IF rc = 0 THEN RETURN NEW (pool, Finding, 0) END ;
  text := OutText (pool, outFile) ;
  (* one slot per line is the most findings the text can hold *)
  nl := 1 ;
  FOR i := 0 TO Text.BLen (text) - 1 DO
    IF B (text, i) = 10 THEN nl := nl + 1 END
  END ;
  fs := NEW (pool, Finding, nl) ;
  n := 0 ;
  i := 0 ;
  mstart := 0 ;
  WHILE i < Text.BLen (text) DO
    j := i ;
    WHILE j < Text.BLen (text) AND B (text, j) # 10 DO j := j + 1 END ;
    line := SLICE (text, i, j - i) ;
    IF Parse (line, fs[n]) THEN
      mstart := j - Text.BLen (fs[n].msg) ;
      n := n + 1
    ELSIF n > 0 AND j > i AND B (text, i) = 32 THEN
      (* an INDENTED line continues the finding above it -- the
         checker's "signature differs from definition:" is followed
         by the two signatures, each on its own line.  The message
         is a view into text and the continuation is the next line
         of the same text, so the view is extended, newline and
         all (Json escapes it); nothing is copied. *)
      fs[n - 1].msg := SLICE (text, mstart, j - mstart)
    END ;
    i := j + 1
  END ;
  IF n > 0 THEN RETURN SLICE (fs, 0, n) END ;
  (* it refused and said where not: the first line is the reason *)
  j := 0 ;
  WHILE j < Text.BLen (text) AND B (text, j) # 10 DO j := j + 1 END ;
  IF j > 0 THEN RETURN OneUtf (pool, 1, 1, SLICE (text, 0, j)) END ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, 'm9c: exit ') ;
  IF rc >= 256 THEN rc := rc DIV 256 END ;
  DynUtf.AppendI64 (d, rc) ;
  RETURN OneUtf (pool, 1, 1, DynUtf.ViewIn (pool, d))
END Check ;

(* ---- the cell shape ---- *)

PROCEDURE DocJson (VAR pool: POOL ; RO m9c: STR ; RO flags: STR ;
                   RO workDir: STR ; RO name: STR) : STR
  RAISES ValueRange, IndexError =
VAR
  scratch : POOL ;
  cmd : PTR DynUtf.DString IN scratch ;
  docs : PTR DynUtf.DString IN scratch ;
  i, rc : I64 ;
  c : CHAR ;
BEGIN
  IF LEN (name) = 0 OR LEN (name) >= 64 OR HasQuote (workDir) THEN
    RETURN ''
  END ;
  FOR c IN name DO
    IF NOT ((c >= 'a' AND c <= 'z') OR (c >= 'A' AND c <= 'Z') OR
            (c >= '0' AND c <= '9')) THEN
      RETURN ''
    END
  END ;
  docs := DynUtf.New (scratch) ;
  DynUtf.AppendStr (docs, workDir) ;
  DynUtf.Append (docs, '/docs') ;
  cmd := DynUtf.New (scratch) ;
  DynUtf.Append (cmd, 'mkdir -p ') ;
  Quoted (cmd, DynUtf.View (docs)) ;
  DynUtf.Append (cmd, ' && cd ') ;
  Quoted (cmd, DynUtf.View (docs)) ;
  DynUtf.Append (cmd, ' && test -f ') ;
  DynUtf.AppendStr (cmd, name) ;
  DynUtf.Append (cmd, '.json || ') ;
  DynUtf.AppendStr (cmd, m9c) ;
  IF LEN (flags) > 0 THEN
    DynUtf.AppendChar (cmd, ' ') ;
    DynUtf.AppendStr (cmd, flags)
  END ;
  DynUtf.Append (cmd, ' --json ') ;
  DynUtf.AppendStr (cmd, name) ;
  DynUtf.Append (cmd, ' > dc.txt 2>&1') ;
  rc := Io.Run (STR (DynUtf.View (cmd))) ;
  DynUtf.Append (docs, '/') ;
  DynUtf.AppendStr (docs, name) ;
  DynUtf.Append (docs, '.json') ;
  RETURN Io.ReadFile (pool, STR (DynUtf.View (docs)))
EXCEPT
| Io.IOError (p) :
    (* the compiler refused the name: no NAME.json was written *)
    RETURN ''
END DocJson ;

PROCEDURE Json (VAR pool: POOL ; RO fs: SLICE OF Finding) : STR
  RAISES ValueRange, IndexError =
VAR
  d : PTR DynUtf.DString IN pool ;
  i : I64 ;
BEGIN
  IF LEN (fs) = 0 THEN RETURN '{"ok":true,"diags":[]}' END ;
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, '{"ok":false,"diags":[') ;
  FOR i := 0 TO LEN (fs) - 1 DO
    IF i > 0 THEN DynUtf.AppendChar (d, 02CC) END ;
    DynUtf.Append (d, '{"line":') ;
    DynUtf.AppendI64 (d, fs[i].line) ;
    DynUtf.Append (d, ',"col":') ;
    DynUtf.AppendI64 (d, fs[i].col) ;
    DynUtf.Append (d, ',"msg":') ;
    JStrUtf (d, fs[i].msg) ;
    DynUtf.AppendChar (d, 07DC)
  END ;
  DynUtf.Append (d, ']}') ;
  RETURN STR (DynUtf.ViewIn (pool, d))
END Json ;

(* ---- the compiler's own tokens ---- *)

PROCEDURE LexJson (RO src: STR) : STR
  RAISES ValueRange, IndexError =
VAR
  pool : POOL ;
  lx : Lex.Lexer ;
  t : Lex.Token ;
  cm : Lex.Comment ;
  d : PTR DynUtf.DString IN pool ;
  first : BOOL ;
  i : I64 ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, '{"tokens":[') ;
  Lex.Collect (TRUE) ;
  Lex.Init (lx, src) ;
  first := TRUE ;
  LOOP
    Lex.Next (lx, t) ;
    (* kinds are stable I64 codes by Lex's own contract: 0 is EOF *)
    IF t.kind = 0 THEN EXIT END ;
    IF NOT first THEN DynUtf.AppendChar (d, 02CC) END ;
    first := FALSE ;
    DynUtf.AppendChar (d, 05BC) ;
    DynUtf.AppendI64 (d, t.kind) ;
    DynUtf.AppendChar (d, 02CC) ;
    DynUtf.AppendI64 (d, t.line) ;
    DynUtf.AppendChar (d, 02CC) ;
    DynUtf.AppendI64 (d, t.col) ;
    DynUtf.AppendChar (d, 02CC) ;
    DynUtf.AppendI64 (d, Text.CpCount (t.text)) ;   (* characters, as the editor counts *)
    DynUtf.AppendChar (d, 05DC)
  END ;
  Lex.Collect (FALSE) ;
  DynUtf.Append (d, '],"comments":[') ;
  FOR i := 0 TO Lex.ComCount () - 1 DO
    cm := Lex.ComAt (i) ;
    IF i > 0 THEN DynUtf.AppendChar (d, 02CC) END ;
    DynUtf.Append (d, '{"line":') ;
    DynUtf.AppendI64 (d, cm.line) ;
    DynUtf.Append (d, ',"col":') ;
    DynUtf.AppendI64 (d, cm.col) ;
    DynUtf.Append (d, ',"text":') ;
    JStrUtf (d, cm.text) ;
    DynUtf.AppendChar (d, 07DC)
  END ;
  DynUtf.Append (d, ']}') ;
  RETURN STR (DynUtf.View (d))
END LexJson ;

END Diag.
