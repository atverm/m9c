DEFINITION MODULE DynStr ;

(* Growable strings.  The M2 version leaned on libc malloc/realloc
   and answered questions about NIL with quiet zeros (Len (NIL) = 0,
   CharAt out of range = 0C).  Here the pool owns the string, NIL
   does not exist, and reading is a checked slice, not a CharAt
   loop.  Dispose is gone: free the pool, free the strings.          *)

TYPE
  DString ;                              (* opaque; lives in a POOL *)

PROCEDURE New (VAR pool: POOL) : PTR DString IN pool ;
  (* an empty string, sixteen characters of capacity, owned by pool.

       pool -- where the string and every buffer it later outgrows
               are carved.  The result is `IN pool`, so the checker
               refuses to let it outlive the pool it came from; that
               is why there is no Dispose.                          *)

PROCEDURE AppendChar (VAR pool: POOL ; VAR d: PTR DString ; ch: CHAR) ;
  (* one scalar onto the end, growing the buffer when it is full.

       d  -- VAR because growing REPLACES the buffer; a caller
             holding an old View sees the old bytes, which is the
             one thing to know about this type.
       ch -- any Unicode scalar.  No encoding happens here: CHAR is
             the unit, and octets are Bytes' business.              *)

PROCEDURE Append (VAR pool: POOL ; VAR d: PTR DString ;
                  RO s: STR) ;
  (* the whole of s onto the end, one AppendChar at a time.

       s -- BORROWED for the call and copied, so appending a View of
            d to d itself is the aliasing case this does not handle;
            nothing in the corpus does it, and the copy is what
            would make it safe.                                     *)

PROCEDURE Len (d: PTR DString) : I64 ;
  (* characters written so far, never the capacity.  The M2 version
     answered 0 for NIL; there is no NIL here, so this cannot be the
     quiet zero that hid an unallocated string.                     *)

PROCEDURE View (d: PTR DString) : RO STR ;
  (* the whole content, zero-copy; replaces the M2 CharAt-in-a-loop
     and its out-of-range 0C lie -- indexing the view is checked.    *)

PROCEDURE Equal (d: PTR DString ; RO s: STR) : BOOL ;
  (* content comparison against a plain slice, without building a
     View first.  Eq below is the slice-to-slice form; this one
     exists because comparing a builder against a literal is the
     common case and should not need two calls.                     *)

PROCEDURE Eq (RO a: STR ;
              RO b: STR) : BOOL ;
  (* slice-to-slice equality.  Json and ZarrStore had each grown a
     private copy before HttpServer became the third caller --
     inventory before manufacturing, consolidated here.              *)

PROCEDURE AppendI64 (VAR pool: POOL ; VAR d: PTR DString ; v: I64) ;
  (* decimal text of v.  Negating MIN(I64) traps Overflow (par 2.1);
     no caller formats it today, and the trap is declared behavior,
     not a surprise.                                                 *)

PROCEDURE Bytes (VAR pool: POOL ; RO s: STR ;
                 zeroTerm: BOOL) : SLICE OF BYTE
  RAISES ValueRange ;
  (* CHAR is a scalar, the wire is octets; a scalar past 255 raises
     here, at the boundary, not as mojibake at the peer.  Pool
     storage is defined-zero (par 4.3): when zeroTerm is asked for,
     the terminator is already in place.                             *)

PROCEDURE Utf8 (VAR pool: POOL ; RO s: STR) : SLICE OF BYTE
  RAISES ValueRange ;
  (* CHARs as UTF-8 octets -- the OTHER wire.  Bytes above is the
     Latin-1 wire and raises past 255; this one encodes every
     Unicode scalar (the claim Io.PutChars makes for the console).
     The declared ValueRange is the BYTE conversions the checker
     counts; every operand is arithmetic mod 64 plus an offset
     below 248, so it cannot fire -- declared because the
     accounting is exhaustive, not because it happens.  Demanded by
     the zarr proxy, whose JSON reference emits ensure_ascii=False. *)

PROCEDURE Chars (VAR pool: POOL ; RO b: SLICE OF BYTE)
  : STR
  RAISES ValueRange ;
  (* octets to scalars, the inverse of Bytes.  An octet is always a
     scalar, so this cannot raise; the checker cannot know that
     without byte-level typing (P2 pass 3), and an honest signature
     beats a silent assumption.                                      *)

END DynStr.


IMPLEMENTATION MODULE DynStr ;

CONST
  DigitChars = '0123456789' ;

TYPE
  DString = RECORD
    len : I64 ;
    buf : STR ;                (* capacity = LEN (buf) *)
  END ;

PROCEDURE New (VAR pool: POOL) : PTR DString IN pool =
VAR d : PTR DString IN pool ;
BEGIN
  d := NEW (pool, DString) ;
  d.len := 0 ;
  d.buf := NEW (pool, CHAR, 16) ;
  RETURN d
END New ;

PROCEDURE Grow (VAR pool: POOL ; VAR d: PTR DString) =
VAR
  nb : STR ;
  i  : I64 ;
BEGIN
  nb := NEW (pool, CHAR, 2 * LEN (d.buf)) ;
  FOR i := 0 TO d.len - 1 DO nb[i] := d.buf[i] END ;
  d.buf := nb
  (* the abandoned buffer stays in the pool until the pool dies:
     pools trade reclamation for a one-line lifetime story.  For
     Json- and Http-sized strings the doublings from 16 chars cost
     less than one chunk read; measure before believing otherwise.   *)
END Grow ;

PROCEDURE AppendChar (VAR pool: POOL ; VAR d: PTR DString ; ch: CHAR) =
BEGIN
  IF d.len = LEN (d.buf) THEN Grow (pool, d) END ;
  d.buf[d.len] := ch ;
  d.len := d.len + 1
END AppendChar ;

PROCEDURE Append (VAR pool: POOL ; VAR d: PTR DString ;
                  RO s: STR) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO AppendChar (pool, d, s[i]) END
END Append ;

PROCEDURE Len (d: PTR DString) : I64 =
BEGIN
  RETURN d.len
END Len ;

PROCEDURE View (d: PTR DString) : RO STR =
BEGIN
  RETURN SLICE (d.buf, 0, d.len)
END View ;

PROCEDURE Equal (d: PTR DString ; RO s: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF d.len # LEN (s) THEN RETURN FALSE END ;
  FOR i := 0 TO d.len - 1 DO
    IF d.buf[i] # s[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END Equal ;

PROCEDURE Eq (RO a: STR ;
              RO b: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (a) # LEN (b) THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (a) - 1 DO
    IF a[i] # b[i] THEN RETURN FALSE END
  END ;
  RETURN TRUE
END Eq ;

PROCEDURE AppendI64 (VAR pool: POOL ; VAR d: PTR DString ; v: I64) =
VAR
  tmp : ARRAY 20 OF CHAR ;
  n, x : I64 ;
BEGIN
  IF v = 0 THEN AppendChar (pool, d, '0') ; RETURN END ;
  (* the digit loop runs in NEGATIVE space: -MIN (I64) does not fit
     an I64, so `x := -v` would trap on exactly one value -- and did,
     as an unhandled Overflow out of Io.WriteI64 (MAX (I64) +% 1),
     found by the tutorial's wrapping example.  MOD and DIV truncate
     toward zero, so a negative x yields remainders in -9..0 and one
     negation of the DIGIT, which cannot overflow, recovers it.     *)
  IF v < 0 THEN AppendChar (pool, d, '-') ; x := v ELSE x := 0 - v END ;
  n := 0 ;
  WHILE x # 0 DO
    tmp[n] := DigitChars[0 - (x MOD 10)] ;
    x := x DIV 10 ;
    n := n + 1
  END ;
  WHILE n > 0 DO
    n := n - 1 ;
    AppendChar (pool, d, tmp[n])
  END
END AppendI64 ;

PROCEDURE Bytes (VAR pool: POOL ; RO s: STR ;
                 zeroTerm: BOOL) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  b : SLICE OF BYTE ;
  n, i : I64 ;
BEGIN
  n := LEN (s) ;
  IF zeroTerm THEN n := n + 1 END ;
  b := NEW (pool, BYTE, n) ;
  FOR i := 0 TO LEN (s) - 1 DO
    b[i] := BYTE (ORD (s[i]))
  END ;
  RETURN b
END Bytes ;

PROCEDURE Utf8 (VAR pool: POOL ; RO s: STR) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  b : SLICE OF BYTE ;
  i, n, v : I64 ;
BEGIN
  (* two passes: size exactly, then fill -- a pool has no realloc
     and guessing 4x would quadruple every response body *)
  n := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    v := ORD (s[i]) ;
    IF v < 128 THEN n := n + 1
    ELSIF v < 2048 THEN n := n + 2
    ELSIF v < 65536 THEN n := n + 3
    ELSE n := n + 4
    END
  END ;
  b := NEW (pool, BYTE, n) ;
  n := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    v := ORD (s[i]) ;
    IF v < 128 THEN
      b[n] := BYTE (v) ;
      n := n + 1
    ELSIF v < 2048 THEN
      b[n] := BYTE (192 + v DIV 64) ;
      b[n + 1] := BYTE (128 + v MOD 64) ;
      n := n + 2
    ELSIF v < 65536 THEN
      b[n] := BYTE (224 + v DIV 4096) ;
      b[n + 1] := BYTE (128 + (v DIV 64) MOD 64) ;
      b[n + 2] := BYTE (128 + v MOD 64) ;
      n := n + 3
    ELSE
      b[n] := BYTE (240 + v DIV 262144) ;
      b[n + 1] := BYTE (128 + (v DIV 4096) MOD 64) ;
      b[n + 2] := BYTE (128 + (v DIV 64) MOD 64) ;
      b[n + 3] := BYTE (128 + v MOD 64) ;
      n := n + 4
    END
  END ;
  RETURN b
END Utf8 ;

PROCEDURE Chars (VAR pool: POOL ; RO b: SLICE OF BYTE)
  : STR
  RAISES ValueRange =
VAR
  c : STR ;
  i : I64 ;
BEGIN
  c := NEW (pool, CHAR, LEN (b)) ;
  FOR i := 0 TO LEN (b) - 1 DO
    c[i] := CHR (ORD (b[i]))
  END ;
  RETURN c
END Chars ;

END DynStr.
