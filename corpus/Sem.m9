STATEFUL DEFINITION MODULE Sem ;

(* The semantic checker, in M9 -- restated from host/fpc/M9Sem.pas,
   which is its differential oracle.  A checker's output IS its
   diagnostics: their text, their line and column, and the order they
   were produced in.  So that is the whole comparison, exactly as
   byte-identical C was the whole comparison for the generator, and
   host/fpc/semdump.pas is the oracle that prints it.

   Errors are values here as everywhere: nothing halts, every problem
   lands in the list with a position, and checking continues.  An
   unknown type never diagnoses -- softness is the contract, because
   a checker that guesses produces diagnostics nobody can act on.

   Built in passes, in the order the oracle grew them, so each is
   differentially verified before the next is written.               *)

IMPORT Ast ;

PROCEDURE LoadFile (root: PTR Ast.Node) ;
  (* every unit of every file must be loaded before ANY is checked:
     cross-module names resolve against this registry, and a name
     that is not yet loaded is indistinguishable from one that does
     not exist                                                       *)

PROCEDURE CheckFile (KEPT root: PTR Ast.Node) ;
  (* checks one parsed file, after LoadFile has registered it and
     every module it imports.  It does not raise and it does not
     halt: ERRORS ARE VALUES here, collected and read back through
     the two procedures below, because a checker that stops at the
     first mistake makes the caller run it once per mistake.

       root -- the NFile node Parse.File answered.  Its declarations
               must already be loaded, or names from them resolve to
               nothing and every use is reported unknown.          *)

PROCEDURE ErrCount () : I64 ;
PROCEDURE ErrAt (i: I64) : STR RAISES IndexError ;
  (* the diagnostics, in the order they were found, each already
     formatted with its line:col.

       i -- 0 .. ErrCount - 1.  These are MODULE state and belong to
            the last CheckFile: the compiler holds one file's
            registries at a time and a process is the reset, which
            is the same rule m9c states in its own header.        *)

PROCEDURE LedgerCount () : I64 ;
PROCEDURE LedgerAt (i: I64) : STR RAISES IndexError ;
  (* the par 4.1 contortion ledger: measured, not rejected.  The
     kill-gate reads this, so it is output and not a debug aside --
     a ledger that silently stops seeing a borrow understates the
     rate the gate is judged on, which has happened once already.   *)

CONST
  StatKinds = 7 ;
  StatSites = 6 ;

PROCEDURE StatName (i: I64) : STR ;
PROCEDURE StatChecked (i: I64) : I64 ;
PROCEDURE StatSkipped (i: I64) : I64 ;
PROCEDURE StatLines (i: I64) : I64 ;
PROCEDURE StatLine (i, j: I64) : I64 ;
  (* what the checker EXAMINED and what it PASSED OVER, for `m9c
     --review`.  This checker never diagnoses an unknown type -- that
     softness is its contract -- so a site where one side had no type
     was accepted without being looked at, and "it compiled" does not
     say how many of those there were.  These do.

       i -- 0 .. StatKinds - 1: assignments, arguments, RETURN values,
            operands, CASE labels, THREAD arguments (each a place two
            types are held to each other: checked when both are
            known, skipped when either is not), and CASE over
            variants (checked when it was held to be total, skipped
            when the selector's type could not be resolved).
       j -- 0 .. StatLines (i) - 1: StatLine (i, j) is the source
            line of a site of kind i that was passed over, the first
            StatSites different lines in the order they were met.

     Module state like the diagnostics, and for the same reason: they
     accumulate over every CheckFile of the process.                *)

PROCEDURE ShowType (RO KEPT name: STR) ;
PROCEDURE ShownType () : STR ;
  (* for `m9c --show`, which asks the type of an expression
     (docs/kernel-show-plan.md): armed with a name, the checker
     records the type it computes for the right side of an
     assignment to that bare name and does not hold the two sides to
     each other -- the left side is a placeholder.  ShownType answers
     the last such type, in the checker's canonical spelling (`SLICE
     OF F64`, `PTR Frame.Fr`, `a real literal`), '' if none was
     met or a side was unknown.  M9 side only, like the counters
     above: nothing in the Pascal twin calls it.                    *)

PROCEDURE ShownRaises () : STR ;
  (* while armed, the checked exceptions a body raises and does not
     handle are recorded here instead of refused: the names, each
     followed by a blank, after a leading blank (' ValueRange ') *)

END Sem.


IMPLEMENTATION MODULE Sem ;

(* STATEFUL because the registry spans files: LoadFile accumulates
   across every unit before CheckFile runs against any of them.      *)

IMPORT Ast ;
IMPORT DynStr ;
IMPORT Print ;
IMPORT Text ;

CONST
  (* the kinds of site the review counters distinguish; the order is
     StatName's and the page's *)
  StAssign = 0 ; StArg = 1 ; StReturn = 2 ; StOperand = 3 ;
  StLabel = 4 ; StThread = 5 ; StCase = 6 ;
  MaxDepth = 8 ;              (* alias-chasing bound, as the oracle *)
  (* binding modes, one letter each, as the oracle spells them *)
  ModeVal = 'p' ; ModeVar = 'v' ; ModeOwn = 'o' ; ModeRo = 'r' ;
  ModeLocal = 'l' ; ModeModule = 'm' ; ModeBinder = 'b' ;

TYPE
  AKid = Ast.Kid ;

  ProcInfo = RECORD
    name, foreign, attrib, modName, sig : STR ;
    raises : SLICE OF STR ;
    node : Ast.Kid ;
    body : Ast.Kid ;                 (* the implementation's node, when
                                        one was loaded: AnswersFrame
                                        reads its body *)
    fromDef, hasBody : BOOL ;
  END ;

  Edge = RECORD
    caller : STR ;
    callees : SLICE OF STR ;
  END ;

  Binding = RECORD
    name, mode : STR ;
    ty : Ast.Kid ;
    ro : BOOL ;                (* a variable declared `VAR RO' *)
  END ;

  VariantInfo = RECORD
    typeName : STR ;
    variants : SLICE OF STR ;
    fields : SLICE OF AKid ;      (* fieldseq per variant, or NONE *)
  END ;

  ModuleInfo = RECORD
    name, foreignLang : STR ;
    stateful, hasDef, hasImpl : BOOL ;
    procs : SLICE OF ProcInfo ;
    nprocs : I64 ;
    vts : SLICE OF VariantInfo ;
    nvts : I64 ;
    tdNames : SLICE OF STR ;      (* type decls WITH bodies *)
    tdNodes : SLICE OF AKid ;
    ntds : I64 ;
    opaque : SLICE OF STR ;       (* opaque decls in the definition *)
    nopaque : I64 ;
    cnNames : SLICE OF STR ;      (* exported CONSTs ... *)
    cnTypes : SLICE OF STR ;      (* ... and their LitType, because a
                                     CONST is an untyped literal and
                                     stays one across a module edge *)
    ncns : I64 ;
    exNames : SLICE OF STR ;      (* EXCEPTION declarations *)
    nexc : I64 ;
    vrNames : SLICE OF STR ;      (* the definition's VARs, which an
                                     importer reads and writes as
                                     Mod.v (decision 28) ... *)
    vrTypes : SLICE OF AKid ;     (* ... their types, qualified in this
                                     module (QualifiedIn) ... *)
    vrRo : SLICE OF BOOL ;        (* ... and VAR RO, written by no one *)
    nvrs : I64 ;
  END ;

VAR
  showName, shown : STR ;     (* ShowType / ShownType *)
  shownRaises : STR ;         (* ShownRaises: ' A B ' *)
  pool : POOL ;
  mods : SLICE OF ModuleInfo ;
  nmods : I64 ;
  errs : SLICE OF STR ;
  nerrs : I64 ;
  ledger : SLICE OF STR ;
  nledger : I64 ;
  (* m9c --review: what was EXAMINED and what was PASSED OVER, per
     kind of site.  Softness is this checker's contract -- an unknown
     type never diagnoses -- and that makes "it compiled" a weaker
     claim than it sounds: a comparison one side of which had no type
     was not a comparison at all.  These say how often.  Counted on
     this side only; the oracle's diagnostics are what semdiff holds
     it to, and a count is not a diagnostic. *)
  statC, statS : ARRAY 7 OF I64 ;         (* StatKinds of them *)
  statR : ARRAY 7 OF I64 ;                (* lines recorded, per kind *)
  statL : ARRAY 42 OF I64 ;               (* StatKinds * StatSites lines
                                             of sites passed over *)
  curMod, canonCtx : STR ;
  curRoot : PTR Ast.Node ;     (* the file CheckFile is checking *)
  scope : SLICE OF Binding ;
  nscope : I64 ;
  fromMap : SLICE OF Binding ;
  nfrom : I64 ;
  graph : SLICE OF Edge ;
  ngraph : I64 ;
  calls : SLICE OF STR ;
  ncalls : I64 ;
  roots : SLICE OF STR ;
  nroots : I64 ;
  raised : SLICE OF Binding ;
  nraised : I64 ;
  handled : SLICE OF STR ;
  nhandled : I64 ;
  strNode : Ast.Kid ;         (* the SLICE OF CHAR that STR names *)
  consts : SLICE OF Binding ;   (* module CONST name -> literal type *)
  nconsts : I64 ;
  svConsts : I64 ;         (* nconsts before a procedure's own CONSTs *)
  nAgg : I64 ;             (* aggregate CONSTs in this unit: the walk
                              that guards them is skipped at zero *)
  own : SLICE OF Binding ;      (* owned name -> alive, or what took it *)
  nown : I64 ;
  curRetTy : STR ;              (* the enclosing procedure's result *)
  curUnsafe : BOOL ;
  curPure : BOOL ;                 (* inside a [PURE] body, par 3.2 *)
  curInBody : BOOL ;               (* the module init body, whose frame
                                      and module vars co-live, so a
                                      concat stored in a module var
                                      there does not outlive it *)
  boundMon : STR ;                 (* the bound monitor parameter, or
                                      empty when this procedure is not
                                      bound to one (par 6) *)
  inited : BOOL ;
  (* par 4.1, DIRECTIONAL: the ledger names stores; these decide
     which stores anyone outside the frame can still see.  Escape
     TARGETS per frame name ('<module>', '<return>', '<call>' or a
     reference parameter's name) in first-encounter order, symmetric
     alias edges the targets close over, and ledger stores PENDED
     until the walk ends and every escape of the destination has
     been seen.  All reset per procedure (CheckProcBody).           *)
  ansName : SLICE OF STR ;       (* AnswersFrame's memo: Module.Proc *)
  ansState : SLICE OF STR ;      (* 'yes', 'no', or 'busy' *)
  nans : I64 ;
  escName : SLICE OF STR ;
  escTgt : SLICE OF STR ;
  nesc : I64 ;
  edgeA : SLICE OF STR ;
  edgeB : SLICE OF STR ;
  nedge : I64 ;
  pendSrc : SLICE OF STR ;
  pendDst : SLICE OF STR ;
  pendLine : SLICE OF I64 ;
  pendCol : SLICE OF I64 ;
  npend : I64 ;
  keptP : SLICE OF STR ;        (* params declared KEPT (par 4.1),
                                   with the declaring identifier's
                                   position beside each *)
  keptLn : SLICE OF I64 ;
  keptCl : SLICE OF I64 ;
  nkept : I64 ;
  keptU : SLICE OF STR ;        (* KEPT params the analysis saw
                                   retained -- the complement is the
                                   kept-unseen ledger class *)
  nkeptU : I64 ;
  (* par 4.1 value provenance: which BORROWS a local or binder
     carries -- a copied reference, a binder's view, a sub-slice --
     plus directed copy edges closed at flush.  No kill on
     reassignment: the approximation errs into the ledger. *)
  carryN : SLICE OF STR ;
  carryB : SLICE OF STR ;
  ncarry : I64 ;
  carryEA : SLICE OF STR ;
  carryEB : SLICE OF STR ;
  ncedge : I64 ;
  (* par 2.3: locals/binders that currently hold a FRAME-SCOPED
     string -- a concatenation, which lives in this frame's arena
     and dies with it.  Escaping one (to a module var, through a
     reference parameter, or via RETURN of the holding name) is the
     use-after-free the frame model would otherwise permit silently.
     Tainted on assignment of a concatenation, cleared when the name
     is given a durable value again.  Reset per frame.  Since the
     frame form of NEW (docs/pool-elision-plan.md, rule 1) a name may
     also hold a FRAME ALLOCATION, and fvalKind says which, for the
     diagnostic: 'a concatenation' or 'a frame allocation'. *)
  fvalName : SLICE OF STR ;
  fvalKind : SLICE OF STR ;
  nfval : I64 ;
  (* the bare names holding a POOL allocation -- `NEW (pool, T)` or
     the object form `NEW (d, T)` -- which is nobody's to own: a
     copy out of such a name is a copy, not a move.  Before stage 5
     such a local said `IN pool` and was no owned candidate by type;
     the elided `j : PTR Job ; j := NEW (f, Job)` is the same storage
     with no clause to say so (VertTransform.RunBands handed j to a
     Band per thread in a loop and read `use of j after it was
     moved`). *)
  pvalName : SLICE OF STR ;
  npval : I64 ;

(* ---- output ---- *)

PROCEDURE Setup () =
VAR ch, sn : PTR Ast.Node IN pool ;
BEGIN
  IF inited THEN RETURN END ;
  inited := TRUE ;
  ch := Ast.NewNode (pool, Ast.NQualident, 0, 0) ;
  ch.a := 'CHAR' ;
  sn := Ast.NewNode (pool, Ast.NSliceType, 0, 0) ;
  Ast.Add (pool, sn, SOME (ch)) ;
  Ast.Add (pool, sn, NONE) ;
  strNode := SOME (sn) ;
  mods := NEW (pool, ModuleInfo, 8) ;
  errs := NEW (pool, STR, 16) ;
  ledger := NEW (pool, STR, 8) ;
  scope := NEW (pool, Binding, 32) ;
  fromMap := NEW (pool, Binding, 8) ;
  graph := NEW (pool, Edge, 32) ;
  calls := NEW (pool, STR, 16) ;
  roots := NEW (pool, STR, 8) ;
  raised := NEW (pool, Binding, 8) ;
  handled := NEW (pool, STR, 8) ;
  escName := NEW (pool, STR, 16) ;
  ansName := NEW (pool, STR, 64) ;
  ansState := NEW (pool, STR, 64) ;
  escTgt := NEW (pool, STR, 16) ;
  fvalName := NEW (pool, STR, 16) ;
  fvalKind := NEW (pool, STR, 16) ;
  pvalName := NEW (pool, STR, 16) ;
  edgeA := NEW (pool, STR, 8) ;
  edgeB := NEW (pool, STR, 8) ;
  pendSrc := NEW (pool, STR, 8) ;
  pendDst := NEW (pool, STR, 8) ;
  pendLine := NEW (pool, I64, 8) ;
  pendCol := NEW (pool, I64, 8) ;
  keptP := NEW (pool, STR, 8) ;
  keptLn := NEW (pool, I64, 8) ;
  keptCl := NEW (pool, I64, 8) ;
  keptU := NEW (pool, STR, 8) ;
  carryN := NEW (pool, STR, 8) ;
  carryB := NEW (pool, STR, 8) ;
  carryEA := NEW (pool, STR, 8) ;
  carryEB := NEW (pool, STR, 8)
END Setup ;

PROCEDURE PushErr (VAR list: SLICE OF STR ; VAR n: I64 ; RO KEPT s: STR) =
VAR
  nb : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF n = LEN (list) THEN
    nb := NEW (pool, STR, 2 * LEN (list)) ;
    FOR i := 0 TO n - 1 DO nb[i] := list[i] END ;
    list := nb
  END ;
  list[n] := s ;
  n := n + 1
END PushErr ;

(* 'line:col ctx: message' -- the oracle's shape, and the bytes the
   differential compares *)
PROCEDURE Diag (VAR list: SLICE OF STR ; VAR n: I64 ;
                line, col: I64 ; RO ctx: STR ; RO msg: STR) =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendI64 (d, line) ;
  DynStr.AppendChar (d, ':') ;
  DynStr.AppendI64 (d, col) ;
  DynStr.AppendChar (d, ' ') ;
  DynStr.Append (d, ctx) ;
  DynStr.Append (d, ': ') ;
  DynStr.Append (d, msg) ;
  PushErr (list, n, DynStr.View (d))
END Diag ;

PROCEDURE ErrN (n: PTR Ast.Node ; RO ctx: STR ; RO msg: STR) =
BEGIN
  Diag (errs, nerrs, n.line, n.col, ctx, msg)
END ErrN ;

PROCEDURE ErrCount () : I64 =
BEGIN
  RETURN nerrs
END ErrCount ;

PROCEDURE ErrAt (i: I64) : STR RAISES IndexError =
BEGIN
  IF i < 0 OR i >= nerrs THEN RAISE IndexError (i, nerrs) END ;
  RETURN errs[i]
END ErrAt ;

PROCEDURE LedgerCount () : I64 =
BEGIN
  RETURN nledger
END LedgerCount ;

PROCEDURE LedgerAt (i: I64) : STR RAISES IndexError =
BEGIN
  IF i < 0 OR i >= nledger THEN RAISE IndexError (i, nledger) END ;
  RETURN ledger[i]
END LedgerAt ;

(* ---- the registry ---- *)

PROCEDURE FindMod (RO n: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nmods - 1 DO
    IF Text.Eq (mods[i].name, n) THEN RETURN i END
  END ;
  RETURN -1
END FindMod ;

PROCEDURE NewMod (RO KEPT n: STR) : I64 =
VAR
  nb : SLICE OF ModuleInfo ;
  i : I64 ;
BEGIN
  IF nmods = LEN (mods) THEN
    nb := NEW (pool, ModuleInfo, 2 * LEN (mods)) ;
    FOR i := 0 TO nmods - 1 DO nb[i] := mods[i] END ;
    mods := nb
  END ;
  mods[nmods].name := n ;
  mods[nmods].procs := NEW (pool, ProcInfo, 8) ;
  mods[nmods].nprocs := 0 ;
  mods[nmods].vts := NEW (pool, VariantInfo, 4) ;
  mods[nmods].nvts := 0 ;
  mods[nmods].tdNames := NEW (pool, STR, 8) ;
  mods[nmods].tdNodes := NEW (pool, AKid, 8) ;
  mods[nmods].ntds := 0 ;
  mods[nmods].opaque := NEW (pool, STR, 4) ;
  mods[nmods].nopaque := 0 ;
  nmods := nmods + 1 ;
  RETURN nmods - 1
END NewMod ;

PROCEDURE FindProcIn (m: I64 ; RO n: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].nprocs - 1 DO
    IF Text.Eq (mods[m].procs[i].name, n) THEN RETURN i END
  END ;
  RETURN -1
END FindProcIn ;

PROCEDURE FindTypeIn (m: I64 ; RO n: STR) : Ast.Kid =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].ntds - 1 DO
    IF Text.Eq (mods[m].tdNames[i], n) THEN RETURN mods[m].tdNodes[i] END
  END ;
  RETURN NONE
END FindTypeIn ;

PROCEDURE IsOpaqueIn (m: I64 ; RO n: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].nopaque - 1 DO
    IF Text.Eq (mods[m].opaque[i], n) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsOpaqueIn ;

PROCEDURE RaisesOf (VAR pl: POOL ; KEPT p: PTR Ast.Node) : SLICE OF STR =
VAR
  r : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF p.kids[2] IS SOME rs THEN
    r := NEW (pl, STR, rs.nkids) ;
    FOR i := 0 TO rs.nkids - 1 DO
      IF rs.kids[i] IS SOME q THEN
        IF LEN (q.b) > 0 THEN r[i] := q.b ELSE r[i] := q.a END
      END
    END ;
    RETURN r
  END ;
  RETURN NEW (pl, STR, 0)
END RaisesOf ;

(* an exception cited by RAISE, a RAISES clause or a handler must be
   one the reader (and the generator) can find, resolving exactly as
   Gen.ExcRef does: a qualified name in the module it names, a bare
   name locally, predeclared, or declared in some loaded module (both
   direct and transitive deps register their exceptions).  A name
   found nowhere is accepted by neither -- catch it HERE. *)
PROCEDURE ExcKnown (RO qual: STR ; RO nm: STR) : BOOL =
VAR m, i : I64 ;
BEGIN
  IF LEN (qual) > 0 AND NOT Text.Eq (qual, curMod) THEN
    m := FindMod (qual) ;
    (* an unknown module is the softness contract's business; only a
       KNOWN, non-foreign module lacking the exception is an error *)
    IF m < 0 THEN RETURN TRUE END ;
    IF LEN (mods[m].foreignLang) > 0 THEN RETURN TRUE END ;
    RETURN HasExcIn (m, nm)
  END ;
  (* bare, or qualified with the current module *)
  IF Text.Eq (nm, 'Overflow') OR Text.Eq (nm, 'IndexError')
     OR Text.Eq (nm, 'OutOfMemory') OR Text.Eq (nm, 'ValueRange') THEN
    RETURN TRUE
  END ;
  FOR i := 0 TO nmods - 1 DO
    IF HasExcIn (i, nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END ExcKnown ;

PROCEDURE CheckExcName (KEPT n: PTR Ast.Node ; RO ctx: STR) =
VAR qual, nm : STR ;
BEGIN
  qual := '' ; nm := n.a ;
  IF LEN (n.b) > 0 THEN qual := n.a ; nm := n.b END ;
  IF NOT ExcKnown (qual, nm) THEN
    ErrN (n, ctx, 'unknown exception: ' + nm)
  END
END CheckExcName ;

(* ---- a type named in a KNOWN module must exist there ----

   The softness contract stands: an unknown type never diagnoses,
   because a bare name found nowhere may simply be a missing IMPORT,
   and a checker that guesses produces diagnostics nobody can act on.
   But `DynStr.Dstring' names a module that IS loaded and a type it
   does not declare.  That is a typo, not softness -- and it rode
   through --check without a word to surface as cc's `unknown type
   name DynStr_Dstring', the M9 name mangled and the M9 line gone
   (2026-09-15).  Same rule as ExcKnown, two hundred lines up: only
   a known, non-foreign module lacking the name is an error.

   Checked ONCE, at the declaration, in declaration order; every
   lookup that follows stays soft, so nothing cascades. *)
PROCEDURE TypeKnown (RO qual: STR ; RO nm: STR) : BOOL =
VAR m : I64 ;
BEGIN
  IF LEN (qual) = 0 THEN RETURN TRUE END ;
  m := FindMod (qual) ;
  IF m < 0 THEN RETURN TRUE END ;
  IF LEN (mods[m].foreignLang) > 0 THEN RETURN TRUE END ;
  IF FindTypeIn (m, nm) IS SOME t THEN RETURN TRUE END ;
  RETURN IsOpaqueIn (m, nm)
END TypeKnown ;

PROCEDURE CheckFieldTypes (fs: Ast.Kid ; RO ctx: STR) ;

PROCEDURE CheckTypeNode (t: Ast.Kid ; RO ctx: STR) =
  (* every qualident reachable through PTR, OPT, SHARED, SLICE, ARRAY,
     GRID and the fields of a record, monitor or case record *)
VAR i : I64 ;
BEGIN
  IF t IS SOME n THEN
    CASE n.kind OF
    | Ast.NQualident :
        IF LEN (n.b) > 0 AND NOT TypeKnown (n.a, n.b) THEN
          ErrN (n, ctx, 'unknown type: ' + n.a + '.' + n.b + ' -- '
                        + n.a + ' declares no such type')
        END
    | Ast.NPtrType : CheckTypeNode (n.kids[0], ctx)
    | Ast.NOptType : CheckTypeNode (n.kids[0], ctx)
    | Ast.NSharedType : CheckTypeNode (n.kids[0], ctx)
    | Ast.NSliceType :
        CheckTypeNode (n.kids[0], ctx) ;
        IF IsBareProc (n.kids[0]) THEN
          ErrN (n, ctx, 'a slice or array of procedure values is not in the language yet (par 2.2.3)')
        END
    | Ast.NArrayType :
        CheckTypeNode (n.kids[1], ctx) ;
        IF IsBareProc (n.kids[1]) THEN
          ErrN (n, ctx, 'a slice or array of procedure values is not in the language yet (par 2.2.3)')
        END
    | Ast.NGridType : CheckTypeNode (n.kids[1], ctx)
    | Ast.NProcType :
        IF n.kids[0] IS SOME pl THEN
          FOR i := 0 TO pl.nkids - 1 DO
            IF pl.kids[i] IS SOME grp THEN CheckTypeNode (grp.kids[1], ctx) END
          END
        END ;
        CheckTypeNode (n.kids[1], ctx)
    | Ast.NRecordType :
        (* kids[0] is the extension base, when there is one *)
        CheckTypeNode (n.kids[0], ctx) ;
        CheckFieldTypes (n.kids[1], ctx)
    | Ast.NMonitorType : CheckFieldTypes (n.kids[0], ctx)
    | Ast.NCaseRecordType :
        FOR i := 0 TO n.nkids - 1 DO
          IF n.kids[i] IS SOME v THEN CheckFieldTypes (v.kids[0], ctx) END
        END
    ELSE
    END
  END
END CheckTypeNode ;

PROCEDURE CheckFieldTypes (fs: Ast.Kid ; RO ctx: STR) =
VAR i : I64 ;
BEGIN
  IF fs IS SOME seq THEN
    FOR i := 0 TO seq.nkids - 1 DO
      IF seq.kids[i] IS SOME g THEN
        CheckTypeNode (g.kids[1], ctx) ;
        IF IsBareProc (g.kids[1]) THEN
          ErrN (g, ctx, 'a field of procedure type must be OPT (par 2.2.3)')
        END
      END
    END
  END
END CheckFieldTypes ;

PROCEDURE CheckVarTypes (holder: PTR Ast.Node ; RO ctx: STR) =
  (* the VAR sections directly under a unit or a procedure body *)
VAR a, b : I64 ;
BEGIN
  FOR a := 0 TO holder.nkids - 1 DO
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NVarSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME vd THEN
            CheckTypeNode (vd.kids[1], ctx) ;
            IF IsBareProc (vd.kids[1]) THEN
              ErrN (vd, ctx, 'a variable of procedure type must be OPT (par 2.2.3)')
            END
          END
        END
      ELSIF sect.kind = Ast.NTypeSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME td THEN CheckTypeNode (td.kids[0], ctx) END
        END
      END
    END
  END
END CheckVarTypes ;

PROCEDURE CheckDeclTypes (u: PTR Ast.Node) =
  (* one pass over a unit, in declaration order: its TYPE and VAR
     sections under the unit's own name, then each procedure's
     parameters, return type and locals under the procedure's *)
VAR i, a : I64 ;
BEGIN
  CheckVarTypes (u, u.a) ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        IF d.kids[0] IS SOME pl THEN
          FOR a := 0 TO pl.nkids - 1 DO
            IF pl.kids[a] IS SOME grp THEN
              CheckTypeNode (grp.kids[1], u.a + '.' + d.a)
            END
          END
        END ;
        CheckTypeNode (d.kids[1], u.a + '.' + d.a) ;
        IF IsBareProc (d.kids[1]) THEN
          ErrN (d, u.a + '.' + d.a,
            'a procedure cannot answer a procedure value (par 2.2.3)')
        END ;
        IF d.kids[4] IS SOME body THEN
          CheckVarTypes (body, u.a + '.' + d.a)
        END
      END
    END
  END
END CheckDeclTypes ;

(* the signature as TEXT: two declarations are the same declaration
   exactly when the printer renders them the same way, which is why
   def/impl conformance is a string comparison and not a tree walk *)
PROCEDURE SigOf (KEPT p: PTR Ast.Node) : STR =
VAR
  d : PTR DynStr.DString IN pool ;
  r : SLICE OF STR ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendChar (d, '(') ;
  DynStr.Append (d, Print.ParamsText (p.kids[0])) ;
  DynStr.AppendChar (d, ')') ;
  IF p.kids[1] IS SOME rt THEN
    DynStr.Append (d, ' : ') ;
    DynStr.Append (d, Print.TypeText (pool, p.kids[1]))
  END ;
  IF p.kids[2] IS SOME rs THEN
    DynStr.Append (d, ' RAISES ') ;
    r := RaisesOf (pool, p) ;
    FOR i := 0 TO LEN (r) - 1 DO
      IF i > 0 THEN DynStr.Append (d, ', ') END ;
      DynStr.Append (d, r[i])
    END
  END ;
  IF p.kids[3] IS SOME at THEN
    DynStr.Append (d, ' [') ;
    DynStr.Append (d, at.a) ;
    DynStr.AppendChar (d, ']')
  END ;
  RETURN DynStr.View (d)
END SigOf ;

PROCEDURE AddProc (m: I64 ; p: ProcInfo) =
VAR
  nb : SLICE OF ProcInfo ;
  i : I64 ;
BEGIN
  IF mods[m].nprocs = LEN (mods[m].procs) THEN
    nb := NEW (pool, ProcInfo, 2 * LEN (mods[m].procs)) ;
    FOR i := 0 TO mods[m].nprocs - 1 DO nb[i] := mods[m].procs[i] END ;
    mods[m].procs := nb
  END ;
  mods[m].procs[mods[m].nprocs] := p ;
  mods[m].nprocs := mods[m].nprocs + 1
END AddProc ;

PROCEDURE AddType (m: I64 ; RO KEPT n: STR ; KEPT body: Ast.Kid) =
VAR
  ns : SLICE OF STR ;
  nk : SLICE OF AKid ;
  i : I64 ;
BEGIN
  IF mods[m].ntds = LEN (mods[m].tdNames) THEN
    ns := NEW (pool, STR, 2 * LEN (mods[m].tdNames)) ;
    nk := NEW (pool, AKid, 2 * LEN (mods[m].tdNodes)) ;
    FOR i := 0 TO mods[m].ntds - 1 DO
      ns[i] := mods[m].tdNames[i] ;
      nk[i] := mods[m].tdNodes[i]
    END ;
    mods[m].tdNames := ns ;
    mods[m].tdNodes := nk
  END ;
  mods[m].tdNames[mods[m].ntds] := n ;
  mods[m].tdNodes[mods[m].ntds] := body ;
  mods[m].ntds := mods[m].ntds + 1
END AddType ;

PROCEDURE AddConst (m: I64 ; RO KEPT n: STR ; RO KEPT ty: STR) =
VAR
  ns, ts : SLICE OF STR ;
  i : I64 ;
BEGIN
  (* what is remembered is the LitType, not a type: `Par.Pi180` must
     adapt in another module exactly as `Pi180` adapts in its own *)
  IF mods[m].ncns = LEN (mods[m].cnNames) THEN
    ns := NEW (pool, STR, 2 * LEN (mods[m].cnNames) + 16) ;
    ts := NEW (pool, STR, 2 * LEN (mods[m].cnTypes) + 16) ;
    FOR i := 0 TO mods[m].ncns - 1 DO
      ns[i] := mods[m].cnNames[i] ;
      ts[i] := mods[m].cnTypes[i]
    END ;
    mods[m].cnNames := ns ;
    mods[m].cnTypes := ts
  END ;
  mods[m].cnNames[mods[m].ncns] := n ;
  mods[m].cnTypes[mods[m].ncns] := ty ;
  mods[m].ncns := mods[m].ncns + 1
END AddConst ;

(* an exported variable: declared in the definition, so an importer
   names it Mod.v (decision 28) *)
PROCEDURE AddExportVar (m: I64 ; RO KEPT n: STR ; KEPT ty: AKid ; ro: BOOL) =
VAR
  ns : SLICE OF STR ;
  ts : SLICE OF AKid ;
  rs : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  IF mods[m].nvrs = LEN (mods[m].vrNames) THEN
    ns := NEW (pool, STR, 2 * LEN (mods[m].vrNames) + 8) ;
    ts := NEW (pool, AKid, 2 * LEN (mods[m].vrNames) + 8) ;
    rs := NEW (pool, BOOL, 2 * LEN (mods[m].vrNames) + 8) ;
    FOR i := 0 TO mods[m].nvrs - 1 DO
      ns[i] := mods[m].vrNames[i] ;
      ts[i] := mods[m].vrTypes[i] ;
      rs[i] := mods[m].vrRo[i]
    END ;
    mods[m].vrNames := ns ;
    mods[m].vrTypes := ts ;
    mods[m].vrRo := rs
  END ;
  mods[m].vrNames[mods[m].nvrs] := n ;
  mods[m].vrTypes[mods[m].nvrs] := ty ;
  mods[m].vrRo[mods[m].nvrs] := ro ;
  mods[m].nvrs := mods[m].nvrs + 1
END AddExportVar ;

(* is v a variable module m's definition exports? *)
PROCEDURE ExportsVar (m: I64 ; RO v: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  FOR i := 0 TO mods[m].nvrs - 1 DO
    IF Text.Eq (mods[m].vrNames[i], v) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END ExportsVar ;

PROCEDURE AddExc (m: I64 ; RO KEPT n: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF mods[m].nexc = LEN (mods[m].exNames) THEN
    ns := NEW (pool, STR, 2 * LEN (mods[m].exNames) + 16) ;
    FOR i := 0 TO mods[m].nexc - 1 DO
      ns[i] := mods[m].exNames[i]
    END ;
    mods[m].exNames := ns
  END ;
  mods[m].exNames[mods[m].nexc] := n ;
  mods[m].nexc := mods[m].nexc + 1
END AddExc ;

PROCEDURE HasExcIn (m: I64 ; RO n: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].nexc - 1 DO
    IF Text.Eq (mods[m].exNames[i], n) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasExcIn ;

PROCEDURE ModConstType (RO modName: STR ; RO n: STR ;
                        VAR found: BOOL) : STR =
VAR m, i : I64 ;
BEGIN
  found := FALSE ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN '' END ;
  FOR i := 0 TO mods[m].ncns - 1 DO
    IF Text.Eq (mods[m].cnNames[i], n) THEN
      found := TRUE ;
      RETURN mods[m].cnTypes[i]
    END
  END ;
  RETURN ''
END ModConstType ;

PROCEDURE AddOpaque (m: I64 ; RO KEPT n: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF mods[m].nopaque = LEN (mods[m].opaque) THEN
    ns := NEW (pool, STR, 2 * LEN (mods[m].opaque)) ;
    FOR i := 0 TO mods[m].nopaque - 1 DO ns[i] := mods[m].opaque[i] END ;
    mods[m].opaque := ns
  END ;
  mods[m].opaque[mods[m].nopaque] := n ;
  mods[m].nopaque := mods[m].nopaque + 1
END AddOpaque ;

PROCEDURE AddVariants (m: I64 ; RO KEPT tn: STR ; KEPT cr: PTR Ast.Node) =
VAR
  nb : SLICE OF VariantInfo ;
  i, k : I64 ;
BEGIN
  IF mods[m].nvts = LEN (mods[m].vts) THEN
    nb := NEW (pool, VariantInfo, 2 * LEN (mods[m].vts)) ;
    FOR i := 0 TO mods[m].nvts - 1 DO nb[i] := mods[m].vts[i] END ;
    mods[m].vts := nb
  END ;
  k := mods[m].nvts ;
  mods[m].vts[k].typeName := tn ;
  mods[m].vts[k].variants := NEW (pool, STR, cr.nkids) ;
  mods[m].vts[k].fields := NEW (pool, AKid, cr.nkids) ;
  FOR i := 0 TO cr.nkids - 1 DO
    IF cr.kids[i] IS SOME v THEN
      mods[m].vts[k].variants[i] := v.a ;
      mods[m].vts[k].fields[i] := v.kids[0]
    END
  END ;
  mods[m].nvts := k + 1
END AddVariants ;

PROCEDURE CollectUnit (KEPT u: PTR Ast.Node) =
VAR
  m, i, j, pi : I64 ;
  p : ProcInfo ;
BEGIN
  m := FindMod (u.a) ;
  IF m < 0 THEN m := NewMod (u.a) END ;
  IF u.kind = Ast.NDefinition THEN
    mods[m].hasDef := TRUE ;
    IF LEN (u.b) > 0 THEN mods[m].foreignLang := u.b END ;
    IF u.f2 THEN mods[m].stateful := TRUE END
  END ;
  IF u.kind = Ast.NImplementation THEN mods[m].hasImpl := TRUE END ;

  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcIn (m, d.a) ;
        IF pi < 0 THEN
          p.name := d.a ;
          p.modName := mods[m].name ;
          p.foreign := d.b ;
          IF d.kids[3] IS SOME at THEN p.attrib := at.a
          ELSE p.attrib := '' END ;
          p.raises := RaisesOf (pool, d) ;
          p.sig := SigOf (d) ;
          p.node := SOME (d) ;
          p.body := NONE ;
          p.fromDef := u.kind = Ast.NDefinition ;
          p.hasBody := FALSE ;
          IF d.kids[4] IS SOME bd THEN
            p.hasBody := TRUE ;
            p.body := SOME (d)
          END ;
          AddProc (m, p)
        ELSE
          IF d.kids[4] IS SOME bd2 THEN
            mods[m].procs[pi].hasBody := TRUE ;
            mods[m].procs[pi].body := SOME (d)
          END
        END
      ELSIF d.kind = Ast.NExcSection THEN
        (* the declared exceptions: RAISE/RAISES/handler may only
           cite a name the reader can find *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN AddExc (m, xd.a) END
        END
      ELSIF d.kind = Ast.NVarSection AND u.kind = Ast.NDefinition THEN
        (* the definition's variables are the module's exports: an
           importer reads and writes them as Mod.v (decision 28) *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME vids THEN
              FOR pi := 0 TO vids.nkids - 1 DO
                IF vids.kids[pi] IS SOME vid THEN
                  AddExportVar (m, vid.a, QualifiedIn (vd.kids[1], mods[m].name),
                                vd.f3)
                END
              END
            END
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        (* a CONST is an untyped literal; what is kept is its
           LitType, so an importer sees it adapt as its own module
           does *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd2 THEN
            AddConst (m, cd2.a, LitType (cd2.kids[0]))
          END
        END
      ELSIF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF td.kids[0] IS SOME body THEN
              IF FindTypeIn (m, td.a) IS SOME already THEN
                (* the definition's copy wins; an implementation may
                   restate an opaque type's body *)
              ELSE
                AddType (m, td.a, td.kids[0])
              END ;
              IF body.kind = Ast.NCaseRecordType THEN
                AddVariants (m, td.a, body)
              END ;
              (* an enumeration is a payload-less case record: its
                 members ARE its variants, so Colour.Red constructs, a
                 CASE over it is total, and it crosses modules -- all
                 from the case-record machinery.  nkIdent and a
                 payload-less nkVariant have the same shape here:
                 name in .a, no payload kid (docs/enum-plan.md). *)
              IF body.kind = Ast.NEnumType THEN
                AddVariants (m, td.a, body)
              END
            ELSE
              IF u.kind = Ast.NDefinition THEN AddOpaque (m, td.a) END
            END
          END
        END
      END
    END
  END
END CollectUnit ;

(* NaN, the predeclared quiet NaN (report par 2.1; Alex 2026-10-05):
   a bare designator NaN becomes the real literal whose text is C's
   NAN, so it is typed, adapts to F32 and is emitted as a literal is.
   Once per file, before anything reads it, here and in both
   generators (Gen.NanWalk): the generator also runs without the
   checker.  A declaration may not take the name (DeclOnce), so a
   NaN is always this one. *)
PROCEDURE NanWalk (VAR n: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND Text.Eq (n.a, 'NaN') THEN
    n.kind := Ast.NReal ;
    n.a := 'NAN'
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN NanWalk (c) END
  END
END NanWalk ;

PROCEDURE IsNanLit (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN
    RETURN n.kind = Ast.NReal AND Text.Eq (n.a, 'NAN')
  END ;
  RETURN FALSE
END IsNanLit ;

PROCEDURE LoadFile (root: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  Setup () ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME w THEN NanWalk (w) END
  END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN CollectUnit (u) END
  END
END LoadFile ;


(* ---- types, canonicalised ---- *)

(* A type is its CANONICAL STRING: 'I64', 'PTR Json.Node',
   'SLICE OF CHAR'.  Records, monitors and opaques are nominal
   (Mod.Name); aliases chase to structure; IN-pool and RO are not
   part of identity, because they annotate the binding and not the
   type.  Two types are the same type exactly when these strings
   match, which is also how def and impl signatures are compared. *)
PROCEDURE LookupTypeName (RO modName: STR ; RO typeName: STR)
  : Ast.Kid =
VAR
  m, i : I64 ;
BEGIN
  IF LEN (modName) > 0 THEN
    m := FindMod (modName) ;
    IF m < 0 THEN RETURN NONE END ;
    RETURN FindTypeIn (m, typeName)
  END ;
  m := FindMod (curMod) ;
  IF m >= 0 THEN
    IF FindTypeIn (m, typeName) IS SOME t THEN RETURN SOME (t) END
  END ;
  FOR i := 0 TO nmods - 1 DO
    IF FindTypeIn (i, typeName) IS SOME t2 THEN RETURN SOME (t2) END
  END ;
  RETURN NONE
END LookupTypeName ;

PROCEDURE ResolveType (t: Ast.Kid) : Ast.Kid =
VAR
  cur : Ast.Kid ;
  depth : I64 ;
BEGIN
  cur := t ;
  depth := 0 ;
  LOOP
    IF cur IS SOME n THEN
      IF n.kind # Ast.NQualident THEN RETURN cur END ;
      IF depth >= MaxDepth THEN RETURN NONE END ;
      IF LEN (n.b) = 0 AND Text.Eq (n.a, 'STR') THEN RETURN strNode END ;
      cur := LookupTypeName (n.b, n.a) ;
      IF LEN (n.b) = 0 THEN cur := LookupTypeName ('', n.a)
      ELSE cur := LookupTypeName (n.a, n.b) END ;
      depth := depth + 1
    ELSE
      RETURN NONE
    END
  END
END ResolveType ;

(* Three lists of type names, each a constant table (report par
   2.2.4) and a search; chains of Text.Eq until 2026-10-01. *)
CONST
  BuiltinTys = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'F32', 'F64',
    'BYTE', 'BOOL', 'CHAR'
  ] ;
  (* the conversions that can refuse a value: RAISES ValueRange *)
  ConvVR = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'BYTE', 'CHR'
  ] ;
  (* what widens to an I64 without loss, so I64 (x) is total *)
  WidensTo64 = [
    'C.Int', 'C.SSizeT', 'BYTE', 'I8', 'I16', 'I32', 'U8', 'U16', 'U32'
  ] ;

PROCEDURE IsBuiltinTy (RO n: STR) : BOOL =
BEGIN
  RETURN Text.OneOf (n, BuiltinTys)
END IsBuiltinTy ;

PROCEDURE ScalarAlias (RO name: STR) : STR ;

PROCEDURE WidthTwin (RO name: STR ; single: BOOL) : STR ;

PROCEDURE CanonT (t: Ast.Kid ; depth: I64) : STR ;
PROCEDURE ArrEnumBoundOf (declN: Ast.Kid) : STR ;

(* hoisted rather than nested: M9 has no nested procedures.  They
   PARSE -- a procedure body accepts declarations, and PROCEDURE is
   one -- but the checker never registers them, so the call reads as
   unknown.  Logged as owed work; the grammar should refuse what the
   checker cannot see. *)
PROCEDURE TryModCanon (mi: I64 ; RO typeName: STR ; depth: I64) : STR =
BEGIN
  IF mi < 0 THEN RETURN '' END ;
  IF FindTypeIn (mi, typeName) IS SOME td THEN
    IF td.kind = Ast.NRecordType OR td.kind = Ast.NCaseRecordType OR
       td.kind = Ast.NMonitorType OR td.kind = Ast.NEnumType THEN
      RETURN Qualify (mods[mi].name, typeName)
    END ;
    RETURN CanonT (SOME (td), depth + 1)
  END ;
  IF IsOpaqueIn (mi, typeName) THEN
    RETURN Qualify (mods[mi].name, typeName)
  END ;
  RETURN ''
END TryModCanon ;

PROCEDURE CanonQual (RO modName: STR ; RO typeName: STR ; depth: I64)
  : STR =
VAR
  m, i : I64 ;
  s : STR ;
BEGIN
  IF LEN (modName) > 0 THEN
    RETURN TryModCanon (FindMod (modName), typeName, depth)
  END ;
  (* bare names resolve in their OWNING module first: a callee's
     signature written in Json must not find Ast's Node just because
     Ast loaded earlier *)
  IF LEN (canonCtx) > 0 THEN m := FindMod (canonCtx)
  ELSE m := FindMod (curMod) END ;
  s := TryModCanon (m, typeName, depth) ;
  IF LEN (s) > 0 THEN RETURN s END ;
  FOR i := 0 TO nmods - 1 DO
    s := TryModCanon (i, typeName, depth) ;
    IF LEN (s) > 0 THEN RETURN s END
  END ;
  RETURN ''
END CanonQual ;

(* scalar-by-scalar order on two names, for the RAISES list below *)
PROCEDURE SigLess (RO a: STR ; RO b: STR) : BOOL =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < LEN (a) AND i < LEN (b) DO
    IF a[i] # b[i] THEN RETURN a[i] < b[i] END ;
    i := i + 1
  END ;
  RETURN LEN (a) < LEN (b)
END SigLess ;

(* the canonical text of a procedure type, or of a procedure's head
   (par 2.2.3): the parameter modes and types with no names, the
   result with its RO, and the RAISES names bare and sorted.  Two
   procedure types are the same type exactly when this text is the
   same.  A procedure FITS a procedure type when its head renders the
   same up to RAISES and it raises no more than the type allows
   (ProcFits, since 2026-10-02; until then the RAISES had to match to
   the letter too, which made every quiet callback declare one). *)
PROCEDURE ProcSig (pl: Ast.Kid ; rt: Ast.Kid ; ro: BOOL ; rs: Ast.Kid ;
                   depth: I64) : STR =
VAR
  d : PTR DynStr.DString IN pool ;
  g, j, i, k : I64 ;
  first : BOOL ;
  s, tmp : STR ;
  names : SLICE OF STR ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, 'PROCEDURE (') ;
  first := TRUE ;
  IF pl IS SOME pln THEN
    FOR g := 0 TO pln.nkids - 1 DO
      IF pln.kids[g] IS SOME grp THEN
        s := CanonT (grp.kids[1], depth + 1) ;
        IF LEN (s) = 0 THEN RETURN '' END ;
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF NOT first THEN DynStr.Append (d, ' ; ') END ;
            first := FALSE ;
            IF grp.f1 THEN DynStr.Append (d, 'VAR ') END ;
            IF grp.f2 THEN DynStr.Append (d, 'OWN ') END ;
            IF grp.f3 THEN DynStr.Append (d, 'RO ') END ;
            IF grp.f4 THEN DynStr.Append (d, 'KEPT ') END ;
            DynStr.Append (d, s)
          END
        END
      END
    END
  END ;
  DynStr.AppendChar (d, ')') ;
  IF rt IS SOME rtn THEN
    s := CanonT (rt, depth + 1) ;
    IF LEN (s) = 0 THEN RETURN '' END ;
    DynStr.Append (d, ' : ') ;
    IF ro THEN DynStr.Append (d, 'RO ') END ;
    DynStr.Append (d, s)
  END ;
  IF rs IS SOME rsn THEN
    names := NEW (pool, STR, rsn.nkids) ;
    FOR i := 0 TO rsn.nkids - 1 DO
      IF rsn.kids[i] IS SOME q THEN
        IF LEN (q.b) > 0 THEN names[i] := q.b ELSE names[i] := q.a END
      END
    END ;
    FOR i := 1 TO rsn.nkids - 1 DO
      k := i ;
      WHILE k > 0 AND SigLess (names[k], names[k - 1]) DO
        tmp := names[k] ;
        names[k] := names[k - 1] ;
        names[k - 1] := tmp ;
        k := k - 1
      END
    END ;
    DynStr.Append (d, ' RAISES ') ;
    FOR i := 0 TO rsn.nkids - 1 DO
      IF i > 0 THEN DynStr.Append (d, ', ') END ;
      DynStr.Append (d, names[i])
    END
  END ;
  RETURN DynStr.View (d)
END ProcSig ;

(* does a declared type resolve to a bare procedure type?  The four
   refusals of par 2.2.3 ask this: a variable or field of procedure
   type must be OPT, because a procedure value has no zero and a
   zeroed one would be a call into nothing. *)
PROCEDURE IsBareProc (t: Ast.Kid) : BOOL =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    RETURN r.kind = Ast.NProcType
  END ;
  RETURN FALSE
END IsBareProc ;

PROCEDURE CanonT (t: Ast.Kid ; depth: I64) : STR =
VAR s : STR ;
BEGIN
  IF depth > MaxDepth THEN RETURN '' END ;
  IF t IS SOME n THEN
    CASE n.kind OF
    | Ast.NProcType :
        RETURN ProcSig (n.kids[0], n.kids[1], n.f3, n.kids[2], depth)
    | Ast.NQualident :
        IF LEN (n.b) > 0 THEN
          IF Text.Eq (n.a, 'C') THEN RETURN Qualify ('C', n.b) END ;
          RETURN CanonQual (n.a, n.b, depth)
        END ;
        IF IsBuiltinTy (n.a) THEN RETURN n.a END ;
        IF Text.Eq (n.a, 'STR') THEN RETURN 'SLICE OF CHAR' END ;
        (* POOL is a type like any other to the comparison of an
           argument with its parameter.  Until 2026-10-01 it had no
           canonical form, so both sides of every pool argument were
           unknown and `Compat' never looked: 128 of the 175
           passed-over argument lines `m9c --review' listed for the
           library named a pool, and `TakesInt (pool)' -- a pool
           where an I64 is wanted -- was accepted by this checker and
           by the generator.  HEAP already answered 'POOL' in
           DesigStrType, alone. *)
        IF Text.Eq (n.a, 'POOL') THEN RETURN 'POOL' END ;
        RETURN CanonQual ('', n.a, depth)
    | Ast.NPtrType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF LEN (s) > 0 THEN RETURN Cat ('PTR ', s) END
    | Ast.NOptType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF LEN (s) > 0 THEN RETURN Cat ('OPT ', s) END
    | Ast.NSharedType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF LEN (s) > 0 THEN RETURN Cat ('SHARED PTR ', s) END
    | Ast.NSliceType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF LEN (s) > 0 THEN RETURN Cat ('SLICE OF ', s) END
    | Ast.NArrayType :
        s := CanonT (n.kids[1], depth + 1) ;
        IF LEN (s) > 0 THEN
          RETURN Cat (Cat (Cat ('ARRAY ', Print.ExprText (n.kids[0])),
                           ' OF '), s)
        END
    | Ast.NGridType :
        s := CanonT (n.kids[1], depth + 1) ;
        IF LEN (s) > 0 THEN
          RETURN Cat (Cat (Cat ('GRID ', Print.ExprText (n.kids[0])),
                           ' OF '), s)
        END
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END CanonT ;


(* ---- scope: names, their declared types, and their binding modes ----
   Modes are one CHAR: value param, VAR, OWN, RO, local, module var,
   and a binder from IS SOME or a handler.  Lookup answers the FIRST
   hit, so params and locals shadow module state -- a pass-2 blind
   spot the stateless corpus never exercised.                        *)

PROCEDURE ScopeClear () =
BEGIN
  nscope := 0
END ScopeClear ;

PROCEDURE ScopeAdd (RO KEPT nm: STR ; KEPT t: Ast.Kid ; RO KEPT mode: STR) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nscope = LEN (scope) THEN
    nb := NEW (pool, Binding, 2 * LEN (scope)) ;
    FOR i := 0 TO nscope - 1 DO nb[i] := scope[i] END ;
    scope := nb
  END ;
  scope[nscope].name := nm ;
  scope[nscope].ty := t ;
  scope[nscope].mode := mode ;
  scope[nscope].ro := FALSE ;
  nscope := nscope + 1
END ScopeAdd ;

(* was the name, as it is seen here, declared `VAR RO'? *)
PROCEDURE ScopeRo (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN FALSE END ;
  RETURN scope[i].ro
END ScopeRo ;

PROCEDURE ScopeFind (RO nm: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nscope - 1 DO
    IF Text.Eq (scope[i].name, nm) THEN RETURN i END
  END ;
  RETURN -1
END ScopeFind ;

PROCEDURE ScopeMode (RO nm: STR) : STR =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN '' END ;
  RETURN scope[i].mode
END ScopeMode ;

PROCEDURE ScopeType (RO nm: STR) : Ast.Kid =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN NONE END ;
  RETURN scope[i].ty
END ScopeType ;

PROCEDURE AddParamsOf (d: PTR Ast.Node) =
VAR
  a, b : I64 ;
  mode : STR ;
BEGIN
  IF d.kids[0] IS SOME pl THEN
    FOR a := 0 TO pl.nkids - 1 DO
      IF pl.kids[a] IS SOME grp THEN
        IF grp.f1 THEN mode := ModeVar
        ELSIF grp.f2 THEN mode := ModeOwn
        ELSIF grp.f3 THEN mode := ModeRo
        ELSE mode := ModeVal END ;
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF ids.kids[b] IS SOME id THEN
              ScopeAdd (id.a, grp.kids[1], mode) ;
              IF grp.f4 THEN KeptPush (id.a, id.line, id.col) END
            END
          END
        END
      END
    END
  END
END AddParamsOf ;

PROCEDURE AddVarsOf (holder: PTR Ast.Node ; RO KEPT mode: STR) =
VAR a, b, c : I64 ;
BEGIN
  FOR a := 0 TO holder.nkids - 1 DO
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NVarSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME vd THEN
            IF vd.kids[0] IS SOME ids THEN
              FOR c := 0 TO ids.nkids - 1 DO
                IF ids.kids[c] IS SOME id THEN
                  ScopeAdd (id.a, vd.kids[1], mode) ;
                  scope[nscope - 1].ro := vd.f3
                END
              END
            END
          END
        END
      END
    END
  END
END AddVarsOf ;

(* PROCEDURE-LOCAL CONSTs.  The grammar has always allowed them --
   ProcBody is `{ Declaration } Block` and CONST is a Declaration --
   but neither end implemented them: the generator said `unknown
   name` and the checker said NOTHING, because an unregistered name
   types as unknown and par 3's softness contract never diagnoses
   one.  Silence was the worse half: `i := Tag` for an I64 i and a
   string Tag rode straight through, while the same two lines at
   module level are refused.

   Answers the count, and refuses a shadow rather than resolving it:
   a local CONST that hides a module CONST would depend on lookup
   ORDER, and the map is searched forwards, so the module one would
   win silently.  What cannot be checked simply is forbidden. *)
PROCEDURE AddConstsOf (holder: PTR Ast.Node ; RO ctx: STR) =
VAR
  a, b : I64 ;
  seen : BOOL ;
  ty   : STR ;
BEGIN
  FOR a := 0 TO holder.nkids - 1 DO
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NConstSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME cd THEN
            ty := ConstType (cd.a, seen) ;
            IF seen THEN
              ErrN (cd, ctx,
                Cat ('a local CONST may not shadow a module CONST: ',
                     cd.a))
            END ;
            CheckAggregate (cd, ctx, 2) ;
            ConstAdd (cd.a, LitType (cd.kids[0]))
          END
        END
      END
    END
  END
END AddConstsOf ;

(* ---- field lookup ---- *)

(* the fields of a MONITOR hang off kids[0], where a record's hang
   off kids[1] -- same walk, one index apart *)
PROCEDURE MonFieldType (mon: PTR Ast.Node ; RO f: STR) : Ast.Kid =
VAR i, j : I64 ;
BEGIN
  IF mon.kids[0] IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF g.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              IF Text.Eq (id.a, f) THEN RETURN g.kids[1] END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END MonFieldType ;

(* par 6: the name of the first parameter when its type is a MONITOR
   RECORD, else empty.  M9 has no method syntax, so that parameter IS
   the binding. *)
PROCEDURE BoundMonitorOf (d: PTR Ast.Node) : STR =
VAR rt : Ast.Kid ;
BEGIN
  IF d.kids[0] IS SOME pl THEN
    IF pl.nkids > 0 THEN
      IF pl.kids[0] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          IF ids.nkids > 0 THEN
            rt := ResolveType (grp.kids[1]) ;
            WHILE rt IS SOME rr DO
              IF rr.kind = Ast.NPtrType OR rr.kind = Ast.NSharedType THEN
                rt := ResolveType (rr.kids[0])
              ELSE
                IF rr.kind = Ast.NMonitorType THEN
                  IF ids.kids[0] IS SOME id0 THEN RETURN id0.a END
                END ;
                RETURN ''
              END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END BoundMonitorOf ;

PROCEDURE FieldTypeOf (rec: PTR Ast.Node ; RO f: STR) : Ast.Kid =
VAR i, j : I64 ;
BEGIN
  IF rec.kids[1] IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF g.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              IF Text.Eq (id.a, f) THEN RETURN g.kids[1] END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END FieldTypeOf ;

(* RO on a FIELD annotates the view, not the slot: the field holds a
   borrowed slice, so writing THROUGH it is refused while assigning
   the field itself -- which is how the record gets filled at all --
   stays legal.  C says the same with const char *p.                *)
PROCEDURE FieldROOf (rec: PTR Ast.Node ; RO f: STR) : BOOL =
VAR i, j : I64 ;
BEGIN
  IF rec.kids[1] IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF g.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              IF Text.Eq (id.a, f) THEN RETURN g.f3 END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END FieldROOf ;

PROCEDURE IsReadonlyT (declN: Ast.Kid ; res: PTR Ast.Node) : BOOL =
BEGIN
  IF res.kind = Ast.NSliceType THEN
    IF res.kids[1] IS SOME at THEN
      IF Text.Eq (at.a, 'RO') THEN RETURN TRUE END
    END
  END ;
  IF declN IS SOME dn THEN
    IF dn.kind = Ast.NQualident AND dn.nkids > 0 THEN
      IF dn.kids[0] IS SOME at2 THEN
        RETURN Text.Eq (at2.a, 'RO')
      END
    END
  END ;
  RETURN FALSE
END IsReadonlyT ;

(* ---- the write analysis (par 4.1) ----
   Answers whether the write lands BEYOND the frame -- through a
   pointer, or into slice storage -- and diagnoses the writes the
   borrow rules refuse on the way.  Both jobs in one walk, because
   they need the same selector chain.                               *)
PROCEDURE CheckWrite (d: PTR Ast.Node ; RO ctx: STR) : BOOL =
VAR
  j : I64 ;
  declN, res : Ast.Kid ;
  mode : STR ;
  beyond, deref, known : BOOL ;
BEGIN
  beyond := FALSE ;
  IF IsConstHere (d.a) THEN
    ErrN (d, ctx, Cat ('cannot write the CONST ', d.a))
  END ;
  (* par 3.2: a PURE procedure has no observable effect, so the two
     ways a body can be observed from outside its own frame are
     refused -- writing through a caller's binding, and writing the
     module's state.  A local or a value parameter is invisible to
     everyone and stays legal. *)
  IF curPure THEN
    IF Text.Eq (ScopeMode (d.a), ModeVar) OR
       Text.Eq (ScopeMode (d.a), ModeOwn) THEN
      ErrN (d, ctx, Cat (Cat ('cannot write through the VAR parameter ',
        d.a), ' in a PURE procedure (par 3.2)'))
    ELSIF Text.Eq (ScopeMode (d.a), ModeModule) THEN
      ErrN (d, ctx, Cat (Cat ('cannot write the module variable ',
        d.a), ' in a PURE procedure (par 3.2)'))
    END
  END ;
  IF Text.Eq (ScopeMode (d.a), ModeRo) THEN
    ErrN (d, ctx, Cat (Cat ('cannot write through the RO parameter ',
      d.a), ' (par 4.1)'))
  END ;
  (* a variable declared `VAR RO': the name may be given a new view,
     nothing may be written through it -- as an RO field (par 2.4,
     2026-10-03; it was parsed and never read) *)
  IF d.nkids > 0 AND ScopeRo (d.a) THEN
    ErrN (d, ctx, Cat (Cat ('cannot write through the RO variable ',
      d.a), ' (par 2.4)'))
  END ;
  IF d.nkids = 0 THEN RETURN FALSE END ;
  mode := ScopeMode (d.a) ;
  declN := ScopeType (d.a) ;
  FOR j := 0 TO d.nkids - 1 DO
    known := FALSE ;
    IF declN IS SOME dn0 THEN known := TRUE END ;
    IF NOT known THEN RETURN beyond END ;
    res := ResolveType (declN) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          IF NOT beyond THEN
            beyond := TRUE ;
            IF Text.Eq (mode, ModeVal) THEN
              ErrN (d, ctx, Cat (Cat (
                'cannot write through a value parameter: ', d.a),
                ' is a shared borrow (take VAR, par 4.1)'))
            END
          END ;
          declN := r0.kids[0] ;
          res := ResolveType (declN)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            IF j < d.nkids - 1 AND FieldROOf (r, sel.a) THEN
              ErrN (d, ctx, Cat (Cat (
                'cannot write through the RO field ', sel.a),
                ' (par 4.1)'))
            END ;
            declN := FieldTypeOf (r, sel.a)
          ELSE
            RETURN beyond
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            IF IsReadonlyT (declN, r) THEN
              ErrN (d, ctx, Cat (
                'cannot write through a read-only grid: ', d.a))
            END ;
            beyond := TRUE ;
            declN := r.kids[1]
          ELSIF r.kind = Ast.NSliceType THEN
            IF IsReadonlyT (declN, r) THEN
              ErrN (d, ctx, Cat (
                'cannot write through a read-only slice: ', d.a))
            END ;
            beyond := TRUE ;      (* slice storage outlives the frame *)
            declN := r.kids[0]
          ELSIF r.kind = Ast.NArrayType THEN
            declN := r.kids[1]
          ELSE
            RETURN beyond
          END
        END
      END
    ELSE
      RETURN beyond
    END
  END ;
  RETURN beyond
END CheckWrite ;

(* the base name a stored reference is borrowed from, when the source
   is a plain designator, possibly under SOME or parentheses *)
PROCEDURE IsRefTy (RO s0: STR) : BOOL =
VAR s : STR ;
BEGIN
  s := s0 ;
  IF Text.StartsWith (s, 'OPT ') THEN
    s := SLICE (s, 4, LEN (s) - 4)
  END ;
  RETURN Text.StartsWith (s, 'PTR ') OR
         Text.StartsWith (s, 'SHARED PTR ') OR
         Text.StartsWith (s, 'SLICE OF ')
END IsRefTy ;

(* ---- par 4.1, the DIRECTION ----

   The machinery behind the directional ledger.  Aliasing is
   symmetric on purpose: the approximation can keep an entry in the
   ledger that a finer analysis would drop, never drop one it should
   keep.                                                             *)

PROCEDURE EscHas (RO nm: STR ; RO tgt: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nesc - 1 DO
    IF Text.Eq (escName[i], nm) THEN
      IF Text.Eq (escTgt[i], tgt) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END EscHas ;

(* name NM's storage is reachable from outside the frame via TGT *)
PROCEDURE EscTarget (RO KEPT nm: STR ; RO KEPT tgt: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF EscHas (nm, tgt) THEN RETURN END ;
  IF nesc = LEN (escName) THEN
    ns := NEW (pool, STR, 2 * LEN (escName)) ;
    FOR i := 0 TO nesc - 1 DO ns[i] := escName[i] END ;
    escName := ns ;
    ns := NEW (pool, STR, 2 * LEN (escTgt)) ;
    FOR i := 0 TO nesc - 1 DO ns[i] := escTgt[i] END ;
    escTgt := ns
  END ;
  escName[nesc] := nm ;
  escTgt[nesc] := tgt ;
  nesc := nesc + 1
END EscTarget ;

PROCEDURE FvalHas (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END FvalHas ;

(* the LOCAL pool a kind names -- 'an allocation in pool P' or 'a view
   into pool P' (FrameWhat, par 4.3) -- or '' for a frame kind.  Read
   back from the text so that one string carries both the diagnostic
   and the taint, as the frame kinds do. *)
PROCEDURE KindPool (RO what: STR) : STR =
BEGIN
  IF Text.StartsWith (what, 'an allocation in pool ') THEN
    RETURN SLICE (what, 22, LEN (what) - 22)
  END ;
  IF Text.StartsWith (what, 'a view into pool ') THEN
    RETURN SLICE (what, 17, LEN (what) - 17)
  END ;
  RETURN ''
END KindPool ;

(* what the name holds: 'a concatenation', 'a frame allocation', or
   '' when it is not tainted *)
PROCEDURE FvalKindOf (RO nm: STR) : STR =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN RETURN fvalKind[i] END
  END ;
  RETURN ''
END FvalKindOf ;

PROCEDURE FvalAdd (RO KEPT nm: STR ; RO KEPT what: STR) =
VAR
  ns, nk : SLICE OF STR ;
  i : I64 ;
BEGIN
  (* a name already tainted keeps its kind, unless the new one names
     a local pool: frame storage is re-homed or adopted at exit, a
     local pool's is freed, so a slice built in the frame that takes
     one element viewing a local pool is the pool's problem *)
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN
      IF LEN (KindPool (what)) > 0 THEN fvalKind[i] := what END ;
      RETURN
    END
  END ;
  IF nfval = LEN (fvalName) THEN
    ns := NEW (pool, STR, 2 * LEN (fvalName)) ;
    nk := NEW (pool, STR, 2 * LEN (fvalName)) ;
    FOR i := 0 TO nfval - 1 DO
      ns[i] := fvalName[i] ;
      nk[i] := fvalKind[i]
    END ;
    fvalName := ns ;
    fvalKind := nk
  END ;
  fvalName[nfval] := nm ;
  fvalKind[nfval] := what ;
  nfval := nfval + 1
END FvalAdd ;

PROCEDURE PvalHas (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npval - 1 DO
    IF Text.Eq (pvalName[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END PvalHas ;

PROCEDURE PvalDel (RO nm: STR) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npval - 1 DO
    IF Text.Eq (pvalName[i], nm) THEN
      pvalName[i] := pvalName[npval - 1] ;
      npval := npval - 1 ;
      RETURN
    END
  END
END PvalDel ;

PROCEDURE PvalAdd (RO KEPT nm: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF PvalHas (nm) THEN RETURN END ;
  IF npval = LEN (pvalName) THEN
    ns := NEW (pool, STR, 2 * LEN (pvalName)) ;
    FOR i := 0 TO npval - 1 DO ns[i] := pvalName[i] END ;
    pvalName := ns
  END ;
  pvalName[npval] := nm ;
  npval := npval + 1
END PvalAdd ;

PROCEDURE FvalDel (RO nm: STR) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN
      fvalName[i] := fvalName[nfval - 1] ;
      fvalKind[i] := fvalKind[nfval - 1] ;
      nfval := nfval - 1 ;
      RETURN
    END
  END
END FvalDel ;

(* Is this NEW the FRAME form -- `NEW (T)` or `NEW (T, n...)`, no
   pool named (docs/pool-elision-plan.md, rule 1)?  Decided by NAME,
   as report par 10 item 6 says: a first argument that is a variable
   in scope, HEAP, or OWN is not the frame form.  Quiet -- NewForm
   below is the one that diagnoses. *)
PROCEDURE NewIsFrame (e: PTR Ast.Node) : BOOL =
BEGIN
  IF e.kids[0] IS SOME d THEN
    IF d.nkids > 0 THEN RETURN FALSE END ;
    IF Text.Eq (d.a, 'OWN') OR Text.Eq (d.a, 'HEAP') THEN RETURN FALSE END ;
    RETURN ScopeFind (d.a) < 0
  END ;
  RETURN TRUE
END NewIsFrame ;

PROCEDURE EscAlias (RO KEPT a: STR ; RO KEPT b: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF Text.Eq (a, b) THEN RETURN END ;
  FOR i := 0 TO nedge - 1 DO
    IF Text.Eq (edgeA[i], a) THEN
      IF Text.Eq (edgeB[i], b) THEN RETURN END
    END
  END ;
  IF nedge = LEN (edgeA) THEN
    ns := NEW (pool, STR, 2 * LEN (edgeA)) ;
    FOR i := 0 TO nedge - 1 DO ns[i] := edgeA[i] END ;
    edgeA := ns ;
    ns := NEW (pool, STR, 2 * LEN (edgeB)) ;
    FOR i := 0 TO nedge - 1 DO ns[i] := edgeB[i] END ;
    edgeB := ns
  END ;
  edgeA[nedge] := a ;
  edgeB[nedge] := b ;
  nedge := nedge + 1
END EscAlias ;

(* the frame-storage root a reference expression views: through SOME
   and parens, and through SLICE/VIEW/SHARED, whose
   answers alias their first argument's storage *)
PROCEDURE EscRootOf (k: Ast.Kid) : STR =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN RETURN e.a END ;
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen THEN
      RETURN EscRootOf (e.kids[0])
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME cal THEN
        IF cal.kind = Ast.NDesignator AND cal.nkids = 0 THEN
          IF Text.Eq (cal.a, 'SLICE') OR Text.Eq (cal.a, 'VIEW') OR
             Text.Eq (cal.a, 'SHARED') THEN
            IF e.kids[1] IS SOME al THEN
              IF al.nkids > 0 THEN RETURN EscRootOf (al.kids[0]) END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END EscRootOf ;

PROCEDURE IsFrameMode (RO m: STR) : BOOL =
BEGIN
  RETURN Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeBinder) OR
         Text.Eq (m, ModeVal)
END IsFrameMode ;

(* the expression under parens and SOME *)
PROCEDURE FrameCore (k: Ast.Kid) : Ast.Kid =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN
      RETURN FrameCore (e.kids[0])
    END
  END ;
  RETURN k
END FrameCore ;

(* does this right-hand side yield a FRAME-SCOPED string (par 2.3)?
   A concatenation is one -- it is built in the frame arena -- and so
   is a bare name that already holds one (fval).  `u` is the RHS's
   type, so a numeric `+` (not SLICE OF CHAR) is not mistaken for a
   concatenation. *)
(* Does this call answer FRAME storage -- the callee's name, or ''?
   A callee that takes no pool and answers a pointer-bearing value
   that is not RO builds its answer in ITS CALLER's arena (rule 1 of
   docs/pool-elision-plan.md, and par 2.3 for a string re-homed at
   exit), so the answer lives in this frame and dies with it.  Not
   frame storage: a foreign procedure's pointer (the library's) and an
   RO answer (a view of something that exists already); a callee that
   took a pool answers in it unless its RETURN says otherwise, which
   AnswersFrame reads from its body. *)
PROCEDURE LookupProc (RO callee: STR ; VAR found: BOOL) : ProcInfo ;
PROCEDURE DesigName (d: PTR Ast.Node) : STR ;

(* ---- does a procedure ANSWER frame storage?  A summary of its body,
   memoised per Module.Proc, because the signature cannot say: a
   pool-less function answering a pointer may answer a VIEW of its
   argument (Text.Trim), storage from a module pool (Gen's S2), or --
   since the frame form of NEW -- storage built in its caller's arena
   (rule 1).  The corpus's 75 pool-less pointer answers were all of
   the first two kinds when this was measured, so the default is NO
   and the evidence for YES is in the body: a frame NEW, a `+` in a
   function that answers a string, a local POOL in one (its answer is
   re-homed out of it), or a call to a procedure that answers frame
   storage.  Over-approximate on purpose: a frame temporary in a
   function that answers a view makes the answer count as frame
   storage, and the cost is a Text.Keep at a durable store. *)
PROCEDURE AnsFind (RO q: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nans - 1 DO
    IF Text.Eq (ansName[i], q) THEN RETURN i END
  END ;
  RETURN -1
END AnsFind ;

PROCEDURE AnsSet (RO KEPT q: STR ; RO KEPT state: STR) =
VAR
  i : I64 ;
  nn, ns : SLICE OF STR ;
BEGIN
  i := AnsFind (q) ;
  IF i >= 0 THEN ansState[i] := state ; RETURN END ;
  IF nans = LEN (ansName) THEN
    nn := NEW (pool, STR, 2 * LEN (ansName)) ;
    ns := NEW (pool, STR, 2 * LEN (ansName)) ;
    FOR i := 0 TO nans - 1 DO
      nn[i] := ansName[i] ;
      ns[i] := ansState[i]
    END ;
    ansName := nn ;
    ansState := ns
  END ;
  ansName[nans] := q ;
  ansState[nans] := state ;
  nans := nans + 1
END AnsSet ;

PROCEDURE AnswersFrame (RO KEPT qual: STR ; pr: ProcInfo) : BOOL ;

(* a callee named inside module MOD, as ProcInfo; found says so *)
PROCEDURE ProcNamed (RO mod: STR ; RO callee: STR ; VAR found: BOOL) : ProcInfo =
VAR
  dot, m, pi : I64 ;
  empty : ProcInfo ;
BEGIN
  found := FALSE ;
  dot := Text.FindChar (callee, '.') ;
  IF dot >= 0 THEN
    m := FindMod (SLICE (callee, 0, dot)) ;
    IF m < 0 THEN RETURN empty END ;
    pi := FindProcIn (m, SLICE (callee, dot + 1, LEN (callee) - dot - 1))
  ELSE
    m := FindMod (mod) ;
    IF m < 0 THEN RETURN empty END ;
    pi := FindProcIn (m, callee)
  END ;
  IF pi < 0 THEN RETURN empty END ;
  found := TRUE ;
  RETURN mods[m].procs[pi]
END ProcNamed ;

(* is there frame storage under node K of a procedure of module MOD
   whose answer is a string when isStr? *)
(* Is the NEW's storage the frame's?  A type's name in the first
   position is the frame form, a variable's a pool; decided without
   the procedure's scope, so a local that shadows a type name of its
   module reads as the type.  Quiet, like NewIsFrame. *)
PROCEDURE NewIsFrameIn (e: PTR Ast.Node ; RO mod: STR) : BOOL =
VAR m : I64 ;
BEGIN
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 THEN
      IF Text.Eq (d.a, 'OWN') OR Text.Eq (d.a, 'HEAP') THEN RETURN FALSE END ;
      IF IsBuiltinTy (d.a) OR Text.Eq (d.a, 'STR') THEN RETURN TRUE END ;
      m := FindMod (mod) ;
      IF m >= 0 THEN
        IF FindTypeIn (m, d.a) IS SOME t THEN RETURN TRUE END
      END ;
      RETURN FALSE
    END ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          m := FindMod (d.a) ;
          IF m >= 0 THEN
            IF FindTypeIn (m, sel.a) IS SOME t2 THEN RETURN TRUE END
          END
        END
      END
    END ;
    RETURN FALSE
  END ;
  RETURN TRUE
END NewIsFrameIn ;

PROCEDURE ExprEvidence (k: Ast.Kid ; RO mod: STR ; isStr: BOOL ;
                        body: Ast.Kid ; depth: I64) : BOOL ;

(* does any `NAME := rhs` under K have frame evidence on its right? *)
PROCEDURE AssignEvidence (k: Ast.Kid ; RO name: STR ; RO mod: STR ;
                          isStr: BOOL ; body: Ast.Kid ; depth: I64) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids = 0 THEN
          IF Text.Eq (lhs.a, name) THEN
            IF ExprEvidence (e.kids[1], mod, isStr, body, depth) THEN
              RETURN TRUE
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF AssignEvidence (e.kids[i], name, mod, isStr, body, depth) THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
END AssignEvidence ;

(* is the value of expression K frame storage?  A frame NEW; a `+`
   in answer position of a string function (a numeric `+` cannot be
   the answer of one); a call to a procedure that answers frame
   storage; a bare local that was assigned any of these (followed
   through assignments, four deep).  A view, a literal and a call
   answering a view or module-pool storage are not. *)
PROCEDURE ExprEvidence (k: Ast.Kid ; RO mod: STR ; isStr: BOOL ;
                        body: Ast.Kid ; depth: I64) : BOOL =
VAR
  found : BOOL ;
  pr : ProcInfo ;
  nm : STR ;
BEGIN
  IF depth > 4 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN
      RETURN ExprEvidence (e.kids[0], mod, isStr, body, depth)
    END ;
    IF e.kind = Ast.NNewExpr THEN RETURN NewIsFrameIn (e, mod) END ;
    IF e.kind = Ast.NBin THEN
      RETURN isStr AND Text.Eq (e.a, '+')
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          nm := DesigName (dn) ;
          pr := ProcNamed (mod, nm, found) ;
          IF found THEN
            IF LEN (pr.foreign) = 0 THEN
              RETURN AnswersFrame (Qualify (pr.modName, pr.name), pr)
            END
          END
        END
      END ;
      RETURN FALSE
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      RETURN AssignEvidence (body, e.a, mod, isStr, body, depth + 1)
    END
  END ;
  RETURN FALSE
END ExprEvidence ;

(* the evidence for a procedure of module MOD whose body is K: a
   RETURN whose expression is frame storage, or -- when it answers a
   string -- a local POOL, whose strings are re-homed out of it at
   exit (par 2.3) and so live in the caller's frame *)
PROCEDURE FrameEvidence (k: Ast.Kid ; RO mod: STR ; isStr: BOOL ;
                         body: Ast.Kid ; scratchCounts: BOOL) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn THEN
      IF ExprEvidence (e.kids[0], mod, isStr, body, 0) THEN RETURN TRUE END
    ELSIF e.kind = Ast.NVarDecl THEN
      IF isStr AND scratchCounts THEN
        IF e.kids[1] IS SOME vt THEN
          IF vt.kind = Ast.NQualident THEN
            IF Text.Eq (vt.a, 'POOL') AND LEN (vt.b) = 0 THEN RETURN TRUE END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF FrameEvidence (e.kids[i], mod, isStr, body, scratchCounts) THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
END FrameEvidence ;

PROCEDURE AnswersFrame (RO KEPT qual: STR ; pr: ProcInfo) : BOOL =
VAR
  i, g : I64 ;
  res, isStr, hasPool : BOOL ;
BEGIN
  i := AnsFind (qual) ;
  IF i >= 0 THEN RETURN Text.Eq (ansState[i], 'yes') END ;
  (* in progress counts as no: a cycle adds no evidence of its own *)
  AnsSet (qual, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    (* a procedure that takes a pool answers in it, by the rule of
       docs/pools.md; its scratch pools and temporaries say nothing
       about where the answer lives *)
    hasPool := FALSE ;
    IF d.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[1] IS SOME pt THEN
            IF pt.kind = Ast.NQualident THEN
              IF Text.Eq (pt.a, 'POOL') AND LEN (pt.b) = 0 THEN
                hasPool := TRUE
              END
            END
          END
        END
      END
    END ;
    (* ... but only for what it returns: a RETURN of a frame NEW, of
       a `+`, or of a frame-answering call is evidence whether or not
       a pool was taken (a reader that hands on a frame-built answer
       is a frame-answering reader), while a local POOL is evidence
       only in a pool-less string function *)
    isStr := FALSE ;
    IF d.kids[1] IS SOME rt THEN
      isStr := Text.Eq (CanonT (d.kids[1], 0), 'SLICE OF CHAR')
    END ;
    res := FrameEvidence (d.kids[4], pr.modName, isStr, d.kids[4],
                          NOT hasPool)
  END ;
  IF res THEN AnsSet (qual, 'yes') ELSE AnsSet (qual, 'no') END ;
  RETURN res
END AnswersFrame ;

PROCEDURE CallAnswersFrame (dn: PTR Ast.Node) : STR =
VAR
  name : STR ;
  pr : ProcInfo ;
  found, ref : BOOL ;
BEGIN
  IF dn.kind # Ast.NDesignator THEN RETURN '' END ;
  name := DesigName (dn) ;
  pr := LookupProc (name, found) ;
  IF NOT found THEN RETURN '' END ;
  IF LEN (pr.foreign) > 0 THEN RETURN '' END ;
  IF NOT AnswersFrame (Qualify (pr.modName, pr.name), pr) THEN RETURN '' END ;
  IF pr.node IS SOME pn THEN
    IF pn.f3 THEN RETURN '' END ;
    ref := FALSE ;
    IF ResolveType (pn.kids[1]) IS SOME r THEN
      IF r.kind = Ast.NPtrType OR r.kind = Ast.NSliceType OR
         r.kind = Ast.NGridType THEN
        ref := TRUE
      ELSIF r.kind = Ast.NOptType THEN
        IF ResolveType (r.kids[0]) IS SOME r2 THEN
          IF r2.kind = Ast.NPtrType THEN ref := TRUE END
        END
      END
    END ;
    IF ref THEN RETURN name END
  END ;
  RETURN ''
END CallAnswersFrame ;

PROCEDURE DeclPool (t: Ast.Kid) : Ast.Kid ;
PROCEDURE AllocPoolOf (k: Ast.Kid ; RO ctx: STR) : STR ;
PROCEDURE FrameWhat (k: Ast.Kid ; RO u: STR) : STR ;
PROCEDURE DesigPath (d: PTR Ast.Node) : STR ;

(* the LOCAL pool an expression's storage lives in, by its shape: the
   pool a NEW names or a call's `IN r` promise names (AllocPoolOf), or
   the IN clause of a bare name -- when that pool is a local of this
   procedure, so dies with its frame; '' for any other pool and any
   other shape *)
PROCEDURE LocalPoolOf (e: PTR Ast.Node) : STR =
VAR p : STR ;
BEGIN
  p := '' ;
  IF e.kind = Ast.NNewExpr OR e.kind = Ast.NCallExpr THEN
    p := AllocPoolOf (SOME (e), '')
  ELSIF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
    IF DeclPool (ScopeType (e.a)) IS SOME dp THEN p := dp.a END
  END ;
  IF LEN (p) > 0 THEN
    IF Text.Eq (ScopeMode (p), ModeLocal) THEN RETURN p END
  END ;
  RETURN ''
END LocalPoolOf ;

(* the local pool a VIEW looks into: a callee that answers RO answers
   a view of its arguments (DynStr.View, par 4.1), so an argument
   whose storage is in a local pool -- by shape, or a name holding
   such a value -- makes the answer live there too; '' otherwise *)
PROCEDURE ViewedPool (dn: PTR Ast.Node ; args: Ast.Kid) : STR =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  i : I64 ;
  p : STR ;
BEGIN
  IF dn.kind # Ast.NDesignator THEN RETURN '' END ;
  pr := LookupProc (DesigName (dn), found) ;
  IF NOT found THEN RETURN '' END ;
  IF pr.node IS SOME pn THEN
    IF NOT pn.f3 THEN RETURN '' END ;
    IF args IS SOME al THEN
      FOR i := 0 TO al.nkids - 1 DO
        p := KindPool (FrameWhat (al.kids[i], '')) ;
        IF LEN (p) > 0 THEN RETURN p END
      END
    END
  END ;
  RETURN ''
END ViewedPool ;

PROCEDURE FrameWhat (k: Ast.Kid ; RO u: STR) : STR =
  (* what the frame-scoped value IS, for the diagnostic and the taint:
     'a concatenation', 'a frame allocation' (a NEW with no pool,
     docs/pool-elision-plan.md rule 1), 'the answer of F' (a call that
     built its answer here), 'an allocation in pool P' or 'a view into
     pool P' for a LOCAL pool P (par 4.3: it dies with the frame as
     the others do, but is neither re-homed nor adopted at exit -- the
     zarr proxy's FillId stored DynStr.View of a scratch-pool string
     into its VAR record, --check accepted it, and the ids read back
     as freed memory, 2026-10-01), or '' when the right-hand side is
     none of these and holds none *)
VAR nm, p : STR ;
BEGIN
  IF FrameCore (k) IS SOME e THEN
    IF e.kind = Ast.NBin AND Text.Eq (e.a, '+') AND
       Text.Eq (u, 'SLICE OF CHAR') THEN RETURN 'a concatenation' END ;
    IF e.kind = Ast.NNewExpr THEN
      IF NewIsFrame (e) THEN RETURN 'a frame allocation' END
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        nm := CallAnswersFrame (dn) ;
        IF LEN (nm) > 0 THEN RETURN Cat ('the answer of ', nm) END ;
        p := ViewedPool (dn, e.kids[1]) ;
        IF LEN (p) > 0 THEN RETURN Cat ('a view into pool ', p) END
      END
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      nm := FvalKindOf (e.a) ;
      IF LEN (nm) > 0 THEN RETURN nm END
    END ;
    (* a COMPONENT that was itself given frame storage carries it:
       `c.pix := NEW (scratch, BYTE, n)' taints the path `c.pix' (and
       c, for a copy of the whole), and `RETURN c.pix' passed until
       2026-10-03 while `RETURN c' was refused -- Png.Raster died on
       it.  The PATH, not the local: an element of `mine := NEW
       (scratch, STR, n)' is a string header whose bytes live where
       they were made, and storing `mine[i]' is sound (the zarr
       proxy does, 2 sites; a rule by the local refused them). *)
    IF e.kind = Ast.NDesignator AND e.nkids > 0 THEN
      nm := FvalKindOf (DesigPath (e)) ;
      IF LEN (nm) > 0 THEN RETURN nm END
    END ;
    p := LocalPoolOf (e) ;
    IF LEN (p) > 0 THEN RETURN Cat ('an allocation in pool ', p) END
  END ;
  RETURN ''
END FrameWhat ;

(* the designator's component path for the taint table: the root,
   `.field' for each field selector, `[]' for each index -- `c.pix',
   `b.rows[]'.  A bare local never contains a dot or a bracket, so
   the paths share the locals' table without meeting them. *)
PROCEDURE DesigPath (d: PTR Ast.Node) : STR =
VAR
  res : STR ;
  i : I64 ;
BEGIN
  res := d.a ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN res := res + '.' + sel.a
      ELSE res := res + '[]' END
    END
  END ;
  RETURN res
END DesigPath ;

(* a ref value rooted at frame storage SRC was stored into the
   designator rooted DST (dstSel: through a selector) *)
PROCEDURE EscStore (RO KEPT dst: STR ; dstSel: BOOL ; RO KEPT src: STR) =
VAR m : STR ;
BEGIN
  m := ScopeMode (dst) ;
  IF Text.Eq (m, ModeModule) THEN EscTarget (src, '<module>')
  ELSIF Text.Eq (m, ModeVar) OR Text.Eq (m, ModeOwn) OR
        Text.Eq (m, ModeRo) THEN EscTarget (src, dst)
  ELSIF Text.Eq (m, ModeVal) AND dstSel THEN EscTarget (src, dst)
  ELSIF IsFrameMode (m) THEN EscAlias (dst, src)
  END
END EscStore ;

PROCEDURE PendPush (line, col: I64 ; RO KEPT src: STR ; RO KEPT dst: STR) =
VAR
  ns : SLICE OF STR ;
  nl : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF npend = LEN (pendSrc) THEN
    ns := NEW (pool, STR, 2 * LEN (pendSrc)) ;
    FOR i := 0 TO npend - 1 DO ns[i] := pendSrc[i] END ;
    pendSrc := ns ;
    ns := NEW (pool, STR, 2 * LEN (pendDst)) ;
    FOR i := 0 TO npend - 1 DO ns[i] := pendDst[i] END ;
    pendDst := ns ;
    nl := NEW (pool, I64, 2 * LEN (pendLine)) ;
    FOR i := 0 TO npend - 1 DO nl[i] := pendLine[i] END ;
    pendLine := nl ;
    nl := NEW (pool, I64, 2 * LEN (pendCol)) ;
    FOR i := 0 TO npend - 1 DO nl[i] := pendCol[i] END ;
    pendCol := nl
  END ;
  pendSrc[npend] := src ;
  pendDst[npend] := dst ;
  pendLine[npend] := line ;
  pendCol[npend] := col ;
  npend := npend + 1
END PendPush ;

PROCEDURE CarryHas (RO nm: STR ; RO borrow: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ncarry - 1 DO
    IF Text.Eq (carryN[i], nm) THEN
      IF Text.Eq (carryB[i], borrow) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END CarryHas ;

PROCEDURE CarryAdd (RO KEPT nm: STR ; RO KEPT borrow: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  FOR i := 0 TO ncarry - 1 DO
    IF Text.Eq (carryN[i], nm) THEN
      IF Text.Eq (carryB[i], borrow) THEN RETURN END
    END
  END ;
  IF ncarry = LEN (carryN) THEN
    ns := NEW (pool, STR, 2 * LEN (carryN)) ;
    FOR i := 0 TO ncarry - 1 DO ns[i] := carryN[i] END ;
    carryN := ns ;
    ns := NEW (pool, STR, 2 * LEN (carryB)) ;
    FOR i := 0 TO ncarry - 1 DO ns[i] := carryB[i] END ;
    carryB := ns
  END ;
  carryN[ncarry] := nm ;
  carryB[ncarry] := borrow ;
  ncarry := ncarry + 1
END CarryAdd ;

PROCEDURE CarryEdgeAdd (RO KEPT dst: STR ; RO KEPT src: STR) =
VAR
  ns : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF Text.Eq (dst, src) THEN RETURN END ;
  FOR i := 0 TO ncedge - 1 DO
    IF Text.Eq (carryEA[i], dst) THEN
      IF Text.Eq (carryEB[i], src) THEN RETURN END
    END
  END ;
  IF ncedge = LEN (carryEA) THEN
    ns := NEW (pool, STR, 2 * LEN (carryEA)) ;
    FOR i := 0 TO ncedge - 1 DO ns[i] := carryEA[i] END ;
    carryEA := ns ;
    ns := NEW (pool, STR, 2 * LEN (carryEB)) ;
    FOR i := 0 TO ncedge - 1 DO ns[i] := carryEB[i] END ;
    carryEB := ns
  END ;
  carryEA[ncedge] := dst ;
  carryEB[ncedge] := src ;
  ncedge := ncedge + 1
END CarryEdgeAdd ;

(* a reference value rooted at SRC now also lives under the bare
   local or binder DST: a borrow is carried, a carrier's cargo is
   inherited *)
PROCEDURE CarryFrom (RO KEPT dst: STR ; RO KEPT src: STR) =
VAR m : STR ;
BEGIN
  m := ScopeMode (src) ;
  IF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeVar) OR
     Text.Eq (m, ModeRo) THEN
    CarryAdd (dst, src)
  ELSIF Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeBinder) THEN
    CarryEdgeAdd (dst, src)
  END
END CarryFrom ;

PROCEDURE AppendTgt (VAR d: PTR DynStr.DString ; RO t: STR) =
BEGIN
  IF Text.Eq (t, '<module>') THEN
    DynStr.Append (d, 'module state')
  ELSIF Text.Eq (t, '<return>') THEN
    DynStr.Append (d, 'the RETURN value')
  ELSIF Text.Eq (t, '<call>') THEN
    DynStr.Append (d, 'a callee')
  ELSIF Text.Eq (t, '<unknown>') THEN
    DynStr.Append (d, 'an unknown name')
  ELSE
    DynStr.Append (d, 'the caller through ') ;
    DynStr.Append (d, t)
  END
END AppendTgt ;

PROCEDURE KeptPush (RO KEPT nm: STR ; line, col: I64) =
VAR
  ns : SLICE OF STR ;
  nl : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF nkept = LEN (keptP) THEN
    ns := NEW (pool, STR, 2 * LEN (keptP)) ;
    FOR i := 0 TO nkept - 1 DO ns[i] := keptP[i] END ;
    keptP := ns ;
    nl := NEW (pool, I64, 2 * LEN (keptLn)) ;
    FOR i := 0 TO nkept - 1 DO nl[i] := keptLn[i] END ;
    keptLn := nl ;
    nl := NEW (pool, I64, 2 * LEN (keptCl)) ;
    FOR i := 0 TO nkept - 1 DO nl[i] := keptCl[i] END ;
    keptCl := nl
  END ;
  keptP[nkept] := nm ;
  keptLn[nkept] := line ;
  keptCl[nkept] := col ;
  nkept := nkept + 1
END KeptPush ;

(* a KEPT parameter earned its mark: seen retained, or handed on to
   another KEPT parameter *)
PROCEDURE KeptUse (RO KEPT nm: STR) =
BEGIN
  PushErr (keptU, nkeptU, nm)
END KeptUse ;

PROCEDURE KeptUsedHas (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nkeptU - 1 DO
    IF Text.Eq (keptU[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END KeptUsedHas ;

PROCEDURE KeptHas (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nkept - 1 DO
    IF Text.Eq (keptP[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END KeptHas ;

(* close the escape targets over the alias edges, then classify
   every pended store by where its destination reaches: 'retention:'
   outlives the frame and names what it reaches, 'self-store:'
   reaches the caller only through the borrow itself, 'frame-store:'
   dies with the frame.  The inner bound is captured per edge, as
   the oracle's for-loop fixes it, so pairs added during a round are
   seen in the next one; the loop terminates because the pair set
   only grows and is bounded by names times targets.                *)
(* classify ONE resolved store -- SRC is the borrow, CARRIER the
   local or binder it travelled through ('' when direct) -- and
   write the ledger line, the undeclared-retention error, and the
   KEPT justification *)
PROCEDURE EmitPend (line, col: I64 ; RO KEPT src: STR ;
                    RO carrier: STR ; RO KEPT dst: STR ; RO ctx: STR) =
VAR
  selfHit, first : BOOL ;
  j, n2, ntl : I64 ;
  dmode : STR ;
  tl : SLICE OF STR ;
  d, de, dm, ds : PTR DynStr.DString IN pool ;
BEGIN
  ds := DynStr.New (pool) ;
  DynStr.Append (ds, src) ;
  IF LEN (carrier) > 0 THEN
    DynStr.Append (ds, ' (carried by ') ;
    DynStr.Append (ds, carrier) ;
    DynStr.Append (ds, ')')
  END ;
  tl := NEW (pool, STR, 8) ;
  ntl := 0 ;
  dmode := ScopeMode (dst) ;
  IF Text.Eq (dmode, ModeModule) THEN
    PushErr (tl, ntl, '<module>')
  ELSIF Text.Eq (dmode, ModeVar) OR Text.Eq (dmode, ModeOwn) OR
        Text.Eq (dmode, ModeRo) OR Text.Eq (dmode, ModeVal) THEN
    PushErr (tl, ntl, dst)
  ELSIF Text.Eq (dmode, ModeLocal) OR Text.Eq (dmode, ModeBinder) THEN
    FOR j := 0 TO nesc - 1 DO
      IF Text.Eq (escName[j], dst) THEN
        PushErr (tl, ntl, escTgt[j])
      END
    END
  ELSE
    PushErr (tl, ntl, '<unknown>')
  END ;
  (* the source among the targets is the destination escaping only
     into the borrow itself -- a tree growing through its own node
     is not a kept borrow *)
  selfHit := FALSE ;
  n2 := 0 ;
  FOR j := 0 TO ntl - 1 DO
    IF NOT selfHit AND Text.Eq (tl[j], src) THEN
      selfHit := TRUE
    ELSE
      tl[n2] := tl[j] ;
      n2 := n2 + 1
    END
  END ;
  ntl := n2 ;
  d := DynStr.New (pool) ;
  IF ntl = 0 THEN
    IF selfHit THEN
      DynStr.Append (d, 'self-store: borrowed ') ;
      DynStr.Append (d, DynStr.View (ds)) ;
      DynStr.Append (d, ' stored into ') ;
      DynStr.Append (d, dst) ;
      DynStr.Append (d, ', which reaches the caller only through ') ;
      DynStr.Append (d, src) ;
      DynStr.Append (d, ' itself (par 4.1)')
    ELSE
      DynStr.Append (d, 'frame-store: borrowed ') ;
      DynStr.Append (d, DynStr.View (ds)) ;
      DynStr.Append (d, ' stored into ') ;
      DynStr.Append (d, dst) ;
      DynStr.Append (d, ', which never escapes the frame (par 4.1)')
    END
  ELSE
    DynStr.Append (d, 'retention: borrowed ') ;
    DynStr.Append (d, DynStr.View (ds)) ;
    DynStr.Append (d, ' stored into ') ;
    DynStr.Append (d, dst) ;
    DynStr.Append (d, ' -- reaches ') ;
    FOR j := 0 TO ntl - 1 DO
      IF j > 0 THEN DynStr.Append (d, ', ') END ;
      AppendTgt (d, tl[j])
    END ;
    DynStr.Append (d, ' (par 4.1/4.2)') ;
    KeptUse (src) ;
    (* the CHECK behind the measurement: a retention must be in the
       signature, the way a raise must be in RAISES.  '<call>'
       alone does not fire it -- whether a callee keeps its
       argument is that callee's declaration to make, and the
       caller check reads it there (par 4.1). *)
    de := DynStr.New (pool) ;
    first := TRUE ;
    FOR j := 0 TO ntl - 1 DO
      IF NOT Text.Eq (tl[j], '<call>') THEN
        IF NOT first THEN DynStr.Append (de, ', ') END ;
        AppendTgt (de, tl[j]) ;
        first := FALSE
      END
    END ;
    IF NOT first AND NOT KeptHas (src) THEN
      dm := DynStr.New (pool) ;
      DynStr.Append (dm, 'undeclared retention: borrowed ') ;
      DynStr.Append (dm, DynStr.View (ds)) ;
      DynStr.Append (dm, ' reaches ') ;
      DynStr.Append (dm, DynStr.View (de)) ;
      DynStr.Append (dm, ' -- declare KEPT ') ;
      DynStr.Append (dm, src) ;
      DynStr.Append (dm, ' (par 4.1)') ;
      Diag (errs, nerrs, line, col, ctx, DynStr.View (dm))
    END
  END ;
  Diag (ledger, nledger, line, col, ctx, DynStr.View (d))
END EmitPend ;

PROCEDURE FlushPend (RO ctx: STR) =
VAR
  changed : BOOL ;
  i, j, n2 : I64 ;
  a2, b2, dmode : STR ;
BEGIN
  changed := TRUE ;
  WHILE changed DO
    changed := FALSE ;
    FOR i := 0 TO nedge - 1 DO
      a2 := edgeA[i] ;
      b2 := edgeB[i] ;
      n2 := nesc ;
      FOR j := 0 TO n2 - 1 DO
        IF Text.Eq (escName[j], a2) THEN
          IF NOT EscHas (b2, escTgt[j]) THEN
            EscTarget (b2, escTgt[j]) ;
            changed := TRUE
          END
        END ;
        IF Text.Eq (escName[j], b2) THEN
          IF NOT EscHas (a2, escTgt[j]) THEN
            EscTarget (a2, escTgt[j]) ;
            changed := TRUE
          END
        END
      END
    END
  END ;
  (* close the carries over the copy edges, exactly as the escape
     targets closed over the alias edges *)
  changed := TRUE ;
  WHILE changed DO
    changed := FALSE ;
    FOR i := 0 TO ncedge - 1 DO
      a2 := carryEA[i] ;
      b2 := carryEB[i] ;
      n2 := ncarry ;
      FOR j := 0 TO n2 - 1 DO
        IF Text.Eq (carryN[j], b2) THEN
          IF NOT CarryHas (a2, carryB[j]) THEN
            CarryAdd (a2, carryB[j]) ;
            changed := TRUE
          END
        END
      END
    END
  END ;
  FOR i := 0 TO npend - 1 DO
    dmode := ScopeMode (pendSrc[i]) ;
    IF Text.Eq (dmode, ModeVal) OR Text.Eq (dmode, ModeVar) OR
       Text.Eq (dmode, ModeRo) THEN
      EmitPend (pendLine[i], pendCol[i], pendSrc[i], '', pendDst[i], ctx)
    ELSIF Text.Eq (dmode, ModeLocal) OR Text.Eq (dmode, ModeBinder) THEN
      (* a carrier resolves to one entry per borrow it carries -- and
         to NONE when it carries none, which is most locals *)
      FOR j := 0 TO ncarry - 1 DO
        IF Text.Eq (carryN[j], pendSrc[i]) THEN
          EmitPend (pendLine[i], pendCol[i], carryB[j],
                    pendSrc[i], pendDst[i], ctx)
        END
      END
    END
  END ;
  (* the lie detector: a KEPT parameter the analysis never saw
     retained.  A ledger class, not an error -- a borrow laundered
     through a call result is not yet seen, so an overstatement is
     a signal to read, not proof of a lie. *)
  FOR i := 0 TO nkept - 1 DO
    IF NOT KeptUsedHas (keptP[i]) THEN
      Diag (ledger, nledger, keptLn[i], keptCl[i], ctx,
        S3 ('kept-unseen: KEPT ', keptP[i],
            ' is not seen retained by this analysis (par 4.1)'))
    END
  END ;
  nesc := 0 ;
  nedge := 0 ;
  npend := 0 ;
  ncarry := 0 ;
  ncedge := 0
END FlushPend ;
(* the declared type a designator lands on, following selectors and
   dereferencing pointers on the way.  NONE when it cannot be known,
   because an unknown type must never diagnose.                     *)
PROCEDURE DesigDeclType (d: PTR Ast.Node ; RO ctx: STR) : Ast.Kid =
VAR
  j, q : I64 ;
  it, eb : STR ;
  declN, res : Ast.Kid ;
  deref, known : BOOL ;
BEGIN
  declN := ScopeType (d.a) ;
  FOR j := 0 TO d.nkids - 1 DO
    (* every axis of every subscript is an index *)
    IF d.kids[j] IS SOME isel THEN
      IF isel.kind = Ast.NSelIndex THEN
        eb := ArrEnumBoundOf (declN) ;
        IF LEN (eb) > 0 THEN
          (* ARRAY Colour OF T: the one subscript is a Colour value *)
          IF isel.nkids >= 1 THEN
            it := ExprType (isel.kids[0], ctx) ;
            IF LEN (it) > 0 AND NOT Text.Eq (it, eb) THEN
              ErrN (d, ctx, S4 ('an ARRAY ', TyName (eb),
                ' OF is indexed by a ', Cat (TyName (eb),
                Cat (' value, not ', TyName (it)))))
            END
          END
        ELSE
          FOR q := 0 TO isel.nkids - 1 DO
            it := ExprType (isel.kids[q], ctx) ;
            IF NOT IsIntish (it) THEN
              ErrN (d, ctx, Cat ('index must be an integer, not ',
                TyName (it)))
            END
          END
        END
      END
    END ;
    known := FALSE ;
    IF declN IS SOME dn1 THEN known := TRUE END ;
    IF NOT known THEN RETURN NONE END ;
    res := ResolveType (declN) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          declN := r0.kids[0] ;
          res := ResolveType (declN)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF r.kind = Ast.NOptType THEN
        (* selecting THROUGH an OPT is the faith-based downcast the
           museum records: the guard is not optional *)
        ErrN (d, ctx, Cat ('OPT value used without IS SOME guard: ',
          d.a)) ;
        RETURN NONE
      END ;
      IF r.kind = Ast.NCaseRecordType THEN
        (* a variant is reached by CASE, which binds its payload;
           selecting one is the faith-based downcast again *)
        ErrN (d, ctx, Cat (
          'CASE RECORD is reached by CASE, not by selection: ', d.a)) ;
        RETURN NONE
      END ;
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            declN := FieldTypeOf (r, sel.a) ;
            IF declN IS SOME fk THEN
              q := 0                     (* found; nothing to say *)
            ELSE
              IF r.kids[0] IS SOME base THEN
                q := 0                   (* an extension: it may be
                                            the base record's field *)
              ELSE
                ErrN (d, ctx, S4 ('no field ', sel.a,
                  ' in the record type of ', d.a))
              END
            END
          ELSIF r.kind = Ast.NMonitorType THEN
            (* par 6: a monitor's fields are reachable only through
               the procedure bound to it, and the binding is the
               FIRST parameter because M9 has no method syntax.  So
               the monitor must be named by that parameter, bare:
               `w.next` inside `Claim (VAR w: Work)` is the binding,
               while `j.w.next` reaches past it, and a second monitor
               parameter is a different lock. *)
            IF Text.Eq (boundMon, '') OR NOT Text.Eq (d.a, boundMon) OR
               j # 0 THEN
              ErrN (d, ctx, S3 ('monitor field ', sel.a,
                ' is reached from outside a procedure bound to the monitor (par 6)'))
            END ;
            declN := MonFieldType (r, sel.a)
          ELSE
            RETURN NONE
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            (* one subscript per axis, counted against the rank in
               the type: the check a flat slice with arithmetic on
               top cannot make *)
            IF sel.nkids # AtoI (Print.ExprText (r.kids[0])) THEN
              ErrN (d, ctx, S5 ('a GRID ',
                Print.ExprText (r.kids[0]), ' needs ',
                Print.ExprText (r.kids[0]),
                Cat (' subscripts, not ', ItoA (sel.nkids))))
            END ;
            declN := r.kids[1]
          ELSIF r.kind = Ast.NSliceType THEN
            IF sel.nkids # 1 THEN
              ErrN (d, ctx, Cat ('a slice takes one subscript, not ',
                ItoA (sel.nkids)))
            END ;
            declN := r.kids[0]
          ELSIF r.kind = Ast.NArrayType THEN
            IF sel.nkids # 1 THEN
              ErrN (d, ctx, Cat ('an array takes one subscript, not ',
                ItoA (sel.nkids)))
            END ;
            declN := r.kids[1]
          ELSE RETURN NONE END
        END
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN declN
END DesigDeclType ;

PROCEDURE DesigCanon (k: Ast.Kid ; RO ctx: STR) : STR =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      RETURN CanonT (DesigDeclType (e, ctx), 0)
    END ;
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen THEN
      RETURN DesigCanon (e.kids[0], ctx)
    END
  END ;
  RETURN ''
END DesigCanon ;

(* ---- pass 3: expression and assignment typing ----

   Types are canonical STRINGS -- 'I64', 'PTR Json.Node',
   'SLICE OF CHAR', 'GRID 2 OF F64' -- because that is what makes
   nominal identity, alias chasing and diagnostics one mechanism
   instead of three.  Records, monitors and opaques are nominal
   (Mod.Name); aliases chase to structure; the IN-pool and the RO
   mode are not part of type identity.

   The empty string means UNKNOWN and never diagnoses.  Softness is
   the contract: a checker that guesses at what it cannot resolve
   reports errors that are not there, and a checker nobody believes
   is a checker nobody runs.

   The literal pseudo-types adapt: <int> fits any integer or BYTE,
   <real> fits F32/F64, <str1> (a one-character string) fits CHAR or
   SLICE OF CHAR, <none> fits any OPT, <all> fits only a VIEW axis.
   Everything else converts explicitly, including widths -- the
   16-byte-stride museum piece is a width that converted itself.   *)

PROCEDURE AtoI (RO s: STR) : I64 =
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] < '0' OR s[i] > '9' THEN RETURN v END ;
    v := v * 10 + (ORD (s[i]) - 48)
  END ;
  RETURN v
END AtoI ;

PROCEDURE ItoA (v: I64) : STR =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.AppendI64 (d, v) ;
  RETURN DynStr.View (d)
END ItoA ;

PROCEDURE S3 (RO a: STR ; RO b: STR ; RO c: STR) : STR =
BEGIN
  RETURN Cat (Cat (a, b), c)
END S3 ;

PROCEDURE S4 (RO a: STR ; RO b: STR ; RO c: STR ; RO d: STR) : STR =
BEGIN
  RETURN Cat (Cat (a, b), Cat (c, d))
END S4 ;

PROCEDURE S5 (RO a: STR ; RO b: STR ; RO c: STR ; RO d: STR ;
              RO e: STR) : STR =
BEGIN
  RETURN Cat (S4 (a, b, c, d), e)
END S5 ;

PROCEDURE IsIntStr (RO s: STR) : BOOL =
BEGIN
  IF Text.Eq (s, 'I8') OR Text.Eq (s, 'I16') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'I32') OR Text.Eq (s, 'I64') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'U8') OR Text.Eq (s, 'U16') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'U32') OR Text.Eq (s, 'U64') THEN RETURN TRUE END ;
  RETURN FALSE
END IsIntStr ;

PROCEDURE IsFloatStr (RO s: STR) : BOOL =
BEGIN
  RETURN Text.Eq (s, 'F32') OR Text.Eq (s, 'F64')
END IsFloatStr ;

PROCEDURE IsIntish (RO s: STR) : BOOL =
BEGIN
  IF LEN (s) = 0 THEN RETURN TRUE END ;
  RETURN IsIntStr (s) OR Text.Eq (s, '<int>')
END IsIntish ;

PROCEDURE IsNumStr (RO s: STR) : BOOL =
BEGIN
  IF LEN (s) = 0 THEN RETURN TRUE END ;
  IF Text.Eq (s, '<int>') OR Text.Eq (s, '<real>') THEN RETURN TRUE END ;
  RETURN IsIntStr (s) OR IsFloatStr (s)
END IsNumStr ;

PROCEDURE TyName (RO s: STR) : STR =
BEGIN
  IF Text.Eq (s, '<int>') THEN RETURN 'an integer literal' END ;
  IF Text.Eq (s, '<real>') THEN RETURN 'a real literal' END ;
  IF Text.Eq (s, '<str1>') THEN RETURN 'a CHAR/string literal' END ;
  IF Text.Eq (s, '<none>') THEN RETURN 'NONE' END ;
  IF Text.Eq (s, '<void>') THEN RETURN 'no value' END ;
  IF Text.Eq (s, '<all>') THEN RETURN 'ALL' END ;
  IF LEN (s) = 0 THEN RETURN 'an unknown type' END ;
  RETURN s
END TyName ;

PROCEDURE AfterOf (RO s: STR) : STR =
VAR i : I64 ;
BEGIN
  i := Text.Find (s, ' OF ') ;
  IF i < 0 THEN RETURN '' END ;
  RETURN SLICE (s, i + 4, LEN (s) - i - 4)
END AfterOf ;

(* 'GRID 3 OF F64': the rank is part of the type so that subscript
   arity is a compile-time question.  0 means "not a grid". *)
PROCEDURE GridRank (RO s: STR) : I64 =
VAR i, v, k : I64 ;
BEGIN
  IF NOT Text.StartsWith (s, 'GRID ') THEN RETURN 0 END ;
  i := Text.Find (s, ' OF ') ;
  IF i <= 5 THEN RETURN 0 END ;
  v := 0 ;
  FOR k := 5 TO i - 1 DO
    IF s[k] < '0' OR s[k] > '9' THEN RETURN 0 END ;
    v := v * 10 + (ORD (s[k]) - 48)
  END ;
  RETURN v
END GridRank ;

(* the type of a view that keeps rank axes.  A rank-1 view is a
   GRID 1 and NOT a slice: a slice is {pointer, length} with no
   stride, and the column at (i,j) is strided. *)
PROCEDURE GridOf (rank: I64 ; RO elem: STR) : STR =
BEGIN
  IF LEN (elem) = 0 THEN RETURN '' END ;
  RETURN S4 ('GRID ', ItoA (rank), ' OF ', elem)
END GridOf ;

(* assignment compatibility: may a src value land where dst is
   expected?  Unknown is compatible with everything. *)
(* the range of an integer width a literal is stored into; FALSE for
   a type that is not a narrow integer -- I64 holds every literal the
   lexer accepts, and U64's upper half cannot be spelled as one *)
PROCEDURE LitRange (RO t: STR ; VAR lo: I64 ; VAR hi: I64) : BOOL =
BEGIN
  IF Text.Eq (t, 'I8') THEN lo := -128 ; hi := 127 ; RETURN TRUE END ;
  IF Text.Eq (t, 'I16') THEN lo := -32768 ; hi := 32767 ; RETURN TRUE END ;
  IF Text.Eq (t, 'I32') THEN
    lo := -2147483648 ; hi := 2147483647 ; RETURN TRUE
  END ;
  IF Text.Eq (t, 'U8') OR Text.Eq (t, 'BYTE') THEN
    lo := 0 ; hi := 255 ; RETURN TRUE
  END ;
  IF Text.Eq (t, 'U16') THEN lo := 0 ; hi := 65535 ; RETURN TRUE END ;
  IF Text.Eq (t, 'U32') THEN lo := 0 ; hi := 4294967295 ; RETURN TRUE END ;
  IF Text.Eq (t, 'U64') THEN lo := 0 ; hi := 9223372036854775807 ; RETURN TRUE END ;
  RETURN FALSE
END LitRange ;

(* a decimal literal node's value, negated when asked; FALSE for a hex
   literal (a bit pattern, left to the width it names) or one too
   long to hold *)
PROCEDURE LitVal (lit: PTR Ast.Node ; neg: BOOL ; VAR v: I64) : BOOL =
VAR i : I64 ;
BEGIN
  IF lit.kind # Ast.NInt THEN RETURN FALSE END ;
  IF LEN (lit.a) = 0 OR LEN (lit.a) > 18 THEN RETURN FALSE END ;
  FOR i := 0 TO LEN (lit.a) - 1 DO
    IF lit.a[i] < '0' OR lit.a[i] > '9' THEN RETURN FALSE END
  END ;
  v := AtoI (lit.a) ;
  IF neg THEN v := -v END ;
  RETURN TRUE
END LitVal ;

(* an integer literal stored where a narrow width is expected must
   fit it.  `s := 40000` for an I16 passed this checker and the C
   conversion stored -25536 until 2026-09-27 -- the same silence as
   the narrow arithmetic fixed the same day (docs/agent-review-
   2026-09-27.md F1).  Answers the offending value through v. *)
PROCEDURE LitOut (n: PTR Ast.Node ; RO t: STR ; VAR v: I64) : BOOL =
VAR lo, hi : I64 ;
BEGIN
  IF NOT LitRange (t, lo, hi) THEN RETURN FALSE END ;
  IF n.kind = Ast.NUn AND Text.Eq (n.a, '-') THEN
    IF n.kids[0] IS SOME c THEN
      IF NOT LitVal (c, TRUE, v) THEN RETURN FALSE END ;
      RETURN v < lo OR v > hi
    END ;
    RETURN FALSE
  END ;
  IF NOT LitVal (n, FALSE, v) THEN RETURN FALSE END ;
  RETURN v < lo OR v > hi
END LitOut ;

(* ---- a procedure fits a procedure type that lets it raise MORE than
   it does (report par 2.2.3; Alex's decision of 2026-10-02).  The
   fit was to the letter, RAISES included, and so a function that
   cannot raise had to SAY `RAISES ValueRange' to be handed to
   Numeric, and Check needed two types where one would do.  Raising
   less is sound: the caller of a value handles what the TYPE says,
   which is then a superset; and nothing moves in the C, where every
   procedure takes the error slot whatever it declares.  Raising
   more is refused as it always was.  Everything else in the
   canonical text -- modes, types, the result -- is still held to
   the letter. ---- *)

(* how much of the canonical text of a procedure type comes before
   its own RAISES clause: all of it when it has none, -1 when s is
   not a procedure type.  A parameter may itself be a procedure type
   with a RAISES of its own, inside the parentheses; the result
   cannot be one. *)
PROCEDURE ProcHead (RO s: STR) : I64 =
VAR i, depth, close : I64 ;
BEGIN
  IF NOT Text.StartsWith (s, 'PROCEDURE (') THEN RETURN -1 END ;
  depth := 0 ;
  close := -1 ;
  i := 10 ;
  WHILE i < LEN (s) AND close < 0 DO
    IF s[i] = '(' THEN
      depth := depth + 1
    ELSIF s[i] = ')' THEN
      depth := depth - 1 ;
      IF depth = 0 THEN close := i END
    END ;
    i := i + 1
  END ;
  IF close < 0 THEN RETURN -1 END ;
  i := close ;
  WHILE i + 8 <= LEN (s) DO
    IF Text.Eq (SLICE (s, i, 8), ' RAISES ') THEN RETURN i END ;
    i := i + 1
  END ;
  RETURN LEN (s)
END ProcHead ;

(* two lists as they stand after RAISES, `A, B': is every name of
   src one of dst's? *)
PROCEDURE RaisesWithin (RO src: STR ; RO dst: STR) : BOOL =
VAR
  a, b, ea, eb : I64 ;
  found : BOOL ;
BEGIN
  a := 0 ;
  WHILE a < LEN (src) DO
    ea := a ;
    WHILE ea < LEN (src) AND src[ea] # ',' DO ea := ea + 1 END ;
    found := FALSE ;
    b := 0 ;
    WHILE b < LEN (dst) AND NOT found DO
      eb := b ;
      WHILE eb < LEN (dst) AND dst[eb] # ',' DO eb := eb + 1 END ;
      found := Text.Eq (SLICE (src, a, ea - a), SLICE (dst, b, eb - b)) ;
      b := eb + 2
    END ;
    IF NOT found THEN RETURN FALSE END ;
    a := ea + 2
  END ;
  RETURN TRUE
END RaisesWithin ;

PROCEDURE ProcFits (RO dst: STR ; RO src: STR) : BOOL =
VAR hd, hs : I64 ;
BEGIN
  hd := ProcHead (dst) ;
  hs := ProcHead (src) ;
  IF hd < 0 OR hs < 0 THEN RETURN FALSE END ;
  IF NOT Text.Eq (SLICE (dst, 0, hd), SLICE (src, 0, hs)) THEN RETURN FALSE END ;
  IF hs = LEN (src) THEN RETURN TRUE END ;        (* src raises nothing *)
  IF hd = LEN (dst) THEN RETURN FALSE END ;       (* and dst allows nothing *)
  RETURN RaisesWithin (SLICE (src, hs + 8, LEN (src) - hs - 8),
                       SLICE (dst, hd + 8, LEN (dst) - hd - 8))
END ProcFits ;

PROCEDURE Compat (RO dst: STR ; RO src: STR) : BOOL =
BEGIN
  IF Text.Eq (dst, '<void>') OR Text.Eq (src, '<void>') THEN
    RETURN FALSE
  END ;
  IF LEN (dst) = 0 OR LEN (src) = 0 THEN RETURN TRUE END ;
  IF Text.Eq (dst, src) THEN RETURN TRUE END ;
  IF Text.Eq (src, '<int>') THEN
    RETURN IsIntStr (dst) OR Text.Eq (dst, 'BYTE')
  END ;
  IF Text.Eq (dst, '<int>') THEN
    RETURN IsIntStr (src) OR Text.Eq (src, 'BYTE')
  END ;
  IF Text.Eq (src, '<real>') THEN RETURN IsFloatStr (dst) END ;
  IF Text.Eq (dst, '<real>') THEN RETURN IsFloatStr (src) END ;
  IF Text.Eq (src, '<str1>') THEN
    RETURN Text.Eq (dst, 'CHAR') OR Text.Eq (dst, 'SLICE OF CHAR')
  END ;
  IF Text.Eq (dst, '<str1>') THEN
    RETURN Text.Eq (src, 'CHAR') OR Text.Eq (src, 'SLICE OF CHAR')
  END ;
  IF Text.Eq (src, '<none>') THEN RETURN Text.StartsWith (dst, 'OPT ') END ;
  IF Text.Eq (dst, '<none>') THEN RETURN Text.StartsWith (src, 'OPT ') END ;
  (* ARRAY N OF T is the view of all N elements (par 2.2) *)
  IF Text.StartsWith (dst, 'SLICE OF ') AND
     Text.StartsWith (src, 'ARRAY ') THEN
    RETURN Text.Eq (AfterOf (src), SLICE (dst, 9, LEN (dst) - 9))
  END ;
  (* a shared handle lends like a plain borrow (par 4.1) *)
  IF Text.StartsWith (dst, 'PTR ') THEN
    IF Text.Eq (src, Cat ('SHARED ', dst)) THEN RETURN TRUE END
  END ;
  (* a procedure that raises no more than the type allows, bare or as
     the OPT a variable of procedure type must be *)
  IF ProcFits (dst, src) THEN RETURN TRUE END ;
  IF Text.StartsWith (dst, 'OPT ') AND Text.StartsWith (src, 'OPT ') THEN
    RETURN ProcFits (SLICE (dst, 4, LEN (dst) - 4), SLICE (src, 4, LEN (src) - 4))
  END ;
  RETURN FALSE
END Compat ;

(* one site where two types are about to be held to each other: it
   was EXAMINED when both are known, and PASSED OVER when either is
   the empty string, which is exactly the case Compat answers TRUE
   for without looking.  Called beside every Compat that decides a
   diagnostic, never inside it: several sites ask Compat twice. *)
PROCEDURE PassedOver (kind, line: I64) =
  (* count it, and keep the first StatSites DIFFERENT lines: a count
     a reviewer cannot go and look at is a count they have to take on
     trust, which is what the page exists to end *)
VAR r : I64 ;
BEGIN
  statS[kind] := statS[kind] + 1 ;
  r := statR[kind] ;
  IF r < StatSites THEN
    IF r = 0 THEN
      statL[kind * StatSites] := line ;
      statR[kind] := 1
    ELSIF statL[kind * StatSites + r - 1] # line THEN
      statL[kind * StatSites + r] := line ;
      statR[kind] := r + 1
    END
  END
END PassedOver ;

PROCEDURE Agree (kind: I64 ; RO a: STR ; RO b: STR ; line: I64) =
BEGIN
  IF LEN (a) = 0 OR LEN (b) = 0 THEN
    PassedOver (kind, line)
  ELSE
    statC[kind] := statC[kind] + 1
  END
END Agree ;

PROCEDURE StatName (i: I64) : STR =
BEGIN
  CASE i OF
  | 0 : RETURN 'assignments'
  | 1 : RETURN 'arguments'
  | 2 : RETURN 'RETURN values'
  | 3 : RETURN 'operands of a comparison or an operator'
  | 4 : RETURN 'CASE labels'
  | 5 : RETURN 'THREAD arguments'
  | 6 : RETURN 'CASE over variants, proved total'
  ELSE RETURN ''
  END
END StatName ;

PROCEDURE StatChecked (i: I64) : I64 =
BEGIN
  RETURN statC[i]
END StatChecked ;

PROCEDURE StatSkipped (i: I64) : I64 =
BEGIN
  RETURN statS[i]
END StatSkipped ;

PROCEDURE StatLines (i: I64) : I64 =
BEGIN
  RETURN statR[i]
END StatLines ;

PROCEDURE StatLine (i, j: I64) : I64 =
BEGIN
  RETURN statL[i * StatSites + j]
END StatLine ;

(* the type one element of an aggregate has (par 2.2.4): a literal,
   or a negated numeric literal.  An integer is an I64, a real an
   F64, a string a STR whatever its length -- a table has one element
   type and nothing in it adapts.  '' for anything else.  A record
   aggregate whose fields are all literals is an element of its
   record's type (Row (200, 'OK'); the fields' types are
   CheckRecordConst's to hold). *)
PROCEDURE RecordNamed (RO name: STR ; VAR om: STR ; VAR canon: STR) : Ast.Kid ;

PROCEDURE RecordConstType (e: PTR Ast.Node) : STR =
VAR
  i : I64 ;
  om, canon : STR ;
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN '' END ;
  IF e.kids[0] IS SOME dn THEN
    IF RecordNamed (DesigName (dn), om, canon) IS SOME rn THEN
      IF e.kids[1] IS SOME al THEN
        FOR i := 0 TO al.nkids - 1 DO
          IF LEN (AggElemType (al.kids[i])) = 0 THEN RETURN '' END
        END
      END ;
      RETURN canon
    END
  END ;
  RETURN ''
END RecordConstType ;

(* is e Row (...) for a record type Row? *)
PROCEDURE IsRecordCall (e: PTR Ast.Node) : BOOL =
VAR om, canon : STR ;
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN FALSE END ;
  IF e.kids[0] IS SOME dn THEN
    IF RecordNamed (DesigName (dn), om, canon) IS SOME rn THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsRecordCall ;

(* the type of field f of the record whose canonical name is rec --
   a record CONST read as Ok.code *)
PROCEDURE ConstFieldType (RO rec: STR ; RO f: STR) : STR =
VAR
  om, canon, s : STR ;
BEGIN
  IF RecordNamed (rec, om, canon) IS SOME rn THEN
    IF FieldTypeOf (rn, f) IS SOME ft THEN
      canonCtx := Text.Keep (pool, om) ;
      s := CanonT (SOME (ft), 0) ;
      canonCtx := '' ;
      RETURN s
    END
  END ;
  RETURN ''
END ConstFieldType ;

PROCEDURE AggElemType (k: Ast.Kid) : STR =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN RETURN RecordConstType (e) END ;
    CASE e.kind OF
    | Ast.NInt : RETURN 'I64'
    | Ast.NReal : RETURN 'F64'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString : RETURN 'SLICE OF CHAR'
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NUn :
        IF Text.Eq (e.a, '-') THEN
          IF e.kids[0] IS SOME o THEN
            IF o.kind = Ast.NInt THEN RETURN 'I64' END ;
            IF o.kind = Ast.NReal THEN RETURN 'F64' END
          END
        END ;
        RETURN ''
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END AggElemType ;

(* [ e1, ..., en ] is an ARRAY n OF T, T being what every element
   is; unknown ('') when the elements do not agree, which
   CheckAggregate says by name *)
PROCEDURE AggType (e: PTR Ast.Node) : STR =
VAR
  i : I64 ;
  t : STR ;
BEGIN
  IF e.nkids = 0 THEN RETURN '' END ;
  t := AggElemType (e.kids[0]) ;
  IF LEN (t) = 0 THEN RETURN '' END ;
  FOR i := 1 TO e.nkids - 1 DO
    IF NOT Text.Eq (AggElemType (e.kids[i]), t) THEN RETURN '' END
  END ;
  RETURN S4 ('ARRAY ', ItoA (e.nkids), ' OF ', t)
END AggType ;

(* the type of a module-level CONST: literals and literal
   arithmetic, an aggregate of literals, and nothing fancier *)
PROCEDURE LitType (k: Ast.Kid) : STR =
VAR l, r : STR ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN RETURN RecordConstType (e) END ;
    CASE e.kind OF
    | Ast.NAggregate : RETURN AggType (e)
    | Ast.NInt : RETURN '<int>'
    | Ast.NReal : RETURN '<real>'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString :
        IF LEN (e.a) = 1 THEN RETURN '<str1>' END ;
        RETURN 'SLICE OF CHAR'
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NParen : RETURN LitType (e.kids[0])
    | Ast.NUn : RETURN LitType (e.kids[0])
    | Ast.NBin :
        l := LitType (e.kids[0]) ;
        r := LitType (e.kids[1]) ;
        IF Text.Eq (l, '<int>') AND Text.Eq (r, '<int>') THEN
          RETURN '<int>'
        END ;
        IF Text.Eq (l, '<real>') AND Text.Eq (r, '<real>') THEN
          RETURN '<real>'
        END ;
        RETURN ''
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END LitType ;

PROCEDURE ConstClear () =
BEGIN
  nconsts := 0 ;
  nAgg := 0
END ConstClear ;

PROCEDURE ConstAdd (RO KEPT nm: STR ; RO KEPT ty: STR) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nconsts = LEN (consts) THEN
    nb := NEW (pool, Binding, 2 * LEN (consts) + 16) ;
    FOR i := 0 TO nconsts - 1 DO nb[i] := consts[i] END ;
    consts := nb
  END ;
  consts[nconsts].name := nm ;
  consts[nconsts].mode := ty ;
  consts[nconsts].ty := NONE ;
  nconsts := nconsts + 1
END ConstAdd ;

PROCEDURE ConstType (RO nm: STR ; VAR found: BOOL) : STR =
VAR i : I64 ;
BEGIN
  found := FALSE ;
  FOR i := 0 TO nconsts - 1 DO
    IF Text.Eq (consts[i].name, nm) THEN
      found := TRUE ;
      RETURN consts[i].mode
    END
  END ;
  RETURN ''
END ConstType ;

(* is this name, HERE, a constant?  A parameter, a local or a module
   variable of the same name shadows it, as it does in the generated
   C -- the lookup that forgot that typed a parameter named like a
   module CONST as the constant (found 2026-10-01). *)
PROCEDURE IsConstHere (RO nm: STR) : BOOL =
VAR
  found : BOOL ;
  t : STR ;
BEGIN
  IF LEN (ScopeMode (nm)) > 0 THEN RETURN FALSE END ;
  t := ConstType (nm, found) ;
  RETURN found
END IsConstHere ;

(* ... and a constant TABLE, the value of an aggregate (par 2.2.4) *)
PROCEDURE IsAggConst (RO nm: STR) : BOOL =
VAR
  found : BOOL ;
  t : STR ;
BEGIN
  IF LEN (ScopeMode (nm)) > 0 THEN RETURN FALSE END ;
  t := ConstType (nm, found) ;
  RETURN found AND Text.StartsWith (t, 'ARRAY ')
END IsAggConst ;

(* par 2.2.4: what an aggregate CONST must be -- literals of one
   type, at module level, in a module's own part.
     where -- 0 a module's own, 1 exported by a DEFINITION, 2 local
              to a procedure *)
(* a record aggregate in a CONST, alone or as a table's element: every
   field a literal of its field's type, as many as the record has *)
PROCEDURE CheckRecordConst (el: PTR Ast.Node ; RO ctx: STR ; RO what: STR) =
VAR
  k, nflat : I64 ;
  om, canon, name, pTy, aTy : STR ;
  flat : SLICE OF AKid ;
BEGIN
  IF el.kids[0] IS SOME dn THEN
    name := DesigName (dn) ;
    IF RecordNamed (name, om, canon) IS SOME rn THEN
      IF rn.kids[0] IS SOME rbase THEN
        ErrN (el, ctx, Cat (name, ': an aggregate of an extended record is'
          + ' not built; give its fields one by one (par 2.2.4)')) ;
        RETURN
      END ;
      flat := FlatFields (rn.kids[1], nflat) ;
      IF el.kids[1] IS SOME al THEN
        Arity (el, ctx, name, nflat, al.nkids) ;
        FOR k := 0 TO al.nkids - 1 DO
          IF al.kids[k] IS SOME a THEN
            IF LEN (AggElemType (al.kids[k])) = 0 THEN
              ErrN (a, ctx, S5 ('field ', ItoA (k + 1), ' of ', what,
                ' is not a literal: a CONST holds literals (par 2.2.4)'))
            ELSIF k < nflat THEN
              canonCtx := Text.Keep (pool, om) ;
              pTy := CanonT (flat[k], 0) ;
              canonCtx := '' ;
              aTy := LitType (al.kids[k]) ;
              IF NOT Compat (pTy, aTy) THEN
                ErrN (a, ctx, S5 ('field ', ItoA (k + 1), ' of ', what,
                  S4 (': cannot give ', TyName (aTy), ' where ',
                      Cat (TyName (pTy), ' is expected'))))
              END
            END
          END
        END
      END
    END
  END
END CheckRecordConst ;

PROCEDURE CheckAggregate (cd: PTR Ast.Node ; RO ctx: STR ; where: I64) =
VAR
  i : I64 ;
  t0, t : STR ;
BEGIN
  IF cd.kids[0] IS SOME rc THEN
    IF IsRecordCall (rc) THEN
      IF rc.kids[0] IS SOME rdn THEN
        IF RecordNamed (DesigName (rdn), t0, t) IS SOME rr THEN
          IF where = 1 THEN
            ErrN (cd, ctx, S3 ('a record CONST is not exported yet: ',
              cd.a, ' (par 2.2.4)'))
          ELSIF where = 2 THEN
            ErrN (cd, ctx, S3 ('a record CONST belongs at module level: ',
              cd.a, ' (par 2.2.4)'))
          END ;
          CheckRecordConst (rc, ctx, cd.a)
        END
      END
    END
  END ;
  IF cd.kids[0] IS SOME ag THEN
    IF ag.kind = Ast.NAggregate THEN
      nAgg := nAgg + 1 ;
      IF where = 1 THEN
        ErrN (cd, ctx, S3 ('an aggregate CONST is not exported yet: ',
          cd.a, ' (par 2.2.4)'))
      ELSIF where = 2 THEN
        ErrN (cd, ctx, S3 ('an aggregate CONST belongs at module level: ',
          cd.a, ' (par 2.2.4)'))
      END ;
      t0 := AggElemType (ag.kids[0]) ;
      FOR i := 0 TO ag.nkids - 1 DO
        IF ag.kids[i] IS SOME el THEN
          t := AggElemType (ag.kids[i]) ;
          IF IsRecordCall (el) THEN
            CheckRecordConst (el, ctx, S4 ('element ', ItoA (i + 1), ' of ', cd.a))
          END ;
          IF LEN (t) = 0 AND IsRecordCall (el) THEN
            t := ''                      (* said by CheckRecordConst *)
          ELSIF LEN (t) = 0 THEN
            ErrN (el, ctx, S5 ('element ', ItoA (i + 1), ' of ', cd.a,
              ' is not a literal: an aggregate holds literals (par 2.2.4)'))
          ELSIF LEN (t0) > 0 AND NOT Text.Eq (t, t0) THEN
            ErrN (el, ctx, S5 ('element ', ItoA (i + 1), ' of ', cd.a,
              S5 (' is ', TyName (t), ' where the first is ', TyName (t0),
                  ': an aggregate has one element type (par 2.2.4)')))
          END
        END
      END
    END
  END
END CheckAggregate ;

(* par 2.2.4: a constant table is read-only DATA, so its whole value
   goes only where nothing can write through it -- indexed, under
   LEN, or lent to an RO parameter (CallType holds that last one,
   argument by argument).  Anything else that names it bare would
   make an alias: s := Primes, SLICE (Primes, 0, 2), RETURN Primes. *)
PROCEDURE AggWalk (n: PTR Ast.Node ; parent: I64 ; RO ctx: STR) =
VAR i, first : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND
     parent # Ast.NArgList THEN
    IF IsAggConst (n.a) THEN
      ErrN (n, ctx, S3 ('the CONST table ', n.a,
        ' can only be indexed, measured with LEN, or lent to an RO'
        + ' parameter (par 2.2.4)'))
    END
  END ;
  first := 0 ;
  (* the left side of an assignment is CheckWrite's to refuse *)
  IF n.kind = Ast.NAssign THEN
    IF n.kids[0] IS SOME lhs THEN
      IF lhs.nkids = 0 THEN first := 1 END
    END
  END ;
  FOR i := first TO n.nkids - 1 DO
    IF n.kids[i] IS SOME k THEN AggWalk (k, n.kind, ctx) END
  END
END AggWalk ;

(* one argument that names a constant: it cannot be a VAR or OWN
   argument (there is nothing to write), and a constant table goes
   only to an RO parameter (par 2.2.4) *)
PROCEDURE ConstArg (site: PTR Ast.Node ; RO ctx: STR ; RO name: STR ;
                    k: I64 ; an: Ast.Kid ; isVar: BOOL ; isRo: BOOL) =
BEGIN
  IF an IS SOME a THEN
    IF a.kind = Ast.NDesignator THEN
      IF IsConstHere (a.a) THEN
        IF isVar THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': the CONST ', a.a,
                ' cannot be passed to a VAR or OWN parameter')))
        ELSIF a.nkids = 0 AND NOT isRo AND IsAggConst (a.a) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': the CONST table ', a.a,
                ' can be lent only to an RO parameter (par 2.2.4)')))
        END
      END
    END
  END
END ConstArg ;

(* par 2.4: read-only storage -- a string literal, what an RO
   parameter views, a CONST -- is lent only to an RO parameter.  A
   by-value SLICE or GRID parameter can be written through, and
   `Up ('abc')` with `s[0] := 'X'` inside was accepted and died with
   SIGSEGV until 2026-10-01 (museum/write-through-literal.m9).  The
   caller has established that the parameter is neither VAR, OWN nor
   RO. *)
PROCEDURE RoArg (site: PTR Ast.Node ; RO ctx: STR ; RO name: STR ;
                 k: I64 ; an: Ast.Kid ; RO pTy: STR ; RO aTy: STR) =
VAR what : STR ;
BEGIN
  what := '' ;
  IF Text.StartsWith (pTy, 'SLICE OF') OR Text.StartsWith (pTy, 'GRID ') THEN
    IF an IS SOME a THEN
      IF a.kind = Ast.NString THEN
        what := 'a string literal'
      ELSIF a.kind = Ast.NDesignator AND
            (Text.StartsWith (aTy, 'SLICE OF') OR
             Text.StartsWith (aTy, 'GRID ') OR Text.Eq (aTy, '<str1>')) THEN
        IF Text.Eq (ScopeMode (a.a), ModeRo) THEN
          what := Cat ('the RO parameter ', a.a)
        ELSIF ScopeRo (a.a) THEN
          what := Cat ('the RO variable ', a.a)
        ELSIF IsConstHere (a.a) THEN
          what := Cat ('the CONST ', a.a)
        END
      END
    END
  END ;
  IF LEN (what) > 0 THEN
    ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
      S3 (': ', what, ' can be lent only to an RO parameter (par 2.4)')))
  END
END RoArg ;

PROCEDURE ExprType (k: Ast.Kid ; RO ctx: STR) : STR ;
PROCEDURE CallType (dn: Ast.Kid ; KEPT argl: Ast.Kid ; site: PTR Ast.Node ;
                    RO ctx: STR) : STR ;

(* a designator as an expression: scope names, module CONSTs, the
   payload-less variant constructor Type.Variant, and ALL *)
PROCEDURE DesigStrType (d: PTR Ast.Node ; guard: BOOL ; RO ctx: STR) : STR =
VAR
  s, it, om : STR ;
  j, m : I64 ;
  found : BOOL ;
  vi : VariantInfo ;
  vfields : Ast.Kid ;
BEGIN
  IF ScopeType (d.a) IS SOME dn0 THEN
    RETURN CanonT (DesigDeclType (d, ctx), 0)
  END ;
  (* ALL is a predeclared identifier, not a keyword -- the STR
     precedent.  It has a type of its own so that using it anywhere
     but a VIEW axis is a type error naming ALL. *)
  IF Text.Eq (d.a, 'ALL') AND d.nkids = 0 THEN RETURN '<all>' END ;
  (* HEAP, the same way: a predeclared POOL that outlives the
     program's frames and is never freed.  Named rather than
     implicit, so `PTR T IN HEAP` still says which pool, and so a
     program that must not grow can grep for it (par 4.3). *)
  IF Text.Eq (d.a, 'HEAP') AND d.nkids = 0 THEN RETURN 'POOL' END ;
  s := ConstType (d.a, found) ;
  IF found AND LEN (ScopeMode (d.a)) = 0 THEN
    FOR j := 0 TO d.nkids - 1 DO
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelIndex THEN
          it := ExprType (sel.kids[0], ctx) ;
          IF NOT IsIntish (it) THEN
            ErrN (d, ctx, Cat ('index must be an integer, not ',
              TyName (it)))
          END ;
          IF Text.Eq (s, 'SLICE OF CHAR') THEN s := 'CHAR'
          ELSIF Text.StartsWith (s, 'ARRAY ') THEN s := AfterOf (s)
          ELSE s := '' END
        ELSIF sel.kind = Ast.NSelField THEN
          (* a field of a record CONST, or of a table's record element *)
          s := ConstFieldType (s, sel.a)
        ELSE
          s := ''
        END
      END
    END ;
    RETURN s
  END ;
  (* Type.Variant with no payload is a value of that variant type *)
  IF d.nkids = 1 THEN
    IF d.kids[0] IS SOME sf THEN
      IF sf.kind = Ast.NSelField THEN
        om := VariantOwnerOf (d.a, sf.a, found) ;
        IF found THEN RETURN Qualify (om, d.a) END ;
        (* an imported CONST is still a literal *)
        s := ModConstType (d.a, sf.a, found) ;
        IF found THEN RETURN s END
      END
    END
  END ;
  (* Mod.Type.Variant with no payload: the cross-module twin of the
     two-part form above, Palette.Hue.Warm.  d.a is a module name (not
     in scope, or the first branch would have answered), the first
     selector its enumeration or case-record type, the second a member.
     Typing it is what lets FOR over an imported enumeration reach the
     enum branch instead of falling through to the integer path
     (docs/enum-plan.md, part 2). *)
  IF d.nkids = 2 THEN
    IF d.kids[0] IS SOME sfT THEN
      IF d.kids[1] IS SOME sfV THEN
        IF sfT.kind = Ast.NSelField AND sfV.kind = Ast.NSelField THEN
          IF TryVariantMod (FindMod (d.a), sfT.a, sfV.a, om, vfields) THEN
            RETURN Qualify (om, sfT.a)
          END
        END
      END
    END
  END ;
  RETURN CanonT (DesigDeclType (d, ctx), 0)
END DesigStrType ;

PROCEDURE NumSide (RO s: STR) : BOOL =
BEGIN
  RETURN IsNumStr (s)
END NumSide ;

PROCEDURE StrSide (RO s: STR) : BOOL =
BEGIN
  RETURN Text.Eq (s, 'SLICE OF CHAR') OR Text.Eq (s, '<str1>')
END StrSide ;

PROCEDURE IsComposite (RO t: STR) : BOOL ;

PROCEDURE BinType (e: PTR Ast.Node ; RO ctx: STR) : STR =
VAR lt, rt, op : STR ;
BEGIN
  op := e.a ;
  lt := ExprType (e.kids[0], ctx) ;
  rt := ExprType (e.kids[1], ctx) ;
  IF Text.Eq (op, 'AND') OR Text.Eq (op, 'OR') THEN
    IF LEN (lt) > 0 AND NOT Text.Eq (lt, 'BOOL') THEN
      ErrN (e, ctx, S3 (op, ' needs BOOL operands, not ', TyName (lt)))
    END ;
    IF LEN (rt) > 0 AND NOT Text.Eq (rt, 'BOOL') THEN
      ErrN (e, ctx, S3 (op, ' needs BOOL operands, not ', TyName (rt)))
    END ;
    RETURN 'BOOL'
  END ;
  IF Text.Eq (op, '=') OR Text.Eq (op, '#') OR Text.Eq (op, '<') OR
     Text.Eq (op, '<=') OR Text.Eq (op, '>') OR Text.Eq (op, '>=') THEN
    IF Text.Eq (lt, '<void>') OR Text.Eq (rt, '<void>') THEN
      ErrN (e, ctx, 'comparing a call that returns no value')
    ELSIF IsNanLit (e.kids[0]) OR IsNanLit (e.kids[1]) THEN
      (* NaN compares unequal to everything, itself included: `x =
         NaN' is never TRUE and `x # NaN' always is -- the comparison
         a reader takes for a test and the machine does not *)
      ErrN (e, ctx, S3 ("no '", op, "' with NaN: no comparison with NaN is"
        + " ever TRUE, except '#', which always is; Math.IsNaN (x) asks"
        + ' (par 2.1)'))
    ELSE
      Agree (StOperand, lt, rt, e.line) ;
      IF NOT (Compat (lt, rt) OR Compat (rt, lt)) THEN
        ErrN (e, ctx, S4 ('cannot compare ', TyName (lt), ' with ',
          TyName (rt)))
      (* an operator compares SCALARS.  Two strings, two arrays, two
         records agree in type and were let through to a C that has
         no == for a struct: `IF name = 'cancel'` was the C
         compiler's to refuse until 2026-10-02 (par 2.3). *)
      ELSIF StrSide (lt) AND StrSide (rt) AND
            (Text.Eq (lt, 'SLICE OF CHAR') OR
             Text.Eq (rt, 'SLICE OF CHAR')) THEN
        ErrN (e, ctx, S3 ("no '", op, "' between two strings: Text.Eq"
          + ' (a, b) answers equality, and no operator orders them'
          + ' (par 2.3)'))
      ELSIF IsComposite (lt) THEN
        ErrN (e, ctx, S5 ("no '", op, "' between two values of type ",
          TyName (lt), ': an operator compares numbers, characters,'
          + ' booleans, enumeration values and pointers (par 2.3)'))
      ELSIF IsComposite (rt) THEN
        ErrN (e, ctx, S5 ("no '", op, "' between two values of type ",
          TyName (rt), ': an operator compares numbers, characters,'
          + ' booleans, enumeration values and pointers (par 2.3)'))
      END
    END ;
    RETURN 'BOOL'
  END ;
  (* string concatenation, before the arithmetic rules: `+` on two
     strings answers a string, allocated in HEAP (par 4.3).  A CHAR
     on either side is one code point appended or prepended -- a
     CHAR converts to nothing implicitly, so there is nothing for
     `s + c` to decide silently (the rule used to refuse it, on a
     Pascal/C worry M9 does not have; revised 2026-09-06).  Anything
     else -- a number, a record -- must be formatted first. *)
  IF Text.Eq (op, '+') AND (StrSide (lt) OR StrSide (rt)) THEN
    IF NOT (StrSide (lt) OR Text.Eq (lt, 'CHAR')) THEN
      ErrN (e, ctx, S3 ('cannot concatenate ', TyName (lt),
        ' with a string'))
    ELSE
      IF NOT (StrSide (rt) OR Text.Eq (rt, 'CHAR')) THEN
        ErrN (e, ctx, S3 ('cannot concatenate a string with ',
          TyName (rt), ''))
      END
    END ;
    RETURN 'SLICE OF CHAR'
  END ;
  (* arithmetic: + - * / DIV MOD and the wrapping three *)
  IF Text.Eq (lt, 'BYTE') OR Text.Eq (rt, 'BYTE') THEN
    ErrN (e, ctx,
      'BYTE is a raw octet: no arithmetic (convert first, par 2.1)') ;
    RETURN ''
  END ;
  IF NOT NumSide (lt) THEN
    ErrN (e, ctx, S3 (op, ' needs numeric operands, not ', TyName (lt)))
  ELSE
    IF NOT NumSide (rt) THEN
      ErrN (e, ctx, S3 (op, ' needs numeric operands, not ', TyName (rt)))
    ELSE
      Agree (StOperand, lt, rt, e.line) ;
      IF NOT (Compat (lt, rt) OR Compat (rt, lt)) THEN
        ErrN (e, ctx, S5 ('no implicit conversions: ', TyName (lt), ' ',
          op, Cat (' ', TyName (rt))))
      END
    END
  END ;
  IF Text.Eq (op, '/') THEN
    IF IsIntStr (lt) OR Text.Eq (lt, '<int>') OR
       IsIntStr (rt) OR Text.Eq (rt, '<int>') THEN
      ErrN (e, ctx, "'/' is float division; integers use DIV")
    END
  ELSIF Text.Eq (op, 'DIV') OR Text.Eq (op, 'MOD') THEN
    IF IsFloatStr (lt) OR Text.Eq (lt, '<real>') OR
       IsFloatStr (rt) OR Text.Eq (rt, '<real>') THEN
      ErrN (e, ctx, S3 (op, ' is integer division; floats use ', "'/'"))
    END
  ELSIF Text.Eq (op, '+%') OR Text.Eq (op, '-%') OR Text.Eq (op, '*%') THEN
    IF IsFloatStr (lt) OR Text.Eq (lt, '<real>') OR
       IsFloatStr (rt) OR Text.Eq (rt, '<real>') THEN
      ErrN (e, ctx, 'wrapping arithmetic is for integers')
    END
  END ;
  (* the concrete side wins over a literal *)
  IF Text.Eq (lt, rt) THEN RETURN lt END ;
  IF LEN (lt) = 0 OR LEN (rt) = 0 THEN RETURN '' END ;
  IF Text.Eq (lt, '<int>') OR Text.Eq (lt, '<real>') THEN RETURN rt END ;
  IF Text.Eq (rt, '<int>') OR Text.Eq (rt, '<real>') THEN RETURN lt END ;
  RETURN ''
END BinType ;

(* is a BARE name one the checker knows -- in scope (any mode,
   including a nil-typed IS SOME binder), a local/impl CONST, a
   def-module CONST across the pair, a predeclared identifier, a
   builtin or user type name, or a module?  If none of these it is
   undefined, not merely unknown-typed: softness excuses a type the
   checker cannot COMPUTE, not a name that does not EXIST. *)
PROCEDURE BareNameKnown (RO nm: STR) : BOOL =
VAR
  mi, j : I64 ;
  found : BOOL ;
  cty : STR ;
BEGIN
  IF LEN (ScopeMode (nm)) > 0 THEN RETURN TRUE END ;
  found := FALSE ;
  cty := ConstType (nm, found) ;
  IF found THEN RETURN TRUE END ;
  IF Text.Eq (nm, 'ALL') OR Text.Eq (nm, 'HEAP') THEN RETURN TRUE END ;
  IF IsBuiltinTy (nm) THEN RETURN TRUE END ;
  IF FindMod (nm) >= 0 THEN RETURN TRUE END ;
  FOR mi := 0 TO nmods - 1 DO
    IF FindTypeIn (mi, nm) IS SOME tt THEN RETURN TRUE END ;
    FOR j := 0 TO mods[mi].ncns - 1 DO
      IF Text.Eq (mods[mi].cnNames[j], nm) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END BareNameKnown ;

(* a designator with at most one field selector as the qualident it
   spells, for the type position of a NEW; NONE for anything else *)
PROCEDURE AsQual (k: Ast.Kid) : Ast.Kid =
VAR q : PTR Ast.Node IN pool ;
BEGIN
  IF k IS SOME d THEN
    IF d.kind # Ast.NQualident AND d.kind # Ast.NDesignator THEN
      RETURN NONE
    END ;
    IF d.nkids > 1 THEN RETURN NONE END ;
    (* a fresh node with its names COPIED, so nothing of the borrowed
       tree is retained through the answer *)
    q := Ast.NewNode (pool, Ast.NQualident, d.line, d.col) ;
    q.a := Text.Keep (pool, d.a) ;
    q.b := Text.Keep (pool, d.b) ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind # Ast.NSelField THEN RETURN NONE END ;
        q.b := Text.Keep (pool, sel.a)
      END
    END ;
    RETURN SOME (q)
  END ;
  RETURN NONE
END AsQual ;

(* The four spellings of NEW, told apart by NAME (par 10, item 6):

     NEW (T)             the frame, one T          (par 4.3)
     NEW (T, n ...)      the frame, a slice or a grid
     NEW (pool, T ...)   the named pool, as it always was
     NEW (OWN, T)        one owned T: DISPOSE, SHARED, THREAD (par 4.2)

   Answers 'frame', 'pool' or 'own', or '' after diagnosing.  ty is
   the type's node and ext0 the index of the first extent, whose kid
   is NONE when there is none.  A first argument that is a variable
   in scope, HEAP, or a designator with selectors is a pool; a bare
   name that is not a variable, or Module.Name where Module is a
   module, is a type (docs/pool-elision-plan.md, rule 1). *)
PROCEDURE NewForm (e: PTR Ast.Node ; RO ctx: STR ; VAR ty: Ast.Kid ;
                   VAR ext0: I64) : STR =
VAR
  t : STR ;
  isVar : BOOL ;
BEGIN
  ty := NONE ;
  ext0 := 2 ;
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 AND Text.Eq (d.a, 'OWN') THEN
      ty := e.kids[1] ;
      IF e.kids[2] IS SOME x THEN
        ErrN (e, ctx, 'NEW (OWN, T) allocates one object; a slice lives in a pool or in the frame') ;
        RETURN ''
      END ;
      RETURN 'own'
    END ;
    isVar := TRUE ;
    IF d.nkids = 0 THEN
      IF ScopeFind (d.a) < 0 AND NOT Text.Eq (d.a, 'HEAP') THEN
        isVar := FALSE
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF ScopeFind (d.a) < 0 AND FindMod (d.a) >= 0 THEN
            isVar := FALSE
          END
        END
      END
    END ;
    IF isVar AND d.nkids = 0 THEN
      IF Text.Eq (ScopeMode (d.a), ModeVar) AND PtrParamTy (ScopeType (d.a)) THEN
        (* `NEW (d, T)`: the pool d's object lives in, carried in by
           rule 2 -- how a VAR pointer parameter grows its object *)
        ty := AsQual (e.kids[1]) ;
        IF ty IS SOME q0 THEN RETURN 'pool' END ;
        ErrN (e, ctx, 'NEW needs a type name after the pool') ;
        RETURN ''
      END
    END ;
    IF isVar THEN
      t := ExprType (e.kids[0], ctx) ;
      IF LEN (t) > 0 AND NOT Text.Eq (t, 'POOL') THEN
        ErrN (e, ctx, Cat ("NEW's first argument is the pool, not ",
          TyName (t))) ;
        RETURN ''
      END ;
      ty := AsQual (e.kids[1]) ;
      IF ty IS SOME q THEN RETURN 'pool' END ;
      ErrN (e, ctx, 'NEW needs a type name after the pool') ;
      RETURN ''
    END ;
    (* a type name, so the frame form with extents *)
    ty := AsQual (e.kids[0]) ;
    IF ty IS SOME q2 THEN
      IF LEN (CanonT (SOME (q2), 0)) = 0 THEN
        t := ExprType (e.kids[0], ctx) ;   (* says `unknown name` *)
        RETURN ''
      END
    END ;
    ext0 := 1 ;
    RETURN 'frame'
  END ;
  ty := e.kids[1] ;
  RETURN 'frame'
END NewForm ;

PROCEDURE ExprType (k: Ast.Kid ; RO ctx: STR) : STR =
VAR
  t, u, form : STR ;
  j, ext0, nx : I64 ;
  res, tyk : Ast.Kid ;
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NInt : RETURN '<int>'
    | Ast.NReal : RETURN '<real>'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString :
        IF LEN (e.a) = 1 THEN RETURN '<str1>' END ;
        RETURN 'SLICE OF CHAR'
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NNoneLit : RETURN '<none>'
    | Ast.NParen : RETURN ExprType (e.kids[0], ctx)
    | Ast.NSomeExpr :
        t := ExprType (e.kids[0], ctx) ;
        IF LEN (t) > 0 AND NOT Text.Eq (t, '<void>') THEN
          RETURN Cat ('OPT ', t)
        END ;
        RETURN ''
    | Ast.NSharedExpr :
        t := ExprType (e.kids[0], ctx) ;
        (* SHARED consumes the owned pointer it wraps (par 4.2) *)
        IF e.kids[0] IS SOME inr THEN
          IF inr.kind = Ast.NDesignator THEN
            IF inr.nkids = 0 AND Text.StartsWith (t, 'PTR ') THEN
              u := ScopeMode (inr.a) ;
              IF Text.Eq (u, ModeVal) OR Text.Eq (u, ModeVar) OR
                 Text.Eq (u, ModeBinder) OR Text.Eq (u, ModeRo) THEN
                ErrN (e, ctx, S3 ('SHARED consumes an owned pointer; ',
                  inr.a, ' is a borrow (par 4.2)'))
              ELSIF FvalHas (inr.a) THEN
                (* a frame allocation has no rc header and dies with
                   the frame: only NEW (OWN, T) can become SHARED *)
                ErrN (e, ctx, S3 ('SHARED needs an OWN allocation; ',
                  inr.a, ' lives in the frame (par 4.2)'))
              ELSE
                IF OwnedCandKind (inr.a) = 1 THEN
                  OwnMark (inr.a, 'consumed by SHARED', e)
                END
              END
            END
          END
        END ;
        IF Text.StartsWith (t, 'PTR ') THEN RETURN Cat ('SHARED ', t) END ;
        RETURN ''
    | Ast.NNewExpr :
        (* THE SHAPE: pool FIRST, then the type.  `NEW (Point, pool)`
           used to type-check in silence -- the pool position holds a
           name that is not a value, so it types as unknown, and
           unknown never diagnoses -- and only the GENERATOR objected,
           with `unknown name: Point`.  A tutorial reader followed
           chapter 4's own example into exactly this (2026-08-29).
           A checker softer than the generator is a checker that
           misses; the second argument BEING a pool is conclusive. *)
        form := NewForm (e, ctx, tyk, ext0) ;
        IF LEN (form) = 0 THEN RETURN '' END ;
        IF Text.Eq (form, 'pool') THEN
          (* par 3.2: allocating from a pool the CALLER owns consumes
             the caller's storage and answers a slice into the
             caller's arena -- an effect, and the one a PURE body
             could still have, since NEW is a builtin (rule 3 does not
             see it) and not an assignment target (rules 1 and 2 do
             not either).  A pool declared LOCAL is invisible outside
             the frame and stays legal, and so is the frame itself,
             so the test is the pool's binding MODE. *)
          IF curPure THEN
            IF e.kids[0] IS SOME pn THEN
              IF pn.kind = Ast.NDesignator THEN
                IF Text.Eq (ScopeMode (pn.a), ModeVar) OR
                   Text.Eq (ScopeMode (pn.a), ModeOwn) OR
                   Text.Eq (ScopeMode (pn.a), ModeModule) THEN
                  ErrN (e, ctx, Cat (Cat ('cannot allocate from the pool ',
                    pn.a), ' in a PURE procedure (par 3.2)'))
                END
              END
            END
          END
        END ;
        IF Text.Eq (form, 'frame') THEN
          (* `NEW (Point, pool)`, the reversed spelling: it reads as
             the frame form with a pool for an extent, so name what
             was meant.  A tutorial reader followed chapter 4's own
             example into exactly this (2026-08-29). *)
          FOR j := ext0 TO e.nkids - 1 DO
            IF e.kids[j] IS SOME xn THEN
              IF xn.kind = Ast.NDesignator AND xn.nkids = 0 THEN
                IF ScopeType (xn.a) IS SOME ptn THEN
                  IF ptn.kind = Ast.NQualident THEN
                    IF DynStr.Eq (ptn.a, 'POOL') THEN
                      ErrN (e, ctx, 'NEW takes the pool first, then the type') ;
                      RETURN ''
                    END
                  END
                END
              END
            END
          END
        END ;
        t := CanonT (tyk, 0) ;
        nx := 0 ;
        FOR j := ext0 TO e.nkids - 1 DO
          IF e.kids[j] IS SOME cnt THEN
            nx := nx + 1 ;
            u := ExprType (e.kids[j], ctx) ;
            IF NOT IsIntish (u) THEN
              ErrN (e, ctx, Cat ('NEW extent must be an integer, not ',
                TyName (u)))
            END
          END
        END ;
        (* one extent is a slice; more than one is a GRID, and the
           arity states the rank so the two cannot disagree *)
        IF nx = 1 THEN
          IF LEN (t) > 0 THEN RETURN Cat ('SLICE OF ', t) END ;
          RETURN ''
        END ;
        IF nx > 1 THEN RETURN GridOf (nx, t) END ;
        IF LEN (t) > 0 THEN RETURN Cat ('PTR ', t) END ;
        RETURN ''
    | Ast.NSliceOf3 :
        t := ExprType (e.kids[0], ctx) ;
        u := ExprType (e.kids[1], ctx) ;
        IF NOT IsIntish (u) THEN
          ErrN (e, ctx, Cat ('SLICE start must be an integer, not ',
            TyName (u)))
        END ;
        u := ExprType (e.kids[2], ctx) ;
        IF NOT IsIntish (u) THEN
          ErrN (e, ctx, Cat ('SLICE length must be an integer, not ',
            TyName (u)))
        END ;
        IF Text.StartsWith (t, 'SLICE OF ') THEN RETURN t END ;
        IF Text.StartsWith (t, 'ARRAY ') THEN
          RETURN Cat ('SLICE OF ', AfterOf (t))
        END ;
        IF LEN (t) > 0 THEN
          ErrN (e, ctx, Cat ('SLICE needs a slice or array, not ',
            TyName (t)))
        END ;
        RETURN ''
    | Ast.NIs :
        (* the IS operand is the guard itself: the final OPT is
           legal, and SOME binds its payload *)
        IF e.kids[0] IS SOME o THEN
          IF o.kind = Ast.NDesignator THEN
            res := DesigDeclType (o, ctx) ;
            IF e.kids[1] IS SOME b THEN
              IF b.kind = Ast.NIsSome THEN
                t := CanonT (res, 0) ;
                res := ResolveType (res) ;
                IF res IS SOME rr THEN
                  IF rr.kind = Ast.NOptType THEN
                    BindName (b.a, rr.kids[0])
                  ELSE
                    IF LEN (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                      ErrN (e, ctx, 'IS SOME needs an OPT operand')
                    END ;
                    BindName (b.a, NONE)
                  END
                ELSE
                  IF LEN (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                    ErrN (e, ctx, 'IS SOME needs an OPT operand')
                  END ;
                  BindName (b.a, NONE)
                END ;
                (* par 4.1 direction: the binder is a VIEW of the
                   operand -- storing into the binder stores into the
                   operand's storage, so the binder inherits the
                   operand's reach (dst = operand, src = binder) --
                   and, provenance, the binder CARRIES the operand *)
                EscStore (o.a, TRUE, b.a) ;
                CarryFrom (b.a, o.a)
              END
            END
          ELSE
            t := ExprType (e.kids[0], ctx) ;
            IF e.kids[1] IS SOME b2 THEN
              IF b2.kind = Ast.NIsSome THEN
                res := NONE ;
                (* a CALL's result: the binder takes the callee's
                   declared payload type, made self-contained in the
                   callee's module, so an argument made of the binder
                   is checked like any other.  Before 2026-09-06 it
                   was bound untyped, passed by softness, and gcc
                   objected. *)
                IF o.kind = Ast.NCallExpr THEN
                  IF o.kids[0] IS SOME cd THEN
                    pr := LookupProc (DesigName (cd), found) ;
                    IF found THEN
                      IF pr.node IS SOME pn THEN
                        IF pn.nkids > 1 THEN
                          IF pn.kids[1] IS SOME rt0 THEN
                            canonCtx := pr.modName ;
                            res := ResolveType (SOME (rt0)) ;
                            canonCtx := '' ;
                            IF res IS SOME rr THEN
                              IF rr.kind = Ast.NOptType THEN
                                res := QualifiedIn (rr.kids[0], pr.modName)
                              ELSE
                                res := NONE
                              END
                            END
                          END
                        END
                      END
                    END
                  END
                END ;
                IF LEN (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                  ErrN (e, ctx, 'IS SOME needs an OPT operand')
                END ;
                BindName (b2.a, res)
              END
            END
          END
        END ;
        RETURN 'BOOL'
    | Ast.NUn :
        t := ExprType (e.kids[0], ctx) ;
        IF Text.Eq (e.a, 'NOT') THEN
          IF LEN (t) > 0 AND NOT Text.Eq (t, 'BOOL') THEN
            ErrN (e, ctx, Cat ('NOT needs a BOOL operand, not ',
              TyName (t)))
          END ;
          RETURN 'BOOL'
        END ;
        IF NOT NumSide (t) THEN
          ErrN (e, ctx, S4 ('unary ', e.a,
            ' needs a numeric operand, not ', TyName (t)))
        END ;
        RETURN t
    | Ast.NBin : RETURN BinType (e, ctx)
    | Ast.NDesignator :
        NoteUse (e, ctx) ;
        (* a top-level M9 procedure named as a VALUE has its head's
           type (par 2.2.3) -- Up, or Mod.Up; a scope name shadows it
           as it shadows anything.  A foreign procedure is a C symbol
           with another ABI and no value at all. *)
        IF (e.nkids = 0 OR (e.nkids = 1 AND FindMod (e.a) >= 0)) AND
           ScopeFind (e.a) < 0 THEN
          pr := LookupProc (DesigName (e), found) ;
          IF found THEN
            IF pr.node IS SOME pn THEN
              IF LEN (pr.foreign) > 0 THEN
                ErrN (e, ctx, S3 ('a foreign procedure is not a value: ',
                  DesigName (e), ' (par 2.2.3)')) ;
                RETURN ''
              END ;
              canonCtx := pr.modName ;
              t := ProcSig (pn.kids[0], pn.kids[1], pn.f3, pn.kids[2], 0) ;
              canonCtx := '' ;
              RETURN t
            END
          END
        END ;
        (* a bare value name known to NO part of the checker's name
           universe is undefined -- the symmetric twin of the
           unknown-procedure check.  Only here (a body-walk value
           context, scope populated), never in DesigStrType, which
           the signature checks also reach without a scope. *)
        IF e.nkids = 0 AND NOT BareNameKnown (e.a) THEN
          ErrN (e, ctx, Cat ('unknown name: ', e.a))
        END ;
        RETURN DesigStrType (e, FALSE, ctx)
    | Ast.NCallExpr : RETURN CallType (e.kids[0], e.kids[1], e, ctx)
    ELSE
      FOR j := 0 TO e.nkids - 1 DO
        t := ExprType (e.kids[j], ctx)
      END ;
      RETURN ''
    END
  END ;
  RETURN ''
END ExprType ;

(* the oracle OVERWRITES an existing binding in place -- a name
   rebound arm by arm (CASE over Frame's column variants rebinds v
   per arm) must answer the LATEST type, and appending would leave
   the first arm's shadowing every later one, since lookup answers
   the first hit.  An existing entry keeps its mode, as the oracle's
   does. *)
PROCEDURE BindName (RO KEPT nm: STR ; KEPT t: Ast.Kid) =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN ScopeAdd (nm, t, ModeBinder)
  ELSE scope[i].ty := t END
END BindName ;

(* a type node from module MODNAME made self-contained: its bare type
   names qualified, so canonicalising it later -- from whichever module
   the binder is used in -- resolves them where they were declared
   (the canonCtx lesson, applied to binders).  Pool and attribute
   components are dropped, neither being part of type identity. *)
PROCEDURE QualifiedIn (KEPT t: Ast.Kid ; RO KEPT modName: STR) : Ast.Kid =
VAR n : PTR Ast.Node IN pool ;
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident THEN
      IF LEN (tn.b) = 0 AND NOT IsBuiltinTy (tn.a) AND
         NOT Text.Eq (tn.a, 'STR') THEN
        n := Ast.NewNode (pool, Ast.NQualident, tn.line, tn.col) ;
        n.a := modName ;
        n.b := tn.a ;
        RETURN SOME (n)
      END
    ELSIF tn.kind = Ast.NPtrType OR tn.kind = Ast.NOptType OR
          tn.kind = Ast.NSharedType OR tn.kind = Ast.NSliceType THEN
      n := Ast.NewNode (pool, tn.kind, tn.line, tn.col) ;
      IF tn.nkids > 0 THEN
        Ast.Add (pool, n, QualifiedIn (tn.kids[0], modName))
      END ;
      Ast.Add (pool, n, NONE) ;
      RETURN SOME (n)
    ELSIF (tn.kind = Ast.NArrayType OR tn.kind = Ast.NGridType) AND
          tn.nkids >= 2 THEN
      (* the bound or the rank as written, the element qualified: an
         exported ARRAY 3 OF Fr (decision 28) *)
      n := Ast.NewNode (pool, tn.kind, tn.line, tn.col) ;
      Ast.Add (pool, n, tn.kids[0]) ;
      Ast.Add (pool, n, QualifiedIn (tn.kids[1], modName)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN t
END QualifiedIn ;

(* which module owns variant V of CASE RECORD type T, and the field
   sequence that variant carries *)
PROCEDURE TryVariantMod (m: I64 ; RO tyName: STR ; RO vName: STR ;
                         VAR owner: STR ; VAR fields: Ast.Kid) : BOOL =
VAR j, v : I64 ;
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  FOR j := 0 TO mods[m].nvts - 1 DO
    IF Text.Eq (mods[m].vts[j].typeName, tyName) THEN
      FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
        IF Text.Eq (mods[m].vts[j].variants[v], vName) THEN
          owner := mods[m].name ;
          fields := mods[m].vts[j].fields[v] ;
          RETURN TRUE
        END
      END
    END
  END ;
  RETURN FALSE
END TryVariantMod ;

(* A bare Value.Null resolves in its OWN module first: Json and Dict
   both declare a variant type named Value, and load order must not
   decide which one a constructor means -- the same rule CanonQual
   already applies to bare type names. *)
PROCEDURE FindVariant (RO tyName: STR ; RO vName: STR ;
                       VAR owner: STR ; VAR fields: Ast.Kid) : BOOL =
VAR m : I64 ;
BEGIN
  owner := '' ;
  fields := NONE ;
  IF LEN (canonCtx) > 0 THEN
    IF TryVariantMod (FindMod (canonCtx), tyName, vName, owner, fields) THEN
      RETURN TRUE
    END
  ELSE
    IF TryVariantMod (FindMod (curMod), tyName, vName, owner, fields) THEN
      RETURN TRUE
    END
  END ;
  FOR m := 0 TO nmods - 1 DO
    IF TryVariantMod (m, tyName, vName, owner, fields) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END FindVariant ;

PROCEDURE VariantOwnerOf (RO tyName: STR ; RO vName: STR ;
                          VAR found: BOOL) : STR =
VAR
  owner : STR ;
  fields : Ast.Kid ;
BEGIN
  found := FindVariant (tyName, vName, owner, fields) ;
  RETURN owner
END VariantOwnerOf ;

PROCEDURE CountParams (pl: Ast.Kid) : I64 =
VAR n, g : I64 ;
BEGIN
  n := 0 ;
  IF pl IS SOME p THEN
    FOR g := 0 TO p.nkids - 1 DO
      IF p.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN n := n + ids.nkids END
      END
    END
  END ;
  RETURN n
END CountParams ;

PROCEDURE BaseIsPtr (d: PTR Ast.Node) : BOOL =
BEGIN
  IF ResolveType (ScopeType (d.a)) IS SOME r THEN
    RETURN r.kind = Ast.NPtrType
  END ;
  RETURN FALSE
END BaseIsPtr ;

(* can a value of this type carry a pointer?  Gen.HasPtr's twin: a
   pointer, a slice, a grid, and any record, array or variant holding
   one, through OPT and through a type name. *)
PROCEDURE PtrBearing (t: Ast.Kid ; depth: I64) : BOOL =
VAR
  i, j : I64 ;
  fsk : Ast.Kid ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF ResolveType (t) IS SOME r THEN
    CASE r.kind OF
    | Ast.NPtrType, Ast.NSliceType, Ast.NGridType : RETURN TRUE
    | Ast.NOptType : RETURN PtrBearing (r.kids[0], depth + 1)
    | Ast.NArrayType : RETURN PtrBearing (r.kids[1], depth + 1)
    | Ast.NRecordType, Ast.NMonitorType :
        IF r.kind = Ast.NMonitorType THEN fsk := r.kids[0]
        ELSE fsk := r.kids[1] END ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF PtrBearing (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME arm THEN
            IF arm.kids[0] IS SOME afs THEN
              FOR j := 0 TO afs.nkids - 1 DO
                IF afs.kids[j] IS SOME ag THEN
                  IF PtrBearing (ag.kids[1], depth + 1) THEN RETURN TRUE END
                END
              END
            END
          END
        END ;
        RETURN FALSE
    ELSE
      RETURN FALSE
    END
  END ;
  RETURN FALSE
END PtrBearing ;

(* does a VAR parameter of this type carry its object's pool as a
   hidden argument (docs/pool-elision-plan.md, rule 2)?  Written as
   `PTR T` or `OPT PTR T`: yes, by node kind and no lookup.  A record,
   monitor, array or variant that can hold a pointer: yes, since a
   component of it may be handed on.  A bare slice, grid or string:
   no -- those are output slots, re-homed or adopted at exit.  Both
   compilers must answer this identically, and gendiff holds them
   to it. *)
PROCEDURE PtrParamTy (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME n THEN
    IF n.kind = Ast.NPtrType THEN RETURN TRUE END ;
    IF n.kind = Ast.NOptType THEN
      IF n.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
      RETURN FALSE
    END ;
    IF n.kind = Ast.NSliceType OR n.kind = Ast.NGridType THEN RETURN FALSE END ;
    IF ResolveType (t) IS SOME r THEN
      (* a name for a pointer -- `SinkP = PTR Zarr.Sink`, `Ast.Kid =
         OPT PTR Node` -- is the pointer it names (the proxy's P9) *)
      IF r.kind = Ast.NPtrType THEN RETURN TRUE END ;
      IF r.kind = Ast.NOptType THEN
        IF r.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
        RETURN FALSE
      END ;
      IF r.kind = Ast.NRecordType OR r.kind = Ast.NMonitorType OR
         r.kind = Ast.NArrayType OR r.kind = Ast.NCaseRecordType THEN
        RETURN PtrBearing (t, 0)
      END
    END
  END ;
  RETURN FALSE
END PtrParamTy ;

(* the pool a declared type names: the IN clause of `PTR T IN p` or
   `OPT PTR T IN p`, through a type name; NONE for anything else *)
PROCEDURE DeclPool (t: Ast.Kid) : Ast.Kid =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    IF r.kind = Ast.NOptType THEN RETURN DeclPool (r.kids[0]) END ;
    IF r.kind = Ast.NPtrType THEN RETURN r.kids[1] END
  END ;
  RETURN NONE
END DeclPool ;

(* the pool of the object a designator names, as a call handing the
   object to a VAR pointer parameter needs it (rule 2): '' when the
   generator can name it from the ROOT of the designator, else why it
   cannot.  A local's pool is its IN clause or the frame; a module
   variable's is its IN clause or the module frame; a VAR parameter's
   is the hidden one it carries; a binder's is its origin's.  An OWN
   parameter's object is heap storage with no pool, a value
   parameter's is a borrow whose pool nobody named, and a VAR slice
   carries none -- those are refused.  A bare value parameter is
   refused as a lent borrow before this is asked. *)
PROCEDURE ObjPoolIssue (a: PTR Ast.Node) : STR =
VAR m : STR ;
BEGIN
  m := ScopeMode (a.a) ;
  IF Text.Eq (m, ModeVar) THEN
    IF PtrParamTy (ScopeType (a.a)) THEN RETURN '' END ;
    RETURN S3 ('VAR parameter ', a.a, ' carries no pool')
  ELSIF Text.Eq (m, ModeOwn) THEN
    RETURN Cat (a.a, ' is an OWN parameter')
  ELSIF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeRo) THEN
    IF a.nkids = 0 AND BaseIsPtr (a) THEN RETURN '' END ;
    RETURN Cat (a.a, ' is a value parameter')
  END ;
  RETURN ''
END ObjPoolIssue ;

(* the flattened field types of a variant: one entry per binder *)
PROCEDURE FlatFields (KEPT fields: Ast.Kid ; VAR n: I64) : SLICE OF AKid =
VAR
  out : SLICE OF AKid ;
  g, j : I64 ;
BEGIN
  (* counted first: a record aggregate has as many fields as its
     record, where a variant's payload had never exceeded 16 *)
  n := 0 ;
  IF fields IS SOME fc THEN
    FOR g := 0 TO fc.nkids - 1 DO
      IF fc.kids[g] IS SOME gc THEN
        IF gc.kids[0] IS SOME idc THEN n := n + idc.nkids END
      END
    END
  END ;
  out := NEW (pool, AKid, n + 1) ;
  n := 0 ;
  IF fields IS SOME fs THEN
    FOR g := 0 TO fs.nkids - 1 DO
      IF fs.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF n < LEN (out) THEN
              out[n] := grp.kids[1] ;
              n := n + 1
            END
          END
        END
      END
    END
  END ;
  RETURN out
END FlatFields ;

PROCEDURE Arity (site: PTR Ast.Node ; RO ctx: STR ; RO name: STR ;
                 want: I64 ; got: I64) =
BEGIN
  IF want # got THEN
    ErrN (site, ctx, S5 (name, ' expects ', ItoA (want),
      ' argument(s), got ', ItoA (got)))
  END
END Arity ;

PROCEDURE IsTotalWideningTo64 (RO t: STR) : BOOL =
BEGIN
  IF Text.Eq (t, 'C.Int') OR Text.Eq (t, 'C.SSizeT') THEN RETURN TRUE END ;
  IF Text.Eq (t, 'BYTE') THEN RETURN TRUE END ;
  IF Text.Eq (t, 'I8') OR Text.Eq (t, 'I16') OR Text.Eq (t, 'I32') THEN
    RETURN TRUE
  END ;
  RETURN Text.Eq (t, 'U8') OR Text.Eq (t, 'U16') OR Text.Eq (t, 'U32')
END IsTotalWideningTo64 ;

(* a conversion FROM an integer TO an enumeration (or a payload-less
   case record), the checked inverse of ORD: Colour (i) is the i-th
   member, and RAISES ValueRange when i is out of 0..n-1 -- the same
   discipline as I64 (x), because a tag that named no member would be
   the museum's Trunc(NaN) again.  Answers the canonical type name, or
   '' when `name' is not such a type. *)
PROCEDURE AllPayloadless (n: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF n IS SOME t THEN
    IF t.kind = Ast.NEnumType THEN RETURN TRUE END ;
    IF t.kind = Ast.NCaseRecordType THEN
      FOR i := 0 TO t.nkids - 1 DO
        IF t.kids[i] IS SOME v THEN
          IF v.kids[0] IS SOME vf THEN RETURN FALSE END
        END
      END ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END AllPayloadless ;

(* a value two of which no single operator compares: a slice, an
   array, a grid, a record, a monitor, a case record that carries a
   payload -- what the C has no == for *)
PROCEDURE IsComposite (RO t: STR) : BOOL =
VAR
  dot : I64 ;
  md, ty : STR ;
  k : Ast.Kid ;
BEGIN
  IF Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'ARRAY ') OR
     Text.StartsWith (t, 'GRID ') THEN
    RETURN TRUE
  END ;
  dot := Text.FindChar (t, '.') ;
  IF dot >= 0 THEN
    md := SLICE (t, 0, dot) ;
    ty := SLICE (t, dot + 1, LEN (t) - dot - 1)
  ELSE
    md := '' ; ty := t
  END ;
  k := LookupTypeName (md, ty) ;
  IF k IS SOME n THEN
    IF n.kind = Ast.NRecordType OR n.kind = Ast.NMonitorType THEN
      RETURN TRUE
    END ;
    IF n.kind = Ast.NCaseRecordType THEN RETURN NOT AllPayloadless (k) END
  END ;
  RETURN FALSE
END IsComposite ;

PROCEDURE IsTagged (RO canon: STR) : BOOL =
  (* the canonical name (Mod.Type) resolves to an enumeration or a
     case record -- a value CASE reaches by tag, which is exactly what
     NAME can name (docs/enum-plan.md, part 2) *)
VAR dot : I64 ;
BEGIN
  dot := Text.FindChar (canon, '.') ;
  IF dot < 0 THEN RETURN FALSE END ;
  IF LookupTypeName (SLICE (canon, 0, dot),
                     SLICE (canon, dot + 1, LEN (canon) - dot - 1))
       IS SOME t THEN
    RETURN t.kind = Ast.NEnumType OR t.kind = Ast.NCaseRecordType
  END ;
  RETURN FALSE
END IsTagged ;

(* the canonical enumeration (or case-record) type an ARRAY bound
   names, or '' when the bound is an integer.  ARRAY Colour OF T is
   indexed by the type: its subscript is a member, not an ordinal, so
   the index check wants the enumeration here (docs/enum-plan.md,
   part 2). *)
PROCEDURE ArrEnumBoundOf (declN: Ast.Kid) : STR =
VAR canon : STR ;
BEGIN
  IF ResolveType (declN) IS SOME r THEN
    IF r.kind = Ast.NArrayType THEN
      IF r.kids[0] IS SOME b THEN
        IF b.kind = Ast.NDesignator THEN
          canon := '' ;
          IF b.nkids = 0 THEN canon := CanonQual ('', b.a, 0)
          ELSIF b.nkids = 1 THEN
            IF b.kids[0] IS SOME sf THEN
              IF sf.kind = Ast.NSelField THEN canon := CanonQual (b.a, sf.a, 0)
              END
            END
          END ;
          IF IsTagged (canon) THEN RETURN canon END
        END
      END
    END
  END ;
  RETURN ''
END ArrEnumBoundOf ;

PROCEDURE EnumConvType (RO name: STR) : STR =
VAR
  dot : I64 ;
  md, ty : STR ;
BEGIN
  dot := Text.FindChar (name, '.') ;
  IF dot >= 0 THEN
    md := SLICE (name, 0, dot) ;
    ty := SLICE (name, dot + 1, LEN (name) - dot - 1)
  ELSE
    md := '' ; ty := name
  END ;
  IF AllPayloadless (LookupTypeName (md, ty)) THEN
    RETURN CanonQual (md, ty, 0)
  END ;
  RETURN ''
END EnumConvType ;

(* what follows a name's first dot, or the name *)
PROCEDURE LastPart (RO name: STR) : STR =
VAR dot : I64 ;
BEGIN
  dot := Text.FindChar (name, '.') ;
  IF dot < 0 THEN RETURN name END ;
  RETURN SLICE (name, dot + 1, LEN (name) - dot - 1)
END LastPart ;

(* the RECORD a callee names -- `Row' declared in this module, or
   `Mod.Row' in an imported one -- through aliases, or NONE; om the
   module that WROTE it (canonCtx) *)
PROCEDURE RecordNamed (RO name: STR ; VAR om: STR ; VAR canon: STR) : Ast.Kid =
VAR
  dot, m : I64 ;
  t : Ast.Kid ;
BEGIN
  canon := '' ;
  dot := Text.FindChar (name, '.') ;
  IF dot > 0 THEN
    om := SLICE (name, 0, dot) ;
    m := FindMod (om) ;
    IF m < 0 THEN RETURN NONE END ;
    t := FindTypeIn (m, SLICE (name, dot + 1, LEN (name) - dot - 1))
  ELSE
    om := curMod ;
    m := FindMod (curMod) ;
    IF m < 0 THEN RETURN NONE END ;
    t := FindTypeIn (m, name)
  END ;
  IF ResolveType (t) IS SOME r THEN
    IF r.kind = Ast.NRecordType THEN
      (* the type's canonical name: its own, or through an alias the
         record's -- what a variable declared with it is typed *)
      canon := Qualify (om, LastPart (name)) ;
      IF t IS SOME tn THEN
        IF tn.kind = Ast.NQualident THEN
          canonCtx := Text.Keep (pool, om) ;
          canon := CanonT (t, 0) ;
          canonCtx := ''
        END
      END ;
      RETURN SOME (r)
    END
  END ;
  RETURN NONE
END RecordNamed ;

PROCEDURE CallType (dn: Ast.Kid ; KEPT argl: Ast.Kid ; site: PTR Ast.Node ;
                    RO ctx: STR) : STR =
VAR
  name, pTy, amode, om, t : STR ;
  nargs, j, g, k, kept, rank, dot, nflat, si, nFrameKept : I64 ;
  aTy : SLICE OF STR ;
  aNode : SLICE OF AKid ;
  flat : SLICE OF AKid ;
  pr : ProcInfo ;
  found, isVar : BOOL ;
  fields : Ast.Kid ;
BEGIN
  name := '' ;
  IF dn IS SOME d0 THEN name := DesigName (d0) ELSE RETURN '' END ;
  nargs := 0 ;
  IF argl IS SOME al0 THEN nargs := al0.nkids END ;
  aTy := NEW (pool, STR, nargs + 1) ;
  aNode := NEW (pool, AKid, nargs + 1) ;
  IF argl IS SOME al1 THEN
    FOR j := 0 TO nargs - 1 DO
      aNode[j] := al1.kids[j] ;
      aTy[j] := ExprType (al1.kids[j], ctx)
    END
  END ;

  IF nargs = 1 THEN name := ScalarAlias (name) END ;
  IF nargs >= 1 THEN
    g := 0 ;
    k := 0 ;
    FOR j := 0 TO nargs - 1 DO
      IF Text.Eq (aTy[j], 'F32') THEN g := g + 1 END ;
      IF Text.Eq (aTy[j], 'F64') THEN k := k + 1 END
    END ;
    name := WidthTwin (name, g > 0 AND k = 0)
  END ;
  IF IsConvVR (name) THEN
    (* I64 of a NARROWER integer is TOTAL and must not be made to
       declare a ValueRange nobody can trigger *)
    IF Text.Eq (name, 'I64') AND nargs = 1 THEN
      IF IsTotalWideningTo64 (aTy[0]) THEN
        Arity (site, ctx, name, 1, nargs) ;
        RETURN 'I64'
      END
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    IF Text.Eq (name, 'CHR') THEN RETURN 'CHAR' END ;
    RETURN name
  END ;
  IF Text.Eq (name, 'ADR') THEN
    IF NOT curUnsafe THEN
      ErrN (site, ctx, 'ADR exists only inside UNSAFE modules')
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    RETURN ''
  END ;
  IF Text.Eq (name, 'F32') OR Text.Eq (name, 'F64') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN name
  END ;
  IF Text.Eq (name, 'LEN') THEN
    IF nargs = 2 THEN
      IF GridRank (aTy[0]) = 0 THEN
        ErrN (site, ctx, Cat ('LEN takes an axis only on a GRID, not on ',
          TyName (aTy[0])))
      END ;
      IF NOT IsIntish (aTy[1]) THEN
        ErrN (site, ctx, Cat ('LEN axis must be an integer, not ',
          TyName (aTy[1])))
      END ;
      IF GridRank (aTy[0]) > 0 THEN
        IF aNode[1] IS SOME an1 THEN
          IF an1.kind = Ast.NInt THEN
            IF AtoI (an1.a) >= GridRank (aTy[0]) THEN
              ErrN (site, ctx, S4 ('axis ', an1.a, ' of a ',
                Cat (aTy[0], ' does not exist')))
            END
          END
        END
      END ;
      RETURN 'I64'
    END ;
    IF GridRank (aTy[0]) > 0 THEN
      ErrN (site, ctx, 'LEN of a GRID needs an axis: LEN (g, 0)')
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'ORD') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'NAME') THEN
    (* the identifier text of an enumeration member (or any
       payload-less case record variant), as a STR: NAME (Colour.Red)
       is 'Red'.  The argument must be one of those types -- its
       canonical form is nominal, and a value that CASE reaches by
       tag is exactly what has a name (docs/enum-plan.md, part 2) *)
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 AND NOT IsTagged (aTy[0]) THEN
      IF LEN (aTy[0]) > 0 THEN
        ErrN (site, ctx, Cat ('NAME needs an enumeration or a case '
          + 'record, not ', TyName (aTy[0])))
      END
    END ;
    RETURN 'SLICE OF CHAR'
  END ;
  IF Text.Eq (name, 'VIEW') THEN
    IF nargs < 2 THEN
      ErrN (site, ctx, 'VIEW needs a grid and one argument per axis') ;
      RETURN ''
    END ;
    rank := GridRank (aTy[0]) ;
    IF rank = 0 THEN
      IF LEN (aTy[0]) > 0 THEN
        ErrN (site, ctx, Cat ('VIEW needs a GRID, not ', TyName (aTy[0])))
      END ;
      RETURN ''
    END ;
    IF nargs - 1 # rank THEN
      ErrN (site, ctx, S5 ('a ', aTy[0], ' needs ', ItoA (rank),
        Cat (' axis arguments, not ', ItoA (nargs - 1)))) ;
      RETURN ''
    END ;
    kept := 0 ;
    FOR j := 1 TO nargs - 1 DO
      IF Text.Eq (aTy[j], '<all>') THEN
        kept := kept + 1
      ELSE
        IF NOT IsIntish (aTy[j]) THEN
          ErrN (site, ctx, Cat ('a VIEW axis is an index or ALL, not ',
            TyName (aTy[j])))
        END
      END
    END ;
    IF kept = 0 THEN
      ErrN (site, ctx,
        'a VIEW that keeps no axis is an index: write the subscripts') ;
      RETURN ''
    END ;
    RETURN GridOf (kept, AfterOf (aTy[0]))
  END ;
  IF Text.Eq (name, 'MAX') THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 THEN
      IF aNode[0] IS SOME a0 THEN
        IF a0.kind = Ast.NDesignator THEN
          IF a0.nkids = 0 THEN
            IF IsBuiltinTy (a0.a) THEN RETURN a0.a END
          END
        END
      END
    END ;
    RETURN ''
  END ;
  (* SizeOf (x): the byte size of x's type (I64); a type name or a
     value.  A slice's SizeOf is its descriptor, the data is
     ByteSize.  In-memory only -- a wire uses the exact-width types
     and ToBytesLE. *)
  IF Text.Eq (name, 'SizeOf') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'ByteSize') THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs >= 1 AND LEN (aTy[0]) > 0 AND
       NOT Text.StartsWith (aTy[0], 'SLICE OF ') THEN
      ErrN (site, ctx, Cat ('ByteSize needs a slice, not ', TyName (aTy[0])))
    END ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'F64.FromBytesLE') OR
     Text.Eq (name, 'F32.FromBytesLE') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN SLICE (name, 0, 3)
  END ;
  IF Text.Eq (name, 'F64.ToBytesLE') OR
     Text.Eq (name, 'F32.ToBytesLE') THEN
    Arity (site, ctx, name, 2, nargs) ;
    RETURN '<void>'
  END ;
  IF Text.StartsWith (name, 'C.') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN name
  END ;

  (* a call THROUGH A PROCEDURE VALUE (par 2.2.3): a parameter or an
     IS SOME binder whose type is a procedure type.  The type's own
     head stands in for the callee's declaration and the same checks
     run over it; nothing is known about which procedure runs, so a
     PURE body may not make the call. *)
  found := FALSE ;
  si := ScopeFind (name) ;
  IF si >= 0 THEN
    IF ResolveType (scope[si].ty) IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        IF curPure THEN
          ErrN (site, ctx, S3 ('PURE procedure calls through the procedure value ',
            name, ' (par 3.2)'))
        END ;
        pr.node := SOME (ptn) ;
        pr.modName := '' ;
        pr.foreign := '' ;
        IF scope[si].ty IS SOME tq THEN
          IF tq.kind = Ast.NQualident THEN
            IF LEN (tq.b) > 0 THEN pr.modName := tq.a END
          END
        END ;
        found := TRUE
      END
    END
  END ;
  IF NOT found THEN pr := LookupProc (name, found) END ;
  IF found THEN
    IF pr.node IS SOME pn THEN
      canonCtx := pr.modName ;
      Arity (site, ctx, name, CountParams (pn.kids[0]), nargs) ;
      (* how many VAR or KEPT arguments are FRAME values: a frame value
         handed to a KEPT parameter is refused (it dies with this
         frame), unless another frame value is the keeper -- a node
         linked under a node of the same frame lives exactly as long
         as it does.  `Set (obj, name, v)` on two fresh nodes is the
         shape (docs/pool-elision-plan.md, stage 2). *)
      nFrameKept := 0 ;
      k := 0 ;
      IF pn.kids[0] IS SOME pl0 THEN
        FOR g := 0 TO pl0.nkids - 1 DO
          IF pl0.kids[g] IS SOME grp0 THEN
            IF grp0.kids[0] IS SOME ids0 THEN
              FOR j := 0 TO ids0.nkids - 1 DO
                IF k < nargs THEN
                  IF grp0.f1 OR grp0.f2 OR grp0.f4 THEN
                    IF LEN (FrameWhat (aNode[k], aTy[k])) > 0 THEN
                      nFrameKept := nFrameKept + 1
                    END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      k := 0 ;
      IF pn.kids[0] IS SOME pl THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            pTy := CanonT (grp.kids[1], 0) ;
            isVar := grp.f1 OR grp.f2 ;
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF k < nargs THEN
                  ConstArg (site, ctx, name, k, aNode[k], isVar, grp.f3) ;
                  IF NOT isVar AND NOT grp.f3 THEN
                    RoArg (site, ctx, name, k, aNode[k], pTy, aTy[k])
                  END ;
                  CheckArg (site, ctx, name, k, pTy, aTy[k], aNode[k],
                            isVar, grp.f2, grp.f4, nFrameKept,
                            grp.f1 AND PtrParamTy (grp.kids[1]) AND
                            LEN (pr.foreign) = 0, argl)
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      pTy := '' ;
      IF pn.kids[1] IS SOME rt THEN pTy := CanonT (pn.kids[1], 0) END ;
      canonCtx := '' ;
      IF LEN (pTy) > 0 THEN RETURN pTy END ;
      IF pn.kids[1] IS SOME rt2 THEN RETURN '' END ;
      RETURN '<void>'
    END ;
    RETURN ''
  END ;

  (* a variant constructor with payload: Type.Variant (args), or
     Mod.Type.Variant (args) from another module.  The three-part
     form was read as a two-part one -- type `Csv', variant
     `Kind.Stamp' -- and refused as `unknown procedure: Csv' until
     2026-09-15; nobody had written one, so nothing knew.  With a
     module named, the variant is looked for THERE and nowhere else:
     that is what the qualification says. *)
  dot := Text.FindChar (name, '.') ;
  isVar := FALSE ;
  IF dot > 0 THEN
    t := SLICE (name, dot + 1, LEN (name) - dot - 1) ;
    g := Text.FindChar (t, '.') ;
    IF g > 0 THEN
      om := SLICE (name, 0, dot) ;
      isVar := TryVariantMod (FindMod (om), SLICE (t, 0, g),
                              SLICE (t, g + 1, LEN (t) - g - 1),
                              om, fields) ;
      t := SLICE (t, 0, g)
    ELSE
      isVar := FindVariant (SLICE (name, 0, dot), t, om, fields) ;
      t := SLICE (name, 0, dot)
    END
  END ;
  IF isVar THEN
    flat := FlatFields (fields, nflat) ;
    Arity (site, ctx, name, nflat, nargs) ;
    canonCtx := om ;
    FOR k := 0 TO nargs - 1 DO
      IF k < nflat THEN
        pTy := CanonT (flat[k], 0) ;
        Agree (StArg, pTy, aTy[k], site.line) ;
        IF NOT Compat (pTy, aTy[k]) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S4 (': cannot pass ', TyName (aTy[k]), ' where ',
                Cat (TyName (pTy), ' is expected'))))
        END
      END
    END ;
    canonCtx := '' ;
    RETURN Qualify (om, t)
  END ;
  t := EnumConvType (name) ;
  IF LEN (t) > 0 THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 AND NOT IsIntish (aTy[0]) THEN
      ErrN (site, ctx, S4 ('argument 1 of ', name,
        ': cannot convert ', Cat (TyName (aTy[0]),
          ' to an enumeration; an integer position is expected')))
    END ;
    RETURN t
  END ;
  (* a RECORD AGGREGATE: Row (200, 'OK'), or Mod.Row (...) for an
     imported type -- every field, in declaration order, each held to
     its field's type (report par 2.2.4, Alex 2026-10-05: positional,
     in a CONST and in statements) *)
  IF RecordNamed (name, om, t) IS SOME rn THEN
    IF rn.kids[0] IS SOME rbase THEN
      ErrN (site, ctx, Cat (name, ': an aggregate of an extended record is'
        + ' not built; give its fields one by one (par 2.2.4)')) ;
      RETURN t
    END ;
    flat := FlatFields (rn.kids[1], nflat) ;
    Arity (site, ctx, name, nflat, nargs) ;
    canonCtx := om ;
    FOR k := 0 TO nargs - 1 DO
      IF k < nflat THEN
        pTy := CanonT (flat[k], 0) ;
        Agree (StArg, pTy, aTy[k], site.line) ;
        IF NOT Compat (pTy, aTy[k]) THEN
          ErrN (site, ctx, S5 ('field ', ItoA (k + 1), ' of ', name,
            S4 (': cannot give ', TyName (aTy[k]), ' where ',
                Cat (TyName (pTy), ' is expected'))))
        END
      END
    END ;
    canonCtx := '' ;
    RETURN t
  END ;
  ErrN (site, ctx, Cat ('unknown procedure: ', name)) ;
  RETURN ''
END CallType ;

(* is the pool P itself one of a call's arguments?  Then the callee
   keeps in P what it keeps, and a value living in P may be handed to
   its KEPT parameter: `PutS (sp, o, k, v)` with o IN sp *)
PROCEDURE PoolAmong (args: Ast.Kid ; RO p: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF LEN (p) = 0 THEN RETURN FALSE END ;
  IF args IS SOME al THEN
    FOR i := 0 TO al.nkids - 1 DO
      IF al.kids[i] IS SOME a THEN
        IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.a, p) THEN
          RETURN TRUE
        END
      END
    END
  END ;
  RETURN FALSE
END PoolAmong ;

(* one argument against one parameter: type, mode, and the two par 4
   rules that are pure checks rather than flow *)
PROCEDURE CheckArg (site: PTR Ast.Node ; RO ctx: STR ; RO name: STR ;
                    k: I64 ; RO pTy: STR ; RO aTy: STR ; an: Ast.Kid ;
                    isVar: BOOL ; isOwn: BOOL ; isKept: BOOL ;
                    nFrameKept: I64 ; wantsPool: BOOL ; args: Ast.Kid) =
VAR amode, aroot, what, why : STR ;
BEGIN
  IF Text.Eq (aTy, '<void>') THEN
    ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
      Cat (name, ' returns no value')))
  ELSE
    Agree (StArg, pTy, aTy, site.line) ;
    IF NOT Compat (pTy, aTy) THEN
      ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
        S4 (': cannot pass ', TyName (aTy), ' where ',
            Cat (TyName (pTy), ' is expected'))))
    END
  END ;
  IF an IS SOME a THEN
    IF isVar AND a.kind # Ast.NDesignator THEN
      ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
        Cat (name, ' must be a variable (VAR/OWN parameter)')))
    END ;
    IF isVar AND a.kind = Ast.NDesignator THEN
      IF a.nkids = 0 THEN
        (* a value parameter of pointer type is a shared borrow;
           lending it onward as VAR would launder the write
           restriction through a call (par 4.1) *)
        IF Text.Eq (ScopeMode (a.a), ModeVal) AND BaseIsPtr (a) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot lend the value parameter ', a.a,
                ' as VAR (shared borrow, par 4.1)')))
        END
      END ;
      (* rule 2: the callee may allocate in the object's pool, which
         the generator names from the ROOT of this designator's
         declaration -- so the root must have one to name *)
      IF wantsPool THEN
        why := ObjPoolIssue (a) ;
        IF LEN (why) > 0 THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S4 (': the pool of ', a.a, ' is not known here, and the callee may allocate in it -- ',
                Cat (why, ' (par 4.3)'))))
        END
      END
    END ;
    IF isOwn AND a.kind = Ast.NDesignator THEN
      IF a.nkids = 0 THEN
        amode := ScopeMode (a.a) ;
        IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
           Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move borrowed ', a.a,
                ' into an OWN parameter (par 4.2)')))
        ELSIF FvalHas (a.a) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move ', a.a,
                ' into an OWN parameter -- it lives in the frame (par 4.3)')))
        ELSE
          IF ResolveType (ScopeType (a.a)) IS SOME ares THEN
            IF ares.kind = Ast.NPtrType THEN
              IF ares.kids[1] IS SOME poolName THEN
                ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ',
                  name, S3 (': the pool owns ', a.a, ' (par 4.3)')))
              ELSE
                IF OwnedCandKind (a.a) > 0 THEN
                  OwnMark (a.a, Cat ('moved into an OWN parameter of ',
                    name), site)
                END
              END
            ELSE
              IF OwnedCandKind (a.a) > 0 THEN
                OwnMark (a.a, Cat ('moved into an OWN parameter of ',
                  name), site)
              END
            END
          END
        END
      END
    END
  END ;
  (* par 4.1, the caller side of KEPT.  A parameter's KEPT is read
     HERE, which is what narrows the old blanket every-callee-may-keep
     '<call>' fact to the parameters that declare it.  Two refusals,
     the RAISES-style upward composition: what is handed to a KEPT
     parameter must survive the call, so a concatenation (frame
     storage, par 2.3) is refused outright, and a borrow is a
     retention the CALLER must declare in turn. *)
  IF isKept THEN
    (* a concatenation, a frame allocation, an answer built here, or a
       name holding one -- unless the keeper is a frame value too *)
    what := FrameWhat (an, aTy) ;
    IF LEN (what) > 0 AND nFrameKept <= 1 AND
       NOT PoolAmong (args, KindPool (what)) THEN
      ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
        S4 (name, ': a KEPT parameter cannot take ', what,
            ' -- it dies with this frame (par 4.1)')))
    END ;
    aroot := EscRootOf (an) ;
    IF LEN (aroot) > 0 AND IsRefTy (aTy) THEN
      amode := ScopeMode (aroot) ;
      (* handing a borrow onward to a KEPT parameter is what
         justifies the caller's own KEPT *)
      IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
         Text.Eq (amode, ModeRo) THEN
        KeptUse (aroot)
      END ;
      IF (Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
          Text.Eq (amode, ModeRo)) AND NOT KeptHas (aroot) THEN
        ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
          S5 (': borrowed ', aroot,
              ' is kept by the callee -- declare KEPT ', aroot,
              ' (par 4.1)')))
      END ;
      IF IsFrameMode (amode) THEN
        EscTarget (aroot, '<call>')
      END
    END
  END
END CheckArg ;


(* ---- par 4.2: moves and consumption ----

   An owned pointer has exactly one owner.  DISPOSE, SHARED (x), an
   OWN argument and a bare owned name on the right of an assignment
   all TAKE it, and any later use of that name is an error naming
   what took it and where.  A bare name on the left is a fresh start.

   The flow is per procedure and deliberately conservative at a join:
   moved in ANY arm is moved after the join, because a checker that
   guessed the other way would accept a use-after-move whenever the
   compiler could not see which arm ran.                            *)

PROCEDURE OwnClear () =
BEGIN
  nown := 0
END OwnClear ;

PROCEDURE OwnFind (RO nm: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nown - 1 DO
    IF Text.Eq (own[i].name, nm) THEN RETURN i END
  END ;
  RETURN -1
END OwnFind ;

PROCEDURE OwnSet (RO KEPT nm: STR ; RO KEPT state: STR) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  i := OwnFind (nm) ;
  IF i >= 0 THEN
    own[i].mode := state ;
    RETURN
  END ;
  IF nown = LEN (own) THEN
    nb := NEW (pool, Binding, 2 * LEN (own) + 16) ;
    FOR i := 0 TO nown - 1 DO nb[i] := own[i] END ;
    own := nb
  END ;
  own[nown].name := nm ;
  own[nown].mode := state ;
  own[nown].ty := NONE ;
  nown := nown + 1
END OwnSet ;

(* 1 = an owned pointer, 2 = a SHARED handle, 0 = neither.  Only
   locals and OWN parameters qualify: everything else is a borrow. *)
PROCEDURE OwnedCandKind (RO nm: STR) : I64 =
VAR mode : STR ;
BEGIN
  mode := ScopeMode (nm) ;
  IF NOT Text.Eq (mode, ModeLocal) AND NOT Text.Eq (mode, ModeOwn) THEN
    RETURN 0
  END ;
  IF ResolveType (ScopeType (nm)) IS SOME res THEN
    IF res.kind = Ast.NPtrType THEN
      IF res.kids[1] IS SOME inpool THEN RETURN 0 END ;
      RETURN 1
    END ;
    IF res.kind = Ast.NSharedType THEN RETURN 2 END
  END ;
  RETURN 0
END OwnedCandKind ;

PROCEDURE OwnMark (RO KEPT nm: STR ; RO what: STR ; site: PTR Ast.Node) =
BEGIN
  OwnSet (nm, S3 (what, ' at line ', ItoA (site.line)))
END OwnMark ;

PROCEDURE OwnAlive (RO KEPT nm: STR) =
BEGIN
  IF OwnFind (nm) >= 0 THEN OwnSet (nm, 'alive') END
END OwnAlive ;

PROCEDURE NoteUse (d: PTR Ast.Node ; RO ctx: STR) =
VAR i : I64 ;
BEGIN
  i := OwnFind (d.a) ;
  IF i < 0 THEN RETURN END ;
  IF NOT Text.Eq (own[i].mode, 'alive') THEN
    ErrN (d, ctx, S4 ('use of ', d.a, ' after it was ',
      Cat (own[i].mode, ' (par 4.2)')))
  END
END NoteUse ;

(* snapshot and merge, so that arms of an IF or a CASE are judged
   independently and their moves are adopted at the join *)
PROCEDURE OwnSnap () : SLICE OF Binding =
VAR
  c : SLICE OF Binding ;
  i : I64 ;
BEGIN
  c := NEW (pool, Binding, nown + 1) ;
  FOR i := 0 TO nown - 1 DO c[i] := own[i] END ;
  RETURN c
END OwnSnap ;

PROCEDURE OwnRestore (KEPT snap: SLICE OF Binding ; n: I64) =
VAR i : I64 ;
BEGIN
  nown := 0 ;
  FOR i := 0 TO n - 1 DO OwnSet (snap[i].name, snap[i].mode) END
END OwnRestore ;

PROCEDURE OwnMergeMoves (KEPT snap: SLICE OF Binding ; n: I64) =
VAR
  i, ix : I64 ;
BEGIN
  FOR i := 0 TO n - 1 DO
    IF NOT Text.Eq (snap[i].mode, 'alive') THEN
      ix := OwnFind (snap[i].name) ;
      IF ix < 0 THEN
        OwnSet (snap[i].name, snap[i].mode)
      ELSE
        IF Text.Eq (own[ix].mode, 'alive') THEN
          OwnSet (snap[i].name, snap[i].mode)
        END
      END
    END
  END
END OwnMergeMoves ;

(* DISPOSE: what may be freed, and by whom *)
PROCEDURE CheckDispose (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  t, amode : STR ;
BEGIN
  IF st.kids[0] IS SOME d THEN
    t := DesigStrType (d, FALSE, ctx) ;
    IF d.nkids = 0 THEN
      NoteUse (d, ctx) ;
      amode := ScopeMode (d.a) ;
      IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
         Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo) THEN
        ErrN (st, ctx, S3 ('cannot DISPOSE ', d.a,
          ': a borrow is not yours to free (take OWN, par 4.2)'))
      ELSIF FvalHas (d.a) THEN
        ErrN (st, ctx, S3 ('the frame owns ', d.a,
          '; it is freed at exit, not by DISPOSE (par 4.3)'))
      ELSE
        IF ResolveType (ScopeType (d.a)) IS SOME dcl THEN
          IF dcl.kind = Ast.NPtrType THEN
            IF dcl.kids[1] IS SOME pn THEN
              ErrN (st, ctx, S3 ('the pool owns ', d.a,
                '; free the pool, not the pointer (par 4.3)'))
            ELSE
              IF OwnedCandKind (d.a) > 0 THEN
                OwnMark (d.a, 'DISPOSEd', st)
              END
            END
          ELSE
            IF OwnedCandKind (d.a) > 0 THEN
              OwnMark (d.a, 'DISPOSEd', st)
            END
          END
        END
      END
    END
  END
END CheckDispose ;

(* completeness, judged at the implementation: everything the
   definition promised has a body, and every opaque type has a
   structure.  A definition is a contract, and a contract with a
   missing half links and then does not run. *)
(* The implementation against its definition, in the oracle's own
   order: signatures, then STATEFUL, then completeness.  Order is not
   cosmetic -- semdiff compares the diagnostic LIST, so a check in
   the wrong place is a divergence even when both checkers find the
   same faults.

   The STATEFUL half was MISSING here until 2026-08-24, and semdiff
   could not see it: every corpus module with module-level state
   already declares STATEFUL, so both checkers agreed by both saying
   nothing.  It took a negative case --
   probes/module-state-without-stateful.m9 -- which is what probes/
   is for and why a clean corpus proves nothing on its own. *)
(* the oracle's three-line message, built rather than concatenated
   because the two middle lines carry a newline each and M9 has no
   escape in a string literal -- a string cannot contain its own
   delimiter and there is no backslash form (report par 2) *)
PROCEDURE SigDiff (RO want: STR ; RO got: STR) : STR =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, 'signature differs from definition:') ;
  DynStr.AppendChar (d, 0AC) ;
  DynStr.Append (d, '    definition     ') ;
  DynStr.Append (d, want) ;
  DynStr.AppendChar (d, 0AC) ;
  DynStr.Append (d, '    implementation ') ;
  DynStr.Append (d, got) ;
  RETURN DynStr.View (d)
END SigDiff ;

PROCEDURE CheckConformance (u: PTR Ast.Node) =
VAR
  m, i, pi : I64 ;
  defined, hasVars : BOOL ;
  isig : STR ;
BEGIN
  m := FindMod (u.a) ;
  IF m < 0 THEN RETURN END ;

  hasVars := FALSE ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NVarSection THEN hasVars := TRUE END ;
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcIn (m, d.a) ;
        IF pi >= 0 THEN
          (* fromDef is the oracle's `node <> d` test said another
             way: an entry that came from the definition is a
             DIFFERENT node from this implementation's, and one that
             did not is this very node, with nothing to compare. *)
          IF mods[m].procs[pi].fromDef THEN
            isig := SigOf (d) ;
            IF NOT Text.Eq (mods[m].procs[pi].sig, isig) THEN
              ErrN (d, Qualify (u.a, d.a),
                SigDiff (mods[m].procs[pi].sig, isig))
            END
          END
        END
      END
    END
  END ;
  IF hasVars AND NOT mods[m].stateful THEN
    ErrN (u, u.a, 'module-level state requires STATEFUL on the definition')
  END ;

  FOR i := 0 TO mods[m].nprocs - 1 DO
    IF mods[m].procs[i].fromDef AND NOT mods[m].procs[i].hasBody THEN
      ErrN (u, Qualify (u.a, mods[m].procs[i].name),
        'declared in the definition but not implemented')
    END
  END ;
  FOR i := 0 TO mods[m].nopaque - 1 DO
    (* FindTypeIn answers the type NODE, not an index -- which the
       new typing caught the first time this was written the other
       way round *)
    IF FindTypeIn (m, mods[m].opaque[i]) IS SOME td THEN
      defined := TRUE
    ELSE
      defined := FALSE
    END ;
    IF NOT defined THEN
      ErrN (u, Qualify (u.a, mods[m].opaque[i]),
        'opaque type not defined in the implementation')
    END
  END
END CheckConformance ;

(* ---- pass 1: foreign declarations ---- *)

PROCEDURE IsCType (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME t THEN
    RETURN t.kind = Ast.NQualident AND Text.Eq (t.a, 'C') AND
           LEN (t.b) > 0
  END ;
  RETURN FALSE
END IsCType ;

PROCEDURE Cat (RO a: STR ; RO b: STR) : STR =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, a) ;
  DynStr.Append (d, b) ;
  RETURN DynStr.View (d)
END Cat ;

PROCEDURE Qualify (RO a: STR ; RO b: STR) : STR =
VAR d : PTR DynStr.DString IN pool ;
BEGIN
  d := DynStr.New (pool) ;
  DynStr.Append (d, a) ;
  DynStr.AppendChar (d, '.') ;
  DynStr.Append (d, b) ;
  RETURN DynStr.View (d)
END Qualify ;

(* A FOR "C" unit is the audit surface: every procedure in it names a
   C symbol, speaks only C.* types, and states its thread contract.
   The blosc_decompress race that seeded the museum is unrepresentable
   once all three hold.                                             *)
PROCEDURE CheckForeignDef (u: PTR Ast.Node) =
VAR
  i, j : I64 ;
  ctx : STR ;
  ok : BOOL ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        ctx := Qualify (u.a, d.a) ;
        IF LEN (d.b) = 0 THEN
          ErrN (d, ctx,
            'foreign procedure needs a bound C name (= "c_name")')
        END ;
        ok := TRUE ;
        IF d.kids[0] IS SOME pl THEN
          FOR j := 0 TO pl.nkids - 1 DO
            IF pl.kids[j] IS SOME prm THEN
              IF NOT IsCType (prm.kids[1]) THEN ok := FALSE END
            END
          END
        END ;
        IF d.kids[1] IS SOME rt THEN
          IF NOT IsCType (d.kids[1]) THEN ok := FALSE END
        END ;
        IF NOT ok THEN
          ErrN (d, ctx,
            'native type in foreign signature; use C.* types')
        END ;
        ok := FALSE ;
        IF d.kids[3] IS SOME at THEN
          ok := Text.Eq (at.a, 'SERIAL') OR Text.Eq (at.a, 'REENTRANT')
        END ;
        IF NOT ok THEN
          ErrN (d, ctx,
            'foreign procedure must declare [SERIAL] or [REENTRANT]')
        END
      END
    END
  END
END CheckForeignDef ;



(* ---- FROM imports: the module a bare callee belongs to ---- *)

PROCEDURE FromClear () =
BEGIN
  nfrom := 0
END FromClear ;

PROCEDURE FromAdd (RO KEPT nm: STR ; RO KEPT owner: STR) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nfrom = LEN (fromMap) THEN
    nb := NEW (pool, Binding, 2 * LEN (fromMap)) ;
    FOR i := 0 TO nfrom - 1 DO nb[i] := fromMap[i] END ;
    fromMap := nb
  END ;
  fromMap[nfrom].name := nm ;
  fromMap[nfrom].mode := owner ;
  fromMap[nfrom].ty := NONE ;
  nfrom := nfrom + 1
END FromAdd ;

PROCEDURE FromOwner (RO nm: STR) : STR =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfrom - 1 DO
    IF Text.Eq (fromMap[i].name, nm) THEN RETURN fromMap[i].mode END
  END ;
  RETURN ''
END FromOwner ;

(* the callee's declaration, wherever it lives: qualified names name
   their module, bare ones mean this module unless a FROM import said
   otherwise *)
PROCEDURE LookupProc (RO callee: STR ; VAR found: BOOL) : ProcInfo =
VAR
  dot, m, pi : I64 ;
  modName, procName, owner : STR ;
  empty : ProcInfo ;
BEGIN
  found := FALSE ;
  dot := Text.FindChar (callee, '.') ;
  IF dot >= 0 THEN
    modName := SLICE (callee, 0, dot) ;
    procName := SLICE (callee, dot + 1, LEN (callee) - dot - 1)
  ELSE
    procName := callee ;
    modName := curMod ;
    owner := FromOwner (callee) ;
    IF LEN (owner) > 0 THEN modName := owner END
  END ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN empty END ;
  pi := FindProcIn (m, procName) ;
  IF pi < 0 THEN RETURN empty END ;
  found := TRUE ;
  RETURN mods[m].procs[pi]
END LookupProc ;

PROCEDURE WidthTwin (RO name: STR ; single: BOOL) : STR =
VAR found : BOOL ; pr : ProcInfo ; n : I64 ;
BEGIN
  (* WIDTH DISPATCH BY DECLARED TWIN.  `Math.Sqrt (x)` with an F32
     argument is `Math.SqrtF32 (x)`, because sqrtf's answer is not
     sqrt's answer narrowed, and a port held bit-identical to a
     single-precision original needs the single-precision libm.

     Two conditions: the first argument is F32, and the module
     DECLARED the twin.  The suffix is how a module says a function
     is width-generic -- so nothing changes for a module that
     declares none, which is every module but Math.

     SOME argument is F32 and NONE is F64.  Reading only the first
     met `Math.Pow (10.0, c)`: a literal types as neither width,
     because it adapts, so it must neither decide nor block.  A
     genuinely mixed call -- one F32 argument and one F64 -- keeps
     the double twin and fails argument compatibility, which is the
     right answer and names the right place. *)
  IF NOT single THEN RETURN name END ;
  n := LEN (name) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (name, n - 3, 3), 'F32') THEN RETURN name END
  END ;
  pr := LookupProc (Cat (name, 'F32'), found) ;
  IF found THEN RETURN Cat (name, 'F32') END ;
  RETURN name
END WidthTwin ;

PROCEDURE DesigName (d: PTR Ast.Node) : STR =
  (* the dotted callee name: `P', `Mod.P', `Type.Variant', and --
     since 2026-09-15 -- `Mod.Type.Variant', the three-part imported
     variant constructor.  Every field selector joins; a call target
     is only ever one of these shapes, because F(x).field does not
     parse and a field chain cannot be called.  A leading index or
     deref stops it (returns the base), as before. *)
VAR
  res : STR ;
  i : I64 ;
BEGIN
  res := d.a ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN res := Qualify (res, sel.a)
      ELSE RETURN d.a END
    END
  END ;
  RETURN res
END DesigName ;

(* ---- the variant set of a KNOWN selector type ----
   Two modules may spell a variant type the same way -- Json and Dict
   both declare Value -- so totality is judged against the SELECTOR's
   type, never against the first module that matches a label by name.
   That distinction cost two bugs before it was written down.       *)
PROCEDURE VariantOfType (RO canon: STR ; VAR mi: I64 ; VAR vi: I64)
  : BOOL =
VAR
  dot, m, j : I64 ;
  modName, tyName : STR ;
BEGIN
  mi := -1 ;
  vi := -1 ;
  dot := Text.FindChar (canon, '.') ;
  IF dot < 0 THEN RETURN FALSE END ;
  modName := SLICE (canon, 0, dot) ;
  tyName := SLICE (canon, dot + 1, LEN (canon) - dot - 1) ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN FALSE END ;
  FOR j := 0 TO mods[m].nvts - 1 DO
    IF Text.Eq (mods[m].vts[j].typeName, tyName) THEN
      mi := m ;
      vi := j ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END VariantOfType ;

PROCEDURE VariantHas (mi, vi: I64 ; RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (mods[mi].vts[vi].variants) - 1 DO
    IF Text.Eq (mods[mi].vts[vi].variants[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END VariantHas ;

(* every arm of a CASE over a CASE RECORD, or an ELSE.  The
   uninitialised-Result bug that seeded the museum is unrepresentable
   once this holds: there is no path out of the CASE that assigns
   nothing.                                                          *)
PROCEDURE HasPatternArm (st: PTR Ast.Node) : BOOL =
VAR j, k : I64 ;
BEGIN
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR k := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END HasPatternArm ;

PROCEDURE CheckCaseTotal (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  selTy : STR ;
  mi, vi, j, k, c : I64 ;
  covered : SLICE OF STR ;
  ncov : I64 ;
  hasElse, labelsVariant : BOOL ;
BEGIN
  selTy := DesigCanon (st.kids[0], ctx) ;
  IF NOT VariantOfType (selTy, mi, vi) THEN
    (* a CASE with an arm that BINDS a payload ranges over variants,
       whatever its selector's type could not be resolved to: nothing
       was proved about its totality, and --review says so.  (A
       scalar CASE is not a totality site at all and is not counted.) *)
    IF HasPatternArm (st) THEN PassedOver (StCase, st.line) END ;
    RETURN
  END ;
  covered := NEW (pool, STR, 16) ;
  ncov := 0 ;
  hasElse := FALSE ;
  labelsVariant := FALSE ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR k := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN
                IF ncov < LEN (covered) THEN
                  covered[ncov] := lbl.a ;
                  ncov := ncov + 1 ;
                  labelsVariant := TRUE
                END
              ELSIF lbl.kind = Ast.NLabelRange THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF lv.kind = Ast.NDesignator AND lv.nkids = 0 THEN
                    IF VariantHas (mi, vi, lv.a) THEN
                      IF ncov < LEN (covered) THEN
                        covered[ncov] := lv.a ;
                        ncov := ncov + 1 ;
                        labelsVariant := TRUE
                      END
                    END
                  END
                END
              END
            END
          END
        END
      ELSE
        hasElse := TRUE
      END
    END
  END ;
  IF NOT labelsVariant OR hasElse THEN RETURN END ;
  statC[StCase] := statC[StCase] + 1 ;
  FOR k := 0 TO LEN (mods[mi].vts[vi].variants) - 1 DO
    c := 0 ;
    FOR j := 0 TO ncov - 1 DO
      IF Text.Eq (covered[j], mods[mi].vts[vi].variants[k]) THEN
        c := c + 1
      END
    END ;
    IF c = 0 THEN
      ErrN (st, ctx, Cat (Cat (
        'CASE over CASE RECORD is not total (missing ',
        mods[mi].vts[vi].variants[k]), ')'))
    END
  END
END CheckCaseTotal ;

(* a function called as a statement throws its answer away, and in a
   language where failure travels in the result that is how a caller
   loses the thing it was supposed to check *)
(* THREAD (P, arg), par 6: the argument is held to P's first
   parameter, and a bare owned pointer handed over is MOVED -- the
   thread owns it now.  Until 2026-09-27 neither checker looked at
   the argument (docs/agent-review-2026-09-27.md F2): `THREAD (Work,
   x)` with an I64 reached the generator, and an owned pointer stayed
   live in the caller after a thread had it.  The shapes that pass:
   `P (VAR r: T)` takes a PTR T or SHARED PTR T -- the record by
   reference, chapter 16's job -- or a monitor T by name; `P (p: PTR
   T)` and `P (OWN p: PTR T)` take a PTR T.  A pool value is the
   pool's and is lent, a VAR parameter is a borrow and is lent;
   sharability itself is still unbuilt and the reviewer holds it. *)
PROCEDURE CheckThread (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  name, pTy, aTy, amode, what : STR ;
  pr : ProcInfo ;
  found, pooled : BOOL ;
BEGIN
  aTy := ExprType (st.kids[1], ctx) ;
  IF st.kids[0] IS SOME tn THEN
    IF tn.kind # Ast.NDesignator THEN RETURN END ;
    name := DesigName (tn) ;
    RootAdd (name) ;
    pTy := '' ;
    pr := LookupProc (name, found) ;
    IF found THEN
      IF pr.node IS SOME pn THEN
        canonCtx := pr.modName ;
        IF pn.kids[0] IS SOME pl THEN
          IF pl.nkids > 0 THEN
            IF pl.kids[0] IS SOME grp THEN
              pTy := CanonT (grp.kids[1], 0)
            END
          END
        END ;
        canonCtx := ''
      END
    END ;
    Agree (StThread, pTy, aTy, st.line) ;
    IF LEN (pTy) > 0 AND LEN (aTy) > 0 THEN
      IF NOT (Compat (pTy, aTy) OR Compat (Cat ('PTR ', pTy), aTy) OR
              Compat (Cat ('SHARED PTR ', pTy), aTy)) THEN
        ErrN (st, ctx, S5 ('THREAD (', name, '): cannot pass ',
          TyName (aTy), S3 (' where ', TyName (pTy), ' is expected')))
      END
    END ;
    (* a frame allocation, or a name holding one, dies when this
       frame exits, which a thread does not wait for: storage handed
       to a thread is allocated with OWN (docs/pool-elision-plan.md) *)
    what := FrameWhat (st.kids[1], aTy) ;
    IF LEN (what) > 0 AND LEN (KindPool (what)) = 0 THEN
      (* a local pool's object is lent as any pool pointer is (the
         thread receives the pool through the thunk, and Mat.AddNormal
         WAITs for its workers before the pool dies): unchecked until
         SHARABLE, like the rest *)
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot hand ', what,
        ' to a thread -- it dies with this frame; allocate it with OWN (par 4.3)'))
    END ;
    IF st.kids[1] IS SOME an THEN
      IF an.kind = Ast.NDesignator THEN
        IF an.nkids = 0 THEN
          amode := ScopeMode (an.a) ;
          IF NOT (Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
                  Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo)) THEN
            IF ResolveType (ScopeType (an.a)) IS SOME ares THEN
              IF ares.kind = Ast.NPtrType THEN
                pooled := FALSE ;
                IF ares.kids[1] IS SOME poolName THEN pooled := TRUE END ;
                IF NOT pooled AND OwnedCandKind (an.a) > 0 AND
                   NOT FvalHas (an.a) THEN
                  OwnMark (an.a, Cat ('moved into a THREAD running ', name),
                           st)
                END
              END
            END
          END
        END
      END
    END
  END
END CheckThread ;

PROCEDURE CheckCallStmt (KEPT st: PTR Ast.Node ; RO ctx: STR) =
VAR t : STR ;
BEGIN
  IF st.kids[0] IS SOME dn THEN
    (* through CallType, so that an unknown callee, a wrong arity and
       a wrong argument are all reported here and not only when the
       call appears in an expression *)
    t := CallType (st.kids[0], st.kids[1], st, ctx) ;
    IF LEN (t) > 0 AND NOT Text.Eq (t, '<void>') THEN
      ErrN (st, ctx, S3 ('function result discarded: ',
        DesigName (dn), Cat (' returns ', TyName (t))))
    END
  END
END CheckCallStmt ;

(* a CASE pattern's binders, bound with the variant's field types --
   the oracle's BindPattern, by global variant-name search -- and,
   par 4.1 direction, each views the selector's payload, so it
   inherits the selector's reach *)
PROCEDURE BindPat (lbl: PTR Ast.Node ; RO KEPT selRoot: STR) =
VAR
  flat : SLICE OF AKid ;
  nflat, m, j, v, n : I64 ;
  done : BOOL ;
BEGIN
  nflat := 0 ;
  flat := NEW (pool, AKid, 1) ;
  done := FALSE ;
  FOR m := 0 TO nmods - 1 DO
    FOR j := 0 TO mods[m].nvts - 1 DO
      FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
        IF NOT done AND Text.Eq (mods[m].vts[j].variants[v], lbl.a) THEN
          flat := FlatFields (mods[m].vts[j].fields[v], nflat) ;
          done := TRUE
        END
      END
    END
  END ;
  IF lbl.kids[0] IS SOME ids THEN
    FOR n := 0 TO ids.nkids - 1 DO
      IF ids.kids[n] IS SOME id THEN
        IF n < nflat THEN BindName (id.a, flat[n])
        ELSE BindName (id.a, NONE) END ;
        IF LEN (selRoot) > 0 THEN
          (* and, provenance, the pattern binder carries the selector *)
          EscStore (selRoot, TRUE, id.a) ;
          CarryFrom (id.a, selRoot)
        END
      END
    END
  END
END BindPat ;

PROCEDURE BindPats (arm: PTR Ast.Node ; RO KEPT selRoot: STR) =
VAR k : I64 ;
BEGIN
  IF arm.kids[0] IS SOME ll THEN
    FOR k := 0 TO ll.nkids - 1 DO
      IF ll.kids[k] IS SOME lbl THEN
        IF lbl.kind = Ast.NLabelPattern THEN BindPat (lbl, selRoot) END
      END
    END
  END
END BindPats ;

(* ---- pass 2: the body walk, and the par 4.1 retention ledger ----

   The ledger is MEASURED, not rejected.  A borrowed reference stored
   beyond the frame is exactly what par 4.1 predicts callers will want
   to do, so the design's price is the count of places that do it --
   and the kill-gate reads that count.  Which is why it is output and
   not a debug aside, and why the gate now fails the build: a rule
   that only prints a verdict is not a rule.

   SHARED handles are excluded.  Copying one IS the sanctioned
   retention -- refcounted, created explicitly (par 4.2) -- so
   counting it would inflate the price of a discipline it obeys.    *)

PROCEDURE WalkStmt (k: Ast.Kid ; RO ctx: STR) ;

PROCEDURE WalkSeq (k: Ast.Kid ; RO ctx: STR) =
VAR j : I64 ;
BEGIN
  IF k IS SOME s THEN
    FOR j := 0 TO s.nkids - 1 DO
      WalkStmt (s.kids[j], ctx)
    END
  END
END WalkSeq ;

(* a NEW from a named pool or an object's pool: not the frame form,
   not OWN *)
PROCEDURE IsPoolNew (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.nkids = 0 AND Text.Eq (d.a, 'OWN') THEN RETURN FALSE END
      END ;
      RETURN NOT NewIsFrame (e)
    END
  END ;
  RETURN FALSE
END IsPoolNew ;

(* HEAP, or a name declared POOL in scope *)
PROCEDURE IsPoolName (RO nm: STR) : BOOL =
BEGIN
  IF Text.Eq (nm, 'HEAP') THEN RETURN TRUE END ;
  IF ScopeType (nm) IS SOME q THEN
    IF q.kind = Ast.NQualident THEN
      RETURN Text.Eq (q.a, 'POOL') AND LEN (q.b) = 0
    END
  END ;
  RETURN FALSE
END IsPoolName ;

(* the pool an allocation on the right-hand side names, for the
   declared-pool check: `NEW (Q, T)` with Q a pool in scope or HEAP,
   or a call whose result type promises `IN r` with a bare name Q
   handed to r; '' when the shape says nothing *)
PROCEDURE AllocPoolOf (k: Ast.Kid ; RO ctx: STR) : STR =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  i, j, ix, want : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.nkids = 0 AND NOT Text.Eq (d.a, 'OWN') THEN
          IF IsPoolName (d.a) THEN RETURN d.a END
        END
      END ;
      RETURN ''
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pr := LookupProc (DesigName (dn), found) ;
          IF found THEN
            IF pr.node IS SOME pn THEN
              IF pn.kids[1] IS SOME rt THEN
                IF rt.kind = Ast.NPtrType THEN
                  IF rt.kids[1] IS SOME rn THEN
                    want := -1 ;
                    ix := 0 ;
                    IF pn.kids[0] IS SOME pl THEN
                      FOR i := 0 TO pl.nkids - 1 DO
                        IF pl.kids[i] IS SOME grp THEN
                          IF grp.kids[0] IS SOME ids THEN
                            FOR j := 0 TO ids.nkids - 1 DO
                              IF ids.kids[j] IS SOME id THEN
                                IF Text.Eq (id.a, rn.a) THEN want := ix END
                              END ;
                              ix := ix + 1
                            END
                          END
                        END
                      END
                    END ;
                    IF e.kids[1] IS SOME al THEN
                      IF want >= 0 AND want < al.nkids THEN
                        IF al.kids[want] IS SOME an THEN
                          IF an.kind = Ast.NDesignator AND an.nkids = 0 THEN
                            RETURN an.a
                          END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END AllocPoolOf ;

PROCEDURE CheckAssign (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  beyond, isShared : BOOL ;
  vname, t, u, lhsMode, dmode, what, apool, par : STR ;
  lv : I64 ;
BEGIN
  IF st.kids[0] IS SOME lhs THEN
    (* the types first, in the oracle's order: the left side, the
       right side, then whether one may become the other *)
    t := DesigStrType (lhs, FALSE, ctx) ;
    u := ExprType (st.kids[1], ctx) ;
    IF LEN (showName) > 0 AND lhs.nkids = 0 AND Text.Eq (lhs.a, showName) THEN
      shown := u ;
      RETURN
    END ;
    (* par 2.3: a FRAME-SCOPED string (a concatenation, or a name
       already holding one) may not be stored where it will be read
       after this frame is freed -- a module variable, or a
       COMPONENT reached through a reference parameter (or a value
       pointer's target).  A bare VAR/OWN STR parameter is not
       refused: the generator re-homes its target into the caller's
       arena at exit, as it does the result.  A bare frame-mode
       destination merely inherits the taint and is cleared when
       given a durable value. *)
    IF st.kids[1] IS SOME frhs THEN
      what := FrameWhat (st.kids[1], u) ;
      IF LEN (what) > 0 THEN
        (* a frame value is par 2.3's rule; storage in a local pool,
           or a view of it, is par 4.3's, refused at the same places
           and for the same reason -- and additionally where the
           destination is declared IN a pool that is NOT local, since
           that pool outlives the frame while a local pool's value
           may rest in a name declared IN any local pool, all of which
           die together (the clause check below speaks when an
           allocation names a pool other than the declared one) *)
        IF LEN (KindPool (what)) > 0 THEN par := '4.3' ELSE par := '2.3' END ;
        dmode := ScopeMode (lhs.a) ;
        IF Text.Eq (dmode, ModeModule) AND NOT curInBody THEN
          ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored in module variable ',
            lhs.a, S3 (' (par ', par, ')')))
        ELSIF Text.Eq (dmode, ModeRo) OR
              ((Text.Eq (dmode, ModeVar) OR Text.Eq (dmode, ModeOwn) OR
                Text.Eq (dmode, ModeVal)) AND lhs.nkids > 0) THEN
          ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored through ',
            lhs.a, S3 (', which outlives it (par ', par, ')')))
        ELSIF lhs.nkids = 0 AND IsFrameMode (dmode) THEN
          (* a local declared IN a pool claims that pool's lifetime,
             and rule 2 hands that pool to every callee that grows
             the object: a frame value held there would have its
             growth outlive its head (docs/pool-elision-plan.md) *)
          IF Text.Eq (dmode, ModeLocal) THEN
            IF DeclPool (ScopeType (lhs.a)) IS SOME dp THEN
              IF LEN (KindPool (what)) = 0 THEN
                ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be held by ',
                  lhs.a, ', which is declared IN a pool (par 4.3)'))
              ELSIF NOT Text.Eq (ScopeMode (dp.a), ModeLocal) AND
                    LEN (AllocPoolOf (st.kids[1], ctx)) = 0 THEN
                ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be held by ',
                  lhs.a, ', which is declared IN a pool (par 4.3)'))
              END
            ELSE
              FvalAdd (lhs.a, what)
            END
          ELSE
            FvalAdd (lhs.a, what)
          END
        ELSIF lhs.nkids > 0 AND Text.Eq (dmode, ModeLocal) THEN
          (* a COMPONENT of a local: the record, or the pointer's
             target, now holds a frame value.  Declared IN a pool, the
             target outlives the frame and the store is refused;
             otherwise the local carries the taint, so copying it out
             is refused as the value itself would be.  Found by stage
             5 of the pool elision: RegisterUnit's ProcInfo held
             RaisesOf's answer in a field and was appended to a module
             table, and every exception name read empty. *)
          IF DeclPool (ScopeType (lhs.a)) IS SOME dp2 THEN
            IF LEN (KindPool (what)) = 0 OR
               NOT Text.Eq (ScopeMode (dp2.a), ModeLocal) THEN
              ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored through ',
                lhs.a, ', which is declared IN a pool (par 4.3)'))
            END
          ELSE
            FvalAdd (lhs.a, what) ;
            (* and the component itself, by its path, so that copying
               the component out is refused as the whole is
               (FrameWhat; Png.Raster's `RETURN c.pix', 2026-10-03) *)
            FvalAdd (Text.Keep (pool, DesigPath (lhs)), what)
          END
        END
      ELSIF lhs.nkids = 0 THEN
        FvalDel (lhs.a)
      ELSIF Text.Eq (ScopeMode (lhs.a), ModeLocal) THEN
        FvalDel (DesigPath (lhs))
      END ;
      (* a bare name given a pool allocation holds nobody's object *)
      IF lhs.nkids = 0 THEN
        IF IsPoolNew (st.kids[1]) THEN PvalAdd (lhs.a) ELSE PvalDel (lhs.a) END
      END ;
      (* par 4.3: the IN clause of a declaration is the pool rule 2
         hands to every callee that grows the object, so it must be
         the pool the object was allocated in.  `acc : PTR DString IN
         scratch ; acc := DynStr.New (pool)` grew its buffer in the
         wrong arena once the parameter that used to say `pool` was
         gone (stage 5, Http.Once: the first chunked body past one
         read block crashed). *)
      IF lhs.nkids = 0 THEN
        IF DeclPool (ScopeType (lhs.a)) IS SOME dp THEN
          apool := AllocPoolOf (st.kids[1], ctx) ;
          IF LEN (apool) > 0 AND NOT Text.Eq (apool, dp.a) THEN
            ErrN (frhs, ctx, S5 (lhs.a, ' is declared IN ', dp.a,
              ' but allocated in ', Cat (apool, ' (par 4.3)')))
          END
        END
      END
    END ;
    (* anchored at the RIGHT-HAND SIDE, not the statement: a value
       on its own line used to be reported one line too high, at
       the := (found by the first m9edit user) *)
    IF st.kids[1] IS SOME rhn THEN
      IF Text.Eq (u, '<void>') THEN
        ErrN (rhn, ctx, 'the right-hand side returns no value')
      ELSE
        Agree (StAssign, t, u, rhn.line) ;
        IF NOT Compat (t, u) THEN
          ErrN (rhn, ctx, S5 ('cannot assign ', TyName (u), ' to ',
            TyName (t), ' (no implicit conversions, par 2.1)'))
        ELSIF LitOut (rhn, t, lv) THEN
          ErrN (rhn, ctx, S4 ('integer literal ', ItoA (lv),
            ' does not fit ', TyName (t)))
        END
      END
    END ;
    (* a WRITE through a selector is a use of its root: `p.n := 8`
       after p was moved is the same fault as reading p.n.  The oracle
       had this and this side did not, found by the THREAD probe of
       2026-09-27 (docs/agent-review-2026-09-27.md F2). *)
    IF lhs.nkids > 0 THEN NoteUse (lhs, ctx) END ;
    beyond := CheckWrite (lhs, ctx) ;
    (* a bare owned pointer on the right MOVES out of its name; a
       bare name on the left is (re)initialised.  A name holding a
       FRAME allocation is not owned -- the frame is -- so copying it
       is a copy, not a move (docs/pool-elision-plan.md, rule 1). *)
    IF st.kids[1] IS SOME rhs THEN
      IF rhs.kind = Ast.NDesignator THEN
        IF rhs.nkids = 0 THEN
          IF OwnedCandKind (rhs.a) = 1 THEN
            IF NOT FvalHas (rhs.a) AND NOT PvalHas (rhs.a) THEN
              OwnMark (rhs.a, 'moved', st)
            END
          END
        END
      END
    END ;
    IF lhs.nkids = 0 THEN OwnAlive (lhs.a) END ;
    (* EscRootOf, not RefRootOf: a sub-slice view of a borrow
       stored beyond the frame retains the borrow just as the whole
       of it would *)
    vname := EscRootOf (st.kids[1]) ;
    isShared := Text.StartsWith (u, 'SHARED PTR ') OR
                Text.StartsWith (u, 'OPT SHARED PTR ') ;
    lhsMode := ScopeMode (lhs.a) ;
    IF LEN (vname) > 0 AND IsRefTy (u) AND NOT isShared THEN
      IF Text.Eq (ScopeMode (vname), ModeVal) OR
         Text.Eq (ScopeMode (vname), ModeVar) OR
         Text.Eq (ScopeMode (vname), ModeRo) OR
         (* a local or binder may CARRY a borrow: recorded now,
            resolved at flush once the carries are closed, and
            dropped there if it carries none *)
         Text.Eq (ScopeMode (vname), ModeLocal) OR
         Text.Eq (ScopeMode (vname), ModeBinder) THEN
        IF beyond OR Text.Eq (lhsMode, ModeModule) OR
           (Text.Eq (lhsMode, ModeVar) AND lhs.nkids > 0) THEN
          (* PENDED, not emitted: the class -- retention, self-store,
             frame-store -- needs every escape of the destination,
             so the walk finishes first (FlushPend) *)
          PendPush (st.line, st.col, vname, lhs.a)
        END
      END
    END ;
    (* par 4.1 provenance: a bare local or binder now holds this
       reference -- a borrow is carried, a carrier's cargo is
       inherited *)
    IF LEN (vname) > 0 AND IsRefTy (u) AND lhs.nkids = 0 THEN
      IF Text.Eq (lhsMode, ModeLocal) OR Text.Eq (lhsMode, ModeBinder) THEN
        CarryFrom (lhs.a, vname)
      END
    END ;
    (* par 4.1 direction: a ref value rooted in frame storage,
       stored anywhere, is an escape fact for the fixpoint *)
    IF LEN (vname) > 0 AND IsRefTy (u) THEN
      IF IsFrameMode (ScopeMode (vname)) THEN
        EscStore (lhs.a, lhs.nkids > 0, vname)
      END
    END
  END
END CheckAssign ;

PROCEDURE WalkStmt (k: Ast.Kid ; RO ctx: STR) =
VAR
  j, hk, npre, nacc, narm2 : I64 ;
  pre, acc, arm2 : SLICE OF Binding ;
BEGIN
  IF k IS SOME st THEN
    CASE st.kind OF
    | Ast.NAssign :
        CheckAssign (st, ctx) ;
        WalkExpr (st.kids[1], ctx)
    | Ast.NCallStmt :
        CheckCallStmt (st, ctx) ;
        IF st.kids[0] IS SOME cn THEN
          NoteCall (cn, st.kids[1], ctx)
        END ;
        WalkArgs (st.kids[1], ctx)
    | Ast.NRaiseStmt :
        IF st.kids[0] IS SOME xn THEN
          CheckExcName (xn, ctx) ;
          IF LEN (xn.b) > 0 THEN RaisedAdd (xn.b, 'RAISE')
          ELSE RaisedAdd (xn.a, 'RAISE') END
        END ;
        WalkArgs (st.kids[1], ctx)
    | Ast.NReturn :
        CheckReturn (st, ctx) ;
        WalkExpr (st.kids[0], ctx)
    | Ast.NDispose :
        CheckDispose (st, ctx)
    | Ast.NThread :
        (* a THREAD root: everything it can reach must be safe to run
           concurrently, which is what the BFS below decides; and the
           argument is checked and, when owned, moved *)
        CheckThread (st, ctx)
    | Ast.NIf :
        CheckCond (st.kids[0], ctx) ;
        pre := OwnSnap () ;
        npre := nown ;
        WalkSeq (st.kids[1], ctx) ;
        acc := OwnSnap () ;
        nacc := nown ;
        OwnRestore (pre, npre) ;
        FOR j := 2 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME arm THEN
            IF arm.kind = Ast.NElsif THEN
              CheckCond (arm.kids[0], ctx) ;
              WalkSeq (arm.kids[1], ctx)
            ELSIF arm.kind = Ast.NElse THEN WalkSeq (arm.kids[0], ctx)
            ELSE WalkSeq (st.kids[j], ctx) END
          END ;
          arm2 := OwnSnap () ;
          narm2 := nown ;
          OwnRestore (pre, npre) ;
          OwnMergeMoves (arm2, narm2)
        END ;
        OwnMergeMoves (acc, nacc)
    | Ast.NWhile :
        CheckCond (st.kids[0], ctx) ;
        WalkSeq (st.kids[1], ctx)
    | Ast.NFor :
        CheckForBounds (st, ctx) ;
        WalkSeq (st.kids[3], ctx)
    | Ast.NLoop :
        WalkSeq (st.kids[0], ctx)
    | Ast.NBlock :
        (* handlers are collected BEFORE the guarded sequence is
           walked: what a block catches, it catches for everything
           inside it *)
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME h THEN
            IF h.kind = Ast.NHandler THEN
              IF h.kids[0] IS SOME hq THEN
                CheckExcName (hq, ctx) ;
                IF LEN (hq.b) > 0 THEN HandledAdd (hq.b)
                ELSE HandledAdd (hq.a) END
              END
            END
          END
        END ;
        WalkSeq (st.kids[0], ctx) ;
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME part THEN
            IF part.kind = Ast.NHandler THEN
              (* handler payload binders are names too -- bind them
                 (nil type) as the FPC checker does, or a use of one
                 would look like an undefined name *)
              IF part.kids[1] IS SOME hbs THEN
                FOR hk := 0 TO hbs.nkids - 1 DO
                  IF hbs.kids[hk] IS SOME hb THEN
                    IF hb.kind = Ast.NIdent THEN BindName (hb.a, NONE) END
                  END
                END
              END ;
              WalkSeq (part.kids[2], ctx)
            ELSIF part.kind = Ast.NFinally THEN WalkSeq (part.kids[0], ctx)
            END
          END
        END
    | Ast.NCase :
        CheckCaseLabels (st, ctx) ;
        CheckCaseTotal (st, ctx) ;
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME arm THEN
            IF arm.kind = Ast.NCaseArm THEN
              BindPats (arm, EscRootOf (st.kids[0])) ;
              WalkSeq (arm.kids[1], ctx)
            ELSE WalkSeq (arm.kids[0], ctx) END
          END
        END
    ELSE
      (* the statements that cannot assign need no walk yet; the
         passes that care about them arrive with their own checks *)
    END
  END
END WalkStmt ;

(* a condition is BOOL or it is a mistake *)
(* every owned candidate in scope starts alive *)
PROCEDURE OwnSeed () =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nscope - 1 DO
    IF OwnedCandKind (scope[i].name) > 0 THEN
      OwnSet (scope[i].name, 'alive')
    END
  END
END OwnSeed ;

PROCEDURE CheckCond (k: Ast.Kid ; RO ctx: STR) =
VAR t : STR ;
BEGIN
  t := ExprType (k, ctx) ;
  IF LEN (t) > 0 AND NOT Text.Eq (t, 'BOOL') THEN
    IF k IS SOME c THEN
      ErrN (c, ctx, Cat ('condition must be BOOL, not ', TyName (t)))
    END
  END
END CheckCond ;

(* THE LOOP VARIABLE IS A VARIABLE: declared, of a type its bounds
   can count in, and of that type inside the loop.  Until 2026-10-02
   FOR bound the name afresh -- with NO type here, as an I64 in the
   oracle -- over whatever had been declared.  So here every loop
   variable was unknown to the checker: `s := i` with s a string and
   `x := x + i` with x an F64 were passed over, the implicit
   conversion par 2.1 refuses let through by the one name every loop
   has; and both checkers accepted a loop variable nobody declared,
   or one declared F64.  Found by `m9c --review`, whose page for
   Stats listed a dozen passed-over sites that had only `i` in
   common.
     bound -- the bounds' type when they are an enumeration's
     enum  -- whether they are *)
PROCEDURE CheckForVar (KEPT st: PTR Ast.Node ; RO ctx: STR ; RO bound: STR ;
                       enum: BOOL) =
VAR vt : STR ;
BEGIN
  IF ScopeFind (st.a) < 0 THEN
    ErrN (st, ctx, S3 ('FOR variable ', st.a, ' is not declared')) ;
    (* bound without a type, so that its uses say nothing more *)
    BindName (st.a, NONE)
  ELSE
    vt := CanonT (ScopeType (st.a), 0) ;
    IF LEN (vt) > 0 THEN
      IF enum THEN
        IF LEN (bound) > 0 AND NOT Text.Eq (vt, bound) THEN
          ErrN (st, ctx, S5 ('FOR variable ', st.a, ' is ', TyName (vt),
            Cat (', and its bounds are ', TyName (bound))))
        END
      ELSIF NOT IsIntStr (vt) THEN
        ErrN (st, ctx, S5 ('FOR variable ', st.a, ' is ', TyName (vt),
          ': a loop over integers counts in an integer variable'))
      END
    END
  END
END CheckForVar ;

PROCEDURE CheckForBounds (KEPT st: PTR Ast.Node ; RO ctx: STR) =
  (* integer bounds, or two bounds of ONE enumeration: FOR c :=
     Colour.Red TO Colour.Blue walks the members in declaration order.
     A step is only for the integer form (docs/enum-plan.md, part 2). *)
VAR t, u : STR ;
BEGIN
  t := ExprType (st.kids[0], ctx) ;
  u := ExprType (st.kids[1], ctx) ;
  IF IsTagged (t) OR IsTagged (u) THEN
    IF NOT Text.Eq (t, u) THEN
      ErrN (st, ctx, S4 ('FOR over an enumeration needs both bounds of one type, not ',
        TyName (t), ' and ', TyName (u)))
    END ;
    IF st.kids[2] IS SOME estep THEN
      ErrN (st, ctx, 'FOR over an enumeration takes no BY step')
    END ;
    CheckForVar (st, ctx, t, TRUE) ;
    RETURN
  END ;
  IF NOT IsIntish (t) THEN
    ErrN (st, ctx, Cat ('FOR bounds must be integers, not ', TyName (t)))
  END ;
  IF NOT IsIntish (u) THEN
    ErrN (st, ctx, Cat ('FOR bounds must be integers, not ', TyName (u)))
  END ;
  IF st.kids[2] IS SOME step THEN
    t := ExprType (st.kids[2], ctx) ;
    IF NOT IsIntish (t) THEN
      ErrN (st, ctx, Cat ('FOR step must be an integer, not ', TyName (t)))
    END
  END ;
  CheckForVar (st, ctx, '', FALSE)
END CheckForBounds ;

(* a scalar CASE label must be comparable with the selector.  The
   variant labels of a CASE RECORD are names, not values, and are
   judged by CheckCaseTotal instead. *)
PROCEDURE CheckCaseLabels (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  selTy, t, lblTxt : STR ;
  j, k, m, nseen : I64 ;
  seen : ARRAY 256 OF STR ;
  dup : BOOL ;
BEGIN
  nseen := 0 ;
  selTy := ExprType (st.kids[0], ctx) ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME ll THEN
          FOR k := 0 TO ll.nkids - 1 DO
            IF ll.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelRange THEN
                IF NOT IsVariantLabel (lbl) THEN
                  t := ExprType (lbl.kids[0], ctx) ;
                  Agree (StLabel, selTy, t, lbl.line) ;
                  IF NOT (Compat (selTy, t) OR Compat (t, selTy)) THEN
                    ErrN (lbl, ctx, S4 ('CASE label is ', TyName (t),
                      ' but the selector is ', TyName (selTy)))
                  END ;
                  IF lbl.kids[1] IS SOME hi THEN
                    t := ExprType (lbl.kids[1], ctx) ;
                    Agree (StLabel, selTy, t, hi.line) ;
                    IF NOT (Compat (selTy, t) OR Compat (t, selTy)) THEN
                      ErrN (hi, ctx, S4 ('CASE label is ', TyName (t),
                        ' but the selector is ', TyName (selTy)))
                    END
                  ELSE
                    (* a repeated label is decided at compile time, and
                       until now only the C compiler decided it -- which
                       reports against generated code the author never
                       wrote.  Single literal labels only: a range needs
                       interval overlap and a CONST designator needs the
                       value, and guessing at either would be worse than
                       the gap. *)
                    lblTxt := Print.ExprText (lbl.kids[0]) ;
                    IF NOT Text.Eq (lblTxt, '') THEN
                      dup := FALSE ;
                      FOR m := 0 TO nseen - 1 DO
                        IF Text.Eq (seen[m], lblTxt) THEN dup := TRUE END
                      END ;
                      IF dup THEN
                        ErrN (lbl, ctx, S3 ('CASE label ', lblTxt,
                          ' appears twice'))
                      ELSIF nseen < 256 THEN
                        seen[nseen] := lblTxt ;
                        nseen := nseen + 1
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END CheckCaseLabels ;

(* a bare name that names a variant is a variant label, not a value *)
PROCEDURE IsVariantLabel (lbl: PTR Ast.Node) : BOOL =
VAR
  owner : STR ;
  fields : Ast.Kid ;
  m, j, v : I64 ;
BEGIN
  IF lbl.kids[1] IS SOME hi THEN RETURN FALSE END ;
  IF lbl.kids[0] IS SOME lo THEN
    IF lo.kind # Ast.NDesignator THEN RETURN FALSE END ;
    IF lo.nkids # 0 THEN RETURN FALSE END ;
    FOR m := 0 TO nmods - 1 DO
      FOR j := 0 TO mods[m].nvts - 1 DO
        FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
          IF Text.Eq (mods[m].vts[j].variants[v], lo.a) THEN
            RETURN TRUE
          END
        END
      END
    END
  END ;
  RETURN FALSE
END IsVariantLabel ;

PROCEDURE CheckReturn (st: PTR Ast.Node ; RO ctx: STR) =
VAR
  t, what : STR ;
  said : BOOL ;
BEGIN
  said := FALSE ;
  IF st.kids[0] IS SOME v THEN
    t := ExprType (st.kids[0], ctx) ;
    IF Text.Eq (curRetTy, '<void>') THEN
      ErrN (st, ctx, 'RETURN with a value in a proper procedure')
    ELSE
      IF Text.Eq (t, '<void>') THEN
        ErrN (v, ctx, 'RETURN of a call that returns no value')
      ELSE
        Agree (StReturn, curRetTy, t, v.line) ;
        IF NOT Compat (curRetTy, t) THEN
          ErrN (v, ctx, S4 ('cannot RETURN ', TyName (t),
            ' from a function of type ', TyName (curRetTy)))
        END
      END
    END ;
    (* par 4.3: a pool-interior pointer may not escape a pool that
       dies with this frame *)
    IF v.kind = Ast.NDesignator THEN
      IF v.nkids = 0 THEN
        IF ScopeType (v.a) IS SOME dcl THEN
          IF dcl.kind = Ast.NPtrType THEN
            IF dcl.kids[1] IS SOME pn THEN
              IF Text.Eq (ScopeMode (pn.a), ModeLocal) THEN
                ErrN (st, ctx, S5 ('pool-interior pointer escapes its pool: ',
                  v.a, ' lives in ', pn.a,
                  ', which dies with this frame (par 4.3)')) ;
                said := TRUE
              END
            END
          END
        END
      END
    END ;
    (* the same by SHAPE rather than by declaration: an allocation
       made in a local pool and held in a pool-less name, or a view
       of one (FrameWhat's pool kinds) -- except a string, which the
       generator re-homes out of a local pool at exit (par 2.3) *)
    IF NOT said AND NOT Text.Eq (t, 'SLICE OF CHAR') THEN
      what := FrameWhat (st.kids[0], t) ;
      IF LEN (KindPool (what)) > 0 THEN
        ErrN (st, ctx, Cat (what, ' escapes its pool, which dies with this frame (par 4.3)'))
      END
    END ;
    (* par 4.1 direction: what is RETURNed reaches the caller *)
    t := EscRootOf (st.kids[0]) ;
    IF LEN (t) > 0 THEN
      IF IsFrameMode (ScopeMode (t)) THEN EscTarget (t, '<return>') END
    END
    (* par 2.3: a string RETURN needs no refusal -- the generator
       re-homes it into the caller's arena, copying a frame-local
       designator's bytes across (m9_strdup). *)
  ELSE
    IF NOT Text.Eq (curRetTy, '<void>') THEN
      ErrN (st, ctx, 'RETURN without a value in a function')
    END
  END
END CheckReturn ;

(* ---- par 3 rule 4: a function answers on every path ----

   Can control pass this statement?  A function whose body can be
   passed reaches its END with nothing to answer, and the emitted C
   would hand back the zero its result was initialised to -- the
   uninitialised-Result class the language was founded to close,
   which until 2026-10-01 was closed for CASE alone: the tutorial's
   own Sign, with its ELSE removed, compiled and answered 0.

   STRUCTURAL and conservative, on purpose, so that the rule is one a
   reader can apply by eye: a WHILE or a FOR can always be passed; a
   LOOP only through an EXIT of its own; an IF when a branch can be
   or there is no ELSE; a CASE when an arm can be (a CASE without
   ELSE is total, CheckCaseTotal holds that); a block when its
   statements or one of its handlers can be.  A call is never an
   ending, whatever the callee does: `Fail (c, msg)` that always
   raises reads, here and to a reviewer, as a statement that returns.
   Measured before it was built: 1 function of 1,167 in the
   repository needed a RAISE of its own.                             *)

PROCEDURE EndsSeq (k: Ast.Kid) : BOOL ;

PROCEDURE HasExit (k: Ast.Kid) : BOOL =
  (* an EXIT that belongs to the LOOP whose body this is: a nested
     LOOP owns its own *)
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NExit THEN RETURN TRUE END ;
    IF n.kind = Ast.NLoop THEN RETURN FALSE END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF HasExit (n.kids[i]) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END HasExit ;

PROCEDURE EndsStmt (n: PTR Ast.Node) : BOOL =
VAR
  i : I64 ;
  hasElse : BOOL ;
BEGIN
  CASE n.kind OF
  | Ast.NReturn, Ast.NRaiseStmt :
      RETURN TRUE
  | Ast.NIf :
      IF NOT EndsSeq (n.kids[1]) THEN RETURN FALSE END ;
      hasElse := FALSE ;
      FOR i := 2 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME e THEN
          IF e.kind = Ast.NElsif THEN
            IF NOT EndsSeq (e.kids[1]) THEN RETURN FALSE END
          ELSIF e.kind = Ast.NElse THEN
            hasElse := TRUE ;
            IF NOT EndsSeq (e.kids[0]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN hasElse
  | Ast.NCase :
      FOR i := 1 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME arm THEN
          IF arm.kind = Ast.NCaseArm THEN
            IF NOT EndsSeq (arm.kids[1]) THEN RETURN FALSE END
          ELSIF arm.kind = Ast.NElse THEN
            IF NOT EndsSeq (arm.kids[0]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN n.nkids > 1
  | Ast.NLoop :
      RETURN NOT HasExit (n.kids[0])
  | Ast.NBlock :
      IF NOT EndsSeq (n.kids[0]) THEN RETURN FALSE END ;
      FOR i := 1 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME h THEN
          IF h.kind = Ast.NHandler THEN
            IF NOT EndsSeq (h.kids[2]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN TRUE
  ELSE
    RETURN FALSE
  END
END EndsStmt ;

PROCEDURE EndsSeq (k: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kids[i] IS SOME st THEN
        IF EndsStmt (st) THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END EndsSeq ;

PROCEDURE CheckProcBody (u: PTR Ast.Node ; KEPT d: PTR Ast.Node ;
                         RO KEPT ctx: STR) =
VAR rk : I64 ;
BEGIN
  IF d.kids[4] IS SOME body THEN
    (* a RAISES clause may only cite an exception the reader can find *)
    IF d.kids[2] IS SOME rsc THEN
      FOR rk := 0 TO rsc.nkids - 1 DO
        IF rsc.kids[rk] IS SOME rxn THEN CheckExcName (rxn, ctx) END
      END
    END ;
    ScopeClear () ;
    CallsClear () ;
    (* KEPT declarations are read as the params are added, so the
       list resets BEFORE AddParamsOf, not beside the walk state *)
    nkept := 0 ;
    nkeptU := 0 ;
    ncarry := 0 ;
    ncedge := 0 ;
    (* params and locals first: the lookup answers the first hit, so
       they shadow module state of the same name *)
    AddParamsOf (d) ;
    AddVarsOf (body, ModeLocal) ;
    AddModuleVars (curRoot, u) ;
    svConsts := nconsts ;
    AddConstsOf (body, ctx) ;
    curRetTy := '<void>' ;
    IF d.kids[1] IS SOME rt THEN curRetTy := CanonT (d.kids[1], 0) END ;
    OwnClear () ;
    OwnSeed () ;
    RaisedClear () ;
    (* par 4.1 direction: escape facts and pended stores are per
       procedure, and a module body's stray facts must not leak into
       the next file's first procedure *)
    nesc := 0 ;
    nedge := 0 ;
    npend := 0 ;
    nfval := 0 ;
    npval := 0 ;
    curInBody := FALSE ;
    (* par 3.2: kid 3 is the attribute, if any *)
    curPure := FALSE ;
    IF d.kids[3] IS SOME at THEN
      IF Text.Eq (at.a, 'PURE') THEN curPure := TRUE END
    END ;
    boundMon := BoundMonitorOf (d) ;
    (* par 3 rule 4, before the walk so that it is the procedure's
       first diagnostic on both sides *)
    IF d.kids[1] IS SOME rtf THEN
      IF body.kids[body.nkids - 1] IS SOME blk0 THEN
        IF NOT EndsStmt (blk0) THEN
          ErrN (d, ctx, 'a function must RETURN or RAISE on every path: '
                        + d.a + ' can reach its END (par 3)')
        END
      END
    END ;
    IF nAgg > 0 THEN
      IF body.kids[body.nkids - 1] IS SOME blk1 THEN
        AggWalk (blk1, Ast.NProcBody, ctx)
      END
    END ;
    WalkStmt (body.kids[body.nkids - 1], ctx) ;
    FlushPend (ctx) ;
    ReportUnhandled (body, ctx, RaisesOf (pool, d)) ;
    ReportImpureCalls (body, ctx) ;
    GraphSet (ctx) ;
    (* the locals go out of scope with the procedure: truncate rather
       than clear, so the module CONSTs registered before them stay *)
    nconsts := svConsts
  END
END CheckProcBody ;



(* ---- RAISES accounting ----

   Every exception a procedure can produce must appear in its RAISES
   clause, or be handled inside it.  Three sources, and the pass is
   only sound because pass 2 made every call RESOLVE: an unknown
   callee would be a blind spot, and a blind spot in this accounting
   is exactly the silence the whole design exists to remove.

     an explicit RAISE;
     a checked conversion -- I8..U64, BYTE, CHR -- which raises
       ValueRange, because Trunc (NaN) crashing FPC and answering
       INT64_MIN in numpy is the museum piece this comes from;
     a resolvable callee's declared set.

   Minus what handlers catch, minus what the clause declares, minus
   the three that are always possible and never declared: Overflow,
   IndexError and OutOfMemory.  Declaring those would put them on
   every signature in the language and so say nothing.             *)

PROCEDURE RaisedClear () =
BEGIN
  nraised := 0 ;
  nhandled := 0
END RaisedClear ;

PROCEDURE RaisedAdd (RO KEPT nm: STR ; RO KEPT origin: STR) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  FOR i := 0 TO nraised - 1 DO
    IF Text.Eq (raised[i].name, nm) THEN RETURN END   (* first wins *)
  END ;
  IF nraised = LEN (raised) THEN
    nb := NEW (pool, Binding, 2 * LEN (raised)) ;
    FOR i := 0 TO nraised - 1 DO nb[i] := raised[i] END ;
    raised := nb
  END ;
  raised[nraised].name := nm ;
  raised[nraised].mode := origin ;
  raised[nraised].ty := NONE ;
  nraised := nraised + 1
END RaisedAdd ;

PROCEDURE HandledAdd (RO KEPT nm: STR) =
VAR
  nb : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF nhandled = LEN (handled) THEN
    nb := NEW (pool, STR, 2 * LEN (handled)) ;
    FOR i := 0 TO nhandled - 1 DO nb[i] := handled[i] END ;
    handled := nb
  END ;
  handled[nhandled] := nm ;
  nhandled := nhandled + 1
END HandledAdd ;

PROCEDURE IsHandled (RO nm: STR) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nhandled - 1 DO
    IF Text.Eq (handled[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsHandled ;

(* the three that are always possible: declaring them would put them
   on every signature and so distinguish nothing *)
PROCEDURE IsUnchecked (RO nm: STR) : BOOL =
BEGIN
  RETURN Text.Eq (nm, 'Overflow') OR Text.Eq (nm, 'IndexError') OR
         Text.Eq (nm, 'OutOfMemory')
END IsUnchecked ;

PROCEDURE ScalarAlias (RO name: STR) : STR =
VAR dot : I64 ; t : STR ;
BEGIN
  (* An alias for a scalar CONVERTS under its own name.  Aliases
     already chase to structure for conformance -- `TYPE Real = F32`
     makes Real and F32 one type for assignment, arguments and RETURN
     -- so `Real (x)` meaning anything but `F32 (x)` would be the odd
     case.  The name is chased to the builtin it abbreviates and
     every conversion rule then applies unchanged.

     Forced by the port: -fdefault-real-8 is commented out
     in the original's makefile, so single precision is what ships
     and double is what the flag is for.  One source held
     bit-identical to both builds needs the default real kind to have
     a name, and that name has to convert.

     An alias for a record, a slice or anything else chases to
     something that is not a builtin, and the caller reports it as
     the unknown procedure it is. *)
  IF IsBuiltinTy (name) THEN RETURN name END ;
  dot := Text.FindChar (name, '.') ;
  IF dot > 0 THEN
    t := CanonQual (SLICE (name, 0, dot),
                    SLICE (name, dot + 1, LEN (name) - dot - 1), 0)
  ELSE
    t := CanonQual ('', name, 0)
  END ;
  IF IsBuiltinTy (t) THEN RETURN t END ;
  RETURN name
END ScalarAlias ;

PROCEDURE IsConvVR (RO nm: STR) : BOOL =
BEGIN
  RETURN Text.OneOf (nm, ConvVR)
END IsConvVR ;

(* I64 of a NARROWER integer is total: every BYTE, I8..I32, U8..U32,
   C.Int and C.SSizeT value is an I64 value.  Requiring RAISES there
   would push an untriggerable ValueRange through every caller of a
   foreign wrapper, and accounting that stops describing what can
   happen is what makes exhaustive RAISES worthless.               *)
PROCEDURE TotalWidening (RO name: STR ; RO argTy: STR) : BOOL =
BEGIN
  IF NOT Text.Eq (name, 'I64') THEN RETURN FALSE END ;
  RETURN Text.OneOf (argTy, WidensTo64)
END TotalWidening ;

PROCEDURE WalkExpr (k: Ast.Kid ; RO ctx: STR) ;

PROCEDURE WalkArgs (k: Ast.Kid ; RO ctx: STR) =
VAR i : I64 ;
BEGIN
  IF k IS SOME al THEN
    FOR i := 0 TO al.nkids - 1 DO WalkExpr (al.kids[i], ctx) END
  END
END WalkArgs ;

(* the type of an argument, when it can be known cheaply: a
   designator's declared type, or a resolvable call's return type.
   The second case is not optional -- I64 (ArgC ()) is the shape
   every foreign wrapper uses, and without it the widening rule
   misses and invents a ValueRange nobody can trigger. *)
PROCEDURE ArgCanon (k: Ast.Kid ; RO ctx: STR) : STR =
VAR
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME cd THEN
        pr := LookupProc (DesigName (cd), found) ;
        IF found THEN
          IF pr.node IS SOME pn THEN RETURN CanonT (pn.kids[1], 0) END
        END
      END ;
      RETURN ''
    END
  END ;
  RETURN DesigCanon (k, ctx)
END ArgCanon ;

PROCEDURE NoteCall (dn: PTR Ast.Node ; argl: Ast.Kid ; RO ctx: STR) =
VAR
  name, argTy : STR ;
  pr : ProcInfo ;
  found : BOOL ;
  j, jj, nf32, nf64, si : I64 ;
BEGIN
  name := DesigName (dn) ;
  (* the FPC checker chases inside CallType, which is also where it
     attributes ValueRange; this one attributes it here, so it chases
     here as well -- otherwise `TYPE Idx = I32` raises in one checker
     and not in the other, and probediff compares the text *)
  IF argl IS SOME alc THEN
    IF alc.nkids = 1 THEN name := ScalarAlias (name) END ;
    IF alc.nkids >= 1 THEN
      nf32 := 0 ;
      nf64 := 0 ;
      FOR jj := 0 TO alc.nkids - 1 DO
        argTy := ArgCanon (alc.kids[jj], ctx) ;
        IF Text.Eq (argTy, 'F32') THEN nf32 := nf32 + 1 END ;
        IF Text.Eq (argTy, 'F64') THEN nf64 := nf64 + 1 END
      END ;
      name := WidthTwin (name, nf32 > 0 AND nf64 = 0)
    END
  END ;
  IF IsConvVR (name) THEN
    argTy := '' ;
    IF argl IS SOME al THEN
      IF al.nkids > 0 THEN argTy := ArgCanon (al.kids[0], ctx) END
    END ;
    IF NOT TotalWidening (name, argTy) THEN
      RaisedAdd ('ValueRange', Cat (name, ' conversion'))
    END ;
    RETURN
  END ;
  (* the integer-to-enumeration conversion raises the same way *)
  IF LEN (EnumConvType (name)) > 0 THEN
    RaisedAdd ('ValueRange', Cat (name, ' conversion'))
  END ;
  (* a call through a procedure value raises what its TYPE declares
     (par 2.2.3); it names no procedure, so it joins no call graph *)
  si := ScopeFind (name) ;
  IF si >= 0 THEN
    IF ResolveType (scope[si].ty) IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        IF ptn.kids[2] IS SOME rs THEN
          FOR j := 0 TO rs.nkids - 1 DO
            IF rs.kids[j] IS SOME q THEN
              IF LEN (q.b) > 0 THEN
                RaisedAdd (q.b, Cat ('call to ', name))
              ELSE
                RaisedAdd (q.a, Cat ('call to ', name))
              END
            END
          END
        END ;
        RETURN
      END
    END
  END ;
  pr := LookupProc (name, found) ;
  IF NOT found THEN RETURN END ;
  CallsAdd (name) ;
  FOR j := 0 TO LEN (pr.raises) - 1 DO
    RaisedAdd (pr.raises[j], Cat ('call to ', name))
  END
END NoteCall ;

PROCEDURE WalkExpr (k: Ast.Kid ; RO ctx: STR) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN NoteCall (dn, e.kids[1], ctx) END ;
      WalkArgs (e.kids[1], ctx) ;
      RETURN
    END ;
    FOR i := 0 TO e.nkids - 1 DO WalkExpr (e.kids[i], ctx) END
  END
END WalkExpr ;

PROCEDURE ReportUnhandled (body: PTR Ast.Node ; RO ctx: STR ;
                           declared: SLICE OF STR) =
VAR
  i, j : I64 ;
  ok : BOOL ;
BEGIN
  FOR i := 0 TO nraised - 1 DO
    IF NOT IsUnchecked (raised[i].name) THEN
      IF NOT IsHandled (raised[i].name) THEN
        ok := FALSE ;
        FOR j := 0 TO LEN (declared) - 1 DO
          IF Text.Eq (declared[j], raised[i].name) THEN ok := TRUE END
        END ;
        IF NOT ok AND LEN (showName) > 0 THEN
          (* m9c --show's probe: its body is the one shown statement,
             and what it raises is what the program around it must
             handle -- recorded, not refused *)
          IF NOT Text.Contains (shownRaises, ' ' + raised[i].name + ' ') THEN
            shownRaises := Text.Keep (pool, shownRaises + raised[i].name + ' ')
          END
        ELSIF NOT ok THEN
          ErrN (body, ctx, Cat (Cat (Cat ('unhandled RAISES ',
            raised[i].name), ' from '), raised[i].mode))
        END
      END
    END
  END
END ReportUnhandled ;

(* par 3.2 rule 3: a PURE procedure may call only PURE procedures.

   This is what makes "no I/O" true without the checker knowing what
   I/O is -- a foreign procedure carries [SERIAL] or [REENTRANT] and
   is therefore never PURE, and neither is Io.WriteLine, so neither
   can be reached from a PURE body.  Purity is transitive by
   construction rather than by a second analysis.

   A callee that does not resolve to a declared procedure is a
   builtin -- LEN, ORD, a checked conversion, a variant constructor
   -- and those are pure, so they are skipped. *)
PROCEDURE ReportImpureCalls (body: PTR Ast.Node ; RO ctx: STR) =
VAR
  i : I64 ;
  found : BOOL ;
  pr : ProcInfo ;
BEGIN
  IF NOT curPure THEN RETURN END ;
  FOR i := 0 TO ncalls - 1 DO
    pr := LookupProc (calls[i], found) ;
    IF found THEN
      IF NOT Text.Eq (pr.attrib, 'PURE') THEN
        ErrN (body, ctx, Cat (Cat ('PURE procedure calls ', calls[i]),
          ', which is not PURE (par 3.2)'))
      END
    END
  END
END ReportImpureCalls ;

(* ---- the call graph, and THREAD reachability ----

   A [SERIAL] foreign procedure keeps global state, so calling one
   from two threads corrupts it.  That is not a hypothetical: the
   blosc_decompress race is the museum piece this pass exists for,
   and it is the reason [SERIAL] is mandatory on every foreign
   declaration -- an unstated contract cannot be checked.

   The rule is REACHABILITY, not adjacency.  A THREAD root reaching a
   SERIAL procedure through any chain of calls is the bug, so this
   walks the graph rather than the call site.  Reported at 0:0
   because the fault is a path and not a line.                      *)

PROCEDURE GraphClear () =
BEGIN
  ngraph := 0 ;
  nroots := 0
END GraphClear ;

PROCEDURE CallsClear () =
BEGIN
  ncalls := 0
END CallsClear ;

PROCEDURE CallsAdd (RO KEPT nm: STR) =
VAR
  nb : SLICE OF STR ;
  i : I64 ;
BEGIN
  FOR i := 0 TO ncalls - 1 DO
    IF Text.Eq (calls[i], nm) THEN RETURN END
  END ;
  IF ncalls = LEN (calls) THEN
    nb := NEW (pool, STR, 2 * LEN (calls)) ;
    FOR i := 0 TO ncalls - 1 DO nb[i] := calls[i] END ;
    calls := nb
  END ;
  calls[ncalls] := nm ;
  ncalls := ncalls + 1
END CallsAdd ;

PROCEDURE GraphSet (RO KEPT caller: STR) =
VAR
  nb : SLICE OF Edge ;
  cs : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF ngraph = LEN (graph) THEN
    nb := NEW (pool, Edge, 2 * LEN (graph)) ;
    FOR i := 0 TO ngraph - 1 DO nb[i] := graph[i] END ;
    graph := nb
  END ;
  cs := NEW (pool, STR, ncalls) ;
  FOR i := 0 TO ncalls - 1 DO cs[i] := calls[i] END ;
  graph[ngraph].caller := caller ;
  graph[ngraph].callees := cs ;
  ngraph := ngraph + 1
END GraphSet ;

PROCEDURE GraphFind (RO caller: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ngraph - 1 DO
    IF Text.Eq (graph[i].caller, caller) THEN RETURN i END
  END ;
  RETURN -1
END GraphFind ;

PROCEDURE RootAdd (RO KEPT nm: STR) =
VAR
  nb : SLICE OF STR ;
  i : I64 ;
BEGIN
  IF nroots = LEN (roots) THEN
    nb := NEW (pool, STR, 2 * LEN (roots)) ;
    FOR i := 0 TO nroots - 1 DO nb[i] := roots[i] END ;
    roots := nb
  END ;
  roots[nroots] := nm ;
  nroots := nroots + 1
END RootAdd ;

PROCEDURE CheckThreadChains () =
VAR
  i, j, k, gi, nwork, nseen : I64 ;
  work, seen : SLICE OF STR ;
  c : STR ;
  pr : ProcInfo ;
  found, already : BOOL ;
BEGIN
  FOR i := 0 TO nroots - 1 DO
    work := NEW (pool, STR, 64) ;
    seen := NEW (pool, STR, 64) ;
    nwork := 0 ;
    nseen := 0 ;
    work[0] := roots[i] ;
    nwork := 1 ;
    WHILE nwork > 0 DO
      c := work[0] ;
      FOR j := 0 TO nwork - 2 DO work[j] := work[j + 1] END ;
      nwork := nwork - 1 ;
      already := FALSE ;
      FOR j := 0 TO nseen - 1 DO
        IF Text.Eq (seen[j], c) THEN already := TRUE END
      END ;
      IF NOT already THEN
        IF nseen < LEN (seen) THEN
          seen[nseen] := c ;
          nseen := nseen + 1
        END ;
        pr := LookupProc (c, found) ;
        IF found THEN
          IF Text.Eq (pr.attrib, 'SERIAL') THEN
            Diag (errs, nerrs, 0, 0, roots[i],
              Cat (Cat (Cat (
                'SERIAL procedure called from THREAD context (',
                roots[i]), ' reaches '), Cat (c, ')')))
          END
        END ;
        gi := GraphFind (Qualify (curMod, c)) ;
        IF gi < 0 THEN gi := GraphFind (c) END ;
        IF gi >= 0 THEN
          FOR k := 0 TO LEN (graph[gi].callees) - 1 DO
            IF nwork < LEN (work) THEN
              work[nwork] := graph[gi].callees[k] ;
              nwork := nwork + 1
            END
          END
        END
      END
    END
  END
END CheckThreadChains ;

(* ---- A MODULE IS NAMED ONLY WHERE IT IS IMPORTED (report par 3,
   rule 5; Alex's decision of 2026-10-02).  The checker is handed the
   whole import closure, and every lookup asks FindMod, which knows
   all of it -- so `Text.Keep' compiled in a program that imported
   only Check, because Check imports Text.  What a module depends on
   was not readable off its IMPORT lines.

   One pass over the unit's tree, the same walk in both checkers.  A
   qualified name -- a qualident `M.T', or a designator `M.x...' --
   whose first part is a module the checker knows must be imported
   by the module that writes it: by its definition or by its
   implementation, either serves both (2,302 sites in 55 files lean
   on that, measured).  A name declared in the enclosing procedure,
   or at the module's own level, is that name and not the module.
   Said ONCE a module and unit: the mistake is one missing line. ---- *)

(* does the module `me' -- any unit of that name in the file --
   import `name', or is it `name' itself? *)
PROCEDURE ModImports (root: PTR Ast.Node ; RO me: STR ; RO name: STR) : BOOL =
VAR i, j, k : I64 ;
BEGIN
  IF Text.Eq (me, name) THEN RETURN TRUE END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF Text.Eq (u.a, me) THEN
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME imp THEN
            IF imp.kind = Ast.NFromImport THEN
              IF Text.Eq (imp.a, name) THEN RETURN TRUE END
            ELSIF imp.kind = Ast.NImportList THEN
              IF imp.kids[0] IS SOME ids THEN
                FOR k := 0 TO ids.nkids - 1 DO
                  IF ids.kids[k] IS SOME id THEN
                    IF Text.Eq (id.a, name) THEN RETURN TRUE END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ModImports ;

(* is `name' declared under k: a variable, parameter, binder, type,
   constant or exception? *)
PROCEDURE DeclaresName (k: Ast.Kid ; RO name: STR) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NIdent OR n.kind = Ast.NIsSome OR n.kind = Ast.NTypeDecl
       OR n.kind = Ast.NConstDecl OR n.kind = Ast.NExcDecl THEN
      IF Text.Eq (n.a, name) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF DeclaresName (n.kids[i], name) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DeclaresName ;

(* in the procedure or module body `scope', or at the level of the
   module `me' *)
PROCEDURE NameShadowed (root: PTR Ast.Node ; RO me: STR ; scope: Ast.Kid ;
                        RO name: STR) : BOOL =
VAR i, j : I64 ;
BEGIN
  IF DeclaresName (scope, name) THEN RETURN TRUE END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF Text.Eq (u.a, me) THEN
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME d THEN
            IF d.kind # Ast.NProcDecl AND d.kind # Ast.NModBody
               AND d.kind # Ast.NImportList AND d.kind # Ast.NFromImport THEN
              IF DeclaresName (u.kids[j], name) THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END NameShadowed ;

PROCEDURE ImportWalk (root: PTR Ast.Node ; u: PTR Ast.Node ; scope: Ast.Kid ;
                      k: Ast.Kid ; VAR seen: SLICE OF BOOL) =
VAR
  i, m : I64 ;
  qualified : BOOL ;
BEGIN
  IF k IS SOME n THEN
    qualified := FALSE ;
    IF n.kind = Ast.NQualident THEN
      qualified := LEN (n.b) > 0
    ELSIF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
      IF n.kids[0] IS SOME sel THEN qualified := sel.kind = Ast.NSelField END
    END ;
    IF qualified THEN
      m := FindMod (n.a) ;
      IF m >= 0 AND m < LEN (seen) THEN
        IF NOT seen[m] THEN
          IF NOT ModImports (root, u.a, n.a) THEN
            IF NOT NameShadowed (root, u.a, scope, n.a) THEN
              seen[m] := TRUE ;
              ErrN (n, u.a, 'module ' + n.a +
                    ' is named and not imported: write IMPORT ' + n.a +
                    ' (par 3)')
            END
          END
        END
      END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kind = Ast.NProcDecl OR n.kind = Ast.NModBody THEN
        ImportWalk (root, u, k, n.kids[i], seen)
      ELSE
        ImportWalk (root, u, scope, n.kids[i], seen)
      END
    END
  END
END ImportWalk ;

(* ---- AN IMPORTED VARIABLE IS ONE NAME (decision 28, 2026-10-04).
   A definition's VARs are the module's exports, read and written by
   an importer as Mod.v (Modula-2's rule; Alex: "rw").  Rather than
   teach every procedure that walks a designator from its root --
   typing, RO, the frame and escape rules, the pool root -- that a
   root can be two names, the designator Mod.v... is REWRITTEN, once,
   to the designator rooted at the single name `Mod.v', which no
   identifier can spell, and that name is in scope as a module
   variable of the definition's type (AddModuleVars).  Every rule
   then applies to it as to any module variable.  After CheckImports,
   so that a module named and not imported is still said so; only
   for a module this one imports, and not where a local or module
   name of the same spelling shadows it (NameShadowed, decision 24's
   test).  The generator makes the same rewrite (Gen.ExportWalk), so
   both ends agree without the generator depending on the checker. *)

(* `a.b', in the module's own pool and not the node's: the node's
   pool, named through a binder on a module table, was the walk's own
   frame in the generator, and the name dangled once the walk returned
   (`unknown name: const vo', 2026-10-04) *)
PROCEDURE DotJoin (RO a, b: STR) : STR =
VAR
  s : SLICE OF CHAR ;
  i : I64 ;
BEGIN
  s := NEW (pool, CHAR, LEN (a) + 1 + LEN (b)) ;
  FOR i := 0 TO LEN (a) - 1 DO s[i] := a[i] END ;
  s[LEN (a)] := '.' ;
  FOR i := 0 TO LEN (b) - 1 DO s[LEN (a) + 1 + i] := b[i] END ;
  RETURN s
END DotJoin ;

PROCEDURE ExportWalk (VAR n: PTR Ast.Node ; root: PTR Ast.Node ; RO me: STR ;
                      scope: Ast.Kid) =
VAR
  i, m : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
    IF n.kids[0] IS SOME s THEN
      IF s.kind = Ast.NSelField AND NOT Text.Eq (n.a, me) THEN
        m := FindMod (n.a) ;
        IF ExportsVar (m, s.a) THEN
          IF ModImports (root, me, n.a) AND
             NOT NameShadowed (root, me, scope, n.a) THEN
            n.a := DotJoin (n.a, s.a) ;
            FOR i := 0 TO n.nkids - 2 DO n.kids[i] := n.kids[i + 1] END ;
            n.nkids := n.nkids - 1
          END
        END
      END
    END
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN
      IF n.kind = Ast.NProcDecl OR n.kind = Ast.NModBody THEN
        ExportWalk (c, root, me, SOME (n))
      ELSE
        ExportWalk (c, root, me, scope)
      END
    END
  END
END ExportWalk ;

(* the module variables a body of unit u sees, after its parameters
   and locals: u's own; its definition's, when u is an implementation
   (until 2026-10-04 an implementation did not see them, and `xs :=
   5' for a SLICE OF F64 xs was passed over as untyped); and every
   other module's exports by their qualified names *)
PROCEDURE AddModuleVars (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  i, m, k : I64 ;
BEGIN
  AddVarsOf (u, ModeModule) ;
  IF u.kind = Ast.NImplementation THEN
    FOR i := 0 TO root.nkids - 1 DO
      IF root.kids[i] IS SOME du THEN
        IF du.kind = Ast.NDefinition AND Text.Eq (du.a, u.a) THEN
          AddVarsOf (du, ModeModule)
        END
      END
    END
  END ;
  FOR m := 0 TO nmods - 1 DO
    IF NOT Text.Eq (mods[m].name, u.a) THEN
      FOR k := 0 TO mods[m].nvrs - 1 DO
        ScopeAdd (Qualify (mods[m].name, mods[m].vrNames[k]),
                  mods[m].vrTypes[k], ModeModule) ;
        scope[nscope - 1].ro := mods[m].vrRo[k]
      END
    END
  END
END AddModuleVars ;

PROCEDURE CheckImports (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  seen : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  seen := NEW (BOOL, nmods) ;
  FOR i := 0 TO u.nkids - 1 DO
    ImportWalk (root, u, NONE, u.kids[i], seen)
  END
END CheckImports ;

(* ---- A NAME IS DECLARED ONCE IN ITS SCOPE (report par 3, rule 6;
   2026-10-03).  Neither checker had a word for a name declared twice:
   a module CONST written a second time, a VAR, a TYPE, a local beside
   a parameter of the same name -- each passed `--check' and was the C
   compiler's to refuse, and a PROCEDURE declared twice was not even
   that: the generator kept the second body and dropped the first,
   and the program built and ran with half its code gone.  Found
   lifting Chart into Plot, whose second `Ink' met the first.

   One pass over the unit, the same in both checkers: the module's
   own level -- every CONST, TYPE, VAR, EXCEPTION and PROCEDURE name,
   across its sections -- and each procedure's parameters and locals
   together.  Refused at the SECOND declaration, naming the line of
   the first.  A local named like a module-level name is a shadow and
   stays legal (decision 20); the two units of a module are two
   scopes, since the implementation re-declares what the definition
   heads.  A FORWARD declaration -- a heading without a body -- is
   closed by the one declaration with a body that follows it (the
   toolchain has 46), and nothing else may close it or follow that.
   Measured over 425 files here and in two applications: the 46
   forwards and TWO real duplicates, both in the shipped library --
   `Csv.ColF64' declared twice with the same body, and the constant
   `NetCDF.ModeNetcdf4'.
   Not covered: an enumeration's members, a binder. ---- *)

CONST
  DeclPlain = 0 ;      (* a constant, type, variable, exception, parameter *)
  DeclForward = 1 ;    (* a procedure heading without a body *)
  DeclBody = 2 ;       (* a procedure with its body *)

(* `id' declares `id.a' in the scope whose names so far are
   names[0 .. n): refuse the second, or add the first *)
PROCEDURE DeclOnce (KEPT id: PTR Ast.Node ; what: I64 ; RO me: STR ; RO where: STR ;
                    VAR names: SLICE OF STR ; VAR lines: SLICE OF I64 ;
                    VAR open: SLICE OF BOOL ; VAR n: I64) =
VAR
  i : I64 ;
  ns : SLICE OF STR ;
  ls : SLICE OF I64 ;
  os : SLICE OF BOOL ;
BEGIN
  FOR i := 0 TO n - 1 DO
    IF Text.Eq (names[i], id.a) THEN
      IF open[i] AND what = DeclBody THEN
        open[i] := FALSE
      ELSE
        ErrN (id, me, id.a + ' is declared twice in ' + where +
              ': the first is at line ' + ItoA (lines[i]) + ' (par 3)')
      END ;
      RETURN
    END
  END ;
  (* a name entered for the first time -- not the body that closes a
     FORWARD, which returned above *)
  IF Text.Eq (id.a, 'NaN') THEN
    ErrN (id, me, 'NaN is predeclared, the quiet NaN: a declaration may'
          + ' not take its name (par 2.1)')
  END ;
  IF n = LEN (names) THEN
    ns := NEW (pool, STR, 2 * n + 16) ;
    ls := NEW (pool, I64, 2 * n + 16) ;
    os := NEW (pool, BOOL, 2 * n + 16) ;
    FOR i := 0 TO n - 1 DO
      ns[i] := names[i] ;
      ls[i] := lines[i] ;
      os[i] := open[i]
    END ;
    names := ns ;
    lines := ls ;
    open := os
  END ;
  names[n] := id.a ;
  lines[n] := id.line ;
  open[n] := what = DeclForward ;
  n := n + 1
END DeclOnce ;

(* the names a declaration section declares: a CONST, TYPE or
   EXCEPTION declaration is its own name, a VAR declaration the
   identifiers of its list *)
PROCEDURE SectionNames (sec: Ast.Kid ; RO me: STR ; RO where: STR ;
                        VAR names: SLICE OF STR ; VAR lines: SLICE OF I64 ;
                        VAR open: SLICE OF BOOL ; VAR n: I64) =
VAR i, j : I64 ;
BEGIN
  IF sec IS SOME s THEN
    IF s.kind = Ast.NConstSection OR s.kind = Ast.NTypeSection
       OR s.kind = Ast.NExcSection THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME d THEN
          DeclOnce (d, DeclPlain, me, where, names, lines, open, n)
        END
      END
    ELSIF s.kind = Ast.NVarSection THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME d THEN
          IF d.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                DeclOnce (id, DeclPlain, me, where, names, lines, open, n)
              END
            END
          END
        END
      END
    END
  END
END SectionNames ;

PROCEDURE CheckDeclaredOnce (u: PTR Ast.Node) =
VAR
  names : SLICE OF STR ;
  lines : SLICE OF I64 ;
  open : SLICE OF BOOL ;
  n, i, j, k, what : I64 ;
  where : STR ;
BEGIN
  names := NEW (pool, STR, 64) ;
  lines := NEW (pool, I64, 64) ;
  open := NEW (pool, BOOL, 64) ;
  n := 0 ;
  where := 'module ' + u.a ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        what := DeclForward ;
        IF d.nkids > 4 THEN
          IF d.kids[4] IS SOME body THEN what := DeclBody END
        END ;
        DeclOnce (d, what, u.a, where, names, lines, open, n)
      ELSE
        SectionNames (u.kids[i], u.a, where, names, lines, open, n)
      END
    END
  END ;
  (* each procedure: its parameters, then its locals, one scope *)
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME p THEN
      IF p.kind = Ast.NProcDecl THEN
        n := 0 ;
        where := 'procedure ' + p.a ;
        IF p.kids[0] IS SOME params THEN
          FOR j := 0 TO params.nkids - 1 DO
            IF params.kids[j] IS SOME pr THEN
              IF pr.kids[0] IS SOME ids THEN
                FOR k := 0 TO ids.nkids - 1 DO
                  IF ids.kids[k] IS SOME id THEN
                    DeclOnce (id, DeclPlain, u.a, where, names, lines, open, n)
                  END
                END
              END
            END
          END
        END ;
        IF p.nkids > 4 THEN
          IF p.kids[4] IS SOME body THEN
            FOR j := 0 TO body.nkids - 1 DO
              SectionNames (body.kids[j], u.a, where, names, lines, open, n)
            END
          END
        END
      END
    END
  END
END CheckDeclaredOnce ;

(* an IMPLEMENTATION sees the constants of its DEFINITION, the unit of
   the same name in this file.  It saw only its own until 2026-10-02,
   so `n := K` -- K a real constant of the definition, n an I64 --
   passed here, built, and answered 1 for 1.5, while a client's
   `n := Mod.K` was refused.  Found by --review: Http's page listed
   MaxWait as passed over wherever the implementation used it.

   Called AFTER the implementation's own constants are in, and adds
   only a name that is not: a constant the implementation declares
   under the same name is the implementation's. *)
PROCEDURE AddDefConsts (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  i, j, k : I64 ;
  seen : BOOL ;
  ty : STR ;
BEGIN
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME d THEN
      IF d.kind = Ast.NDefinition AND LEN (d.b) = 0 AND Text.Eq (d.a, u.a) THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cs THEN
            IF cs.kind = Ast.NConstSection THEN
              FOR k := 0 TO cs.nkids - 1 DO
                IF cs.kids[k] IS SOME cd THEN
                  ty := ConstType (cd.a, seen) ;
                  IF NOT seen THEN ConstAdd (cd.a, LitType (cd.kids[0])) END
                END
              END
            END
          END
        END
      END
    END
  END
END AddDefConsts ;

PROCEDURE CheckFile (KEPT root: PTR Ast.Node) =
VAR i, j, k, fm : I64 ;
BEGIN
  Setup () ;
  GraphClear () ;
  curRoot := root ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      curMod := u.a ;
      curUnsafe := u.f1 ;
      (* FROM csock IMPORT Read, Write: a bare callee names its
         module through this, and without it the resolution would
         fall back to the current module and miss *)
      FromClear () ;
      FOR j := 0 TO u.nkids - 1 DO
        IF u.kids[j] IS SOME imp THEN
          IF imp.kind = Ast.NFromImport THEN
            (* FROM is for foreign FOR-C units only (there is no
               u.m9 to resolve).  A FROM of a loaded M9 module is a
               Modula-2 habit the generator cannot honour -- catch
               it HERE, at the mistake, not as a gen error later *)
            fm := FindMod (imp.a) ;
            IF fm >= 0 THEN
              IF LEN (mods[fm].foreignLang) = 0 THEN
                ErrN (imp, u.a,
                  'FROM imports from a foreign FOR-C unit; ' + imp.a +
                  ' is an M9 module -- use IMPORT ' + imp.a +
                  ' and write ' + imp.a + '.Name')
              END
            END ;
            IF imp.kids[0] IS SOME ids THEN
              FOR k := 0 TO ids.nkids - 1 DO
                IF ids.kids[k] IS SOME id THEN FromAdd (id.a, imp.a) END
              END
            END
          END
        END
      END ;
      CheckImports (root, u) ;
      ExportWalk (u, root, u.a, NONE) ;
      CheckDeclaredOnce (u) ;
      (* module CONSTs, so a designator naming one has a type *)
      ConstClear () ;
      FOR j := 0 TO u.nkids - 1 DO
        IF u.kids[j] IS SOME cs THEN
          IF cs.kind = Ast.NConstSection THEN
            FOR k := 0 TO cs.nkids - 1 DO
              IF cs.kids[k] IS SOME cd THEN
                IF u.kind = Ast.NDefinition THEN
                  CheckAggregate (cd, u.a, 1)
                ELSE
                  CheckAggregate (cd, u.a, 0)
                END ;
                ConstAdd (cd.a, LitType (cd.kids[0]))
              END
            END
          END
        END
      END ;
      IF u.kind = Ast.NImplementation THEN AddDefConsts (root, u) END ;
      IF u.kind = Ast.NDefinition AND LEN (u.b) > 0 THEN
        CheckForeignDef (u)
      ELSE
        (* declarations before bodies: a type spelled wrong is
           reported where it is written, once, ahead of whatever the
           bodies make of a variable that has no type *)
        CheckDeclTypes (u) ;
        IF u.kind = Ast.NImplementation THEN CheckConformance (u) END ;
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME d THEN
            IF d.kind = Ast.NProcDecl THEN
              CheckProcBody (u, d, Qualify (u.a, d.a))
            ELSIF d.kind = Ast.NModBody THEN
              (* the module body is a frame too, and the one with no
                 caller: its ctx is 'Mod body', as the oracle says *)
              ScopeClear () ;
              CallsClear () ;
              AddModuleVars (curRoot, u) ;
              curRetTy := '<void>' ;
              RaisedClear () ;
              (* never PURE, and the flag must be CLEARED rather than
                 inherited from whichever procedure was checked last
                 -- it leaked into this frame on the first run of the
                 host side and reported the body writing its own
                 module variables *)
              curPure := FALSE ;
              nfval := 0 ;
              npval := 0 ;
              curInBody := TRUE ;
              boundMon := '' ;      (* a module body binds no monitor *)
              IF nAgg > 0 THEN
                AggWalk (d, Ast.NModBody, Cat (u.a, ' body'))
              END ;
              WalkStmt (d.kids[0], Cat (u.a, ' body')) ;
              (* the module body has no caller to declare RAISES to,
                 and so no clause: whatever it can raise, it must
                 handle.  museum/trunc-nan is exactly this. *)
              ReportUnhandled (d, Cat (u.a, ' body'),
                NEW (pool, STR, 0)) ;
              GraphSet (Cat (u.a, ' body'))
            END
          END
        END
      END
    END
  END ;
  CheckThreadChains ()
END CheckFile ;

PROCEDURE ShowType (RO KEPT name: STR) =
BEGIN
  showName := name ;
  shownRaises := ' '
END ShowType ;

PROCEDURE ShownRaises () : STR =
BEGIN
  RETURN shownRaises
END ShownRaises ;

PROCEDURE ShownType () : STR =
BEGIN
  RETURN shown
END ShownType ;

END Sem.
