STATEFUL DEFINITION MODULE Sem ;

(* The semantic checker, in M9 -- restated from host/fpc/M9Sem.pas,
   which is its differential oracle.  A checker's output IS its
   diagnostics: their text, their line and column, and the order they
   were produced in.  So that is the whole comparison, exactly as
   byte-identical C was the whole comparison for the generator, and
   host/fpc/semdump.pas is the oracle that prints it.

   Errors are values here as everywhere: nothing halts, every problem
   lands in the list with a position, and checking continues.  An
   unknown type never diagnoses -- softness is the contract, because
   a checker that guesses produces diagnostics nobody can act on.

   Built in passes, in the order the oracle grew them, so each is
   differentially verified before the next is written.               *)

IMPORT Ast ;

PROCEDURE LoadFile (VAR root: PTR Ast.Node) ;
  (* every unit of every file must be loaded before ANY is checked:
     cross-module names resolve against this registry, and a name
     that is not yet loaded is indistinguishable from one that does
     not exist                                                       *)

PROCEDURE CheckFile (VAR KEPT root: PTR Ast.Node) ;
  (* checks one parsed file, after LoadFile has registered it and
     every module it imports.  It does not raise and it does not
     halt: ERRORS ARE VALUES here, collected and read back through
     the two procedures below, because a checker that stops at the
     first mistake makes the caller run it once per mistake.

       root -- the NFile node Parse.File answered.  Its declarations
               must already be loaded, or names from them resolve to
               nothing and every use is reported unknown.          *)

PROCEDURE ErrCount () : I64 ;
PROCEDURE ErrAt (i: I64) : UTF RAISES IndexError ;
  (* the diagnostics, in the order they were found, each already
     formatted with its line:col.

       i -- 0 .. ErrCount - 1.  These are MODULE state and belong to
            the last CheckFile: the compiler holds one file's
            registries at a time and a process is the reset, which
            is the same rule m9c states in its own header.        *)

PROCEDURE LedgerCount () : I64 ;
PROCEDURE LedgerAt (i: I64) : UTF RAISES IndexError ;
  (* the par 4.1 contortion ledger: measured, not rejected.  The
     kill-gate reads this, so it is output and not a debug aside --
     a ledger that silently stops seeing a borrow understates the
     rate the gate is judged on, which has happened once already.   *)

CONST
  StatKinds = 7 ;
  StatSites = 6 ;

PROCEDURE SetStrUtf (on: BOOL) ;
  (* THE SWITCH, REHEARSED (docs/utf8-stage4-plan.md, 4d behind a flag;
     Alex, 2026-10-24): with SetStrUtf (TRUE) before CheckFile, STR
     names the UTF type -- a subscript or a LEN of one is refused as a
     UTF's is, STR (u) and UTF (s) are identities -- and the twins
     collapse: a procedure X whose module declares XUtf is not checked
     (its body is the one the switch deletes) and every call of X is
     a call of XUtf.  `m9c --utf-str'.  Off, nothing changes. *)
PROCEDURE SetRegions (on: BOOL) ;
PROCEDURE RegionCount () : I64 ;
PROCEDURE RegionAt (i: I64) : UTF RAISES IndexError ;
  (* the one region judgement of docs/region-plan.md, in SHADOW: with
     SetRegions (TRUE) before CheckFile, every procedure body is also
     walked by it, and what it finds -- `regions: KIND: ...' -- is
     listed here and refused nowhere, to be measured against the
     diagnostics before it replaces any of them.  m9c prints the list
     under M9_REGIONS=1.                                        *)

PROCEDURE StatName (i: I64) : UTF ;
PROCEDURE StatChecked (i: I64) : I64 ;
PROCEDURE StatSkipped (i: I64) : I64 ;
PROCEDURE StatLines (i: I64) : I64 ;
PROCEDURE StatLine (i, j: I64) : I64 ;
  (* what the checker EXAMINED and what it PASSED OVER, for `m9c
     --review`.  This checker never diagnoses an unknown type -- that
     softness is its contract -- so a site where one side had no type
     was accepted without being looked at, and "it compiled" does not
     say how many of those there were.  These do.

       i -- 0 .. StatKinds - 1: assignments, arguments, RETURN values,
            operands, CASE labels, THREAD arguments (each a place two
            types are held to each other: checked when both are
            known, skipped when either is not), and CASE over
            variants (checked when it was held to be total, skipped
            when the selector's type could not be resolved).
       j -- 0 .. StatLines (i) - 1: StatLine (i, j) is the source
            line of a site of kind i that was passed over, the first
            StatSites different lines in the order they were met.

     Module state like the diagnostics, and for the same reason: they
     accumulate over every CheckFile of the process.                *)

PROCEDURE ThreadWrites () : I64 ;
PROCEDURE ThreadWrite (i: I64) : UTF ;
  (* the THREADs whose target, or what it calls that the checker can
     follow, WRITES a variable of a STATEFUL module that is not a
     monitor (report par 6), for `m9c --review'.  Not a refusal (Alex,
     2026-10-11): the one such site measured, the zarr proxy's reaper,
     is correct because the thread is joined before its counter is
     read, and no checker sees a join.  So it is listed, as a thing
     the reviewer reads.

       i -- 0 .. ThreadWrites () - 1: `LINE TARGET writes Mod.v
            (Mod.P, line N)', the THREAD's line first, as the page
            prints a site.                                         *)

PROCEDURE StaleCalls () : I64 ;
PROCEDURE StaleCall (i: I64) : UTF ;
  (* the calls of a STR procedure whose module declares a UTF twin --
     the DEPRECATED forms of the transition (docs/utf8-plan.md, (C)) --
     for `m9c --review', so a module sees the edits it still owes by
     name.  A call inside the module declaring both is not one: a
     module using its own STR forms is the transition itself.

       i -- 0 .. StaleCalls () - 1: `LINE Mod.P -> Mod.PUtf', the call's
            line first, as the page prints a site.                  *)

PROCEDURE AdrSites () : I64 ;
PROCEDURE AdrSite (i: I64) : UTF ;
  (* every ADR of the unit, the trust points where C reads or writes M9
     storage the checker cannot follow (2026-10-26, the third review's
     trust advice): `LINE reads|writes|descriptor in Proc', for `m9c
     --review''s TRUSTED rows, so a new one is a reviewed diff.

       i -- 0 .. AdrSites () - 1                                     *)

PROCEDURE StrSites () : I64 ;
PROCEDURE StrSite (i: I64) : UTF ;
  (* every use of a STR the UTF-8 switch refuses -- a subscript, a
     write through one, a LEN (docs/utf8-stage4-plan.md) -- by the
     DECLARED type: STR or an alias of it, not SLICE OF CHAR spelled
     out, which stays a character array.  For `m9c --review', so a
     module reads the edits the switch will ask of it before it comes:
     Text.BAt or CpAt, FOR c IN s, Text.BLen or CpCount.  Each node
     once; a write is listed beside its subscript.  A site inside a
     STR procedure whose UTF twin this module declares (`X' beside
     `XUtf') is NOT one: the switch deletes that body with the twins'
     collapse, so it is no edit anybody makes.

       i -- 0 .. StrSites () - 1: `LINE KIND what', KIND one of index,
            write, len, the line first, as the page prints a site.  *)

PROCEDURE ShowType (RO KEPT name: UTF) ;
PROCEDURE ShownType () : UTF ;
  (* for `m9c --show`, which asks the type of an expression
     (docs/kernel-show-plan.md): armed with a name, the checker
     records the type it computes for the right side of an
     assignment to that bare name and does not hold the two sides to
     each other -- the left side is a placeholder.  ShownType answers
     the last such type, in the checker's canonical spelling (`SLICE
     OF F64`, `PTR Frame.Fr`, `a real literal`), '' if none was
     met or a side was unknown.  M9 side only, like the counters
     above: nothing in the Pascal twin calls it.                    *)

PROCEDURE ShownRaises () : UTF ;
  (* while armed, the checked exceptions a body raises and does not
     handle are recorded here instead of refused: the names, each
     followed by a blank, after a leading blank (' ValueRange ') *)

END Sem.


IMPLEMENTATION MODULE Sem ;

(* STATEFUL because the registry spans files: LoadFile accumulates
   across every unit before CheckFile runs against any of them.      *)

IMPORT Ast ;
IMPORT DynUtf ;
IMPORT Print ;
IMPORT Text ;

CONST
  (* the kinds of site the review counters distinguish; the order is
     StatName's and the page's *)
  StAssign = 0 ; StArg = 1 ; StReturn = 2 ; StOperand = 3 ;
  StLabel = 4 ; StThread = 5 ; StCase = 6 ;
  MaxDepth = 8 ;              (* alias-chasing bound, as the oracle *)
  (* binding modes, one letter each, as the oracle spells them *)
  ModeVal = 'p' ; ModeVar = 'v' ; ModeOwn = 'o' ; ModeRo = 'r' ;
  ModeLocal = 'l' ; ModeModule = 'm' ; ModeBinder = 'b' ;

TYPE
  AKid = Ast.Kid ;

  (* a name -> index table (NxFind/NxAdd): open addressing over a power
     of two, a slot live while its generation is the table's, so NxClear
     empties it at once.  The FIRST entry of a name wins -- the linear
     scans it replaced answered the first hit.  Speed only: ScopeFind,
     FindProcIn and DeclOnce were scans, quadratic in a procedure's
     locals and a module's procedures (the review's F5) *)
  NameIx = RECORD
    keys : SLICE OF UTF ;
    vals, gens : SLICE OF I64 ;
    gen, n : I64 ;
  END ;

  ProcInfo = RECORD
    name, foreign, attrib, modName, sig : UTF ;
    raises : SLICE OF UTF ;
    node : Ast.Kid ;
    body : Ast.Kid ;                 (* the implementation's node, when
                                        one was loaded: AnswersFrame
                                        reads its body *)
    fromDef, hasBody : BOOL ;
  END ;

  Binding = RECORD
    name, mode : UTF ;
    ty : Ast.Kid ;
    ro : BOOL ;                (* a variable declared `VAR RO' *)
    roFrom : UTF ;             (* read-only storage it was given, or '' *)
    roLine : I64 ;             (* by the assignment at this line *)
    from : UTF ;               (* a binder: the root name of the IS SOME
                                  operand it was bound from, or '' *)
  END ;

  VariantInfo = RECORD
    typeName : UTF ;
    variants : SLICE OF UTF ;
    fields : SLICE OF AKid ;      (* fieldseq per variant, or NONE *)
  END ;

  ModuleInfo = RECORD
    name, foreignLang : UTF ;
    stateful, hasDef, hasImpl : BOOL ;
    procs : SLICE OF ProcInfo ;
    nprocs : I64 ;
    procIx : NameIx ;             (* procs by name *)
    tdIx, cnIx : NameIx ;         (* tdNames, cnNames by name *)
    vts : SLICE OF VariantInfo ;
    nvts : I64 ;
    tdNames : SLICE OF UTF ;      (* type decls WITH bodies *)
    tdNodes : SLICE OF AKid ;
    ntds : I64 ;
    opaque : SLICE OF UTF ;       (* opaque decls in the definition *)
    nopaque : I64 ;
    cnNames : SLICE OF UTF ;      (* exported CONSTs ... *)
    cnTypes : SLICE OF UTF ;      (* ... and their LitType, because a
                                     CONST is an untyped literal and
                                     stays one across a module edge *)
    cnVals : SLICE OF AKid ;      (* ... and their literal, for an
                                     array count's value (CountValue) *)
    ncns : I64 ;
    exNames : SLICE OF UTF ;      (* EXCEPTION declarations *)
    exDecls : SLICE OF AKid ;     (* ... and their nodes, for a
                                     handler's binder types *)
    nexc : I64 ;
    vrNames : SLICE OF UTF ;      (* the definition's VARs, which an
                                     importer reads and writes as
                                     Mod.v (decision 28) ... *)
    vrTypes : SLICE OF AKid ;     (* ... their types, qualified in this
                                     module (QualifiedIn) ... *)
    vrRo : SLICE OF BOOL ;        (* ... and VAR RO, written by no one *)
    nvrs : I64 ;
    mvNames : SLICE OF UTF ;      (* every module-level VAR, definition's
                                     and implementation's: the state a
                                     THREAD may not write (par 6) ... *)
    mvTypes : SLICE OF AKid ;     (* ... and its declared type *)
    nmvs : I64 ;
  END ;

VAR
  showName, shown : UTF ;     (* ShowType / ShownType *)
  shownRaises : UTF ;         (* ShownRaises: ' A B ' *)
  pool : POOL ;
  mods : SLICE OF ModuleInfo ;
  nmods : I64 ;
  impB : SLICE OF UTF ;      (* CheckImports: the binders in scope *)
  nimpB : I64 ;
  roFresh : SLICE OF UTF ;   (* RoSeed: `name.field' paths of a marked record
                                copy given storage that is NOT read-only *)
  nroFresh : I64 ;
  ownFed : SLICE OF UTF ;    (* OwnFedSeed: locals something may give an
                                owned pointer -- DISPOSE frees only those *)
  nownFed : I64 ;
  mroName, mroFrom : SLICE OF UTF ;   (* ModRoSeed: module variables given *)
  mroLine : SLICE OF I64 ;            (* read-only storage, and where *)
  nmro : I64 ;
  errs : SLICE OF UTF ;
  nerrs : I64 ;
  quietWalk : I64 ;     (* > 0: WalkQuiet is collecting RAISES only *)
  unkArgs : SLICE OF I64 ;  (* argument lists of calls to an UNKNOWN
                               procedure, typed (and reported) once by
                               CallType: walked again quietly *)
  nunkArgs : I64 ;
  ledger : SLICE OF UTF ;
  nledger : I64 ;
  (* m9c --review: what was EXAMINED and what was PASSED OVER, per
     kind of site.  Softness is this checker's contract -- an unknown
     type never diagnoses -- and that makes "it compiled" a weaker
     claim than it sounds: a comparison one side of which had no type
     was not a comparison at all.  These say how often.  Counted on
     this side only; the oracle's diagnostics are what semdiff holds
     it to, and a count is not a diagnostic. *)
  statC, statS : ARRAY 7 OF I64 ;         (* StatKinds of them *)
  twText : SLICE OF UTF ;                  (* ThreadWrite *)
  adText : SLICE OF UTF ;                  (* AdrSite *)
  nad : I64 ;
  scText : SLICE OF UTF ;                  (* StaleCall *)
  nsc : I64 ;
  ssText : SLICE OF UTF ;                  (* StrSite *)
  nss : I64 ;
  curProcNm : UTF ;                        (* the procedure CheckProcBody is in, '' in the module body *)
  ntw : I64 ;
  statR : ARRAY 7 OF I64 ;                (* lines recorded, per kind *)
  statL : ARRAY 42 OF I64 ;               (* StatKinds * StatSites lines
                                             of sites passed over *)
  curMod, canonCtx : UTF ;
  typeArgOk : BOOL ;           (* typing MAX's, MIN's or SizeOf's arguments:
                                  a bare type there is the argument *)
  typeTop : BOOL ;             (* the next CheckTypeNode is a TYPE's body:
                                  a RECORD there is named *)
  curRoot : PTR Ast.Node ;     (* the file CheckFile is checking *)
  scope : SLICE OF Binding ;
  nscope : I64 ;
  scopeIx : NameIx ;           (* scope by name, the first binding *)
  declIx : NameIx ;            (* DeclOnce's names by name *)
  callsIx : NameIx ;           (* CallsAdd's calls by name *)
  strScanIx : NameIx ;         (* StrScan: the nodes listed *)
  constIx : NameIx ;           (* consts by name, checked live: ConstAt *)
  rgIx : NameIx ;              (* the region walk's names by name *)
  olIx : NameIx ;              (* the owner walk's names by name *)
  olUseIx : NameIx ;           (* the names a body mentions *)
  rgCompMod, rgCompName : UTF ; (* RgCompOf: the callee whose body is being read *)
  olRetIx : NameIx ;           (* OlRetReach: `Mod.Proc#j' -> 0 no, 1 yes, 2 busy, 3 redo *)
  olPrevIx : NameIx ;          (* the previous round's answers, for a busy read *)
  olDepth : I64 ;              (* nesting of the return-flow summaries *)
  olLean : BOOL ;              (* a busy entry was read this round *)
  olProv : SLICE OF UTF ;      (* the keys this round answered *)
  nOlProv : I64 ;
  fieldIx : NameIx ;           (* FieldGroupOf: "record id field" -> its group *)
  fieldDone : NameIx ;         (* FieldGroupOf: the records indexed, by id *)
  onceIx : NameIx ;            (* OnceNames: "scope name", seen *)
  onceGen : I64 ;              (* OnceNames: the scope a list is one in *)
  rgMemoIx : NameIx ;          (* rgMemoK by key *)
  rgFldIx : NameIx ;           (* names with a tracked field x.f *)
  rgCntIx : NameIx ;           (* RgNames' distinct keys, sizing the table *)
  rgCntN : I64 ;
  rgMkRoot : I64 ;             (* RgModMarks: the file rgMkAcc describes *)
  rgMkIx : NameIx ;            (*   a name's entry in rgMkAcc *)
  rgMkAcc : SLICE OF UTF ;
  nrgMk : I64 ;
  tcRoot : I64 ;               (* TcDecl: the unit tcIx indexes *)
  tcIx : NameIx ;
  mroIx : NameIx ;             (* mroName by name *)
  localTyIx : NameIx ;         (* CheckDeclTypes: this procedure's TYPEs *)
  mvtRoot : I64 ;              (* ModVarType: the file and unit ... *)
  mvtUnit : UTF ;
  mvtIx : NameIx ;             (*   ... whose variables are where *)
  avHolder : I64 ;             (* AddVarsOf: the node whose VAR sections *)
  avAt : SLICE OF I64 ;        (*   are at avAt[0 .. navAt - 1]           *)
  navAt : I64 ;
  resolvedIn : I64 ;   (* the module (index into mods) ResolveType's last
                          lookup ended in; -1 when the node needed none *)
  fromMap : SLICE OF Binding ;
  nfrom : I64 ;
  calls : SLICE OF UTF ;
  ncalls : I64 ;
  raised : SLICE OF Binding ;
  nraised : I64 ;
  strNode : Ast.Kid ;         (* the SLICE OF CHAR that STR names *)
  utfNode : Ast.Kid ;         (* the SLICE OF <u8> that UTF names *)
  loopsOpen : I64 ;           (* LOOPs around the statement walked *)
  finSinceLoop : I64 ;        (* FINALLY-protected blocks since the innermost LOOP *)
  forNames : SLICE OF UTF ;   (* the control variables of the FORs being
                                 walked, innermost last (issue 3) *)
  forLines : SLICE OF I64 ;
  forPlain : SLICE OF BOOL ;  (* a FOR's, not a FOR IN's: only it may not be written *)
  nforActive : I64 ;
  ixDecl : Ast.Kid ;          (* IndexError (index, length : I64), the
                                 predeclared payload (par 5, 2026-10-09) *)
  consts : SLICE OF Binding ;   (* module CONST name -> literal type *)
  nconsts : I64 ;
  svConsts : I64 ;         (* nconsts before a procedure's own CONSTs *)
  nAgg : I64 ;             (* aggregate CONSTs in this unit: the walk
                              that guards them is skipped at zero *)
  own : SLICE OF Binding ;      (* owned name -> alive, or what took it *)
  nown : I64 ;
  curRetTy : UTF ;              (* the enclosing procedure's result *)
  curUnsafe : BOOL ;
  curPure : BOOL ;                 (* inside a [PURE] body, par 3.2 *)
  curFresh : BOOL ;                (* inside a [FRESH] body, par 7 *)
  ownModule : BOOL ;               (* the module body: its variables are
                                      owned candidates there (2026-10-10) *)
  curInBody : BOOL ;               (* the module init body, whose frame
                                      and module vars co-live, so a
                                      concat stored in a module var
                                      there does not outlive it *)
  boundMonId : I64 ;               (* the bound monitor's type node, or -1 *)
  allocNoPool : BOOL ;             (* AllocsThrough for a THREAD: a POOL argument is its own pool *)
  allocMon : BOOL ;                (* AllocsThrough of a MONITOR parameter: its POOL fields are carved under its lock *)
  boundMon : UTF ;                 (* the bound monitor parameter, or
                                      empty when this procedure is not
                                      bound to one (par 6) *)
  inited : BOOL ;
  (* par 4.1, DIRECTIONAL: the ledger names stores; these decide
     which stores anyone outside the frame can still see.  Escape
     TARGETS per frame name ('<module>', '<return>', '<call>' or a
     reference parameter's name) in first-encounter order, symmetric
     alias edges the targets close over, and ledger stores PENDED
     until the walk ends and every escape of the destination has
     been seen.  All reset per procedure (CheckProcBody).           *)
  ansName : SLICE OF UTF ;       (* AnswersFrame's memo: Module.Proc *)
  ansState : SLICE OF UTF ;      (* 'yes', 'no', or 'busy' *)
  nans : I64 ;
  ansDep, ansLow, ansBase, provIx : SLICE OF I64 ;
  ansRB, ansDirty : SLICE OF BOOL ;
  provTop : I64 ;
  ansDepth : I64 ;
  escName : SLICE OF UTF ;
  escTgt : SLICE OF UTF ;
  nesc : I64 ;
  edgeA : SLICE OF UTF ;
  edgeB : SLICE OF UTF ;
  nedge : I64 ;
  pendSrc : SLICE OF UTF ;
  pendDst : SLICE OF UTF ;
  pendLine : SLICE OF I64 ;
  pendCol : SLICE OF I64 ;
  npend : I64 ;
  keptP : SLICE OF UTF ;        (* params declared KEPT (par 4.1),
                                   with the declaring identifier's
                                   position beside each *)
  keptLn : SLICE OF I64 ;
  keptCl : SLICE OF I64 ;
  nkept : I64 ;
  keptU : SLICE OF UTF ;        (* KEPT params the analysis saw
                                   retained -- the complement is the
                                   kept-unseen ledger class *)
  nkeptU : I64 ;
  (* par 4.1 value provenance: which BORROWS a local or binder
     carries -- a copied reference, a binder's view, a sub-slice --
     plus directed copy edges closed at flush.  No kill on
     reassignment: the approximation errs into the ledger. *)
  carryN : SLICE OF UTF ;
  carryB : SLICE OF UTF ;
  ncarry : I64 ;
  carryEA : SLICE OF UTF ;
  carryEB : SLICE OF UTF ;
  ncedge : I64 ;
  (* par 2.3: locals/binders that currently hold a FRAME-SCOPED
     string -- a concatenation, which lives in this frame's arena
     and dies with it.  Escaping one (to a module var, through a
     reference parameter, or via RETURN of the holding name) is the
     use-after-free the frame model would otherwise permit silently.
     Tainted on assignment of a concatenation, cleared when the name
     is given a durable value again.  Reset per frame.  Since the
     frame form of NEW (docs/pool-elision-plan.md, rule 1) a name may
     also hold a FRAME ALLOCATION, and fvalKind says which, for the
     diagnostic: 'a concatenation' or 'a frame allocation'. *)
  fvalName : SLICE OF UTF ;
  fvalKind : SLICE OF UTF ;
  nfval : I64 ;
  (* the bare names holding a POOL allocation -- `NEW (pool, T)` or
     the object form `NEW (d, T)` -- which is nobody's to own: a
     copy out of such a name is a copy, not a move.  Before stage 5
     such a local said `IN pool` and was no owned candidate by type;
     the elided `j : PTR Job ; j := NEW (f, Job)` is the same storage
     with no clause to say so (VertTransform.RunBands handed j to a
     Band per thread in a loop and read `use of j after it was
     moved`). *)
  pvalName : SLICE OF UTF ;
  npval : I64 ;

(* ---- output ---- *)

PROCEDURE Setup () =
VAR ch, sn, ub, un, xd, fs, g, il, i1, i2, ty : PTR Ast.Node IN pool ;
BEGIN
  IF inited THEN RETURN END ;
  inited := TRUE ;
  ch := Ast.NewNode (pool, Ast.NQualident, 0, 0) ;
  Ast.SetA (pool, ch, 'CHAR') ;
  sn := Ast.NewNode (pool, Ast.NSliceType, 0, 0) ;
  Ast.Add (pool, sn, SOME (ch)) ;
  Ast.Add (pool, sn, NONE) ;
  strNode := SOME (sn) ;
  (* UTF names SLICE OF <u8>: an octet of valid UTF-8, an element type
     no program can write (docs/utf8-plan.md, stage 1) *)
  ub := Ast.NewNode (pool, Ast.NQualident, 0, 0) ;
  Ast.SetA (pool, ub, '<u8>') ;
  un := Ast.NewNode (pool, Ast.NSliceType, 0, 0) ;
  Ast.Add (pool, un, SOME (ub)) ;
  Ast.Add (pool, un, NONE) ;
  utfNode := SOME (un) ;
  (* EXCEPTION IndexError (index, length : I64), as it would parse:
     the payload every index check writes, so a handler's binders
     are typed (both generators read err->i[0], err->i[1] off the
     same shape) *)
  xd := Ast.NewNode (pool, Ast.NExcDecl, 0, 0) ;
  Ast.SetA (pool, xd, 'IndexError') ;
  fs := Ast.NewNode (pool, Ast.NFieldSeq, 0, 0) ;
  g := Ast.NewNode (pool, Ast.NFieldGroup, 0, 0) ;
  il := Ast.NewNode (pool, Ast.NIdentList, 0, 0) ;
  i1 := Ast.NewNode (pool, Ast.NIdent, 0, 0) ;
  Ast.SetA (pool, i1, 'index') ;
  i2 := Ast.NewNode (pool, Ast.NIdent, 0, 0) ;
  Ast.SetA (pool, i2, 'length') ;
  ty := Ast.NewNode (pool, Ast.NQualident, 0, 0) ;
  Ast.SetA (pool, ty, 'I64') ;
  Ast.Add (pool, il, SOME (i1)) ;
  Ast.Add (pool, il, SOME (i2)) ;
  Ast.Add (pool, g, SOME (il)) ;
  Ast.Add (pool, g, SOME (ty)) ;
  Ast.Add (pool, fs, SOME (g)) ;
  Ast.Add (pool, xd, SOME (fs)) ;
  ixDecl := SOME (xd) ;
  forNames := NEW (pool, UTF, 64) ;
  forLines := NEW (pool, I64, 64) ;
  forPlain := NEW (pool, BOOL, 64) ;
  nforActive := 0 ;
  mods := NEW (pool, ModuleInfo, 8) ;
  errs := NEW (pool, UTF, 16) ;
  ledger := NEW (pool, UTF, 8) ;
  scope := NEW (pool, Binding, 32) ;
  avHolder := -1 ;
  rgMkRoot := -1 ;
  tcRoot := -1 ;
  mvtRoot := -1 ;
  fromMap := NEW (pool, Binding, 8) ;
  calls := NEW (pool, UTF, 16) ;
  raised := NEW (pool, Binding, 8) ;
  escName := NEW (pool, UTF, 16) ;
  ansName := NEW (pool, UTF, 64) ;
  ansState := NEW (pool, UTF, 64) ;
  ansDep := NEW (pool, I64, 64) ;
  ansLow := NEW (pool, I64, 64) ;
  ansBase := NEW (pool, I64, 64) ;
  ansDirty := NEW (pool, BOOL, 64) ;
  provIx := NEW (pool, I64, 256) ;
  ansRB := NEW (pool, BOOL, 64) ;
  provTop := 0 ;
  ansDepth := 0 ;
  boundMonId := -1 ;
  escTgt := NEW (pool, UTF, 16) ;
  fvalName := NEW (pool, UTF, 16) ;
  fvalKind := NEW (pool, UTF, 16) ;
  pvalName := NEW (pool, UTF, 16) ;
  edgeA := NEW (pool, UTF, 8) ;
  edgeB := NEW (pool, UTF, 8) ;
  pendSrc := NEW (pool, UTF, 8) ;
  pendDst := NEW (pool, UTF, 8) ;
  pendLine := NEW (pool, I64, 8) ;
  pendCol := NEW (pool, I64, 8) ;
  keptP := NEW (pool, UTF, 8) ;
  keptLn := NEW (pool, I64, 8) ;
  keptCl := NEW (pool, I64, 8) ;
  keptU := NEW (pool, UTF, 8) ;
  carryN := NEW (pool, UTF, 8) ;
  carryB := NEW (pool, UTF, 8) ;
  carryEA := NEW (pool, UTF, 8) ;
  carryEB := NEW (pool, UTF, 8)
END Setup ;

PROCEDURE PushErr (VAR list: SLICE OF UTF ; VAR n: I64 ; RO KEPT s: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF n = LEN (list) THEN
    nb := NEW (pool, UTF, 2 * LEN (list)) ;
    FOR i := 0 TO n - 1 DO nb[i] := list[i] END ;
    list := nb
  END ;
  list[n] := s ;
  n := n + 1
END PushErr ;

(* 'line:col ctx: message' -- the oracle's shape, and the bytes the
   differential compares *)
PROCEDURE Diag (VAR list: SLICE OF UTF ; VAR n: I64 ;
                line, col: I64 ; RO ctx: UTF ; RO msg: UTF) =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.AppendI64 (d, line) ;
  DynUtf.AppendChar (d, ':') ;
  DynUtf.AppendI64 (d, col) ;
  DynUtf.AppendChar (d, ' ') ;
  DynUtf.Append (d, ctx) ;
  DynUtf.Append (d, ': ') ;
  (* the type UTF names is spelled UTF: SLICE OF <u8> is nothing a
     program can write (docs/utf8-plan.md) *)
  DynUtf.Append (d, Text.Replace (msg, UtfTy, 'UTF')) ;
  PushErr (list, n, DynUtf.ViewIn (pool, d))   (* in the pool: the list is module state *)
END Diag ;

PROCEDURE ErrN (n: PTR Ast.Node ; RO ctx: UTF ; RO msg: UTF) =
BEGIN
  IF quietWalk > 0 THEN RETURN END ;
  Diag (errs, nerrs, n.line, n.col, ctx, msg)
END ErrN ;

PROCEDURE ErrCount () : I64 =
BEGIN
  RETURN nerrs
END ErrCount ;

PROCEDURE ErrAt (i: I64) : UTF RAISES IndexError =
BEGIN
  IF i < 0 OR i >= nerrs THEN RAISE IndexError (i, nerrs) END ;
  RETURN errs[i]
END ErrAt ;

PROCEDURE LedgerCount () : I64 =
BEGIN
  RETURN nledger
END LedgerCount ;

PROCEDURE LedgerAt (i: I64) : UTF RAISES IndexError =
BEGIN
  IF i < 0 OR i >= nledger THEN RAISE IndexError (i, nledger) END ;
  RETURN ledger[i]
END LedgerAt ;

(* ---- the registry ---- *)

PROCEDURE FindMod (RO n: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nmods - 1 DO
    IF Text.Eq (mods[i].name, n) THEN RETURN i END
  END ;
  RETURN -1
END FindMod ;

PROCEDURE NewMod (RO KEPT n: UTF) : I64 =
VAR
  nb : SLICE OF ModuleInfo ;
  i : I64 ;
BEGIN
  IF nmods = LEN (mods) THEN
    nb := NEW (pool, ModuleInfo, 2 * LEN (mods)) ;
    FOR i := 0 TO nmods - 1 DO nb[i] := mods[i] END ;
    mods := nb
  END ;
  mods[nmods].name := n ;
  mods[nmods].procs := NEW (pool, ProcInfo, 8) ;
  mods[nmods].nprocs := 0 ;
  mods[nmods].vts := NEW (pool, VariantInfo, 4) ;
  mods[nmods].nvts := 0 ;
  mods[nmods].tdNames := NEW (pool, UTF, 8) ;
  mods[nmods].tdNodes := NEW (pool, AKid, 8) ;
  mods[nmods].ntds := 0 ;
  mods[nmods].opaque := NEW (pool, UTF, 4) ;
  mods[nmods].nopaque := 0 ;
  nmods := nmods + 1 ;
  RETURN nmods - 1
END NewMod ;

PROCEDURE FindProcIn (m: I64 ; RO n: UTF) : I64 =
BEGIN
  RETURN NxFind (mods[m].procIx, n)
END FindProcIn ;

(* ---- NameIx: see the type ---- *)

(* the byte at offset i of u, as a number: the scanners below read ASCII
   structure -- digits, `.`, `,`, `(` -- where a byte IS the character,
   and compare it with ORD ('x') or 48..57 *)
PROCEDURE B (RO u: UTF ; i: I64) : I64 =
BEGIN
  RETURN I64 (Text.BAt (u, i))
END B ;

CONST
  NxMul = -7046029254386353131 ;   (* 0x9E3779B97F4A7C15, the golden ratio, as an I64 *)

PROCEDURE NxHash (RO s: UTF) : I64 =
VAR i, h : I64 ;
BEGIN
  h := 5381 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO h := h *% 33 +% B (s, i) END ;
  (* finished by the golden ratio's multiply, the high half kept: djb2
     alone puts `g0' .. `g79999' in runs a linear probe walks through,
     and scale's module-variable shape drifted to ratio 4.3 *)
  h := h *% NxMul ;
  RETURN h DIV 4294967296
END NxHash ;

(* the slot holding nm, or the empty one where it would go *)
PROCEDURE NxSlot (VAR x: NameIx ; RO nm: UTF) : I64 =
VAR k, cap : I64 ;
BEGIN
  cap := LEN (x.keys) ;
  k := NxHash (nm) MOD cap ;
  IF k < 0 THEN k := k + cap END ;
  WHILE x.gens[k] = x.gen AND NOT Text.Eq (x.keys[k], nm) DO
    k := (k + 1) MOD cap
  END ;
  RETURN k
END NxSlot ;

PROCEDURE NxFind (VAR x: NameIx ; RO nm: UTF) : I64 =
VAR k : I64 ;
BEGIN
  IF LEN (x.keys) = 0 THEN RETURN -1 END ;
  k := NxSlot (x, nm) ;
  IF x.gens[k] = x.gen THEN RETURN x.vals[k] END ;
  RETURN -1
END NxFind ;

PROCEDURE NxGrow (VAR x: NameIx) =
VAR
  ok : SLICE OF UTF ;
  ov, og : SLICE OF I64 ;
  j, k, cap : I64 ;
BEGIN
  ok := x.keys ;
  ov := x.vals ;
  og := x.gens ;
  cap := 2 * LEN (ok) ;
  IF cap < 64 THEN cap := 64 END ;
  x.keys := NEW (pool, UTF, cap) ;
  x.vals := NEW (pool, I64, cap) ;
  x.gens := NEW (pool, I64, cap) ;
  IF x.gen < 1 THEN x.gen := 1 END ;
  FOR j := 0 TO LEN (ok) - 1 DO
    IF og[j] = x.gen THEN
      k := NxSlot (x, ok[j]) ;
      x.keys[k] := ok[j] ;
      x.vals[k] := ov[j] ;
      x.gens[k] := x.gen
    END
  END
END NxGrow ;

(* nm -> v, unless nm is there already: the first entry wins *)
PROCEDURE NxAdd (VAR x: NameIx ; RO KEPT nm: UTF ; v: I64) =
VAR k : I64 ;
BEGIN
  IF 2 * (x.n + 1) > LEN (x.keys) THEN NxGrow (x) END ;
  k := NxSlot (x, nm) ;
  IF x.gens[k] = x.gen THEN RETURN END ;
  x.keys[k] := nm ;
  x.vals[k] := v ;
  x.gens[k] := x.gen ;
  x.n := x.n + 1
END NxAdd ;

(* nm -> v, whatever was there: for a list cut back from the top,
   where the entry an index names may be gone (ConstAdd) *)
PROCEDURE NxSet (VAR x: NameIx ; RO KEPT nm: UTF ; v: I64) =
VAR k : I64 ;
BEGIN
  IF 2 * (x.n + 1) > LEN (x.keys) THEN NxGrow (x) END ;
  k := NxSlot (x, nm) ;
  IF x.gens[k] # x.gen THEN x.n := x.n + 1 END ;
  x.keys[k] := nm ;
  x.vals[k] := v ;
  x.gens[k] := x.gen
END NxSet ;

PROCEDURE NxClear (VAR x: NameIx) =
BEGIN
  x.gen := x.gen + 1 ;
  x.n := 0
END NxClear ;

(* module m (if loaded) declares a procedure n *)
PROCEDURE ProcIn (m: I64 ; RO n: UTF) : BOOL =
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  RETURN FindProcIn (m, n) >= 0
END ProcIn ;

PROCEDURE FindTypeIn (m: I64 ; RO n: UTF) : Ast.Kid =
VAR i : I64 ;
BEGIN
  i := NxFind (mods[m].tdIx, n) ;
  IF i < 0 THEN RETURN NONE END ;
  RETURN mods[m].tdNodes[i]
END FindTypeIn ;

PROCEDURE IsOpaqueIn (m: I64 ; RO n: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].nopaque - 1 DO
    IF Text.Eq (mods[m].opaque[i], n) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsOpaqueIn ;

PROCEDURE RaisesOf (VAR pl: POOL ; p: PTR Ast.Node) : SLICE OF UTF =
VAR
  r : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF p.kids[2] IS SOME rs THEN
    r := NEW (pl, UTF, rs.nkids) ;
    FOR i := 0 TO rs.nkids - 1 DO
      IF rs.kids[i] IS SOME q THEN
        IF Text.BLen (q.bu) > 0 THEN r[i] := q.bu ELSE r[i] := q.au END
      END
    END ;
    RETURN r
  END ;
  RETURN NEW (pl, UTF, 0)
END RaisesOf ;

(* a RAISES clause's names as SPELLED -- `A.E' or `E' -- for the
   accounting, which keys them (ExcKey) once every module is registered;
   RaisesOf's bare names stay the signature's text *)
PROCEDURE RaisesSpelled (VAR pl: POOL ; p: PTR Ast.Node) : SLICE OF UTF =
VAR
  r : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF p.kids[2] IS SOME rs THEN
    r := NEW (pl, UTF, rs.nkids) ;
    FOR i := 0 TO rs.nkids - 1 DO
      IF rs.kids[i] IS SOME q THEN
        IF Text.BLen (q.bu) > 0 THEN r[i] := Text.Keep (pl, q.au + '.' + q.bu)
        ELSE r[i] := q.au END
      END
    END ;
    RETURN r
  END ;
  RETURN NEW (pl, UTF, 0)
END RaisesSpelled ;

(* a key's bare name, for the message *)
PROCEDURE ExcBare (RO key: UTF) : UTF =
VAR i : I64 ;
BEGIN
  i := Text.BLen (key) - 1 ;
  WHILE i >= 0 AND B (key, i) # ORD ('.') DO i := i - 1 END ;
  RETURN SLICE (key, i + 1, Text.BLen (key) - i - 1)
END ExcBare ;

(* an exception's KEY in the RAISES accounting (2026-10-21, the
   compiler review's C6, second half): its module and name.  Bare
   names were compared until then, so `| EB.Error' handled EA.Error
   and `RAISES EB.Error' covered a call raising EA.Error; and a module's
   own `EXCEPTION Overflow' was exempted as the predeclared one.  A
   qualified spelling keys as written; a bare one under mod, the module
   that spelled it, when mod declares it; anything else -- the
   predeclared four, another module's exception named bare -- as
   itself, and ExcCovers matches that by name.  The messages show the
   bare name, as before. *)
PROCEDURE ExcKey (RO mod: UTF ; RO spelled: UTF) : UTF =
VAR m, i : I64 ;
BEGIN
  IF Text.Contains (spelled, '.') THEN RETURN Text.Keep (pool, spelled) END ;
  m := FindMod (mod) ;
  IF m >= 0 THEN
    FOR i := 0 TO mods[m].nexc - 1 DO
      IF Text.Eq (mods[m].exNames[i], spelled) THEN
        RETURN Text.Keep (pool, mod + '.' + spelled)
      END
    END
  END ;
  RETURN Text.Keep (pool, spelled)
END ExcKey ;

(* does a handler's or a clause's key cover a raised key?  The same key,
   or a BARE key -- a name the module spelling it does not declare, as
   ZarrStore handles Http's TransportError -- and the raised one's bare
   name.  Not a lookup over the loaded modules: Csv and Json both
   declare ParseError, and which is "first" depends on what else is
   loaded (the canonCtx class). *)
(* the name a refusal shows for a raised key: bare (decision 56), unless
   it is another module's and this module declares an exception of the
   same bare name -- then `EXCEPT | Error' would name the wrong one, and
   the message names the module (zarrm9's PtyOwn, 2026-10-25) *)
PROCEDURE ExcShown (RO key: UTF) : UTF =
VAR bare : UTF ;
BEGIN
  bare := ExcBare (key) ;
  IF Text.Contains (key, '.') AND NOT Text.StartsWith (key, curMod + '.') AND
     Text.Eq (ExcKey (curMod, bare), curMod + '.' + bare) THEN
    RETURN key
  END ;
  RETURN bare
END ExcShown ;

PROCEDURE ExcCovers (RO k: UTF ; RO raisedKey: UTF) : BOOL =
BEGIN
  IF Text.Eq (k, raisedKey) THEN RETURN TRUE END ;
  RETURN NOT Text.Contains (k, '.') AND Text.Eq (k, ExcBare (raisedKey))
END ExcCovers ;



(* an exception cited by RAISE, a RAISES clause or a handler must be
   one the reader (and the generator) can find, resolving exactly as
   Gen.ExcRef does: a qualified name in the module it names, a bare
   name locally, predeclared, or declared in some loaded module (both
   direct and transitive deps register their exceptions).  A name
   found nowhere is accepted by neither -- catch it HERE. *)
PROCEDURE ExcKnown (RO qual: UTF ; RO nm: UTF) : BOOL =
VAR m, i : I64 ;
BEGIN
  IF Text.BLen (qual) > 0 AND NOT Text.Eq (qual, curMod) THEN
    m := FindMod (qual) ;
    (* an unknown module is the softness contract's business; only a
       KNOWN, non-foreign module lacking the exception is an error *)
    IF m < 0 THEN RETURN TRUE END ;
    IF Text.BLen (mods[m].foreignLang) > 0 THEN RETURN TRUE END ;
    RETURN HasExcIn (m, nm)
  END ;
  (* bare, or qualified with the current module *)
  IF Text.Eq (nm, 'Overflow') OR Text.Eq (nm, 'IndexError')
     OR Text.Eq (nm, 'OutOfMemory') OR Text.Eq (nm, 'ValueRange') THEN
    RETURN TRUE
  END ;
  FOR i := 0 TO nmods - 1 DO
    IF HasExcIn (i, nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END ExcKnown ;

PROCEDURE CheckExcName (n: PTR Ast.Node ; RO ctx: UTF) =
VAR qual, nm : UTF ;
BEGIN
  qual := '' ; nm := n.au ;
  IF Text.BLen (n.bu) > 0 THEN qual := n.au ; nm := n.bu END ;
  IF NOT ExcKnown (qual, nm) THEN
    ErrN (n, ctx, 'unknown exception: ' + nm)
  END
END CheckExcName ;

(* a handler's name qualified by a name in scope: `| v.E' with v a
   variable.  A name in scope is never a module (par 3 rule 5), and the
   checker said only that E was unhandled (the review's F4) *)
PROCEDURE HandlerQualVar (n: PTR Ast.Node ; RO ctx: UTF) =
BEGIN
  IF Text.BLen (n.bu) > 0 AND Text.BLen (ScopeMode (n.au)) > 0 THEN
    ErrN (n, ctx, S4 (n.au, '.', n.bu, S3 (': ', n.au,
      ' is a variable, not a module -- name the exception as declared')))
  END
END HandlerQualVar ;

(* ---- a type named in a KNOWN module must exist there ----

   The softness contract stands: an unknown type never diagnoses,
   because a bare name found nowhere may simply be a missing IMPORT,
   and a checker that guesses produces diagnostics nobody can act on.
   But `DynStr.Dstring' names a module that IS loaded and a type it
   does not declare.  That is a typo, not softness -- and it rode
   through --check without a word to surface as cc's `unknown type
   name DynStr_Dstring', the M9 name mangled and the M9 line gone
   (2026-09-15).  Same rule as ExcKnown, two hundred lines up: only
   a known, non-foreign module lacking the name is an error.

   Checked ONCE, at the declaration, in declaration order; every
   lookup that follows stays soft, so nothing cascades. *)
PROCEDURE TypeKnown (RO qual: UTF ; RO nm: UTF) : BOOL =
VAR m : I64 ;
BEGIN
  IF Text.BLen (qual) = 0 THEN RETURN TRUE END ;
  m := FindMod (qual) ;
  IF m < 0 THEN RETURN TRUE END ;
  IF Text.BLen (mods[m].foreignLang) > 0 THEN RETURN TRUE END ;
  IF FindTypeIn (m, nm) IS SOME t THEN RETURN TRUE END ;
  RETURN IsOpaqueIn (m, nm)
END TypeKnown ;

(* the part of an array count outside its grammar (report par 2.2): an
   integer literal, a name (a CONST, an enumeration; bare or Mod.N),
   parentheses, unary minus, and + - * DIV MOD over those, never by a
   literal 0.  '' when the count is in it.  ORD ('a'), MAX (I8), LEN
   (Tab), N DIV 0 were accepted here and refused by the generator as
   `array count form unsupported' until 2026-10-29 *)
PROCEDURE ArrayCountForm (k: Ast.Kid) : UTF =
VAR
  r : UTF ;
  v : I64 ;
  ch : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NInt THEN RETURN '' END ;
    IF e.kind = Ast.NDesignator THEN
      (* a CONST named is an integer one: `CONST C = 'a'' or `= 2.5'
         reached the generator *)
      IF e.nkids = 0 THEN
        r := ConstType (e.au, ch) ;
        IF ch AND NOT Text.Eq (r, '<int>') THEN RETURN Print.ExprTextUtf (k) END ;
        RETURN ''
      END ;
      IF e.nkids = 1 THEN
        IF e.kids[0] IS SOME sf THEN
          IF sf.kind = Ast.NSelField THEN
            r := ModConstType (e.au, sf.au, ch) ;
            IF ch AND NOT Text.Eq (r, '<int>') THEN RETURN Print.ExprTextUtf (k) END ;
            RETURN ''
          END
        END
      END ;
      RETURN Print.ExprTextUtf (k)
    END ;
    IF e.kind = Ast.NParen THEN RETURN ArrayCountForm (e.kids[0]) END ;
    IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN RETURN ArrayCountForm (e.kids[0]) END ;
    IF e.kind = Ast.NBin AND e.nkids = 2 AND
       (Text.Eq (e.au, '+') OR Text.Eq (e.au, '-') OR Text.Eq (e.au, '*') OR
        Text.Eq (e.au, 'DIV') OR Text.Eq (e.au, 'MOD')) THEN
      r := ArrayCountForm (e.kids[0]) ;
      IF Text.BLen (r) > 0 THEN RETURN r END ;
      r := ArrayCountForm (e.kids[1]) ;
      IF Text.BLen (r) > 0 THEN RETURN r END ;
      IF Text.Eq (e.au, 'DIV') OR Text.Eq (e.au, 'MOD') THEN
        IF Ast.ScalarConst (e.kids[1], v, ch) THEN
          IF NOT ch AND v = 0 THEN RETURN Print.ExprTextUtf (k) END
        END
      END ;
      RETURN ''
    END
  END ;
  RETURN Print.ExprTextUtf (k)
END ArrayCountForm ;

(* an array count that is a CONST expression, not an enumeration: a
   literal or an operator, or a name of a CONST (bare or Mod.N) *)
PROCEDURE CountIsConst (k: Ast.Kid) : BOOL =
VAR
  found : BOOL ;
  t : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NInt OR e.kind = Ast.NBin OR e.kind = Ast.NUn OR
       e.kind = Ast.NParen THEN
      RETURN TRUE
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN RETURN ConstNamed (e.au) END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 1 THEN
      IF e.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          t := ModConstType (e.au, sf.au, found) ;
          RETURN found
        END
      END
    END
  END ;
  RETURN FALSE
END CountIsConst ;

(* a GRID's rank: an integer literal from 1 to 32 *)
PROCEDURE GridRankOk (k: Ast.Kid) : BOOL =
VAR
  v : I64 ;
  ch : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NInt AND Ast.ScalarConst (k, v, ch) THEN
      RETURN NOT ch AND v >= 1 AND v <= 32
    END
  END ;
  RETURN FALSE
END GridRankOk ;

(* an array count that folds to an integer below 1 *)
PROCEDURE ArrayCountBad (k: Ast.Kid) : BOOL =
VAR
  v : I64 ;
  ch : BOOL ;
BEGIN
  v := 1 ;
  ch := FALSE ;
  IF Ast.ScalarConst (k, v, ch) THEN RETURN NOT ch AND v < 1 END ;
  RETURN FALSE
END ArrayCountBad ;

(* nm, bare, is no type anywhere: no builtin, no TYPE of a loaded
   module, no opaque one, no exception (ExcNotType says those) *)
PROCEDURE TypeNowhere (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF IsBuiltinTy (nm) OR Text.Eq (nm, 'STR') OR Text.Eq (nm, 'UTF') OR
     Text.Eq (nm, 'POOL') THEN
    RETURN FALSE
  END ;
  IF LookupTypeName ('', nm) IS SOME t THEN RETURN FALSE END ;
  (* a procedure's own TYPE, refused where it is declared *)
  IF NxFind (localTyIx, nm) >= 0 THEN RETURN FALSE END ;
  FOR i := 0 TO nmods - 1 DO
    IF IsOpaqueIn (i, nm) OR HasExcIn (i, nm) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END TypeNowhere ;

(* nm, bare, names an exception of this module or a predeclared one,
   and no type of it *)
PROCEDURE ExcNotType (RO nm: UTF) : BOOL =
VAR m : I64 ;
BEGIN
  m := FindMod (curMod) ;
  IF m < 0 OR IsBuiltinTy (nm) THEN RETURN FALSE END ;
  IF FindTypeIn (m, nm) IS SOME t THEN RETURN FALSE END ;
  IF IsOpaqueIn (m, nm) THEN RETURN FALSE END ;
  RETURN HasExcIn (m, nm) OR Text.Eq (nm, 'Overflow') OR
    Text.Eq (nm, 'IndexError') OR Text.Eq (nm, 'OutOfMemory') OR
    Text.Eq (nm, 'ValueRange')
END ExcNotType ;

PROCEDURE CheckFieldTypes (fs: Ast.Kid ; RO ctx: UTF) ;

PROCEDURE CheckTypeNode (t: Ast.Kid ; RO ctx: UTF) =
  (* every qualident reachable through PTR, OPT, SHARED, SLICE, ARRAY,
     GRID and the fields of a record, monitor or case record *)
VAR i, cv : I64 ;
  top : BOOL ;
BEGIN
  top := typeTop ;
  typeTop := FALSE ;
  IF t IS SOME n THEN
    (* a RECORD, CASE RECORD or MONITOR RECORD is a TYPE's body and
       has its name: written inline -- a variable's, a field's, an
       element's or a parameter's type -- the generator refused it as
       `type kind unsupported yet' (the fuzz review's InlineRec and
       InlineRecField, until 2026-10-30) *)
    IF NOT top AND (n.kind = Ast.NRecordType OR n.kind = Ast.NCaseRecordType OR
                    n.kind = Ast.NMonitorType) THEN
      ErrN (n, ctx, 'a RECORD is a TYPE of its own: declare it, TYPE T = RECORD ... END, and use its name (par 2.2)')
    END ;
    CASE n.kind OF
    | Ast.NQualident :
        IF Text.BLen (n.bu) > 0 AND NOT TypeKnown (n.au, n.bu) THEN
          ErrN (n, ctx, 'unknown type: ' + n.au + '.' + n.bu + ' -- '
                        + n.au + ' declares no such type')
        END ;
        (* a bare name of an EXCEPTION is no type: `VAR b : Bad'
           reached the C compiler as a variable of an m9_exc *)
        IF Text.BLen (n.bu) = 0 AND ExcNotType (n.au) THEN
          ErrN (n, ctx, S3 (n.au, ' is an EXCEPTION, not a type -- an exception',
                            ' is raised and handled; a value of its fields is a RECORD'))
        ELSIF Text.BLen (n.bu) = 0 AND TypeNowhere (n.au) THEN
          (* decision 32 left this soft, as a possible missing import;
             Alex decided 2026-10-22 to refuse it *)
          ErrN (n, ctx, S3 ('unknown type: ', n.au,
            S3 (' -- no module declares it; declare it, or write the module it is in (Mod.',
                n.au, ') and IMPORT that module')))
        END
    | Ast.NPtrType : CheckTypeNode (n.kids[0], ctx)
    | Ast.NOptType :
        CheckTypeNode (n.kids[0], ctx) ;
        (* OPT holds what can be absent: a pointer or a procedure
           value, emitted as a C pointer that may be NULL.  Over a
           value type it was accepted here and refused by the
           generator ("dereference of a non-pointer"; until
           2026-10-09) *)
        IF OptOverValue (n.kids[0]) THEN
          ErrN (n, ctx, S3 ('OPT holds a pointer or a procedure value, and ',
            Print.TypeTextUtf (pool, n.kids[0]),
            ' is neither: keep a BOOL beside the value, or OPT PTR to it (par 2.2)'))
        END
    | Ast.NSharedType : CheckTypeNode (n.kids[0], ctx)
    | Ast.NSliceType :
        CheckTypeNode (n.kids[0], ctx) ;
        IF IsBareProc (n.kids[0]) THEN
          ErrN (n, ctx, 'a slice or array of procedure values is not in the language yet (par 2.2.3)')
        END
    | Ast.NArrayType :
        CheckTypeNode (n.kids[1], ctx) ;
        (* the count, where it folds to a value, is at least 1: the
           generator refused ARRAY -3 OF as `array count form
           unsupported yet' (the review's F4) *)
        IF ArrayCountBad (n.kids[0]) THEN
          ErrN (n, ctx, Cat ('an ARRAY holds at least one element; its count is ',
            Print.ExprTextUtf (n.kids[0])))
        ELSIF Text.BLen (ArrayCountForm (n.kids[0])) > 0 THEN
          ErrN (n, ctx, S3 ("an ARRAY's count is an integer literal, a CONST or an enumeration, or + - * DIV MOD over them, not ",
            ArrayCountForm (n.kids[0]), ' (par 2.2)'))
        ELSIF CountIsConst (n.kids[0]) THEN
          (* a count over CONSTs, now that the checker knows their
             values (decision 78): one that divides by a CONST of 0 or
             passes MAX (I64) has none, and one below 1 holds nothing --
             the generator's `array count form unsupported' until
             2026-10-30 *)
          IF NOT CountValue (n.kids[0], '', 0, cv) THEN
            ErrN (n, ctx, S3 ("an ARRAY's count has no value: ", Print.ExprTextUtf (n.kids[0]),
              ' divides by 0 or passes MAX (I64) (par 2.2)'))
          ELSIF cv < 1 THEN
            ErrN (n, ctx, S3 ('an ARRAY holds at least one element; its count is ',
              Print.ExprTextUtf (n.kids[0]), Cat (' = ', ItoA (cv))))
          END
        END ;
        IF IsBareProc (n.kids[1]) THEN
          ErrN (n, ctx, 'a slice or array of procedure values is not in the language yet (par 2.2.3)')
        END
    | Ast.NGridType :
        CheckTypeNode (n.kids[1], ctx) ;
        (* a rank from 1 to 32, written as a number: GRID
           18446744073709551615 OF F64 stopped the compiler with
           `m9: unhandled Overflow' and no position (the fuzz review's
           N8, until 2026-10-30); GRID 0 has no axis to index *)
        IF NOT GridRankOk (n.kids[0]) THEN
          ErrN (n, ctx, S3 ("a GRID's rank is a number from 1 to 32, not ",
            Print.ExprTextUtf (n.kids[0]), ' (par 2.2.1)'))
        END
    | Ast.NProcType :
        IF n.kids[0] IS SOME pl THEN
          FOR i := 0 TO pl.nkids - 1 DO
            IF pl.kids[i] IS SOME grp THEN CheckTypeNode (grp.kids[1], ctx) END
          END
        END ;
        CheckTypeNode (n.kids[1], ctx)
    | Ast.NRecordType :
        (* kids[0] is the extension base, when there is one *)
        (* type extension is specified and not built (par 2.2): the
           generator knew no field of a base (`e.a0' on an extension
           of an extension, the fuzz review's ext3, until 2026-10-30) *)
        IF n.kids[0] IS SOME THEN
          ErrN (n, ctx, S3 ('type extension, RECORD (', Print.TypeTextUtf (pool, n.kids[0]),
            ') ..., is not in the language yet: give the fields one by one (par 2.2)'))
        END ;
        CheckTypeNode (n.kids[0], ctx) ;
        CheckFieldTypes (n.kids[1], ctx)
    | Ast.NMonitorType : CheckFieldTypes (n.kids[0], ctx)
    | Ast.NCaseRecordType :
        FOR i := 0 TO n.nkids - 1 DO
          IF n.kids[i] IS SOME v THEN CheckFieldTypes (v.kids[0], ctx) END
        END
    ELSE
    END
  END
END CheckTypeNode ;

PROCEDURE CheckFieldTypes (fs: Ast.Kid ; RO ctx: UTF) =
VAR i : I64 ;
BEGIN
  IF fs IS SOME seq THEN
    FOR i := 0 TO seq.nkids - 1 DO
      IF seq.kids[i] IS SOME g THEN
        CheckTypeNode (g.kids[1], ctx) ;
        IF IsBareProc (g.kids[1]) THEN
          ErrN (g, ctx, 'a field of procedure type must be OPT (par 2.2.3)')
        END
      END
    END
  END
END CheckFieldTypes ;

PROCEDURE CheckVarTypes (holder: PTR Ast.Node ; RO ctx: UTF) =
  (* the VAR sections directly under a unit or a procedure body *)
VAR a, b : I64 ;
BEGIN
  FOR a := 0 TO holder.nkids - 1 DO
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NVarSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME vd THEN
            CheckTypeNode (vd.kids[1], ctx) ;
            IF IsBareProc (vd.kids[1]) THEN
              ErrN (vd, ctx, 'a variable of procedure type must be OPT (par 2.2.3)')
            END
          END
        END
      ELSIF sect.kind = Ast.NTypeSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME td THEN
            typeTop := TRUE ;
            CheckTypeNode (td.kids[0], ctx) ;
            (* the grammar allows a TYPE in a procedure (ProcBody is
               { Declaration } Block) and nothing implements one: the
               generator refused its first use as `selector form
               unsupported yet' (2026-10-22) *)
            IF holder.kind # Ast.NProgram AND holder.kind # Ast.NImplementation AND
               holder.kind # Ast.NDefinition THEN
              ErrN (td, ctx, S3 ('a TYPE declared in a procedure is not in the language yet: declare ',
                                 td.au, ' at module level'))
            END
          END
        END
      END
    END
  END
END CheckVarTypes ;

(* the TYPE names a procedure body declares, for TypeNowhere *)
PROCEDURE LocalTypes (body: Ast.Kid) =
VAR a, b : I64 ;
BEGIN
  NxClear (localTyIx) ;
  IF body IS SOME bd THEN
    FOR a := 0 TO bd.nkids - 1 DO
      IF bd.kids[a] IS SOME sect THEN
        IF sect.kind = Ast.NTypeSection THEN
          FOR b := 0 TO sect.nkids - 1 DO
            IF sect.kids[b] IS SOME td THEN
              NxAdd (localTyIx, Text.Keep (pool, td.au), 1)
            END
          END
        END
      END
    END
  END
END LocalTypes ;

PROCEDURE CheckDeclTypes (u: PTR Ast.Node) =
  (* one pass over a unit, in declaration order: its TYPE and VAR
     sections under the unit's own name, then each procedure's
     parameters, return type and locals under the procedure's *)
VAR i, a : I64 ;
BEGIN
  NxClear (localTyIx) ;
  CheckVarTypes (u, u.au) ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        IF d.nkids > 4 THEN LocalTypes (d.kids[4]) ELSE NxClear (localTyIx) END ;
        IF d.kids[0] IS SOME pl THEN
          FOR a := 0 TO pl.nkids - 1 DO
            IF pl.kids[a] IS SOME grp THEN
              CheckTypeNode (grp.kids[1], u.au + '.' + d.au)
            END
          END
        END ;
        CheckTypeNode (d.kids[1], u.au + '.' + d.au) ;
        IF IsBareProc (d.kids[1]) THEN
          ErrN (d, u.au + '.' + d.au,
            'a procedure cannot answer a procedure value (par 2.2.3)')
        END ;
        IF d.kids[4] IS SOME body THEN
          CheckVarTypes (body, u.au + '.' + d.au)
        END
      END
    END
  END
END CheckDeclTypes ;

(* the signature as TEXT: two declarations are the same declaration
   exactly when the printer renders them the same way, which is why
   def/impl conformance is a string comparison and not a tree walk *)
PROCEDURE SigOf (p: PTR Ast.Node) : UTF =
VAR
  scratch : POOL ;                (* the builder dies with the call *)
  d : PTR DynUtf.DString IN scratch ;
  r : SLICE OF UTF ;
  i : I64 ;
BEGIN
  d := DynUtf.New (scratch) ;
  DynUtf.AppendChar (d, '(') ;
  DynUtf.Append (d, Print.ParamsTextUtf (p.kids[0])) ;
  DynUtf.AppendChar (d, ')') ;
  IF p.kids[1] IS SOME rt THEN
    DynUtf.Append (d, ' : ') ;
    DynUtf.Append (d, Print.TypeTextUtf (pool, p.kids[1]))
  END ;
  IF p.kids[2] IS SOME rs THEN
    DynUtf.Append (d, ' RAISES ') ;
    r := RaisesOf (pool, p) ;
    FOR i := 0 TO LEN (r) - 1 DO
      IF i > 0 THEN DynUtf.Append (d, ', ') END ;
      DynUtf.Append (d, r[i])
    END
  END ;
  IF p.kids[3] IS SOME at THEN
    DynUtf.Append (d, ' [') ;
    DynUtf.Append (d, at.au) ;
    DynUtf.AppendChar (d, ']')
  END ;
  RETURN DynUtf.View (d)
END SigOf ;

PROCEDURE AddProc (m: I64 ; KEPT p: ProcInfo) =
VAR
  nb : SLICE OF ProcInfo ;
  i : I64 ;
BEGIN
  IF mods[m].nprocs = LEN (mods[m].procs) THEN
    nb := NEW (pool, ProcInfo, 2 * LEN (mods[m].procs)) ;
    FOR i := 0 TO mods[m].nprocs - 1 DO nb[i] := mods[m].procs[i] END ;
    mods[m].procs := nb
  END ;
  mods[m].procs[mods[m].nprocs] := p ;
  NxAdd (mods[m].procIx, p.name, mods[m].nprocs) ;
  mods[m].nprocs := mods[m].nprocs + 1
END AddProc ;

PROCEDURE AddType (m: I64 ; RO KEPT n: UTF ; KEPT body: Ast.Kid) =
VAR
  ns : SLICE OF UTF ;
  nk : SLICE OF AKid ;
  i : I64 ;
BEGIN
  IF mods[m].ntds = LEN (mods[m].tdNames) THEN
    ns := NEW (pool, UTF, 2 * LEN (mods[m].tdNames)) ;
    nk := NEW (pool, AKid, 2 * LEN (mods[m].tdNodes)) ;
    FOR i := 0 TO mods[m].ntds - 1 DO
      ns[i] := mods[m].tdNames[i] ;
      nk[i] := mods[m].tdNodes[i]
    END ;
    mods[m].tdNames := ns ;
    mods[m].tdNodes := nk
  END ;
  mods[m].tdNames[mods[m].ntds] := n ;
  NxAdd (mods[m].tdIx, n, mods[m].ntds) ;
  mods[m].tdNodes[mods[m].ntds] := body ;
  mods[m].ntds := mods[m].ntds + 1
END AddType ;

PROCEDURE AddConst (m: I64 ; RO KEPT n: UTF ; RO KEPT ty: UTF ; KEPT val: Ast.Kid) =
VAR
  ns, ts : SLICE OF UTF ;
  vs : SLICE OF AKid ;
  i : I64 ;
BEGIN
  IF mods[m].ncns >= LEN (mods[m].cnVals) THEN
    vs := NEW (pool, AKid, 2 * LEN (mods[m].cnVals) + 16) ;
    FOR i := 0 TO mods[m].ncns - 1 DO vs[i] := mods[m].cnVals[i] END ;
    mods[m].cnVals := vs
  END ;
  mods[m].cnVals[mods[m].ncns] := val ;
  (* what is remembered is the LitType, not a type: `Par.Pi180` must
     adapt in another module exactly as `Pi180` adapts in its own *)
  IF mods[m].ncns = LEN (mods[m].cnNames) THEN
    ns := NEW (pool, UTF, 2 * LEN (mods[m].cnNames) + 16) ;
    ts := NEW (pool, UTF, 2 * LEN (mods[m].cnTypes) + 16) ;
    FOR i := 0 TO mods[m].ncns - 1 DO
      ns[i] := mods[m].cnNames[i] ;
      ts[i] := mods[m].cnTypes[i]
    END ;
    mods[m].cnNames := ns ;
    mods[m].cnTypes := ts
  END ;
  mods[m].cnNames[mods[m].ncns] := n ;
  NxAdd (mods[m].cnIx, n, mods[m].ncns) ;
  mods[m].cnTypes[mods[m].ncns] := ty ;
  mods[m].ncns := mods[m].ncns + 1
END AddConst ;

(* an exported variable: declared in the definition, so an importer
   names it Mod.v (decision 28) *)
PROCEDURE AddExportVar (m: I64 ; RO KEPT n: UTF ; KEPT ty: AKid ; ro: BOOL) =
VAR
  ns : SLICE OF UTF ;
  ts : SLICE OF AKid ;
  rs : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  IF mods[m].nvrs = LEN (mods[m].vrNames) THEN
    ns := NEW (pool, UTF, 2 * LEN (mods[m].vrNames) + 8) ;
    ts := NEW (pool, AKid, 2 * LEN (mods[m].vrNames) + 8) ;
    rs := NEW (pool, BOOL, 2 * LEN (mods[m].vrNames) + 8) ;
    FOR i := 0 TO mods[m].nvrs - 1 DO
      ns[i] := mods[m].vrNames[i] ;
      ts[i] := mods[m].vrTypes[i] ;
      rs[i] := mods[m].vrRo[i]
    END ;
    mods[m].vrNames := ns ;
    mods[m].vrTypes := ts ;
    mods[m].vrRo := rs
  END ;
  mods[m].vrNames[mods[m].nvrs] := n ;
  mods[m].vrTypes[mods[m].nvrs] := ty ;
  mods[m].vrRo[mods[m].nvrs] := ro ;
  mods[m].nvrs := mods[m].nvrs + 1
END AddExportVar ;

(* is v a variable module m's definition exports? *)
PROCEDURE ExportsVar (m: I64 ; RO v: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  FOR i := 0 TO mods[m].nvrs - 1 DO
    IF Text.Eq (mods[m].vrNames[i], v) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END ExportsVar ;

PROCEDURE AddExc (m: I64 ; RO KEPT n: UTF ; KEPT decl: Ast.Kid) =
VAR
  ns : SLICE OF UTF ;
  nd : SLICE OF AKid ;
  i : I64 ;
BEGIN
  IF mods[m].nexc = LEN (mods[m].exNames) THEN
    ns := NEW (pool, UTF, 2 * LEN (mods[m].exNames) + 16) ;
    nd := NEW (pool, AKid, 2 * LEN (mods[m].exNames) + 16) ;
    FOR i := 0 TO mods[m].nexc - 1 DO
      ns[i] := mods[m].exNames[i] ;
      nd[i] := mods[m].exDecls[i]
    END ;
    mods[m].exNames := ns ;
    mods[m].exDecls := nd
  END ;
  mods[m].exNames[mods[m].nexc] := n ;
  mods[m].exDecls[mods[m].nexc] := decl ;
  mods[m].nexc := mods[m].nexc + 1
END AddExc ;

(* the EXCEPTION declaration a handler names, and the module that
   declares it: qualified, that module; bare, the predeclared ones have
   none, else the current module first, then any (as ExcKnown finds
   it) *)
PROCEDURE ExcDeclOf (RO qual: UTF ; RO nm: UTF ; VAR owner: UTF) : Ast.Kid =
VAR m, i, first : I64 ;
BEGIN
  owner := '' ;
  IF Text.BLen (qual) > 0 THEN
    m := FindMod (qual) ;
    IF m < 0 THEN RETURN NONE END ;
    FOR i := 0 TO mods[m].nexc - 1 DO
      IF Text.Eq (mods[m].exNames[i], nm) THEN owner := qual ; RETURN mods[m].exDecls[i] END
    END ;
    RETURN NONE
  END ;
  first := FindMod (curMod) ;
  IF first >= 0 THEN
    FOR i := 0 TO mods[first].nexc - 1 DO
      IF Text.Eq (mods[first].exNames[i], nm) THEN owner := curMod ; RETURN mods[first].exDecls[i] END
    END
  END ;
  FOR m := 0 TO nmods - 1 DO
    FOR i := 0 TO mods[m].nexc - 1 DO
      IF Text.Eq (mods[m].exNames[i], nm) THEN owner := mods[m].name ; RETURN mods[m].exDecls[i] END
    END
  END ;
  IF Text.Eq (nm, 'IndexError') THEN RETURN ixDecl END ;
  RETURN NONE
END ExcDeclOf ;

(* the type of the k-th payload field of an EXCEPTION declaration,
   qualified in its module so that it resolves wherever the handler
   is; NONE past the fields or for a bare declaration *)
PROCEDURE ExcFieldType (decl: Ast.Kid ; RO KEPT owner: UTF ; k: I64) : Ast.Kid ;

(* an exception as the program spelled it: Mod.Name or Name *)
PROCEDURE ExcSpelled (q: PTR Ast.Node) : UTF =
BEGIN
  IF Text.BLen (q.bu) > 0 THEN RETURN q.au + '.' + q.bu END ;
  RETURN q.au
END ExcSpelled ;

(* an exception's fields as one text -- `(I64, STR)' -- for the one-arm
   handler of several exceptions: a binder there needs the same fields
   in every one (2026-10-11) *)
PROCEDURE ExcFieldsText (q: PTR Ast.Node) : UTF =
VAR
  owner, r : UTF ;
  decl : Ast.Kid ;
  k : I64 ;
BEGIN
  owner := '' ;
  IF Text.BLen (q.bu) > 0 THEN decl := ExcDeclOf (q.au, q.bu, owner)
  ELSE decl := ExcDeclOf ('', q.au, owner) END ;
  r := '' ;
  k := 0 ;
  LOOP
    IF ExcFieldType (decl, owner, k) IS SOME ft THEN
      IF k > 0 THEN r := r + ', ' END ;
      r := r + TyName (CanonT (SOME (ft), 0)) ;
      k := k + 1
    ELSE
      EXIT
    END
  END ;
  RETURN '(' + r + ')'
END ExcFieldsText ;

PROCEDURE ExcFieldType (decl: Ast.Kid ; RO KEPT owner: UTF ; k: I64) : Ast.Kid =
VAR g, j, ix : I64 ;
BEGIN
  IF decl IS SOME xd THEN
    IF xd.kids[0] IS SOME fs THEN
      ix := 0 ;
      FOR g := 0 TO fs.nkids - 1 DO
        IF fs.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ix = k THEN RETURN QualifiedIn (grp.kids[1], owner) END ;
              ix := ix + 1
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ExcFieldType ;

PROCEDURE HasExcIn (m: I64 ; RO n: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO mods[m].nexc - 1 DO
    IF Text.Eq (mods[m].exNames[i], n) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasExcIn ;

PROCEDURE ModConstType (RO modName: UTF ; RO n: UTF ;
                        VAR found: BOOL) : UTF =
VAR m, i : I64 ;
BEGIN
  found := FALSE ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN '' END ;
  i := NxFind (mods[m].cnIx, n) ;
  IF i < 0 THEN RETURN '' END ;
  found := TRUE ;
  RETURN mods[m].cnTypes[i]
END ModConstType ;

PROCEDURE AddOpaque (m: I64 ; RO KEPT n: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF mods[m].nopaque = LEN (mods[m].opaque) THEN
    ns := NEW (pool, UTF, 2 * LEN (mods[m].opaque)) ;
    FOR i := 0 TO mods[m].nopaque - 1 DO ns[i] := mods[m].opaque[i] END ;
    mods[m].opaque := ns
  END ;
  mods[m].opaque[mods[m].nopaque] := n ;
  mods[m].nopaque := mods[m].nopaque + 1
END AddOpaque ;

PROCEDURE AddVariants (m: I64 ; RO KEPT tn: UTF ; KEPT cr: PTR Ast.Node) =
VAR
  nb : SLICE OF VariantInfo ;
  i, k : I64 ;
BEGIN
  IF mods[m].nvts = LEN (mods[m].vts) THEN
    nb := NEW (pool, VariantInfo, 2 * LEN (mods[m].vts)) ;
    FOR i := 0 TO mods[m].nvts - 1 DO nb[i] := mods[m].vts[i] END ;
    mods[m].vts := nb
  END ;
  k := mods[m].nvts ;
  mods[m].vts[k].typeName := tn ;
  mods[m].vts[k].variants := NEW (pool, UTF, cr.nkids) ;
  mods[m].vts[k].fields := NEW (pool, AKid, cr.nkids) ;
  FOR i := 0 TO cr.nkids - 1 DO
    IF cr.kids[i] IS SOME v THEN
      mods[m].vts[k].variants[i] := v.au ;
      mods[m].vts[k].fields[i] := v.kids[0]
    END
  END ;
  mods[m].nvts := k + 1
END AddVariants ;

PROCEDURE AddModVar (m: I64 ; RO KEPT n: UTF ; KEPT ty: Ast.Kid) =
VAR
  nn : SLICE OF UTF ;
  nt : SLICE OF AKid ;
  i : I64 ;
BEGIN
  IF mods[m].nmvs = LEN (mods[m].mvNames) THEN
    nn := NEW (pool, UTF, 2 * LEN (mods[m].mvNames) + 8) ;
    nt := NEW (pool, AKid, 2 * LEN (mods[m].mvNames) + 8) ;
    FOR i := 0 TO mods[m].nmvs - 1 DO
      nn[i] := mods[m].mvNames[i] ;
      nt[i] := mods[m].mvTypes[i]
    END ;
    mods[m].mvNames := nn ;
    mods[m].mvTypes := nt
  END ;
  mods[m].mvNames[mods[m].nmvs] := n ;
  mods[m].mvTypes[mods[m].nmvs] := ty ;
  mods[m].nmvs := mods[m].nmvs + 1
END AddModVar ;

PROCEDURE CollectUnit (KEPT u: PTR Ast.Node) =
VAR
  m, i, j, pi : I64 ;
  p : ProcInfo ;
BEGIN
  m := FindMod (u.au) ;
  IF m < 0 THEN m := NewMod (u.au) END ;
  IF u.kind = Ast.NDefinition THEN
    mods[m].hasDef := TRUE ;
    IF Text.BLen (u.bu) > 0 THEN mods[m].foreignLang := u.bu END ;
    IF u.f2 THEN mods[m].stateful := TRUE END
  END ;
  IF u.kind = Ast.NImplementation THEN mods[m].hasImpl := TRUE END ;

  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcIn (m, d.au) ;
        IF pi < 0 THEN
          p.name := d.au ;
          p.modName := mods[m].name ;
          p.foreign := d.bu ;
          IF d.kids[3] IS SOME at THEN p.attrib := at.au
          ELSE p.attrib := '' END ;
          p.raises := RaisesSpelled (pool, d) ;
          p.sig := Text.Keep (pool, SigOf (d)) ;
          p.node := SOME (d) ;
          p.body := NONE ;
          p.fromDef := u.kind = Ast.NDefinition ;
          p.hasBody := FALSE ;
          IF d.kids[4] IS SOME bd THEN
            p.hasBody := TRUE ;
            p.body := SOME (d)
          END ;
          AddProc (m, p)
        ELSE
          IF d.kids[4] IS SOME bd2 THEN
            mods[m].procs[pi].hasBody := TRUE ;
            mods[m].procs[pi].body := SOME (d)
          END
        END
      ELSIF d.kind = Ast.NExcSection THEN
        (* the declared exceptions: RAISE/RAISES/handler may only
           cite a name the reader can find *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME xd THEN AddExc (m, xd.au, SOME (xd)) END
        END
      ELSIF d.kind = Ast.NVarSection AND u.kind = Ast.NDefinition THEN
        (* the definition's variables are the module's exports: an
           importer reads and writes them as Mod.v (decision 28) *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME vids THEN
              FOR pi := 0 TO vids.nkids - 1 DO
                IF vids.kids[pi] IS SOME vid THEN
                  AddExportVar (m, vid.au, QualifiedIn (vd.kids[1], mods[m].name),
                                vd.f3)
                END
              END
            END
          END
        END
      ELSIF d.kind = Ast.NVarSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME vd THEN
            IF vd.kids[0] IS SOME vids THEN
              FOR pi := 0 TO vids.nkids - 1 DO
                IF vids.kids[pi] IS SOME vid THEN AddModVar (m, vid.au, vd.kids[1]) END
              END
            END
          END
        END
      ELSIF d.kind = Ast.NConstSection THEN
        (* a CONST is an untyped literal; what is kept is its
           LitType, so an importer sees it adapt as its own module
           does *)
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cd2 THEN
            AddConst (m, cd2.au, Text.Keep (pool, LitType (cd2.kids[0])), cd2.kids[0])
          END
        END
      ELSIF d.kind = Ast.NTypeSection THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME td THEN
            IF td.kids[0] IS SOME body THEN
              IF FindTypeIn (m, td.au) IS SOME already THEN
                (* the definition's copy wins; an implementation may
                   restate an opaque type's body *)
              ELSE
                AddType (m, td.au, td.kids[0])
              END ;
              IF body.kind = Ast.NCaseRecordType THEN
                AddVariants (m, td.au, body)
              END ;
              (* an enumeration is a payload-less case record: its
                 members ARE its variants, so Colour.Red constructs, a
                 CASE over it is total, and it crosses modules -- all
                 from the case-record machinery.  nkIdent and a
                 payload-less nkVariant have the same shape here:
                 name in .a, no payload kid (docs/enum-plan.md). *)
              IF body.kind = Ast.NEnumType THEN
                AddVariants (m, td.au, body)
              END
            ELSE
              IF u.kind = Ast.NDefinition THEN AddOpaque (m, td.au) END
            END
          END
        END
      END
    END
  END
END CollectUnit ;

(* NaN, the predeclared quiet NaN (report par 2.1; Alex 2026-10-05):
   a bare designator NaN becomes the real literal whose text is C's
   NAN, so it is typed, adapts to F32 and is emitted as a literal is.
   Once per file, before anything reads it, here and in both
   generators (Gen.NanWalk): the generator also runs without the
   checker.  A declaration may not take the name (DeclOnce), so a
   NaN is always this one. *)
PROCEDURE NanWalk (VAR n: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND Text.Eq (n.au, 'NaN') THEN
    n.kind := Ast.NReal ;
    Ast.SetA (pool, n, 'NAN')
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN NanWalk (c) END
  END
END NanWalk ;

(* FOR x IN s makes an assignment each time round, x := s[i], and the
   checker's rules about what may flow where are rules about
   assignments: read-only storage (par 2.4), frame and pool storage,
   borrows carried (par 4.1).  So the loop's assignment is WRITTEN DOWN
   once per file, `x := s[0]' as the FOR IN node's kids[2], where every
   pass that reads a procedure's assignments finds it, and the walk
   checks it as the first statement of the body.  The parsers, the
   printers and the generators never see it (2026-10-11). *)
PROCEDURE ForInWalk (VAR n: PTR Ast.Node) =
VAR i, j : I64 ;
  asg, lhs, rhs, sel, ix : PTR Ast.Node ;
BEGIN
  IF n.kind = Ast.NForIn AND n.nkids = 2 THEN
    IF n.kids[0] IS SOME s THEN
      IF s.kind = Ast.NDesignator THEN
        lhs := Ast.NewNode (pool, Ast.NDesignator, n.line, n.col) ;
        Ast.SetA (pool, lhs, n.au) ;
        rhs := Ast.NewNode (pool, Ast.NDesignator, s.line, s.col) ;
        Ast.SetA (pool, rhs, s.au) ;
        Ast.SetB (pool, rhs, s.bu) ;
        FOR j := 0 TO s.nkids - 1 DO Ast.Add (pool, rhs, s.kids[j]) END ;
        ix := Ast.NewNode (pool, Ast.NInt, s.line, s.col) ;
        Ast.SetA (pool, ix, '0') ;
        sel := Ast.NewNode (pool, Ast.NSelIndex, s.line, s.col) ;
        Ast.Add (pool, sel, SOME (ix)) ;
        Ast.Add (pool, rhs, SOME (sel)) ;
        asg := Ast.NewNode (pool, Ast.NAssign, n.line, n.col) ;
        Ast.Add (pool, asg, SOME (lhs)) ;
        Ast.Add (pool, asg, SOME (rhs)) ;
        Ast.Add (pool, n, SOME (asg))
      END
    END
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN ForInWalk (c) END
  END
END ForInWalk ;

PROCEDURE IsNanLit (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN
    RETURN n.kind = Ast.NReal AND Text.Eq (n.au, 'NAN')
  END ;
  RETURN FALSE
END IsNanLit ;

PROCEDURE LoadFile (VAR root: PTR Ast.Node) =
VAR i : I64 ;
BEGIN
  Setup () ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME w THEN NanWalk (w) END
  END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME v THEN ForInWalk (v) END
  END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN CollectUnit (u) END
  END
END LoadFile ;


(* ---- types, canonicalised ---- *)

(* A type is its CANONICAL STRING: 'I64', 'PTR Json.Node',
   'SLICE OF CHAR'.  Records, monitors and opaques are nominal
   (Mod.Name); aliases chase to structure; IN-pool and RO are not
   part of identity, because they annotate the binding and not the
   type.  Two types are the same type exactly when these strings
   match, which is also how def and impl signatures are compared. *)
(* a bare type name found by the scan over every loaded module, not in
   the module asking or the one the name was written in: the review's
   tier 2 item 12 counts these before the scan is made to refuse --
   each is a site that leaned on load order (the canonCtx class).
   Listed under M9_REGIONS=1, once per name and module *)
VAR
  tsSeen : SLICE OF UTF ;
  ntsSeen : I64 ;

PROCEDURE TypeScan (RO how, typeName: UTF ; i: I64) =
VAR
  key, msg : UTF ;
  j : I64 ;
  ns : SLICE OF UTF ;
BEGIN
  IF NOT rgOn THEN RETURN END ;
  key := Cat (Cat (Cat (curMod, ' '), canonCtx), Cat (Cat (' ', typeName), Cat (' ', mods[i].name))) ;
  FOR j := 0 TO ntsSeen - 1 DO
    IF Text.Eq (tsSeen[j], key) THEN RETURN END
  END ;
  IF ntsSeen = LEN (tsSeen) THEN
    ns := NEW (pool, UTF, 2 * ntsSeen + 16) ;
    FOR j := 0 TO ntsSeen - 1 DO ns[j] := tsSeen[j] END ;
    tsSeen := ns
  END ;
  tsSeen[ntsSeen] := Text.Keep (pool, key) ;
  ntsSeen := ntsSeen + 1 ;
  msg := Cat (Cat (Cat ('regions: typescan: ', how), Cat (' ', typeName)),
    Cat (Cat (' found in ', mods[i].name), Cat (Cat (' asked from ', curMod), Cat (' ctx ', canonCtx)))) ;
  Diag (rgNotes, nrg, 0, 0, curMod, msg)
END TypeScan ;

(* ---- the UTF-8 plan's step 0 (docs/utf8-plan.md): every use of a
   STR the switch refuses -- a subscript, a write through one, a LEN --
   listed under M9_REGIONS=1 as `regions: strscan: KIND BASE[INDEX]', once
   a node.  By the DECLARED type: STR or an alias of it, not SLICE OF
   CHAR spelled out, which stays a character array. *)

PROCEDURE NamesStr (t: Ast.Kid) : BOOL =
VAR
  cur : Ast.Kid ;
  depth : I64 ;
BEGIN
  cur := t ;
  depth := 0 ;
  WHILE depth < 32 DO
    IF cur IS SOME n THEN
      IF n.kind # Ast.NQualident THEN RETURN FALSE END ;
      IF Text.BLen (n.bu) = 0 AND Text.Eq (n.au, 'STR') THEN RETURN TRUE END ;
      IF Text.BLen (n.bu) = 0 THEN cur := LookupTypeName ('', n.au)
      ELSE cur := LookupTypeName (n.au, n.bu) END
    ELSE
      RETURN FALSE
    END ;
    depth := depth + 1
  END ;
  RETURN FALSE
END NamesStr ;

PROCEDURE StrScan (n: PTR Ast.Node ; RO kind: UTF ; RO what: UTF) =
VAR
  key : UTF ;
  nt : SLICE OF UTF ;
  i : I64 ;
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  (* a body the switch deletes: the STR form of a procedure whose UTF
     twin this module declares (docs/utf8-stage4-plan.md, 4b) *)
  IF Text.BLen (curProcNm) > 0 THEN
    IF Text.BLen (curProcNm) < 3 OR
       NOT Text.Eq (SLICE (curProcNm, Text.BLen (curProcNm) - 3, 3), 'Utf') THEN
      pr := LookupProc (Cat (curProcNm, 'Utf'), found) ;
      IF found AND Text.Eq (pr.modName, curMod) THEN RETURN END
    END
  END ;
  key := Text.Keep (pool, Cat (ItoA (n.id), Cat (' ', kind))) ;
  IF NxFind (strScanIx, key) >= 0 THEN RETURN END ;
  NxAdd (strScanIx, key, 1) ;
  (* the site for the review page (StrSite), always *)
  IF nss = LEN (ssText) THEN
    nt := NEW (pool, UTF, 2 * LEN (ssText) + 16) ;
    FOR i := 0 TO nss - 1 DO nt[i] := ssText[i] END ;
    ssText := nt
  END ;
  ssText[nss] := Text.Keep (pool, S5 (ItoA (n.line), ' ', kind, ' ', what)) ;
  nss := nss + 1 ;
  IF rgOn THEN
    Diag (rgNotes, nrg, n.line, n.col, curMod,
          Cat (Cat ('regions: strscan: ', kind), Cat (' ', what)))
  END
END StrScan ;

PROCEDURE LookupTypeName (RO modName: UTF ; RO typeName: UTF)
  : Ast.Kid =
VAR
  m, i : I64 ;
BEGIN
  IF Text.BLen (modName) > 0 THEN
    m := FindMod (modName) ;
    IF m < 0 THEN RETURN NONE END ;
    resolvedIn := m ;
    RETURN FindTypeIn (m, typeName)
  END ;
  (* a bare name resolves in the module that WROTE it first (canonCtx),
     as CanonQual's does: the scan below found it there only because no
     module loaded earlier declared one of the name (the review's tier 2
     item 12; measured 2026-10-22, the scans' hits over the tree and the
     applications went from 1,519 to 1,255 with this) *)
  IF Text.BLen (canonCtx) > 0 THEN
    m := FindMod (canonCtx) ;
    IF m >= 0 THEN
      IF FindTypeIn (m, typeName) IS SOME t0 THEN
        resolvedIn := m ;
        RETURN SOME (t0)
      END
    END
  END ;
  m := FindMod (curMod) ;
  IF m >= 0 THEN
    IF FindTypeIn (m, typeName) IS SOME t THEN
      resolvedIn := m ;
      RETURN SOME (t)
    END
  END ;
  FOR i := 0 TO nmods - 1 DO
    IF FindTypeIn (i, typeName) IS SOME t2 THEN
      resolvedIn := i ;
      TypeScan ('lookup', typeName, i) ;
      RETURN SOME (t2)
    END
  END ;
  RETURN NONE
END LookupTypeName ;

PROCEDURE ResolveType (t: Ast.Kid) : Ast.Kid =
VAR
  cur : Ast.Kid ;
  depth : I64 ;
BEGIN
  cur := t ;
  depth := 0 ;
  resolvedIn := -1 ;
  LOOP
    IF cur IS SOME n THEN
      IF n.kind # Ast.NQualident THEN RETURN cur END ;
      IF depth >= MaxDepth THEN RETURN NONE END ;
      IF Text.BLen (n.bu) = 0 AND Text.Eq (n.au, 'STR') THEN
        IF strUtf THEN RETURN utfNode END ;
        RETURN strNode
      END ;
      IF Text.BLen (n.bu) = 0 AND Text.Eq (n.au, 'UTF') THEN RETURN utfNode END ;
      IF Text.BLen (n.bu) = 0 THEN cur := LookupTypeName ('', n.au)
      ELSE cur := LookupTypeName (n.au, n.bu) END ;
      depth := depth + 1
    ELSE
      RETURN NONE
    END
  END
END ResolveType ;

(* the name of the module ResolveType's last lookup ended in, '' for
   none -- a module-pool string, so it may be kept anywhere *)
PROCEDURE ResolvedMod () : UTF =
BEGIN
  IF resolvedIn < 0 THEN RETURN '' END ;
  RETURN mods[resolvedIn].name
END ResolvedMod ;

(* Three lists of type names, each a constant table (report par
   2.2.4) and a search; chains of Text.Eq until 2026-10-01. *)
CONST
  UtfTy = 'SLICE OF <u8>' ;   (* the canonical type UTF names *)
  BuiltinTys = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'F32', 'F64',
    'BYTE', 'BOOL', 'CHAR'
  ] ;
  (* the conversions that can refuse a value: RAISES ValueRange *)
  (* what C.Int and C.SizeT take without a check (CTotal) *)
  CIntTotal = ['I8', 'I16', 'I32', 'U8', 'U16', 'BYTE', 'CHAR', 'BOOL'] ;
  CSizeTotal = ['U8', 'U16', 'U32', 'U64', 'BYTE', 'CHAR', 'BOOL'] ;
  ConvVR = [
    'I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'BYTE', 'CHR'
  ] ;
  (* what widens to an I64 without loss, so I64 (x) is total *)
  WidensTo64 = [
    'C.Int', 'C.SSizeT', 'BYTE', 'I8', 'I16', 'I32', 'U8', 'U16', 'U32'
  ] ;

PROCEDURE IsBuiltinTy (RO n: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (n), BuiltinTys)
END IsBuiltinTy ;

(* the SLICE OF <u8> that UTF names, by its element (docs/utf8-plan.md) *)
PROCEDURE IsUtfNode (r: PTR Ast.Node) : BOOL =
BEGIN
  IF r.kind # Ast.NSliceType OR r.nkids = 0 THEN RETURN FALSE END ;
  IF r.kids[0] IS SOME el THEN
    RETURN el.kind = Ast.NQualident AND Text.BLen (el.bu) = 0 AND Text.Eq (el.au, '<u8>')
  END ;
  RETURN FALSE
END IsUtfNode ;

(* a string literal adapts to a UTF where one is wanted, as a numeric
   literal adapts to a width: the type the value is held to is the
   slot's.  Anything else keeps the type it has -- a STR variable is not
   a UTF *)
(* a designator naming a CONST whose value is a string literal -- this
   module's bare name, or an imported Mod.C -- adapts as the literal
   does (Alex, 2026-10-23, decision 66: Sem's own ModeVar = 'v' and
   UtfTy met the rule in its port).  Defined after IsConstHere. *)
PROCEDURE StrConstDesig (k: Ast.Kid) : BOOL ;

PROCEDURE AdaptLit (k: Ast.Kid ; RO dst: UTF ; RO src: UTF) : UTF =
BEGIN
  IF Text.Eq (dst, UtfTy) THEN
    IF k IS SOME e THEN
      IF e.kind = Ast.NString OR StrConstDesig (k) THEN RETURN UtfTy END
    END
  END ;
  RETURN src
END AdaptLit ;

(* the UTF builtins (docs/utf8-plan.md, U2; Alex: "conversions + view"):
   UTF (s) encodes a STR, UTF (b) validates and copies a SLICE OF BYTE,
   STR (u) decodes, OCTETS (u) views the octets read-only.  A call of
   one, by its callee's bare name and one argument -- a procedure of
   the program's own by that name is not one *)
PROCEDURE UtfName (RO nm: UTF) : BOOL =
VAR found : BOOL ; pr : ProcInfo ;
BEGIN
  IF NOT (Text.Eq (nm, 'UTF') OR Text.Eq (nm, 'STR') OR Text.Eq (nm, 'OCTETS')) THEN
    RETURN FALSE
  END ;
  pr := LookupProc (nm, found) ;
  RETURN NOT found
END UtfName ;

PROCEDURE UtfBuiltin (e: PTR Ast.Node) : UTF =
VAR nm : UTF ;
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN '' END ;
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind # Ast.NDesignator OR dn.nkids # 0 THEN RETURN '' END ;
    nm := dn.au ;
    IF NOT UtfName (nm) THEN RETURN '' END ;
    IF e.kids[1] IS SOME al THEN
      IF al.nkids = 1 THEN RETURN nm END
    END
  END ;
  RETURN ''
END UtfBuiltin ;

(* the type of a UTF builtin's answer, its argument held to what it
   takes (an unknown argument type says nothing, as everywhere) *)
PROCEDURE UtfConvType (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                       RO at: UTF) : UTF =
BEGIN
  IF Text.Eq (name, 'UTF') THEN
    IF NOT (Text.BLen (at) = 0 OR Text.Eq (at, 'SLICE OF CHAR') OR Text.Eq (at, '<str1>') OR
            Text.Eq (at, 'SLICE OF BYTE') OR Text.Eq (at, UtfTy)) THEN
      ErrN (site, ctx, Cat ('UTF converts a STR (encoding it) or a SLICE OF BYTE (validating it), not ',
        TyName (at)))
    END ;
    RETURN UtfTy
  END ;
  IF NOT (Text.BLen (at) = 0 OR Text.Eq (at, UtfTy)) THEN
    IF Text.Eq (name, 'STR') THEN
      ErrN (site, ctx, Cat ('STR decodes a UTF, not ', TyName (at)))
    ELSE
      ErrN (site, ctx, Cat ('OCTETS views the octets of a UTF, not ', TyName (at)))
    END
  END ;
  IF Text.Eq (name, 'STR') THEN
    IF strUtf THEN RETURN UtfTy END ;           (* STR (u) is u *)
    RETURN 'SLICE OF CHAR'
  END ;
  RETURN 'SLICE OF BYTE'
END UtfConvType ;

(* a string literal, any length *)
PROCEDURE IsStringLit (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN RETURN e.kind = Ast.NString END ;
  RETURN FALSE
END IsStringLit ;

(* UTF (pool, x): the pool a UTF is placed in (Alex, 2026-10-23), the
   name of the first argument; '' for any other call *)
PROCEDURE UtfInPool (e: PTR Ast.Node) : UTF =
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN '' END ;
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind # Ast.NDesignator OR dn.nkids # 0 OR NOT Text.Eq (dn.au, 'UTF') THEN
      RETURN ''
    END ;
    IF NOT UtfName ('UTF') THEN RETURN '' END ;
    IF e.kids[1] IS SOME al THEN
      IF al.nkids = 2 THEN
        IF al.kids[0] IS SOME pd THEN
          IF pd.kind = Ast.NDesignator THEN RETURN pd.au END
        END
      END
    END
  END ;
  RETURN ''
END UtfInPool ;

(* a bare VAR pointer parameter, whose object's pool NEW (d, T) and
   UTF (d, x) allocate in *)
PROCEDURE ObjPoolArg (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME d THEN
    IF d.kind = Ast.NDesignator AND d.nkids = 0 THEN
      RETURN Text.Eq (ScopeMode (d.au), ModeVar) AND PtrParamTy (ScopeType (d.au))
    END
  END ;
  RETURN FALSE
END ObjPoolArg ;

(* OCTETS (u) is a view of u: the argument it views *)
PROCEDURE OctetsArg (e: PTR Ast.Node) : Ast.Kid =
BEGIN
  IF Text.Eq (UtfBuiltin (e), 'OCTETS') THEN
    IF e.kids[1] IS SOME al THEN RETURN al.kids[0] END
  END ;
  RETURN NONE
END OctetsArg ;

PROCEDURE ScalarAlias (RO name: UTF) : UTF ;

PROCEDURE WidthTwin (RO name: UTF ; single: BOOL) : UTF ;
PROCEDURE UtfTwin (RO name: UTF ; any: BOOL) : UTF ;

PROCEDURE CanonT (t: Ast.Kid ; depth: I64) : UTF ;
PROCEDURE ArrEnumBoundOf (declN: Ast.Kid) : UTF ;

(* hoisted rather than nested: M9 has no nested procedures.  They
   PARSE -- a procedure body accepts declarations, and PROCEDURE is
   one -- but the checker never registers them, so the call reads as
   unknown.  Logged as owed work; the grammar should refuse what the
   checker cannot see. *)
PROCEDURE TryModCanon (mi: I64 ; RO typeName: UTF ; depth: I64) : UTF =
VAR was, s : UTF ;
BEGIN
  IF mi < 0 THEN RETURN '' END ;
  IF FindTypeIn (mi, typeName) IS SOME td THEN
    IF td.kind = Ast.NRecordType OR td.kind = Ast.NCaseRecordType OR
       td.kind = Ast.NMonitorType OR td.kind = Ast.NEnumType THEN
      RETURN Qualify (mods[mi].name, typeName)
    END ;
    (* the declaration's bare names are the declaring module's *)
    was := canonCtx ;
    canonCtx := Text.Keep (pool, mods[mi].name) ;
    s := CanonT (SOME (td), depth + 1) ;
    canonCtx := was ;
    RETURN s
  END ;
  IF IsOpaqueIn (mi, typeName) THEN
    RETURN Qualify (mods[mi].name, typeName)
  END ;
  RETURN ''
END TryModCanon ;

PROCEDURE CanonQual (RO modName: UTF ; RO typeName: UTF ; depth: I64)
  : UTF =
VAR
  m, i : I64 ;
  s : UTF ;
BEGIN
  IF Text.BLen (modName) > 0 THEN
    RETURN TryModCanon (FindMod (modName), typeName, depth)
  END ;
  (* bare names resolve in their OWNING module first: a callee's
     signature written in Json must not find Ast's Node just because
     Ast loaded earlier *)
  IF Text.BLen (canonCtx) > 0 THEN m := FindMod (canonCtx)
  ELSE m := FindMod (curMod) END ;
  s := TryModCanon (m, typeName, depth) ;
  IF Text.BLen (s) > 0 THEN RETURN s END ;
  FOR i := 0 TO nmods - 1 DO
    s := TryModCanon (i, typeName, depth) ;
    IF Text.BLen (s) > 0 THEN
      TypeScan ('canon', typeName, i) ;
      RETURN s
    END
  END ;
  RETURN ''
END CanonQual ;

(* scalar-by-scalar order on two names, for the RAISES list below *)
PROCEDURE SigLess (RO a: UTF ; RO b: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (a) AND i < Text.BLen (b) DO
    IF B (a, i) # B (b, i) THEN RETURN B (a, i) < B (b, i) END ;
    i := i + 1
  END ;
  RETURN Text.BLen (a) < Text.BLen (b)
END SigLess ;

(* the canonical text of a procedure type, or of a procedure's head
   (par 2.2.3): the parameter modes and types with no names, the
   result with its RO, and the RAISES names bare and sorted.  Two
   procedure types are the same type exactly when this text is the
   same.  A procedure FITS a procedure type when its head renders the
   same up to RAISES and it raises no more than the type allows
   (ProcFits, since 2026-10-02; until then the RAISES had to match to
   the letter too, which made every quiet callback declare one). *)
PROCEDURE ProcSig (pl: Ast.Kid ; rt: Ast.Kid ; ro: BOOL ; rs: Ast.Kid ;
                   depth: I64) : UTF =
VAR
  d : PTR DynUtf.DString IN pool ;
  g, j, i, k : I64 ;
  first : BOOL ;
  s, tmp : UTF ;
  names : SLICE OF UTF ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, 'PROCEDURE (') ;
  first := TRUE ;
  IF pl IS SOME pln THEN
    FOR g := 0 TO pln.nkids - 1 DO
      IF pln.kids[g] IS SOME grp THEN
        s := CanonT (grp.kids[1], depth + 1) ;
        IF Text.BLen (s) = 0 THEN RETURN '' END ;
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF NOT first THEN DynUtf.Append (d, ' ; ') END ;
            first := FALSE ;
            IF grp.f1 THEN DynUtf.Append (d, 'VAR ') END ;
            IF grp.f2 THEN DynUtf.Append (d, 'OWN ') END ;
            IF grp.f3 THEN DynUtf.Append (d, 'RO ') END ;
            IF grp.f4 THEN DynUtf.Append (d, 'KEPT ') END ;
            DynUtf.Append (d, s)
          END
        END
      END
    END
  END ;
  DynUtf.AppendChar (d, ')') ;
  IF rt IS SOME rtn THEN
    s := CanonT (rt, depth + 1) ;
    IF Text.BLen (s) = 0 THEN RETURN '' END ;
    DynUtf.Append (d, ' : ') ;
    IF ro THEN DynUtf.Append (d, 'RO ') END ;
    DynUtf.Append (d, s)
  END ;
  IF rs IS SOME rsn THEN
    names := NEW (pool, UTF, rsn.nkids) ;
    (* each name KEYED as the RAISES accounting keys it (ExcKey):
       `EA.Error' and `EB.Error' rendered bare were one name, and a
       procedure raising EA.Error fitted a type raising EB.Error
       (2026-10-21, the compiler review's C5 repro) *)
    IF Text.BLen (canonCtx) > 0 THEN tmp := canonCtx ELSE tmp := curMod END ;
    FOR i := 0 TO rsn.nkids - 1 DO
      IF rsn.kids[i] IS SOME q THEN
        IF Text.BLen (q.bu) > 0 THEN names[i] := ExcKey (tmp, q.au + '.' + q.bu)
        ELSE names[i] := ExcKey (tmp, q.au) END
      END
    END ;
    FOR i := 1 TO rsn.nkids - 1 DO
      k := i ;
      WHILE k > 0 AND SigLess (names[k], names[k - 1]) DO
        tmp := names[k] ;
        names[k] := names[k - 1] ;
        names[k - 1] := tmp ;
        k := k - 1
      END
    END ;
    DynUtf.Append (d, ' RAISES ') ;
    FOR i := 0 TO rsn.nkids - 1 DO
      IF i > 0 THEN DynUtf.Append (d, ', ') END ;
      DynUtf.Append (d, names[i])
    END
  END ;
  RETURN DynUtf.ViewIn (pool, d)
END ProcSig ;

(* does a declared type resolve to a bare procedure type?  The four
   refusals of par 2.2.3 ask this: a variable or field of procedure
   type must be OPT, because a procedure value has no zero and a
   zeroed one would be a call into nothing. *)
(* is t a type OPT cannot hold: a value, not a pointer or procedure *)
PROCEDURE OptOverValue (t: Ast.Kid) : BOOL =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    RETURN r.kind # Ast.NPtrType AND r.kind # Ast.NProcType AND r.kind # Ast.NSharedType
  END ;
  IF t IS SOME n THEN
    IF n.kind = Ast.NQualident AND Text.BLen (n.bu) = 0 THEN
      RETURN Text.OneOf (STR (n.au), BuiltinTys) OR Text.Eq (n.au, 'POOL')
    END
  END ;
  RETURN FALSE
END OptOverValue ;

PROCEDURE IsBareProc (t: Ast.Kid) : BOOL =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    RETURN r.kind = Ast.NProcType
  END ;
  RETURN FALSE
END IsBareProc ;

(* an array bound as the canonical text spells it: a bare CONST of the
   module whose declaration is being read, when that is not this one,
   as `Mod.N' -- QualifiedIn's spelling.  Until 2026-10-29 Shapes.Vec
   = ARRAY N OF F64 read in an importer canonicalised as `ARRAY N OF
   F64' and the same field reached through a Shapes.Rec (InMod) as
   `ARRAY Shapes.N OF F64', and the assignment of one to the other was
   refused.  The names inside an expression too, and an enumeration:
   Shapes' ARRAY 2 * N OF I32 and an importer's own, with its own N,
   were one canonical text and the C compiler refused the assignment *)
PROCEDURE BoundQual (b: Ast.Kid ; mi: I64) : Ast.Kid =
VAR
  d, sf : PTR Ast.Node IN pool ;
  found : BOOL ;
  t : UTF ;
  i : I64 ;
BEGIN
  IF b IS SOME e THEN
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      t := ModConstType (mods[mi].name, e.au, found) ;
      IF NOT found THEN found := FindTypeIn (mi, e.au) IS SOME END ;
      IF found THEN
        d := Ast.NewNode (pool, Ast.NDesignator, e.line, e.col) ;
        Ast.SetA (pool, d, mods[mi].name) ;
        sf := Ast.NewNode (pool, Ast.NSelField, e.line, e.col) ;
        Ast.SetA (pool, sf, e.au) ;
        Ast.Add (pool, d, SOME (sf)) ;
        RETURN SOME (d)
      END
    ELSIF e.kind = Ast.NParen OR e.kind = Ast.NUn OR e.kind = Ast.NBin THEN
      d := Ast.NewNode (pool, e.kind, e.line, e.col) ;
      Ast.SetA (pool, d, e.au) ;
      FOR i := 0 TO e.nkids - 1 DO Ast.Add (pool, d, BoundQual (e.kids[i], mi)) END ;
      RETURN SOME (d)
    END
  END ;
  RETURN b
END BoundQual ;

(* the value of an array count: integer literals, CONSTs (bare in the
   module the type was written in -- canonCtx, else this one -- or
   Mod.N), under + - * DIV MOD, unary minus and parentheses.  Two
   array types with counts of one value are one type (Alex, 2026-10-30,
   a port's report M8: ARRAY N OF F64 with N = 3 was refused where
   ARRAY 3 OF F64 was expected) *)
PROCEDURE CountValue (k: Ast.Kid ; RO KEPT m: UTF ; depth: I64 ; VAR v: I64) : BOOL =
VAR
  a, b, i, mi : I64 ;
BEGIN
  IF depth > 16 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NInt THEN RETURN Ast.FoldInt (k, v) END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      IF Text.BLen (m) = 0 OR Text.Eq (m, curMod) THEN
        i := ConstAt (e.au) ;
        IF i >= 0 THEN RETURN CountValue (consts[i].ty, m, depth + 1, v) END
      END ;
      IF Text.BLen (m) > 0 THEN mi := FindMod (m) ELSE mi := FindMod (curMod) END ;
      IF mi >= 0 THEN
        i := NxFind (mods[mi].cnIx, e.au) ;
        IF i >= 0 AND i < LEN (mods[mi].cnVals) THEN
          RETURN CountValue (mods[mi].cnVals[i], mods[mi].name, depth + 1, v)
        END
      END ;
      RETURN FALSE
    END ;
    IF e.nkids < 1 THEN RETURN FALSE END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 1 THEN
      IF e.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          mi := FindMod (e.au) ;
          IF mi >= 0 THEN
            i := NxFind (mods[mi].cnIx, sf.au) ;
            IF i >= 0 AND i < LEN (mods[mi].cnVals) THEN
              RETURN CountValue (mods[mi].cnVals[i], mods[mi].name, depth + 1, v)
            END
          END
        END
      END ;
      RETURN FALSE
    END ;
    IF e.kind = Ast.NParen THEN RETURN CountValue (e.kids[0], m, depth + 1, v) END ;
    IF e.kind = Ast.NUn AND Text.Eq (e.au, '-') THEN
      IF NOT CountValue (e.kids[0], m, depth + 1, a) THEN RETURN FALSE END ;
      v := 0 - a ;
      RETURN TRUE
    END ;
    IF e.kind = Ast.NBin AND e.nkids = 2 THEN
      IF NOT CountValue (e.kids[0], m, depth + 1, a) THEN RETURN FALSE END ;
      IF NOT CountValue (e.kids[1], m, depth + 1, b) THEN RETURN FALSE END ;
      IF Text.Eq (e.au, '+') THEN v := a + b ; RETURN TRUE END ;
      IF Text.Eq (e.au, '-') THEN v := a - b ; RETURN TRUE END ;
      IF Text.Eq (e.au, '*') THEN v := a * b ; RETURN TRUE END ;
      IF Text.Eq (e.au, 'DIV') OR Text.Eq (e.au, 'MOD') THEN
        IF b = 0 THEN RETURN FALSE END ;
        IF b = -1 AND a = -9223372036854775807 - 1 THEN RETURN FALSE END ;
        IF Text.Eq (e.au, 'DIV') THEN v := a DIV b ELSE v := a MOD b END ;
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
EXCEPT
| Overflow : RETURN FALSE
END CountValue ;

PROCEDURE BoundText (b: Ast.Kid) : UTF =
VAR mi, v : I64 ;
BEGIN
  (* a count of a value is spelled by it (CountValue); an enumeration
     or what does not fold, by its name, read where it was written *)
  IF CountValue (b, canonCtx, 0, v) THEN RETURN ItoA (v) END ;
  IF Text.BLen (canonCtx) > 0 AND NOT Text.Eq (canonCtx, curMod) THEN
    mi := FindMod (canonCtx) ;
    IF mi >= 0 THEN RETURN Print.ExprTextUtf (BoundQual (b, mi)) END
  END ;
  RETURN Print.ExprTextUtf (b)
END BoundText ;

PROCEDURE CanonT (t: Ast.Kid ; depth: I64) : UTF =
VAR s : UTF ;
BEGIN
  IF depth > MaxDepth THEN RETURN '' END ;
  IF t IS SOME n THEN
    CASE n.kind OF
    | Ast.NProcType :
        RETURN ProcSig (n.kids[0], n.kids[1], n.f3, n.kids[2], depth)
    | Ast.NQualident :
        IF Text.BLen (n.bu) > 0 THEN
          IF Text.Eq (n.au, 'C') THEN RETURN Qualify ('C', n.bu) END ;
          RETURN CanonQual (n.au, n.bu, depth)
        END ;
        IF IsBuiltinTy (n.au) THEN RETURN n.au END ;
        IF Text.Eq (n.au, 'STR') THEN
          IF strUtf THEN RETURN UtfTy END ;     (* the switch, rehearsed *)
          RETURN 'SLICE OF CHAR'
        END ;
        IF Text.Eq (n.au, 'UTF') THEN RETURN UtfTy END ;
        IF Text.Eq (n.au, '<u8>') THEN RETURN '<u8>' END ;
        (* POOL is a type like any other to the comparison of an
           argument with its parameter.  Until 2026-10-01 it had no
           canonical form, so both sides of every pool argument were
           unknown and `Compat' never looked: 128 of the 175
           passed-over argument lines `m9c --review' listed for the
           library named a pool, and `TakesInt (pool)' -- a pool
           where an I64 is wanted -- was accepted by this checker and
           by the generator.  HEAP already answered 'POOL' in
           DesigStrType, alone. *)
        IF Text.Eq (n.au, 'POOL') THEN RETURN 'POOL' END ;
        RETURN CanonQual ('', n.au, depth)
    | Ast.NPtrType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF Text.BLen (s) > 0 THEN RETURN Cat ('PTR ', s) END
    | Ast.NOptType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF Text.BLen (s) > 0 THEN RETURN Cat ('OPT ', s) END
    | Ast.NSharedType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF Text.BLen (s) > 0 THEN RETURN Cat ('SHARED PTR ', s) END
    | Ast.NSliceType :
        s := CanonT (n.kids[0], depth + 1) ;
        IF Text.BLen (s) > 0 THEN RETURN Cat ('SLICE OF ', s) END
    | Ast.NArrayType :
        s := CanonT (n.kids[1], depth + 1) ;
        IF Text.BLen (s) > 0 THEN
          RETURN Cat (Cat (Cat ('ARRAY ', BoundText (n.kids[0])),
                           ' OF '), s)
        END
    | Ast.NGridType :
        s := CanonT (n.kids[1], depth + 1) ;
        IF Text.BLen (s) > 0 THEN
          RETURN Cat (Cat (Cat ('GRID ', Print.ExprTextUtf (n.kids[0])),
                           ' OF '), s)
        END
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END CanonT ;


(* ---- scope: names, their declared types, and their binding modes ----
   Modes are one CHAR: value param, VAR, OWN, RO, local, module var,
   and a binder from IS SOME or a handler.  Lookup answers the FIRST
   hit, so params and locals shadow module state -- a pass-2 blind
   spot the stateless corpus never exercised.                        *)

PROCEDURE ScopeClear () =
BEGIN
  nscope := 0 ;
  NxClear (scopeIx)
END ScopeClear ;

PROCEDURE ScopeAdd (RO KEPT nm: UTF ; KEPT t: Ast.Kid ; RO KEPT mode: UTF) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nscope = LEN (scope) THEN
    nb := NEW (pool, Binding, 2 * LEN (scope)) ;
    FOR i := 0 TO nscope - 1 DO nb[i] := scope[i] END ;
    scope := nb
  END ;
  scope[nscope].name := nm ;
  scope[nscope].ty := t ;
  scope[nscope].mode := mode ;
  scope[nscope].ro := FALSE ;
  scope[nscope].roFrom := '' ;
  scope[nscope].roLine := 0 ;
  scope[nscope].from := '' ;
  NxAdd (scopeIx, nm, nscope) ;
  nscope := nscope + 1
END ScopeAdd ;

(* was the name, as it is seen here, declared `VAR RO'? *)
PROCEDURE ScopeRo (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN FALSE END ;
  RETURN scope[i].ro
END ScopeRo ;

(* the read-only storage the name was given by an assignment in this
   procedure ('a string literal (line 12)'), or '' *)
PROCEDURE ScopeRoFrom (RO nm: UTF) : UTF =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN '' END ;
  IF Text.BLen (scope[i].roFrom) = 0 THEN RETURN '' END ;
  RETURN Cat (scope[i].roFrom, Cat (' (line ', Cat (ItoA (scope[i].roLine), ')')))
END ScopeRoFrom ;

PROCEDURE ScopeFind (RO nm: UTF) : I64 =
BEGIN
  RETURN NxFind (scopeIx, nm)
END ScopeFind ;

PROCEDURE ScopeMode (RO nm: UTF) : UTF =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN '' END ;
  RETURN scope[i].mode
END ScopeMode ;

PROCEDURE ScopeType (RO nm: UTF) : Ast.Kid =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN RETURN NONE END ;
  RETURN scope[i].ty
END ScopeType ;

PROCEDURE AddParamsOf (d: PTR Ast.Node) =
VAR
  a, b : I64 ;
  mode : UTF ;
BEGIN
  IF d.kids[0] IS SOME pl THEN
    FOR a := 0 TO pl.nkids - 1 DO
      IF pl.kids[a] IS SOME grp THEN
        IF grp.f1 THEN mode := ModeVar
        ELSIF grp.f2 THEN mode := ModeOwn
        ELSIF grp.f3 THEN mode := ModeRo
        ELSE mode := ModeVal END ;
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF ids.kids[b] IS SOME id THEN
              ScopeAdd (id.au, grp.kids[1], mode) ;
              IF grp.f4 THEN KeptPush (id.au, id.line, id.col) END
            END
          END
        END
      END
    END
  END
END AddParamsOf ;

PROCEDURE AddVarsOf (holder: PTR Ast.Node ; RO KEPT mode: UTF) =
VAR a : I64 ;
BEGIN
  (* where the holder's VAR sections are, found once per holder: a
     unit's declarations were walked again for every procedure, n
     squared in its procedures (the review's F5) *)
  IF holder.id # avHolder THEN
    IF holder.kind # Ast.NProgram AND holder.kind # Ast.NImplementation AND
       holder.kind # Ast.NDefinition THEN
      (* a procedure body, walked once: no need to remember it, and
         remembering it would evict the unit's *)
      AddVarsAt (holder, mode, 0, holder.nkids, FALSE) ;
      RETURN
    END ;
    avHolder := holder.id ;
    navAt := 0 ;
    IF LEN (avAt) < holder.nkids THEN avAt := NEW (pool, I64, holder.nkids + 16) END ;
    FOR a := 0 TO holder.nkids - 1 DO
      IF holder.kids[a] IS SOME vs THEN
        IF vs.kind = Ast.NVarSection THEN
          avAt[navAt] := a ;
          navAt := navAt + 1
        END
      END
    END
  END ;
  AddVarsAt (holder, mode, 0, navAt, TRUE)
END AddVarsOf ;

(* the VAR sections among holder's kids from .. to - 1, or, with
   listed, those avAt[from .. to - 1] names *)
PROCEDURE AddVarsAt (holder: PTR Ast.Node ; RO KEPT mode: UTF ;
                     from: I64 ; to: I64 ; listed: BOOL) =
VAR a, b, c, k, q : I64 ;
BEGIN
  FOR q := from TO to - 1 DO
    a := q ;
    IF listed THEN a := avAt[q] END ;
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NVarSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME vd THEN
            IF vd.kids[0] IS SOME ids THEN
              FOR c := 0 TO ids.nkids - 1 DO
                IF ids.kids[c] IS SOME id THEN
                  ScopeAdd (id.au, vd.kids[1], mode) ;
                  scope[nscope - 1].ro := vd.f3 ;
                  IF Text.Eq (mode, ModeModule) THEN
                    k := MroFind (id.au) ;
                    IF k >= 0 THEN
                      scope[nscope - 1].roFrom := mroFrom[k] ;
                      scope[nscope - 1].roLine := mroLine[k]
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END AddVarsAt ;

(* PROCEDURE-LOCAL CONSTs.  The grammar has always allowed them --
   ProcBody is `{ Declaration } Block` and CONST is a Declaration --
   but neither end implemented them: the generator said `unknown
   name` and the checker said NOTHING, because an unregistered name
   types as unknown and par 3's softness contract never diagnoses
   one.  Silence was the worse half: `i := Tag` for an I64 i and a
   string Tag rode straight through, while the same two lines at
   module level are refused.

   Answers the count, and refuses a shadow rather than resolving it:
   a local CONST that hides a module CONST would depend on lookup
   ORDER, and the map is searched forwards, so the module one would
   win silently.  What cannot be checked simply is forbidden. *)
PROCEDURE AddConstsOf (holder: PTR Ast.Node ; RO ctx: UTF) =
VAR
  a, b : I64 ;
  seen : BOOL ;
  ty   : UTF ;
BEGIN
  FOR a := 0 TO holder.nkids - 1 DO
    IF holder.kids[a] IS SOME sect THEN
      IF sect.kind = Ast.NConstSection THEN
        FOR b := 0 TO sect.nkids - 1 DO
          IF sect.kids[b] IS SOME cd THEN
            ty := ConstType (cd.au, seen) ;
            IF seen THEN
              ErrN (cd, ctx,
                Cat ('a local CONST may not shadow a module CONST: ',
                     cd.au))
            END ;
            CheckAggregate (cd, ctx, 2) ;
            ConstAdd (cd.au, Text.Keep (pool, LitType (cd.kids[0])), cd.kids[0])
          END
        END
      END
    END
  END
END AddConstsOf ;

(* ---- field lookup ---- *)

(* the fields of a MONITOR hang off kids[0], where a record's hang
   off kids[1] -- same walk, one index apart *)
PROCEDURE MonFieldType (mon: PTR Ast.Node ; RO f: UTF) : Ast.Kid =
VAR i, j : I64 ;
BEGIN
  IF mon.kids[0] IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF g.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              IF Text.Eq (id.au, f) THEN RETURN g.kids[1] END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END MonFieldType ;

(* par 6: the name of the first parameter when its type is a MONITOR
   RECORD, else empty.  M9 has no method syntax, so that parameter IS
   the binding. *)
PROCEDURE BoundMonitorOf (d: PTR Ast.Node) : UTF =
VAR rt : Ast.Kid ;
BEGIN
  IF d.kids[0] IS SOME pl THEN
    IF pl.nkids > 0 THEN
      IF pl.kids[0] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          IF ids.nkids > 0 THEN
            rt := ResolveType (grp.kids[1]) ;
            WHILE rt IS SOME rr DO
              IF rr.kind = Ast.NPtrType OR rr.kind = Ast.NSharedType THEN
                rt := ResolveType (rr.kids[0])
              ELSE
                IF rr.kind = Ast.NMonitorType THEN
                  IF ids.kids[0] IS SOME id0 THEN RETURN id0.au END
                END ;
                RETURN ''
              END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END BoundMonitorOf ;

(* the field group of a record's field f, -1 when it has none: every
   field of the record entered once, the first of a name winning as the
   scan's first hit did.  The scan per access made `--check' quadratic
   in a record's fields -- 10,000 fields 0.20 s, 20,000 0.69 s (the
   review's F5, the shape the scale gate left out) *)
PROCEDURE FieldGroupOf (rec: PTR Ast.Node ; RO f: UTF) : I64 =
VAR
  i, j : I64 ;
  rid : UTF ;
BEGIN
  rid := ItoA (rec.id) ;
  IF NxFind (fieldDone, rid) < 0 THEN
    NxAdd (fieldDone, Text.Keep (pool, rid), 1) ;
    IF rec.kids[1] IS SOME fs THEN
      FOR i := 0 TO fs.nkids - 1 DO
        IF fs.kids[i] IS SOME g THEN
          IF g.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                NxAdd (fieldIx, Text.Keep (pool, Cat (Cat (rid, ' '), id.au)), i)
              END
            END
          END
        END
      END
    END
  END ;
  RETURN NxFind (fieldIx, Cat (Cat (rid, ' '), f))
END FieldGroupOf ;

PROCEDURE FieldTypeOf (rec: PTR Ast.Node ; RO f: UTF) : Ast.Kid =
VAR i : I64 ;
BEGIN
  i := FieldGroupOf (rec, f) ;
  IF i >= 0 THEN
    IF rec.kids[1] IS SOME fs THEN
      IF fs.kids[i] IS SOME g THEN RETURN g.kids[1] END
    END
  END ;
  RETURN NONE
END FieldTypeOf ;

(* RO on a FIELD annotates the view, not the slot: the field holds a
   borrowed slice, so writing THROUGH it is refused while assigning
   the field itself -- which is how the record gets filled at all --
   stays legal.  C says the same with const char *p.                *)
PROCEDURE FieldROOf (rec: PTR Ast.Node ; RO f: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  i := FieldGroupOf (rec, f) ;
  IF i >= 0 THEN
    IF rec.kids[1] IS SOME fs THEN
      IF fs.kids[i] IS SOME g THEN RETURN g.f3 END
    END
  END ;
  RETURN FALSE
END FieldROOf ;

PROCEDURE IsReadonlyT (declN: Ast.Kid ; res: PTR Ast.Node) : BOOL =
BEGIN
  IF res.kind = Ast.NSliceType THEN
    IF res.kids[1] IS SOME at THEN
      IF Text.Eq (at.au, 'RO') THEN RETURN TRUE END
    END
  END ;
  IF declN IS SOME dn THEN
    IF dn.kind = Ast.NQualident AND dn.nkids > 0 THEN
      IF dn.kids[0] IS SOME at2 THEN
        RETURN Text.Eq (at2.au, 'RO')
      END
    END
  END ;
  RETURN FALSE
END IsReadonlyT ;

(* ---- the write analysis (par 4.1) ----
   Answers whether the write lands BEYOND the frame -- through a
   pointer, or into slice storage -- and diagnoses the writes the
   borrow rules refuse on the way.  Both jobs in one walk, because
   they need the same selector chain.                               *)
PROCEDURE RoRefreshed (d: PTR Ast.Node) : BOOL ;

(* CheckWrite proper, below: whether the write lands beyond the frame
   -- and a write THROUGH a name given read-only storage (RoSeed) is
   refused exactly when it does: `t[0] := 'X'' for a slice, `t.s[0]'
   or `t.p.n' for a record copy, never `t.n := 5', which writes the
   copy itself (2026-10-08). *)
PROCEDURE CheckWrite (d: PTR Ast.Node ; RO ctx: UTF) : BOOL =
VAR beyond : BOOL ;
BEGIN
  beyond := CheckWrite0 (d, ctx) ;
  IF beyond AND Text.BLen (ScopeRoFrom (d.au)) > 0 AND NOT RoRefreshed (d) THEN
    ErrN (d, ctx, Cat (Cat (Cat ('cannot write through ', d.au),
      ', which holds '), Cat (ScopeRoFrom (d.au), ' (par 2.4)')))
  END ;
  RETURN beyond
END CheckWrite ;

PROCEDURE CheckWrite0 (d: PTR Ast.Node ; RO ctx: UTF) : BOOL =
VAR
  j : I64 ;
  declN, res : Ast.Kid ;
  mode, tmod : UTF ;
  beyond, deref, known : BOOL ;
BEGIN
  beyond := FALSE ;
  tmod := '' ;
  IF IsConstHere (d.au) THEN
    ErrN (d, ctx, Cat ('cannot write the CONST ', d.au))
  END ;
  (* par 3.2: a PURE procedure has no observable effect, so the two
     ways a body can be observed from outside its own frame are
     refused -- writing through a caller's binding, and writing the
     module's state.  A local or a value parameter is invisible to
     everyone and stays legal. *)
  IF curPure THEN
    IF Text.Eq (ScopeMode (d.au), ModeVar) OR
       Text.Eq (ScopeMode (d.au), ModeOwn) THEN
      ErrN (d, ctx, Cat (Cat ('cannot write through the VAR parameter ',
        d.au), ' in a PURE procedure (par 3.2)'))
    ELSIF Text.Eq (ScopeMode (d.au), ModeModule) THEN
      ErrN (d, ctx, Cat (Cat ('cannot write the module variable ',
        d.au), ' in a PURE procedure (par 3.2)'))
    END
  END ;
  IF Text.Eq (ScopeMode (d.au), ModeRo) THEN
    ErrN (d, ctx, Cat (Cat ('cannot write through the RO parameter ',
      d.au), ' (par 4.1)'))
  END ;
  (* a variable declared `VAR RO': the name may be given a new view,
     nothing may be written through it -- as an RO field (par 2.4,
     2026-10-03; it was parsed and never read) *)
  IF d.nkids > 0 AND ScopeRo (d.au) THEN
    ErrN (d, ctx, Cat (Cat ('cannot write through the RO variable ',
      d.au), ' (par 2.4)'))
  END ;
  IF d.nkids = 0 THEN RETURN FALSE END ;
  mode := ScopeMode (d.au) ;
  declN := ScopeType (d.au) ;
  FOR j := 0 TO d.nkids - 1 DO
    known := FALSE ;
    IF declN IS SOME dn0 THEN known := TRUE END ;
    IF NOT known THEN RETURN beyond END ;
    NoteMod (declN, tmod) ;
    res := ResolveType (declN) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          IF NOT beyond THEN
            beyond := TRUE ;
            IF Text.Eq (mode, ModeVal) THEN
              ErrN (d, ctx, Cat (Cat (
                'cannot write through a value parameter: ', d.au),
                ' is a shared borrow (take VAR, par 4.1)'))
            END
          END ;
          declN := InMod (r0.kids[0], tmod) ;
          NoteMod (declN, tmod) ;
          res := ResolveType (declN)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            IF j < d.nkids - 1 AND FieldROOf (r, sel.au) THEN
              ErrN (d, ctx, Cat (Cat (
                'cannot write through the RO field ', sel.au),
                ' (par 4.1)'))
            END ;
            declN := InMod (FieldTypeOf (r, sel.au), tmod)
          ELSE
            RETURN beyond
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            IF IsReadonlyT (declN, r) THEN
              ErrN (d, ctx, Cat (
                'cannot write through a read-only grid: ', d.au))
            END ;
            beyond := TRUE ;
            declN := InMod (r.kids[1], tmod)
          ELSIF r.kind = Ast.NSliceType THEN
            IF IsReadonlyT (declN, r) THEN
              ErrN (d, ctx, Cat (
                'cannot write through a read-only slice: ', d.au))
            END ;
            beyond := TRUE ;      (* slice storage outlives the frame *)
            declN := InMod (r.kids[0], tmod)
          ELSIF r.kind = Ast.NArrayType THEN
            declN := InMod (r.kids[1], tmod)
          ELSE
            RETURN beyond
          END
        END
      END
    ELSE
      RETURN beyond
    END
  END ;
  RETURN beyond
END CheckWrite0 ;

(* CheckWrite0's answer alone -- does a store into designator D land
   beyond the frame, through a pointer, a slice or a grid -- with
   none of its refusals, for a VAR argument that a callee fills with
   a view (CallType's hand-back, 2026-10-18): the same walk, so that
   `Fill (f.cols[0], v)' is judged as `f.cols[0].data := v' is *)
PROCEDURE DerefBeyond (d: PTR Ast.Node) : BOOL =
VAR
  j : I64 ;
  declN, res : Ast.Kid ;
  tmod : UTF ;
  beyond, deref, known : BOOL ;
BEGIN
  beyond := FALSE ;
  tmod := '' ;
  IF d.nkids = 0 THEN RETURN FALSE END ;
  declN := ScopeType (d.au) ;
  FOR j := 0 TO d.nkids - 1 DO
    known := FALSE ;
    IF declN IS SOME dn0 THEN known := TRUE END ;
    IF NOT known THEN RETURN beyond END ;
    NoteMod (declN, tmod) ;
    res := ResolveType (declN) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          beyond := TRUE ;
          declN := InMod (r0.kids[0], tmod) ;
          NoteMod (declN, tmod) ;
          res := ResolveType (declN)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            declN := InMod (FieldTypeOf (r, sel.au), tmod)
          ELSE
            RETURN beyond
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            beyond := TRUE ;
            declN := InMod (r.kids[1], tmod)
          ELSIF r.kind = Ast.NSliceType THEN
            beyond := TRUE ;
            declN := InMod (r.kids[0], tmod)
          ELSIF r.kind = Ast.NArrayType THEN
            declN := InMod (r.kids[1], tmod)
          ELSE
            RETURN beyond
          END
        END
      END
    ELSE
      RETURN beyond
    END
  END ;
  RETURN beyond
END DerefBeyond ;

(* the base name a stored reference is borrowed from, when the source
   is a plain designator, possibly under SOME or parentheses *)
PROCEDURE IsRefTy (RO s0: UTF) : BOOL =
VAR s : UTF ;
BEGIN
  s := s0 ;
  IF Text.StartsWith (s, 'OPT ') THEN
    s := SLICE (s, 4, Text.BLen (s) - 4)
  END ;
  RETURN Text.StartsWith (s, 'PTR ') OR
         Text.StartsWith (s, 'SHARED PTR ') OR
         Text.StartsWith (s, 'SLICE OF ')
END IsRefTy ;

(* ---- par 4.1, the DIRECTION ----

   The machinery behind the directional ledger.  Aliasing is
   symmetric on purpose: the approximation can keep an entry in the
   ledger that a finer analysis would drop, never drop one it should
   keep.                                                             *)

PROCEDURE EscHas (RO nm: UTF ; RO tgt: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nesc - 1 DO
    IF Text.Eq (escName[i], nm) THEN
      IF Text.Eq (escTgt[i], tgt) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END EscHas ;

(* name NM's storage is reachable from outside the frame via TGT *)
PROCEDURE EscTarget (RO KEPT nm: UTF ; RO KEPT tgt: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF EscHas (nm, tgt) THEN RETURN END ;
  IF nesc = LEN (escName) THEN
    ns := NEW (pool, UTF, 2 * LEN (escName)) ;
    FOR i := 0 TO nesc - 1 DO ns[i] := escName[i] END ;
    escName := ns ;
    ns := NEW (pool, UTF, 2 * LEN (escTgt)) ;
    FOR i := 0 TO nesc - 1 DO ns[i] := escTgt[i] END ;
    escTgt := ns
  END ;
  escName[nesc] := nm ;
  escTgt[nesc] := tgt ;
  nesc := nesc + 1
END EscTarget ;

PROCEDURE FvalHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END FvalHas ;

(* the LOCAL pool a kind names -- 'an allocation in pool P' or 'a view
   into pool P' (FrameWhat, par 4.3) -- or '' for a frame kind.  Read
   back from the text so that one string carries both the diagnostic
   and the taint, as the frame kinds do. *)
PROCEDURE KindPool (RO what: UTF) : UTF =
BEGIN
  (* a view of storage in P is storage in P, for the lifetime the
     pool clauses weigh (2026-10-18: `cs.added := NotOpen (scratch,
     c, qs)' with cs and qs both in scratch was refused as a view
     of nowhere) *)
  IF Text.StartsWith (what, 'a view of ') THEN
    RETURN KindPool (SLICE (what, 10, Text.BLen (what) - 10))
  END ;
  IF Text.StartsWith (what, 'an allocation in pool ') THEN
    RETURN SLICE (what, 22, Text.BLen (what) - 22)
  END ;
  IF Text.StartsWith (what, 'a view into pool ') THEN
    RETURN SLICE (what, 17, Text.BLen (what) - 17)
  END ;
  RETURN ''
END KindPool ;

(* what the name holds: 'a concatenation', 'a frame allocation', or
   '' when it is not tainted *)
PROCEDURE FvalKindOf (RO nm: UTF) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN RETURN fvalKind[i] END
  END ;
  RETURN ''
END FvalKindOf ;

PROCEDURE FvalAdd (RO KEPT nm: UTF ; RO KEPT what: UTF) =
VAR
  ns, nk : SLICE OF UTF ;
  i : I64 ;
BEGIN
  (* a name already tainted keeps its kind, unless the new one names
     a local pool: frame storage is re-homed or adopted at exit, a
     local pool's is freed, so a slice built in the frame that takes
     one element viewing a local pool is the pool's problem *)
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN
      IF Text.BLen (KindPool (what)) > 0 OR Text.StartsWith (what, 'a view of ') THEN
        fvalKind[i] := what
      END ;
      RETURN
    END
  END ;
  IF nfval = LEN (fvalName) THEN
    ns := NEW (pool, UTF, 2 * LEN (fvalName)) ;
    nk := NEW (pool, UTF, 2 * LEN (fvalName)) ;
    FOR i := 0 TO nfval - 1 DO
      ns[i] := fvalName[i] ;
      nk[i] := fvalKind[i]
    END ;
    fvalName := ns ;
    fvalKind := nk
  END ;
  fvalName[nfval] := nm ;
  fvalKind[nfval] := what ;
  nfval := nfval + 1
END FvalAdd ;

PROCEDURE PvalHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npval - 1 DO
    IF Text.Eq (pvalName[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END PvalHas ;

PROCEDURE PvalDel (RO nm: UTF) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO npval - 1 DO
    IF Text.Eq (pvalName[i], nm) THEN
      pvalName[i] := pvalName[npval - 1] ;
      npval := npval - 1 ;
      RETURN
    END
  END
END PvalDel ;

PROCEDURE PvalAdd (RO KEPT nm: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF PvalHas (nm) THEN RETURN END ;
  IF npval = LEN (pvalName) THEN
    ns := NEW (pool, UTF, 2 * LEN (pvalName)) ;
    FOR i := 0 TO npval - 1 DO ns[i] := pvalName[i] END ;
    pvalName := ns
  END ;
  pvalName[npval] := nm ;
  npval := npval + 1
END PvalAdd ;

PROCEDURE FvalDel (RO nm: UTF) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfval - 1 DO
    IF Text.Eq (fvalName[i], nm) THEN
      fvalName[i] := fvalName[nfval - 1] ;
      fvalKind[i] := fvalKind[nfval - 1] ;
      nfval := nfval - 1 ;
      RETURN
    END
  END
END FvalDel ;

(* Is this NEW the FRAME form -- `NEW (T)` or `NEW (T, n...)`, no
   pool named (docs/pool-elision-plan.md, rule 1)?  Decided by NAME,
   as report par 10 item 6 says: a first argument that is a variable
   in scope, HEAP, or OWN is not the frame form.  Quiet -- NewForm
   below is the one that diagnoses. *)
PROCEDURE NewIsFrame (e: PTR Ast.Node) : BOOL =
BEGIN
  IF e.kids[0] IS SOME d THEN
    IF d.nkids > 0 THEN RETURN FALSE END ;
    IF Text.Eq (d.au, 'OWN') OR Text.Eq (d.au, 'HEAP') THEN RETURN FALSE END ;
    RETURN ScopeFind (d.au) < 0
  END ;
  RETURN TRUE
END NewIsFrame ;

PROCEDURE EscAlias (RO KEPT a: UTF ; RO KEPT b: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF Text.Eq (a, b) THEN RETURN END ;
  FOR i := 0 TO nedge - 1 DO
    IF Text.Eq (edgeA[i], a) THEN
      IF Text.Eq (edgeB[i], b) THEN RETURN END
    END
  END ;
  IF nedge = LEN (edgeA) THEN
    ns := NEW (pool, UTF, 2 * LEN (edgeA)) ;
    FOR i := 0 TO nedge - 1 DO ns[i] := edgeA[i] END ;
    edgeA := ns ;
    ns := NEW (pool, UTF, 2 * LEN (edgeB)) ;
    FOR i := 0 TO nedge - 1 DO ns[i] := edgeB[i] END ;
    edgeB := ns
  END ;
  edgeA[nedge] := a ;
  edgeB[nedge] := b ;
  nedge := nedge + 1
END EscAlias ;

(* the frame-storage root a reference expression views: through SOME
   and parens, and through SLICE/VIEW/SHARED/GRID, whose
   answers alias their first argument's storage.

   SLICE, SHARED and GRID ARE NODES OF THEIR OWN, not calls: the
   parser makes NSliceOf3, NSharedExpr and NGridOf, so the branch
   below that looks for a call named SLICE never saw one, and
   `RETURN SLICE (out, 0, n)` -- out holding borrowed elements --
   reached the caller with no root found and nothing pended, while
   `RETURN out` was refused.  cp-kernel's Unique (its FINDINGS,
   "a retention through an intermediate slice") was this, not the
   intermediate copy: a copy through a local IS carried (kept-via-
   local).  Found 2026-10-18 by the statement-release plan's stage 0,
   which makes a missed retention a use-after-release rather than a
   leak.  Only VIEW is still a call by name. *)
PROCEDURE EscRootOf (k: Ast.Kid) : UTF =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN RETURN e.au END ;
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen OR
       e.kind = Ast.NSliceOf3 OR e.kind = Ast.NSharedExpr OR
       e.kind = Ast.NGridOf THEN
      RETURN EscRootOf (e.kids[0])
    END ;
    IF OctetsArg (e) IS SOME oa THEN RETURN EscRootOf (SOME (oa)) END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME cal THEN
        IF cal.kind = Ast.NDesignator AND cal.nkids = 0 THEN
          IF Text.Eq (cal.au, 'SLICE') OR Text.Eq (cal.au, 'VIEW') OR
             Text.Eq (cal.au, 'SHARED') THEN
            IF e.kids[1] IS SOME al THEN
              IF al.nkids > 0 THEN RETURN EscRootOf (al.kids[0]) END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END EscRootOf ;

PROCEDURE IsFrameMode (RO m: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeBinder) OR
         Text.Eq (m, ModeVal)
END IsFrameMode ;

(* the expression under parens and SOME *)
(* k without its parentheses, as the Pascal twin's StripParens *)
PROCEDURE ParenCore (k: Ast.Kid) : Ast.Kid =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen THEN RETURN ParenCore (e.kids[0]) END
  END ;
  RETURN k
END ParenCore ;

PROCEDURE FrameCore (k: Ast.Kid) : Ast.Kid =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN
      RETURN FrameCore (e.kids[0])
    END
  END ;
  RETURN k
END FrameCore ;

(* does this right-hand side yield a FRAME-SCOPED string (par 2.3)?
   A concatenation is one -- it is built in the frame arena -- and so
   is a bare name that already holds one (fval).  `u` is the RHS's
   type, so a numeric `+` (not SLICE OF CHAR) is not mistaken for a
   concatenation. *)
(* Does this call answer FRAME storage -- the callee's name, or ''?
   A callee that takes no pool and answers a pointer-bearing value
   that is not RO builds its answer in ITS CALLER's arena (rule 1 of
   docs/pool-elision-plan.md, and par 2.3 for a string re-homed at
   exit), so the answer lives in this frame and dies with it.  Not
   frame storage: a foreign procedure's pointer (the library's) and an
   RO answer (a view of something that exists already); a callee that
   took a pool answers in it unless its RETURN says otherwise, which
   AnswersFrame reads from its body. *)
PROCEDURE LookupProc (RO callee: UTF ; VAR found: BOOL) : ProcInfo ;
PROCEDURE DesigName (d: PTR Ast.Node) : UTF ;
PROCEDURE NoStateWrite (RO qual: UTF ; m: I64 ; body: Ast.Kid) : BOOL ;

(* ---- does a procedure ANSWER frame storage?  A summary of its body,
   memoised per Module.Proc, because the signature cannot say: a
   pool-less function answering a pointer may answer a VIEW of its
   argument (Text.Trim), storage from a module pool (Gen's S2), or --
   since the frame form of NEW -- storage built in its caller's arena
   (rule 1).  The corpus's 75 pool-less pointer answers were all of
   the first two kinds when this was measured, so the default is NO
   and the evidence for YES is in the body: a frame NEW, a `+` in a
   function that answers a string, a local POOL in one (its answer is
   re-homed out of it), or a call to a procedure that answers frame
   storage.  Over-approximate on purpose: a frame temporary in a
   function that answers a view makes the answer count as frame
   storage, and the cost is a Text.Keep at a durable store. *)
PROCEDURE AnsFindRaw (RO q: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nans - 1 DO
    IF Text.Eq (ansName[i], q) THEN RETURN i END
  END ;
  RETURN -1
END AnsFindRaw ;

(* an entry computed while an ANCESTOR was in progress is 'redo': it is
   asked again, now that the ancestor has its answer *)
PROCEDURE AnsFind (RO q: UTF) : I64 =
VAR i : I64 ;
BEGIN
  i := AnsFindRaw (q) ;
  IF i >= 0 THEN
    IF Text.Eq (ansState[i], 'redo') THEN RETURN -1 END
  END ;
  RETURN i
END AnsFind ;

PROCEDURE AnsYes (i: I64) : BOOL =
BEGIN
  IF Text.Eq (ansState[i], 'busy') THEN
    IF ansDep[i] < ansLow[ansDepth] THEN ansLow[ansDepth] := ansDep[i] END ;
    ansRB[i] := TRUE ;
    RETURN FALSE
  END ;
  RETURN Text.Eq (ansState[i], 'yes')
END AnsYes ;

(* room for one more level of summaries in progress and one more
   provisional entry: the tables grow, as the memo itself does -- a
   fixed size would end in an IndexError inside the checker *)
PROCEDURE AnsRoom () =
VAR
  k : I64 ;
  nl, nb2, np : SLICE OF I64 ;
  nd : SLICE OF BOOL ;
BEGIN
  IF ansDepth + 2 >= LEN (ansLow) THEN
    nl := NEW (pool, I64, 2 * LEN (ansLow)) ;
    nb2 := NEW (pool, I64, 2 * LEN (ansLow)) ;
    nd := NEW (pool, BOOL, 2 * LEN (ansLow)) ;
    FOR k := 0 TO LEN (ansLow) - 1 DO
      nl[k] := ansLow[k] ; nb2[k] := ansBase[k] ; nd[k] := ansDirty[k]
    END ;
    ansLow := nl ; ansBase := nb2 ; ansDirty := nd
  END ;
  IF provTop + 1 >= LEN (provIx) THEN
    np := NEW (pool, I64, 2 * LEN (provIx)) ;
    FOR k := 0 TO provTop - 1 DO np[k] := provIx[k] END ;
    provIx := np
  END
END AnsRoom ;

PROCEDURE AnsSet (RO KEPT q: UTF ; RO KEPT state: UTF) =
VAR
  i, d, k : I64 ;
  nn, ns : SLICE OF UTF ;
  nd : SLICE OF I64 ;
  nb : SLICE OF BOOL ;
  st : UTF ;
BEGIN
  i := AnsFindRaw (q) ;
  d := 0 ;
  st := state ;
  IF Text.Eq (state, 'busy') THEN
    AnsRoom () ;
    ansDepth := ansDepth + 1 ;
    ansLow[ansDepth] := ansDepth ;
    ansBase[ansDepth] := provTop ;
    ansDirty[ansDepth] := FALSE ;
    d := ansDepth ;
    IF i >= 0 THEN ansRB[i] := FALSE END
  ELSIF i >= 0 THEN
    IF Text.Eq (ansState[i], 'busy') THEN
      d := ansDep[i] ;
      (* an answer that was ASSUMED no by a descendant and is not: what
         was computed under the assumption is asked again *)
      IF ansRB[i] AND NOT Text.Eq (state, 'no') AND NOT Text.Eq (state, '-') THEN
        ansDirty[d] := TRUE
      END ;
      IF ansLow[d] < d THEN
        AnsRoom () ;
        provIx[provTop] := i ;
        provTop := provTop + 1 ;
        IF ansLow[d] < ansLow[d - 1] THEN ansLow[d - 1] := ansLow[d] END ;
        IF ansDirty[d] THEN ansDirty[d - 1] := TRUE END
      ELSE
        IF ansDirty[d] THEN
          FOR k := ansBase[d] TO provTop - 1 DO ansState[provIx[k]] := 'redo' END
        END ;
        provTop := ansBase[d]
      END ;
      ansDepth := d - 1
    END
  END ;
  IF i >= 0 THEN ansState[i] := st ; ansDep[i] := d ; RETURN END ;
  IF nans = LEN (ansName) THEN
    nb := NEW (pool, BOOL, 2 * LEN (ansName)) ;
    FOR k := 0 TO nans - 1 DO nb[k] := ansRB[k] END ;
    ansRB := nb ;
    nn := NEW (pool, UTF, 2 * LEN (ansName)) ;
    ns := NEW (pool, UTF, 2 * LEN (ansName)) ;
    nd := NEW (pool, I64, 2 * LEN (ansName)) ;
    FOR i := 0 TO nans - 1 DO
      nn[i] := ansName[i] ;
      ns[i] := ansState[i] ;
      nd[i] := ansDep[i]
    END ;
    ansName := nn ;
    ansState := ns ;
    ansDep := nd
  END ;
  ansName[nans] := q ;
  ansState[nans] := st ;
  ansDep[nans] := d ;
  ansRB[nans] := FALSE ;
  nans := nans + 1
END AnsSet ;

(* a type of module m's declaration, canonical in m -- a callee's result
   read from another module's body was canonicalised in the CURRENT one,
   its bare names found by the scan over every loaded module (the
   review's tier 2 item 12, measured 2026-10-22) *)
PROCEDURE CanonIn (RO m: UTF ; t: Ast.Kid) : UTF =
VAR was, r : UTF ;
BEGIN
  was := canonCtx ;
  canonCtx := Text.Keep (pool, m) ;
  r := CanonT (t, 0) ;
  canonCtx := was ;
  RETURN r
END CanonIn ;

PROCEDURE AnswersFrame (RO qual: UTF ; pr: ProcInfo) : BOOL ;

(* a callee named inside module MOD, as ProcInfo; found says so *)
PROCEDURE ProcNamed (RO mod: UTF ; RO callee: UTF ; VAR found: BOOL) : ProcInfo =
VAR
  dot, m, pi : I64 ;
  empty : ProcInfo ;
BEGIN
  found := FALSE ;
  dot := Text.FindChar (callee, '.') ;
  IF dot >= 0 THEN
    m := FindMod (SLICE (callee, 0, dot)) ;
    IF m < 0 THEN RETURN empty END ;
    pi := FindProcIn (m, SLICE (callee, dot + 1, Text.BLen (callee) - dot - 1))
  ELSE
    m := FindMod (mod) ;
    IF m < 0 THEN RETURN empty END ;
    pi := FindProcIn (m, callee)
  END ;
  IF pi < 0 THEN RETURN empty END ;
  pi := TwinIx (m, pi) ;
  found := TRUE ;
  RETURN mods[m].procs[pi]
END ProcNamed ;

(* is there frame storage under node K of a procedure of module MOD
   whose answer is a string when isStr? *)
(* Is the NEW's storage the frame's?  A type's name in the first
   position is the frame form, a variable's a pool; decided without
   the procedure's scope, so a local that shadows a type name of its
   module reads as the type.  Quiet, like NewIsFrame. *)
PROCEDURE NewIsFrameIn (e: PTR Ast.Node ; RO mod: UTF) : BOOL =
VAR m : I64 ;
BEGIN
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 THEN
      IF Text.Eq (d.au, 'OWN') OR Text.Eq (d.au, 'HEAP') THEN RETURN FALSE END ;
      IF IsBuiltinTy (d.au) OR Text.Eq (d.au, 'STR') THEN RETURN TRUE END ;
      m := FindMod (mod) ;
      IF m >= 0 THEN
        IF FindTypeIn (m, d.au) IS SOME t THEN RETURN TRUE END
      END ;
      RETURN FALSE
    END ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          m := FindMod (d.au) ;
          IF m >= 0 THEN
            IF FindTypeIn (m, sel.au) IS SOME t2 THEN RETURN TRUE END
          END
        END
      END
    END ;
    RETURN FALSE
  END ;
  RETURN TRUE
END NewIsFrameIn ;

PROCEDURE ExprEvidence (k: Ast.Kid ; RO mod: UTF ; isStr: BOOL ;
                        body: Ast.Kid ; depth: I64) : BOOL ;

(* does any `NAME := rhs` under K have frame evidence on its right? *)
PROCEDURE AssignEvidence (k: Ast.Kid ; RO name: UTF ; RO mod: UTF ;
                          isStr: BOOL ; body: Ast.Kid ; depth: I64) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids = 0 THEN
          IF Text.Eq (lhs.au, name) THEN
            IF ExprEvidence (e.kids[1], mod, isStr, body, depth) THEN
              RETURN TRUE
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF AssignEvidence (e.kids[i], name, mod, isStr, body, depth) THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
END AssignEvidence ;

(* is the value of expression K frame storage?  A frame NEW; a `+`
   in answer position of a string function (a numeric `+` cannot be
   the answer of one); a call to a procedure that answers frame
   storage; a bare local that was assigned any of these (followed
   through assignments, four deep).  A view, a literal and a call
   answering a view or module-pool storage are not. *)
PROCEDURE ExprEvidence (k: Ast.Kid ; RO mod: UTF ; isStr: BOOL ;
                        body: Ast.Kid ; depth: I64) : BOOL =
VAR
  found : BOOL ;
  pr : ProcInfo ;
  nm : UTF ;
BEGIN
  IF depth > 4 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN
      RETURN ExprEvidence (e.kids[0], mod, isStr, body, depth)
    END ;
    IF e.kind = Ast.NNewExpr THEN RETURN NewIsFrameIn (e, mod) END ;
    IF e.kind = Ast.NBin THEN
      RETURN isStr AND Text.Eq (e.au, '+')
    END ;
    (* UTF (x), UTF (b) and STR (u) build their answer in this frame as
       + does, and OCTETS (x) is a view of x (2026-10-23: DynUtf.View
       answers `UTF (...)`, and three ports kept it in module state
       unrefused -- probe frame-answer-conversion) *)
    nm := UtfBuiltin (e) ;
    IF Text.Eq (nm, 'UTF') OR Text.Eq (nm, 'STR') THEN RETURN TRUE END ;
    IF OctetsArg (e) IS SOME oa THEN
      RETURN ExprEvidence (SOME (oa), mod, isStr, body, depth)
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          nm := DesigName (dn) ;
          pr := ProcNamed (mod, nm, found) ;
          IF found THEN
            IF Text.BLen (pr.foreign) = 0 THEN
              RETURN AnswersFrame (Qualify (pr.modName, pr.name), pr)
            END
          END
        END
      END ;
      RETURN FALSE
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      RETURN AssignEvidence (body, e.au, mod, isStr, body, depth + 1)
    END
  END ;
  RETURN FALSE
END ExprEvidence ;

(* the evidence for a procedure of module MOD whose body is K: a
   RETURN whose expression is frame storage, or -- when it answers a
   string -- a local POOL, whose strings are re-homed out of it at
   exit (par 2.3) and so live in the caller's frame *)
PROCEDURE FrameEvidence (k: Ast.Kid ; RO mod: UTF ; isStr: BOOL ;
                         body: Ast.Kid ; scratchCounts: BOOL) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn THEN
      IF ExprEvidence (e.kids[0], mod, isStr, body, 0) THEN RETURN TRUE END
    ELSIF e.kind = Ast.NVarDecl THEN
      IF isStr AND scratchCounts THEN
        IF e.kids[1] IS SOME vt THEN
          IF vt.kind = Ast.NQualident THEN
            IF Text.Eq (vt.au, 'POOL') AND Text.BLen (vt.bu) = 0 THEN RETURN TRUE END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF FrameEvidence (e.kids[i], mod, isStr, body, scratchCounts) THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
END FrameEvidence ;

PROCEDURE AnswersFrame (RO qual: UTF ; pr: ProcInfo) : BOOL =
VAR
  i, g : I64 ;
  res, isStr, hasPool : BOOL ;
  key : UTF ;
BEGIN
  i := AnsFind (qual) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  (* the memo keeps its key: copied on a miss only, so a caller may ask
     with a frame string (Qualify's) and a hit copies nothing *)
  key := Text.Keep (pool, qual) ;
  (* in progress counts as no: a cycle adds no evidence of its own *)
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    (* a procedure that takes a pool answers in it, by the rule of
       docs/pools.md; its scratch pools and temporaries say nothing
       about where the answer lives *)
    hasPool := FALSE ;
    IF d.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[1] IS SOME pt THEN
            IF pt.kind = Ast.NQualident THEN
              IF Text.Eq (pt.au, 'POOL') AND Text.BLen (pt.bu) = 0 THEN
                hasPool := TRUE
              END
            END
          END
        END
      END
    END ;
    (* ... but only for what it returns: a RETURN of a frame NEW, of
       a `+`, or of a frame-answering call is evidence whether or not
       a pool was taken (a reader that hands on a frame-built answer
       is a frame-answering reader), while a local POOL is evidence
       only in a pool-less string function *)
    isStr := FALSE ;
    IF d.kids[1] IS SOME rt THEN
      (* a UTF answer is a string answer: its + is built here too *)
      isStr := Text.Eq (CanonIn (pr.modName, d.kids[1]), 'SLICE OF CHAR') OR
               Text.Eq (CanonIn (pr.modName, d.kids[1]), UtfTy)
    END ;
    res := FrameEvidence (d.kids[4], pr.modName, isStr, d.kids[4],
                          NOT hasPool)
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END AnswersFrame ;

(* ---- may a function answer READ-ONLY storage? (par 2.4, 2026-10-10)
   A STR answer of `RETURN 'OK'' is a view of a string literal, and
   one of `RETURN SLICE (s, ...)' with s an RO parameter a view of
   whatever the caller lent: written through, the first died with
   SIGBUS (`s := Reason (200) ; s[0] := 'X''), and the second wrote
   into a literal through Text.Trim.  The evidence is read off the
   callee's RETURNs, memoised like AnswersFrame's; the answer is then
   read-only storage at the call (RoAnswerOf), and decision 33's marks
   and RoArg do the rest.  A function DECLARED `: RO T' says it. *)

PROCEDURE IsRoParamOf (d: PTR Ast.Node ; RO nm: UTF) : BOOL =
VAR a, b : I64 ;
BEGIN
  IF d.kids[0] IS SOME pl THEN
    FOR a := 0 TO pl.nkids - 1 DO
      IF pl.kids[a] IS SOME grp THEN
        IF grp.f3 THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR b := 0 TO ids.nkids - 1 DO
              IF ids.kids[b] IS SOME id THEN
                IF Text.Eq (id.au, nm) THEN RETURN TRUE END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END IsRoParamOf ;

PROCEDURE AnswersRo (RO qual: UTF ; pr: ProcInfo) : BOOL ;

PROCEDURE RoExprEvidence (k: Ast.Kid ; d: PTR Ast.Node ; RO mod: UTF ;
                          depth: I64) : BOOL =
VAR
  found : BOOL ;
  t, nm : UTF ;
  pr : ProcInfo ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NString THEN RETURN Text.BLen (e.au) > 0 END ;
    IF e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf THEN
      RETURN RoExprEvidence (e.kids[0], d, mod, depth + 1)
    END ;
    (* the octets of a UTF are read-only storage, whatever holds it *)
    IF Text.Eq (UtfBuiltin (e), 'OCTETS') THEN RETURN TRUE END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      IF IsRoParamOf (d, e.au) THEN RETURN TRUE END ;
      t := ModConstType (mod, e.au, found) ;
      RETURN found
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          nm := DesigName (dn) ;
          pr := ProcNamed (mod, nm, found) ;
          IF found AND Text.BLen (pr.foreign) = 0 THEN
            IF pr.node IS SOME pn THEN
              IF pn.f3 THEN RETURN TRUE END
            END ;
            RETURN AnswersRo (Qualify (pr.modName, pr.name), pr)
          END
        END
      END
    END
  END ;
  RETURN FALSE
END RoExprEvidence ;

PROCEDURE RoEvidence (k: Ast.Kid ; d: PTR Ast.Node ; RO mod: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn THEN
      IF RoExprEvidence (e.kids[0], d, mod, 0) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF RoEvidence (e.kids[i], d, mod) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RoEvidence ;

PROCEDURE AnswersRo (RO qual: UTF ; pr: ProcInfo) : BOOL =
VAR
  i : I64 ;
  key, t : UTF ;
  res : BOOL ;
BEGIN
  key := Text.Keep (pool, Cat ('ro ', qual)) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    IF d.kids[1] IS SOME rt THEN
      t := CanonIn (pr.modName, d.kids[1]) ;
      IF Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ') THEN
        res := RoEvidence (d.kids[4], d, pr.modName)
      END
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END AnswersRo ;

(* does the callee answer a VIEW of one of its own parameters -- a
   RETURN of a parameter, a SLICE or GRID over one, or the answer of
   another such callee handed a parameter?  Text.Trim answers SLICE (s,
   ...): a frame string handed to it comes back as a view into that
   frame (2026-10-11; `keep := Text.Trim (x + ' ')' passed and kept
   freed storage).  Memoised beside AnswersRo; a string literal or a
   CONST answer is not a view of an argument. *)
PROCEDURE IsParamOf (d: PTR Ast.Node ; RO nm: UTF) : BOOL =
VAR g, b : I64 ;
BEGIN
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF ids.kids[b] IS SOME id THEN
              IF Text.Eq (id.au, nm) THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END IsParamOf ;

PROCEDURE AnswersViewAt (RO qual: UTF ; pr: ProcInfo ; j: I64) : BOOL ;
PROCEDURE ViewCarrier (RO cn: UTF ; d: PTR Ast.Node ; RO mod: UTF ;
                       depth: I64 ; RO nm: UTF) : BOOL ;
PROCEDURE HandsBackFrom (RO qual: UTF ; pr: ProcInfo ; i, j: I64) : BOOL ;
PROCEDURE HandsBackDeep (RO qual: UTF ; pr: ProcInfo ; i, j: I64) : BOOL ;
PROCEDURE ParamViewBearing (d: PTR Ast.Node ; e: PTR Ast.Node ; RO mod: UTF) : BOOL ;
PROCEDURE ParamSelBeyond (d: PTR Ast.Node ; e: PTR Ast.Node ; RO mod: UTF) : BOOL ;

(* the J-th parameter's name, '' past the end *)
PROCEDURE ParamNameAt (d: PTR Ast.Node ; j: I64) : UTF =
VAR g, b, k : I64 ;
BEGIN
  k := 0 ;
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF k = j THEN
              IF ids.kids[b] IS SOME id THEN RETURN id.au END ;
              RETURN ''
            END ;
            k := k + 1
          END
        END
      END
    END
  END ;
  RETURN ''
END ParamNameAt ;

(* is the callee's parameter j of a MONITOR type, read in its module: a
   POOL field of it is reached only by a procedure bound to it, so only
   under its lock (report par 6) -- `NEW (d.p, T)' in Search.Put of
   cp-kernel's live-demo branch, eight workers through one job *)
PROCEDURE ParamMonitorAt (pr: ProcInfo ; j: I64) : BOOL =
VAR
  g, b, k : I64 ;
  was : UTF ;
  r : Ast.Kid ;
BEGIN
  k := 0 ;
  IF pr.node IS SOME d THEN
    IF d.kids[0] IS SOME ps THEN
      FOR g := 0 TO ps.nkids - 1 DO
        IF ps.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR b := 0 TO ids.nkids - 1 DO
              IF k = j THEN
                was := canonCtx ;
                canonCtx := Text.Keep (pool, pr.modName) ;
                r := ResolveType (grp.kids[1]) ;
                canonCtx := was ;
                IF r IS SOME rn THEN RETURN rn.kind = Ast.NMonitorType END ;
                RETURN FALSE
              END ;
              k := k + 1
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ParamMonitorAt ;

(* may a callee allocate THROUGH its VAR pointer parameter j: a NEW on
   the parameter, or the parameter handed on as a VAR argument to a
   callee that does?  Read off the body, memoised as `alloc Mod.Proc#j'
   beside AnswersFrame's states; a cycle adds no evidence.  It gates
   the local-without-IN case of ObjPoolIssue (2026-10-23): Json's
   CopyInto lends its child `cc' to itself and allocates through root
   alone, which the unconditional rule refused. *)
PROCEDURE AllocsThrough (pr: ProcInfo ; j: I64) : BOOL ;

(* the root name of `UTF (p, x)''s pool argument, else empty *)
PROCEDURE UtfPoolArg (e: PTR Ast.Node) : UTF =
BEGIN
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator AND dn.nkids = 0 AND Text.Eq (dn.au, 'UTF') THEN
      IF e.kids[1] IS SOME al THEN
        IF al.nkids = 2 THEN
          IF al.kids[0] IS SOME a0 THEN
            IF a0.kind = Ast.NDesignator THEN RETURN a0.au END
          END
        END
      END
    END
  END ;
  RETURN ''
END UtfPoolArg ;

(* is the parameter type the bare POOL: an argument handed to it is a
   pool in its own right -- `FlatVars (j.wp, ...)', a worker's own pool
   field -- not the pool j's object lives in (zarrm9's Shuttle.SetupRun,
   which the first cut of the THREAD rule refused) *)
PROCEDURE PoolParam (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME pt THEN
    RETURN pt.kind = Ast.NQualident AND Text.Eq (pt.au, 'POOL') AND Text.BLen (pt.bu) = 0
  END ;
  RETURN FALSE
END PoolParam ;

PROCEDURE PoolField (d: PTR Ast.Node) : BOOL =
BEGIN
  IF d.kids[d.nkids - 1] IS SOME ls THEN RETURN PoolParam (Ast.TypeAt (ls.id)) END ;
  RETURN FALSE
END PoolField ;

PROCEDURE AllocWalk (k: Ast.Kid ; RO nm: UTF ; RO mod: UTF) : BOOL =
VAR
  i, g, j, a : I64 ;
  cpr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.kind = Ast.NDesignator AND Text.Eq (d.au, nm) THEN
          (* for a THREAD, `NEW (j.wp, T)' is in the worker's own pool
             field, by the type the typed tree recorded for its last
             step (a THREAD's target is in the checked unit) *)
          IF NOT ((allocNoPool OR allocMon) AND d.nkids > 0 AND PoolField (d)) THEN RETURN TRUE END
        END
      END
    END ;
    (* `UTF (j, s)': the UTF built in the pool j's object lives in *)
    IF e.kind = Ast.NCallExpr AND Text.Eq (UtfPoolArg (e), nm) THEN RETURN TRUE END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          cpr := ProcNamed (mod, DesigName (dn), found) ;
          (* a call through a procedure value, handed the parameter or a
             component of it: what it does there is unseen, so it counts
             as allocating (the fourth review's AllocValue: a DynStr grown
             through `f (j.out[b])' by eight workers at once) *)
          IF NOT found AND NOT (dn.nkids = 0 AND Text.OneOf (STR (DesigName (dn)), ScalarFns)) THEN
            IF e.kids[1] IS SOME alv THEN
              FOR j := 0 TO alv.nkids - 1 DO
                IF alv.kids[j] IS SOME av THEN
                  IF av.kind = Ast.NDesignator AND Text.Eq (av.au, nm) AND
                     Text.BLen (Ast.TyStrAt (av.id)) > 0 AND NOT IsBuiltinTy (Ast.TyStrAt (av.id)) THEN
                    RETURN TRUE
                  END
                END
              END
            END
          END ;
          IF found AND Text.BLen (cpr.foreign) = 0 THEN
            IF cpr.node IS SOME pn THEN
              IF pn.kids[0] IS SOME pl THEN
                IF e.kids[1] IS SOME al THEN
                  a := 0 ;
                  FOR g := 0 TO pl.nkids - 1 DO
                    IF pl.kids[g] IS SOME grp THEN
                      IF grp.kids[0] IS SOME ids THEN
                        FOR j := 0 TO ids.nkids - 1 DO
                          IF a < al.nkids AND grp.f1 AND NOT (allocNoPool AND PoolParam (grp.kids[1])) THEN
                            IF al.kids[a] IS SOME an THEN
                              IF an.kind = Ast.NDesignator AND Text.Eq (an.au, nm) THEN
                                IF AllocsThrough (cpr, a) THEN RETURN TRUE END
                              END
                            END
                          END ;
                          a := a + 1
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF AllocWalk (e.kids[i], nm, mod) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END AllocWalk ;

PROCEDURE AllocsThrough (pr: ProcInfo ; j: I64) : BOOL =
VAR
  q, key, nm : UTF ;
  i : I64 ;
  res, wasMon : BOOL ;
BEGIN
  IF allocNoPool THEN
    q := S4 ('talloc ', Qualify (pr.modName, pr.name), '#', ItoA (j))
  ELSE
    q := S4 ('alloc ', Qualify (pr.modName, pr.name), '#', ItoA (j))
  END ;
  i := AnsFind (q) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  key := Text.Keep (pool, q) ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    nm := ParamNameAt (d, j) ;
    IF Text.BLen (nm) > 0 AND d.nkids > 4 THEN
      wasMon := allocMon ;
      allocMon := ParamMonitorAt (pr, j) ;
      res := AllocWalk (d.kids[4], nm, pr.modName) ;
      allocMon := wasMon
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END AllocsThrough ;

(* the J-th parameter's name when it is a VAR parameter -- the one
   kind a callee can hand a view back through -- else '' *)
PROCEDURE VarParamAt (d: PTR Ast.Node ; j: I64) : UTF =
VAR g, b, k : I64 ;
BEGIN
  k := 0 ;
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF k = j THEN
              IF ids.kids[b] IS SOME id THEN
                IF grp.f1 AND NOT grp.f2 THEN RETURN id.au END
              END ;
              RETURN ''
            END ;
            k := k + 1
          END
        END
      END
    END
  END ;
  RETURN ''
END VarParamAt ;

(* is expression K, in the body of procedure D of module MOD, a VIEW
   of D's parameter NM -- NM itself or a component of it that can be
   viewed (ParamViewBearing), under SLICE, GRID or parentheses; a
   local that CARRIES it (ViewCarrier); or the answer of a callee
   that answers a view of the argument that is one (AnswersViewAt)?
   Per parameter since 2026-10-18: `Frame.ColStrs (f, name)' views f
   and not name, and blaming both refused Parquet.AddCopy. *)
PROCEDURE ViewExprEvidence (k: Ast.Kid ; d: PTR Ast.Node ; RO mod: UTF ;
                            depth: I64 ; RO nm: UTF) : BOOL =
VAR
  found : BOOL ;
  pr : ProcInfo ;
  i : I64 ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf OR e.kind = Ast.NParen OR
       e.kind = Ast.NSomeExpr THEN
      RETURN ViewExprEvidence (e.kids[0], d, mod, depth + 1, nm)
    END ;
    IF OctetsArg (e) IS SOME ova THEN
      RETURN ViewExprEvidence (SOME (ova), d, mod, depth + 1, nm)
    END ;
    IF e.kind = Ast.NDesignator THEN
      (* the parameter, or a component of it (`lx.src'), that can be
         viewed at all: a scalar -- `s[i]', a CHAR -- is copied *)
      IF Text.Eq (e.au, nm) THEN RETURN ParamViewBearing (d, e, mod) END ;
      IF IsParamOf (d, e.au) THEN RETURN FALSE END ;
      (* or a local that CARRIES the parameter: the splitter shape,
         `parts[n] := SLICE (s, ...) ; RETURN parts' (2026-10-18) *)
      IF e.nkids = 0 THEN RETURN ViewCarrier (e.au, d, mod, depth + 1, nm) END ;
      RETURN FALSE
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pr := ProcNamed (mod, DesigName (dn), found) ;
          IF found AND Text.BLen (pr.foreign) = 0 THEN
            IF e.kids[1] IS SOME al THEN
              FOR i := 0 TO al.nkids - 1 DO
                IF AnswersViewAt (Qualify (pr.modName, pr.name), pr, i) THEN
                  IF ViewExprEvidence (al.kids[i], d, mod, depth + 1, nm) THEN
                    RETURN TRUE
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ViewExprEvidence ;

PROCEDURE ViewEvidence (k: Ast.Kid ; d: PTR Ast.Node ; RO mod: UTF ;
                        RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn THEN
      IF ViewExprEvidence (e.kids[0], d, mod, 0, nm) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF ViewEvidence (e.kids[i], d, mod, nm) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END ViewEvidence ;

(* does the body store a view of parameter NM under the name CN --
   bare or through a selector (`parts[n] := SLICE (s, a, b)',
   `tg.name := ...'), bound by IS SOME or FOR IN, assigned from a
   carrier or a view-answering call, or handed as a VAR argument to a
   callee that fills that parameter with a view of another argument
   (`Mk (t, kind, SLICE (lx.src, a, n))' makes t carry lx,
   HandsBackFrom)?  Structural, over the callee's own tree, because
   it is asked from OTHER procedures' checks, where this one's carry
   edges are not in hand.  Bounded by depth, since a local may be
   assigned from itself. *)
PROCEDURE CarrierEvidence (k: Ast.Kid ; RO cn: UTF ; d: PTR Ast.Node ;
                           RO mod: UTF ; depth: I64 ; RO nm: UTF ;
                           deep: BOOL) : BOOL =
VAR
  i, j : I64 ;
  pr : ProcInfo ;
  found, hit : BOOL ;
  q : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallStmt OR e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          IF e.kids[1] IS SOME al THEN
            FOR i := 0 TO al.nkids - 1 DO
              IF al.kids[i] IS SOME ai THEN
                IF ai.kind = Ast.NDesignator AND Text.Eq (ai.au, cn) THEN
                  pr := ProcNamed (mod, DesigName (dn), found) ;
                  IF found AND Text.BLen (pr.foreign) = 0 THEN
                    q := Qualify (pr.modName, pr.name) ;
                    FOR j := 0 TO al.nkids - 1 DO
                      IF j # i THEN
                        hit := HandsBackFrom (q, pr, i, j) ;
                        (* DEEP asks for a store beyond the frame: the
                           callee's own was, or our designator reaches
                           the parameter through a reference *)
                        IF hit AND deep THEN
                          hit := HandsBackDeep (q, pr, i, j) OR
                                 ParamSelBeyond (d, ai, mod)
                        END ;
                        IF hit THEN
                          IF ViewExprEvidence (al.kids[j], d, mod, depth + 1, nm) THEN
                            RETURN TRUE
                          END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND Text.Eq (lhs.au, cn) THEN
          IF NOT deep OR ParamSelBeyond (d, lhs, mod) THEN
            IF ViewExprEvidence (e.kids[1], d, mod, depth + 1, nm) THEN RETURN TRUE END
          END
        END
      END
    END ;
    (* binders are locals, never the parameter a DEEP question is about *)
    IF e.kind = Ast.NIs AND NOT deep THEN
      IF e.kids[1] IS SOME b THEN
        IF b.kind = Ast.NIsSome AND Text.Eq (b.au, cn) THEN
          IF ViewExprEvidence (e.kids[0], d, mod, depth + 1, nm) THEN RETURN TRUE END
        END
      END
    END ;
    IF e.kind = Ast.NForIn AND NOT deep AND Text.Eq (e.au, cn) THEN
      IF ViewExprEvidence (e.kids[0], d, mod, depth + 1, nm) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF CarrierEvidence (e.kids[i], cn, d, mod, depth, nm, deep) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END CarrierEvidence ;

PROCEDURE ViewCarrier (RO cn: UTF ; d: PTR Ast.Node ; RO mod: UTF ;
                       depth: I64 ; RO nm: UTF) : BOOL =
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF IsParamOf (d, cn) THEN RETURN FALSE END ;
  RETURN CarrierEvidence (d.kids[4], cn, d, mod, depth, nm, FALSE)
END ViewCarrier ;

(* does the callee fill its I-th parameter, a VAR one, with a view of
   its J-th -- `tg.name := SLICE (s, a, n)', `t.text := text', or
   through a further call that does?  Then the argument handed to I
   CARRIES the borrow of the argument handed to J in the caller's
   frame, as the answer of a view-answering callee does
   (AnswersViewAt): the borrow is handed back, not kept, and KEPT is
   not the word for it (par 4.1, 2026-10-18).  Memoised like
   AnswersViewAt; 'busy' breaks a cycle as FALSE. *)
PROCEDURE HandsBackFrom (RO qual: UTF ; pr: ProcInfo ; i, j: I64) : BOOL =
VAR
  n : I64 ;
  key, cn, src : UTF ;
  res : BOOL ;
BEGIN
  IF i = j THEN RETURN FALSE END ;
  key := Text.Keep (pool, S5 ('back ', qual, '#', ItoA (i), Cat ('#', ItoA (j)))) ;
  n := AnsFind (key) ;
  IF n >= 0 THEN RETURN AnsYes (n) END ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    cn := VarParamAt (d, i) ;
    src := ParamNameAt (d, j) ;
    IF Text.BLen (cn) > 0 AND Text.BLen (src) > 0 THEN
      res := CarrierEvidence (d.kids[4], cn, d, pr.modName, 0, src, FALSE)
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END HandsBackFrom ;

(* HandsBackFrom's question with the store BEYOND the frame: does the
   callee put the view of its J-th parameter where its I-th points --
   `n.kids[k] := sel' through `VAR n: PTR Node', `out[i] := v' into a
   slice's storage -- rather than into the variable itself (`res :=
   SLICE (out, 0, n)', `tg.name := ...')?  The caller's variable then
   does not merely carry the borrow, its object keeps it: judged as
   the direct store `n.kids[k] := sel' would be there (par 4.1,
   2026-10-18). *)
PROCEDURE HandsBackDeep (RO qual: UTF ; pr: ProcInfo ; i, j: I64) : BOOL =
VAR
  n : I64 ;
  key, cn, src : UTF ;
  res : BOOL ;
BEGIN
  IF i = j THEN RETURN FALSE END ;
  key := Text.Keep (pool, S5 ('deep ', qual, '#', ItoA (i), Cat ('#', ItoA (j)))) ;
  n := AnsFind (key) ;
  IF n >= 0 THEN RETURN AnsYes (n) END ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    cn := VarParamAt (d, i) ;
    src := ParamNameAt (d, j) ;
    IF Text.BLen (cn) > 0 AND Text.BLen (src) > 0 THEN
      res := CarrierEvidence (d.kids[4], cn, d, pr.modName, 0, src, TRUE)
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END HandsBackDeep ;

(* does the callee answer a VIEW of its J-th parameter -- a slice or
   grid whose RETURN is that parameter, a component of it, a local
   carrying it, or such a view answered by a further callee?  Then its
   answer CARRIES the argument handed to J: the borrow is handed back,
   not kept (par 4.1, 2026-10-18).  Memoised per parameter; 'busy'
   breaks a cycle as FALSE. *)
PROCEDURE AnswersViewAt (RO qual: UTF ; pr: ProcInfo ; j: I64) : BOOL =
VAR
  i : I64 ;
  key, t, nm : UTF ;
  res : BOOL ;
BEGIN
  key := Text.Keep (pool, S4 ('view ', qual, '#', ItoA (j))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    nm := ParamNameAt (d, j) ;
    IF d.kids[1] IS SOME rt THEN
      t := CanonIn (pr.modName, d.kids[1]) ;
      IF Text.BLen (nm) > 0 AND
         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ')) THEN
        res := ViewEvidence (d.kids[4], d, pr.modName, nm)
      END
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END AnswersViewAt ;

(* is the J-th parameter OWN? *)
PROCEDURE ParamOwnAt (d: PTR Ast.Node ; j: I64) : BOOL =
VAR g, k : I64 ;
BEGIN
  k := 0 ;
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          IF j < k + ids.nkids THEN RETURN grp.f2 END ;
          k := k + ids.nkids
        END
      END
    END
  END ;
  RETURN FALSE
END ParamOwnAt ;

(* does the callee answer a POINTER it was lent -- a parameter that is
   not OWN, a component of one, a local carrying one (ViewEvidence)?
   Then its answer is a borrow, not an owner: `r := Id (p) ; DISPOSE
   (r) ; DISPOSE (p)' freed p twice (2026-10-21, the compiler review's
   O4b), and `t := Id (s)' with s in a pool freed pool storage.
   Memoised. *)
PROCEDURE AnswersBorrowAny (RO qual: UTF ; pr: ProcInfo) : BOOL ;

(* can a value of type T hold a POINTER -- a PTR or SHARED, or an OPT,
   array, record, variant, slice or grid holding one?  PtrBearing's walk,
   except that a slice or a grid counts only by its element: a string, a
   SLICE OF F64, carries storage but no pointer an answer could be *)
PROCEDURE CarriesPtr0 (r: PTR Ast.Node ; depth: I64) : BOOL ;

PROCEDURE CarriesPtr (t: Ast.Kid ; depth: I64) : BOOL =
VAR
  was : UTF ;
  rm : I64 ;
  res : BOOL ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF ResolveType (t) IS SOME r THEN
    rm := resolvedIn ;
    IF rm < 0 THEN RETURN CarriesPtr0 (r, depth) END ;
    was := canonCtx ;
    canonCtx := Text.Keep (pool, mods[rm].name) ;
    res := CarriesPtr0 (r, depth) ;
    canonCtx := was ;
    RETURN res
  END ;
  RETURN FALSE
END CarriesPtr ;

PROCEDURE CarriesPtr0 (r: PTR Ast.Node ; depth: I64) : BOOL =
VAR
  i, j : I64 ;
  fsk : Ast.Kid ;
BEGIN
  CASE r.kind OF
  | Ast.NPtrType, Ast.NSharedType : RETURN TRUE
  | Ast.NOptType, Ast.NSliceType : RETURN CarriesPtr (r.kids[0], depth + 1)
  | Ast.NArrayType, Ast.NGridType : RETURN CarriesPtr (r.kids[1], depth + 1)
  | Ast.NRecordType, Ast.NMonitorType :
      IF r.kind = Ast.NMonitorType THEN fsk := r.kids[0] ELSE fsk := r.kids[1] END ;
      IF fsk IS SOME fs THEN
        FOR i := 0 TO fs.nkids - 1 DO
          IF fs.kids[i] IS SOME g THEN
            IF CarriesPtr (g.kids[1], depth + 1) THEN RETURN TRUE END
          END
        END
      END ;
      RETURN FALSE
  | Ast.NCaseRecordType :
      FOR i := 0 TO r.nkids - 1 DO
        IF r.kids[i] IS SOME arm THEN
          IF arm.kids[0] IS SOME afs THEN
            FOR j := 0 TO afs.nkids - 1 DO
              IF afs.kids[j] IS SOME ag THEN
                IF CarriesPtr (ag.kids[1], depth + 1) THEN RETURN TRUE END
              END
            END
          END
        END
      END ;
      RETURN FALSE
  ELSE
    RETURN FALSE
  END
END CarriesPtr0 ;

(* can the J-th parameter of D, of module MOD, hold a pointer? *)
PROCEDURE ParamCarriesPtr (d: PTR Ast.Node ; RO mod: UTF ; j: I64) : BOOL =
VAR
  g, k : I64 ;
  was : UTF ;
  res : BOOL ;
BEGIN
  k := 0 ;
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          IF j < k + ids.nkids THEN
            was := canonCtx ;
            canonCtx := Text.Keep (pool, mod) ;
            res := CarriesPtr (grp.kids[1], 0) ;
            canonCtx := was ;
            RETURN res
          END ;
          k := k + ids.nkids
        END
      END
    END
  END ;
  RETURN FALSE
END ParamCarriesPtr ;

(* k through parens and SOME *)
PROCEDURE ParenSome (k: Ast.Kid) : Ast.Kid =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN RETURN ParenSome (e.kids[0]) END
  END ;
  RETURN k
END ParenSome ;

(* does a RETURN under k answer a call -- through parens and SOME -- whose
   callee answers a borrow, with an argument rooted at nm?  `RETURN Id
   (a)' answered a, and `c := Via (b) ; DISPOSE (c)' freed what b owned
   (decision 61's open half, 2026-10-25; ASan: heap-use-after-free) *)
PROCEDURE ReturnBorrows (k: Ast.Kid ; RO nm: UTF) : BOOL =
VAR
  i : I64 ;
  pr : ProcInfo ;
  found : BOOL ;
  r : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn AND e.nkids > 0 THEN
      r := ParenSome (e.kids[0]) ;
      IF r IS SOME c THEN
        IF c.kind = Ast.NCallExpr AND c.nkids > 1 THEN
          IF c.kids[0] IS SOME dn THEN
            IF dn.kind = Ast.NDesignator THEN
              pr := LookupProc (DesigName (dn), found) ;
              IF found AND Text.BLen (pr.foreign) = 0 THEN
                IF AnswersBorrowAny (Qualify (pr.modName, pr.name), pr) THEN
                  IF c.kids[1] IS SOME al THEN
                    FOR i := 0 TO al.nkids - 1 DO
                      IF Text.Eq (EscRootOf (al.kids[i]), nm) THEN RETURN TRUE END
                    END
                  END
                END
              END
            END
          END
        END
      END ;
      RETURN FALSE
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF ReturnBorrows (e.kids[i], nm) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END ReturnBorrows ;

PROCEDURE AnswersBorrowAny (RO qual: UTF ; pr: ProcInfo) : BOOL =
VAR
  i, j, n : I64 ;
  key, t, nm : UTF ;
  res : BOOL ;
BEGIN
  key := Text.Keep (pool, Cat ('borrow ', qual)) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  res := FALSE ;
  IF pr.body IS SOME d THEN
    IF d.kids[1] IS SOME rt THEN
      t := CanonIn (pr.modName, d.kids[1]) ;
      IF Text.StartsWith (t, 'PTR ') OR Text.StartsWith (t, 'OPT ') THEN
        n := CountParams (d.kids[0]) ;
        j := 0 ;
        WHILE j < n AND NOT res DO
          nm := ParamNameAt (d, j) ;
          (* only a parameter that can hold a pointer can BE the pointer
             answered: `OpenArray (s, path)' keeping a view of its STR
             path in the Array it makes answers an owner, which under
             --utf-str (a UTF path's view is seen) read as a borrow and,
             once an OWN argument asked as DISPOSE does, refused
             `CloseArray (a)' (2026-10-28) *)
          IF Text.BLen (nm) > 0 AND NOT ParamOwnAt (d, j) AND
             ParamCarriesPtr (d, pr.modName, j) THEN
            res := ViewEvidence (d.kids[4], d, pr.modName, nm) OR
                   ReturnBorrows (d.kids[4], nm)
          END ;
          j := j + 1
        END
      END
    END
  END ;
  IF res THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN res
END AnswersBorrowAny ;

(* does the callee answer a view of ANY of its parameters? *)
PROCEDURE AnswersViewAny (RO qual: UTF ; pr: ProcInfo) : BOOL =
VAR j, n : I64 ;
BEGIN
  IF pr.node IS SOME pn THEN
    n := CountParams (pn.kids[0]) ;
    FOR j := 0 TO n - 1 DO
      IF AnswersViewAt (qual, pr, j) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END AnswersViewAny ;

(* the call under K -- through parens, SOME, SLICE and GRID -- when
   its callee answers a view of some parameter, so that the call's
   ANSWER carries that argument's root (par 4.1, 2026-10-18; which
   argument, ViewArgOf says); NONE for anything else *)
PROCEDURE ViewCallOf (k: Ast.Kid) : Ast.Kid =
VAR
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr OR
       e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf THEN
      RETURN ViewCallOf (e.kids[0])
    END ;
    IF OctetsArg (e) IS SOME vca THEN RETURN ViewCallOf (SOME (vca)) END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pr := LookupProc (DesigName (dn), found) ;
          IF found AND Text.BLen (pr.foreign) = 0 THEN
            IF AnswersViewAny (Qualify (pr.modName, pr.name), pr) THEN
              RETURN SOME (e)
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END ViewCallOf ;

(* does the callee of call VC (ViewCallOf's answer) view its J-th
   argument -- the one the answer carries? *)
PROCEDURE ViewArgOf (vc: PTR Ast.Node ; j: I64) : BOOL =
VAR
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF vc.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator THEN
      pr := LookupProc (DesigName (dn), found) ;
      IF found AND Text.BLen (pr.foreign) = 0 THEN
        RETURN AnswersViewAt (Qualify (pr.modName, pr.name), pr, j)
      END
    END
  END ;
  RETURN FALSE
END ViewArgOf ;

(* the frame storage a call's answer views: the first argument that is
   frame storage AMONG THOSE THE CALLEE VIEWS (per parameter since
   2026-10-18: `ReqOf (pool, st, errs, vs, s, p + 'x')' views vs and
   not the concatenation handed to p, which cp-kernel's Respage was
   refused for) *)
PROCEDURE ViewedFrame (dn: PTR Ast.Node ; args: Ast.Kid) : UTF =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  i : I64 ;
  w, q : UTF ;
BEGIN
  IF dn.kind # Ast.NDesignator THEN RETURN '' END ;
  pr := LookupProc (DesigName (dn), found) ;
  IF NOT found OR Text.BLen (pr.foreign) > 0 THEN RETURN '' END ;
  q := Qualify (pr.modName, pr.name) ;
  IF args IS SOME al THEN
    FOR i := 0 TO al.nkids - 1 DO
      IF AnswersViewAt (q, pr, i) THEN
        w := FrameWhat (al.kids[i], 'SLICE OF CHAR') ;
        IF Text.BLen (w) > 0 THEN RETURN Cat ('a view of ', w) END
      END
    END
  END ;
  RETURN ''
END ViewedFrame ;

PROCEDURE CallAnswersFrame (dn: PTR Ast.Node) : UTF =
VAR
  name : UTF ;
  pr : ProcInfo ;
  found, ref : BOOL ;
BEGIN
  IF dn.kind # Ast.NDesignator THEN RETURN '' END ;
  name := DesigName (dn) ;
  pr := LookupProc (name, found) ;
  IF NOT found THEN RETURN '' END ;
  IF Text.BLen (pr.foreign) > 0 THEN RETURN '' END ;
  IF NOT AnswersFrame (Qualify (pr.modName, pr.name), pr) THEN RETURN '' END ;
  IF pr.node IS SOME pn THEN
    IF pn.f3 THEN RETURN '' END ;
    ref := FALSE ;
    IF ResolveType (pn.kids[1]) IS SOME r THEN
      IF r.kind = Ast.NPtrType OR r.kind = Ast.NSliceType OR
         r.kind = Ast.NGridType THEN
        ref := TRUE
      ELSIF r.kind = Ast.NOptType THEN
        IF ResolveType (r.kids[0]) IS SOME r2 THEN
          IF r2.kind = Ast.NPtrType THEN ref := TRUE END
        END
      END
    END ;
    IF ref THEN RETURN name END
  END ;
  RETURN ''
END CallAnswersFrame ;

PROCEDURE DeclPool (t: Ast.Kid) : Ast.Kid ;
PROCEDURE AllocPoolOf (k: Ast.Kid ; RO ctx: UTF) : UTF ;
PROCEDURE FrameWhat (k: Ast.Kid ; RO u: UTF) : UTF ;
PROCEDURE DesigPath (d: PTR Ast.Node) : UTF ;

(* the LOCAL pool an expression's storage lives in, by its shape: the
   pool a NEW names or a call's `IN r` promise names (AllocPoolOf), or
   the IN clause of a bare name -- when that pool is a local of this
   procedure, so dies with its frame; '' for any other pool and any
   other shape *)
PROCEDURE LocalPoolOf (e: PTR Ast.Node) : UTF =
VAR p : UTF ;
BEGIN
  p := '' ;
  IF e.kind = Ast.NNewExpr OR e.kind = Ast.NCallExpr THEN
    p := AllocPoolOf (SOME (e), '')
  ELSIF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
    IF DeclPool (ScopeType (e.au)) IS SOME dp THEN p := dp.au END
  END ;
  IF Text.BLen (p) > 0 THEN
    IF Text.Eq (ScopeMode (p), ModeLocal) THEN RETURN p END
  END ;
  RETURN ''
END LocalPoolOf ;

(* the local pool a VIEW looks into: a callee that answers RO answers
   a view of its arguments (DynStr.View, par 4.1), so an argument
   whose storage is in a local pool -- by shape, or a name holding
   such a value -- makes the answer live there too; '' otherwise *)
PROCEDURE ViewedPool (dn: PTR Ast.Node ; args: Ast.Kid) : UTF =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  i : I64 ;
  p : UTF ;
BEGIN
  IF dn.kind # Ast.NDesignator THEN RETURN '' END ;
  pr := LookupProc (DesigName (dn), found) ;
  IF NOT found THEN RETURN '' END ;
  IF pr.node IS SOME pn THEN
    IF NOT pn.f3 THEN RETURN '' END ;
    IF args IS SOME al THEN
      FOR i := 0 TO al.nkids - 1 DO
        p := KindPool (FrameWhat (al.kids[i], '')) ;
        IF Text.BLen (p) > 0 THEN RETURN p END
      END
    END
  END ;
  RETURN ''
END ViewedPool ;

PROCEDURE FrameWhat (k: Ast.Kid ; RO u: UTF) : UTF =
  (* what the frame-scoped value IS, for the diagnostic and the taint:
     'a concatenation', 'a frame allocation' (a NEW with no pool,
     docs/pool-elision-plan.md rule 1), 'the answer of F' (a call that
     built its answer here), 'an allocation in pool P' or 'a view into
     pool P' for a LOCAL pool P (par 4.3: it dies with the frame as
     the others do, but is neither re-homed nor adopted at exit -- the
     zarr proxy's FillId stored DynStr.View of a scratch-pool string
     into its VAR record, --check accepted it, and the ids read back
     as freed memory, 2026-10-01), or '' when the right-hand side is
     none of these and holds none *)
VAR nm, p : UTF ;
BEGIN
  IF FrameCore (k) IS SOME e THEN
    IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') AND
       (Text.Eq (u, 'SLICE OF CHAR') OR Text.Eq (u, UtfTy)) THEN
      RETURN 'a concatenation'
    END ;
    (* UTF (x) and STR (u) build their answer in this frame, as + does;
       OCTETS (u) is a view of u *)
    IF Text.Eq (UtfBuiltin (e), 'UTF') OR Text.Eq (UtfBuiltin (e), 'STR') THEN
      RETURN Cat ('the answer of ', UtfBuiltin (e))
    END ;
    IF OctetsArg (e) IS SOME fwa THEN
      p := FrameWhat (SOME (fwa), UtfTy) ;
      IF Text.BLen (p) > 0 THEN
        IF Text.StartsWith (p, 'a view') THEN RETURN p END ;
        RETURN Cat ('a view of ', p)
      END
    END ;
    IF e.kind = Ast.NNewExpr THEN
      IF NewIsFrame (e) THEN RETURN 'a frame allocation' END
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        nm := CallAnswersFrame (dn) ;
        IF Text.BLen (nm) > 0 THEN RETURN Cat ('the answer of ', nm) END ;
        p := ViewedPool (dn, e.kids[1]) ;
        IF Text.BLen (p) > 0 THEN RETURN Cat ('a view into pool ', p) END ;
        p := ViewedFrame (dn, e.kids[1]) ;
        IF Text.BLen (p) > 0 THEN RETURN p END
      END
    END ;
    (* a SLICE or GRID over frame storage is that storage, a view of it
       (2026-10-11: `keep := SLICE (f, 0, 2)' with f a concatenation
       passed and kept freed bytes) *)
    IF e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf THEN
      p := FrameWhat (e.kids[0], 'SLICE OF CHAR') ;
      IF Text.BLen (p) > 0 THEN
        IF Text.StartsWith (p, 'a view') THEN RETURN p END ;
        RETURN Cat ('a view of ', p)
      END
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      nm := FvalKindOf (e.au) ;
      IF Text.BLen (nm) > 0 THEN RETURN nm END
    END ;
    (* a COMPONENT that was itself given frame storage carries it:
       `c.pix := NEW (scratch, BYTE, n)' taints the path `c.pix' (and
       c, for a copy of the whole), and `RETURN c.pix' passed until
       2026-10-03 while `RETURN c' was refused -- Png.Raster died on
       it.  The PATH, not the local: an element of `mine := NEW
       (scratch, STR, n)' is a string header whose bytes live where
       they were made, and storing `mine[i]' is sound (the zarr
       proxy does, 2 sites; a rule by the local refused them). *)
    IF e.kind = Ast.NDesignator AND e.nkids > 0 THEN
      nm := FvalKindOf (DesigPath (e)) ;
      IF Text.BLen (nm) > 0 THEN RETURN nm END
    END ;
    p := LocalPoolOf (e) ;
    IF Text.BLen (p) > 0 THEN RETURN Cat ('an allocation in pool ', p) END
  END ;
  RETURN ''
END FrameWhat ;

(* the designator's component path for the taint table: the root,
   `.field' for each field selector, `[]' for each index -- `c.pix',
   `b.rows[]'.  A bare local never contains a dot or a bracket, so
   the paths share the locals' table without meeting them. *)
PROCEDURE DesigPath (d: PTR Ast.Node) : UTF =
VAR
  res : UTF ;
  i : I64 ;
BEGIN
  res := d.au ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN res := res + '.' + sel.au
      ELSE res := res + '[]' END
    END
  END ;
  RETURN res
END DesigPath ;

(* a ref value rooted at frame storage SRC was stored into the
   designator rooted DST (dstSel: through a selector) *)
(* the name under a destination or target: '>tg' marks a store into
   the VAR parameter tg's OWN storage -- the variable itself or an
   inline component, no pointer or slice crossed -- which hands the
   borrow back to the caller through tg rather than keeping it
   (StoreRef, 2026-10-18); the mark travels with the escape fact and
   the pend, and only EmitPend reads it *)
PROCEDURE TgtName (RO t: UTF) : UTF =
BEGIN
  IF Text.StartsWith (t, '>') THEN RETURN SLICE (t, 1, Text.BLen (t) - 1) END ;
  RETURN t
END TgtName ;

PROCEDURE EscStore (RO KEPT dst: UTF ; dstSel: BOOL ; RO KEPT src: UTF) =
VAR m, nm : UTF ;
BEGIN
  nm := TgtName (dst) ;
  m := ScopeMode (nm) ;
  IF Text.Eq (m, ModeModule) THEN EscTarget (src, '<module>')
  ELSIF Text.Eq (m, ModeVar) OR Text.Eq (m, ModeOwn) OR
        Text.Eq (m, ModeRo) THEN EscTarget (src, dst)
  ELSIF Text.Eq (m, ModeVal) AND dstSel THEN EscTarget (src, dst)
  ELSIF IsFrameMode (m) THEN EscAlias (nm, src)
  END
END EscStore ;

PROCEDURE PendPush (line, col: I64 ; RO KEPT src: UTF ; RO KEPT dst: UTF) =
VAR
  ns : SLICE OF UTF ;
  nl : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF npend = LEN (pendSrc) THEN
    ns := NEW (pool, UTF, 2 * LEN (pendSrc)) ;
    FOR i := 0 TO npend - 1 DO ns[i] := pendSrc[i] END ;
    pendSrc := ns ;
    ns := NEW (pool, UTF, 2 * LEN (pendDst)) ;
    FOR i := 0 TO npend - 1 DO ns[i] := pendDst[i] END ;
    pendDst := ns ;
    nl := NEW (pool, I64, 2 * LEN (pendLine)) ;
    FOR i := 0 TO npend - 1 DO nl[i] := pendLine[i] END ;
    pendLine := nl ;
    nl := NEW (pool, I64, 2 * LEN (pendCol)) ;
    FOR i := 0 TO npend - 1 DO nl[i] := pendCol[i] END ;
    pendCol := nl
  END ;
  pendSrc[npend] := src ;
  pendDst[npend] := dst ;
  pendLine[npend] := line ;
  pendCol[npend] := col ;
  npend := npend + 1
END PendPush ;

PROCEDURE CarryHas (RO nm: UTF ; RO borrow: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO ncarry - 1 DO
    IF Text.Eq (carryN[i], nm) THEN
      IF Text.Eq (carryB[i], borrow) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END CarryHas ;

PROCEDURE CarryAdd (RO KEPT nm: UTF ; RO KEPT borrow: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  FOR i := 0 TO ncarry - 1 DO
    IF Text.Eq (carryN[i], nm) THEN
      IF Text.Eq (carryB[i], borrow) THEN RETURN END
    END
  END ;
  IF ncarry = LEN (carryN) THEN
    ns := NEW (pool, UTF, 2 * LEN (carryN)) ;
    FOR i := 0 TO ncarry - 1 DO ns[i] := carryN[i] END ;
    carryN := ns ;
    ns := NEW (pool, UTF, 2 * LEN (carryB)) ;
    FOR i := 0 TO ncarry - 1 DO ns[i] := carryB[i] END ;
    carryB := ns
  END ;
  carryN[ncarry] := nm ;
  carryB[ncarry] := borrow ;
  ncarry := ncarry + 1
END CarryAdd ;

PROCEDURE CarryEdgeAdd (RO KEPT dst: UTF ; RO KEPT src: UTF) =
VAR
  ns : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF Text.Eq (dst, src) THEN RETURN END ;
  FOR i := 0 TO ncedge - 1 DO
    IF Text.Eq (carryEA[i], dst) THEN
      IF Text.Eq (carryEB[i], src) THEN RETURN END
    END
  END ;
  IF ncedge = LEN (carryEA) THEN
    ns := NEW (pool, UTF, 2 * LEN (carryEA)) ;
    FOR i := 0 TO ncedge - 1 DO ns[i] := carryEA[i] END ;
    carryEA := ns ;
    ns := NEW (pool, UTF, 2 * LEN (carryEB)) ;
    FOR i := 0 TO ncedge - 1 DO ns[i] := carryEB[i] END ;
    carryEB := ns
  END ;
  carryEA[ncedge] := dst ;
  carryEB[ncedge] := src ;
  ncedge := ncedge + 1
END CarryEdgeAdd ;

(* a reference value rooted at SRC now also lives under the bare
   local or binder DST: a borrow is carried, a carrier's cargo is
   inherited *)
PROCEDURE CarryFrom (RO KEPT dst: UTF ; RO KEPT src: UTF) =
VAR m : UTF ;
BEGIN
  m := ScopeMode (src) ;
  IF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeVar) OR
     Text.Eq (m, ModeRo) THEN
    CarryAdd (dst, src)
  ELSIF Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeBinder) THEN
    CarryEdgeAdd (dst, src)
  END
END CarryFrom ;

PROCEDURE AppendTgt (VAR d: PTR DynUtf.DString ; RO t: UTF) =
BEGIN
  IF Text.Eq (t, '<module>') THEN
    DynUtf.Append (d, 'module state')
  ELSIF Text.Eq (t, '<return>') THEN
    DynUtf.Append (d, 'the RETURN value')
  ELSIF Text.Eq (t, '<call>') THEN
    DynUtf.Append (d, 'a callee')
  ELSIF Text.Eq (t, '<unknown>') THEN
    DynUtf.Append (d, 'an unknown name')
  ELSE
    DynUtf.Append (d, 'the caller through ') ;
    DynUtf.Append (d, TgtName (t))
  END
END AppendTgt ;

PROCEDURE KeptPush (RO KEPT nm: UTF ; line, col: I64) =
VAR
  ns : SLICE OF UTF ;
  nl : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF nkept = LEN (keptP) THEN
    ns := NEW (pool, UTF, 2 * LEN (keptP)) ;
    FOR i := 0 TO nkept - 1 DO ns[i] := keptP[i] END ;
    keptP := ns ;
    nl := NEW (pool, I64, 2 * LEN (keptLn)) ;
    FOR i := 0 TO nkept - 1 DO nl[i] := keptLn[i] END ;
    keptLn := nl ;
    nl := NEW (pool, I64, 2 * LEN (keptCl)) ;
    FOR i := 0 TO nkept - 1 DO nl[i] := keptCl[i] END ;
    keptCl := nl
  END ;
  keptP[nkept] := nm ;
  keptLn[nkept] := line ;
  keptCl[nkept] := col ;
  nkept := nkept + 1
END KeptPush ;

(* a KEPT parameter earned its mark: seen retained, or handed on to
   another KEPT parameter *)
PROCEDURE KeptUse (RO KEPT nm: UTF) =
BEGIN
  PushErr (keptU, nkeptU, nm)
END KeptUse ;

PROCEDURE KeptUsedHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nkeptU - 1 DO
    IF Text.Eq (keptU[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END KeptUsedHas ;

PROCEDURE KeptHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nkept - 1 DO
    IF Text.Eq (keptP[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END KeptHas ;

(* close the escape targets over the alias edges, then classify
   every pended store by where its destination reaches: 'retention:'
   outlives the frame and names what it reaches, 'self-store:'
   reaches the caller only through the borrow itself, 'frame-store:'
   dies with the frame.  The inner bound is captured per edge, as
   the oracle's for-loop fixes it, so pairs added during a round are
   seen in the next one; the loop terminates because the pair set
   only grows and is bounded by names times targets.                *)
(* classify ONE resolved store -- SRC is the borrow, CARRIER the
   local or binder it travelled through ('' when direct) -- and
   write the ledger line, the undeclared-retention error, and the
   KEPT justification *)
PROCEDURE EmitPend (line, col: I64 ; RO KEPT src: UTF ;
                    RO carrier: UTF ; RO KEPT dst: UTF ; RO ctx: UTF) =
VAR
  selfHit, first, used : BOOL ;
  j, n2, ntl : I64 ;
  dmode, dn : UTF ;
  tl : SLICE OF UTF ;
  d, de, dm, ds : PTR DynUtf.DString IN pool ;
BEGIN
  ds := DynUtf.New (pool) ;
  DynUtf.Append (ds, src) ;
  IF Text.BLen (carrier) > 0 THEN
    DynUtf.Append (ds, ' (carried by ') ;
    DynUtf.Append (ds, carrier) ;
    DynUtf.Append (ds, ')')
  END ;
  tl := NEW (pool, UTF, 8) ;
  ntl := 0 ;
  dn := TgtName (dst) ;
  dmode := ScopeMode (dn) ;
  IF Text.Eq (dmode, ModeModule) THEN
    PushErr (tl, ntl, '<module>')
  ELSIF Text.Eq (dmode, ModeVar) OR Text.Eq (dmode, ModeOwn) OR
        Text.Eq (dmode, ModeRo) OR Text.Eq (dmode, ModeVal) THEN
    PushErr (tl, ntl, dst)
  ELSIF Text.Eq (dmode, ModeLocal) OR Text.Eq (dmode, ModeBinder) THEN
    FOR j := 0 TO nesc - 1 DO
      IF Text.Eq (escName[j], dn) THEN
        PushErr (tl, ntl, escTgt[j])
      END
    END
  ELSE
    PushErr (tl, ntl, '<unknown>')
  END ;
  (* the source among the targets is the destination escaping only
     into the borrow itself -- a tree growing through its own node
     is not a kept borrow *)
  selfHit := FALSE ;
  n2 := 0 ;
  FOR j := 0 TO ntl - 1 DO
    IF Text.Eq (TgtName (tl[j]), src) THEN
      (* in both its spellings: a store through the pointer and one
         into the parameter's own storage are one escape *)
      selfHit := TRUE
    ELSE
      tl[n2] := tl[j] ;
      n2 := n2 + 1
    END
  END ;
  ntl := n2 ;
  d := DynUtf.New (pool) ;
  IF ntl = 0 THEN
    IF selfHit THEN
      DynUtf.Append (d, 'self-store: borrowed ') ;
      DynUtf.Append (d, DynUtf.View (ds)) ;
      DynUtf.Append (d, ' stored into ') ;
      DynUtf.Append (d, dn) ;
      DynUtf.Append (d, ', which reaches the caller only through ') ;
      DynUtf.Append (d, src) ;
      DynUtf.Append (d, ' itself (par 4.1)')
    ELSE
      DynUtf.Append (d, 'frame-store: borrowed ') ;
      DynUtf.Append (d, DynUtf.View (ds)) ;
      DynUtf.Append (d, ' stored into ') ;
      DynUtf.Append (d, dn) ;
      DynUtf.Append (d, ', which never escapes the frame (par 4.1)')
    END
  ELSE
    DynUtf.Append (d, 'retention: borrowed ') ;
    DynUtf.Append (d, DynUtf.View (ds)) ;
    DynUtf.Append (d, ' stored into ') ;
    DynUtf.Append (d, dn) ;
    DynUtf.Append (d, ' -- reaches ') ;
    FOR j := 0 TO ntl - 1 DO
      IF j > 0 THEN DynUtf.Append (d, ', ') END ;
      AppendTgt (d, tl[j])
    END ;
    DynUtf.Append (d, ' (par 4.1/4.2)') ;
    (* the CHECK behind the measurement: a retention must be in the
       signature, the way a raise must be in RAISES.  '<call>'
       alone does not fire it -- whether a callee keeps its
       argument is that callee's declaration to make, and the
       caller check reads it there (par 4.1).  Nor does '<return>'
       (2026-10-18): a borrow that reaches the ANSWER is not kept by
       this procedure, it is handed back -- Text.Split answers views
       of s and retains nothing -- so the answer CARRIES the borrow
       instead (AnswersView, ViewCarrier) and the caller's store of
       that answer is the retention, judged there.  Until this day the
       answer demanded KEPT, and KEPT on a splitter refused every
       caller that split a frame string -- false, measured on ten
       corpus modules; the ledger line below still says "reaches the
       RETURN value", as a provenance fact.  Nor a VAR parameter's
       OWN storage ('>tg', StoreRef): `tg.name := SLICE (s, a, n)'
       hands the view back to the caller's variable, which CARRIES
       it there (CallType's hand-back) -- Png.NextTag fills the
       caller's Tag with views of the document and keeps nothing;
       KEPT on it rippled up to Raster and refused every caller
       that rasterised a frame string. *)
    de := DynUtf.New (pool) ;
    first := TRUE ;
    used := FALSE ;
    FOR j := 0 TO ntl - 1 DO
      IF NOT Text.Eq (tl[j], '<return>') AND NOT Text.StartsWith (tl[j], '>') THEN
        used := TRUE ;
        IF NOT Text.Eq (tl[j], '<call>') THEN
          IF NOT first THEN DynUtf.Append (de, ', ') END ;
          AppendTgt (de, tl[j]) ;
          first := FALSE
        END
      END
    END ;
    (* a KEPT is JUSTIFIED by a reach that keeps -- module state, the
       caller's object, or a callee's declared keeping ('<call>') --
       not by a hand-back: a borrow that only reaches the answer or a
       VAR parameter's own storage leaves a KEPT on it unseen, and
       the ledger says so (kept-unseen, 2026-10-18) *)
    IF used THEN KeptUse (src) END ;
    IF NOT first AND NOT KeptHas (src) THEN
      dm := DynUtf.New (pool) ;
      DynUtf.Append (dm, 'undeclared retention: borrowed ') ;
      DynUtf.Append (dm, DynUtf.View (ds)) ;
      DynUtf.Append (dm, ' reaches ') ;
      DynUtf.Append (dm, DynUtf.View (de)) ;
      DynUtf.Append (dm, ' -- declare KEPT ') ;
      DynUtf.Append (dm, src) ;
      DynUtf.Append (dm, ' (par 4.1)') ;
      Diag (errs, nerrs, line, col, ctx, DynUtf.View (dm))
    END
  END ;
  Diag (ledger, nledger, line, col, ctx, DynUtf.View (d))
END EmitPend ;

PROCEDURE FlushPend (RO ctx: UTF) =
VAR
  changed : BOOL ;
  i, j, n2 : I64 ;
  a2, b2, dmode : UTF ;
BEGIN
  changed := TRUE ;
  WHILE changed DO
    changed := FALSE ;
    FOR i := 0 TO nedge - 1 DO
      a2 := edgeA[i] ;
      b2 := edgeB[i] ;
      n2 := nesc ;
      FOR j := 0 TO n2 - 1 DO
        IF Text.Eq (escName[j], a2) THEN
          IF NOT EscHas (b2, escTgt[j]) THEN
            EscTarget (b2, escTgt[j]) ;
            changed := TRUE
          END
        END ;
        IF Text.Eq (escName[j], b2) THEN
          IF NOT EscHas (a2, escTgt[j]) THEN
            EscTarget (a2, escTgt[j]) ;
            changed := TRUE
          END
        END
      END
    END
  END ;
  (* close the carries over the copy edges, exactly as the escape
     targets closed over the alias edges *)
  changed := TRUE ;
  WHILE changed DO
    changed := FALSE ;
    FOR i := 0 TO ncedge - 1 DO
      a2 := carryEA[i] ;
      b2 := carryEB[i] ;
      n2 := ncarry ;
      FOR j := 0 TO n2 - 1 DO
        IF Text.Eq (carryN[j], b2) THEN
          IF NOT CarryHas (a2, carryB[j]) THEN
            CarryAdd (a2, carryB[j]) ;
            changed := TRUE
          END
        END
      END
    END
  END ;
  FOR i := 0 TO npend - 1 DO
    dmode := ScopeMode (pendSrc[i]) ;
    IF Text.Eq (dmode, ModeVal) OR Text.Eq (dmode, ModeVar) OR
       Text.Eq (dmode, ModeRo) THEN
      EmitPend (pendLine[i], pendCol[i], pendSrc[i], '', pendDst[i], ctx)
    ELSIF Text.Eq (dmode, ModeLocal) OR Text.Eq (dmode, ModeBinder) THEN
      (* a carrier resolves to one entry per borrow it carries -- and
         to NONE when it carries none, which is most locals *)
      FOR j := 0 TO ncarry - 1 DO
        IF Text.Eq (carryN[j], pendSrc[i]) THEN
          EmitPend (pendLine[i], pendCol[i], carryB[j],
                    pendSrc[i], pendDst[i], ctx)
        END
      END
    END
  END ;
  (* the lie detector: a KEPT parameter the analysis never saw
     retained.  A ledger class, not an error -- a borrow laundered
     through a call result is not yet seen, so an overstatement is
     a signal to read, not proof of a lie. *)
  FOR i := 0 TO nkept - 1 DO
    IF NOT KeptUsedHas (keptP[i]) THEN
      Diag (ledger, nledger, keptLn[i], keptCl[i], ctx,
        S3 ('kept-unseen: KEPT ', keptP[i],
            ' is not seen retained by this analysis (par 4.1)'))
    END
  END ;
  nesc := 0 ;
  nedge := 0 ;
  npend := 0 ;
  ncarry := 0 ;
  ncedge := 0
END FlushPend ;
(* the declared type a designator lands on, following selectors and
   dereferencing pointers on the way.  NONE when it cannot be known,
   because an unknown type must never diagnose.                     *)
(* the declared result type of the procedure a call names, qualified
   in the callee's module when that is another one (InMod: the
   designator walk's convention, which the generator reads); NONE for a call through a procedure value
   or a callee the checker does not know *)
PROCEDURE CallResultNode (k: Ast.Kid) : Ast.Kid =
VAR
  pr : ProcInfo ;
  found, any : BOOL ;
  nm : UTF ;
  i : I64 ;
BEGIN
  IF k IS SOME ce THEN
    IF ce.kind = Ast.NCallExpr THEN
      IF ce.kids[0] IS SOME cd THEN
        (* the procedure the call IS: a UTF argument sends it to its Utf
           twin, read from the types the call's typing recorded (typing
           them again would count them twice) -- `Text.Split (u, ',')[1]'
           read Split's SLICE OF STR until 2026-10-23 *)
        nm := DesigName (cd) ;
        any := FALSE ;
        IF ce.kids[1] IS SOME cal THEN
          FOR i := 0 TO cal.nkids - 1 DO
            IF cal.kids[i] IS SOME ca THEN
              IF UtfVotes (Ast.TyStrAt (ca.id)) THEN any := TRUE END
            END
          END
        END ;
        pr := LookupProc (UtfTwin (nm, any), found) ;
        IF found THEN
          IF pr.node IS SOME pn THEN
            IF pn.nkids > 1 THEN
              IF pn.kids[1] IS SOME rt THEN
                RETURN InMod (pn.kids[1], pr.modName)
              END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END CallResultNode ;

PROCEDURE DesigDeclType (d: PTR Ast.Node ; RO ctx: UTF) : Ast.Kid =
BEGIN
  RETURN SelWalk (d, ctx, ScopeType (d.au), 0)
END DesigDeclType ;

(* the selectors of d from kid FROM on, walked from the type START:
   a designator's from its name's declared type (DesigDeclType), a
   call's answer -- F (x).f, NCallSel -- from the callee's declared
   result.  Each step's type is recorded for the generator. *)
(* k is a bare name that names a type -- a builtin or this module's --
   and nothing in scope: the argument of LEN (I64) *)
PROCEDURE LenOfType (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NDesignator AND n.nkids = 0 AND
       Text.BLen (ScopeMode (n.au)) = 0 THEN
      IF IsBuiltinTy (n.au) OR Text.Eq (n.au, 'STR') OR Text.Eq (n.au, 'UTF') THEN
        RETURN TRUE
      END ;
      IF FindMod (curMod) >= 0 THEN
        IF FindTypeIn (FindMod (curMod), n.au) IS SOME t THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END LenOfType ;

(* a selector the type it is applied to cannot take: a field of a
   slice, an array, an enumeration or a scalar, a subscript of a record,
   a monitor, an enumeration or a scalar.  The checker passed them and
   the generator refused them as `unsupported yet' (the review's F4) *)
PROCEDURE SelRefuse (d: PTR Ast.Node ; RO ctx: UTF ; sel: PTR Ast.Node ;
                     ty: Ast.Kid) =
VAR whole : UTF ;
BEGIN
  (* F (x).f has its own refusal, naming the answer's type *)
  IF d.kind = Ast.NCallSel THEN RETURN END ;
  whole := Print.ExprTextUtf (SOME (d)) ;
  IF sel.kind = Ast.NSelField THEN
    ErrN (d, ctx, S4 (whole, ': no field ', sel.au,
      S3 (' -- the type ', Print.TypeTextUtf (pool, ty), ' has no fields')))
  ELSE
    ErrN (d, ctx, S4 (whole, ': cannot index -- the type ',
      Print.TypeTextUtf (pool, ty), ' is no array, slice, grid or string'))
  END
END SelRefuse ;

PROCEDURE SelWalk (d: PTR Ast.Node ; RO ctx: UTF ; start: Ast.Kid ;
                   from: I64) : Ast.Kid =
VAR
  j, q : I64 ;
  it, eb, tmod : UTF ;
  declN, res : Ast.Kid ;
  deref, known : BOOL ;
BEGIN
  tmod := '' ;
  declN := start ;
  FOR j := from TO d.nkids - 1 DO
    (* every axis of every subscript is an index *)
    IF d.kids[j] IS SOME isel THEN
      IF isel.kind = Ast.NSelIndex THEN
        eb := ArrEnumBoundOf (declN) ;
        IF Text.BLen (eb) > 0 THEN
          (* ARRAY Colour OF T: the one subscript is a Colour value *)
          IF isel.nkids >= 1 THEN
            it := ExprType (isel.kids[0], ctx) ;
            IF Text.BLen (it) > 0 AND NOT Text.Eq (it, eb) THEN
              ErrN (d, ctx, S4 ('an ARRAY ', TyName (eb),
                ' OF is indexed by a ', Cat (TyName (eb),
                Cat (' value, not ', TyName (it)))))
            END
          END
        ELSE
          FOR q := 0 TO isel.nkids - 1 DO
            it := ExprType (isel.kids[q], ctx) ;
            IF NOT IsIntish (it) THEN
              ErrN (d, ctx, Cat ('index must be an integer, not ',
                TyName (it)))
            END
          END
        END
      END
    END ;
    known := FALSE ;
    IF declN IS SOME dn1 THEN known := TRUE END ;
    IF NOT known THEN RETURN NONE END ;
    NoteMod (declN, tmod) ;
    res := ResolveType (declN) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          declN := InMod (r0.kids[0], tmod) ;
          NoteMod (declN, tmod) ;
          res := ResolveType (declN)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF r.kind = Ast.NOptType THEN
        (* selecting THROUGH an OPT is the faith-based downcast the
           museum records: the guard is not optional *)
        ErrN (d, ctx, Cat ('OPT value used without IS SOME guard: ',
          d.au)) ;
        RETURN NONE
      END ;
      IF r.kind = Ast.NCaseRecordType THEN
        (* a variant is reached by CASE, which binds its payload;
           selecting one is the faith-based downcast again *)
        ErrN (d, ctx, Cat (
          'CASE RECORD is reached by CASE, not by selection: ', d.au)) ;
        RETURN NONE
      END ;
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            declN := InMod (FieldTypeOf (r, sel.au), tmod) ;
            IF declN IS SOME fk THEN
              q := 0                     (* found; nothing to say *)
            ELSE
              IF r.kids[0] IS SOME base THEN
                q := 0                   (* an extension: it may be
                                            the base record's field *)
              ELSE
                ErrN (d, ctx, S4 ('no field ', sel.au,
                  ' in the record type of ', d.au))
              END
            END
          ELSIF r.kind = Ast.NMonitorType THEN
            (* par 6: a monitor's fields are reachable only through
               the procedure bound to it, and the binding is the
               FIRST parameter because M9 has no method syntax.  So
               the monitor must be named by that parameter, bare:
               `w.next` inside `Claim (VAR w: Work)` is the binding,
               while `j.w.next` reaches past it, and a second monitor
               parameter is a different lock. *)
            IF Text.Eq (boundMon, '') OR NOT Text.Eq (d.au, boundMon) OR
               j # from THEN
              ErrN (d, ctx, S3 ('monitor field ', sel.au,
                ' is reached from outside a procedure bound to the monitor (par 6)'))
            END ;
            declN := InMod (MonFieldType (r, sel.au), tmod)
          ELSE
            IF r.kind = Ast.NSliceType OR r.kind = Ast.NArrayType OR
               r.kind = Ast.NGridType OR r.kind = Ast.NEnumType THEN
              SelRefuse (d, ctx, sel, declN)
            END ;
            RETURN NONE
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NGridType THEN
            (* one subscript per axis, counted against the rank in
               the type: the check a flat slice with arithmetic on
               top cannot make *)
            IF sel.nkids # AtoI (Print.ExprTextUtf (r.kids[0])) THEN
              ErrN (d, ctx, S5 ('a GRID ',
                Print.ExprTextUtf (r.kids[0]), ' needs ',
                Print.ExprTextUtf (r.kids[0]),
                Cat (' subscripts, not ', ItoA (sel.nkids))))
            END ;
            declN := InMod (r.kids[1], tmod)
          ELSIF r.kind = Ast.NSliceType AND IsUtfNode (r) THEN
            (* a UTF has no O(1) i-th character, so no subscript: the
               operation says its unit and its cost (docs/utf8-plan.md) *)
            ErrN (d, ctx, Cat (Print.ExprTextUtf (SOME (d)),
              ': a UTF has no subscript -- Text.BAt (u, i) for the byte at offset i, Text.CpAt (u, x) or FOR c IN u for a character')) ;
            RETURN NONE
          ELSIF r.kind = Ast.NSliceType THEN
            IF sel.nkids # 1 THEN
              ErrN (d, ctx, Cat ('a slice takes one subscript, not ',
                ItoA (sel.nkids)))
            END ;
            IF NamesStr (declN) AND sel.nkids = 1 THEN
              StrScan (sel, 'index', Cat (Cat (d.au, '['),
                Cat (Print.ExprTextUtf (sel.kids[0]), ']')))
            END ;
            declN := InMod (r.kids[0], tmod)
          ELSIF r.kind = Ast.NArrayType THEN
            IF sel.nkids # 1 THEN
              ErrN (d, ctx, Cat ('an array takes one subscript, not ',
                ItoA (sel.nkids)))
            END ;
            declN := InMod (r.kids[1], tmod)
          ELSE
            IF r.kind = Ast.NRecordType OR r.kind = Ast.NMonitorType OR
               r.kind = Ast.NEnumType THEN
              SelRefuse (d, ctx, sel, declN)
            END ;
            RETURN NONE
          END
        END
      END
    ELSE
      (* a builtin scalar resolves to nothing: I64, F64, BOOL ... *)
      IF d.kids[j] IS SOME bsel THEN
        IF declN IS SOME bn THEN
          IF bn.kind = Ast.NQualident AND Text.BLen (bn.bu) = 0 AND
             IsBuiltinTy (bn.au) THEN
            SelRefuse (d, ctx, bsel, declN)
          END
        END
      END ;
      RETURN NONE
    END ;
    (* the typed tree: what this selector reaches, qualified where it
       was declared, for the generator to read (Ast.SetType) *)
    IF d.kids[j] IS SOME stp THEN Ast.SetType (stp.id, declN) END
  END ;
  RETURN declN
END SelWalk ;

PROCEDURE DesigCanon (k: Ast.Kid ; RO ctx: UTF) : UTF =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      RETURN CanonT (DesigDeclType (e, ctx), 0)
    END ;
    IF e.kind = Ast.NSomeExpr OR e.kind = Ast.NParen THEN
      RETURN DesigCanon (e.kids[0], ctx)
    END
  END ;
  RETURN ''
END DesigCanon ;

(* ---- pass 3: expression and assignment typing ----

   Types are canonical STRINGS -- 'I64', 'PTR Json.Node',
   'SLICE OF CHAR', 'GRID 2 OF F64' -- because that is what makes
   nominal identity, alias chasing and diagnostics one mechanism
   instead of three.  Records, monitors and opaques are nominal
   (Mod.Name); aliases chase to structure; the IN-pool and the RO
   mode are not part of type identity.

   The empty string means UNKNOWN and never diagnoses.  Softness is
   the contract: a checker that guesses at what it cannot resolve
   reports errors that are not there, and a checker nobody believes
   is a checker nobody runs.

   The literal pseudo-types adapt: <int> fits any integer or BYTE,
   <real> fits F32/F64, <str1> (a one-character string) fits CHAR or
   SLICE OF CHAR, <none> fits any OPT, <all> fits only a VIEW axis.
   Everything else converts explicitly, including widths -- the
   16-byte-stride museum piece is a width that converted itself.   *)

PROCEDURE AtoI (RO s: UTF) : I64 =
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO
    IF B (s, i) < 48 OR B (s, i) > 57 THEN RETURN v END ;
    v := v * 10 + (B (s, i) - 48)
  END ;
  RETURN v
END AtoI ;

PROCEDURE ItoA (v: I64) : UTF =
VAR
  scratch : POOL ;
  d : PTR DynUtf.DString IN scratch ;
BEGIN
  d := DynUtf.New (scratch) ;
  DynUtf.AppendI64 (d, v) ;
  RETURN DynUtf.View (d)
END ItoA ;

PROCEDURE S3 (RO a: UTF ; RO b: UTF ; RO c: UTF) : UTF =
BEGIN
  RETURN Cat (Cat (a, b), c)
END S3 ;

PROCEDURE S4 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO d: UTF) : UTF =
BEGIN
  RETURN Cat (Cat (a, b), Cat (c, d))
END S4 ;

PROCEDURE S5 (RO a: UTF ; RO b: UTF ; RO c: UTF ; RO d: UTF ;
              RO e: UTF) : UTF =
BEGIN
  RETURN Cat (S4 (a, b, c, d), e)
END S5 ;

PROCEDURE IsIntStr (RO s: UTF) : BOOL =
BEGIN
  IF Text.Eq (s, 'I8') OR Text.Eq (s, 'I16') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'I32') OR Text.Eq (s, 'I64') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'U8') OR Text.Eq (s, 'U16') THEN RETURN TRUE END ;
  IF Text.Eq (s, 'U32') OR Text.Eq (s, 'U64') THEN RETURN TRUE END ;
  RETURN FALSE
END IsIntStr ;

PROCEDURE IsFloatStr (RO s: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (s, 'F32') OR Text.Eq (s, 'F64')
END IsFloatStr ;

PROCEDURE IsIntish (RO s: UTF) : BOOL =
BEGIN
  IF Text.BLen (s) = 0 THEN RETURN TRUE END ;
  RETURN IsIntStr (s) OR Text.Eq (s, '<int>')
END IsIntish ;

PROCEDURE IsNumStr (RO s: UTF) : BOOL =
BEGIN
  IF Text.BLen (s) = 0 THEN RETURN TRUE END ;
  IF Text.Eq (s, '<int>') OR Text.Eq (s, '<real>') THEN RETURN TRUE END ;
  RETURN IsIntStr (s) OR IsFloatStr (s)
END IsNumStr ;

PROCEDURE TyName (RO s: UTF) : UTF =
BEGIN
  IF Text.Eq (s, '<int>') THEN RETURN 'an integer literal' END ;
  IF Text.Eq (s, '<real>') THEN RETURN 'a real literal' END ;
  IF Text.Eq (s, '<str1>') THEN RETURN 'a CHAR/string literal' END ;
  IF Text.Eq (s, '<none>') THEN RETURN 'NONE' END ;
  IF Text.Eq (s, '<void>') THEN RETURN 'no value' END ;
  IF Text.Eq (s, '<all>') THEN RETURN 'ALL' END ;
  IF Text.BLen (s) = 0 THEN RETURN 'an unknown type' END ;
  RETURN s
END TyName ;

(* the element type of a slice or an array's canonical type, '' for
   anything else *)
PROCEDURE CopyElem (RO t: UTF) : UTF =
BEGIN
  IF Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'ARRAY ') THEN
    RETURN AfterOf (t)
  END ;
  RETURN ''
END CopyElem ;

(* COPY's element types: a builtin scalar or an enumeration -- a
   pointer element is a store the ownership rules follow one by one *)
PROCEDURE CopyElemOk (RO t: UTF) : BOOL =
VAR dot : I64 ;
BEGIN
  IF IsBuiltinTy (t) THEN RETURN TRUE END ;
  dot := Text.FindChar (t, '.') ;
  IF dot > 0 THEN
    RETURN AllPayloadless (LookupTypeName (SLICE (t, 0, dot),
                                           SLICE (t, dot + 1, Text.BLen (t) - dot - 1)))
  END ;
  RETURN FALSE
END CopyElemOk ;

(* COPY (to, from): two slices or arrays of one scalar element type,
   `to' writable.  Unknown types say nothing (softness).  The lengths
   are the run time's: unequal ones raise IndexError and copy nothing. *)
PROCEDURE CheckCopy (site: PTR Ast.Node ; RO ctx: UTF ; RO toTy: UTF ;
                     RO fromTy: UTF ; toArg: Ast.Kid) =
VAR
  te, fe, w : UTF ;
  root : Ast.Kid ;
BEGIN
  IF Text.BLen (toTy) = 0 OR Text.BLen (fromTy) = 0 THEN RETURN END ;
  te := CopyElem (toTy) ;
  fe := CopyElem (fromTy) ;
  IF Text.BLen (te) = 0 THEN
    ErrN (site, ctx, Cat ('COPY copies into a slice or an array, not ', TyName (toTy))) ;
    RETURN
  END ;
  IF Text.BLen (fe) = 0 THEN
    ErrN (site, ctx, Cat ('COPY copies from a slice or an array, not ', TyName (fromTy))) ;
    RETURN
  END ;
  IF NOT Text.Eq (te, fe) THEN
    ErrN (site, ctx, S4 ('COPY needs one element type: ', TyName (te), ' and ', TyName (fe))) ;
    RETURN
  END ;
  IF NOT CopyElemOk (te) THEN
    ErrN (site, ctx, S3 ('COPY copies elements of a scalar type, not ', TyName (te),
      ' -- such elements are stores the ownership rules follow one by one: keep the loop')) ;
    RETURN
  END ;
  (* `to' is written: read-only storage, through a SLICE of it too, is
     refused as it is lent to a writable parameter (par 2.4) *)
  root := toArg ;
  IF toArg IS SOME ta THEN
    IF ta.kind = Ast.NSliceOf3 THEN root := ta.kids[0] END
  END ;
  w := RoWhatArg (root, 'SLICE OF X', toTy) ;
  IF root IS SOME rd THEN
    IF rd.kind = Ast.NDesignator AND rd.nkids = 0 AND IsConstHere (rd.au) THEN
      w := Cat ('the CONST ', rd.au)
    END
  END ;
  IF Text.BLen (w) > 0 THEN
    ErrN (site, ctx, S3 ('COPY writes into ', w, ', which is read-only (par 2.4)'))
  END
END CheckCopy ;

PROCEDURE AfterOf (RO s: UTF) : UTF =
VAR i : I64 ;
BEGIN
  i := Text.Find (s, ' OF ') ;
  IF i < 0 THEN RETURN '' END ;
  RETURN SLICE (s, i + 4, Text.BLen (s) - i - 4)
END AfterOf ;

(* 'GRID 3 OF F64': the rank is part of the type so that subscript
   arity is a compile-time question.  0 means "not a grid". *)
PROCEDURE GridRank (RO s: UTF) : I64 =
VAR i, v, k : I64 ;
BEGIN
  IF NOT Text.StartsWith (s, 'GRID ') THEN RETURN 0 END ;
  i := Text.Find (s, ' OF ') ;
  IF i <= 5 THEN RETURN 0 END ;
  v := 0 ;
  FOR k := 5 TO i - 1 DO
    IF B (s, k) < 48 OR B (s, k) > 57 THEN RETURN 0 END ;
    (* past a 32-bit rank, 0, as the Pascal twin's StrToIntDef: the
       product overflowed, unhandled (the fuzz review's N8) *)
    IF v > 214748363 THEN RETURN 0 END ;
    v := v * 10 + (B (s, k) - 48)
  END ;
  RETURN v
END GridRank ;

(* the type of a view that keeps rank axes.  A rank-1 view is a
   GRID 1 and NOT a slice: a slice is {pointer, length} with no
   stride, and the column at (i,j) is strided. *)
PROCEDURE GridOf (rank: I64 ; RO elem: UTF) : UTF =
BEGIN
  IF Text.BLen (elem) = 0 THEN RETURN '' END ;
  RETURN S4 ('GRID ', ItoA (rank), ' OF ', elem)
END GridOf ;

(* assignment compatibility: may a src value land where dst is
   expected?  Unknown is compatible with everything. *)
(* the range of an integer width a literal is stored into; FALSE for
   a type that is not a narrow integer -- I64 holds every literal the
   lexer accepts, and U64's upper half cannot be spelled as one *)
PROCEDURE LitRange (RO t: UTF ; VAR lo: I64 ; VAR hi: I64) : BOOL =
BEGIN
  IF Text.Eq (t, 'I8') THEN lo := -128 ; hi := 127 ; RETURN TRUE END ;
  IF Text.Eq (t, 'I16') THEN lo := -32768 ; hi := 32767 ; RETURN TRUE END ;
  IF Text.Eq (t, 'I32') THEN
    lo := -2147483648 ; hi := 2147483647 ; RETURN TRUE
  END ;
  IF Text.Eq (t, 'U8') OR Text.Eq (t, 'BYTE') THEN
    lo := 0 ; hi := 255 ; RETURN TRUE
  END ;
  IF Text.Eq (t, 'U16') THEN lo := 0 ; hi := 65535 ; RETURN TRUE END ;
  IF Text.Eq (t, 'U32') THEN lo := 0 ; hi := 4294967295 ; RETURN TRUE END ;
  IF Text.Eq (t, 'U64') THEN lo := 0 ; hi := 9223372036854775807 ; RETURN TRUE END ;
  RETURN FALSE
END LitRange ;

(* a decimal literal node's value, negated when asked; FALSE for a hex
   literal (a bit pattern, left to the width it names) or one too
   long to hold *)
PROCEDURE LitVal (lit: PTR Ast.Node ; neg: BOOL ; VAR v: I64) : BOOL =
VAR i : I64 ;
BEGIN
  IF lit.kind # Ast.NInt THEN RETURN FALSE END ;
  IF Text.BLen (lit.au) = 0 OR Text.BLen (lit.au) > 18 THEN RETURN FALSE END ;
  FOR i := 0 TO Text.BLen (lit.au) - 1 DO
    IF B (lit.au, i) < 48 OR B (lit.au, i) > 57 THEN RETURN FALSE END
  END ;
  v := AtoI (lit.au) ;
  IF neg THEN v := -v END ;
  RETURN TRUE
END LitVal ;

(* an integer literal stored where a narrow width is expected must
   fit it.  `s := 40000` for an I16 passed this checker and the C
   conversion stored -25536 until 2026-09-27 -- the same silence as
   the narrow arithmetic fixed the same day (docs/agent-review-
   2026-09-27.md F1).  Answers the offending value through v. *)
PROCEDURE LitOut (n: PTR Ast.Node ; RO t: UTF ; VAR v: I64) : BOOL =
VAR lo, hi : I64 ;
BEGIN
  IF NOT LitRange (t, lo, hi) THEN RETURN FALSE END ;
  IF n.kind = Ast.NUn AND Text.Eq (n.au, '-') THEN
    IF n.kids[0] IS SOME c THEN
      IF NOT LitVal (c, TRUE, v) THEN RETURN FALSE END ;
      RETURN v < lo OR v > hi
    END ;
    RETURN FALSE
  END ;
  IF NOT LitVal (n, FALSE, v) THEN RETURN FALSE END ;
  RETURN v < lo OR v > hi
END LitOut ;

(* ---- a procedure fits a procedure type that lets it raise MORE than
   it does (report par 2.2.3; Alex's decision of 2026-10-02).  The
   fit was to the letter, RAISES included, and so a function that
   cannot raise had to SAY `RAISES ValueRange' to be handed to
   Numeric, and Check needed two types where one would do.  Raising
   less is sound: the caller of a value handles what the TYPE says,
   which is then a superset; and nothing moves in the C, where every
   procedure takes the error slot whatever it declares.  Raising
   more is refused as it always was.  Everything else in the
   canonical text -- modes, types, the result -- is still held to
   the letter. ---- *)

(* how much of the canonical text of a procedure type comes before
   its own RAISES clause: all of it when it has none, -1 when s is
   not a procedure type.  A parameter may itself be a procedure type
   with a RAISES of its own, inside the parentheses; the result
   cannot be one. *)
PROCEDURE ProcHead (RO s: UTF) : I64 =
VAR i, depth, close : I64 ;
BEGIN
  IF NOT Text.StartsWith (s, 'PROCEDURE (') THEN RETURN -1 END ;
  depth := 0 ;
  close := -1 ;
  i := 10 ;
  WHILE i < Text.BLen (s) AND close < 0 DO
    IF B (s, i) = ORD ('(') THEN
      depth := depth + 1
    ELSIF B (s, i) = ORD (')') THEN
      depth := depth - 1 ;
      IF depth = 0 THEN close := i END
    END ;
    i := i + 1
  END ;
  IF close < 0 THEN RETURN -1 END ;
  i := close ;
  WHILE i + 8 <= Text.BLen (s) DO
    IF Text.Eq (SLICE (s, i, 8), ' RAISES ') THEN RETURN i END ;
    i := i + 1
  END ;
  RETURN Text.BLen (s)
END ProcHead ;

(* two lists as they stand after RAISES, `A, B': is every name of
   src one of dst's? *)
PROCEDURE RaisesWithin (RO src: UTF ; RO dst: UTF) : BOOL =
VAR
  a, b, ea, eb : I64 ;
  found : BOOL ;
BEGIN
  a := 0 ;
  WHILE a < Text.BLen (src) DO
    ea := a ;
    WHILE ea < Text.BLen (src) AND B (src, ea) # ORD (',') DO ea := ea + 1 END ;
    found := FALSE ;
    b := 0 ;
    WHILE b < Text.BLen (dst) AND NOT found DO
      eb := b ;
      WHILE eb < Text.BLen (dst) AND B (dst, eb) # ORD (',') DO eb := eb + 1 END ;
      found := ExcCovers (SLICE (dst, b, eb - b), SLICE (src, a, ea - a)) ;
      b := eb + 2
    END ;
    IF NOT found THEN RETURN FALSE END ;
    a := ea + 2
  END ;
  RETURN TRUE
END RaisesWithin ;

PROCEDURE ProcFits (RO dst: UTF ; RO src: UTF) : BOOL =
VAR hd, hs : I64 ;
BEGIN
  hd := ProcHead (dst) ;
  hs := ProcHead (src) ;
  IF hd < 0 OR hs < 0 THEN RETURN FALSE END ;
  IF NOT Text.Eq (SLICE (dst, 0, hd), SLICE (src, 0, hs)) THEN RETURN FALSE END ;
  IF hs = Text.BLen (src) THEN RETURN TRUE END ;        (* src raises nothing *)
  IF hd = Text.BLen (dst) THEN RETURN FALSE END ;       (* and dst allows nothing *)
  RETURN RaisesWithin (SLICE (src, hs + 8, Text.BLen (src) - hs - 8),
                       SLICE (dst, hd + 8, Text.BLen (dst) - hd - 8))
END ProcFits ;

PROCEDURE Compat (RO dst: UTF ; RO src: UTF) : BOOL =
BEGIN
  IF Text.Eq (dst, '<void>') OR Text.Eq (src, '<void>') THEN
    RETURN FALSE
  END ;
  IF Text.BLen (dst) = 0 OR Text.BLen (src) = 0 THEN RETURN TRUE END ;
  IF Text.Eq (dst, src) THEN RETURN TRUE END ;
  IF Text.Eq (src, '<int>') THEN
    RETURN IsIntStr (dst) OR Text.Eq (dst, 'BYTE')
  END ;
  IF Text.Eq (dst, '<int>') THEN
    RETURN IsIntStr (src) OR Text.Eq (src, 'BYTE')
  END ;
  IF Text.Eq (src, '<real>') THEN RETURN IsFloatStr (dst) END ;
  IF Text.Eq (dst, '<real>') THEN RETURN IsFloatStr (src) END ;
  IF Text.Eq (src, '<str1>') THEN
    RETURN Text.Eq (dst, 'CHAR') OR Text.Eq (dst, 'SLICE OF CHAR')
  END ;
  IF Text.Eq (dst, '<str1>') THEN
    RETURN Text.Eq (src, 'CHAR') OR Text.Eq (src, 'SLICE OF CHAR')
  END ;
  IF Text.Eq (src, '<none>') THEN RETURN Text.StartsWith (dst, 'OPT ') END ;
  IF Text.Eq (dst, '<none>') THEN RETURN Text.StartsWith (src, 'OPT ') END ;
  (* ADR's answer fits a C pointer parameter of either constness *)
  IF Text.Eq (src, 'C.Ptr') THEN
    RETURN Text.Eq (dst, 'C.ConstPtr') OR Text.Eq (dst, 'C.MutPtr')
  END ;
  (* ARRAY N OF T is the view of all N elements (par 2.2) *)
  IF Text.StartsWith (dst, 'SLICE OF ') AND
     Text.StartsWith (src, 'ARRAY ') THEN
    RETURN Text.Eq (AfterOf (src), SLICE (dst, 9, Text.BLen (dst) - 9))
  END ;
  (* a shared handle lends like a plain borrow (par 4.1) *)
  IF Text.StartsWith (dst, 'PTR ') THEN
    IF Text.Eq (src, Cat ('SHARED ', dst)) THEN RETURN TRUE END
  END ;
  (* a procedure that raises no more than the type allows, bare or as
     the OPT a variable of procedure type must be *)
  IF ProcFits (dst, src) THEN RETURN TRUE END ;
  IF Text.StartsWith (dst, 'OPT ') AND Text.StartsWith (src, 'OPT ') THEN
    RETURN ProcFits (SLICE (dst, 4, Text.BLen (dst) - 4), SLICE (src, 4, Text.BLen (src) - 4))
  END ;
  RETURN FALSE
END Compat ;

(* one site where two types are about to be held to each other: it
   was EXAMINED when both are known, and PASSED OVER when either is
   the empty string, which is exactly the case Compat answers TRUE
   for without looking.  Called beside every Compat that decides a
   diagnostic, never inside it: several sites ask Compat twice. *)
PROCEDURE PassedOver (kind, line: I64) =
  (* count it, and keep the first StatSites DIFFERENT lines: a count
     a reviewer cannot go and look at is a count they have to take on
     trust, which is what the page exists to end *)
VAR r : I64 ;
BEGIN
  statS[kind] := statS[kind] + 1 ;
  r := statR[kind] ;
  IF r < StatSites THEN
    IF r = 0 THEN
      statL[kind * StatSites] := line ;
      statR[kind] := 1
    ELSIF statL[kind * StatSites + r - 1] # line THEN
      statL[kind * StatSites + r] := line ;
      statR[kind] := r + 1
    END
  END
END PassedOver ;

PROCEDURE Agree (kind: I64 ; RO a: UTF ; RO b: UTF ; line: I64) =
BEGIN
  IF Text.BLen (a) = 0 OR Text.BLen (b) = 0 THEN
    PassedOver (kind, line)
  ELSE
    statC[kind] := statC[kind] + 1
  END
END Agree ;

PROCEDURE StatName (i: I64) : UTF =
BEGIN
  CASE i OF
  | 0 : RETURN 'assignments'
  | 1 : RETURN 'arguments'
  | 2 : RETURN 'RETURN values'
  | 3 : RETURN 'operands of a comparison or an operator'
  | 4 : RETURN 'CASE labels'
  | 5 : RETURN 'THREAD arguments'
  | 6 : RETURN 'CASE over variants, proved total'
  ELSE RETURN ''
  END
END StatName ;

PROCEDURE StatChecked (i: I64) : I64 =
BEGIN
  RETURN statC[i]
END StatChecked ;

PROCEDURE StatSkipped (i: I64) : I64 =
BEGIN
  RETURN statS[i]
END StatSkipped ;

PROCEDURE StatLines (i: I64) : I64 =
BEGIN
  RETURN statR[i]
END StatLines ;

PROCEDURE StatLine (i, j: I64) : I64 =
BEGIN
  RETURN statL[i * StatSites + j]
END StatLine ;

(* the type one element of an aggregate has (par 2.2.4): a literal,
   or a negated numeric literal.  An integer is an I64, a real an
   F64, a string a STR whatever its length -- a table has one element
   type and nothing in it adapts.  '' for anything else.  A record
   aggregate whose fields are all literals is an element of its
   record's type (Row (200, 'OK'); the fields' types are
   CheckRecordConst's to hold). *)
PROCEDURE RecordNamed (RO name: UTF ; VAR om: UTF ; VAR canon: UTF) : Ast.Kid ;

PROCEDURE RecordConstType (e: PTR Ast.Node) : UTF =
VAR
  i : I64 ;
  om, canon : UTF ;
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN '' END ;
  IF e.kids[0] IS SOME dn THEN
    IF RecordNamed (DesigName (dn), om, canon) IS SOME rn THEN
      IF e.kids[1] IS SOME al THEN
        FOR i := 0 TO al.nkids - 1 DO
          IF Text.BLen (AggElemType (al.kids[i])) = 0 THEN RETURN '' END
        END
      END ;
      RETURN canon
    END
  END ;
  RETURN ''
END RecordConstType ;

(* is e Row (...) for a record type Row? *)
PROCEDURE IsRecordCall (e: PTR Ast.Node) : BOOL =
VAR om, canon : UTF ;
BEGIN
  IF e.kind # Ast.NCallExpr THEN RETURN FALSE END ;
  IF e.kids[0] IS SOME dn THEN
    IF RecordNamed (DesigName (dn), om, canon) IS SOME rn THEN RETURN TRUE END
  END ;
  RETURN FALSE
END IsRecordCall ;

(* the type of field f of the record whose canonical name is rec --
   a record CONST read as Ok.code *)
PROCEDURE ConstFieldType (RO rec: UTF ; RO f: UTF) : UTF =
VAR
  om, canon, s : UTF ;
BEGIN
  IF RecordNamed (rec, om, canon) IS SOME rn THEN
    IF FieldTypeOf (rn, f) IS SOME ft THEN
      canonCtx := Text.Keep (pool, om) ;
      s := CanonT (SOME (ft), 0) ;
      canonCtx := '' ;
      RETURN s
    END
  END ;
  RETURN ''
END ConstFieldType ;

PROCEDURE AggElemType (k: Ast.Kid) : UTF =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN RETURN RecordConstType (e) END ;
    CASE e.kind OF
    | Ast.NInt : RETURN 'I64'
    | Ast.NReal : RETURN 'F64'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString : RETURN StrLitTy ()
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NUn :
        IF Text.Eq (e.au, '-') THEN
          IF e.kids[0] IS SOME o THEN
            IF o.kind = Ast.NInt THEN RETURN 'I64' END ;
            IF o.kind = Ast.NReal THEN RETURN 'F64' END
          END
        END ;
        RETURN ''
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END AggElemType ;

(* [ e1, ..., en ] is an ARRAY n OF T, T being what every element
   is; unknown ('') when the elements do not agree, which
   CheckAggregate says by name *)
PROCEDURE AggType (e: PTR Ast.Node) : UTF =
VAR
  i : I64 ;
  t : UTF ;
BEGIN
  IF e.nkids = 0 THEN RETURN '' END ;
  t := AggElemType (e.kids[0]) ;
  IF Text.BLen (t) = 0 THEN RETURN '' END ;
  FOR i := 1 TO e.nkids - 1 DO
    IF NOT Text.Eq (AggElemType (e.kids[i]), t) THEN RETURN '' END
  END ;
  RETURN S4 ('ARRAY ', ItoA (e.nkids), ' OF ', t)
END AggType ;

(* the type of a module-level CONST: literals and literal
   arithmetic, an aggregate of literals, and nothing fancier *)
CONST
  IntOps = ['+', '-', '*', 'DIV', 'MOD'] ;
  ArithOps = ['-', '*', '/', 'DIV', 'MOD'] ;
  NumericTys = ['I8', 'I16', 'I32', 'I64', 'U8', 'U16', 'U32', 'U64', 'F32', 'F64', 'BYTE'] ;
  (* builtins whose answer holds no reference (OlScalarFn) *)
  ScalarFns = ['LEN', 'ORD', 'CHR', 'ABS', 'ODD', 'MAX', 'MIN', 'I8', 'I16', 'I32', 'I64',
               'U8', 'U16', 'U32', 'U64', 'F32', 'F64', 'CHAR', 'BOOL', 'BYTE'] ;
  I64Max = '9223372036854775807' ;
  RealOps = ['+', '-', '*', '/'] ;

(* a decimal integer literal past MAX (I64) is a U64 literal
   (2026-10-21, the compiler review's F1): typed U64, it is held where
   it lands as every U64 is -- `big := 18446744073709551615' for a U64
   as before, `x := 9223372036854775808' for an I64 refused by the
   rule of no implicit conversions -- where as an <int> it reached C
   as INT64_C of a value past 2^63 and printed its wrapped self.  The
   lexer refuses one past 64 bits; a hex literal is a bit pattern and
   stays an <int>. *)
PROCEDURE BeyondI64 (RO a: UTF) : BOOL =
VAR i, k : I64 ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (a) - 1 AND B (a, i) = 48 DO i := i + 1 END ;
  IF Text.BLen (a) - i # 19 THEN RETURN Text.BLen (a) - i > 19 END ;
  FOR k := 0 TO 18 DO
    IF B (a, i + k) < 48 OR B (a, i + k) > 57 THEN RETURN FALSE END ;
    IF B (a, i + k) # ORD (I64Max[k]) THEN RETURN B (a, i + k) > ORD (I64Max[k]) END
  END ;
  RETURN FALSE
END BeyondI64 ;

PROCEDURE LitType (k: Ast.Kid) : UTF =
VAR l, r : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN RETURN RecordConstType (e) END ;
    CASE e.kind OF
    | Ast.NAggregate : RETURN AggType (e)
    | Ast.NInt :
        IF BeyondI64 (e.au) THEN RETURN 'U64' END ;
        RETURN '<int>'
    | Ast.NReal : RETURN '<real>'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString :
        IF Text.CpCount (e.au) = 1 THEN RETURN '<str1>' END ;
        RETURN StrLitTy ()
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NParen : RETURN LitType (e.kids[0])
    | Ast.NUn : RETURN LitType (e.kids[0])
    | Ast.NBin :
        l := LitType (e.kids[0]) ;
        r := LitType (e.kids[1]) ;
        (* the arithmetic each kind has, and nothing else: a CONST of
           2 < 3 or 1 / 2 is no number the generator can write *)
        IF Text.Eq (l, '<int>') AND Text.Eq (r, '<int>') AND
           Text.OneOf (STR (e.au), IntOps) THEN
          RETURN '<int>'
        END ;
        IF Text.Eq (l, '<real>') AND Text.Eq (r, '<real>') AND
           Text.OneOf (STR (e.au), RealOps) THEN
          RETURN '<real>'
        END ;
        (* `+' over string and CHAR literals is one string literal
           (the generators fold it, 2026-10-09) *)
        IF Text.Eq (e.au, '+') AND IsStrLit (l) AND IsStrLit (r) THEN
          RETURN StrLitTy ()
        END ;
        RETURN ''
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END LitType ;

(* an expression a generator folds, not a literal it writes as is: a
   binary operation, parentheses, or a minus over something that is not
   itself a literal *)
PROCEDURE IsConstExpr (e: PTR Ast.Node) : BOOL =
BEGIN
  IF e.kind = Ast.NBin OR e.kind = Ast.NParen THEN RETURN TRUE END ;
  IF e.kind = Ast.NUn AND e.nkids > 0 THEN
    IF e.kids[0] IS SOME k THEN
      RETURN k.kind # Ast.NInt AND k.kind # Ast.NReal
    END
  END ;
  RETURN FALSE
END IsConstExpr ;

PROCEDURE IsStrLit (RO t: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (t, '<str1>') OR Text.Eq (t, 'SLICE OF CHAR') OR Text.Eq (t, 'CHAR') OR
         (strUtf AND Text.Eq (t, UtfTy))
END IsStrLit ;

PROCEDURE ConstClear () =
BEGIN
  nconsts := 0 ;
  NxClear (constIx) ;
  nAgg := 0
END ConstClear ;

PROCEDURE ConstAdd (RO KEPT nm: UTF ; RO KEPT ty: UTF ; KEPT val: Ast.Kid) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nconsts = LEN (consts) THEN
    nb := NEW (pool, Binding, 2 * LEN (consts) + 16) ;
    FOR i := 0 TO nconsts - 1 DO nb[i] := consts[i] END ;
    consts := nb
  END ;
  consts[nconsts].name := nm ;
  consts[nconsts].mode := ty ;
  consts[nconsts].ty := val ;     (* the literal: CountValue *)
  (* the first LIVE entry of a name is the one found; the list is cut
     back (nconsts := svConsts) past a procedure's own CONSTs, so an
     entry the index names may be gone *)
  IF ConstAt (nm) < 0 THEN NxSet (constIx, nm, nconsts) END ;
  nconsts := nconsts + 1
END ConstAdd ;

(* the first live entry of nm in consts, or -1 *)
PROCEDURE ConstAt (RO nm: UTF) : I64 =
VAR i : I64 ;
BEGIN
  i := NxFind (constIx, nm) ;
  IF i < 0 OR i >= nconsts THEN RETURN -1 END ;
  IF NOT Text.Eq (consts[i].name, nm) THEN RETURN -1 END ;
  RETURN i
END ConstAt ;

PROCEDURE ConstType (RO nm: UTF ; VAR found: BOOL) : UTF =
VAR i : I64 ;
BEGIN
  found := FALSE ;
  i := ConstAt (nm) ;
  IF i < 0 THEN RETURN '' END ;
  found := TRUE ;
  RETURN consts[i].mode
END ConstType ;

(* is this name, HERE, a constant?  A parameter, a local or a module
   variable of the same name shadows it, as it does in the generated
   C -- the lookup that forgot that typed a parameter named like a
   module CONST as the constant (found 2026-10-01). *)
PROCEDURE IsConstHere (RO nm: UTF) : BOOL =
VAR
  found : BOOL ;
  t : UTF ;
BEGIN
  IF Text.BLen (ScopeMode (nm)) > 0 THEN RETURN FALSE END ;
  t := ConstType (nm, found) ;
  RETURN found
END IsConstHere ;

(* the body of the FORWARD heading beside AdaptLit: a CONST's recorded
   type is its literal's (LitType), so a string literal's is SLICE OF
   CHAR or <str1>; a table or a record CONST is neither *)
PROCEDURE StrConstDesig (k: Ast.Kid) : BOOL =
VAR
  t : UTF ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF e.nkids = 0 THEN
        IF NOT IsConstHere (e.au) THEN RETURN FALSE END ;
        t := ConstType (e.au, found)
      ELSIF e.nkids = 1 THEN
        IF Text.BLen (ScopeMode (e.au)) > 0 THEN RETURN FALSE END ;
        IF e.kids[0] IS SOME sel THEN
          IF sel.kind # Ast.NSelField THEN RETURN FALSE END ;
          t := ModConstType (e.au, sel.au, found)
        ELSE
          RETURN FALSE
        END
      ELSE
        RETURN FALSE
      END ;
      RETURN found AND (Text.Eq (t, 'SLICE OF CHAR') OR Text.Eq (t, '<str1>') OR
                        (strUtf AND Text.Eq (t, UtfTy)))
    END
  END ;
  RETURN FALSE
END StrConstDesig ;

(* ... and a constant TABLE, the value of an aggregate (par 2.2.4) *)
PROCEDURE IsAggConst (RO nm: UTF) : BOOL =
VAR
  found : BOOL ;
  t : UTF ;
BEGIN
  IF Text.BLen (ScopeMode (nm)) > 0 THEN RETURN FALSE END ;
  t := ConstType (nm, found) ;
  RETURN found AND Text.StartsWith (t, 'ARRAY ')
END IsAggConst ;

(* par 2.2.4: what an aggregate CONST must be -- literals of one
   type, at module level, in a module's own part.
     where -- 0 a module's own, 1 exported by a DEFINITION, 2 local
              to a procedure *)
(* a record aggregate in a CONST, alone or as a table's element: every
   field a literal of its field's type, as many as the record has *)
PROCEDURE CheckRecordConst (el: PTR Ast.Node ; RO ctx: UTF ; RO what: UTF) =
VAR
  k, nflat : I64 ;
  om, canon, name, pTy, aTy : UTF ;
  flat : SLICE OF AKid ;
BEGIN
  IF el.kids[0] IS SOME dn THEN
    name := DesigName (dn) ;
    IF RecordNamed (name, om, canon) IS SOME rn THEN
      IF rn.kids[0] IS SOME rbase THEN
        ErrN (el, ctx, S3 (name, ': an aggregate of an extended record is',
          ' not built; give its fields one by one (par 2.2.4)')) ;
        RETURN
      END ;
      flat := FlatFields (rn.kids[1], nflat) ;
      IF el.kids[1] IS SOME al THEN
        Arity (el, ctx, name, nflat, al.nkids) ;
        FOR k := 0 TO al.nkids - 1 DO
          IF al.kids[k] IS SOME a THEN
            IF Text.BLen (AggElemType (al.kids[k])) = 0 THEN
              ErrN (a, ctx, S5 ('field ', ItoA (k + 1), ' of ', what,
                ' is not a literal: a CONST holds literals (par 2.2.4)'))
            ELSIF k < nflat THEN
              canonCtx := Text.Keep (pool, om) ;
              pTy := CanonT (flat[k], 0) ;
              canonCtx := '' ;
              aTy := LitType (al.kids[k]) ;
              IF NOT Compat (pTy, aTy) THEN
                ErrN (a, ctx, S5 ('field ', ItoA (k + 1), ' of ', what,
                  S4 (': cannot give ', TyName (aTy), ' where ',
                      Cat (TyName (pTy), ' is expected'))))
              END
            END
          END
        END
      END
    END
  END
END CheckRecordConst ;

PROCEDURE CheckAggregate (cd: PTR Ast.Node ; RO ctx: UTF ; where: I64) =
VAR
  i, cv : I64 ;
  t0, t : UTF ;
BEGIN
  IF cd.kids[0] IS SOME rc THEN
    IF IsRecordCall (rc) THEN
      IF rc.kids[0] IS SOME rdn THEN
        IF RecordNamed (DesigName (rdn), t0, t) IS SOME rr THEN
          IF where = 1 THEN
            ErrN (cd, ctx, S3 ('a record CONST is not exported yet: ',
              cd.au, ' (par 2.2.4)'))
          ELSIF where = 2 THEN
            ErrN (cd, ctx, S3 ('a record CONST belongs at module level: ',
              cd.au, ' (par 2.2.4)'))
          END ;
          CheckRecordConst (rc, ctx, cd.au)
        END
      END
    END
  END ;
  (* a form the generator cannot emit is refused HERE, by name: a
     generator error after a clean check reads as a compiler fault
     (cp-kernel's issue 1, 2026-10-09) *)
  IF cd.kids[0] IS SOME ce THEN
    IF Text.BLen (LitType (SOME (ce))) = 0 THEN
      ErrN (cd, ctx, S3 ('CONST ', cd.au,
        ': a constant is a literal, a negated number, or + over string and CHAR literals -- compute anything else in a procedure (par 2.2.4)'))
    ELSIF Text.Eq (LitType (SOME (ce)), '<int>') AND IsConstExpr (ce) THEN
      (* folded by the generators with the runtime's arithmetic:
         what the program would raise at run time is refused here *)
      IF NOT Ast.FoldInt (SOME (ce), cv) THEN
        ErrN (cd, ctx, S3 ('CONST ', cd.au,
          ': the expression overflows I64 or divides by zero (par 2.2.4)'))
      ELSIF cv = -9223372036854775807 - 1 THEN
        ErrN (cd, ctx, S3 ('CONST ', cd.au,
          ': the smallest I64 cannot be written as a constant; give it a procedure (par 2.2.4)'))
      END
    END
  END ;
  IF cd.kids[0] IS SOME ag THEN
    IF ag.kind = Ast.NAggregate THEN
      nAgg := nAgg + 1 ;
      IF where = 1 THEN
        ErrN (cd, ctx, S3 ('an aggregate CONST is not exported yet: ',
          cd.au, ' (par 2.2.4)'))
      ELSIF where = 2 THEN
        ErrN (cd, ctx, S3 ('an aggregate CONST belongs at module level: ',
          cd.au, ' (par 2.2.4)'))
      END ;
      t0 := AggElemType (ag.kids[0]) ;
      FOR i := 0 TO ag.nkids - 1 DO
        IF ag.kids[i] IS SOME el THEN
          t := AggElemType (ag.kids[i]) ;
          IF IsRecordCall (el) THEN
            CheckRecordConst (el, ctx, S4 ('element ', ItoA (i + 1), ' of ', cd.au))
          END ;
          IF Text.BLen (t) = 0 AND IsRecordCall (el) THEN
            t := ''                      (* said by CheckRecordConst *)
          ELSIF Text.BLen (t) = 0 THEN
            ErrN (el, ctx, S5 ('element ', ItoA (i + 1), ' of ', cd.au,
              ' is not a literal: an aggregate holds literals (par 2.2.4)'))
          ELSIF Text.BLen (t0) > 0 AND NOT Text.Eq (t, t0) THEN
            ErrN (el, ctx, S5 ('element ', ItoA (i + 1), ' of ', cd.au,
              S5 (' is ', TyName (t), ' where the first is ', TyName (t0),
                  ': an aggregate has one element type (par 2.2.4)')))
          END
        END
      END
    END
  END
END CheckAggregate ;

(* par 2.2.4: a constant table is read-only DATA, so its whole value
   goes only where nothing can write through it -- indexed, under
   LEN, gone over by FOR x IN (a copy of each element), or lent to an
   RO parameter (CallType holds that last one,
   argument by argument).  Anything else that names it bare would
   make an alias: s := Primes, SLICE (Primes, 0, 2), RETURN Primes. *)
PROCEDURE AggWalk (n: PTR Ast.Node ; parent: I64 ; RO ctx: UTF) =
VAR i, first : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids = 0 AND
     parent # Ast.NArgList AND parent # Ast.NForIn THEN
    IF IsAggConst (n.au) THEN
      ErrN (n, ctx, S4 ('the CONST table ', n.au,
        ' can only be indexed, measured with LEN, gone over by FOR IN, or lent to an RO',
        ' parameter (par 2.2.4)'))
    END
  END ;
  first := 0 ;
  (* the left side of an assignment is CheckWrite's to refuse *)
  IF n.kind = Ast.NAssign THEN
    IF n.kids[0] IS SOME lhs THEN
      IF lhs.nkids = 0 THEN first := 1 END
    END
  END ;
  FOR i := first TO n.nkids - 1 DO
    IF n.kids[i] IS SOME k THEN AggWalk (k, n.kind, ctx) END
  END
END AggWalk ;

(* one argument that names a constant: it cannot be a VAR or OWN
   argument (there is nothing to write), and a constant table goes
   only to an RO parameter (par 2.2.4) *)
PROCEDURE ConstArg (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                    k: I64 ; an: Ast.Kid ; isVar: BOOL ; isRo: BOOL) =
BEGIN
  IF an IS SOME a THEN
    IF a.kind = Ast.NDesignator THEN
      IF IsConstHere (a.au) THEN
        IF isVar THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': the CONST ', a.au,
                ' cannot be passed to a VAR or OWN parameter')))
        ELSIF a.nkids = 0 AND NOT isRo AND IsAggConst (a.au) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': the CONST table ', a.au,
                ' can be lent only to an RO parameter (par 2.2.4)')))
        END
      END
    END
  END
END ConstArg ;

(* par 2.4: read-only storage -- a string literal, what an RO
   parameter views, a CONST -- is lent only to an RO parameter.  A
   by-value SLICE or GRID parameter can be written through, and
   `Up ('abc')` with `s[0] := 'X'` inside was accepted and died with
   SIGSEGV until 2026-10-01 (museum/write-through-literal.m9).  The
   caller has established that the parameter is neither VAR, OWN nor
   RO. *)
(* the name of the RO FIELD a designator ENDS at (`r.s' with `RO s:
   STR' in r's record), resolved as CheckWrite resolves a write --
   through pointers, fields, elements -- and '' when it ends elsewhere
   or the way is unknown.  An RO field holds a view of storage someone
   else owns (par 2.4): what it is copied into may not be written
   through. *)
PROCEDURE RoFieldOf (d: PTR Ast.Node) : UTF =
VAR
  j : I64 ;
  declN, res : Ast.Kid ;
  tmod : UTF ;
  deref : BOOL ;
BEGIN
  IF d.nkids = 0 THEN RETURN '' END ;
  tmod := '' ;
  declN := ScopeType (d.au) ;
  FOR j := 0 TO d.nkids - 1 DO
    IF declN IS SOME dn0 THEN
      NoteMod (declN, tmod) ;
      res := ResolveType (declN) ;
      LOOP
        deref := FALSE ;
        IF res IS SOME r0 THEN
          IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
            deref := TRUE ;
            declN := InMod (r0.kids[0], tmod) ;
            NoteMod (declN, tmod) ;
            res := ResolveType (declN)
          END
        END ;
        IF NOT deref THEN EXIT END
      END ;
      IF res IS SOME r THEN
        IF d.kids[j] IS SOME sel THEN
          IF sel.kind = Ast.NSelField THEN
            IF r.kind = Ast.NRecordType THEN
              IF j = d.nkids - 1 AND FieldROOf (r, sel.au) THEN RETURN sel.au END ;
              declN := InMod (FieldTypeOf (r, sel.au), tmod)
            ELSE
              RETURN ''
            END
          ELSIF sel.kind = Ast.NSelIndex THEN
            IF r.kind = Ast.NGridType THEN declN := InMod (r.kids[1], tmod)
            ELSIF r.kind = Ast.NSliceType THEN declN := InMod (r.kids[0], tmod)
            ELSIF r.kind = Ast.NArrayType THEN declN := InMod (r.kids[1], tmod)
            ELSE RETURN '' END
          END
        END
      ELSE
        RETURN ''
      END
    ELSE
      RETURN ''
    END
  END ;
  RETURN ''
END RoFieldOf ;

(* `the RO answer of F' when call E names a procedure whose result is
   declared RO, else '' *)
PROCEDURE RoAnswerOf (e: PTR Ast.Node) : UTF =
VAR
  name : UTF ;
  found : BOOL ;
  pr : ProcInfo ;
BEGIN
  IF Text.Eq (UtfBuiltin (e), 'OCTETS') THEN RETURN 'the octets of a UTF (OCTETS)' END ;
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator THEN
      name := DesigName (dn) ;
      pr := LookupProc (name, found) ;
      IF found THEN
        IF pr.node IS SOME pn THEN
          IF pn.f3 THEN RETURN Cat ('the RO answer of ', name) END ;
          IF Text.BLen (pr.foreign) = 0 THEN
            IF AnswersRo (Qualify (pr.modName, pr.name), pr) THEN
              RETURN S3 ('the answer of ', name,
                         ', which may be read-only storage (a literal, a CONST or a view of an RO parameter)')
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END RoAnswerOf ;

(* par 2.4, the copy: is the value of expression K read-only storage
   -- a string literal, what an RO parameter or an RO variable views,
   a CONST, or a name that was itself given such storage -- seen
   through SLICE, VIEW and parentheses?  Answers what it is, or ''. *)
PROCEDURE RoWhatOf (k: Ast.Kid) : UTF =
VAR
  r : UTF ;
  i : I64 ;
BEGIN
  IF k IS SOME e THEN
    (* the empty literal holds no storage: nothing can be written
       through a slice of length 0, and `buf := ''' is how a STR is
       given a known start (Xml.CharData, the one site measured) *)
    IF e.kind = Ast.NString THEN
      IF Text.BLen (e.au) = 0 THEN RETURN '' END ;
      RETURN 'a string literal'
    END ;
    IF e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf THEN
      RETURN RoWhatOf (e.kids[0])
    END ;
    (* the answer of a function declared `: RO T' is read-only storage
       lent onward (the report's `PROCEDURE G () : RO STR') *)
    IF e.kind = Ast.NCallExpr THEN RETURN RoAnswerOf (e) END ;
    IF e.kind = Ast.NDesignator AND e.nkids > 0 THEN
      r := RoFieldOf (e) ;
      IF Text.BLen (r) > 0 THEN RETURN Cat ('the RO field ', r) END
    END ;
    r := EscRootOf (k) ;
    IF Text.BLen (r) = 0 THEN RETURN '' END ;
    IF Text.Eq (ScopeMode (r), ModeRo) THEN
      RETURN Cat ('the RO parameter ', r)
    END ;
    IF ScopeRo (r) THEN RETURN Cat ('the RO variable ', r) END ;
    i := ScopeFind (r) ;
    IF i >= 0 THEN
      IF Text.BLen (scope[i].roFrom) > 0 THEN RETURN scope[i].roFrom END
    END ;
    IF IsConstHere (r) THEN RETURN Cat ('the CONST ', r) END
  END ;
  RETURN ''
END RoWhatOf ;

(* one pass over the assignments under K: a bare local or parameter
   of slice or grid type given read-only storage is marked with what
   it holds and where.  Answers whether a mark was added, so that
   `t := s ; u := t' settles in a second pass. *)
PROCEDURE RoSeedWalk (k: Ast.Kid) : BOOL =
VAR
  i, j : I64 ;
  changed : BOOL ;
  what, m, ty : UTF ;
BEGIN
  changed := FALSE ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids = 0 THEN
          i := ScopeFind (lhs.au) ;
          IF i >= 0 THEN
            IF Text.BLen (scope[i].roFrom) = 0 THEN
              m := scope[i].mode ;
              IF Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeVal) OR
                 Text.Eq (m, ModeVar) OR Text.Eq (m, ModeOwn) OR
                 Text.Eq (m, ModeModule) THEN
                ty := CanonT (scope[i].ty, 0) ;
                (* a record or pointer that holds a reference copies
                   the VIEW: `t := r' with r an RO record parameter,
                   then `t.s[0] := 'X'' (2026-10-08, the last of
                   decision 33's named gaps) *)
                IF Text.StartsWith (ty, 'SLICE OF') OR
                   Text.StartsWith (ty, 'GRID ') OR
                   PtrBearing (scope[i].ty, 0) THEN
                  what := RoWhatOf (e.kids[1]) ;
                  IF Text.BLen (what) > 0 THEN
                    scope[i].roFrom := Text.Keep (pool, what) ;
                    scope[i].roLine := e.line ;
                    changed := TRUE
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR j := 0 TO e.nkids - 1 DO
      IF RoSeedWalk (e.kids[j]) THEN changed := TRUE END
    END
  END ;
  RETURN changed
END RoSeedWalk ;

(* ---- par 2.4, the copy, for MODULE VARIABLES (2026-10-08, the same
   day's second half).  RoSeed reads one procedure; a module variable
   given a literal in Init and written through in Up is two
   procedures.  Before the bodies, every assignment in the unit --
   each procedure's and the module body's -- whose left side is a bare
   module variable of slice or grid type, not shadowed by the
   enclosing procedure's own declarations, and whose right side is a
   string literal, a CONST, a marked module variable or a SLICE of one
   is recorded here; AddVarsOf hands the mark to every scope the
   variable enters.  What an RO parameter views needs that procedure's
   scope and is marked by RoSeedWalk for that procedure alone. ---- *)
PROCEDURE MroFind (RO nm: UTF) : I64 =
BEGIN
  RETURN NxFind (mroIx, nm)
END MroFind ;

PROCEDURE MroAdd (RO KEPT nm: UTF ; RO KEPT what: UTF ; line: I64) =
VAR
  ns, nf : SLICE OF UTF ;
  nl : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF nmro = LEN (mroName) THEN
    ns := NEW (pool, UTF, 2 * LEN (mroName) + 16) ;
    nf := NEW (pool, UTF, 2 * LEN (mroName) + 16) ;
    nl := NEW (pool, I64, 2 * LEN (mroName) + 16) ;
    FOR i := 0 TO nmro - 1 DO
      ns[i] := mroName[i] ; nf[i] := mroFrom[i] ; nl[i] := mroLine[i]
    END ;
    mroName := ns ; mroFrom := nf ; mroLine := nl
  END ;
  mroName[nmro] := nm ;
  mroFrom[nmro] := what ;
  mroLine[nmro] := line ;
  NxAdd (mroIx, nm, nmro) ;
  nmro := nmro + 1
END MroAdd ;

(* the module variables of unit u (and of its definition): name and
   declared type *)
PROCEDURE ModVarType (root: PTR Ast.Node ; u: PTR Ast.Node ; RO nm: UTF) : Ast.Kid =
VAR
  i, a, b, c, q : I64 ;
BEGIN
  (* the unit's variables indexed once per file and unit, the first of
     a name kept: a walk per assignment was n squared in a module's
     variables (the review's F5) *)
  IF root.id # mvtRoot OR NOT Text.Eq (u.au, mvtUnit) THEN
    mvtRoot := root.id ;
    mvtUnit := Text.Keep (pool, u.au) ;
    NxClear (mvtIx) ;
    FOR i := 0 TO root.nkids - 1 DO
      IF root.kids[i] IS SOME un2 THEN
        IF Text.Eq (un2.au, u.au) THEN
          FOR a := 0 TO un2.nkids - 1 DO
            IF un2.kids[a] IS SOME sect2 THEN
              IF sect2.kind = Ast.NVarSection THEN
                FOR b := 0 TO sect2.nkids - 1 DO
                  IF sect2.kids[b] IS SOME vd2 THEN
                    IF vd2.kids[0] IS SOME ids2 THEN
                      FOR c := 0 TO ids2.nkids - 1 DO
                        IF ids2.kids[c] IS SOME id2 THEN
                          IF NxFind (mvtIx, id2.au) < 0 THEN
                            (* where the declaration is, not the node:
                               the tree is the caller's.  2^20 kids of
                               a unit and 2^22 declarations in one
                               section: a source past either is over a
                               gigabyte *)
                            NxAdd (mvtIx, Text.Keep (pool, id2.au),
                                   (i * 1048576 + a) * 4194304 + b)
                          END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  q := NxFind (mvtIx, nm) ;
  IF q < 0 THEN RETURN NONE END ;
  i := q DIV (1048576 * 4194304) ;
  a := (q DIV 4194304) MOD 1048576 ;
  b := q MOD 4194304 ;
  IF root.kids[i] IS SOME un THEN
    IF un.kids[a] IS SOME sect THEN
      IF sect.kids[b] IS SOME vd THEN RETURN vd.kids[1] END
    END
  END ;
  RETURN NONE
END ModVarType ;

(* read-only storage with no procedure scope to ask: a literal, a
   module CONST, a marked module variable, a SLICE of one *)
PROCEDURE ModRoWhat (k: Ast.Kid ; scope: Ast.Kid) : UTF =
VAR
  r : UTF ;
  i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NString THEN
      IF Text.BLen (e.au) = 0 THEN RETURN '' END ;
      RETURN 'a string literal'
    END ;
    IF e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf THEN
      RETURN ModRoWhat (e.kids[0], scope)
    END ;
    IF e.kind = Ast.NCallExpr THEN RETURN RoAnswerOf (e) END ;
    r := EscRootOf (k) ;
    IF Text.BLen (r) = 0 THEN RETURN '' END ;
    IF ProcDeclares (scope, r) THEN RETURN '' END ;
    i := MroFind (r) ;
    IF i >= 0 THEN RETURN mroFrom[i] END ;
    IF IsConstHere (r) THEN RETURN Cat ('the CONST ', r) END
  END ;
  RETURN ''
END ModRoWhat ;

PROCEDURE ModRoWalk (root: PTR Ast.Node ; u: PTR Ast.Node ; scope: Ast.Kid ;
                     k: Ast.Kid) : BOOL =
VAR
  j : I64 ;
  changed : BOOL ;
  what, ty : UTF ;
BEGIN
  changed := FALSE ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids = 0 THEN
          IF MroFind (lhs.au) < 0 AND NOT ProcDeclares (scope, lhs.au) THEN
            ty := CanonT (ModVarType (root, u, lhs.au), 0) ;
            IF Text.StartsWith (ty, 'SLICE OF') OR Text.StartsWith (ty, 'GRID ') THEN
              what := ModRoWhat (e.kids[1], scope) ;
              IF Text.BLen (what) > 0 THEN
                MroAdd (lhs.au, Text.Keep (pool, what), e.line) ;
                changed := TRUE
              END
            END
          END
        END
      END
    END ;
    FOR j := 0 TO e.nkids - 1 DO
      IF e.kind = Ast.NProcDecl OR e.kind = Ast.NModBody THEN
        IF ModRoWalk (root, u, k, e.kids[j]) THEN changed := TRUE END
      ELSE
        IF ModRoWalk (root, u, scope, e.kids[j]) THEN changed := TRUE END
      END
    END
  END ;
  RETURN changed
END ModRoWalk ;

PROCEDURE ModRoSeed (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR n : I64 ;
BEGIN
  nmro := 0 ;
  NxClear (mroIx) ;
  IF LEN (mroName) = 0 THEN
    mroName := NEW (pool, UTF, 16) ;
    mroFrom := NEW (pool, UTF, 16) ;
    mroLine := NEW (pool, I64, 16)
  END ;
  n := 0 ;
  WHILE ModRoWalk (root, u, NONE, SOME (u)) AND n < 8 DO n := n + 1 END
END ModRoSeed ;

(* A FIELD of a record copy given storage that is not read-only --
   `d := c ; d.defs := NEW (pool, TermDef, n) ; d.defs[i] := ...'
   (Rdf.CopyCtx) -- is REFRESHED: a write that lands beyond the copy
   through that field writes the fresh storage, not the view the copy
   took.  Recorded as the path `d.defs' (every selector a field); like
   the mark itself, for the whole procedure and not flow-sensitive. *)
PROCEDURE RoFreshWalk (k: Ast.Kid) =
VAR
  i, j : I64 ;
  p : UTF ;
  nf : SLICE OF UTF ;
  fields : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids > 0 AND
           Text.BLen (ScopeRoFrom (lhs.au)) > 0 THEN
          fields := TRUE ;
          FOR j := 0 TO lhs.nkids - 1 DO
            IF lhs.kids[j] IS SOME sel THEN
              IF sel.kind # Ast.NSelField THEN fields := FALSE END
            END
          END ;
          IF fields AND Text.BLen (RoWhatOf (e.kids[1])) = 0 THEN
            p := DesigPath (lhs) ;
            IF nroFresh = LEN (roFresh) THEN
              nf := NEW (pool, UTF, 2 * nroFresh) ;
              FOR i := 0 TO nroFresh - 1 DO nf[i] := roFresh[i] END ;
              roFresh := nf
            END ;
            roFresh[nroFresh] := Text.Keep (pool, p) ;
            nroFresh := nroFresh + 1
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RoFreshWalk (e.kids[i]) END
  END
END RoFreshWalk ;

(* DISPOSE frees only a name that may OWN what it holds (2026-10-10;
   `r := b.p ; DISPOSE (r) ; DISPOSE (b.p)' freed one object twice and
   both checkers accepted it).  A local is owner-fed when some
   assignment in the procedure gives it NEW (OWN, T), SHARED (x), a
   call's answer (soft: the callee is not read) or a bare name that is
   an OWN parameter, a SHARED handle or owner-fed itself; a field, a
   copy of a field, a pool or frame allocation is not.  Flow-
   insensitive, like the RO marks. *)
PROCEDURE OwnFedHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nownFed - 1 DO
    IF Text.Eq (ownFed[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END OwnFedHas ;

PROCEDURE OwnerName (RO nm: UTF) : BOOL =
BEGIN
  IF Text.Eq (ScopeMode (nm), ModeOwn) THEN RETURN TRUE END ;
  IF OwnedCandKind (nm) = 2 THEN RETURN TRUE END ;
  RETURN OwnFedHas (nm)
END OwnerName ;

PROCEDURE PtrBearing (t: Ast.Kid ; depth: I64) : BOOL ;

(* is the callee DN a procedure value (par 2.2.3) -- a parameter or an
   IS SOME binder whose type is a procedure type, as CallType reads it?
   0 when it is not; 1 when no parameter of the type can carry a
   reference, so its answer cannot be one of its arguments; 2 when one
   can.  The parameter types are read in the module that declared the
   procedure type (canonCtx) *)
PROCEDURE ProcValKind (dn: PTR Ast.Node) : I64 =
VAR
  si, g, r : I64 ;
  was : UTF ;
BEGIN
  IF dn.nkids > 0 THEN RETURN 0 END ;
  si := ScopeFind (dn.au) ;
  IF si < 0 THEN RETURN 0 END ;
  r := 0 ;
  IF ResolveType (scope[si].ty) IS SOME ptn THEN
    IF ptn.kind = Ast.NProcType THEN
      r := 1 ;
      was := canonCtx ;
      IF resolvedIn >= 0 THEN canonCtx := Text.Keep (pool, mods[resolvedIn].name) END ;
      IF ptn.kids[0] IS SOME pl THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF PtrBearing (grp.kids[1], 0) THEN r := 2 END
          END
        END
      END ;
      canonCtx := was
    END
  END ;
  RETURN r
END ProcValKind ;

(* a name that cannot own what it points to: DISPOSE's refusal (par
   4.2), asked by every operation that consumes an owner -- an OWN
   argument, SHARED (x), THREAD into an OWN parameter.  Until 2026-10-28
   only DISPOSE asked it, and `r := Id (q) ; Eat (r)' freed what q held *)
PROCEDURE OwnsNothing (RO nm: UTF) : BOOL =
BEGIN
  RETURN (Text.Eq (ScopeMode (nm), ModeLocal) OR
          (ownModule AND Text.Eq (ScopeMode (nm), ModeModule))) AND
         OwnedCandKind (nm) = 1 AND
         NOT FvalHas (nm) AND NOT OwnFedHas (nm)
END OwnsNothing ;

PROCEDURE OwnFedBy (k: Ast.Kid) : BOOL =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  pvk : I64 ;
BEGIN
  IF k IS SOME r0 THEN
    IF r0.kind = Ast.NParen THEN RETURN OwnFedBy (r0.kids[0]) END
  END ;
  IF k IS SOME r THEN
    IF r.kind = Ast.NNewExpr THEN
      IF r.kids[0] IS SOME d THEN
        RETURN d.kind = Ast.NDesignator AND d.nkids = 0 AND Text.Eq (d.au, 'OWN')
      END
    ELSIF r.kind = Ast.NSharedExpr THEN
      RETURN TRUE
    ELSIF r.kind = Ast.NCallExpr THEN
      (* a call's answer owns, unless the callee answers what it was
         lent (AnswersBorrowAny); a foreign callee is taken at its word,
         as before.  A procedure value's body is not known, so it is
         judged by the region walk's sound default: its answer may be
         any argument a parameter can carry, and owns only when none
         can carry a reference (2026-10-28: `p := fn (h) ; DISPOSE (p)'
         freed what h's field still held) *)
      IF r.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pvk := ProcValKind (dn) ;
          IF pvk > 0 THEN RETURN pvk = 1 END ;
          pr := LookupProc (DesigName (dn), found) ;
          IF found AND Text.BLen (pr.foreign) = 0 THEN
            RETURN NOT AnswersBorrowAny (Qualify (pr.modName, pr.name), pr)
          END
        END
      END ;
      RETURN TRUE
    ELSIF r.kind = Ast.NDesignator AND r.nkids = 0 THEN
      RETURN OwnerName (r.au)
    END
  END ;
  RETURN FALSE
END OwnFedBy ;

PROCEDURE OwnFedWalk (k: Ast.Kid) : BOOL =
VAR
  i : I64 ;
  nf : SLICE OF UTF ;
  changed : BOOL ;
BEGIN
  changed := FALSE ;
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND lhs.nkids = 0 THEN
          IF NOT OwnFedHas (lhs.au) AND OwnFedBy (e.kids[1]) THEN
            IF nownFed = LEN (ownFed) THEN
              nf := NEW (pool, UTF, 2 * nownFed + 16) ;
              FOR i := 0 TO nownFed - 1 DO nf[i] := ownFed[i] END ;
              ownFed := nf
            END ;
            ownFed[nownFed] := Text.Keep (pool, lhs.au) ;
            nownFed := nownFed + 1 ;
            changed := TRUE
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF OwnFedWalk (e.kids[i]) THEN changed := TRUE END
    END
  END ;
  RETURN changed
END OwnFedWalk ;

PROCEDURE OwnFedSeed (k: Ast.Kid) =
VAR n : I64 ;
BEGIN
  nownFed := 0 ;
  n := 0 ;
  WHILE OwnFedWalk (k) AND n < 16 DO n := n + 1 END
END OwnFedSeed ;

(* does the designator write through a refreshed field (RoFreshWalk)?
   `d.defs[i]' and `d.defs.x' are, `d.other[i]' is not. *)
PROCEDURE RoRefreshed (d: PTR Ast.Node) : BOOL =
VAR
  i : I64 ;
  p, f : UTF ;
BEGIN
  p := DesigPath (d) ;
  FOR i := 0 TO nroFresh - 1 DO
    f := roFresh[i] ;
    IF Text.StartsWith (p, f) THEN
      IF Text.BLen (p) = Text.BLen (f) OR B (p, Text.BLen (f)) = ORD ('.') OR B (p, Text.BLen (f)) = ORD ('[') THEN
        RETURN TRUE
      END
    END
  END ;
  RETURN FALSE
END RoRefreshed ;

(* par 2.4, the copy (2026-10-08): a local or parameter of slice or
   grid type that an assignment anywhere in the procedure gives
   read-only storage holds it for the whole procedure -- a write
   through the name and a lend of it to a writable parameter are
   refused by CheckWrite and RoArg, naming the storage and the
   assignment's line.  Whole-procedure and not flow-sensitive, as RO
   itself is a property of a declaration: `t := s ; t[0] := 'X'' with
   s read-only was accepted and, for a literal, died with SIGSEGV
   until then (museum/write-through-copy.m9).  Not followed: a
   module variable (its assignments are in other procedures), a
   record holding a slice, a call that answers a view without RO. *)
PROCEDURE RoSeed (k: Ast.Kid) =
VAR n : I64 ;
BEGIN
  n := 0 ;
  nroFresh := 0 ;
  IF LEN (roFresh) = 0 THEN roFresh := NEW (pool, UTF, 32) END ;
  WHILE RoSeedWalk (k) AND n < 8 DO n := n + 1 END ;
  RoFreshWalk (k)
END RoSeed ;


(* the read-only storage argument an is, handed to a parameter of type
   pTy that is not RO; '' when it is none *)
PROCEDURE RoWhatArg (an: Ast.Kid ; RO pTy: UTF ; RO aTy: UTF) : UTF =
VAR what : UTF ;
BEGIN
  what := '' ;
  (* nothing writes through a UTF -- it has no subscript -- so read-only
     storage may be lent to any UTF parameter *)
  IF Text.Eq (pTy, UtfTy) THEN RETURN '' END ;
  IF Text.StartsWith (pTy, 'SLICE OF') OR Text.StartsWith (pTy, 'GRID ') THEN
    IF an IS SOME a THEN
      IF a.kind = Ast.NString THEN
        what := 'a string literal'
      ELSIF a.kind = Ast.NDesignator AND
            (Text.StartsWith (aTy, 'SLICE OF') OR
             Text.StartsWith (aTy, 'GRID ') OR Text.Eq (aTy, '<str1>')) THEN
        IF Text.Eq (ScopeMode (a.au), ModeRo) THEN
          what := Cat ('the RO parameter ', a.au)
        ELSIF ScopeRo (a.au) THEN
          what := Cat ('the RO variable ', a.au)
        ELSIF Text.BLen (ScopeRoFrom (a.au)) > 0 THEN
          what := Cat (a.au, Cat (', which holds ', Cat (ScopeRoFrom (a.au), ',')))
        ELSIF IsConstHere (a.au) THEN
          what := Cat ('the CONST ', a.au)
        ELSIF Text.BLen (RoFieldOf (a)) > 0 THEN
          (* an RO field lent onward (decision 21's gap, 2026-10-08) *)
          what := Cat ('the RO field ', RoFieldOf (a))
        END
      ELSIF a.kind = Ast.NCallExpr AND
            (Text.StartsWith (aTy, 'SLICE OF') OR
             Text.StartsWith (aTy, 'GRID ')) THEN
        (* the answer of a function declared `: RO T', lent onward *)
        what := RoAnswerOf (a)
      END
    END
  END ;
  RETURN what
END RoWhatArg ;

PROCEDURE RoArg (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                 k: I64 ; an: Ast.Kid ; RO pTy: UTF ; RO aTy: UTF) =
VAR what : UTF ;
BEGIN
  what := RoWhatArg (an, pTy, aTy) ;
  IF Text.BLen (what) > 0 THEN
    ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
      S3 (': ', what, ' can be lent only to an RO parameter (par 2.4)')))
  END
END RoArg ;

PROCEDURE ExprType (k: Ast.Kid ; RO ctx: UTF) : UTF ;
PROCEDURE CallType (dn: Ast.Kid ; argl: Ast.Kid ; site: PTR Ast.Node ;
                    RO ctx: UTF) : UTF ;

(* a designator as an expression: scope names, module CONSTs, the
   payload-less variant constructor Type.Variant, and ALL *)
PROCEDURE DesigStrType (d: PTR Ast.Node ; guard: BOOL ; RO ctx: UTF) : UTF =
VAR
  s, it, om : UTF ;
  j, m : I64 ;
  found : BOOL ;
  vi : VariantInfo ;
  vfields : Ast.Kid ;
BEGIN
  IF ScopeType (d.au) IS SOME dn0 THEN
    RETURN CanonT (DesigDeclType (d, ctx), 0)
  END ;
  (* ALL is a predeclared identifier, not a keyword -- the STR
     precedent.  It has a type of its own so that using it anywhere
     but a VIEW axis is a type error naming ALL. *)
  IF Text.Eq (d.au, 'ALL') AND d.nkids = 0 THEN RETURN '<all>' END ;
  (* HEAP, the same way: a predeclared POOL that outlives the
     program's frames and is never freed.  Named rather than
     implicit, so `PTR T IN HEAP` still says which pool, and so a
     program that must not grow can grep for it (par 4.3). *)
  IF Text.Eq (d.au, 'HEAP') AND d.nkids = 0 THEN RETURN 'POOL' END ;
  s := ConstType (d.au, found) ;
  IF found AND Text.BLen (ScopeMode (d.au)) = 0 THEN
    FOR j := 0 TO d.nkids - 1 DO
      IF d.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelIndex THEN
          it := ExprType (sel.kids[0], ctx) ;
          IF NOT IsIntish (it) THEN
            ErrN (d, ctx, Cat ('index must be an integer, not ',
              TyName (it)))
          END ;
          IF Text.Eq (s, 'SLICE OF CHAR') THEN s := 'CHAR'
          ELSIF Text.Eq (s, UtfTy) THEN
            (* a string CONST under the rehearsed switch: it was typed
               unknown here and the generator read octets as characters
               (Fmt.Hex, 2026-10-24) *)
            ErrN (d, ctx, Cat (d.au,
              ': a UTF has no subscript -- Text.BAt (u, i) for the byte at offset i, Text.CpAt (u, x) or FOR c IN u for a character')) ;
            s := ''
          ELSIF Text.StartsWith (s, 'ARRAY ') THEN s := AfterOf (s)
          ELSE s := '' END
        ELSIF sel.kind = Ast.NSelField THEN
          (* a field of a record CONST, or of a table's record element *)
          s := ConstFieldType (s, sel.au)
        ELSE
          s := ''
        END
      END
    END ;
    RETURN s
  END ;
  (* Type.Variant with no payload is a value of that variant type *)
  IF d.nkids = 1 THEN
    IF d.kids[0] IS SOME sf THEN
      IF sf.kind = Ast.NSelField THEN
        om := VariantOwnerOf (d.au, sf.au, found) ;
        IF found THEN RETURN Qualify (om, d.au) END ;
        (* an imported CONST is still a literal *)
        s := ModConstType (d.au, sf.au, found) ;
        IF found THEN RETURN s END
      END
    END
  END ;
  (* Mod.Type.Variant with no payload: the cross-module twin of the
     two-part form above, Palette.Hue.Warm.  d.au is a module name (not
     in scope, or the first branch would have answered), the first
     selector its enumeration or case-record type, the second a member.
     Typing it is what lets FOR over an imported enumeration reach the
     enum branch instead of falling through to the integer path
     (docs/enum-plan.md, part 2). *)
  IF d.nkids = 2 THEN
    IF d.kids[0] IS SOME sfT THEN
      IF d.kids[1] IS SOME sfV THEN
        IF sfT.kind = Ast.NSelField AND sfV.kind = Ast.NSelField THEN
          IF TryVariantMod (FindMod (d.au), sfT.au, sfV.au, om, vfields) THEN
            RETURN Qualify (om, sfT.au)
          END
        END
      END
    END
  END ;
  RETURN CanonT (DesigDeclType (d, ctx), 0)
END DesigStrType ;

PROCEDURE NumSide (RO s: UTF) : BOOL =
BEGIN
  RETURN IsNumStr (s)
END NumSide ;

PROCEDURE StrSide (RO s: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (s, 'SLICE OF CHAR') OR Text.Eq (s, '<str1>')
END StrSide ;

PROCEDURE IsComposite (RO t: UTF) : BOOL ;

PROCEDURE BinType (e: PTR Ast.Node ; RO ctx: UTF) : UTF =
VAR lt, rt, op : UTF ;
BEGIN
  op := e.au ;
  lt := ExprType (e.kids[0], ctx) ;
  rt := ExprType (e.kids[1], ctx) ;
  IF Text.Eq (op, 'AND') OR Text.Eq (op, 'OR') THEN
    IF Text.BLen (lt) > 0 AND NOT Text.Eq (lt, 'BOOL') THEN
      ErrN (e, ctx, S3 (op, ' needs BOOL operands, not ', TyName (lt)))
    END ;
    IF Text.BLen (rt) > 0 AND NOT Text.Eq (rt, 'BOOL') THEN
      ErrN (e, ctx, S3 (op, ' needs BOOL operands, not ', TyName (rt)))
    END ;
    RETURN 'BOOL'
  END ;
  IF Text.Eq (op, '=') OR Text.Eq (op, '#') OR Text.Eq (op, '<') OR
     Text.Eq (op, '<=') OR Text.Eq (op, '>') OR Text.Eq (op, '>=') THEN
    IF Text.Eq (lt, '<void>') OR Text.Eq (rt, '<void>') THEN
      ErrN (e, ctx, 'comparing a call that returns no value')
    ELSIF IsNanLit (e.kids[0]) OR IsNanLit (e.kids[1]) THEN
      (* NaN compares unequal to everything, itself included: `x =
         NaN' is never TRUE and `x # NaN' always is -- the comparison
         a reader takes for a test and the machine does not *)
      ErrN (e, ctx, S5 ("no '", op, "' with NaN: no comparison with NaN is",
        " ever TRUE, except '#', which always is; Math.IsNaN (x) asks",
        ' (par 2.1)'))
    ELSE
      Agree (StOperand, lt, rt, e.line) ;
      IF NOT (Compat (lt, rt) OR Compat (rt, lt)) THEN
        ErrN (e, ctx, S4 ('cannot compare ', TyName (lt), ' with ',
          TyName (rt)))
      (* an operator compares SCALARS.  Two strings, two arrays, two
         records agree in type and were let through to a C that has
         no == for a struct: `IF name = 'cancel'` was the C
         compiler's to refuse until 2026-10-02 (par 2.3). *)
      ELSIF StrSide (lt) AND StrSide (rt) AND
            (Text.Eq (lt, 'SLICE OF CHAR') OR
             Text.Eq (rt, 'SLICE OF CHAR')) OR
            Text.Eq (lt, UtfTy) OR Text.Eq (rt, UtfTy) THEN
        ErrN (e, ctx, S5 ("no '", op, "' between two strings: Text.Eq",
          ' (a, b) answers equality, and no operator orders them',
          ' (par 2.3)'))
      ELSIF IsComposite (lt) THEN
        ErrN (e, ctx, S5 ("no '", op, "' between two values of type ",
          TyName (lt), Cat (': an operator compares numbers, characters,',
          ' booleans, enumeration values and pointers (par 2.3)')))
      ELSIF IsComposite (rt) THEN
        ErrN (e, ctx, S5 ("no '", op, "' between two values of type ",
          TyName (rt), Cat (': an operator compares numbers, characters,',
          ' booleans, enumeration values and pointers (par 2.3)')))
      END
    END ;
    RETURN 'BOOL'
  END ;
  (* string concatenation, before the arithmetic rules: `+` on two
     strings answers a string, allocated in HEAP (par 4.3).  A CHAR
     on either side is one code point appended or prepended -- a
     CHAR converts to nothing implicitly, so there is nothing for
     `s + c` to decide silently (the rule used to refuse it, on a
     Pascal/C worry M9 does not have; revised 2026-09-06).  Anything
     else -- a number, a record -- must be formatted first. *)
  (* a UTF concatenates with a UTF, a CHAR (its encoding appended) or a
     string literal (which adapts); a STR does not join a UTF *)
  IF Text.Eq (op, '+') AND (Text.Eq (lt, UtfTy) OR Text.Eq (rt, UtfTy)) THEN
    IF NOT (Text.Eq (lt, UtfTy) OR Text.Eq (lt, 'CHAR') OR IsStringLit (e.kids[0])
            OR StrConstDesig (e.kids[0])) THEN
      ErrN (e, ctx, S3 ('cannot concatenate ', TyName (lt),
        ' with a UTF -- UTF (s) converts a STR'))
    ELSIF NOT (Text.Eq (rt, UtfTy) OR Text.Eq (rt, 'CHAR') OR IsStringLit (e.kids[1])
               OR StrConstDesig (e.kids[1])) THEN
      ErrN (e, ctx, S3 ('cannot concatenate a UTF with ', TyName (rt),
        ' -- UTF (s) converts a STR'))
    END ;
    RETURN UtfTy
  END ;
  IF Text.Eq (op, '+') AND (StrSide (lt) OR StrSide (rt)) THEN
    IF NOT (StrSide (lt) OR Text.Eq (lt, 'CHAR')) THEN
      ErrN (e, ctx, S3 ('cannot concatenate ', TyName (lt),
        ' with a string'))
    ELSE
      IF NOT (StrSide (rt) OR Text.Eq (rt, 'CHAR')) THEN
        ErrN (e, ctx, S3 ('cannot concatenate a string with ',
          TyName (rt), ''))
      END
    END ;
    RETURN StrLitTy ()
  END ;
  (* arithmetic: + - * / DIV MOD and the wrapping three *)
  IF Text.Eq (lt, 'BYTE') OR Text.Eq (rt, 'BYTE') THEN
    ErrN (e, ctx,
      'BYTE is a raw octet: no arithmetic (convert first, par 2.1)') ;
    RETURN ''
  END ;
  IF NOT NumSide (lt) THEN
    ErrN (e, ctx, S3 (op, ' needs numeric operands, not ', TyName (lt)))
  ELSE
    IF NOT NumSide (rt) THEN
      ErrN (e, ctx, S3 (op, ' needs numeric operands, not ', TyName (rt)))
    ELSE
      Agree (StOperand, lt, rt, e.line) ;
      IF NOT (Compat (lt, rt) OR Compat (rt, lt)) THEN
        ErrN (e, ctx, S5 ('no implicit conversions: ', TyName (lt), ' ',
          op, Cat (' ', TyName (rt))))
      END
    END
  END ;
  IF Text.Eq (op, '/') THEN
    IF IsIntStr (lt) OR Text.Eq (lt, '<int>') OR
       IsIntStr (rt) OR Text.Eq (rt, '<int>') THEN
      ErrN (e, ctx, "'/' is float division; integers use DIV")
    END
  ELSIF Text.Eq (op, 'DIV') OR Text.Eq (op, 'MOD') THEN
    IF IsFloatStr (lt) OR Text.Eq (lt, '<real>') OR
       IsFloatStr (rt) OR Text.Eq (rt, '<real>') THEN
      ErrN (e, ctx, S3 (op, ' is integer division; floats use ', "'/'"))
    END
  ELSIF Text.Eq (op, '+%') OR Text.Eq (op, '-%') OR Text.Eq (op, '*%') THEN
    IF IsFloatStr (lt) OR Text.Eq (lt, '<real>') OR
       IsFloatStr (rt) OR Text.Eq (rt, '<real>') THEN
      ErrN (e, ctx, 'wrapping arithmetic is for integers')
    END
  END ;
  (* the concrete side wins over a literal *)
  IF Text.Eq (lt, rt) THEN RETURN lt END ;
  IF Text.BLen (lt) = 0 OR Text.BLen (rt) = 0 THEN RETURN '' END ;
  IF Text.Eq (lt, '<int>') OR Text.Eq (lt, '<real>') THEN RETURN rt END ;
  IF Text.Eq (rt, '<int>') OR Text.Eq (rt, '<real>') THEN RETURN lt END ;
  RETURN ''
END BinType ;

(* is a BARE name one the checker knows -- in scope (any mode,
   including a nil-typed IS SOME binder), a local/impl CONST, a
   def-module CONST across the pair, a predeclared identifier, a
   builtin or user type name, or a module?  If none of these it is
   undefined, not merely unknown-typed: softness excuses a type the
   checker cannot COMPUTE, not a name that does not EXIST. *)
PROCEDURE BareNameKnown (RO nm: UTF) : BOOL =
VAR
  mi, j : I64 ;
  found : BOOL ;
  cty : UTF ;
BEGIN
  IF Text.BLen (ScopeMode (nm)) > 0 THEN RETURN TRUE END ;
  found := FALSE ;
  cty := ConstType (nm, found) ;
  IF found THEN RETURN TRUE END ;
  IF Text.Eq (nm, 'ALL') OR Text.Eq (nm, 'HEAP') THEN RETURN TRUE END ;
  IF IsBuiltinTy (nm) THEN RETURN TRUE END ;
  IF FindMod (nm) >= 0 THEN RETURN TRUE END ;
  FOR mi := 0 TO nmods - 1 DO
    IF FindTypeIn (mi, nm) IS SOME tt THEN RETURN TRUE END ;
    IF NxFind (mods[mi].cnIx, nm) >= 0 THEN RETURN TRUE END
  END ;
  RETURN FALSE
END BareNameKnown ;

(* nm, bare, is a CONST: this module's or this procedure's, or a
   loaded module's (BareNameKnown counts those too) *)
PROCEDURE ConstNamed (RO nm: UTF) : BOOL =
VAR
  mi : I64 ;
  found : BOOL ;
  cty : UTF ;
BEGIN
  found := FALSE ;
  cty := ConstType (nm, found) ;
  IF found THEN RETURN TRUE END ;
  FOR mi := 0 TO nmods - 1 DO
    IF NxFind (mods[mi].cnIx, nm) >= 0 THEN RETURN TRUE END
  END ;
  RETURN FALSE
END ConstNamed ;

(* nm, bare, is an EXCEPTION: predeclared or any loaded module's *)
PROCEDURE HasExcAny (RO nm: UTF) : BOOL =
VAR mi : I64 ;
BEGIN
  IF Text.Eq (nm, 'Overflow') OR Text.Eq (nm, 'IndexError') OR
     Text.Eq (nm, 'OutOfMemory') OR Text.Eq (nm, 'ValueRange') THEN
    RETURN TRUE
  END ;
  FOR mi := 0 TO nmods - 1 DO
    IF HasExcIn (mi, nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END HasExcAny ;

(* a designator with at most one field selector as the qualident it
   spells, for the type position of a NEW; NONE for anything else *)
PROCEDURE AsQual (k: Ast.Kid) : Ast.Kid =
VAR q : PTR Ast.Node IN pool ;
BEGIN
  IF k IS SOME d THEN
    IF d.kind # Ast.NQualident AND d.kind # Ast.NDesignator THEN
      RETURN NONE
    END ;
    IF d.nkids > 1 THEN RETURN NONE END ;
    (* a fresh node with its names COPIED, so nothing of the borrowed
       tree is retained through the answer *)
    q := Ast.NewNode (pool, Ast.NQualident, d.line, d.col) ;
    Ast.SetA (pool, q, Text.Keep (pool, d.au)) ;
    Ast.SetB (pool, q, Text.Keep (pool, d.bu)) ;
    IF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind # Ast.NSelField THEN RETURN NONE END ;
        Ast.SetB (pool, q, Text.Keep (pool, sel.au))
      END
    END ;
    RETURN SOME (q)
  END ;
  RETURN NONE
END AsQual ;

(* The four spellings of NEW, told apart by NAME (par 10, item 6):

     NEW (T)             the frame, one T          (par 4.3)
     NEW (T, n ...)      the frame, a slice or a grid
     NEW (pool, T ...)   the named pool, as it always was
     NEW (OWN, T)        one owned T: DISPOSE, SHARED, THREAD (par 4.2)

   Answers 'frame', 'pool' or 'own', or '' after diagnosing.  ty is
   the type's node and ext0 the index of the first extent, whose kid
   is NONE when there is none.  A first argument that is a variable
   in scope, HEAP, or a designator with selectors is a pool; a bare
   name that is not a variable, or Module.Name where Module is a
   module, is a type (docs/pool-elision-plan.md, rule 1). *)
(* ---- a name a KNOWN module does not declare (2026-10-08) ----

   The softness contract stands for the unknown: a bare type found
   nowhere may be a missing IMPORT, a module the checker never
   loaded says nothing.  But a type named in NEW that NO module
   declares, a member that a LOADED module does not have, and a
   bare name on the left of `:=' declared nowhere are typos, and
   each rode through --check to surface as the GENERATOR's `unknown
   name', without the M9 line (Xml's `NEW (pool, AttrsKids, 64)',
   2026-10-07; `Math.Nosuch` found by --show, 2026-10-05; `x := 1`
   with no x, 2026-10-04 -- the owed ledger's three).  The same
   wording as the generator's, so a reader meets one message. *)

PROCEDURE ModHasName (RO modName: UTF ; RO nm: UTF) : BOOL =
  (* the module declares nm as a type, a procedure, a constant, an
     exception or an exported variable; TRUE too where nothing can be
     said (the module is not loaded, or is a foreign unit) *)
VAR
  m : I64 ;
  found : BOOL ;
  pr : ProcInfo ;
  t : UTF ;
BEGIN
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN TRUE END ;
  IF Text.BLen (mods[m].foreignLang) > 0 THEN RETURN TRUE END ;
  IF TypeKnown (modName, nm) THEN
    IF FindTypeIn (m, nm) IS SOME tt THEN RETURN TRUE END ;
    IF IsOpaqueIn (m, nm) THEN RETURN TRUE END
  END ;
  pr := LookupProc (Qualify (modName, nm), found) ;
  IF found THEN RETURN TRUE END ;
  t := ModConstType (modName, nm, found) ;
  IF found THEN RETURN TRUE END ;
  IF ExcKnown (modName, nm) THEN RETURN TRUE END ;
  RETURN ExportsVar (m, nm)
END ModHasName ;

PROCEDURE UnknownNewType (ty: Ast.Kid ; e: PTR Ast.Node ; RO ctx: UTF) : BOOL =
  (* the type position of a NEW names nothing: said, as the generator
     would have said it *)
BEGIN
  IF AsQual (ty) IS SOME q THEN
    IF Text.BLen (q.bu) = 0 THEN
      IF Text.BLen (CanonT (SOME (q), 0)) = 0 AND NOT IsBuiltinTy (q.au) THEN
        ErrN (e, ctx, Cat ('unknown type: ', q.au)) ;
        RETURN TRUE
      END
    ELSIF NOT TypeKnown (q.au, q.bu) THEN
      ErrN (e, ctx, S3 ('unknown type: ', Cat (q.au, Cat ('.', q.bu)),
                        S3 (' -- ', q.au, ' declares no such type'))) ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END UnknownNewType ;

PROCEDURE NewForm (e: PTR Ast.Node ; RO ctx: UTF ; VAR ty: Ast.Kid ;
                   VAR ext0: I64) : UTF =
VAR
  t : UTF ;
  isVar : BOOL ;
BEGIN
  ty := NONE ;
  ext0 := 2 ;
  IF e.kids[0] IS SOME d THEN
    IF d.nkids = 0 AND Text.Eq (d.au, 'OWN') THEN
      ty := e.kids[1] ;
      IF e.kids[2] IS SOME x THEN
        ErrN (e, ctx, 'NEW (OWN, T) allocates one object; a slice lives in a pool or in the frame') ;
        RETURN ''
      END ;
      IF UnknownNewType (ty, e, ctx) THEN RETURN '' END ;
      RETURN 'own'
    END ;
    isVar := TRUE ;
    IF d.nkids = 0 THEN
      IF ScopeFind (d.au) < 0 AND NOT Text.Eq (d.au, 'HEAP') THEN
        isVar := FALSE
      END
    ELSIF d.nkids = 1 THEN
      IF d.kids[0] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF ScopeFind (d.au) < 0 AND FindMod (d.au) >= 0 THEN
            isVar := FALSE
          END
        END
      END
    END ;
    IF isVar AND d.nkids = 0 THEN
      IF Text.Eq (ScopeMode (d.au), ModeVar) AND PtrParamTy (ScopeType (d.au)) THEN
        (* `NEW (d, T)`: the pool d's object lives in, carried in by
           rule 2 -- how a VAR pointer parameter grows its object *)
        ty := AsQual (e.kids[1]) ;
        IF ty IS SOME q0 THEN
          IF UnknownNewType (ty, e, ctx) THEN RETURN '' END ;
          RETURN 'pool'
        END ;
        ErrN (e, ctx, 'NEW needs a type name after the pool') ;
        RETURN ''
      END
    END ;
    IF isVar THEN
      t := ExprType (e.kids[0], ctx) ;
      IF Text.BLen (t) > 0 AND NOT Text.Eq (t, 'POOL') THEN
        ErrN (e, ctx, Cat ("NEW's first argument is the pool, not ",
          TyName (t))) ;
        RETURN ''
      END ;
      ty := AsQual (e.kids[1]) ;
      IF ty IS SOME q THEN
        IF UnknownNewType (ty, e, ctx) THEN RETURN '' END ;
        RETURN 'pool'
      END ;
      ErrN (e, ctx, 'NEW needs a type name after the pool') ;
      RETURN ''
    END ;
    (* a type name, so the frame form with extents *)
    ty := AsQual (e.kids[0]) ;
    IF ty IS SOME q2 THEN
      IF Text.BLen (CanonT (SOME (q2), 0)) = 0 THEN
        t := ExprType (e.kids[0], ctx) ;   (* says `unknown name` *)
        RETURN ''
      END
    END ;
    ext0 := 1 ;
    RETURN 'frame'
  END ;
  ty := e.kids[1] ;
  RETURN 'frame'
END NewForm ;

PROCEDURE ExprType0 (k: Ast.Kid ; RO ctx: UTF) : UTF =
VAR
  t, u, form : UTF ;
  j, ext0, nx : I64 ;
  res, tyk : Ast.Kid ;
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NInt :
        IF BeyondI64 (e.au) THEN RETURN 'U64' END ;
        RETURN '<int>'
    | Ast.NReal : RETURN '<real>'
    | Ast.NChar : RETURN 'CHAR'
    | Ast.NString :
        IF Text.CpCount (e.au) = 1 THEN RETURN '<str1>' END ;
        RETURN StrLitTy ()
    | Ast.NTrue : RETURN 'BOOL'
    | Ast.NFalse : RETURN 'BOOL'
    | Ast.NNoneLit : RETURN '<none>'
    | Ast.NParen : RETURN ExprType (e.kids[0], ctx)
    | Ast.NSomeExpr :
        t := ExprType (e.kids[0], ctx) ;
        IF Text.BLen (t) > 0 AND NOT Text.Eq (t, '<void>') THEN
          RETURN Cat ('OPT ', t)
        END ;
        RETURN ''
    | Ast.NSharedExpr :
        t := ExprType (e.kids[0], ctx) ;
        (* SHARED consumes the owned pointer it wraps (par 4.2), under
           its parentheses as the Pascal twin's StripParens reads it *)
        IF ParenCore (e.kids[0]) IS SOME inr THEN
          IF inr.kind = Ast.NDesignator THEN
            (* a name, as DISPOSE takes one: `SHARED (b.p)' left b.p
               holding what the handle's last DISPOSE freed *)
            IF inr.nkids > 0 AND Text.StartsWith (t, 'PTR ') THEN
              ErrN (e, ctx, S3 ('SHARED cannot consume through a selector of ', inr.au,
                ': a move takes a name that owns its pointer, and ownership is not followed into a field or an element (par 4.2)'))
            END ;
            IF inr.nkids = 0 AND Text.StartsWith (t, 'PTR ') THEN
              u := ScopeMode (inr.au) ;
              IF Text.Eq (u, ModeVal) OR Text.Eq (u, ModeVar) OR
                 Text.Eq (u, ModeBinder) OR Text.Eq (u, ModeRo) THEN
                ErrN (e, ctx, S3 ('SHARED consumes an owned pointer; ',
                  inr.au, ' is a borrow (par 4.2)'))
              ELSIF FvalHas (inr.au) THEN
                (* a frame allocation has no rc header and dies with
                   the frame: only NEW (OWN, T) can become SHARED *)
                ErrN (e, ctx, S3 ('SHARED needs an OWN allocation; ',
                  inr.au, ' lives in the frame (par 4.2)'))
              ELSIF OwnsNothing (inr.au) THEN
                ErrN (e, ctx, S3 ('SHARED cannot consume ', inr.au,
                  ': nothing here gives it an owned pointer -- only NEW (OWN, T), an owned name moved in or a call that does not answer what it was lent does (par 4.2)'))
              ELSE
                IF OwnedCandKind (inr.au) = 1 THEN
                  OwnMark (inr.au, 'consumed by SHARED', e)
                END
              END
            END
          END
        END ;
        IF Text.StartsWith (t, 'PTR ') THEN RETURN Cat ('SHARED ', t) END ;
        RETURN ''
    | Ast.NNewExpr :
        (* THE SHAPE: pool FIRST, then the type.  `NEW (Point, pool)`
           used to type-check in silence -- the pool position holds a
           name that is not a value, so it types as unknown, and
           unknown never diagnoses -- and only the GENERATOR objected,
           with `unknown name: Point`.  A tutorial reader followed
           chapter 4's own example into exactly this (2026-08-29).
           A checker softer than the generator is a checker that
           misses; the second argument BEING a pool is conclusive. *)
        form := NewForm (e, ctx, tyk, ext0) ;
        IF Text.BLen (form) = 0 THEN RETURN '' END ;
        IF Text.Eq (form, 'pool') THEN
          (* par 3.2: allocating from a pool the CALLER owns consumes
             the caller's storage and answers a slice into the
             caller's arena -- an effect, and the one a PURE body
             could still have, since NEW is a builtin (rule 3 does not
             see it) and not an assignment target (rules 1 and 2 do
             not either).  A pool declared LOCAL is invisible outside
             the frame and stays legal, and so is the frame itself,
             so the test is the pool's binding MODE. *)
          IF curPure THEN
            IF e.kids[0] IS SOME pn THEN
              IF pn.kind = Ast.NDesignator THEN
                IF Text.Eq (ScopeMode (pn.au), ModeVar) OR
                   Text.Eq (ScopeMode (pn.au), ModeOwn) OR
                   Text.Eq (ScopeMode (pn.au), ModeModule) THEN
                  ErrN (e, ctx, Cat (Cat ('cannot allocate from the pool ',
                    pn.au), ' in a PURE procedure (par 3.2)'))
                END
              END
            END
          END
        END ;
        IF Text.Eq (form, 'frame') THEN
          (* `NEW (Point, pool)`, the reversed spelling: it reads as
             the frame form with a pool for an extent, so name what
             was meant.  A tutorial reader followed chapter 4's own
             example into exactly this (2026-08-29). *)
          FOR j := ext0 TO e.nkids - 1 DO
            IF e.kids[j] IS SOME xn THEN
              IF xn.kind = Ast.NDesignator AND xn.nkids = 0 THEN
                IF ScopeType (xn.au) IS SOME ptn THEN
                  IF ptn.kind = Ast.NQualident THEN
                    IF Text.Eq (ptn.au, 'POOL') THEN
                      ErrN (e, ctx, 'NEW takes the pool first, then the type') ;
                      RETURN ''
                    END
                  END
                END
              END
            END
          END
        END ;
        t := CanonT (tyk, 0) ;
        nx := 0 ;
        FOR j := ext0 TO e.nkids - 1 DO
          IF e.kids[j] IS SOME cnt THEN
            nx := nx + 1 ;
            u := ExprType (e.kids[j], ctx) ;
            IF NOT IsIntish (u) THEN
              ErrN (e, ctx, Cat ('NEW extent must be an integer, not ',
                TyName (u)))
            END
          END
        END ;
        (* one extent is a slice; more than one is a GRID, and the
           arity states the rank so the two cannot disagree *)
        IF nx = 1 THEN
          IF Text.BLen (t) > 0 THEN RETURN Cat ('SLICE OF ', t) END ;
          RETURN ''
        END ;
        IF nx > 1 THEN RETURN GridOf (nx, t) END ;
        IF Text.BLen (t) > 0 THEN RETURN Cat ('PTR ', t) END ;
        RETURN ''
    | Ast.NGridOf :
        (* GRID (s, n0, ..., nR): GRID R OF T over a SLICE OF T named
           by a designator; the extents are integers, held to the
           slice's length at run time (par 2.2.1, 2026-10-08) *)
        t := ExprType (e.kids[0], ctx) ;
        FOR j := 1 TO e.nkids - 1 DO
          u := ExprType (e.kids[j], ctx) ;
          IF NOT IsIntish (u) THEN
            ErrN (e, ctx, Cat ('GRID extent must be an integer, not ',
              TyName (u)))
          END
        END ;
        IF e.nkids - 1 > 4 THEN
          ErrN (e, ctx, 'GRID takes at most 4 extents (par 2.2.1)')
        END ;
        IF e.kids[0] IS SOME g0 THEN
          IF g0.kind # Ast.NDesignator THEN
            ErrN (e, ctx, 'GRID lays over a slice NAMED by a designator: SLICE it into a variable first (par 2.2.1)')
          END
        END ;
        IF Text.StartsWith (t, 'SLICE OF ') THEN
          RETURN GridOf (e.nkids - 1, AfterOf (t))
        END ;
        IF Text.BLen (t) > 0 THEN
          ErrN (e, ctx, Cat ('GRID needs a slice, not ', TyName (t)))
        END ;
        RETURN ''
    | Ast.NSliceOf3 :
        t := ExprType (e.kids[0], ctx) ;
        u := ExprType (e.kids[1], ctx) ;
        IF NOT IsIntish (u) THEN
          ErrN (e, ctx, Cat ('SLICE start must be an integer, not ',
            TyName (u)))
        END ;
        u := ExprType (e.kids[2], ctx) ;
        IF NOT IsIntish (u) THEN
          ErrN (e, ctx, Cat ('SLICE length must be an integer, not ',
            TyName (u)))
        END ;
        IF Text.StartsWith (t, 'SLICE OF ') THEN RETURN t END ;
        IF Text.StartsWith (t, 'ARRAY ') THEN
          (* an ARRAY is a value: one a call answers (or a selection
             from one) lives in a temporary of the statement, and a
             slice of it would outlive it -- the generator refused it
             as `SLICE() argument form' (genforms GfSliceOfCall,
             2026-10-10).  A variable, a parameter, a constant table:
             all designators. *)
          IF e.kids[0] IS SOME a0 THEN
            IF a0.kind # Ast.NDesignator THEN
              ErrN (e, ctx, 'a SLICE of an array no variable holds: the array is gone at the end of the statement -- name it first: a := F (...) ; SLICE (a, ...)')
            END
          END ;
          RETURN Cat ('SLICE OF ', AfterOf (t))
        END ;
        IF Text.BLen (t) > 0 THEN
          ErrN (e, ctx, Cat ('SLICE needs a slice or array, not ',
            TyName (t)))
        END ;
        RETURN ''
    | Ast.NIs :
        (* the IS operand is the guard itself: the final OPT is
           legal, and SOME binds its payload *)
        IF e.kids[0] IS SOME o THEN
          IF o.kind = Ast.NDesignator THEN
            res := DesigDeclType (o, ctx) ;
            (* `x IS SOME p' with no x: the generator's `IS SOME form
               unsupported' until 2026-10-30 (the fuzz review's N13) *)
            IF NOT BareNameKnown (o.au) THEN
              ErrN (o, ctx, Cat ('unknown name: ', o.au))
            END ;
            IF e.kids[1] IS SOME b THEN
              IF b.kind = Ast.NIsSome AND Text.BLen (b.au) = 0 THEN
                (* `x IS SOME' / `x IS NONE': a BOOL, nothing bound
                   (issue 4, 2026-10-09); the operand must still be an
                   OPT *)
                t := CanonT (res, 0) ;
                IF Text.BLen (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                  ErrN (e, ctx, 'IS SOME needs an OPT operand')
                END
              ELSIF b.kind = Ast.NIsSome THEN
                t := CanonT (res, 0) ;
                res := ResolveType (res) ;
                IF res IS SOME rr THEN
                  IF rr.kind = Ast.NOptType THEN
                    (* the payload is written in the module that
                       declared the OPT -- an alias `Ast.Kid' resolves
                       to `OPT PTR Node' in Ast, and a bare `Node' is
                       Ast's, not this module's (2026-10-08: it was
                       found through the all-modules fallback) *)
                    BindName (b.au, InMod (rr.kids[0], ResolvedMod ()))
                  ELSE
                    IF Text.BLen (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                      ErrN (e, ctx, 'IS SOME needs an OPT operand')
                    END ;
                    BindName (b.au, NONE)
                  END
                ELSE
                  IF Text.BLen (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                    ErrN (e, ctx, 'IS SOME needs an OPT operand')
                  END ;
                  BindName (b.au, NONE)
                END ;
                (* par 4.1 direction: the binder is a VIEW of the
                   operand -- storing into the binder stores into the
                   operand's storage, so the binder inherits the
                   operand's reach (dst = operand, src = binder) --
                   and, provenance, the binder CARRIES the operand *)
                EscStore (o.au, TRUE, b.au) ;
                CarryFrom (b.au, o.au) ;
                BindFrom (b.au, o.au)
              END
            END
          ELSE
            t := ExprType (e.kids[0], ctx) ;
            IF e.kids[1] IS SOME b2 THEN
              IF b2.kind = Ast.NIsSome AND Text.BLen (b2.au) = 0 THEN
                IF Text.BLen (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                  ErrN (e, ctx, 'IS SOME needs an OPT operand')
                END
              ELSIF b2.kind = Ast.NIsSome THEN
                res := NONE ;
                (* a CALL's result: the binder takes the callee's
                   declared payload type, made self-contained in the
                   callee's module, so an argument made of the binder
                   is checked like any other.  Before 2026-09-06 it
                   was bound untyped, passed by softness, and gcc
                   objected. *)
                IF o.kind = Ast.NCallExpr THEN
                  IF o.kids[0] IS SOME cd THEN
                    pr := LookupProc (DesigName (cd), found) ;
                    IF found THEN
                      IF pr.node IS SOME pn THEN
                        IF pn.nkids > 1 THEN
                          IF pn.kids[1] IS SOME rt0 THEN
                            canonCtx := pr.modName ;
                            res := ResolveType (SOME (rt0)) ;
                            canonCtx := '' ;
                            IF res IS SOME rr THEN
                              IF rr.kind = Ast.NOptType THEN
                                (* in the module the OPT was DECLARED
                                   in, which an alias in the result
                                   type may make another than the
                                   callee's: `Mk () : Ast.Kid' binds
                                   a `PTR Ast.Node', not a `PTR
                                   Soft.Node' nobody declares -- the
                                   cause behind 150 passed-over sites
                                   on the review pages (2026-10-08) *)
                                IF resolvedIn >= 0 THEN
                                  res := QualifiedIn (rr.kids[0], ResolvedMod ())
                                ELSE
                                  res := QualifiedIn (rr.kids[0], pr.modName)
                                END
                              ELSE
                                res := NONE
                              END
                            END
                          END
                        END
                      END
                    END
                  END
                END ;
                IF Text.BLen (t) > 0 AND NOT Text.StartsWith (t, 'OPT ') THEN
                  ErrN (e, ctx, 'IS SOME needs an OPT operand')
                END ;
                BindName (b2.au, res)
              END
            END
          END
        END ;
        RETURN 'BOOL'
    | Ast.NUn :
        t := ExprType (e.kids[0], ctx) ;
        IF Text.Eq (e.au, 'NOT') THEN
          IF Text.BLen (t) > 0 AND NOT Text.Eq (t, 'BOOL') THEN
            ErrN (e, ctx, Cat ('NOT needs a BOOL operand, not ',
              TyName (t)))
          END ;
          RETURN 'BOOL'
        END ;
        IF NOT NumSide (t) THEN
          ErrN (e, ctx, S4 ('unary ', e.au,
            ' needs a numeric operand, not ', TyName (t)))
        END ;
        RETURN t
    | Ast.NBin : RETURN BinType (e, ctx)
    | Ast.NDesignator :
        NoteUse (e, ctx) ;
        (* a top-level M9 procedure named as a VALUE has its head's
           type (par 2.2.3) -- Up, or Mod.Up; a scope name shadows it
           as it shadows anything.  A foreign procedure is a C symbol
           with another ABI and no value at all. *)
        IF (e.nkids = 0 OR (e.nkids = 1 AND FindMod (e.au) >= 0)) AND
           ScopeFind (e.au) < 0 THEN
          pr := LookupProc (DesigName (e), found) ;
          IF found THEN
            IF pr.node IS SOME pn THEN
              IF Text.BLen (pr.foreign) > 0 THEN
                ErrN (e, ctx, S3 ('a foreign procedure is not a value: ',
                  DesigName (e), ' (par 2.2.3)')) ;
                RETURN ''
              END ;
              canonCtx := pr.modName ;
              t := ProcSig (pn.kids[0], pn.kids[1], pn.f3, pn.kids[2], 0) ;
              canonCtx := '' ;
              RETURN t
            END
          END
        END ;
        (* a bare value name known to NO part of the checker's name
           universe is undefined -- the symmetric twin of the
           unknown-procedure check.  Only here (a body-walk value
           context, scope populated), never in DesigStrType, which
           the signature checks also reach without a scope. *)
        IF e.nkids = 0 AND NOT BareNameKnown (e.au) THEN
          ErrN (e, ctx, Cat ('unknown name: ', e.au))
        ELSIF e.nkids = 0 AND Text.BLen (ScopeMode (e.au)) = 0 AND NOT ConstNamed (e.au) THEN
          (* known, and no value: a module or a type named where a value
             is read -- `x := I64', `IF Io = 3' reached the generator as
             `unknown name' (the fuzz review's N13, until 2026-10-30) *)
          IF FindMod (e.au) >= 0 THEN
            ErrN (e, ctx, S3 (e.au, ' is a module, not a value -- name what it declares: ', Cat (e.au, '.X')))
          ELSIF NOT Text.Eq (e.au, 'ALL') AND NOT Text.Eq (e.au, 'HEAP') AND
                NOT typeArgOk THEN
            ErrN (e, ctx, S3 (e.au, ' is a type, not a value -- ', S3 ('a value of it is written ', e.au, ' (x)')))
          END
        END ;
        (* a root with selectors that names nothing: `w.n', `w[0]' *)
        IF e.nkids >= 1 AND NOT BareNameKnown (e.au) AND NOT HasExcAny (e.au) AND
           NOT ModImports (curRoot, curMod, e.au) THEN
          ErrN (e, ctx, Cat ('unknown name: ', e.au))
        END ;
        (* a member a LOADED module does not declare: Math.Nosuch *)
        IF e.nkids >= 1 AND ScopeFind (e.au) < 0 AND FindMod (e.au) >= 0 THEN
          IF e.kids[0] IS SOME msel THEN
            IF msel.kind = Ast.NSelField AND NOT ModHasName (e.au, msel.au) THEN
              ErrN (e, ctx, S3 ('unknown name: ', Cat (e.au, Cat ('.', msel.au)),
                                S3 (' -- ', e.au, ' declares no such name')))
            END
          END
        END ;
        (* a member an enumeration or case record does not declare:
           Hue.Nope here, Palette.Hue.Nope in a loaded module *)
        IF e.nkids = 1 AND ScopeFind (e.au) < 0 AND FindMod (e.au) < 0 THEN
          IF e.kids[0] IS SOME vsel THEN
            IF vsel.kind = Ast.NSelField AND
               MemberMissing (FindMod (curMod), e.au, vsel.au) THEN
              ErrN (e, ctx, S3 ('unknown member: ', Cat (e.au, Cat ('.', vsel.au)),
                                S3 (' -- ', e.au, ' declares no such member')))
            END
          END
        END ;
        IF e.nkids = 2 AND ScopeFind (e.au) < 0 AND FindMod (e.au) >= 0 THEN
          IF e.kids[0] IS SOME tsel THEN
            IF e.kids[1] IS SOME msel2 THEN
              IF tsel.kind = Ast.NSelField AND msel2.kind = Ast.NSelField AND
                 MemberMissing (FindMod (e.au), tsel.au, msel2.au) THEN
                ErrN (e, ctx, S3 ('unknown member: ',
                                  Cat (e.au, Cat ('.', Cat (tsel.au, Cat ('.', msel2.au)))),
                                  S3 (' -- ', tsel.au, ' declares no such member')))
              END
            END
          END
        END ;
        RETURN DesigStrType (e, FALSE, ctx)
    | Ast.NCallExpr : RETURN CallType (e.kids[0], e.kids[1], e, ctx)
    | Ast.NCallSel :
        (* F (x).f, F (x)[i]: the call checked as any call, then its
           answer's declared type walked by the selectors as a
           designator's is; the answer's type recorded for the
           generator (2026-10-09, cp-kernel's stages 4b and 6a) *)
        t := ExprType (e.kids[0], ctx) ;
        res := CallResultNode (e.kids[0]) ;
        IF res IS SOME r0 THEN
          Ast.SetType (e.id, res) ;
          j := nerrs ;
          tyk := SelWalk (e, ctx, res, 1) ;
          IF tyk IS SOME t1 THEN RETURN CanonT (tyk, 0) END ;
          IF nerrs = j THEN
            ErrN (e, ctx, Cat (Cat ('cannot select from an answer of type ',
              TyName (t)), ': a field needs a record, a subscript a slice, array or grid'))
          END
        ELSIF Text.BLen (t) > 0 THEN
          (* a call through a procedure value: no declaration to read
             the answer's type node from *)
          ErrN (e, ctx,
            'select from the answer of a procedure value through a variable: assign the answer first')
        END ;
        RETURN ''
    ELSE
      FOR j := 0 TO e.nkids - 1 DO
        t := ExprType (e.kids[j], ctx)
      END ;
      RETURN ''
    END
  END ;
  RETURN ''
END ExprType0 ;

(* the typed tree's stage 3: every expression's type, recorded as the
   checker computes it, for the generator to read (Ast.SetTyStr) *)
PROCEDURE ExprType (k: Ast.Kid ; RO ctx: UTF) : UTF =
VAR t : UTF ;
BEGIN
  t := ExprType0 (k, ctx) ;
  IF k IS SOME e THEN Ast.SetTyStr (e.id, t) END ;
  RETURN t
END ExprType ;

(* the oracle OVERWRITES an existing binding in place -- a name
   rebound arm by arm (CASE over Frame's column variants rebinds v
   per arm) must answer the LATEST type, and appending would leave
   the first arm's shadowing every later one, since lookup answers
   the first hit.  An existing entry keeps its mode, as the oracle's
   does. *)
PROCEDURE BindName (RO KEPT nm: UTF ; KEPT t: Ast.Kid) =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i < 0 THEN ScopeAdd (nm, t, ModeBinder)
  ELSE
    scope[i].ty := t ;
    scope[i].from := ''
  END
END BindName ;

(* a binder bound by IS SOME from a designator: the designator's ROOT
   name, which names the binder's pool (ObjPoolIssue) *)
PROCEDURE BindFrom (RO nm: UTF ; RO KEPT root: UTF) =
VAR i : I64 ;
BEGIN
  i := ScopeFind (nm) ;
  IF i >= 0 THEN scope[i].from := root END
END BindFrom ;

(* a type node from module MODNAME made self-contained: its bare type
   names qualified, so canonicalising it later -- from whichever module
   the binder is used in -- resolves them where they were declared
   (the canonCtx lesson, applied to binders).  Pool and attribute
   components are dropped, neither being part of type identity. *)
PROCEDURE QualifiedBound (b: Ast.Kid ; RO KEPT m: UTF) : Ast.Kid =
VAR
  d, sf : PTR Ast.Node IN pool ;
  found : BOOL ;
  t : UTF ;
BEGIN
  IF b IS SOME e THEN
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
      t := ModConstType (m, e.au, found) ;
      IF found THEN
        d := Ast.NewNode (pool, Ast.NDesignator, e.line, e.col) ;
        Ast.SetA (pool, d, m) ;
        sf := Ast.NewNode (pool, Ast.NSelField, e.line, e.col) ;
        Ast.SetA (pool, sf, e.au) ;
        Ast.Add (pool, d, SOME (sf)) ;
        RETURN SOME (d)
      END
    END
  END ;
  RETURN b
END QualifiedBound ;

PROCEDURE QualifiedIn (t: Ast.Kid ; RO KEPT modName: UTF) : Ast.Kid =
VAR n : PTR Ast.Node IN pool ;
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident THEN
      IF Text.BLen (tn.bu) = 0 AND NOT IsBuiltinTy (tn.au) AND
         NOT Text.Eq (tn.au, 'STR') AND NOT Text.Eq (tn.au, 'UTF') THEN
        n := Ast.NewNode (pool, Ast.NQualident, tn.line, tn.col) ;
        Ast.SetA (pool, n, modName) ;
        Ast.SetB (pool, n, tn.au) ;
        RETURN SOME (n)
      END
    ELSIF tn.kind = Ast.NPtrType OR tn.kind = Ast.NOptType OR
          tn.kind = Ast.NSharedType OR tn.kind = Ast.NSliceType THEN
      n := Ast.NewNode (pool, tn.kind, tn.line, tn.col) ;
      IF tn.nkids > 0 THEN
        Ast.Add (pool, n, QualifiedIn (tn.kids[0], modName))
      END ;
      Ast.Add (pool, n, NONE) ;
      RETURN SOME (n)
    ELSIF (tn.kind = Ast.NArrayType OR tn.kind = Ast.NGridType) AND
          tn.nkids >= 2 THEN
      (* the element qualified: an exported ARRAY 3 OF Fr (decision
         28); the rank as written; the bound as written unless it is a
         bare CONST of modName, which becomes `modName.N' -- the
         generators read this node (the typed tree), and in an
         importer a bare MaxErr was looked up among the importer's
         constants (2026-10-10, Parse's errs) *)
      n := Ast.NewNode (pool, tn.kind, tn.line, tn.col) ;
      IF tn.kind = Ast.NArrayType THEN
        Ast.Add (pool, n, QualifiedBound (tn.kids[0], modName))
      ELSE
        Ast.Add (pool, n, tn.kids[0])
      END ;
      Ast.Add (pool, n, QualifiedIn (tn.kids[1], modName)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN t
END QualifiedIn ;

(* ---- the module a designator's type was written in ----

   A component type -- a record's field, a pointer's target, a slice's
   or an array's element -- is written in the module that declared the
   aggregate, and a bare name in it means that module's type.
   CheckWrite and DesigDeclType resolved such a node in the CURRENT
   module, so `tm.kind' with tm a Sparql.Term and its field a bare
   `Kind' resolved to Csv.Kind where every corpus module was loaded
   (semtest and semdiff; m9c loads only the closure and never met
   it): the canonCtx class, the fourth of its kind, in both checkers
   (2026-10-07).  NoteMod remembers the module of the last QUALIFIED
   type the walk passed; InMod qualifies a component in it, unless it
   is the current module. *)

PROCEDURE NoteMod (t: Ast.Kid ; VAR m: UTF) =
BEGIN
  IF t IS SOME tn THEN
    IF tn.kind = Ast.NQualident AND Text.BLen (tn.bu) > 0 THEN m := tn.au END
  END
END NoteMod ;

PROCEDURE InMod (t: Ast.Kid ; RO KEPT m: UTF) : Ast.Kid =
BEGIN
  IF Text.BLen (m) = 0 OR Text.Eq (m, curMod) THEN RETURN t END ;
  RETURN QualifiedIn (t, m)
END InMod ;

(* which module owns variant V of CASE RECORD type T, and the field
   sequence that variant carries *)
PROCEDURE TryVariantMod (m: I64 ; RO tyName: UTF ; RO vName: UTF ;
                         VAR owner: UTF ; VAR fields: Ast.Kid) : BOOL =
VAR j, v : I64 ;
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  FOR j := 0 TO mods[m].nvts - 1 DO
    IF Text.Eq (mods[m].vts[j].typeName, tyName) THEN
      FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
        IF Text.Eq (mods[m].vts[j].variants[v], vName) THEN
          owner := mods[m].name ;
          fields := mods[m].vts[j].fields[v] ;
          RETURN TRUE
        END
      END
    END
  END ;
  RETURN FALSE
END TryVariantMod ;

(* Module m declares an enumeration or case record tyName and vName is
   none of its members: Hue.Nope. *)
PROCEDURE MemberMissing (m: I64 ; RO tyName: UTF ; RO vName: UTF) : BOOL =
VAR j, v : I64 ;
BEGIN
  IF m < 0 THEN RETURN FALSE END ;
  FOR j := 0 TO mods[m].nvts - 1 DO
    IF Text.Eq (mods[m].vts[j].typeName, tyName) THEN
      FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
        IF Text.Eq (mods[m].vts[j].variants[v], vName) THEN RETURN FALSE END
      END ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END MemberMissing ;

(* A bare Value.Null resolves in its OWN module first: Json and Dict
   both declare a variant type named Value, and load order must not
   decide which one a constructor means -- the same rule CanonQual
   already applies to bare type names. *)
PROCEDURE FindVariant (RO tyName: UTF ; RO vName: UTF ;
                       VAR owner: UTF ; VAR fields: Ast.Kid) : BOOL =
VAR m : I64 ;
BEGIN
  owner := '' ;
  fields := NONE ;
  IF Text.BLen (canonCtx) > 0 THEN
    IF TryVariantMod (FindMod (canonCtx), tyName, vName, owner, fields) THEN
      RETURN TRUE
    END
  ELSE
    IF TryVariantMod (FindMod (curMod), tyName, vName, owner, fields) THEN
      RETURN TRUE
    END
  END ;
  FOR m := 0 TO nmods - 1 DO
    IF TryVariantMod (m, tyName, vName, owner, fields) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END FindVariant ;

PROCEDURE VariantOwnerOf (RO tyName: UTF ; RO vName: UTF ;
                          VAR found: BOOL) : UTF =
VAR
  owner : UTF ;
  fields : Ast.Kid ;
BEGIN
  found := FindVariant (tyName, vName, owner, fields) ;
  RETURN owner
END VariantOwnerOf ;

PROCEDURE CountParams (pl: Ast.Kid) : I64 =
VAR n, g : I64 ;
BEGIN
  n := 0 ;
  IF pl IS SOME p THEN
    FOR g := 0 TO p.nkids - 1 DO
      IF p.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN n := n + ids.nkids END
      END
    END
  END ;
  RETURN n
END CountParams ;

PROCEDURE BaseIsPtr (d: PTR Ast.Node) : BOOL =
BEGIN
  IF ResolveType (ScopeType (d.au)) IS SOME r THEN
    RETURN r.kind = Ast.NPtrType
  END ;
  RETURN FALSE
END BaseIsPtr ;

(* can a value of this type carry a pointer?  Gen.HasPtr's twin: a
   pointer, a slice, a grid, and any record, array or variant holding
   one, through OPT and through a type name. *)
PROCEDURE PtrBearing0 (r: PTR Ast.Node ; depth: I64) : BOOL ;

(* the fields of a named type are read in the module that declares it
   (ResolveType says which in resolvedIn): until 2026-10-22 they were
   read in the caller's context, their bare names found by the scan
   (item 12's measurement) *)
PROCEDURE PtrBearing (t: Ast.Kid ; depth: I64) : BOOL =
VAR
  was : UTF ;
  rm : I64 ;
  res : BOOL ;
BEGIN
  IF depth > 8 THEN RETURN FALSE END ;
  IF ResolveType (t) IS SOME r THEN
    rm := resolvedIn ;
    IF rm < 0 THEN RETURN PtrBearing0 (r, depth) END ;
    was := canonCtx ;
    canonCtx := Text.Keep (pool, mods[rm].name) ;
    res := PtrBearing0 (r, depth) ;
    canonCtx := was ;
    RETURN res
  END ;
  RETURN FALSE
END PtrBearing ;

PROCEDURE PtrBearing0 (r: PTR Ast.Node ; depth: I64) : BOOL =
VAR
  i, j : I64 ;
  fsk : Ast.Kid ;
BEGIN
  IF TRUE THEN
    CASE r.kind OF
    | Ast.NPtrType, Ast.NSliceType, Ast.NGridType : RETURN TRUE
    | Ast.NOptType : RETURN PtrBearing (r.kids[0], depth + 1)
    | Ast.NArrayType : RETURN PtrBearing (r.kids[1], depth + 1)
    | Ast.NRecordType, Ast.NMonitorType :
        IF r.kind = Ast.NMonitorType THEN fsk := r.kids[0]
        ELSE fsk := r.kids[1] END ;
        IF fsk IS SOME fs THEN
          FOR i := 0 TO fs.nkids - 1 DO
            IF fs.kids[i] IS SOME g THEN
              IF PtrBearing (g.kids[1], depth + 1) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NCaseRecordType :
        FOR i := 0 TO r.nkids - 1 DO
          IF r.kids[i] IS SOME arm THEN
            IF arm.kids[0] IS SOME afs THEN
              FOR j := 0 TO afs.nkids - 1 DO
                IF afs.kids[j] IS SOME ag THEN
                  IF PtrBearing (ag.kids[1], depth + 1) THEN RETURN TRUE END
                END
              END
            END
          END
        END ;
        RETURN FALSE
    ELSE
      RETURN FALSE
    END
  END ;
  RETURN FALSE
END PtrBearing0 ;

(* the type under designator E -- a parameter of procedure D of module
   MOD, bare or selected (`lx.src', `items[i]', `s[i]') -- walked from
   the parameter's declared type as CheckWrite0 walks a write, with
   the component types qualified in the module that declared the
   aggregate (InMod, NoteMod).  BEYOND says whether the walk crossed
   a reference -- a pointer's target, a slice's or a grid's element --
   so that the storage lies beyond the frame holding the parameter;
   KNOWN is FALSE when the parameter is not D's or a step did not
   resolve (another module's type this checker has not loaded), and
   the callers then take the conservative side. *)
PROCEDURE ParamSelType (d: PTR Ast.Node ; e: PTR Ast.Node ; RO mod: UTF ;
                        VAR beyond: BOOL ; VAR known: BOOL) : Ast.Kid =
VAR
  g, b, j : I64 ;
  tn, tq, res : Ast.Kid ;
  tmod : UTF ;
  found, deref : BOOL ;
BEGIN
  beyond := FALSE ;
  known := FALSE ;
  found := FALSE ;
  tn := NONE ;
  IF d.kids[0] IS SOME ps THEN
    FOR g := 0 TO ps.nkids - 1 DO
      IF ps.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR b := 0 TO ids.nkids - 1 DO
            IF ids.kids[b] IS SOME id THEN
              IF NOT found AND Text.Eq (id.au, e.au) THEN
                found := TRUE ;
                tn := grp.kids[1]
              END
            END
          END
        END
      END
    END
  END ;
  IF NOT found THEN RETURN NONE END ;
  tmod := mod ;
  tq := InMod (tn, tmod) ;
  FOR j := 0 TO e.nkids - 1 DO
    NoteMod (tq, tmod) ;
    res := ResolveType (tq) ;
    LOOP
      deref := FALSE ;
      IF res IS SOME r0 THEN
        IF r0.kind = Ast.NPtrType OR r0.kind = Ast.NSharedType THEN
          deref := TRUE ;
          beyond := TRUE ;
          tq := InMod (r0.kids[0], tmod) ;
          NoteMod (tq, tmod) ;
          res := ResolveType (tq)
        END
      END ;
      IF NOT deref THEN EXIT END
    END ;
    IF res IS SOME r THEN
      IF e.kids[j] IS SOME sel THEN
        IF sel.kind = Ast.NSelField THEN
          IF r.kind = Ast.NRecordType THEN
            tq := InMod (FieldTypeOf (r, sel.au), tmod)
          ELSE
            RETURN NONE
          END
        ELSIF sel.kind = Ast.NSelIndex THEN
          IF r.kind = Ast.NSliceType THEN
            beyond := TRUE ;
            tq := InMod (r.kids[0], tmod)
          ELSIF r.kind = Ast.NGridType THEN
            beyond := TRUE ;
            tq := InMod (r.kids[1], tmod)
          ELSIF r.kind = Ast.NArrayType THEN
            tq := InMod (r.kids[1], tmod)
          ELSE
            RETURN NONE
          END
        ELSE
          RETURN NONE
        END
      END
    ELSE
      RETURN NONE
    END
  END ;
  known := TRUE ;
  RETURN tq
END ParamSelType ;

(* can designator E -- a parameter of procedure D, bare or selected
   -- be viewed at all: is what it names a reference, a string, a
   record holding one (PtrBearing)?  A scalar is copied, so a store
   of it is no borrow: `buf[i] := s[i]' copies a CHAR, and
   DynStr.Append hands nothing back (ViewExprEvidence, 2026-10-18).
   A type this checker cannot resolve is taken as bearing, and the
   caller's own argument types then decide what is carried. *)
PROCEDURE ParamViewBearing (d: PTR Ast.Node ; e: PTR Ast.Node ; RO mod: UTF) : BOOL =
VAR
  tn : Ast.Kid ;
  qn : UTF ;
  beyond, known : BOOL ;
BEGIN
  IF NOT IsParamOf (d, e.au) THEN RETURN FALSE END ;
  tn := ParamSelType (d, e, mod, beyond, known) ;
  IF NOT known THEN RETURN TRUE END ;
  (* a builtin scalar resolves to nothing, being nothing's alias --
     and so does a NAME for one, `Kind.FlexFloat = F32`: chased through
     ScalarAlias as a conversion chases it, or every element copied
     out of a `SLICE OF Kind.FlexFloat` reads as a borrow and the
     FLEXPART port's Getfields.Adopt asks its callers for a KEPT that
     keeps nothing (2026-10-18, atverm/m9 pull request 23) *)
  IF tn IS SOME tq THEN
    IF tq.kind = Ast.NQualident THEN
      IF Text.BLen (tq.bu) = 0 THEN qn := tq.au ELSE qn := tq.au + '.' + tq.bu END ;
      IF IsBuiltinTy (ScalarAlias (qn)) THEN RETURN FALSE END
    END
  END ;
  IF ResolveType (tn) IS SOME r2 THEN RETURN PtrBearing (tn, 0) END ;
  RETURN TRUE
END ParamViewBearing ;

(* does a store into designator E -- a parameter of D, selected --
   land beyond the frame that holds the parameter: through a pointer
   it points to, into a slice's or grid's element?  Then what the
   store keeps outlives the call, and the caller's variable does not
   merely carry it (HandsBackDeep).  Unknown is taken as beyond. *)
PROCEDURE ParamSelBeyond (d: PTR Ast.Node ; e: PTR Ast.Node ; RO mod: UTF) : BOOL =
VAR
  tn : Ast.Kid ;
  beyond, known : BOOL ;
BEGIN
  IF NOT IsParamOf (d, e.au) THEN RETURN FALSE END ;
  tn := ParamSelType (d, e, mod, beyond, known) ;
  IF NOT known THEN RETURN TRUE END ;
  RETURN beyond
END ParamSelBeyond ;

(* does a VAR parameter of this type carry its object's pool as a
   hidden argument (docs/pool-elision-plan.md, rule 2)?  Written as
   `PTR T` or `OPT PTR T`: yes, by node kind and no lookup.  A record,
   monitor, array or variant that can hold a pointer: yes, since a
   component of it may be handed on.  A bare slice, grid or string:
   no -- those are output slots, re-homed or adopted at exit.  Both
   compilers must answer this identically, and gendiff holds them
   to it. *)
PROCEDURE PtrParamTy (t: Ast.Kid) : BOOL =
BEGIN
  IF t IS SOME n THEN
    IF n.kind = Ast.NPtrType THEN RETURN TRUE END ;
    IF n.kind = Ast.NOptType THEN
      IF n.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
      RETURN FALSE
    END ;
    IF n.kind = Ast.NSliceType OR n.kind = Ast.NGridType THEN RETURN FALSE END ;
    IF ResolveType (t) IS SOME r THEN
      (* a name for a pointer -- `SinkP = PTR Zarr.Sink`, `Ast.Kid =
         OPT PTR Node` -- is the pointer it names (the proxy's P9) *)
      IF r.kind = Ast.NPtrType THEN RETURN TRUE END ;
      IF r.kind = Ast.NOptType THEN
        IF r.kids[0] IS SOME inner THEN RETURN inner.kind = Ast.NPtrType END ;
        RETURN FALSE
      END ;
      IF r.kind = Ast.NRecordType OR r.kind = Ast.NMonitorType OR
         r.kind = Ast.NArrayType OR r.kind = Ast.NCaseRecordType THEN
        RETURN PtrBearing (t, 0)
      END
    END
  END ;
  RETURN FALSE
END PtrParamTy ;

(* the pool a declared type names: the IN clause of `PTR T IN p` or
   `OPT PTR T IN p`, through a type name; NONE for anything else *)
PROCEDURE DeclPool (t: Ast.Kid) : Ast.Kid =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    IF r.kind = Ast.NOptType THEN RETURN DeclPool (r.kids[0]) END ;
    IF r.kind = Ast.NPtrType THEN RETURN r.kids[1] END
  END ;
  RETURN NONE
END DeclPool ;

(* the pool of the object a designator names, as a call handing the
   object to a VAR pointer parameter needs it (rule 2): '' when the
   generator can name it from the ROOT of the designator, else why it
   cannot.  A local's pool is its IN clause or the frame; a module
   variable's is its IN clause or the module frame; a VAR parameter's
   is the hidden one it carries; a binder's is its origin's.  An OWN
   parameter's object is heap storage with no pool, a value
   parameter's is a borrow whose pool nobody named, and a VAR slice
   carries none -- those are refused.  A bare value parameter is
   refused as a lent borrow before this is asked. *)
PROCEDURE ObjPoolIssue (a: PTR Ast.Node) : UTF =
VAR
  m, root : UTF ;
  i, hops : I64 ;
BEGIN
  m := ScopeMode (a.au) ;
  (* a binder's pool is its ORIGIN's: followed back through binders to
     the root its IS SOME operand was written on.  A value or RO
     parameter there is a borrow whose pool nobody named -- the
     generator fell back to the calling frame, and a NEW in "the
     binder's pool" died with the caller (Sem.CheckFile lending a
     binder on root.kids[i] to ExportWalk: `unknown name: const voi',
     2026-10-10; owed since 2026-10-04) *)
  IF Text.Eq (m, ModeBinder) THEN
    root := a.au ;
    hops := 0 ;
    LOOP
      i := ScopeFind (root) ;
      IF i < 0 OR hops > 16 THEN EXIT END ;
      IF NOT Text.Eq (scope[i].mode, ModeBinder) OR Text.BLen (scope[i].from) = 0 THEN EXIT END ;
      root := scope[i].from ;
      hops := hops + 1
    END ;
    IF hops > 0 THEN
      m := ScopeMode (root) ;
      IF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeRo) THEN
        RETURN S4 (a.au, ' is bound from the value parameter ', root,
                   ' -- take it as VAR, so its pool comes with it')
      ELSIF Text.Eq (m, ModeOwn) THEN
        RETURN S3 (a.au, ' is bound from the OWN parameter ', root)
      END
    END ;
    RETURN ''
  END ;
  IF Text.Eq (m, ModeVar) THEN
    IF PtrParamTy (ScopeType (a.au)) THEN RETURN '' END ;
    RETURN S3 ('VAR parameter ', a.au, ' carries no pool')
  ELSIF Text.Eq (m, ModeOwn) THEN
    RETURN Cat (a.au, ' is an OWN parameter')
  ELSIF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeRo) THEN
    IF a.nkids = 0 AND BaseIsPtr (a) THEN RETURN '' END ;
    RETURN Cat (a.au, ' is a value parameter')
  ELSIF Text.Eq (m, ModeLocal) AND a.nkids = 0 THEN
    (* a local without IN lends the FRAME as its object's pool -- right
       for a frame allocation, and for a POOL allocation (pval, stage
       6) the callee's growth dies with this frame while the object
       lives on (2026-10-23: Ast.SetA's first cut allocated a node's
       name in the parser's frame; probe pool-root-local-no-in) *)
    IF DeclPool (ScopeType (a.au)) IS SOME dp THEN RETURN '' END ;
    IF PvalHas (a.au) THEN
      RETURN S3 (a.au, ' holds a pool allocation and is declared without IN; declare ',
                 Cat (a.au, ' IN that pool'))
    END
  END ;
  RETURN ''
END ObjPoolIssue ;

(* the flattened field types of a variant: one entry per binder *)
PROCEDURE FlatFields (fields: Ast.Kid ; VAR n: I64) : SLICE OF AKid =
VAR
  out : SLICE OF AKid ;
  g, j : I64 ;
BEGIN
  (* counted first: a record aggregate has as many fields as its
     record, where a variant's payload had never exceeded 16 *)
  n := 0 ;
  IF fields IS SOME fc THEN
    FOR g := 0 TO fc.nkids - 1 DO
      IF fc.kids[g] IS SOME gc THEN
        IF gc.kids[0] IS SOME idc THEN n := n + idc.nkids END
      END
    END
  END ;
  out := NEW (pool, AKid, n + 1) ;
  n := 0 ;
  IF fields IS SOME fs THEN
    FOR g := 0 TO fs.nkids - 1 DO
      IF fs.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF n < LEN (out) THEN
              out[n] := grp.kids[1] ;
              n := n + 1
            END
          END
        END
      END
    END
  END ;
  RETURN out
END FlatFields ;

PROCEDURE Arity (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                 want: I64 ; got: I64) =
BEGIN
  IF want # got THEN
    ErrN (site, ctx, S5 (name, ' expects ', ItoA (want),
      ' argument(s), got ', ItoA (got)))
  END
END Arity ;

(* a RAISE's payload held to its EXCEPTION's fields, as a record
   aggregate's arguments are held to its fields (par 5): the count, and
   each value against its field's type.  Until 2026-10-09 nothing held
   it -- `RAISE Bad ('oops', 5)' against `Bad (code : I64 ; what : STR)'
   compiled and ran, each value landing in the slot of its OWN type, and
   `RAISE Bad (1, 2, 3)' against one field dropped two (found by the
   typed tree's measurement: the payload had no recorded types).  An
   exception with no declaration to read -- the predeclared, or one the
   checker does not know -- is left as it was. *)
PROCEDURE CheckRaisePayload (xn: PTR Ast.Node ; args: Ast.Kid ;
                             RO ctx: UTF) =
VAR
  decl : Ast.Kid ;
  owner, name, at, ft : UTF ;
  nf, na, k : I64 ;
  arg : Ast.Kid ;
BEGIN
  IF Text.BLen (xn.bu) > 0 THEN
    decl := ExcDeclOf (xn.au, xn.bu, owner) ;
    name := Cat (Cat (xn.au, '.'), xn.bu)
  ELSE
    decl := ExcDeclOf ('', xn.au, owner) ;
    name := xn.au
  END ;
  IF decl IS SOME d0 THEN
    nf := 0 ;
    WHILE ExcFieldType (decl, owner, nf) IS SOME f0 DO nf := nf + 1 END ;
    na := 0 ;
    IF args IS SOME al THEN na := al.nkids END ;
    (* the predeclared IndexError raised bare: its two fields are the
       synthetic declaration the handler binders read (they bind 0) *)
    IF na = 0 AND Text.BLen (owner) = 0 AND Text.Eq (name, 'IndexError') THEN
      RETURN
    END ;
    Arity (xn, ctx, name, nf, na) ;
    FOR k := 0 TO na - 1 DO
      IF k < nf THEN
        arg := NONE ;
        IF args IS SOME al2 THEN arg := al2.kids[k] END ;
        at := ExprType (arg, ctx) ;
        ft := CanonT (ExcFieldType (decl, owner, k), 0) ;
        at := AdaptLit (arg, ft, at) ;
        IF Text.BLen (at) > 0 AND Text.BLen (ft) > 0 AND NOT Compat (ft, at) THEN
          ErrN (xn, ctx, S5 ('field ', ItoA (k + 1), ' of ', name,
            S4 (': cannot give ', TyName (at), ' where ',
                Cat (TyName (ft), ' is expected'))))
        END
      END
    END
  END
END CheckRaisePayload ;

PROCEDURE IsTotalWideningTo64 (RO t: UTF) : BOOL =
BEGIN
  IF Text.Eq (t, 'C.Int') OR Text.Eq (t, 'C.SSizeT') THEN RETURN TRUE END ;
  IF Text.Eq (t, 'BYTE') THEN RETURN TRUE END ;
  IF Text.Eq (t, 'I8') OR Text.Eq (t, 'I16') OR Text.Eq (t, 'I32') THEN
    RETURN TRUE
  END ;
  RETURN Text.Eq (t, 'U8') OR Text.Eq (t, 'U16') OR Text.Eq (t, 'U32')
END IsTotalWideningTo64 ;

(* a conversion FROM an integer TO an enumeration (or a payload-less
   case record), the checked inverse of ORD: Colour (i) is the i-th
   member, and RAISES ValueRange when i is out of 0..n-1 -- the same
   discipline as I64 (x), because a tag that named no member would be
   the museum's Trunc(NaN) again.  Answers the canonical type name, or
   '' when `name' is not such a type. *)
PROCEDURE AllPayloadless (n: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF n IS SOME t THEN
    IF t.kind = Ast.NEnumType THEN RETURN TRUE END ;
    IF t.kind = Ast.NCaseRecordType THEN
      FOR i := 0 TO t.nkids - 1 DO
        IF t.kids[i] IS SOME v THEN
          IF v.kids[0] IS SOME vf THEN RETURN FALSE END
        END
      END ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END AllPayloadless ;

(* a value two of which no single operator compares: a slice, an
   array, a grid, a record, a monitor, a case record that carries a
   payload -- what the C has no == for *)
PROCEDURE IsComposite (RO t: UTF) : BOOL =
VAR
  dot : I64 ;
  md, ty : UTF ;
  k : Ast.Kid ;
BEGIN
  IF Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'ARRAY ') OR
     Text.StartsWith (t, 'GRID ') THEN
    RETURN TRUE
  END ;
  dot := Text.FindChar (t, '.') ;
  IF dot >= 0 THEN
    md := SLICE (t, 0, dot) ;
    ty := SLICE (t, dot + 1, Text.BLen (t) - dot - 1)
  ELSE
    md := '' ; ty := t
  END ;
  k := LookupTypeName (md, ty) ;
  IF k IS SOME n THEN
    IF n.kind = Ast.NRecordType OR n.kind = Ast.NMonitorType THEN
      RETURN TRUE
    END ;
    IF n.kind = Ast.NCaseRecordType THEN RETURN NOT AllPayloadless (k) END
  END ;
  RETURN FALSE
END IsComposite ;

PROCEDURE IsTagged (RO canon: UTF) : BOOL =
  (* the canonical name (Mod.Type) resolves to an enumeration or a
     case record -- a value CASE reaches by tag, which is exactly what
     NAME can name (docs/enum-plan.md, part 2) *)
VAR dot : I64 ;
BEGIN
  dot := Text.FindChar (canon, '.') ;
  IF dot < 0 THEN RETURN FALSE END ;
  IF LookupTypeName (SLICE (canon, 0, dot),
                     SLICE (canon, dot + 1, Text.BLen (canon) - dot - 1))
       IS SOME t THEN
    RETURN t.kind = Ast.NEnumType OR t.kind = Ast.NCaseRecordType
  END ;
  RETURN FALSE
END IsTagged ;

(* the canonical enumeration (or case-record) type an ARRAY bound
   names, or '' when the bound is an integer.  ARRAY Colour OF T is
   indexed by the type: its subscript is a member, not an ordinal, so
   the index check wants the enumeration here (docs/enum-plan.md,
   part 2). *)
PROCEDURE ArrEnumBoundOf (declN: Ast.Kid) : UTF =
VAR canon, was : UTF ;
BEGIN
  IF ResolveType (declN) IS SOME r THEN
    IF r.kind = Ast.NArrayType THEN
      IF r.kids[0] IS SOME b THEN
        IF b.kind = Ast.NDesignator THEN
          canon := '' ;
          (* a bare bound is the module's that declared the array:
             Guess.ByLandcover = ARRAY Landcover OF BOOL read in a
             module with a Landcover record of its own was indexed as
             an integer array (a port's report M9, until 2026-10-30) *)
          IF b.nkids = 0 THEN
            was := canonCtx ;
            IF Text.BLen (ResolvedMod ()) > 0 THEN canonCtx := Text.Keep (pool, ResolvedMod ()) END ;
            canon := CanonQual ('', b.au, 0) ;
            canonCtx := was
          ELSIF b.nkids = 1 THEN
            IF b.kids[0] IS SOME sf THEN
              IF sf.kind = Ast.NSelField THEN canon := CanonQual (b.au, sf.au, 0)
              END
            END
          END ;
          IF IsTagged (canon) THEN RETURN canon END
        END
      END
    END
  END ;
  RETURN ''
END ArrEnumBoundOf ;

PROCEDURE EnumConvType (RO name: UTF) : UTF =
VAR
  dot : I64 ;
  md, ty : UTF ;
BEGIN
  dot := Text.FindChar (name, '.') ;
  IF dot >= 0 THEN
    md := SLICE (name, 0, dot) ;
    ty := SLICE (name, dot + 1, Text.BLen (name) - dot - 1)
  ELSE
    (* a bare name is this module's type: another module's is written
       qualified.  The scan over every module found `Less (a, b)' -- a
       call through a parameter -- to be Sort's type Less (2026-10-22,
       item 12's measurement) *)
    md := curMod ; ty := name
  END ;
  IF AllPayloadless (LookupTypeName (md, ty)) THEN
    RETURN CanonQual (md, ty, 0)
  END ;
  RETURN ''
END EnumConvType ;

(* the procedure a misspelt callee meant when only its CASE differs --
   Io.Writeline for Io.WriteLine, the first thing a newcomer writes
   wrong (a notebook cell on the MacBook, 2026-10-05) -- qualified as
   the callee was; '' when there is none.  Case-sensitive names are a
   rule (CLAUDE.md, symbol tables); saying which name was meant costs
   nothing. *)
PROCEDURE EditDist (RO a, b: UTF) : I64 ;

PROCEDURE CaseTwin (RO callee: UTF) : UTF =
VAR
  dot, m, i, best, bd, d : I64 ;
  modName, procName, want : UTF ;
BEGIN
  dot := Text.FindChar (callee, '.') ;
  IF dot >= 0 THEN
    modName := SLICE (callee, 0, dot) ;
    procName := SLICE (callee, dot + 1, Text.BLen (callee) - dot - 1)
  ELSE
    modName := curMod ;
    procName := callee
  END ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN '' END ;
  want := Text.Lower (procName) ;
  FOR i := 0 TO mods[m].nprocs - 1 DO
    IF Text.Eq (Text.Lower (mods[m].procs[i].name), want) THEN
      IF dot >= 0 THEN RETURN S3 (modName, '.', mods[m].procs[i].name) END ;
      RETURN mods[m].procs[i].name
    END
  END ;
  (* or the NEAREST name -- at most two edits, and no more than a third
     of the name's length, case aside; the first so near in declaration
     order (2026-10-22, the review's tier 3: `Io.WriteLn' said only
     "unknown procedure") *)
  IF Text.BLen (procName) >= 4 THEN
    best := -1 ;
    bd := 3 ;
    FOR i := 0 TO mods[m].nprocs - 1 DO
      d := EditDist (want, Text.Lower (mods[m].procs[i].name)) ;
      IF d < bd AND d * 3 <= Text.BLen (procName) THEN bd := d ; best := i END
    END ;
    IF best >= 0 THEN
      IF dot >= 0 THEN RETURN S3 (modName, '.', mods[m].procs[best].name) END ;
      RETURN mods[m].procs[best].name
    END
  END ;
  RETURN ''
END CaseTwin ;

(* the Levenshtein distance of two names *)
PROCEDURE EditDist (RO a, b: UTF) : I64 =
VAR
  prev, cur : SLICE OF I64 ;
  i, j, c, x : I64 ;
BEGIN
  prev := NEW (I64, Text.BLen (b) + 1) ;
  cur := NEW (I64, Text.BLen (b) + 1) ;
  FOR j := 0 TO Text.BLen (b) DO prev[j] := j END ;
  FOR i := 1 TO Text.BLen (a) DO
    cur[0] := i ;
    FOR j := 1 TO Text.BLen (b) DO
      IF B (a, i - 1) = B (b, j - 1) THEN c := 0 ELSE c := 1 END ;
      x := prev[j - 1] + c ;
      IF prev[j] + 1 < x THEN x := prev[j] + 1 END ;
      IF cur[j - 1] + 1 < x THEN x := cur[j - 1] + 1 END ;
      cur[j] := x
    END ;
    FOR j := 0 TO Text.BLen (b) DO prev[j] := cur[j] END
  END ;
  RETURN prev[Text.BLen (b)]
END EditDist ;

(* what follows a name's first dot, or the name *)
PROCEDURE LastPart (RO name: UTF) : UTF =
VAR dot : I64 ;
BEGIN
  dot := Text.FindChar (name, '.') ;
  IF dot < 0 THEN RETURN name END ;
  RETURN SLICE (name, dot + 1, Text.BLen (name) - dot - 1)
END LastPart ;

(* the RECORD a callee names -- `Row' declared in this module, or
   `Mod.Row' in an imported one -- through aliases, or NONE; om the
   module that WROTE it (canonCtx) *)
PROCEDURE RecordNamed (RO name: UTF ; VAR om: UTF ; VAR canon: UTF) : Ast.Kid =
VAR
  dot, m : I64 ;
  t : Ast.Kid ;
BEGIN
  canon := '' ;
  dot := Text.FindChar (name, '.') ;
  IF dot > 0 THEN
    om := SLICE (name, 0, dot) ;
    m := FindMod (om) ;
    IF m < 0 THEN RETURN NONE END ;
    t := FindTypeIn (m, SLICE (name, dot + 1, Text.BLen (name) - dot - 1))
  ELSE
    om := curMod ;
    m := FindMod (curMod) ;
    IF m < 0 THEN RETURN NONE END ;
    t := FindTypeIn (m, name)
  END ;
  IF ResolveType (t) IS SOME r THEN
    IF r.kind = Ast.NRecordType THEN
      (* the type's canonical name: its own, or through an alias the
         record's -- what a variable declared with it is typed *)
      canon := Qualify (om, LastPart (name)) ;
      IF t IS SOME tn THEN
        IF tn.kind = Ast.NQualident THEN
          canonCtx := Text.Keep (pool, om) ;
          canon := CanonT (t, 0) ;
          canonCtx := ''
        END
      END ;
      RETURN SOME (r)
    END
  END ;
  RETURN NONE
END RecordNamed ;

PROCEDURE CallType (dn: Ast.Kid ; argl: Ast.Kid ; site: PTR Ast.Node ;
                    RO ctx: UTF) : UTF =
VAR
  name, pTy, amode, om, t, hint, hbMode, hroot : UTF ;
  nargs, j, g, k, kept, rank, dot, nflat, si, nFrameKept, iu : I64 ;
  nu : SLICE OF I64 ;
  aTy : SLICE OF UTF ;
  aNode : SLICE OF AKid ;
  flat : SLICE OF AKid ;
  pr : ProcInfo ;
  found, isVar, hbBeyond, roDes : BOOL ;
  fields, dty : Ast.Kid ;
BEGIN
  name := '' ;
  IF dn IS SOME d0 THEN name := DesigName (d0) ELSE RETURN '' END ;
  nargs := 0 ;
  IF argl IS SOME al0 THEN nargs := al0.nkids END ;
  aTy := NEW (UTF, nargs + 1) ;     (* the frame: its types die with the call *)
  aNode := NEW (pool, AKid, nargs + 1) ;
  IF argl IS SOME al1 THEN
    (* MAX (I64), SizeOf (T): a type is the argument; LEN refuses one
       in its own words (probe len-of-type) *)
    typeArgOk := Text.Eq (name, 'MAX') OR Text.Eq (name, 'SizeOf') OR
                 Text.Eq (name, 'LEN') ;
    FOR j := 0 TO nargs - 1 DO
      aNode[j] := al1.kids[j] ;
      aTy[j] := ExprType (al1.kids[j], ctx)
    END ;
    typeArgOk := FALSE
  END ;

  (* the UTF builtins (docs/utf8-plan.md, U2) *)
  IF nargs = 1 AND UtfName (name) THEN
    RETURN UtfConvType (site, ctx, name, aTy[0])
  END ;
  IF nargs = 2 AND Text.Eq (name, 'UTF') AND UtfName (name) THEN
    (* the pool as NEW takes it: a POOL, or a VAR pointer parameter whose
       object's pool it is (rule 2) -- a clone's strings join the pool
       their tree lives in *)
    IF Text.BLen (aTy[0]) > 0 AND NOT Text.Eq (aTy[0], 'POOL') AND
       NOT ObjPoolArg (aNode[0]) THEN
      ErrN (site, ctx, Cat ('UTF (pool, x) takes the pool first, not ', TyName (aTy[0])))
    END ;
    RETURN UtfConvType (site, ctx, name, aTy[1])
  END ;
  IF nargs = 1 THEN name := ScalarAlias (name) END ;
  IF nargs >= 1 THEN
    g := 0 ;
    k := 0 ;
    FOR j := 0 TO nargs - 1 DO
      IF Text.Eq (aTy[j], 'F32') THEN g := g + 1 END ;
      IF Text.Eq (aTy[j], 'F64') THEN k := k + 1 END
    END ;
    name := WidthTwin (name, g > 0 AND k = 0) ;
    g := 0 ;
    FOR j := 0 TO nargs - 1 DO
      IF UtfVotes (aTy[j]) THEN g := g + 1 END
    END ;
    name := UtfTwin (name, g > 0) ;
    NoteStale (site.line, name)
  END ;
  IF IsConvVR (name) THEN
    (* I64 of a NARROWER integer is TOTAL and must not be made to
       declare a ValueRange nobody can trigger *)
    IF Text.Eq (name, 'I64') AND nargs = 1 THEN
      IF IsTotalWideningTo64 (aTy[0]) THEN
        Arity (site, ctx, name, 1, nargs) ;
        RETURN 'I64'
      END
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    IF Text.Eq (name, 'CHR') THEN RETURN 'CHAR' END ;
    RETURN name
  END ;
  IF Text.Eq (name, 'ADR') THEN
    IF NOT curUnsafe THEN
      ErrN (site, ctx, 'ADR exists only inside UNSAFE modules')
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    (* a C pointer, fitting any C.*Ptr parameter and nothing else:
       until 2026-10-09 it answered no type, and every ADR argument
       of every foreign call -- 225 across the library, the last
       passed-over class on the review pages -- went unexamined *)
    (* of read-only storage -- a literal, a CONST, what an RO parameter,
       field or answer lends, OCTETS -- or of a UTF, whose octets are
       valid UTF-8 only while nobody writes them: a const pointer, which
       no C.MutPtr parameter takes.  ADR's one pointer fitting both let
       a literal's octets reach memset (SIGBUS) and C write 0xFF under a
       UTF (the third review's trust T4, T6, 2026-10-26) *)
    (* of a VARIABLE whose type holds a reference -- a record with a
       slice, a UTF, a pointer -- C can write a reference no assignment
       shows, and the region judgement read such an answer as module
       storage: AdoptUtf8 of frame bytes kept in a module UTF was a
       heap-use-after-free (the second review's S9).  Allowed where the
       procedure states its answer's storage, [FRESH] (the third review's
       trust advice; Io.ReadFileUtf is the one site) *)
    IF nargs = 1 AND NOT curFresh THEN
      IF NOT Text.StartsWith (aTy[0], 'SLICE OF ') AND NOT Text.StartsWith (aTy[0], 'ARRAY ') AND
         NOT Text.StartsWith (aTy[0], 'GRID ') AND NOT Text.Eq (aTy[0], UtfTy) AND
         Text.BLen (aTy[0]) > 0 AND TyBearing (aTy[0]) THEN
        ErrN (site, ctx, S3 ('ADR of a variable of type ', TyName (aTy[0]),
          ', which holds a reference: C can write one no assignment shows -- state where the answer lives with [FRESH] on the procedure, or hand C a slice (par 7)'))
      END
    END ;
    IF nargs = 1 THEN
      IF Text.BLen (RoWhatOf (aNode[0])) > 0 OR Text.Eq (aTy[0], UtfTy) THEN
        NoteAdr (site.line, 'reads') ;
        RETURN 'C.ConstPtr'
      END ;
      IF curFresh AND NOT Text.StartsWith (aTy[0], 'SLICE OF ') AND NOT Text.StartsWith (aTy[0], 'ARRAY ') AND
         NOT Text.StartsWith (aTy[0], 'GRID ') AND Text.BLen (aTy[0]) > 0 AND TyBearing (aTy[0]) THEN
        NoteAdr (site.line, 'descriptor ([FRESH])')
      ELSE
        NoteAdr (site.line, 'writes or reads')
      END
    END ;
    RETURN 'C.Ptr'
  END ;
  IF Text.Eq (name, 'F32') OR Text.Eq (name, 'F64') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN name
  END ;
  IF Text.Eq (name, 'COPY') THEN
    (* COPY (to, from): a block copy (docs/blockcopy-plan.md, Alex
       2026-10-22) *)
    Arity (site, ctx, name, 2, nargs) ;
    IF nargs = 2 THEN CheckCopy (site, ctx, aTy[0], aTy[1], aNode[0]) END ;
    RETURN '<void>'
  END ;
  IF Text.Eq (name, 'LEN') THEN
    IF nargs = 2 THEN
      IF GridRank (aTy[0]) = 0 THEN
        ErrN (site, ctx, Cat ('LEN takes an axis only on a GRID, not on ',
          TyName (aTy[0])))
      END ;
      IF NOT IsIntish (aTy[1]) THEN
        ErrN (site, ctx, Cat ('LEN axis must be an integer, not ',
          TyName (aTy[1])))
      END ;
      IF GridRank (aTy[0]) > 0 THEN
        IF aNode[1] IS SOME an1 THEN
          IF an1.kind = Ast.NInt THEN
            IF AtoI (an1.au) >= GridRank (aTy[0]) THEN
              ErrN (site, ctx, S4 ('axis ', an1.au, ' of a ',
                Cat (aTy[0], ' does not exist')))
            END
          END
        END
      END ;
      RETURN 'I64'
    END ;
    IF GridRank (aTy[0]) > 0 THEN
      ErrN (site, ctx, 'LEN of a GRID needs an axis: LEN (g, 0)')
    END ;
    IF Text.Eq (aTy[0], UtfTy) THEN
      ErrN (site, ctx, 'LEN of a UTF -- Text.BLen (u) for its bytes, Text.CpCount (u) for its characters')
    END ;
    IF nargs = 1 THEN
      IF aNode[0] IS SOME lnd THEN
        IF lnd.kind = Ast.NDesignator THEN
          (* the declared type the typed tree recorded when the argument
             was typed (stage 1), never a second walk: a walk counts the
             operands of the subscripts again (Xml's page read one more) *)
          IF lnd.nkids = 0 THEN dty := ScopeType (lnd.au)
          ELSIF lnd.kids[lnd.nkids - 1] IS SOME lst THEN dty := Ast.TypeAt (lst.id)
          ELSE dty := NONE END ;
          IF NamesStr (dty) THEN
            StrScan (site, 'len', Print.ExprTextUtf (aNode[0]))
          END
        ELSIF lnd.kind = Ast.NString THEN
          StrScan (site, 'len', 'a literal')
        END
      END
    END ;
    (* LEN of a scalar, or of a type: the generator refused both, as
       `unknown name: I64' or an unsupported form (the review's F4) *)
    IF nargs = 1 THEN
      IF IsBuiltinTy (aTy[0]) OR Text.Eq (aTy[0], '<int>') OR
         Text.Eq (aTy[0], '<real>') THEN
        ErrN (site, ctx, Cat ('LEN takes an array, slice, grid or string, not ',
          TyName (aTy[0])))
      ELSIF LenOfType (aNode[0]) THEN
        IF aNode[0] IS SOME an0 THEN
          ErrN (site, ctx, Cat ('LEN takes a value, not the type ', an0.au))
        END
      END
    END ;
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'ORD') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'NAME') THEN
    (* the identifier text of an enumeration member (or any
       payload-less case record variant), as a STR: NAME (Colour.Red)
       is 'Red'.  The argument must be one of those types -- its
       canonical form is nominal, and a value that CASE reaches by
       tag is exactly what has a name (docs/enum-plan.md, part 2) *)
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 AND NOT IsTagged (aTy[0]) THEN
      IF Text.BLen (aTy[0]) > 0 THEN
        ErrN (site, ctx, S3 ('NAME needs an enumeration or a case ',
          'record, not ', TyName (aTy[0])))
      END
    END ;
    RETURN StrLitTy ()
  END ;
  IF Text.Eq (name, 'VIEW') THEN
    IF nargs < 2 THEN
      ErrN (site, ctx, 'VIEW needs a grid and one argument per axis') ;
      RETURN ''
    END ;
    rank := GridRank (aTy[0]) ;
    IF rank = 0 THEN
      IF Text.BLen (aTy[0]) > 0 THEN
        ErrN (site, ctx, Cat ('VIEW needs a GRID, not ', TyName (aTy[0])))
      END ;
      RETURN ''
    END ;
    IF nargs - 1 # rank THEN
      ErrN (site, ctx, S5 ('a ', aTy[0], ' needs ', ItoA (rank),
        Cat (' axis arguments, not ', ItoA (nargs - 1)))) ;
      RETURN ''
    END ;
    kept := 0 ;
    FOR j := 1 TO nargs - 1 DO
      IF Text.Eq (aTy[j], '<all>') THEN
        kept := kept + 1
      ELSE
        IF NOT IsIntish (aTy[j]) THEN
          ErrN (site, ctx, Cat ('a VIEW axis is an index or ALL, not ',
            TyName (aTy[j])))
        END
      END
    END ;
    IF kept = 0 THEN
      ErrN (site, ctx,
        'a VIEW that keeps no axis is an index: write the subscripts') ;
      RETURN ''
    END ;
    RETURN GridOf (kept, AfterOf (aTy[0]))
  END ;
  IF Text.Eq (name, 'MAX') THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 THEN
      IF aNode[0] IS SOME a0 THEN
        IF a0.kind = Ast.NDesignator THEN
          IF a0.nkids = 0 THEN
            IF IsBuiltinTy (a0.au) THEN RETURN a0.au END
          END
        END
      END
    END ;
    RETURN ''
  END ;
  (* SizeOf (x): the byte size of x's type (I64); a type name or a
     value.  A slice's SizeOf is its descriptor, the data is
     ByteSize.  In-memory only -- a wire uses the exact-width types
     and ToBytesLE. *)
  IF Text.Eq (name, 'SizeOf') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'ByteSize') THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs >= 1 AND Text.BLen (aTy[0]) > 0 AND
       NOT Text.StartsWith (aTy[0], 'SLICE OF ') THEN
      ErrN (site, ctx, Cat ('ByteSize needs a slice, not ', TyName (aTy[0])))
    END ;
    RETURN 'I64'
  END ;
  IF Text.Eq (name, 'F64.FromBytesLE') OR
     Text.Eq (name, 'F32.FromBytesLE') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN SLICE (name, 0, 3)
  END ;
  IF Text.Eq (name, 'F64.ToBytesLE') OR
     Text.Eq (name, 'F32.ToBytesLE') THEN
    Arity (site, ctx, name, 2, nargs) ;
    RETURN '<void>'
  END ;
  IF Text.StartsWith (name, 'C.') THEN
    Arity (site, ctx, name, 1, nargs) ;
    RETURN name
  END ;

  (* a call THROUGH A PROCEDURE VALUE (par 2.2.3): a parameter or an
     IS SOME binder whose type is a procedure type.  The type's own
     head stands in for the callee's declaration and the same checks
     run over it; nothing is known about which procedure runs, so a
     PURE body may not make the call. *)
  found := FALSE ;
  si := ScopeFind (name) ;
  IF si >= 0 THEN
    IF ResolveType (scope[si].ty) IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        IF curPure THEN
          ErrN (site, ctx, S3 ('PURE procedure calls through the procedure value ',
            name, ' (par 3.2)'))
        END ;
        pr.node := SOME (ptn) ;
        pr.modName := '' ;
        pr.foreign := '' ;
        pr.name := '' ;
        pr.body := NONE ;          (* nothing is known of which body runs *)
        IF scope[si].ty IS SOME tq THEN
          IF tq.kind = Ast.NQualident THEN
            IF Text.BLen (tq.bu) > 0 THEN pr.modName := tq.au END
          END
        END ;
        found := TRUE
      END
    END
  END ;
  IF NOT found THEN pr := LookupProc (name, found) END ;
  IF found THEN
    IF pr.node IS SOME pn THEN
      canonCtx := pr.modName ;
      Arity (site, ctx, name, CountParams (pn.kids[0]), nargs) ;
      IF nargs > 0 THEN SameMonitorCall (ctx, name, pn, aNode[0]) END ;
      (* and what the call may reach: a procedure bound to a monitor of
         this procedure's type, two calls down or through an unbound
         helper (the reviews' S11: N30, N30b hung).  The direct call on
         the bound parameter itself is SameMonitorCall's *)
      IF boundMonId >= 0 AND NOT SameMonDirect (pn, aNode, nargs) THEN
        IF MonReach (pr, boundMonId) THEN
          ErrN (site, ctx, S3 ('a call of ', name, ' may enter a monitor of the type this procedure is bound to and holds the lock of: on the same monitor it waits for ever, on another of its type two threads can take the two in opposite orders -- take what the callee needs out of the monitor first, or make the call from a procedure that is not bound (par 6)'))
        ELSIF MonCycle (pr, boundMonId) THEN
          ErrN (site, ctx, S3 ('a call of ', name, ' may enter a monitor of another type while this procedure holds its own, and a procedure bound to that type may enter one of this type: two threads can take the two locks in opposite orders -- take what the callee needs out of the monitor first, or make the call from a procedure that is not bound (par 6)'))
        ELSIF MonWaits (pr) THEN
          ErrN (site, ctx, S3 ('a call of ', name, ' may WAIT on another monitor while this procedure holds its own: the wait releases only that one, and what would SIGNAL it may need the lock held here -- wait from a procedure that is not bound (par 6)'))
        END
      END ;
      (* how many VAR or KEPT arguments are FRAME values: a frame value
         handed to a KEPT parameter is refused (it dies with this
         frame), unless another frame value is the keeper -- a node
         linked under a node of the same frame lives exactly as long
         as it does.  `Set (obj, name, v)` on two fresh nodes is the
         shape (docs/pool-elision-plan.md, stage 2). *)
      nFrameKept := 0 ;
      k := 0 ;
      IF pn.kids[0] IS SOME pl0 THEN
        FOR g := 0 TO pl0.nkids - 1 DO
          IF pl0.kids[g] IS SOME grp0 THEN
            IF grp0.kids[0] IS SOME ids0 THEN
              FOR j := 0 TO ids0.nkids - 1 DO
                IF k < nargs THEN
                  IF grp0.f1 OR grp0.f2 OR grp0.f4 THEN
                    IF Text.BLen (FrameWhat (aNode[k], aTy[k])) > 0 THEN
                      nFrameKept := nFrameKept + 1
                    END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      k := 0 ;
      IF pn.kids[0] IS SOME pl THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            pTy := CanonT (grp.kids[1], 0) ;
            isVar := grp.f1 OR grp.f2 ;
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF k < nargs THEN
                  ConstArg (site, ctx, name, k, aNode[k], isVar, grp.f3) ;
                  IF NOT isVar AND NOT grp.f3 THEN
                    RoArg (site, ctx, name, k, aNode[k], pTy, aTy[k])
                  END ;
                  CheckArg (site, ctx, name, k, pTy, aTy[k], aNode[k],
                            isVar, grp.f2, grp.f4, nFrameKept,
                            grp.f1 AND PtrParamTy (grp.kids[1]) AND
                            Text.BLen (pr.foreign) = 0,
                            grp.f1 AND AllocsThrough (pr, k), argl)
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      (* decision 81: an RO argument that names storage, when the callee
         and all it calls provably write no module state -- the generator
         may then pass one held in a module variable by its address *)
      roDes := FALSE ;
      k := 0 ;
      IF pn.kids[0] IS SOME pl1 THEN
        FOR g := 0 TO pl1.nkids - 1 DO
          IF pl1.kids[g] IS SOME grp1 THEN
            IF grp1.kids[0] IS SOME ids1 THEN
              FOR j := 0 TO ids1.nkids - 1 DO
                IF k < nargs AND grp1.f3 THEN
                  IF aNode[k] IS SOME an1 THEN
                    IF an1.kind = Ast.NDesignator THEN roDes := TRUE END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      IF roDes THEN
        IF argl IS SOME alr THEN
          IF NoStateWrite (Qualify (pr.modName, pr.name), FindMod (pr.modName), pr.body) THEN
            Ast.SetNoWrites (alr.id)
          END
        END
      END ;
      (* par 4.2: a name moved into an OWN parameter is not also lent
         in the same call (2026-10-21, the compiler review's C7): `Use
         (p, p)' with the first OWN handed the callee one object to
         DISPOSE and to read, a use after free under ASan.  Any other
         argument whose root is the name and whose type carries a
         reference is refused; a scalar read out of it (`p.n') is
         copied before the call and stays legal. *)
      k := 0 ;
      IF pn.kids[0] IS SOME plo THEN
        FOR g := 0 TO plo.nkids - 1 DO
          IF plo.kids[g] IS SOME grpo THEN
            IF grpo.kids[0] IS SOME idso THEN
              FOR j := 0 TO idso.nkids - 1 DO
                IF k < nargs AND grpo.f2 THEN
                  IF aNode[k] IS SOME ao THEN
                    IF ao.kind = Ast.NDesignator AND ao.nkids = 0 THEN
                      FOR iu := 0 TO nargs - 1 DO
                        IF iu # k THEN
                          IF Text.Eq (EscRootOf (aNode[iu]), ao.au) AND
                             TyBearing (aTy[iu]) THEN
                            ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
                              S5 (': ', ao.au, ' is moved into an OWN parameter and lent as argument ',
                                  ItoA (iu + 1), ' of the same call (par 4.2)')))
                          END
                        END
                      END
                    END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END ;
      (* par 4.1, the hand-back: a VAR argument whose parameter the
         callee fills with a view of another argument (HandsBack)
         now holds that borrow, exactly as the left side of `tg :=
         SLICE (svg, a, n)' would -- carried by a local, pended
         beyond the frame, an escape fact in frame storage.  The
         callee declares nothing: `NextTag (svg, i, tg)' hands svg
         back through tg, and whether tg then outlives the frame is
         this frame's business (2026-10-18). *)
      IF Text.BLen (pr.foreign) = 0 THEN
        k := 0 ;
        IF pn.kids[0] IS SOME pl2 THEN
          FOR g := 0 TO pl2.nkids - 1 DO
            IF pl2.kids[g] IS SOME grp2 THEN
              IF grp2.kids[0] IS SOME ids2 THEN
                FOR j := 0 TO ids2.nkids - 1 DO
                  IF k < nargs AND grp2.f1 AND NOT grp2.f2 THEN
                    IF aNode[k] IS SOME ak THEN
                      IF ak.kind = Ast.NDesignator THEN
                        hbMode := ScopeMode (ak.au) ;
                        hbBeyond := DerefBeyond (ak) ;
                        FOR iu := 0 TO nargs - 1 DO
                          IF iu # k THEN
                            hroot := EscRootOf (aNode[iu]) ;
                            IF Text.BLen (hroot) > 0 AND TyBearing (aTy[iu]) AND
                               HandsBackFrom (Qualify (pr.modName, pr.name), pr, k, iu) THEN
                              (* beyond the frame when our designator
                                 crosses a reference, or the callee's
                                 store did (`n.kids[k] := sel' through
                                 `VAR n: PTR Node') *)
                              StoreRef (site, ak, hroot,
                                hbBeyond OR HandsBackDeep (Qualify (pr.modName, pr.name), pr, k, iu),
                                hbMode, ctx)
                            END
                          END
                        END
                      END
                    END
                  END ;
                  k := k + 1
                END
              END
            END
          END
        END
      END ;
      pTy := '' ;
      IF pn.kids[1] IS SOME rt THEN pTy := CanonT (pn.kids[1], 0) END ;
      canonCtx := '' ;
      IF Text.BLen (pTy) > 0 THEN RETURN pTy END ;
      IF pn.kids[1] IS SOME rt2 THEN RETURN '' END ;
      RETURN '<void>'
    END ;
    RETURN ''
  END ;

  (* a variant constructor with payload: Type.Variant (args), or
     Mod.Type.Variant (args) from another module.  The three-part
     form was read as a two-part one -- type `Csv', variant
     `Kind.Stamp' -- and refused as `unknown procedure: Csv' until
     2026-09-15; nobody had written one, so nothing knew.  With a
     module named, the variant is looked for THERE and nowhere else:
     that is what the qualification says. *)
  dot := Text.FindChar (name, '.') ;
  isVar := FALSE ;
  IF dot > 0 THEN
    t := SLICE (name, dot + 1, Text.BLen (name) - dot - 1) ;
    g := Text.FindChar (t, '.') ;
    IF g > 0 THEN
      om := SLICE (name, 0, dot) ;
      isVar := TryVariantMod (FindMod (om), SLICE (t, 0, g),
                              SLICE (t, g + 1, Text.BLen (t) - g - 1),
                              om, fields) ;
      t := SLICE (t, 0, g)
    ELSE
      isVar := FindVariant (SLICE (name, 0, dot), t, om, fields) ;
      t := SLICE (name, 0, dot)
    END
  END ;
  IF isVar THEN
    flat := FlatFields (fields, nflat) ;
    Arity (site, ctx, name, nflat, nargs) ;
    (* a copy: om views the call's own text, and canonCtx is module
       state (par 4.1, 2026-10-18) *)
    canonCtx := Text.Keep (pool, om) ;
    FOR k := 0 TO nargs - 1 DO
      IF k < nflat THEN
        pTy := CanonT (flat[k], 0) ;
        aTy[k] := AdaptLit (aNode[k], pTy, aTy[k]) ;
        Agree (StArg, pTy, aTy[k], site.line) ;
        IF NOT Compat (pTy, aTy[k]) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S4 (': cannot pass ', TyName (aTy[k]), ' where ',
                Cat (TyName (pTy), ' is expected'))))
        END
      END
    END ;
    canonCtx := '' ;
    RETURN Qualify (om, t)
  END ;
  t := EnumConvType (name) ;
  IF Text.BLen (t) > 0 THEN
    Arity (site, ctx, name, 1, nargs) ;
    IF nargs = 1 AND NOT IsIntish (aTy[0]) THEN
      ErrN (site, ctx, S4 ('argument 1 of ', name,
        ': cannot convert ', Cat (TyName (aTy[0]),
          ' to an enumeration; an integer position is expected')))
    END ;
    RETURN t
  END ;
  (* a RECORD AGGREGATE: Row (200, 'OK'), or Mod.Row (...) for an
     imported type -- every field, in declaration order, each held to
     its field's type (report par 2.2.4, Alex 2026-10-05: positional,
     in a CONST and in statements) *)
  IF RecordNamed (name, om, t) IS SOME rn THEN
    IF rn.kids[0] IS SOME rbase THEN
      ErrN (site, ctx, S3 (name, ': an aggregate of an extended record is',
        ' not built; give its fields one by one (par 2.2.4)')) ;
      RETURN t
    END ;
    flat := FlatFields (rn.kids[1], nflat) ;
    Arity (site, ctx, name, nflat, nargs) ;
    canonCtx := Text.Keep (pool, om) ;
    FOR k := 0 TO nargs - 1 DO
      IF k < nflat THEN
        pTy := CanonT (flat[k], 0) ;
        aTy[k] := AdaptLit (aNode[k], pTy, aTy[k]) ;
        Agree (StArg, pTy, aTy[k], site.line) ;
        IF NOT Compat (pTy, aTy[k]) THEN
          ErrN (site, ctx, S5 ('field ', ItoA (k + 1), ' of ', name,
            S4 (': cannot give ', TyName (aTy[k]), ' where ',
                Cat (TyName (pTy), ' is expected'))))
        END
      END
    END ;
    canonCtx := '' ;
    RETURN t
  END ;
  hint := CaseTwin (name) ;
  (* the arguments were typed above, and what was wrong in them said:
     the walk that follows is quiet for this list, as the Pascal twin
     types them once (CheckFuzz, 2026-10-11: `Nosuch (r.at)' said `no
     field at' twice) *)
  IF argl IS SOME ual THEN
    IF nunkArgs = LEN (unkArgs) THEN
      nu := NEW (pool, I64, 2 * nunkArgs + 16) ;
      FOR iu := 0 TO nunkArgs - 1 DO nu[iu] := unkArgs[iu] END ;
      unkArgs := nu
    END ;
    unkArgs[nunkArgs] := ual.id ;
    nunkArgs := nunkArgs + 1
  END ;
  IF Text.BLen (hint) > 0 THEN
    ErrN (site, ctx, S4 ('unknown procedure: ', name, ' -- did you mean ', Cat (hint, '?')))
  ELSE
    ErrN (site, ctx, Cat ('unknown procedure: ', name))
  END ;
  RETURN ''
END CallType ;

(* is the pool P itself one of a call's arguments?  Then the callee
   keeps in P what it keeps, and a value living in P may be handed to
   its KEPT parameter: `PutS (sp, o, k, v)` with o IN sp *)
PROCEDURE PoolAmong (args: Ast.Kid ; RO p: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF Text.BLen (p) = 0 THEN RETURN FALSE END ;
  IF args IS SOME al THEN
    FOR i := 0 TO al.nkids - 1 DO
      IF al.kids[i] IS SOME a THEN
        IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, p) THEN
          RETURN TRUE
        END
      END
    END
  END ;
  RETURN FALSE
END PoolAmong ;

(* one argument against one parameter: type, mode, and the two par 4
   rules that are pure checks rather than flow *)
(* par 4.1, one root handed to a KEPT parameter: a borrow is a
   retention the caller must declare in turn (and justifies its own
   KEPT); a frame-mode root escapes to the callee *)
PROCEDURE KeptRoot (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                    k: I64 ; RO KEPT aroot: UTF) =
VAR amode : UTF ;
BEGIN
  amode := ScopeMode (aroot) ;
  IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
     Text.Eq (amode, ModeRo) THEN
    KeptUse (aroot) ;
    IF NOT KeptHas (aroot) THEN
      ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
        S5 (': borrowed ', aroot,
            ' is kept by the callee -- declare KEPT ', aroot,
            ' (par 4.1)')))
    END
  END ;
  IF IsFrameMode (amode) THEN
    EscTarget (aroot, '<call>')
  END
END KeptRoot ;

(* par 4.1 for a POOL handed to a KEPT parameter.  The callee keeps
   what it allocates there past the call -- the region walk reads a
   KEPT pool as the module's -- so the pool must outlive the callee's
   state: KeptRoot's rule for a reference, applied to the pool by the
   root of its designator.  HEAP and a module's pools outlive it; a
   pool reached from a parameter is a borrow the caller declares KEPT
   in turn; a local pool, or a pool field of a local, a binder or an
   owned object, may die first and is refused (2026-10-28: `Grow
   (scratch)' left a module variable in a freed block, which the next
   local pool reused) *)
PROCEDURE KeptPool (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                    k: I64 ; an: Ast.Kid) =
VAR amode, why : UTF ;
BEGIN
  IF ParenCore (an) IS SOME a THEN
    IF a.kind # Ast.NDesignator THEN RETURN END ;
    IF Text.Eq (a.au, 'HEAP') AND a.nkids = 0 THEN RETURN END ;
    amode := ScopeMode (a.au) ;
    IF Text.BLen (amode) = 0 OR Text.Eq (amode, ModeModule) THEN RETURN END ;
    IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
       Text.Eq (amode, ModeRo) THEN
      KeptRoot (site, ctx, name, k, a.au) ;
      RETURN
    END ;
    IF Text.Eq (amode, ModeOwn) OR OwnedCandKind (a.au) > 0 THEN
      why := S3 ('it dies when ', a.au, ' is disposed')
    ELSIF Text.Eq (amode, ModeBinder) THEN
      why := 'where it lives is not known here'
    ELSE
      why := 'it dies with this frame'
    END ;
    ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
      S4 (': a KEPT parameter cannot take the pool ', DesigName (a),
          Cat (' -- ', why),
          " (par 4.1); give it a pool that outlives the call: HEAP, a module's pool, or a POOL parameter declared KEPT")))
  END
END KeptPool ;

(* a procedure bound to a monitor holds its lock for the whole body
   (par 6, decision 10), and the lock is not recursive: calling another
   procedure bound to the SAME monitor -- the bound parameter handed on
   as the callee's first argument -- waits for a lock this procedure
   holds, for ever.  m9downloadstats' RespCache.LookupB calling
   SameKey (g, ...) hung on its first cached lookup, sampled in
   pthread_mutex_lock (2026-10-25; Alex: "yes for the bound refusal") *)
(* the monitor TYPE a procedure is bound to -- its first parameter's,
   resolved through pointers -- as the type node's id, -1 when it is
   bound to none.  By node, not by name: the same type from two modules
   is one node *)
PROCEDURE MonIdOf (d: PTR Ast.Node ; RO modn: UTF) : I64 =
VAR
  rt : Ast.Kid ;
  was : UTF ;
  r : I64 ;
BEGIN
  r := -1 ;
  was := canonCtx ;
  canonCtx := Text.Keep (pool, modn) ;
  IF d.kids[0] IS SOME pl THEN
    IF pl.nkids > 0 THEN
      IF pl.kids[0] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          IF ids.nkids > 0 THEN
            rt := ResolveType (grp.kids[1]) ;
            WHILE rt IS SOME rr DO
              IF rr.kind = Ast.NPtrType OR rr.kind = Ast.NSharedType THEN
                rt := ResolveType (rr.kids[0])
              ELSE
                IF rr.kind = Ast.NMonitorType THEN r := rr.id END ;
                rt := NONE
              END
            END
          END
        END
      END
    END
  END ;
  canonCtx := was ;
  RETURN r
END MonIdOf ;

PROCEDURE MonReach (pr: ProcInfo ; mon: I64) : BOOL ;

PROCEDURE MonReachWalk (k: Ast.Kid ; RO modn: UTF ; mon: I64) : BOOL =
VAR
  i : I64 ;
  cpr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          cpr := ProcNamed (modn, DesigName (dn), found) ;
          IF found AND Text.BLen (cpr.foreign) = 0 THEN
            IF MonReach (cpr, mon) THEN RETURN TRUE END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF MonReachWalk (e.kids[i], modn, mon) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END MonReachWalk ;

(* may a call of pr enter a monitor of the type mon -- pr bound to one,
   or a procedure it calls, at any depth?  Memoised as `mon N Mod.Proc'
   in the iterating memo (a cycle answers the same in any order).  A
   call through a procedure value is not followed: nothing is known of
   which body runs (the reviews' S11, owed for values) *)
PROCEDURE MonReach (pr: ProcInfo ; mon: I64) : BOOL =
VAR
  i : I64 ;
  key : UTF ;
  r : BOOL ;
BEGIN
  key := Text.Keep (pool, S4 ('mon ', ItoA (mon), ' ', Qualify (pr.modName, pr.name))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  r := FALSE ;
  IF pr.node IS SOME pn THEN
    IF MonIdOf (pn, pr.modName) = mon THEN r := TRUE END
  END ;
  IF NOT r THEN
    IF pr.body IS SOME b THEN
      IF b.nkids > 4 THEN r := MonReachWalk (b.kids[4], pr.modName, mon) END
    END
  END ;
  IF r THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN r
END MonReach ;

(* may a call of pr WAIT -- its body, or a procedure it calls, at any
   depth?  Called while another monitor is held, the wait releases only
   its own lock, and what would SIGNAL it may need the one held (the
   fourth review's NestWait: holding A, waiting on B, the signaller first
   taking A).  Memoised as `waits Mod.Proc' *)
PROCEDURE MonWaits (pr: ProcInfo) : BOOL ;

PROCEDURE MonWaitWalk (k: Ast.Kid ; RO modn: UTF) : BOOL =
VAR
  i : I64 ;
  cpr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NWait THEN RETURN TRUE END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          cpr := ProcNamed (modn, DesigName (dn), found) ;
          IF found AND Text.BLen (cpr.foreign) = 0 THEN
            IF MonWaits (cpr) THEN RETURN TRUE END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF MonWaitWalk (e.kids[i], modn) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END MonWaitWalk ;

PROCEDURE MonWaits (pr: ProcInfo) : BOOL =
VAR
  i : I64 ;
  key : UTF ;
  r : BOOL ;
BEGIN
  key := Text.Keep (pool, Cat ('waits ', Qualify (pr.modName, pr.name))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  r := FALSE ;
  IF pr.body IS SOME b THEN
    IF b.nkids > 4 THEN r := MonWaitWalk (b.kids[4], pr.modName) END
  END ;
  IF r THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN r
END MonWaits ;

(* a lock-order cycle: pr, called from a procedure bound to a monitor of
   type mon, may enter a monitor of another type, and some procedure bound
   to that type may enter one of type mon -- two threads take the two locks
   in opposite orders (the fourth review's Abba: a deadlock, 3 of 3) *)
PROCEDURE MonCycle (pr: ProcInfo ; mon: I64) : BOOL =
VAR m, i, t : I64 ;
BEGIN
  FOR m := 0 TO nmods - 1 DO
    FOR i := 0 TO mods[m].nprocs - 1 DO
      IF mods[m].procs[i].node IS SOME qn THEN
        t := MonIdOf (qn, mods[m].name) ;
        IF t >= 0 AND t # mon THEN
          IF MonReach (pr, t) THEN
            IF MonReach (mods[m].procs[i], mon) THEN RETURN TRUE END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END MonCycle ;

(* SameMonitorCall's case: the bound parameter itself handed to a bound
   callee -- said there, not again *)
PROCEDURE SameMonDirect (callee: PTR Ast.Node ; RO aNode: SLICE OF AKid ; nargs: I64) : BOOL =
BEGIN
  IF nargs = 0 OR Text.BLen (boundMon) = 0 THEN RETURN FALSE END ;
  IF aNode[0] IS SOME a THEN
    RETURN a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, boundMon) AND
           Text.BLen (BoundMonitorOf (callee)) > 0
  END ;
  RETURN FALSE
END SameMonDirect ;

PROCEDURE SameMonitorCall (RO ctx: UTF ; RO name: UTF ; callee: PTR Ast.Node ; a0: Ast.Kid) =
BEGIN
  IF Text.BLen (boundMon) = 0 THEN RETURN END ;
  IF a0 IS SOME a THEN
    IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, boundMon) AND
       Text.BLen (BoundMonitorOf (callee)) > 0 THEN
      ErrN (a, ctx, S5 (name, ' is bound to the monitor ', boundMon,
        ', which this procedure is bound to and holds the lock of: the call waits for that lock for ever',
        ' -- pass what it needs instead of the monitor, or call it from a procedure that is not bound (par 6)'))
    END
  END
END SameMonitorCall ;

(* a FOR's control variable is written by the loop alone (par 2.1;
   Alex, 2026-10-25: "refuse"): assigned bare, or handed to a VAR or
   OWN parameter, inside a FOR over it, it is refused.  `IF j = 0 THEN
   j := 3 END' in `FOR j := 0 TO 2' ran on forever under 0.25's exit
   test and stopped under 0.17's -- the meaning moved with the
   generator, which a rule does not (zarrm9's 0.25 report).  A FOR IN's
   variable is a copy and stays writable (decision 48). *)
PROCEDURE ForVarWrite (d: PTR Ast.Node ; RO ctx: UTF ; byRef: BOOL) =
VAR j : I64 ;
BEGIN
  IF d.kind # Ast.NDesignator OR d.nkids # 0 THEN RETURN END ;
  FOR j := nforActive - 1 TO 0 BY -1 DO
    IF forPlain[j] AND Text.Eq (forNames[j], d.au) THEN
      IF byRef THEN
        ErrN (d, ctx, S5 (d.au, ' is the control variable of the FOR at line ',
          ItoA (forLines[j]), ': it cannot be handed to a VAR or OWN parameter inside the loop',
          ' -- pass a copy (par 2.1)'))
      ELSE
        ErrN (d, ctx, S5 (d.au, ' is the control variable of the FOR at line ',
          ItoA (forLines[j]), ': it cannot be assigned inside the loop',
          ' -- leave with EXIT, or count in a WHILE (par 2.1)'))
      END ;
      RETURN
    END
  END
END ForVarWrite ;

(* is the designator's value a MONITOR, by the type the typed tree
   recorded for its last selector?  A monitor is shared by design: its
   bound procedure takes it VAR, and that is the monitor's own lock, not
   a write through the borrow that leads to it (`LookupB (b.reg, ...)',
   the cache pattern of three applications) *)
PROCEDURE MonitorArg (a: PTR Ast.Node) : BOOL =
BEGIN
  IF a.nkids = 0 THEN RETURN FALSE END ;
  IF a.kids[a.nkids - 1] IS SOME ls THEN
    IF ResolveType (Ast.TypeAt (ls.id)) IS SOME mt THEN RETURN mt.kind = Ast.NMonitorType END
  END ;
  RETURN FALSE
END MonitorArg ;

PROCEDURE CheckArg (site: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ;
                    k: I64 ; RO pTy: UTF ; RO aTy: UTF ; an: Ast.Kid ;
                    isVar: BOOL ; isOwn: BOOL ; isKept: BOOL ;
                    nFrameKept: I64 ; wantsPool: BOOL ; allocs: BOOL ;
                    args: Ast.Kid) =
VAR
  amode, aroot, what, why, om, fty, sv, at : UTF ;
  nflat, j : I64 ;
  flat : SLICE OF AKid ;
BEGIN
  IF Text.Eq (aTy, '<void>') THEN
    ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
      Cat (name, ' returns no value')))
  ELSE
    at := AdaptLit (an, pTy, aTy) ;
    Agree (StArg, pTy, at, site.line) ;
    IF NOT Compat (pTy, at) THEN
      ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
        S4 (': cannot pass ', TyName (aTy), ' where ',
            Cat (TyName (pTy), ' is expected'))))
    END
  END ;
  IF an IS SOME a THEN
    IF isVar AND a.kind # Ast.NDesignator THEN
      ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
        Cat (name, ' must be a variable (VAR/OWN parameter)')))
    END ;
    IF isVar OR isOwn THEN ForVarWrite (a, ctx, TRUE) END ;
    IF isVar AND a.kind = Ast.NDesignator THEN
      IF a.nkids = 0 THEN
        (* a value parameter of pointer type is a shared borrow;
           lending it onward as VAR would launder the write
           restriction through a call (par 4.1) *)
        IF Text.Eq (ScopeMode (a.au), ModeVal) AND BaseIsPtr (a) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot lend the value parameter ', a.au,
                ' as VAR (shared borrow, par 4.1)')))
        END
      ELSIF Text.Eq (ScopeMode (a.au), ModeVal) AND BaseIsPtr (a) AND NOT MonitorArg (a) THEN
        (* and what it points to, `q.s': the same write by a call, which
           the assignment `q.s := ...' is refused for -- and no pool
           comes with a value pointer, so a new string the callee gave
           q.s was re-homed into this frame and read back freed (the
           second review's gen N3, 2026-10-26) *)
        ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
          S3 (': cannot lend what the value parameter ', a.au,
              ' points to as VAR (shared borrow, par 4.1)')))
      END ;
      (* rule 2: the callee may allocate in the object's pool, which
         the generator names from the ROOT of this designator's
         declaration -- so the root must have one to name *)
      IF wantsPool THEN
        why := ObjPoolIssue (a) ;
        (* a local without IN is refused only where the callee may
           allocate through this parameter: the frame it lends is the
           wrong pool only then *)
        IF Text.BLen (why) > 0 AND Text.Eq (ScopeMode (a.au), ModeLocal) AND NOT allocs THEN
          why := ''
        END ;
        IF Text.BLen (why) > 0 THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S4 (': the pool of ', a.au, ' is not known here, and the callee may allocate in it -- ',
                Cat (why, ' (par 4.3)'))))
        END
      END
    END ;
    IF isOwn AND a.kind = Ast.NDesignator THEN
      (* a move takes a name, as DISPOSE does: ownership is not followed
         into a field or an element, so `Eat (b.p)' left b.p holding what
         Eat freed and a second `Eat (b.p)' freed it again (2026-10-28) *)
      IF a.nkids > 0 THEN
        ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
          S3 (': cannot move through a selector of ', a.au,
              ' into an OWN parameter: a move takes a name that owns its pointer, and ownership is not followed into a field or an element (par 4.2)')))
      END ;
      IF a.nkids = 0 THEN
        amode := ScopeMode (a.au) ;
        IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
           Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move borrowed ', a.au,
                ' into an OWN parameter (par 4.2)')))
        ELSIF FvalHas (a.au) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move ', a.au,
                ' into an OWN parameter -- it lives in the frame (par 4.3)')))
        ELSIF Text.Eq (amode, ModeModule) AND NOT ownModule AND OwnedPtrTy (a.au) THEN
          (* as DISPOSE: a procedure cannot move what the module owns (O3) *)
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move the module variable ', a.au,
                ' into an OWN parameter in a procedure: the module owns it, and its body reads it after the call -- move it in the module body, or keep the owned value in a local (par 4.2)')))
        ELSIF OwnsNothing (a.au) THEN
          ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ', name,
            S3 (': cannot move ', a.au,
                ' into an OWN parameter: nothing here gives it an owned pointer -- only NEW (OWN, T), an owned name moved in or a call that does not answer what it was lent does (par 4.2)')))
        ELSE
          IF ResolveType (ScopeType (a.au)) IS SOME ares THEN
            IF ares.kind = Ast.NPtrType THEN
              IF ares.kids[1] IS SOME poolName THEN
                ErrN (site, ctx, S5 ('argument ', ItoA (k + 1), ' of ',
                  name, S3 (': the pool owns ', a.au, ' (par 4.3)')))
              ELSE
                IF OwnedCandKind (a.au) > 0 THEN
                  OwnMark (a.au, Cat ('moved into an OWN parameter of ',
                    name), site)
                END
              END
            ELSE
              IF OwnedCandKind (a.au) > 0 THEN
                OwnMark (a.au, Cat ('moved into an OWN parameter of ',
                  name), site)
              END
            END
          END
        END
      END
    END
  END ;
  (* par 4.1, the caller side of KEPT.  A parameter's KEPT is read
     HERE, which is what narrows the old blanket every-callee-may-keep
     '<call>' fact to the parameters that declare it.  Two refusals,
     the RAISES-style upward composition: what is handed to a KEPT
     parameter must survive the call, so a concatenation (frame
     storage, par 2.3) is refused outright, and a borrow is a
     retention the CALLER must declare in turn. *)
  IF isKept AND Text.Eq (pTy, 'POOL') THEN
    KeptPool (site, ctx, name, k, an)
  ELSIF isKept THEN
    (* a concatenation, a frame allocation, an answer built here, or a
       name holding one -- unless the keeper is a frame value too *)
    what := FrameWhat (an, aTy) ;
    (* a VIEW of frame storage -- a SLICE of it, or a callee's answer
       that views it -- is refused here too since 2026-10-18.  It was
       not from 2026-10-11 to then: following it refused four sound
       sites in the tools (three through Diag.LexJson's KEPT, one in
       Setup.Args9) for one real escape in an application; with the
       answer and the hand-back carrying borrows LexJson lost its KEPT
       and Args9 builds its vector in the frame, so the measurement
       became one false site repaired against one escape found
       (probe frame-view-kept-arg) *)
    IF Text.BLen (what) > 0 AND nFrameKept <= 1 AND
       NOT PoolAmong (args, KindPool (what)) THEN
      ErrN (site, ctx, S4 ('argument ', ItoA (k + 1), ' of ',
        S4 (name, ': a KEPT parameter cannot take ', what,
            Cat (' -- it dies with this frame (par 4.1); give it storage that outlives the call: ',
              'a string through Text.Keep (pool, s), an allocation through NEW (pool, T)'))))
    END ;
    (* a record value carries what its fields hold (TyBearing,
       decision 34), and a CONSTRUCTOR wrapping a borrow hands the
       borrow to the keeper: `Keep (f, Data.F64s (v, 0.0))' is `Keep
       (f, v)' for par 4.1 (2026-10-08) *)
    aroot := EscRootOf (an) ;
    IF Text.BLen (aroot) > 0 AND TyBearing (aTy) THEN
      KeptRoot (site, ctx, name, k, aroot)
    ELSIF ViewCallOf (an) IS SOME vc THEN
      (* a view-answering call handed to a keeper hands it the
         arguments the answer views: `Keep (Text.Split (s))' is `Keep
         (s)' for par 4.1 (2026-10-18) *)
      IF vc.kids[1] IS SOME val THEN
        FOR j := 0 TO val.nkids - 1 DO
          aroot := EscRootOf (val.kids[j]) ;
          IF Text.BLen (aroot) > 0 THEN
            IF val.kids[j] IS SOME varg THEN
              IF TyBearing (Ast.TyStrAt (varg.id)) AND ViewArgOf (vc, j) THEN
                KeptRoot (site, ctx, name, k, aroot)
              END
            END
          END
        END
      END
    ELSIF Text.BLen (aroot) = 0 THEN
      nflat := CtorFields (an, flat, om) ;
      IF nflat >= 0 THEN
        IF an IS SOME ce THEN
          IF ce.kids[1] IS SOME al THEN
            FOR j := 0 TO al.nkids - 1 DO
              IF j < nflat THEN
                sv := canonCtx ;
                canonCtx := om ;
                fty := CanonT (flat[j], 0) ;
                canonCtx := sv ;
                aroot := EscRootOf (al.kids[j]) ;
                IF Text.BLen (aroot) > 0 AND TyBearing (fty) THEN
                  KeptRoot (site, ctx, name, k, aroot)
                END
              END
            END
          END
        END
      END
    END
  END
END CheckArg ;


(* ---- par 4.2: moves and consumption ----

   An owned pointer has exactly one owner.  DISPOSE, SHARED (x), an
   OWN argument and a bare owned name on the right of an assignment
   all TAKE it, and any later use of that name is an error naming
   what took it and where.  A bare name on the left is a fresh start.

   The flow is per procedure and deliberately conservative at a join:
   moved in ANY arm is moved after the join, because a checker that
   guessed the other way would accept a use-after-move whenever the
   compiler could not see which arm ran.                            *)

PROCEDURE OwnClear () =
BEGIN
  nown := 0
END OwnClear ;

PROCEDURE OwnFind (RO nm: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nown - 1 DO
    IF Text.Eq (own[i].name, nm) THEN RETURN i END
  END ;
  RETURN -1
END OwnFind ;

PROCEDURE OwnSet (RO KEPT nm: UTF ; RO KEPT state: UTF) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  i := OwnFind (nm) ;
  IF i >= 0 THEN
    own[i].mode := state ;
    RETURN
  END ;
  IF nown = LEN (own) THEN
    nb := NEW (pool, Binding, 2 * LEN (own) + 16) ;
    FOR i := 0 TO nown - 1 DO nb[i] := own[i] END ;
    own := nb
  END ;
  own[nown].name := nm ;
  own[nown].mode := state ;
  own[nown].ty := NONE ;
  nown := nown + 1
END OwnSet ;

(* 1 = an owned pointer, 2 = a SHARED handle, 0 = neither.  Only
   locals and OWN parameters qualify: everything else is a borrow. *)
(* is the name's declared type an owned pointer -- a PTR without IN, or
   a SHARED handle -- whatever its mode *)
PROCEDURE OwnedPtrTy (RO nm: UTF) : BOOL =
BEGIN
  IF ResolveType (ScopeType (nm)) IS SOME res THEN
    IF res.kind = Ast.NPtrType THEN
      IF res.kids[1] IS SOME inpool THEN RETURN FALSE END ;
      RETURN TRUE
    END ;
    RETURN res.kind = Ast.NSharedType
  END ;
  RETURN FALSE
END OwnedPtrTy ;

PROCEDURE OwnedCandKind (RO nm: UTF) : I64 =
VAR mode : UTF ;
BEGIN
  mode := ScopeMode (nm) ;
  IF NOT Text.Eq (mode, ModeLocal) AND NOT Text.Eq (mode, ModeOwn) AND
     NOT (ownModule AND Text.Eq (mode, ModeModule)) THEN
    RETURN 0
  END ;
  IF ResolveType (ScopeType (nm)) IS SOME res THEN
    IF res.kind = Ast.NPtrType THEN
      IF res.kids[1] IS SOME inpool THEN RETURN 0 END ;
      RETURN 1
    END ;
    IF res.kind = Ast.NSharedType THEN RETURN 2 END
  END ;
  RETURN 0
END OwnedCandKind ;

PROCEDURE OwnMark (RO KEPT nm: UTF ; RO what: UTF ; site: PTR Ast.Node) =
BEGIN
  OwnSet (nm, Text.Keep (pool, S3 (what, ' at line ', ItoA (site.line))))
END OwnMark ;

PROCEDURE OwnAlive (RO KEPT nm: UTF) =
BEGIN
  IF OwnFind (nm) >= 0 THEN OwnSet (nm, 'alive') END
END OwnAlive ;

PROCEDURE NoteUse (d: PTR Ast.Node ; RO ctx: UTF) =
VAR i : I64 ;
BEGIN
  i := OwnFind (d.au) ;
  IF i < 0 THEN RETURN END ;
  IF NOT Text.Eq (own[i].mode, 'alive') THEN
    ErrN (d, ctx, S4 ('use of ', d.au, ' after it was ',
      Cat (own[i].mode, ' (par 4.2)')))
  END
END NoteUse ;

(* snapshot and merge, so that arms of an IF or a CASE are judged
   independently and their moves are adopted at the join *)
PROCEDURE OwnSnap () : SLICE OF Binding =
VAR
  c : SLICE OF Binding ;
  i : I64 ;
BEGIN
  c := NEW (pool, Binding, nown + 1) ;
  FOR i := 0 TO nown - 1 DO c[i] := own[i] END ;
  RETURN c
END OwnSnap ;

PROCEDURE OwnRestore (KEPT snap: SLICE OF Binding ; n: I64) =
VAR i : I64 ;
BEGIN
  nown := 0 ;
  FOR i := 0 TO n - 1 DO OwnSet (snap[i].name, snap[i].mode) END
END OwnRestore ;

PROCEDURE OwnMergeMoves (KEPT snap: SLICE OF Binding ; n: I64) =
VAR
  i, ix : I64 ;
BEGIN
  FOR i := 0 TO n - 1 DO
    IF NOT Text.Eq (snap[i].mode, 'alive') THEN
      ix := OwnFind (snap[i].name) ;
      IF ix < 0 THEN
        OwnSet (snap[i].name, snap[i].mode)
      ELSE
        IF Text.Eq (own[ix].mode, 'alive') THEN
          OwnSet (snap[i].name, snap[i].mode)
        END
      END
    END
  END
END OwnMergeMoves ;

(* ---- a move inside a loop carries into the NEXT TURN (ownership
   pass 3, 2026-10-10): the body is walked once, as if the loop ran
   once, so `FOR i := 1 TO 3 DO Eat (p) END' with Eat (OWN p) passed --
   the second turn handed on a pointer already moved and freed.  A name
   alive entering the loop and moved at the end of the body is refused
   at its FIRST appearance in the body when that appearance is a use;
   a body that gives it a fresh value first (`p := NEW (OWN, T)') is
   fine. ---- *)

(* the first appearance of NAME under K, in source order: 1 a use, 2 a
   bare assignment that gives it a value, 0 none; site is where *)
PROCEDURE FirstAppear (k: Ast.Kid ; RO nm: UTF ; VAR site: Ast.Kid) : I64 =
VAR
  i, r : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      (* the right side is evaluated first *)
      r := FirstAppear (e.kids[1], nm, site) ;
      IF r > 0 THEN RETURN r END ;
      IF e.kids[0] IS SOME lhs THEN
        IF lhs.kind = Ast.NDesignator AND Text.Eq (lhs.au, nm) THEN
          site := e.kids[0] ;
          IF lhs.nkids = 0 THEN RETURN 2 END ;
          RETURN 1
        END
      END ;
      RETURN 0
    END ;
    IF e.kind = Ast.NDesignator AND Text.Eq (e.au, nm) THEN
      site := k ;
      RETURN 1
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      r := FirstAppear (e.kids[i], nm, site) ;
      IF r > 0 THEN RETURN r END
    END
  END ;
  RETURN 0
END FirstAppear ;

(* the line a move was made at, read off its note (`... at line N') *)
PROCEDURE MoveLine (RO mode: UTF) : I64 =
VAR
  i, v : I64 ;
BEGIN
  i := Text.BLen (mode) ;
  WHILE i > 0 AND B (mode, i - 1) >= 48 AND B (mode, i - 1) <= 57 DO i := i - 1 END ;
  v := 0 ;
  WHILE i < Text.BLen (mode) DO
    v := v * 10 + (B (mode, i) - 48) ;
    i := i + 1
  END ;
  RETURN v
END MoveLine ;

(* does the statement sequence holding the statement at LINE leave --
   EXIT, RETURN or RAISE -- after it?  Then that move has no next turn *)
PROCEDURE LeavesAfter (k: Ast.Kid ; line: I64) : BOOL =
VAR
  i, j : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NStmtSeq THEN
      FOR i := 0 TO e.nkids - 1 DO
        IF e.kids[i] IS SOME st THEN
          IF st.line = line THEN
            FOR j := i + 1 TO e.nkids - 1 DO
              IF e.kids[j] IS SOME after THEN
                IF after.kind = Ast.NExit OR after.kind = Ast.NReturn OR
                   after.kind = Ast.NRaiseStmt THEN
                  RETURN TRUE
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF LeavesAfter (e.kids[i], line) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END LeavesAfter ;

PROCEDURE LoopCarry (pre: SLICE OF Binding ; npre: I64 ; body: Ast.Kid ;
                     RO ctx: UTF) =
VAR
  i, ix : I64 ;
  site : Ast.Kid ;
BEGIN
  FOR i := 0 TO npre - 1 DO
    IF Text.Eq (pre[i].mode, 'alive') THEN
      ix := OwnFind (pre[i].name) ;
      IF ix >= 0 THEN
        IF NOT Text.Eq (own[ix].mode, 'alive') AND
           NOT LeavesAfter (body, MoveLine (own[ix].mode)) THEN
          site := NONE ;
          IF FirstAppear (body, pre[i].name, site) = 1 THEN
            IF site IS SOME sn THEN
              ErrN (sn, ctx, S5 ('use of ', pre[i].name,
                ' in the next turn of the loop, after it was ', own[ix].mode,
                ' (par 4.2)'))
            END
          END
        END
      END
    END
  END
END LoopCarry ;

(* DISPOSE: what may be freed, and by whom *)
PROCEDURE CheckDispose (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  t, amode : UTF ;
BEGIN
  IF st.kids[0] IS SOME d THEN
    t := DesigStrType (d, FALSE, ctx) ;
    IF Text.BLen (ScopeMode (d.au)) = 0 AND NOT ConstNamed (d.au) AND
       FindMod (d.au) < 0 THEN
      (* `DISPOSE (x)' with no x: the generator's `unknown name' until
         2026-10-30 (the fuzz review's N13) *)
      ErrN (st, ctx, Cat ('unknown name: ', d.au))
    ELSIF d.nkids > 0 THEN
      ErrN (st, ctx, S3 ('cannot DISPOSE through a selector of ', d.au,
        Cat (': DISPOSE frees a name that owns its pointer, and ',
             'ownership is not followed into a field (par 4.2)')))
    ELSIF Text.Eq (ScopeMode (d.au), ModeModule) AND NOT ownModule THEN
      (* in a procedure a module variable is no owner: nothing here shows
         that no other name still holds what it points to, and the module
         body reads it after the call (the third review's O2) *)
      ErrN (st, ctx, S3 ('cannot DISPOSE the module variable ', d.au,
        ' in a procedure: the module owns it, and nothing here shows that no other name still holds it -- DISPOSE it in the module body, or keep the owned value in a local or an OWN parameter (par 4.2)'))
    ELSIF (Text.Eq (ScopeMode (d.au), ModeLocal) OR
           (ownModule AND Text.Eq (ScopeMode (d.au), ModeModule))) AND
          OwnedCandKind (d.au) = 1 AND
          NOT FvalHas (d.au) AND NOT OwnFedHas (d.au) THEN
      ErrN (st, ctx, S3 ('cannot DISPOSE ', d.au,
        Cat (': nothing here gives it an owned pointer -- only NEW (OWN, T), ',
             'an owned name moved in or a call that does not answer what it was lent does (par 4.2)')))
    ELSIF d.nkids = 0 THEN
      NoteUse (d, ctx) ;
      amode := ScopeMode (d.au) ;
      IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
         Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo) THEN
        ErrN (st, ctx, S3 ('cannot DISPOSE ', d.au,
          ': a borrow is not yours to free (take OWN, par 4.2)'))
      ELSIF FvalHas (d.au) THEN
        ErrN (st, ctx, S3 ('the frame owns ', d.au,
          '; it is freed at exit, not by DISPOSE (par 4.3)'))
      ELSE
        IF ResolveType (ScopeType (d.au)) IS SOME dcl THEN
          IF dcl.kind = Ast.NPtrType THEN
            IF dcl.kids[1] IS SOME pn THEN
              ErrN (st, ctx, S3 ('the pool owns ', d.au,
                '; free the pool, not the pointer (par 4.3)'))
            ELSE
              IF OwnedCandKind (d.au) > 0 THEN
                OwnMark (d.au, 'DISPOSEd', st)
              END
            END
          ELSE
            IF OwnedCandKind (d.au) > 0 THEN
              OwnMark (d.au, 'DISPOSEd', st)
            END
          END
        END
      END
    END
  END
END CheckDispose ;

(* completeness, judged at the implementation: everything the
   definition promised has a body, and every opaque type has a
   structure.  A definition is a contract, and a contract with a
   missing half links and then does not run. *)
(* The implementation against its definition, in the oracle's own
   order: signatures, then STATEFUL, then completeness.  Order is not
   cosmetic -- semdiff compares the diagnostic LIST, so a check in
   the wrong place is a divergence even when both checkers find the
   same faults.

   The STATEFUL half was MISSING here until 2026-08-24, and semdiff
   could not see it: every corpus module with module-level state
   already declares STATEFUL, so both checkers agreed by both saying
   nothing.  It took a negative case --
   probes/module-state-without-stateful.m9 -- which is what probes/
   is for and why a clean corpus proves nothing on its own. *)
(* the oracle's three-line message, built rather than concatenated
   because the two middle lines carry a newline each and M9 has no
   escape in a string literal -- a string cannot contain its own
   delimiter and there is no backslash form (report par 2) *)
PROCEDURE SigDiff (RO want: UTF ; RO got: UTF) : UTF =
VAR d : PTR DynUtf.DString IN pool ;
BEGIN
  d := DynUtf.New (pool) ;
  DynUtf.Append (d, 'signature differs from definition:') ;
  DynUtf.AppendChar (d, 0AC) ;
  DynUtf.Append (d, '    definition     ') ;
  DynUtf.Append (d, want) ;
  DynUtf.AppendChar (d, 0AC) ;
  DynUtf.Append (d, '    implementation ') ;
  DynUtf.Append (d, got) ;
  RETURN DynUtf.ViewIn (pool, d)
END SigDiff ;

PROCEDURE CheckConformance (u: PTR Ast.Node) =
VAR
  m, i, pi : I64 ;
  defined, hasVars : BOOL ;
  isig : UTF ;
BEGIN
  m := FindMod (u.au) ;
  IF m < 0 THEN RETURN END ;

  hasVars := FALSE ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NVarSection THEN hasVars := TRUE END ;
      IF d.kind = Ast.NProcDecl THEN
        pi := FindProcIn (m, d.au) ;
        IF pi >= 0 THEN
          (* fromDef is the oracle's `node <> d` test said another
             way: an entry that came from the definition is a
             DIFFERENT node from this implementation's, and one that
             did not is this very node, with nothing to compare. *)
          IF mods[m].procs[pi].fromDef THEN
            isig := SigOf (d) ;
            IF NOT Text.Eq (mods[m].procs[pi].sig, isig) THEN
              ErrN (d, Qualify (u.au, d.au),
                SigDiff (mods[m].procs[pi].sig, isig))
            END
          END
        END
      END
    END
  END ;
  IF hasVars AND NOT mods[m].stateful THEN
    ErrN (u, u.au, 'module-level state requires STATEFUL on the definition')
  END ;

  FOR i := 0 TO mods[m].nprocs - 1 DO
    IF mods[m].procs[i].fromDef AND NOT mods[m].procs[i].hasBody THEN
      ErrN (u, Qualify (u.au, mods[m].procs[i].name),
        'declared in the definition but not implemented')
    END
  END ;
  FOR i := 0 TO mods[m].nopaque - 1 DO
    (* FindTypeIn answers the type NODE, not an index -- which the
       new typing caught the first time this was written the other
       way round *)
    IF FindTypeIn (m, mods[m].opaque[i]) IS SOME td THEN
      defined := TRUE
    ELSE
      defined := FALSE
    END ;
    IF NOT defined THEN
      ErrN (u, Qualify (u.au, mods[m].opaque[i]),
        'opaque type not defined in the implementation')
    END
  END
END CheckConformance ;

(* ---- pass 1: foreign declarations ---- *)

PROCEDURE IsCType (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME t THEN
    RETURN t.kind = Ast.NQualident AND Text.Eq (t.au, 'C') AND
           Text.BLen (t.bu) > 0
  END ;
  RETURN FALSE
END IsCType ;

(* the string helpers answer FRAME strings, built in the caller's arena
   (decision 6): a text that must live is kept by its keeper, Text.Keep
   (pool, ...), where the checker says so.  Until 2026-10-23 they built in
   the module pool, never freed -- a check of Sem.m9 kept some 340,000
   DynStr builders and their doublings, most of its 219 MB peak
   (docs/utf8-stage3-plan.md, step 1) *)
PROCEDURE Cat (RO a: UTF ; RO b: UTF) : UTF =
BEGIN
  RETURN a + b
END Cat ;

PROCEDURE Qualify (RO a: UTF ; RO b: UTF) : UTF =
BEGIN
  RETURN a + '.' + b
END Qualify ;

(* A FOR "C" unit is the audit surface: every procedure in it names a
   C symbol, speaks only C.* types, and states its thread contract.
   The blosc_decompress race that seeded the museum is unrepresentable
   once all three hold.                                             *)
PROCEDURE CheckForeignDef (u: PTR Ast.Node) =
VAR
  i, j : I64 ;
  ctx : UTF ;
  ok : BOOL ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        ctx := Qualify (u.au, d.au) ;
        IF Text.BLen (d.bu) = 0 THEN
          ErrN (d, ctx,
            'foreign procedure needs a bound C name (= "c_name")')
        END ;
        ok := TRUE ;
        IF d.kids[0] IS SOME pl THEN
          FOR j := 0 TO pl.nkids - 1 DO
            IF pl.kids[j] IS SOME prm THEN
              IF NOT IsCType (prm.kids[1]) THEN ok := FALSE END
            END
          END
        END ;
        IF d.kids[1] IS SOME rt THEN
          IF NOT IsCType (d.kids[1]) THEN ok := FALSE END
        END ;
        IF NOT ok THEN
          ErrN (d, ctx,
            'native type in foreign signature; use C.* types')
        END ;
        ok := FALSE ;
        IF d.kids[3] IS SOME at THEN
          ok := Text.Eq (at.au, 'SERIAL') OR Text.Eq (at.au, 'REENTRANT')
        END ;
        IF NOT ok THEN
          ErrN (d, ctx,
            'foreign procedure must declare [SERIAL] or [REENTRANT]')
        END
      END
    END
  END
END CheckForeignDef ;



(* ---- FROM imports: the module a bare callee belongs to ---- *)

PROCEDURE FromClear () =
BEGIN
  nfrom := 0
END FromClear ;

PROCEDURE FromAdd (RO KEPT nm: UTF ; RO KEPT owner: UTF) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  IF nfrom = LEN (fromMap) THEN
    nb := NEW (pool, Binding, 2 * LEN (fromMap)) ;
    FOR i := 0 TO nfrom - 1 DO nb[i] := fromMap[i] END ;
    fromMap := nb
  END ;
  fromMap[nfrom].name := nm ;
  fromMap[nfrom].mode := owner ;
  fromMap[nfrom].ty := NONE ;
  nfrom := nfrom + 1
END FromAdd ;

PROCEDURE FromOwner (RO nm: UTF) : UTF =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nfrom - 1 DO
    IF Text.Eq (fromMap[i].name, nm) THEN RETURN fromMap[i].mode END
  END ;
  RETURN ''
END FromOwner ;

(* the callee's declaration, wherever it lives: qualified names name
   their module, bare ones mean this module unless a FROM import said
   otherwise *)
PROCEDURE LookupProc (RO callee: UTF ; VAR found: BOOL) : ProcInfo =
VAR
  dot, m, pi : I64 ;
  modName, procName, owner : UTF ;
  empty : ProcInfo ;
BEGIN
  found := FALSE ;
  dot := Text.FindChar (callee, '.') ;
  IF dot >= 0 THEN
    modName := SLICE (callee, 0, dot) ;
    procName := SLICE (callee, dot + 1, Text.BLen (callee) - dot - 1)
  ELSE
    procName := callee ;
    modName := curMod ;
    owner := FromOwner (callee) ;
    IF Text.BLen (owner) > 0 THEN modName := owner END
  END ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN empty END ;
  pi := FindProcIn (m, procName) ;
  IF pi < 0 THEN RETURN empty END ;
  pi := TwinIx (m, pi) ;
  found := TRUE ;
  RETURN mods[m].procs[pi]
END LookupProc ;

(* TWINS BY TYPE for UTF (docs/utf8-plan.md, U3; Alex, 2026-10-23:
   dispatch by type): a call with a UTF argument is the module's
   XxxUtf when it declares one -- decision 13's width rule with the
   suffix Utf -- so a module moves to UTF by its declarations, not its
   calls.  Gen.CallC applies the same rule *)
(* an argument that sends a call to its Utf twin: a UTF, or a slice of
   them (Text.Join's parts) *)
PROCEDURE UtfVotes (RO t: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (t, UtfTy) OR Text.Eq (t, Cat ('SLICE OF ', UtfTy))
END UtfVotes ;

PROCEDURE UtfTwin (RO name: UTF ; any: BOOL) : UTF =
VAR found : BOOL ; pr : ProcInfo ; n : I64 ;
BEGIN
  (* under the rehearsed switch every call of X is XUtf's *)
  IF NOT any AND NOT strUtf THEN RETURN name END ;
  n := Text.BLen (name) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (name, n - 3, 3), 'Utf') THEN RETURN name END
  END ;
  pr := LookupProc (Cat (name, 'Utf'), found) ;
  IF found THEN RETURN Cat (name, 'Utf') END ;
  RETURN name
END UtfTwin ;

PROCEDURE WidthTwin (RO name: UTF ; single: BOOL) : UTF =
VAR found : BOOL ; pr : ProcInfo ; n : I64 ;
BEGIN
  (* WIDTH DISPATCH BY DECLARED TWIN.  `Math.Sqrt (x)` with an F32
     argument is `Math.SqrtF32 (x)`, because sqrtf's answer is not
     sqrt's answer narrowed, and a port held bit-identical to a
     single-precision original needs the single-precision libm.

     Two conditions: the first argument is F32, and the module
     DECLARED the twin.  The suffix is how a module says a function
     is width-generic -- so nothing changes for a module that
     declares none, which is every module but Math.

     SOME argument is F32 and NONE is F64.  Reading only the first
     met `Math.Pow (10.0, c)`: a literal types as neither width,
     because it adapts, so it must neither decide nor block.  A
     genuinely mixed call -- one F32 argument and one F64 -- keeps
     the double twin and fails argument compatibility, which is the
     right answer and names the right place. *)
  IF NOT single THEN RETURN name END ;
  n := Text.BLen (name) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (name, n - 3, 3), 'F32') THEN RETURN name END
  END ;
  pr := LookupProc (Cat (name, 'F32'), found) ;
  IF found THEN RETURN Cat (name, 'F32') END ;
  RETURN name
END WidthTwin ;

PROCEDURE DesigName (d: PTR Ast.Node) : UTF =
  (* the dotted callee name: `P', `Mod.P', `Type.Variant', and --
     since 2026-09-15 -- `Mod.Type.Variant', the three-part imported
     variant constructor.  Every field selector joins; a call target
     is only ever one of these shapes, because F(x).field does not
     parse and a field chain cannot be called.  A leading index or
     deref stops it (returns the base), as before. *)
VAR
  res : UTF ;
  i : I64 ;
BEGIN
  res := d.au ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN res := Qualify (res, sel.au)
      ELSE RETURN d.au END
    END
  END ;
  RETURN res
END DesigName ;

(* ---- the variant set of a KNOWN selector type ----
   Two modules may spell a variant type the same way -- Json and Dict
   both declare Value -- so totality is judged against the SELECTOR's
   type, never against the first module that matches a label by name.
   That distinction cost two bugs before it was written down.       *)
PROCEDURE VariantOfType (RO canon: UTF ; VAR mi: I64 ; VAR vi: I64)
  : BOOL =
VAR
  dot, m, j : I64 ;
  modName, tyName : UTF ;
BEGIN
  mi := -1 ;
  vi := -1 ;
  dot := Text.FindChar (canon, '.') ;
  IF dot < 0 THEN RETURN FALSE END ;
  modName := SLICE (canon, 0, dot) ;
  tyName := SLICE (canon, dot + 1, Text.BLen (canon) - dot - 1) ;
  m := FindMod (modName) ;
  IF m < 0 THEN RETURN FALSE END ;
  FOR j := 0 TO mods[m].nvts - 1 DO
    IF Text.Eq (mods[m].vts[j].typeName, tyName) THEN
      mi := m ;
      vi := j ;
      RETURN TRUE
    END
  END ;
  RETURN FALSE
END VariantOfType ;

PROCEDURE VariantHas (mi, vi: I64 ; RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (mods[mi].vts[vi].variants) - 1 DO
    IF Text.Eq (mods[mi].vts[vi].variants[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END VariantHas ;

(* every arm of a CASE over a CASE RECORD, or an ELSE.  The
   uninitialised-Result bug that seeded the museum is unrepresentable
   once this holds: there is no path out of the CASE that assigns
   nothing.                                                          *)
PROCEDURE HasPatternArm (st: PTR Ast.Node) : BOOL =
VAR j, k : I64 ;
BEGIN
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR k := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END HasPatternArm ;

(* the member a CASE label over an enumeration or CASE RECORD names:
   a bare `Fs', or `Kind.Fs' / `Mod.Kind.Fs' -- the last field of a
   designator that is nothing but field selectors; '' for any other
   form.  The qualified spelling was accepted by the checker and
   refused by the generator until 2026-10-09 (cp-kernel's issue 13),
   and the totality check skipped it *)
PROCEDURE LabelName (lv: PTR Ast.Node) : UTF =
VAR i : I64 ;
BEGIN
  IF lv.kind # Ast.NDesignator THEN RETURN '' END ;
  IF lv.nkids = 0 THEN RETURN lv.au END ;
  FOR i := 0 TO lv.nkids - 1 DO
    IF lv.kids[i] IS SOME sel THEN
      IF sel.kind # Ast.NSelField THEN RETURN '' END
    ELSE
      RETURN ''
    END
  END ;
  IF lv.kids[lv.nkids - 1] IS SOME last THEN RETURN last.au END ;
  RETURN ''
END LabelName ;

PROCEDURE CheckCaseTotal (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  selTy : UTF ;
  mi, vi, j, k, c : I64 ;
  covered : SLICE OF UTF ;
  ncov : I64 ;
  hasElse, labelsVariant : BOOL ;
BEGIN
  selTy := DesigCanon (st.kids[0], ctx) ;
  IF NOT VariantOfType (selTy, mi, vi) THEN
    (* a CASE with an arm that BINDS a payload ranges over variants,
       whatever its selector's type could not be resolved to: nothing
       was proved about its totality, and --review says so.  (A
       scalar CASE is not a totality site at all and is not counted.) *)
    IF HasPatternArm (st) THEN PassedOver (StCase, st.line) END ;
    RETURN
  END ;
  (* one entry per label: a fixed 16 dropped the 17th and every one
     after it, and a total CASE over 17 members or variants was refused
     as missing them (the second review's fuzz N5; the Pascal twin's
     list never had the cap) *)
  ncov := 1 ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm0 THEN
      IF arm0.kind = Ast.NCaseArm THEN
        IF arm0.kids[0] IS SOME lbls0 THEN ncov := ncov + lbls0.nkids END
      END
    END
  END ;
  covered := NEW (pool, UTF, ncov) ;
  ncov := 0 ;
  hasElse := FALSE ;
  labelsVariant := FALSE ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME lbls THEN
          FOR k := 0 TO lbls.nkids - 1 DO
            IF lbls.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelPattern THEN
                IF ncov < LEN (covered) THEN
                  covered[ncov] := lbl.au ;
                  ncov := ncov + 1 ;
                  labelsVariant := TRUE
                END
              ELSIF lbl.kind = Ast.NLabelRange THEN
                IF lbl.kids[0] IS SOME lv THEN
                  IF Text.BLen (LabelName (lv)) > 0 THEN
                    IF VariantHas (mi, vi, LabelName (lv)) THEN
                      IF ncov < LEN (covered) THEN
                        covered[ncov] := LabelName (lv) ;
                        ncov := ncov + 1 ;
                        labelsVariant := TRUE
                      END
                    END
                  END
                END
              END
            END
          END
        END
      ELSE
        hasElse := TRUE
      END
    END
  END ;
  IF NOT labelsVariant OR hasElse THEN RETURN END ;
  statC[StCase] := statC[StCase] + 1 ;
  FOR k := 0 TO LEN (mods[mi].vts[vi].variants) - 1 DO
    c := 0 ;
    FOR j := 0 TO ncov - 1 DO
      IF Text.Eq (covered[j], mods[mi].vts[vi].variants[k]) THEN
        c := c + 1
      END
    END ;
    IF c = 0 THEN
      ErrN (st, ctx, Cat (Cat (
        'CASE over CASE RECORD is not total (missing ',
        mods[mi].vts[vi].variants[k]), ')'))
    END
  END
END CheckCaseTotal ;

(* a function called as a statement throws its answer away, and in a
   language where failure travels in the result that is how a caller
   loses the thing it was supposed to check *)
(* THREAD (P, arg), par 6: the argument is held to P's first
   parameter, and a bare owned pointer handed over is MOVED -- the
   thread owns it now.  Until 2026-09-27 neither checker looked at
   the argument (docs/agent-review-2026-09-27.md F2): `THREAD (Work,
   x)` with an I64 reached the generator, and an owned pointer stayed
   live in the caller after a thread had it.  The shapes that pass:
   `P (VAR r: T)` takes a PTR T or SHARED PTR T -- the record by
   reference, chapter 16's job -- or a monitor T by name; `P (p: PTR
   T)` and `P (OWN p: PTR T)` take a PTR T.  A pool value is the
   pool's and is lent, a VAR parameter is a borrow and is lent;
   sharability itself is still unbuilt and the reviewer holds it. *)
(* ---- par 6: a STATEFUL module's state is written by ONE thread ----
   (2026-10-11.)  Listed on the review page, not refused (ThreadWrites
   says why).  A THREAD's target, and everything it calls that the
   checker can follow, should not WRITE a variable of a STATEFUL module:
   assign one, hand one to a VAR or OWN parameter, allocate in a module
   POOL, DISPOSE one.  READING is allowed -- the threshold and the sink
   Logger.Msg reads, set before the threads start, are the idiom -- and
   a variable whose type is a MONITOR, or a pointer to one, serialises
   itself.  A call through a procedure value is not followed (nothing
   says what it calls).  The answer is a witness, `Mod.v (Mod.P, line
   N)', memoised per Module.Proc in AnswersFrame's table under `w:'. *)

(* a type's body, through pointers, OPT and names; m becomes the
   module that declares it *)
PROCEDURE SwResolve (VAR m: I64 ; k: Ast.Kid) : Ast.Kid =
VAR
  depth, mm : I64 ;
  cur : Ast.Kid ;
BEGIN
  cur := k ;
  FOR depth := 0 TO 8 DO
    IF m < 0 THEN RETURN NONE END ;
    IF cur IS SOME t THEN
      IF t.kind = Ast.NPtrType OR t.kind = Ast.NSharedType OR t.kind = Ast.NOptType THEN
        cur := t.kids[0]
      ELSIF t.kind = Ast.NQualident THEN
        IF Text.BLen (t.bu) = 0 THEN
          cur := FindTypeIn (m, t.au)
        ELSE
          mm := FindMod (t.au) ;
          IF mm < 0 THEN RETURN NONE END ;
          m := mm ;
          cur := FindTypeIn (m, t.bu)
        END
      ELSE
        RETURN cur
      END
    ELSE
      RETURN NONE
    END
  END ;
  RETURN NONE
END SwResolve ;

(* does the write through designator d, from its selector `from' on,
   pass through a MONITOR -- the variable's own type, or a field's on
   the way?  Then the monitor serialises it.  An index, or a type not
   found, stops the walk: the write counts. *)
PROCEDURE SwPathMonitor (m: I64 ; ty: Ast.Kid ; d: PTR Ast.Node ; from: I64) : BOOL =
VAR
  i : I64 ;
  t : Ast.Kid ;
BEGIN
  t := SwResolve (m, ty) ;
  FOR i := from TO d.nkids - 1 DO
    IF t IS SOME tn THEN
      IF tn.kind = Ast.NMonitorType THEN RETURN TRUE END ;
      IF d.kids[i] IS SOME sel THEN
        IF sel.kind = Ast.NSelField AND tn.kind = Ast.NRecordType THEN
          t := SwResolve (m, FieldTypeOf (tn, sel.au))
        ELSE
          RETURN FALSE
        END
      END
    ELSE
      RETURN FALSE
    END
  END ;
  IF t IS SOME tf THEN RETURN tf.kind = Ast.NMonitorType END ;
  RETURN FALSE
END SwPathMonitor ;

(* `Mod.v' when nm is a variable of the STATEFUL module m and the
   write through d (selectors from `from') reaches no monitor, else '' *)
PROCEDURE SwVarAt (m: I64 ; RO nm: UTF ; d: PTR Ast.Node ; from: I64) : UTF =
VAR i : I64 ;
BEGIN
  IF m < 0 THEN RETURN '' END ;
  IF NOT mods[m].stateful THEN RETURN '' END ;
  FOR i := 0 TO mods[m].nmvs - 1 DO
    IF Text.Eq (mods[m].mvNames[i], nm) THEN
      IF SwPathMonitor (m, mods[m].mvTypes[i], d, from) THEN RETURN '' END ;
      RETURN Qualify (mods[m].name, nm)
    END
  END ;
  RETURN ''
END SwVarAt ;

(* the module variable designator d (in procedure proc of module m)
   writes through, or '' *)
PROCEDURE SwTarget (m: I64 ; proc: PTR Ast.Node ; d: PTR Ast.Node) : UTF =
VAR dot, mm : I64 ;
BEGIN
  dot := Text.FindChar (d.au, '.') ;
  IF dot > 0 THEN
    (* an exported variable, rewritten to one name (decision 28) *)
    RETURN SwVarAt (FindMod (SLICE (d.au, 0, dot)),
                    SLICE (d.au, dot + 1, Text.BLen (d.au) - dot - 1), d, 0)
  END ;
  IF DeclaresName (SOME (proc), d.au) THEN RETURN '' END ;
  mm := FindMod (d.au) ;
  IF mm >= 0 AND mm # m AND d.nkids > 0 THEN
    IF d.kids[0] IS SOME s0 THEN
      IF s0.kind = Ast.NSelField THEN RETURN SwVarAt (mm, s0.au, d, 1) END
    END ;
    RETURN ''
  END ;
  RETURN SwVarAt (m, d.au, d, 0)
END SwTarget ;

PROCEDURE SwAt (RO w: UTF ; m: I64 ; proc: PTR Ast.Node ; line: I64) : UTF =
BEGIN
  RETURN S5 (w, ' (', Qualify (mods[m].name, proc.au), ', line ',
             Cat (ItoA (line), ')'))
END SwAt ;

PROCEDURE StateWrite (RO qual: UTF ; m: I64 ; body: Ast.Kid) : UTF ;

(* a call in procedure proc of module m: its VAR and OWN arguments,
   a NEW's pool, and what the callee writes *)
PROCEDURE SwCall (m: I64 ; proc: PTR Ast.Node ; cn: PTR Ast.Node ;
                  args: Ast.Kid ; line: I64) : UTF =
VAR
  callee, w : UTF ;
  found : BOOL ;
  pr : ProcInfo ;
  g, j, k : I64 ;
BEGIN
  callee := DesigName (cn) ;
  IF Text.Eq (callee, 'NEW') OR Text.Eq (callee, 'DISPOSE') THEN
    IF args IS SOME al THEN
      IF al.nkids > 0 THEN
        IF al.kids[0] IS SOME a0 THEN
          IF a0.kind = Ast.NDesignator AND a0.nkids = 0 THEN
            w := SwTarget (m, proc, a0) ;
            IF Text.BLen (w) > 0 THEN RETURN SwAt (w, m, proc, line) END
          END
        END
      END
    END ;
    RETURN ''
  END ;
  pr := ProcNamed (mods[m].name, callee, found) ;
  IF NOT found THEN RETURN '' END ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      IF args IS SOME al2 THEN
        k := 0 ;
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF (grp.f1 OR grp.f2) AND k < al2.nkids THEN
                  IF al2.kids[k] IS SOME ak THEN
                    IF ak.kind = Ast.NDesignator THEN
                      w := SwTarget (m, proc, ak) ;
                      IF Text.BLen (w) > 0 THEN RETURN SwAt (w, m, proc, line) END
                    END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END
    END
  END ;
  RETURN StateWrite (Qualify (pr.modName, pr.name), FindMod (pr.modName), pr.body)
END SwCall ;

PROCEDURE SwWalk (m: I64 ; proc: PTR Ast.Node ; k: Ast.Kid) : UTF =
VAR
  i : I64 ;
  w : UTF ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NAssign THEN
      IF n.kids[0] IS SOME l THEN
        IF l.kind = Ast.NDesignator THEN
          w := SwTarget (m, proc, l) ;
          IF Text.BLen (w) > 0 THEN RETURN SwAt (w, m, proc, n.line) END
        END
      END
    ELSIF n.kind = Ast.NDispose THEN
      IF n.kids[0] IS SOME dd THEN
        IF dd.kind = Ast.NDesignator THEN
          w := SwTarget (m, proc, dd) ;
          IF Text.BLen (w) > 0 THEN RETURN SwAt (w, m, proc, n.line) END
        END
      END
    ELSIF n.kind = Ast.NCallStmt OR n.kind = Ast.NCallExpr THEN
      IF n.kids[0] IS SOME cn THEN
        IF cn.kind = Ast.NDesignator THEN
          w := SwCall (m, proc, cn, n.kids[1], n.line) ;
          IF Text.BLen (w) > 0 THEN RETURN w END
        END
      END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      w := SwWalk (m, proc, n.kids[i]) ;
      IF Text.BLen (w) > 0 THEN RETURN w END
    END
  END ;
  RETURN ''
END SwWalk ;

PROCEDURE StateWrite (RO qual: UTF ; m: I64 ; body: Ast.Kid) : UTF =
VAR
  i : I64 ;
  key, w : UTF ;
BEGIN
  key := Text.Keep (pool, Cat ('w:', qual)) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN
    IF Text.Eq (ansState[i], '-') OR Text.Eq (ansState[i], 'busy') THEN RETURN '' END ;
    RETURN ansState[i]
  END ;
  AnsSet (key, 'busy') ;
  w := '' ;
  IF m >= 0 THEN
    IF body IS SOME pd THEN
      IF pd.kind = Ast.NProcDecl THEN w := SwWalk (m, pd, pd.kids[4]) END
    END
  END ;
  IF Text.BLen (w) = 0 THEN AnsSet (key, '-') ELSE AnsSet (key, Text.Keep (pool, w)) END ;
  RETURN w
END StateWrite ;

(* DOES A PROCEDURE PROVABLY WRITE NO MODULE STATE?  The generator's
   question for an RO aggregate held in a module variable (decision 81):
   its address may be passed only when nothing the callee runs writes
   any module variable, or the callee would read the write where it read
   a copy until then.  StateWrite above answers the THREAD note and
   says '' for whatever it cannot see -- a procedure value, a callee
   with no body, a recursive cycle -- which is right for a note and
   wrong here.  This is its sound twin: TRUE only when every statement
   is seen and none writes.  A procedure value, a callee without a body
   (a foreign C procedure aside: it cannot name an M9 variable, and its
   VAR arguments are read like any call's), a builtin not known pure,
   THREAD and a cycle all answer FALSE.  Memo 'n:<qual>', 'busy' while
   walked: a FALSE taken from a cycle is only conservative. *)

(* may a write through d, in procedure proc, reach module state?  Its
   root is not a parameter, local or binder of proc -- any module's
   variable, STATEFUL or not, a monitor path included: SwTarget's
   narrower answer is the THREAD note's, and a program's own module
   variables were not in it *)
PROCEDURE NwTarget (proc: PTR Ast.Node ; d: PTR Ast.Node) : BOOL =
BEGIN
  IF Text.FindChar (d.au, '.') > 0 THEN RETURN TRUE END ;
  RETURN NOT DeclaresName (SOME (proc), d.au)
END NwTarget ;

(* is nm a module-level VAR of module m (a POOL NEW grows, say)?  NEW's
   first argument is also a TYPE (NEW (T, n)) or OWN, which write
   nothing *)
PROCEDURE NwModVar (m: I64 ; RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF m < 0 THEN RETURN TRUE END ;
  FOR i := 0 TO mods[m].nmvs - 1 DO
    IF Text.Eq (mods[m].mvNames[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END NwModVar ;

PROCEDURE NwPureBuiltin (RO nm: UTF) : BOOL =
BEGIN
  RETURN IsBuiltinTy (nm) OR Text.Eq (nm, 'LEN') OR Text.Eq (nm, 'ORD') OR
    Text.Eq (nm, 'CHR') OR Text.Eq (nm, 'MAX') OR Text.Eq (nm, 'SizeOf') OR
    Text.Eq (nm, 'ByteSize') OR Text.Eq (nm, 'NAME') OR Text.Eq (nm, 'VIEW') OR
    Text.Eq (nm, 'SLICE') OR Text.Eq (nm, 'GRID') OR Text.Eq (nm, 'OCTETS') OR
    Text.Eq (nm, 'STR') OR Text.Eq (nm, 'UTF')
END NwPureBuiltin ;

(* the call cn (args) in procedure proc of module m writes no module state *)
PROCEDURE NwCall (m: I64 ; proc: PTR Ast.Node ; cn: PTR Ast.Node ; args: Ast.Kid) : BOOL =
VAR
  callee, om, canon : UTF ;
  found : BOOL ;
  pr : ProcInfo ;
  g, j, k : I64 ;
BEGIN
  callee := DesigName (cn) ;
  IF Text.Eq (callee, 'NEW') OR Text.Eq (callee, 'DISPOSE') OR Text.Eq (callee, 'COPY') THEN
    (* the first argument is what they write: a pool, a pointer, a target *)
    IF args IS SOME al THEN
      IF al.nkids > 0 THEN
        IF al.kids[0] IS SOME a0 THEN
          IF a0.kind # Ast.NDesignator THEN RETURN FALSE END ;
          IF NwTarget (proc, a0) THEN
            IF NOT Text.Eq (callee, 'NEW') THEN RETURN FALSE END ;
            IF Text.FindChar (a0.au, '.') > 0 OR NwModVar (m, a0.au) THEN RETURN FALSE END
          END
        END
      END
    END ;
    RETURN TRUE
  END ;
  pr := ProcNamed (mods[m].name, callee, found) ;
  IF NOT found THEN
    IF RecordNamed (callee, om, canon) IS SOME rn THEN RETURN TRUE END ;
    RETURN NwPureBuiltin (callee)
  END ;
  (* a VAR or OWN argument naming module state is written by the call *)
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      IF args IS SOME al2 THEN
        k := 0 ;
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF (grp.f1 OR grp.f2) AND k < al2.nkids THEN
                  IF al2.kids[k] IS SOME ak THEN
                    IF ak.kind # Ast.NDesignator THEN RETURN FALSE END ;
                    IF NwTarget (proc, ak) THEN RETURN FALSE END
                  END
                END ;
                k := k + 1
              END
            END
          END
        END
      END
    END
  END ;
  IF Text.BLen (pr.foreign) > 0 THEN RETURN TRUE END ;
  RETURN NoStateWrite (Qualify (pr.modName, pr.name), FindMod (pr.modName), pr.body)
END NwCall ;

PROCEDURE NwWalk (m: I64 ; proc: PTR Ast.Node ; k: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NAssign THEN
      IF n.kids[0] IS SOME l THEN
        IF l.kind # Ast.NDesignator THEN RETURN FALSE END ;
        IF NwTarget (proc, l) THEN RETURN FALSE END
      END
    ELSIF n.kind = Ast.NDispose THEN
      IF n.kids[0] IS SOME dd THEN
        IF dd.kind # Ast.NDesignator THEN RETURN FALSE END ;
        IF NwTarget (proc, dd) THEN RETURN FALSE END
      END
    ELSIF n.kind = Ast.NThread THEN
      RETURN FALSE
    ELSIF n.kind = Ast.NCallStmt OR n.kind = Ast.NCallExpr THEN
      IF n.kids[0] IS SOME cn THEN
        IF cn.kind # Ast.NDesignator THEN RETURN FALSE END ;
        IF NOT NwCall (m, proc, cn, n.kids[1]) THEN RETURN FALSE END
      END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF NOT NwWalk (m, proc, n.kids[i]) THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END NwWalk ;

PROCEDURE NoStateWrite (RO qual: UTF ; m: I64 ; body: Ast.Kid) : BOOL =
VAR
  i : I64 ;
  key : UTF ;
  ok : BOOL ;
BEGIN
  key := Text.Keep (pool, Cat ('n:', qual)) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN Text.Eq (ansState[i], 'y') END ;
  AnsSet (key, 'busy') ;
  ok := FALSE ;
  IF m >= 0 THEN
    IF body IS SOME pd THEN
      IF pd.kind = Ast.NProcDecl THEN ok := NwWalk (m, pd, pd.kids[4]) END
    END
  END ;
  IF ok THEN AnsSet (key, 'y') ELSE AnsSet (key, 'n') END ;
  RETURN ok
END NoStateWrite ;

PROCEDURE NoteThreadWrite (line: I64 ; RO name: UTF ; RO sw: UTF) =
VAR
  nt : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF ntw = LEN (twText) THEN
    nt := NEW (pool, UTF, 2 * LEN (twText) + 4) ;
    FOR i := 0 TO ntw - 1 DO nt[i] := twText[i] END ;
    twText := nt
  END ;
  twText[ntw] := Text.Keep (pool, S5 (ItoA (line), ' ', name, ' writes ', sw)) ;
  ntw := ntw + 1
END NoteThreadWrite ;

(* a call that resolved to name: a stale one when name has a UTF twin in
   another module than this (StaleCalls); each site once, though a call
   may be typed more than once *)
PROCEDURE NoteStale (line: I64 ; RO name: UTF) =
VAR
  found : BOOL ;
  pr : ProcInfo ;
  n, i : I64 ;
  nt : SLICE OF UTF ;
  e : UTF ;
BEGIN
  n := Text.BLen (name) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (name, n - 3, 3), 'Utf') THEN RETURN END
  END ;
  pr := LookupProc (Cat (name, 'Utf'), found) ;
  IF NOT found OR Text.Eq (pr.modName, curMod) THEN RETURN END ;
  e := Qualify (pr.modName, pr.name) ;
  e := S5 (ItoA (line), ' ', SLICE (e, 0, Text.BLen (e) - 3), ' -> ', e) ;
  FOR i := 0 TO nsc - 1 DO
    IF Text.Eq (scText[i], e) THEN RETURN END
  END ;
  IF nsc = LEN (scText) THEN
    nt := NEW (pool, UTF, 2 * LEN (scText) + 4) ;
    FOR i := 0 TO nsc - 1 DO nt[i] := scText[i] END ;
    scText := nt
  END ;
  scText[nsc] := Text.Keep (pool, e) ;
  nsc := nsc + 1
END NoteStale ;

PROCEDURE StaleCalls () : I64 =
BEGIN
  RETURN nsc
END StaleCalls ;

PROCEDURE StaleCall (i: I64) : UTF =
BEGIN
  RETURN scText[i]
END StaleCall ;

PROCEDURE StrSites () : I64 =
BEGIN
  RETURN nss
END StrSites ;

PROCEDURE StrSite (i: I64) : UTF =
BEGIN
  RETURN ssText[i]
END StrSite ;

(* an ADR site of the unit, once though it may be typed more than once *)
PROCEDURE NoteAdr (line: I64 ; RO kind: UTF) =
VAR
  nt : SLICE OF UTF ;
  i : I64 ;
  e, where : UTF ;
BEGIN
  IF quietWalk > 0 THEN RETURN END ;
  where := curProcNm ;
  IF Text.BLen (where) = 0 THEN where := Cat (curMod, ' body') END ;
  e := S5 (ItoA (line), ' ', kind, ' in ', where) ;
  FOR i := 0 TO nad - 1 DO
    IF Text.Eq (adText[i], e) THEN RETURN END
  END ;
  IF nad = LEN (adText) THEN
    nt := NEW (pool, UTF, 2 * LEN (adText) + 4) ;
    FOR i := 0 TO nad - 1 DO nt[i] := adText[i] END ;
    adText := nt
  END ;
  adText[nad] := Text.Keep (pool, e) ;
  nad := nad + 1
END NoteAdr ;

PROCEDURE AdrSites () : I64 =
BEGIN
  RETURN nad
END AdrSites ;

PROCEDURE AdrSite (i: I64) : UTF =
BEGIN
  RETURN adText[i]
END AdrSite ;

PROCEDURE ThreadWrites () : I64 =
BEGIN
  RETURN ntw
END ThreadWrites ;

PROCEDURE ThreadWrite (i: I64) : UTF =
BEGIN
  RETURN twText[i]
END ThreadWrite ;

(* ---- par 6: SHARABLE (2026-10-11; Alex: "an attribute on the job
   type").  What a THREAD is handed and not MOVED -- a pool pointer, a
   VAR parameter's, a module variable's -- both threads hold.  That is
   sound for a MONITOR, whose lock is the point, and for a RECORD whose
   declaration says `[SHARABLE]': the author's claim that the threads'
   writes to it are disjoint (a band each, a monitor field dealing the
   bands out), which no type can prove and the review page lists.  Any
   other RECORD so handed is refused.  A type the checker cannot find
   says nothing, as everywhere. *)
PROCEDURE ShareWhy (RO aTy: UTF ; anyRecord: BOOL) : UTF =
VAR
  t, mn, tn : UTF ;
  m, dot : I64 ;
  body : Ast.Kid ;
BEGIN
  t := aTy ;
  IF Text.StartsWith (t, 'OPT ') THEN t := SLICE (t, 4, Text.BLen (t) - 4) END ;
  IF Text.StartsWith (t, 'SHARED PTR ') THEN t := SLICE (t, 11, Text.BLen (t) - 11)
  ELSIF Text.StartsWith (t, 'PTR ') THEN t := SLICE (t, 4, Text.BLen (t) - 4)
  END ;
  dot := Text.FindChar (t, '.') ;
  IF dot > 0 THEN
    mn := SLICE (t, 0, dot) ;
    tn := SLICE (t, dot + 1, Text.BLen (t) - dot - 1)
  ELSE
    mn := curMod ;
    tn := t
  END ;
  m := FindMod (mn) ;
  IF m < 0 THEN RETURN '' END ;
  body := SwResolve (m, FindTypeIn (m, tn)) ;
  IF body IS SOME b THEN
    IF b.kind = Ast.NRecordType THEN
      IF b.nkids > 2 THEN
        IF b.kids[2] IS SOME at THEN
          IF Text.Eq (at.au, 'SHARABLE') AND NOT anyRecord THEN RETURN '' END
        END
      END ;
      RETURN t
    END
  END ;
  RETURN ''
END ShareWhy ;

(* the record a type names (through PTR, SHARED and OPT), and the first
   SHARED field of it whose target ShareWhy names, or '' *)
PROCEDURE SharedFieldWhy (RO aTy: UTF) : UTF =
VAR
  t, mn, tn, ft, w, was : UTF ;
  m, dot, g : I64 ;
  body : Ast.Kid ;
BEGIN
  t := aTy ;
  IF Text.StartsWith (t, 'OPT ') THEN t := SLICE (t, 4, Text.BLen (t) - 4) END ;
  IF Text.StartsWith (t, 'SHARED PTR ') THEN t := SLICE (t, 11, Text.BLen (t) - 11)
  ELSIF Text.StartsWith (t, 'PTR ') THEN t := SLICE (t, 4, Text.BLen (t) - 4)
  END ;
  dot := Text.FindChar (t, '.') ;
  IF dot > 0 THEN
    mn := SLICE (t, 0, dot) ;
    tn := SLICE (t, dot + 1, Text.BLen (t) - dot - 1)
  ELSE
    mn := curMod ;
    tn := t
  END ;
  m := FindMod (mn) ;
  IF m < 0 THEN RETURN '' END ;
  body := SwResolve (m, FindTypeIn (m, tn)) ;
  IF body IS SOME b THEN
    IF b.kind = Ast.NRecordType THEN
      IF b.kids[1] IS SOME fl THEN
        FOR g := 0 TO fl.nkids - 1 DO
          IF fl.kids[g] IS SOME grp THEN
            was := canonCtx ;
            canonCtx := Text.Keep (pool, mn) ;
            ft := CanonT (grp.kids[1], 0) ;
            canonCtx := was ;
            IF Text.StartsWith (ft, 'SHARED ') OR Text.StartsWith (ft, 'OPT SHARED ') THEN
              w := ShareWhy (ft, FALSE) ;
              IF Text.BLen (w) > 0 THEN RETURN w END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END SharedFieldWhy ;

(* a RECORD takes one attribute, [SHARABLE] *)
PROCEDURE RecordAttribWalk (k: Ast.Kid ; RO ctx: UTF) =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NRecordType AND n.nkids > 2 THEN
      IF n.kids[2] IS SOME at THEN
        IF NOT Text.Eq (at.au, 'SHARABLE') THEN
          ErrN (at, ctx, S3 ('a RECORD takes one attribute, [SHARABLE] (par 6), not [',
            at.au, ']'))
        END
      END
    END ;
    FOR i := 0 TO n.nkids - 1 DO RecordAttribWalk (n.kids[i], ctx) END
  END
END RecordAttribWalk ;

(* is THREAD (P, x)'s target P's parameter OWN? *)
PROCEDURE ThreadOwnTarget (st: PTR Ast.Node) : BOOL =
VAR
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF st.kids[0] IS SOME tn THEN
    IF tn.kind = Ast.NDesignator THEN
      pr := LookupProc (DesigName (tn), found) ;
      IF found THEN
        IF pr.node IS SOME pn THEN
          IF pn.kids[0] IS SOME pl THEN
            IF pl.nkids > 0 THEN
              IF pl.kids[0] IS SOME grp THEN RETURN grp.f2 END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ThreadOwnTarget ;

(* THREAD's argument for a target whose parameter is OWN: CheckArg's
   OWN rules, one by one, worded for the thread *)
PROCEDURE ThreadOwnArg (st: PTR Ast.Node ; RO ctx: UTF ; RO name: UTF ; an: Ast.Kid) =
VAR amode : UTF ;
BEGIN
  IF an IS SOME a THEN
    IF a.kind # Ast.NDesignator THEN RETURN END ;
    IF a.nkids > 0 THEN
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot move through a selector of ', a.au,
        ' into its OWN parameter: a move takes a name that owns its pointer, and ownership is not followed into a field or an element (par 4.2)')) ;
      RETURN
    END ;
    amode := ScopeMode (a.au) ;
    IF Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
       Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo) THEN
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot move borrowed ', a.au,
        ' into its OWN parameter (par 4.2)'))
    ELSIF Text.Eq (amode, ModeModule) AND NOT ownModule AND OwnedPtrTy (a.au) THEN
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot move the module variable ', a.au,
        ' into its OWN parameter in a procedure: the module owns it, and its body reads it after the call -- move it in the module body, or keep the owned value in a local (par 4.2)'))
    ELSIF OwnsNothing (a.au) THEN
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot move ', a.au,
        ' into its OWN parameter: nothing here gives it an owned pointer -- only NEW (OWN, T), an owned name moved in or a call that does not answer what it was lent does (par 4.2)'))
    ELSIF ResolveType (ScopeType (a.au)) IS SOME ares THEN
      IF ares.kind = Ast.NPtrType THEN
        IF ares.kids[1] IS SOME poolName THEN
          ErrN (st, ctx, S5 ('THREAD (', name, '): the pool owns ', a.au, ' (par 4.3)'))
        END
      END
    END
  END
END ThreadOwnArg ;

PROCEDURE CheckThread (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  name, pTy, aTy, amode, what, sw, sh : UTF ;
  dot : I64 ;
  pr : ProcInfo ;
  found, pooled, moved, ownTarget, varTarget : BOOL ;
BEGIN
  moved := FALSE ;
  ownTarget := FALSE ;
  varTarget := FALSE ;
  aTy := ExprType (st.kids[1], ctx) ;
  IF st.kids[0] IS SOME tn THEN
    IF tn.kind # Ast.NDesignator THEN RETURN END ;
    name := DesigName (tn) ;
    (* the target is a procedure of THIS module: the generator makes
       the thread's thunk beside the target, in the module that
       starts it, so `THREAD (Lib.Work, p)' was a link error naming
       a C symbol until 2026-10-08 (the generator's owed line) *)
    dot := Text.FindChar (name, '.') ;
    IF dot > 0 THEN
      IF NOT Text.Eq (SLICE (name, 0, dot), curMod) THEN
        ErrN (st, ctx, S5 ('THREAD (', name, '): the target must be a procedure of this module, not ',
          SLICE (name, 0, dot), "'s -- start it from a procedure declared here (par 6)")) ;
        RETURN
      END
    END ;
    pTy := '' ;
    pr := LookupProc (name, found) ;
    IF found THEN
      IF pr.node IS SOME pn THEN
        canonCtx := pr.modName ;
        IF pn.kids[0] IS SOME pl THEN
          IF pl.nkids > 0 THEN
            IF pl.kids[0] IS SOME grp THEN
              pTy := CanonT (grp.kids[1], 0) ;
              ownTarget := grp.f2 ;
              varTarget := grp.f1
            END
          END
        END ;
        canonCtx := ''
      END
    END ;
    (* a target whose parameter is OWN takes its argument as a call to
       an OWN parameter does (CheckArg): a name that owns its pointer.
       `THREAD (Work, b.p)' and `THREAD (Work, p)' with p borrowed were
       lends, and Work's DISPOSE freed what this thread still held
       (2026-10-28) *)
    IF ownTarget THEN ThreadOwnArg (st, ctx, name, ParenCore (st.kids[1])) END ;
    IF found THEN
      sw := StateWrite (Qualify (pr.modName, pr.name), FindMod (pr.modName), pr.body) ;
      IF Text.BLen (sw) > 0 THEN NoteThreadWrite (st.line, name, sw) END
    END ;
    Agree (StThread, pTy, aTy, st.line) ;
    IF Text.BLen (pTy) > 0 AND Text.BLen (aTy) > 0 THEN
      IF NOT (Compat (pTy, aTy) OR Compat (Cat ('PTR ', pTy), aTy) OR
              Compat (Cat ('SHARED PTR ', pTy), aTy)) THEN
        ErrN (st, ctx, S5 ('THREAD (', name, '): cannot pass ',
          TyName (aTy), S3 (' where ', TyName (pTy), ' is expected')))
      ELSIF NOT varTarget AND NOT Compat (pTy, aTy) THEN
        (* the pointer reaches the record only through a VAR parameter,
           which C passes as the pointer; a value or RO parameter takes
           the record itself, and the C compiler refused the thread's
           thunk (the second review's N7, soundfuzz.owed, 2026-10-29) *)
        ErrN (st, ctx, S5 ('THREAD (', name, '): the target takes its ',
          TyName (pTy), S3 (' by value, and a thread is handed ', TyName (aTy),
          S3 (' -- declare the parameter VAR, or of type ', TyName (aTy), ' (par 6)'))))
      END
    END ;
    (* a frame allocation, or a name holding one, dies when this
       frame exits, which a thread does not wait for: storage handed
       to a thread is allocated with OWN (docs/pool-elision-plan.md) *)
    what := FrameWhat (st.kids[1], aTy) ;
    IF Text.BLen (what) > 0 AND Text.BLen (KindPool (what)) = 0 THEN
      moved := TRUE ;     (* refused here: the sharing rule says no more *)
      (* a local pool's object is lent as any pool pointer is (the
         thread receives the pool through the thunk, and Mat.AddNormal
         WAITs for its workers before the pool dies), and held to
         SHARABLE below, like the rest *)
      ErrN (st, ctx, S5 ('THREAD (', name, '): cannot hand ', what,
        ' to a thread -- it dies with this frame; allocate it with OWN (par 4.3)'))
    END ;
    IF ParenCore (st.kids[1]) IS SOME an THEN
      IF an.kind = Ast.NDesignator THEN
        IF an.nkids = 0 THEN
          amode := ScopeMode (an.au) ;
          IF NOT (Text.Eq (amode, ModeVal) OR Text.Eq (amode, ModeVar) OR
                  Text.Eq (amode, ModeBinder) OR Text.Eq (amode, ModeRo)) THEN
            IF ResolveType (ScopeType (an.au)) IS SOME ares THEN
              IF ares.kind = Ast.NPtrType THEN
                pooled := FALSE ;
                IF ares.kids[1] IS SOME poolName THEN pooled := TRUE END ;
                (* a pool allocation is nobody's to own (pval), as at
                   an assignment: the module body's `j := NEW (pool,
                   Job) ; THREAD (W, j)' lends it, it does not move it *)
                IF NOT pooled AND OwnedCandKind (an.au) > 0 AND
                   NOT FvalHas (an.au) AND NOT PvalHas (an.au) THEN
                  OwnMark (an.au, Cat ('moved into a THREAD running ', name),
                           st) ;
                  moved := TRUE
                END
              END
            END
          END
        END
      END
    END ;
    (* what a moved argument holds is shared all the same: a SHARED field
       of it reaches an object the starting thread still names (the
       fourth review's SharedInMoved: a race TSan reports) *)
    IF moved THEN
      sh := SharedFieldWhy (aTy) ;
      IF Text.BLen (sh) > 0 THEN
        ErrN (st, ctx, S5 ('THREAD (', name, '): the value moved in holds a SHARED handle to ', sh,
          " which the starting thread may still hold, and it is neither a MONITOR nor a RECORD marked [SHARABLE] (par 6)"))
      END
    END ;
    IF NOT moved THEN
      sh := ShareWhy (aTy, FALSE) ;
      IF Text.BLen (sh) > 0 THEN
        ErrN (st, ctx, S5 ('THREAD (', name, '): both threads hold the ', sh,
          " handed over, and it is neither a MONITOR nor a RECORD marked [SHARABLE] -- mark it RECORD ... END [SHARABLE] if the threads' writes to it are disjoint, or move an owned value in (par 6)"))
      ELSIF found AND Text.BLen (ShareWhy (aTy, TRUE)) > 0 THEN
        (* a shared record's pool is carved by both threads at once: the
           target's allocations through its parameter -- a NEW on it, a
           callee growing a DynStr in it -- go to the pool the argument's
           object lives in, and m9_pool_alloc takes no lock (the reviews'
           G8: 21,733 to 29,570 of 400,000 wrong, AdoptRace; a DynStr per
           worker, AdoptAppend).  A MONITOR's fields are reached only
           under its lock, so it is not refused *)
        (* a POOL field or argument is the worker's own only when each
           thread is handed its own object: an element (`THREAD (W,
           sj[i])'), or one THREAD outside any loop.  One record handed
           to eight threads in a loop shares its pool field (the fourth
           review's PoolField: 129,000 of 160,000 cells wrong) *)
        allocNoPool := loopsOpen = 0 ;
        IF st.kids[1] IS SOME aw THEN
          IF aw.kind = Ast.NDesignator AND aw.nkids > 0 THEN allocNoPool := TRUE END
        END ;
        pooled := AllocsThrough (pr, 0) ;
        allocNoPool := FALSE ;
        IF pooled THEN
          ErrN (st, ctx, S3 ('THREAD (', name, "): the target allocates through its parameter, in the pool of the record both threads hold, and the pool takes no lock -- give the worker a POOL of its own to allocate in, or move an owned value in (par 6)"))
        END
      END
    END
  END
END CheckThread ;

PROCEDURE CheckCallStmt (st: PTR Ast.Node ; RO ctx: UTF) =
VAR t : UTF ;
BEGIN
  IF st.kids[0] IS SOME dn THEN
    (* through CallType, so that an unknown callee, a wrong arity and
       a wrong argument are all reported here and not only when the
       call appears in an expression *)
    t := CallType (st.kids[0], st.kids[1], st, ctx) ;
    IF Text.BLen (t) > 0 AND NOT Text.Eq (t, '<void>') THEN
      ErrN (st, ctx, S3 ('function result discarded: ',
        DesigName (dn), Cat (' returns ', TyName (t))))
    END
  END
END CheckCallStmt ;

(* a CASE pattern's binders, bound with the variant's field types --
   the oracle's BindPattern, by global variant-name search -- and,
   par 4.1 direction, each views the selector's payload, so it
   inherits the selector's reach *)
PROCEDURE BindPat (lbl: PTR Ast.Node ; RO KEPT selRoot: UTF) =
VAR
  flat : SLICE OF AKid ;
  nflat, m, j, v, n, pass : I64 ;
  done : BOOL ;
BEGIN
  nflat := 0 ;
  flat := NEW (pool, AKid, 1) ;
  done := FALSE ;
  (* the module being checked first, then the others: by the first
     module LOADED, JsonUtf's `Str (t)' took Json's `Str : RO s: STR'
     wherever both were loaded (semdiff, 2026-10-23; the canonCtx
     class) -- the oracle's VariantOwner the same *)
  FOR pass := 0 TO 1 DO
    FOR m := 0 TO nmods - 1 DO
      IF (pass = 1) # Text.Eq (mods[m].name, curMod) THEN
        FOR j := 0 TO mods[m].nvts - 1 DO
          FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
            IF NOT done AND Text.Eq (mods[m].vts[j].variants[v], lbl.au) THEN
              flat := FlatFields (mods[m].vts[j].fields[v], nflat) ;
              done := TRUE
            END
          END
        END
      END
    END
  END ;
  IF lbl.kids[0] IS SOME ids THEN
    FOR n := 0 TO ids.nkids - 1 DO
      IF ids.kids[n] IS SOME id THEN
        IF n < nflat THEN BindName (id.au, flat[n])
        ELSE BindName (id.au, NONE) END ;
        IF Text.BLen (selRoot) > 0 THEN
          (* and, provenance, the pattern binder carries the selector *)
          EscStore (selRoot, TRUE, id.au) ;
          CarryFrom (id.au, selRoot)
        END
      END
    END
  END
END BindPat ;

PROCEDURE BindPats (arm: PTR Ast.Node ; RO KEPT selRoot: UTF) =
VAR k : I64 ;
BEGIN
  IF arm.kids[0] IS SOME ll THEN
    FOR k := 0 TO ll.nkids - 1 DO
      IF ll.kids[k] IS SOME lbl THEN
        IF lbl.kind = Ast.NLabelPattern THEN BindPat (lbl, selRoot) END
      END
    END
  END
END BindPats ;

(* ---- pass 2: the body walk, and the par 4.1 retention ledger ----

   The ledger is MEASURED, not rejected.  A borrowed reference stored
   beyond the frame is exactly what par 4.1 predicts callers will want
   to do, so the design's price is the count of places that do it --
   and the kill-gate reads that count.  Which is why it is output and
   not a debug aside, and why the gate now fails the build: a rule
   that only prints a verdict is not a rule.

   SHARED handles are excluded.  Copying one IS the sanctioned
   retention -- refcounted, created explicitly (par 4.2) -- so
   counting it would inflate the price of a discipline it obeys.    *)

PROCEDURE WalkStmt (k: Ast.Kid ; RO ctx: UTF) ;

(* ---- DEFINITE ASSIGNMENT of the locals whose type is a pointer that
   is not OPT (2026-10-21, report par 4; the compiler review's C8).  A
   local `p : PTR T' starts as nothing -- a zeroed slot, NULL in C -- and
   was dereferenced unseen: `VAR p : PTR Node ; ... p.n' died with
   SIGSEGV, and a pointer assigned on one branch only did the same on
   the other.  The walk follows the statements: an assignment gives the
   name its value, as does a VAR or OWN argument (the callee may fill
   it); a read before that, on any path the walk can see, is refused,
   once per name.  IF and CASE keep what every arm that goes on gives,
   an arm ending in RETURN, RAISE or EXIT gives everything; a loop's
   body and a block's handlers give nothing to what follows them.  Not
   followed: a field of a zeroed record -- that one is tested at run
   time (m9_unset) -- and a module variable. ---- *)
VAR
  daNames : SLICE OF UTF ;
  daN : I64 ;
  daCtx : UTF ;

PROCEDURE DaFind (RO nm: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO daN - 1 DO
    IF Text.Eq (daNames[i], nm) THEN RETURN i END
  END ;
  RETURN -1
END DaFind ;

PROCEDURE DaCopy (RO st: SLICE OF BOOL) : SLICE OF BOOL =
VAR
  r : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  r := NEW (BOOL, LEN (st)) ;
  FOR i := 0 TO LEN (st) - 1 DO r[i] := st[i] END ;
  RETURN r
END DaCopy ;

PROCEDURE DaRead (e: PTR Ast.Node ; st: SLICE OF BOOL) =
VAR x : I64 ;
BEGIN
  x := DaFind (e.au) ;
  IF x >= 0 THEN
    IF NOT st[x] THEN
      ErrN (e, daCtx, Cat (e.au,
        ' is read before it is assigned: a PTR that is not OPT has no value until it is given one -- assign it on every path first (par 4)')) ;
      st[x] := TRUE
    END
  END
END DaRead ;

(* is argument k of the call through cd a VAR or OWN parameter? *)
(* does a body give its VAR parameter nm a value: an assignment to the
   bare name, or the name handed on as an argument (to a VAR parameter,
   which may give it one) *)
PROCEDURE DaGives (k: Ast.Kid ; RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND lh.nkids = 0 AND Text.Eq (lh.au, nm) THEN RETURN TRUE END
      END
    END ;
    IF e.kind = Ast.NArgList THEN
      FOR i := 0 TO e.nkids - 1 DO
        IF e.kids[i] IS SOME a THEN
          IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, nm) THEN RETURN TRUE END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF DaGives (e.kids[i], nm) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DaGives ;

PROCEDURE DaArgByRef (cd: PTR Ast.Node ; k: I64) : BOOL =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  g, j, n : I64 ;
BEGIN
  pr := LookupProc (DesigName (cd), found) ;
  IF NOT found THEN RETURN FALSE END ;
  n := 0 ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF n = k THEN
                (* a VAR argument is given a value only where the callee's
                   body gives its parameter one: `Nothing (p)' that never
                   wrote p left it NULL, and `p.n' after it was not
                   guarded (the second review's S10, 2026-10-26).  A callee
                   whose body is not here -- foreign, another module's
                   implementation not loaded -- is trusted, as before *)
                IF grp.f1 AND NOT grp.f2 THEN
                  IF pr.body IS SOME b THEN
                    IF ids.kids[j] IS SOME id THEN RETURN DaGives (b.kids[4], id.au) END
                  END
                END ;
                RETURN grp.f1 OR grp.f2
              END ;
              n := n + 1
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END DaArgByRef ;

PROCEDURE DaExpr (k: Ast.Kid ; st: SLICE OF BOOL) ;

PROCEDURE DaArgs (cd: Ast.Kid ; al: Ast.Kid ; st: SLICE OF BOOL) =
VAR
  i, x : I64 ;
  byRef : BOOL ;
BEGIN
  IF al IS SOME a THEN
    FOR i := 0 TO a.nkids - 1 DO
      IF a.kids[i] IS SOME ar THEN
        byRef := FALSE ;
        IF cd IS SOME c THEN
          IF c.kind = Ast.NDesignator THEN byRef := DaArgByRef (c, i) END
        END ;
        IF byRef AND ar.kind = Ast.NDesignator AND ar.nkids = 0 THEN
          x := DaFind (ar.au) ;
          IF x >= 0 THEN st[x] := TRUE END
        ELSE
          DaExpr (a.kids[i], st)
        END
      END
    END
  END
END DaArgs ;

PROCEDURE DaExpr (k: Ast.Kid ; st: SLICE OF BOOL) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      DaArgs (e.kids[0], e.kids[1], st) ;
      RETURN
    END ;
    IF e.kind = Ast.NDesignator THEN DaRead (e, st) END ;
    FOR i := 0 TO e.nkids - 1 DO DaExpr (e.kids[i], st) END
  END
END DaExpr ;

PROCEDURE DaSeq (k: Ast.Kid ; st: SLICE OF BOOL) : BOOL ;

(* a branch's end state into acc, when the branch goes on *)
PROCEDURE DaMerge (acc: SLICE OF BOOL ; RO b: SLICE OF BOOL ; ended: BOOL ;
                   VAR alive: BOOL) =
VAR i : I64 ;
BEGIN
  IF ended THEN RETURN END ;
  alive := TRUE ;
  FOR i := 0 TO LEN (acc) - 1 DO acc[i] := acc[i] AND b[i] END
END DaMerge ;

PROCEDURE DaAll (n: I64) : SLICE OF BOOL =
VAR
  r : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  r := NEW (BOOL, n) ;
  FOR i := 0 TO n - 1 DO r[i] := TRUE END ;
  RETURN r
END DaAll ;

PROCEDURE DaStmt (k: Ast.Kid ; st: SLICE OF BOOL) : BOOL =
VAR
  j, x, i : I64 ;
  acc, b : SLICE OF BOOL ;
  alive, hasElse, e2 : BOOL ;
BEGIN
  IF k IS SOME s THEN
    CASE s.kind OF
    | Ast.NAssign :
        DaExpr (s.kids[1], st) ;
        IF s.kids[0] IS SOME lh THEN
          IF lh.nkids = 0 THEN
            x := DaFind (lh.au) ;
            IF x >= 0 THEN st[x] := TRUE END
          ELSE
            DaExpr (s.kids[0], st)
          END
        END
    | Ast.NCallStmt :
        DaArgs (s.kids[0], s.kids[1], st)
    | Ast.NReturn, Ast.NRaiseStmt :
        FOR j := 0 TO s.nkids - 1 DO DaExpr (s.kids[j], st) END ;
        RETURN TRUE
    | Ast.NExit :
        RETURN TRUE
    | Ast.NIf :
        DaExpr (s.kids[0], st) ;
        acc := DaAll (LEN (st)) ;
        alive := FALSE ;
        b := DaCopy (st) ;
        e2 := DaSeq (s.kids[1], b) ;
        DaMerge (acc, b, e2, alive) ;
        hasElse := FALSE ;
        FOR j := 2 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t THEN
            b := DaCopy (st) ;
            IF t.kind = Ast.NElsif THEN
              DaExpr (t.kids[0], b) ;
              e2 := DaSeq (t.kids[1], b)
            ELSE
              hasElse := TRUE ;
              e2 := DaSeq (t.kids[0], b)
            END ;
            DaMerge (acc, b, e2, alive)
          END
        END ;
        IF NOT hasElse THEN DaMerge (acc, st, FALSE, alive) END ;
        IF NOT alive THEN RETURN TRUE END ;
        FOR i := 0 TO LEN (st) - 1 DO st[i] := acc[i] END
    | Ast.NCase :
        DaExpr (s.kids[0], st) ;
        acc := DaAll (LEN (st)) ;
        alive := FALSE ;
        hasElse := FALSE ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t2 THEN
            b := DaCopy (st) ;
            IF t2.kind = Ast.NCaseArm THEN
              e2 := DaSeq (t2.kids[1], b)
            ELSE
              hasElse := TRUE ;
              e2 := DaSeq (t2.kids[0], b)
            END ;
            DaMerge (acc, b, e2, alive)
          END
        END ;
        IF NOT hasElse THEN DaMerge (acc, st, FALSE, alive) END ;
        IF NOT alive THEN RETURN TRUE END ;
        FOR i := 0 TO LEN (st) - 1 DO st[i] := acc[i] END
    | Ast.NWhile :
        DaExpr (s.kids[0], st) ;
        b := DaCopy (st) ;
        e2 := DaSeq (s.kids[1], b)
    | Ast.NFor :
        DaExpr (s.kids[0], st) ;
        DaExpr (s.kids[1], st) ;
        b := DaCopy (st) ;
        e2 := DaSeq (s.kids[3], b)
    | Ast.NForIn :
        DaExpr (s.kids[0], st) ;
        b := DaCopy (st) ;
        (* the loop gives its variable each element: inside the body it
           has a value (FOR p IN rows over pointers) *)
        x := DaFind (s.au) ;
        IF x >= 0 THEN b[x] := TRUE END ;
        e2 := DaSeq (s.kids[1], b)
    | Ast.NLoop :
        b := DaCopy (st) ;
        e2 := DaSeq (s.kids[0], b)
    | Ast.NBlock :
        b := DaCopy (st) ;
        e2 := DaSeq (s.kids[0], b) ;
        acc := DaAll (LEN (st)) ;
        alive := FALSE ;
        DaMerge (acc, b, e2, alive) ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME h THEN
            IF h.kind = Ast.NHandler THEN
              b := DaCopy (st) ;
              e2 := DaSeq (h.kids[2], b) ;
              DaMerge (acc, b, e2, alive)
            ELSIF h.kind = Ast.NFinally THEN
              b := DaCopy (st) ;
              e2 := DaSeq (h.kids[0], b)
            END
          END
        END ;
        IF NOT alive THEN RETURN TRUE END ;
        FOR i := 0 TO LEN (st) - 1 DO st[i] := acc[i] END
    ELSE
      FOR j := 0 TO s.nkids - 1 DO DaExpr (s.kids[j], st) END
    END
  END ;
  RETURN FALSE
END DaStmt ;

PROCEDURE DaSeq (k: Ast.Kid ; st: SLICE OF BOOL) : BOOL =
VAR j : I64 ;
BEGIN
  IF k IS SOME q THEN
    IF q.kind # Ast.NStmtSeq THEN RETURN DaStmt (k, st) END ;
    FOR j := 0 TO q.nkids - 1 DO
      IF DaStmt (q.kids[j], st) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DaSeq ;

PROCEDURE DaProc (body: Ast.Kid ; RO ctx: UTF) =
VAR
  i : I64 ;
  st : SLICE OF BOOL ;
  e2 : BOOL ;
BEGIN
  daNames := NEW (pool, UTF, nscope + 1) ;
  daN := 0 ;
  daCtx := Text.Keep (pool, ctx) ;
  FOR i := 0 TO nscope - 1 DO
    IF Text.Eq (scope[i].mode, ModeLocal) THEN
      IF ResolveType (scope[i].ty) IS SOME rt THEN
        IF rt.kind = Ast.NPtrType OR rt.kind = Ast.NSharedType THEN
          daNames[daN] := scope[i].name ;
          daN := daN + 1
        END
      END
    END
  END ;
  IF daN = 0 THEN RETURN END ;
  st := NEW (BOOL, daN) ;
  e2 := DaSeq (body, st)
END DaProc ;


PROCEDURE WalkSeq (k: Ast.Kid ; RO ctx: UTF) =
VAR j : I64 ;
BEGIN
  IF k IS SOME s THEN
    FOR j := 0 TO s.nkids - 1 DO
      WalkStmt (s.kids[j], ctx)
    END
  END
END WalkSeq ;

(* a NEW from a named pool or an object's pool: not the frame form,
   not OWN *)
PROCEDURE IsPoolNew (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.nkids = 0 AND Text.Eq (d.au, 'OWN') THEN RETURN FALSE END
      END ;
      RETURN NOT NewIsFrame (e)
    END
  END ;
  RETURN FALSE
END IsPoolNew ;

(* HEAP, or a name declared POOL in scope *)
PROCEDURE IsPoolName (RO nm: UTF) : BOOL =
BEGIN
  IF Text.Eq (nm, 'HEAP') THEN RETURN TRUE END ;
  IF ScopeType (nm) IS SOME q THEN
    IF q.kind = Ast.NQualident THEN
      RETURN Text.Eq (q.au, 'POOL') AND Text.BLen (q.bu) = 0
    END
  END ;
  RETURN FALSE
END IsPoolName ;

(* the pool an allocation on the right-hand side names, for the
   declared-pool check: `NEW (Q, T)` with Q a pool in scope or HEAP,
   or a call whose result type promises `IN r` with a bare name Q
   handed to r; '' when the shape says nothing *)
PROCEDURE AllocPoolOf (k: Ast.Kid ; RO ctx: UTF) : UTF =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  i, j, ix, want : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.nkids = 0 AND NOT Text.Eq (d.au, 'OWN') THEN
          IF IsPoolName (d.au) THEN RETURN d.au END
        END
      END ;
      RETURN ''
    END ;
    (* UTF (pool, x) answers in pool, as NEW (pool, ...) does *)
    IF Text.BLen (UtfInPool (e)) > 0 THEN
      IF IsPoolName (UtfInPool (e)) THEN RETURN UtfInPool (e) END ;
      RETURN ''
    END ;
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pr := LookupProc (DesigName (dn), found) ;
          IF found THEN
            IF pr.node IS SOME pn THEN
              IF pn.kids[1] IS SOME rt THEN
                want := -1 ;
                IF rt.kind = Ast.NPtrType THEN
                  IF rt.kids[1] IS SOME rn THEN
                    (* `: PTR T IN rn': the promise names the pool *)
                    ix := 0 ;
                    IF pn.kids[0] IS SOME pl THEN
                      FOR i := 0 TO pl.nkids - 1 DO
                        IF pl.kids[i] IS SOME grp THEN
                          IF grp.kids[0] IS SOME ids THEN
                            FOR j := 0 TO ids.nkids - 1 DO
                              IF ids.kids[j] IS SOME id THEN
                                IF Text.Eq (id.au, rn.au) THEN want := ix END
                              END ;
                              ix := ix + 1
                            END
                          END
                        END
                      END
                    END
                  END
                END ;
                (* no promise: a procedure that takes a POOL answers in
                   it (docs/pools.md), so a pointer-bearing answer lives
                   in the first POOL argument.  `RETURN DynStr.Utf8 (p,
                   text)' with p a local pool passed the checker and
                   came back as freed bytes (RdfTest, 2026-10-07); the
                   call-summary item of the owed ledger, made concrete *)
                IF want < 0 AND PtrBearingIn (pr.modName, SOME (rt)) THEN
                  ix := 0 ;
                  IF pn.kids[0] IS SOME pl THEN
                    FOR i := 0 TO pl.nkids - 1 DO
                      IF pl.kids[i] IS SOME grp THEN
                        IF grp.kids[0] IS SOME ids THEN
                          IF grp.kids[1] IS SOME pt THEN
                            IF pt.kind = Ast.NQualident AND Text.Eq (pt.au, 'POOL') AND
                               Text.BLen (pt.bu) = 0 AND want < 0 THEN
                              want := ix
                            END
                          END ;
                          ix := ix + ids.nkids
                        END
                      END
                    END
                  END
                END ;
                IF e.kids[1] IS SOME al THEN
                  IF want >= 0 AND want < al.nkids THEN
                    IF al.kids[want] IS SOME an THEN
                      IF an.kind = Ast.NDesignator AND an.nkids = 0 THEN
                        IF IsPoolName (an.au) THEN RETURN an.au END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN ''
END AllocPoolOf ;

(* the fields, flattened, of the variant or record a call CONSTRUCTS
   -- `Data.F64s (v, miss)', `Mod.T.Arm (...)', `Row (a, b)' -- and
   their module in OM; -1 when the call constructs nothing *)
PROCEDURE CtorFields (k: Ast.Kid ; VAR flat: SLICE OF AKid ; VAR om: UTF) : I64 =
VAR
  name, t, canon : UTF ;
  dot, g, n : I64 ;
  fields : Ast.Kid ;
  isVar : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          name := DesigName (dn) ;
          dot := Text.FindChar (name, '.') ;
          isVar := FALSE ;
          IF dot > 0 THEN
            t := SLICE (name, dot + 1, Text.BLen (name) - dot - 1) ;
            g := Text.FindChar (t, '.') ;
            IF g > 0 THEN
              om := SLICE (name, 0, dot) ;
              isVar := TryVariantMod (FindMod (om), SLICE (t, 0, g),
                                      SLICE (t, g + 1, Text.BLen (t) - g - 1),
                                      om, fields)
            ELSE
              isVar := FindVariant (SLICE (name, 0, dot), t, om, fields)
            END
          END ;
          IF isVar THEN
            flat := FlatFields (fields, n) ;
            RETURN n
          END ;
          IF RecordNamed (name, om, canon) IS SOME rn THEN
            flat := FlatFields (rn.kids[1], n) ;
            RETURN n
          END
        END
      END
    END
  END ;
  RETURN -1
END CtorFields ;

(* does a value of canonical type U carry a reference: a pointer or
   slice itself (IsRefTy), or a record, case record, array or OPT
   that holds one by resolution (PtrBearing)?  A record VALUE stored
   beyond the frame retains whatever its fields view. *)
(* PtrBearing of a type module m's declaration names, read in m *)
PROCEDURE PtrBearingIn (RO m: UTF ; t: Ast.Kid) : BOOL =
VAR
  was : UTF ;
  r : BOOL ;
BEGIN
  was := canonCtx ;
  canonCtx := Text.Keep (pool, m) ;
  r := PtrBearing (t, 0) ;
  canonCtx := was ;
  RETURN r
END PtrBearingIn ;

PROCEDURE TyBearing (RO u: UTF) : BOOL =
VAR
  dot, m : I64 ;
  t : Ast.Kid ;
  was : UTF ;
  r : BOOL ;
BEGIN
  IF IsRefTy (u) THEN RETURN TRUE END ;
  dot := Text.FindChar (u, '.') ;
  IF dot <= 0 THEN RETURN FALSE END ;
  IF Text.FindChar (u, ' ') >= 0 THEN RETURN FALSE END ;
  m := FindMod (SLICE (u, 0, dot)) ;
  IF m < 0 THEN RETURN FALSE END ;
  t := FindTypeIn (m, SLICE (u, dot + 1, Text.BLen (u) - dot - 1)) ;
  (* the type's fields are read in the module that declares it -- the
     canonCtx rule: until 2026-10-22 its bare names were found by the
     scan over every loaded module (item 12's measurement) *)
  was := canonCtx ;
  canonCtx := Text.Keep (pool, mods[m].name) ;
  r := PtrBearing (t, 0) ;
  canonCtx := was ;
  RETURN r
END TyBearing ;

(* one reference-valued source stored by an assignment: pended when
   the destination outlives the frame, carried by a bare local or
   binder, an escape fact when rooted in frame storage -- the three
   acts CheckAssign did for a bare right-hand side, now shared with
   each borrow a CONSTRUCTOR wraps (2026-10-08) *)
PROCEDURE StoreRef (st: PTR Ast.Node ; KEPT lhs: PTR Ast.Node ; RO KEPT vname: UTF ;
                    beyond: BOOL ; RO lhsMode: UTF ; RO ctx: UTF) =
VAR m, dst : UTF ;
BEGIN
  m := ScopeMode (vname) ;
  (* a store into a VAR parameter's OWN storage -- not beyond: no
     pointer or slice crossed on the way -- hands the borrow back to
     the caller through that parameter, as a RETURN hands it back
     through the answer; the destination is marked '>' so that
     EmitPend records the reach without demanding KEPT (2026-10-18) *)
  dst := lhs.au ;
  IF Text.Eq (lhsMode, ModeVar) AND NOT beyond THEN
    dst := Text.Keep (pool, Cat ('>', lhs.au))
  END ;
  IF Text.Eq (m, ModeVal) OR Text.Eq (m, ModeVar) OR Text.Eq (m, ModeRo) OR
     Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeBinder) THEN
    IF beyond OR Text.Eq (lhsMode, ModeModule) OR
       (Text.Eq (lhsMode, ModeVar) AND lhs.nkids > 0) THEN
      PendPush (st.line, st.col, vname, dst)
    END
  END ;
  IF Text.Eq (lhsMode, ModeLocal) OR Text.Eq (lhsMode, ModeBinder) THEN
    (* a bare local now holds the reference; a COMPONENT of a local
       record holds it too, and the record is what gets stored on
       (`c.data := v ; f.cols[n] := c', Frame's Add*; 2026-10-08) *)
    CarryFrom (lhs.au, vname)
  END ;
  IF IsFrameMode (m) THEN
    EscStore (dst, lhs.nkids > 0, vname)
  END
END StoreRef ;

PROCEDURE CheckAssign (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  beyond, isShared : BOOL ;
  vname, t, u, lhsMode, dmode, what, apool, par, om, fty, pp, vroot : UTF ;
  lv, nflat, k, vj : I64 ;
  flat : SLICE OF AKid ;
BEGIN
  IF st.kids[0] IS SOME lhs THEN
    (* the types first, in the oracle's order: the left side, the
       right side, then whether one may become the other *)
    t := DesigStrType (lhs, FALSE, ctx) ;
    (* the UTF-8 plan's step 0: a write through a STR's subscript *)
    IF lhs.nkids > 0 THEN
      IF lhs.kids[lhs.nkids - 1] IS SOME lsel THEN
        IF NxFind (strScanIx, Text.Keep (pool, Cat (ItoA (lsel.id), ' index'))) >= 0 THEN
          StrScan (lsel, 'write', Print.ExprTextUtf (st.kids[0]))
        END
      END
    END ;
    (* a bare name on the left declared nowhere: `x := 1' with no x;
       a procedure is declared, and is no variable: `P := 1',
       `Io.WriteLine := s' *)
    IF lhs.nkids = 0 AND Text.BLen (ScopeMode (lhs.au)) = 0 AND
       ProcIn (FindMod (curMod), lhs.au) THEN
      ErrN (lhs, ctx, S3 ('cannot assign to ', lhs.au,
                          S3 (' -- ', lhs.au, ' is a PROCEDURE, not a variable')))
    ELSIF lhs.nkids = 0 AND NOT BareNameKnown (lhs.au) THEN
      ErrN (lhs, ctx, Cat ('unknown name: ', lhs.au))
    ELSIF lhs.nkids >= 1 AND Text.BLen (ScopeMode (lhs.au)) = 0 AND HasExcAny (lhs.au) THEN
      (* `IndexError[0] := 1': the generator's `unknown name' until
         2026-10-30 (the fuzz review's N13) *)
      ErrN (lhs, ctx, S3 ('cannot assign through ', lhs.au,
                          S3 (' -- ', lhs.au, ' is an EXCEPTION, not a variable')))
    ELSIF lhs.nkids >= 1 AND NOT BareNameKnown (lhs.au) AND
          NOT ModImports (curRoot, curMod, lhs.au) THEN
      (* `w.n := 1', `w[0] := 1' with no w *)
      ErrN (lhs, ctx, Cat ('unknown name: ', lhs.au))
    END ;
    IF lhs.nkids = 1 AND Text.BLen (ScopeMode (lhs.au)) = 0 AND FindMod (lhs.au) >= 0 THEN
      IF lhs.kids[0] IS SOME psel THEN
        IF psel.kind = Ast.NSelField AND
           ProcIn (FindMod (lhs.au), psel.au) THEN
          ErrN (lhs, ctx, S3 ('cannot assign to ', Cat (lhs.au, Cat ('.', psel.au)),
                              S3 (' -- ', Cat (lhs.au, Cat ('.', psel.au)),
                                  ' is a PROCEDURE, not a variable')))
        END
      END
    END ;
    u := ExprType (st.kids[1], ctx) ;
    IF Text.BLen (showName) > 0 AND lhs.nkids = 0 AND Text.Eq (lhs.au, showName) THEN
      shown := Text.Keep (pool, u) ;
      RETURN
    END ;
    (* par 2.3: a FRAME-SCOPED string (a concatenation, or a name
       already holding one) may not be stored where it will be read
       after this frame is freed -- a module variable, or a
       COMPONENT reached through a reference parameter (or a value
       pointer's target).  A bare VAR/OWN STR parameter is not
       refused: the generator re-homes its target into the caller's
       arena at exit, as it does the result.  A bare frame-mode
       destination merely inherits the taint and is cleared when
       given a durable value. *)
    IF st.kids[1] IS SOME frhs THEN
      what := FrameWhat (st.kids[1], u) ;
      (* the CALLER's pool, handed in as a POOL parameter, lives as long
         as the caller's frame may: kept in a module variable, the
         storage is read after a local pool of the caller died (the
         tutor's prevName, 2026-09).  0 sites in 616 files measured;
         HEAP and a module's own pools are not parameters. *)
      IF Text.BLen (what) = 0 AND lhs.nkids = 0 AND
         Text.Eq (ScopeMode (lhs.au), ModeModule) AND NOT curInBody AND
         (frhs.kind = Ast.NNewExpr OR frhs.kind = Ast.NCallExpr) THEN
        pp := AllocPoolOf (SOME (frhs), '') ;
        IF Text.BLen (pp) > 0 AND Text.Eq (ScopeMode (pp), ModeVar) THEN
          ErrN (frhs, ctx, S4 ('an allocation in pool ', pp,
            Cat (", the caller's, may die before module variable ", lhs.au),
            ' is read (par 4.3) -- allocate it in a module pool (VAR mpool : POOL ; NEW (mpool, T)), or copy a string: Text.Keep (mpool, s)'))
        END
      END ;
      IF Text.BLen (what) > 0 THEN
        (* a frame value is par 2.3's rule; storage in a local pool,
           or a view of it, is par 4.3's, refused at the same places
           and for the same reason -- and additionally where the
           destination is declared IN a pool that is NOT local, since
           that pool outlives the frame while a local pool's value
           may rest in a name declared IN any local pool, all of which
           die together (the clause check below speaks when an
           allocation names a pool other than the declared one) *)
        IF Text.BLen (KindPool (what)) > 0 THEN par := '4.3' ELSE par := '2.3' END ;
        dmode := ScopeMode (lhs.au) ;
        IF Text.Eq (dmode, ModeModule) AND NOT curInBody THEN
          ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored in module variable ',
            lhs.au, S4 (' (par ', par, ')',
              ' -- allocate it in a module pool (VAR mpool : POOL ; NEW (mpool, T)), or copy a string: Text.Keep (mpool, s)')))
        ELSIF Text.Eq (dmode, ModeRo) OR
              ((Text.Eq (dmode, ModeVar) OR Text.Eq (dmode, ModeOwn) OR
                Text.Eq (dmode, ModeVal)) AND lhs.nkids > 0) THEN
          ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored through ',
            lhs.au, S3 (', which outlives it (par ', par, ')')))
        ELSIF lhs.nkids = 0 AND IsFrameMode (dmode) THEN
          (* a local declared IN a pool claims that pool's lifetime,
             and rule 2 hands that pool to every callee that grows
             the object: a frame value held there would have its
             growth outlive its head (docs/pool-elision-plan.md) *)
          IF Text.Eq (dmode, ModeLocal) THEN
            IF DeclPool (ScopeType (lhs.au)) IS SOME dp THEN
              IF Text.BLen (KindPool (what)) = 0 THEN
                ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be held by ',
                  lhs.au, ', which is declared IN a pool (par 4.3)'))
              ELSIF NOT Text.Eq (ScopeMode (dp.au), ModeLocal) AND
                    Text.BLen (AllocPoolOf (st.kids[1], ctx)) = 0 THEN
                ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be held by ',
                  lhs.au, ', which is declared IN a pool (par 4.3)'))
              END
            ELSE
              FvalAdd (lhs.au, Text.Keep (pool, what))
            END
          ELSE
            FvalAdd (lhs.au, Text.Keep (pool, what))
          END
        ELSIF lhs.nkids > 0 AND Text.Eq (dmode, ModeLocal) THEN
          (* a COMPONENT of a local: the record, or the pointer's
             target, now holds a frame value.  Declared IN a pool, the
             target outlives the frame and the store is refused;
             otherwise the local carries the taint, so copying it out
             is refused as the value itself would be.  Found by stage
             5 of the pool elision: RegisterUnit's ProcInfo held
             RaisesOf's answer in a field and was appended to a module
             table, and every exception name read empty. *)
          IF DeclPool (ScopeType (lhs.au)) IS SOME dp2 THEN
            IF Text.BLen (KindPool (what)) = 0 OR
               NOT Text.Eq (ScopeMode (dp2.au), ModeLocal) THEN
              ErrN (frhs, ctx, S4 (what, ' dies with this frame; it cannot be stored through ',
                lhs.au, ', which is declared IN a pool (par 4.3)'))
            END
          ELSE
            FvalAdd (lhs.au, Text.Keep (pool, what)) ;
            (* and the component itself, by its path, so that copying
               the component out is refused as the whole is
               (FrameWhat; Png.Raster's `RETURN c.pix', 2026-10-03) *)
            FvalAdd (Text.Keep (pool, DesigPath (lhs)), Text.Keep (pool, what))
          END
        END
      ELSIF lhs.nkids = 0 THEN
        FvalDel (lhs.au)
      ELSIF Text.Eq (ScopeMode (lhs.au), ModeLocal) THEN
        FvalDel (DesigPath (lhs))
      END ;
      (* a bare name given a pool allocation holds nobody's object *)
      IF lhs.nkids = 0 THEN
        IF IsPoolNew (st.kids[1]) THEN PvalAdd (lhs.au) ELSE PvalDel (lhs.au) END
      END ;
      (* par 4.3: the IN clause of a declaration is the pool rule 2
         hands to every callee that grows the object, so it must be
         the pool the object was allocated in.  `acc : PTR DString IN
         scratch ; acc := DynUtf.New (pool)` grew its buffer in the
         wrong arena once the parameter that used to say `pool` was
         gone (stage 5, Http.Once: the first chunked body past one
         read block crashed). *)
      IF lhs.nkids = 0 THEN
        IF DeclPool (ScopeType (lhs.au)) IS SOME dp THEN
          apool := AllocPoolOf (st.kids[1], ctx) ;
          IF Text.BLen (apool) > 0 AND NOT Text.Eq (apool, dp.au) THEN
            ErrN (frhs, ctx, S5 (lhs.au, ' is declared IN ', dp.au,
              ' but allocated in ', Cat (apool, ' (par 4.3)')))
          END
        END
      END
    END ;
    (* anchored at the RIGHT-HAND SIDE, not the statement: a value
       on its own line used to be reported one line too high, at
       the := (found by the first m9edit user) *)
    IF st.kids[1] IS SOME rhn THEN
      IF Text.Eq (u, '<void>') THEN
        ErrN (rhn, ctx, 'the right-hand side returns no value')
      ELSE
        u := AdaptLit (st.kids[1], t, u) ;
        Agree (StAssign, t, u, rhn.line) ;
        IF NOT Compat (t, u) THEN
          ErrN (rhn, ctx, S5 ('cannot assign ', TyName (u), ' to ',
            TyName (t), ' (no implicit conversions, par 2.1)'))
        ELSIF LitOut (rhn, t, lv) THEN
          ErrN (rhn, ctx, S4 ('integer literal ', ItoA (lv),
            ' does not fit ', TyName (t)))
        END
      END
    END ;
    (* a WRITE through a selector is a use of its root: `p.n := 8`
       after p was moved is the same fault as reading p.n.  The oracle
       had this and this side did not, found by the THREAD probe of
       2026-09-27 (docs/agent-review-2026-09-27.md F2). *)
    IF lhs.nkids > 0 THEN NoteUse (lhs, ctx) END ;
    beyond := CheckWrite (lhs, ctx) ;
    (* a bare owned pointer on the right MOVES out of its name; a
       bare name on the left is (re)initialised.  A name holding a
       FRAME allocation is not owned -- the frame is -- so copying it
       is a copy, not a move (docs/pool-elision-plan.md, rule 1). *)
    (* the parentheses stripped, as the Pascal twin's StripParens does:
       `t := (s)' moves s as `t := s' does (CheckFuzz, 2026-10-11) *)
    IF ParenCore (st.kids[1]) IS SOME rhs THEN
      IF rhs.kind = Ast.NDesignator THEN
        IF rhs.nkids = 0 THEN
          IF OwnedCandKind (rhs.au) = 1 THEN
            IF NOT FvalHas (rhs.au) AND NOT PvalHas (rhs.au) THEN
              OwnMark (rhs.au, 'moved', st)
            END
          END
        END
      END
    END ;
    IF lhs.nkids = 0 THEN OwnAlive (lhs.au) END ;
    (* EscRootOf, not RefRootOf: a sub-slice view of a borrow
       stored beyond the frame retains the borrow just as the whole
       of it would *)
    vname := EscRootOf (st.kids[1]) ;
    isShared := Text.StartsWith (u, 'SHARED PTR ') OR
                Text.StartsWith (u, 'OPT SHARED PTR ') ;
    lhsMode := ScopeMode (lhs.au) ;
    (* PENDED, not emitted: the class -- retention, self-store,
       frame-store -- needs every escape of the destination, so the
       walk finishes first (FlushPend).  A local or binder may CARRY
       a borrow: recorded now, resolved at flush once the carries are
       closed, and dropped there if it carries none.  A RECORD value
       that holds a reference (TyBearing) is stored as the reference
       would be: until 2026-10-08 only a bare pointer or slice was,
       and a record local whose field viewed a borrow went through a
       VAR parameter's component unseen (Frame.AddF64). *)
    IF Text.BLen (vname) > 0 AND TyBearing (u) AND NOT isShared THEN
      StoreRef (st, lhs, vname, beyond, lhsMode, ctx)
    ELSIF Text.BLen (vname) = 0 AND TyBearing (u) AND NOT isShared THEN
      (* the ANSWER of a view-answering callee carries its arguments:
         `t := Text.Split (s)' stores a view of s, so storing t
         durably is storing s -- the borrow laundered through a call
         result, not seen until 2026-10-18.  Each reference-typed
         argument's root goes the way a bare right-hand side goes. *)
      IF ViewCallOf (st.kids[1]) IS SOME vc THEN
        IF vc.kids[1] IS SOME val THEN
          FOR vj := 0 TO val.nkids - 1 DO
            vroot := EscRootOf (val.kids[vj]) ;
            IF Text.BLen (vroot) > 0 THEN
              IF val.kids[vj] IS SOME varg THEN
                IF TyBearing (Ast.TyStrAt (varg.id)) AND ViewArgOf (vc, vj) THEN
                  StoreRef (st, lhs, vroot, beyond, lhsMode, ctx)
                END
              END
            END
          END
        END
      END
    END ;
    (* a value CONSTRUCTED around a borrow retains it as the borrow
       itself would (2026-10-08): `c.data := Data.F64s (v, miss)'
       stored v and the checker saw a call, not a slice -- Frame's
       AddF64 and six siblings kept their callers' buffers without
       KEPT, and a caller reusing one buffer for several columns read
       the last column everywhere.  Each argument whose FIELD is
       reference-typed goes the way a bare right-hand side goes. *)
    IF Text.BLen (vname) = 0 THEN
      nflat := CtorFields (st.kids[1], flat, om) ;
      IF nflat >= 0 THEN
        IF st.kids[1] IS SOME ce THEN
          IF ce.kids[1] IS SOME al THEN
            FOR k := 0 TO al.nkids - 1 DO
              IF k < nflat THEN
                canonCtx := om ;
                fty := CanonT (flat[k], 0) ;
                canonCtx := '' ;
                vname := EscRootOf (al.kids[k]) ;
                IF Text.BLen (vname) > 0 AND TyBearing (fty) AND
                   NOT Text.StartsWith (fty, 'SHARED PTR ') AND
                   NOT Text.StartsWith (fty, 'OPT SHARED PTR ') THEN
                  StoreRef (st, lhs, vname, beyond, lhsMode, ctx)
                END
              END
            END
          END
        END
      END
    END
  END
END CheckAssign ;

PROCEDURE HasFinally (st: PTR Ast.Node) : BOOL =
VAR j : I64 ;
BEGIN
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME part THEN
      IF part.kind = Ast.NFinally THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END HasFinally ;

PROCEDURE WalkStmt (k: Ast.Kid ; RO ctx: UTF) =
VAR
  j, hk, hm, npre, nacc, narm2, sv, hfrom : I64 ;
  xowner, hnames, wt : UTF ;
  xdecl : Ast.Kid ;
  pre, acc, arm2 : SLICE OF Binding ;
  headOk : BOOL ;
BEGIN
  IF k IS SOME st THEN
    CASE st.kind OF
    | Ast.NAssign :
        IF st.kids[0] IS SOME flh THEN ForVarWrite (flh, ctx, FALSE) END ;
        CheckAssign (st, ctx) ;
        WalkExpr (st.kids[1], ctx)
    | Ast.NCallStmt :
        CheckCallStmt (st, ctx) ;
        IF st.kids[0] IS SOME cn THEN
          NoteCall (cn, st.kids[1], ctx)
        END ;
        WalkArgs (st.kids[1], ctx)
    | Ast.NRaiseStmt :
        IF st.kids[0] IS SOME xn THEN
          CheckExcName (xn, ctx) ;
          RaisedAdd (ExcKey (curMod, ExcSpelled (xn)), 'RAISE') ;
          CheckRaisePayload (xn, st.kids[1], ctx)
        END ;
        WalkArgs (st.kids[1], ctx)
    | Ast.NReturn :
        CheckReturn (st, ctx) ;
        WalkExpr (st.kids[0], ctx)
    | Ast.NDispose :
        CheckDispose (st, ctx)
    | Ast.NThread :
        (* a THREAD root: everything it can reach must be safe to run
           concurrently, which is what the BFS below decides; and the
           argument is checked and, when owned, moved *)
        CheckThread (st, ctx)
    | Ast.NIf :
        CheckCond (st.kids[0], ctx) ;
        pre := OwnSnap () ;
        npre := nown ;
        WalkSeq (st.kids[1], ctx) ;
        acc := OwnSnap () ;
        nacc := nown ;
        OwnRestore (pre, npre) ;
        FOR j := 2 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME arm THEN
            IF arm.kind = Ast.NElsif THEN
              CheckCond (arm.kids[0], ctx) ;
              WalkSeq (arm.kids[1], ctx)
            ELSIF arm.kind = Ast.NElse THEN WalkSeq (arm.kids[0], ctx)
            ELSE WalkSeq (st.kids[j], ctx) END
          END ;
          arm2 := OwnSnap () ;
          narm2 := nown ;
          OwnRestore (pre, npre) ;
          OwnMergeMoves (arm2, narm2)
        END ;
        OwnMergeMoves (acc, nacc)
    | Ast.NWhile :
        CheckCond (st.kids[0], ctx) ;
        sv := finSinceLoop ; finSinceLoop := 0 ; loopsOpen := loopsOpen + 1 ;
        pre := OwnSnap () ;
        npre := nown ;
        WalkSeq (st.kids[1], ctx) ;
        LoopCarry (pre, npre, st.kids[1], ctx) ;
        loopsOpen := loopsOpen - 1 ; finSinceLoop := sv
    | Ast.NFor :
        CheckForBounds (st, ctx) ;
        (* a FOR inside a FOR over the SAME control variable clobbers
           the outer count -- Pascal's rule that a control variable is
           not assigned inside its loop, applied to the one assignment
           the language itself makes (cp-kernel's issue 3, 2026-10-09:
           it compiled, ran, and was wrong) *)
        FOR j := 0 TO nforActive - 1 DO
          IF Text.Eq (forNames[j], st.au) THEN
            ErrN (st, ctx, S4 ('FOR variable ', st.au,
              ' is the control variable of the enclosing FOR at line ',
              Cat (ItoA (forLines[j]), ' (par 2.1)')))
          END
        END ;
        sv := finSinceLoop ; finSinceLoop := 0 ; loopsOpen := loopsOpen + 1 ;
        pre := OwnSnap () ;
        npre := nown ;
        IF nforActive < LEN (forNames) THEN
          forNames[nforActive] := Text.Keep (pool, st.au) ;   (* a copy: module state keeps no view of the tree *)
          forLines[nforActive] := st.line ;
          forPlain[nforActive] := TRUE ;
          nforActive := nforActive + 1 ;
          WalkSeq (st.kids[3], ctx) ;
          nforActive := nforActive - 1
        ELSE
          WalkSeq (st.kids[3], ctx)
        END ;
        LoopCarry (pre, npre, st.kids[3], ctx) ;
        loopsOpen := loopsOpen - 1 ; finSinceLoop := sv
    | Ast.NForIn :
        headOk := CheckForIn (st, ctx) ;
        FOR j := 0 TO nforActive - 1 DO
          IF Text.Eq (forNames[j], st.au) THEN
            ErrN (st, ctx, S4 ('FOR variable ', st.au,
              ' is the control variable of the enclosing FOR at line ',
              Cat (ItoA (forLines[j]), ' (par 2.1)')))
          END
        END ;
        sv := finSinceLoop ; finSinceLoop := 0 ; loopsOpen := loopsOpen + 1 ;
        pre := OwnSnap () ;
        npre := nown ;
        (* the loop's own assignment, x := s[i], first in the body --
           only for a sound head, whose refusal already said it all *)
        (* not over a UTF: its element is decoded, a CHAR, a scalar that
           holds no storage for the walk to follow, and `c := u[0]' is
           the subscript a UTF refuses *)
        IF headOk AND st.nkids > 2 AND NOT IterUtf (st) THEN WalkStmt (st.kids[2], ctx) END ;
        IF nforActive < LEN (forNames) THEN
          forNames[nforActive] := Text.Keep (pool, st.au) ;
          forLines[nforActive] := st.line ;
          forPlain[nforActive] := FALSE ;
          nforActive := nforActive + 1 ;
          WalkSeq (st.kids[1], ctx) ;
          nforActive := nforActive - 1
        ELSE
          WalkSeq (st.kids[1], ctx)
        END ;
        LoopCarry (pre, npre, st.kids[1], ctx) ;
        loopsOpen := loopsOpen - 1 ; finSinceLoop := sv
    | Ast.NLoop :
        (* EXIT leaves the innermost LOOP, WHILE or FOR -- from inside a
           CASE arm too (report par 5); the FINALLY blocks entered since
           that loop are counted, because an EXIT across one would skip
           its cleanup *)
        sv := finSinceLoop ;
        finSinceLoop := 0 ;
        loopsOpen := loopsOpen + 1 ;
        pre := OwnSnap () ;
        npre := nown ;
        WalkSeq (st.kids[0], ctx) ;
        LoopCarry (pre, npre, st.kids[0], ctx) ;
        loopsOpen := loopsOpen - 1 ;
        finSinceLoop := sv
    | Ast.NWait, Ast.NSignal :
        (* WAIT and SIGNAL take the monitor this procedure is bound to:
           WAIT on another releases a lock it does not hold (the fourth
           review's WaitOther: it returned at once on macOS).  The operand
           is typed, as the Pascal twin always did *)
        wt := ExprType (st.kids[0], ctx) ;
        IF st.kids[0] IS SOME wm THEN
          IF NOT (wm.kind = Ast.NDesignator AND wm.nkids = 0 AND Text.BLen (boundMon) > 0 AND
                  Text.Eq (wm.au, boundMon)) THEN
            ErrN (st, ctx, Cat ('WAIT and SIGNAL take the monitor this procedure is bound to -- its first parameter',
              ' -- and no other: on another monitor there is no lock held to release (par 6)'))
          END
        END
    | Ast.NExit :
        IF loopsOpen = 0 THEN
          ErrN (st, ctx, 'EXIT outside a loop: EXIT leaves the innermost LOOP, WHILE or FOR (par 5)')
        ELSIF finSinceLoop > 0 THEN
          ErrN (st, ctx, 'EXIT across a FINALLY would skip its cleanup: leave the protected block first, or move the loop inside it (par 5)')
        END
    | Ast.NBlock :
        (* handlers are collected BEFORE the guarded sequence is
           walked: what a block catches, it catches for everything
           inside it -- and ONLY for that: the raises its sequence adds
           are dropped once it is walked, before the handler bodies are,
           so a call after the block or a re-raise inside a handler is
           still the procedure's (2026-10-21, the compiler review's C6;
           the set was flat over the whole procedure, in both checkers,
           and `BEGIN Boom (0) EXCEPT | Error : ... END ; Boom (5)'
           compiled in a procedure with no RAISES) *)
        IF HasFinally (st) THEN finSinceLoop := finSinceLoop + 1 END ;
        hnames := ' ' ;
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME h THEN
            IF h.kind = Ast.NHandler THEN
              IF h.kids[0] IS SOME hq THEN
                CheckExcName (hq, ctx) ;
                HandlerQualVar (hq, ctx) ;
                hnames := S3 (hnames, ExcKey (curMod, ExcSpelled (hq)), ' ')
              END ;
              (* the further names of `| A, B :', each handled and each
                 an exception; with a binder list, each with the fields
                 of the first *)
              FOR hm := 3 TO h.nkids - 1 DO
                IF h.kids[hm] IS SOME hq3 THEN
                  CheckExcName (hq3, ctx) ;
                  HandlerQualVar (hq3, ctx) ;
                  hnames := S3 (hnames, ExcKey (curMod, ExcSpelled (hq3)), ' ') ;
                  IF h.kids[1] IS SOME hba THEN
                    IF h.kids[0] IS SOME hq0 THEN
                      IF NOT Text.Eq (ExcFieldsText (hq0), ExcFieldsText (hq3)) THEN
                        ErrN (h, ctx, S5 ('one handler arm binds a payload only when every exception it names has the same fields: ',
                          Cat (ExcSpelled (hq0), Cat (' ', ExcFieldsText (hq0))), ' and ',
                          Cat (ExcSpelled (hq3), Cat (' ', ExcFieldsText (hq3))),
                          ' differ -- give each its own arm, or bind nothing (par 5)'))
                      END
                    END
                  END
                END
              END
            END
          END
        END ;
        hfrom := nraised ;
        WalkSeq (st.kids[0], ctx) ;
        IF Text.BLen (hnames) > 1 THEN RaisedDrop (hfrom, hnames) END ;
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME part THEN
            IF part.kind = Ast.NHandler THEN
              (* handler payload binders are names, TYPED since
                 2026-10-08 by the EXCEPTION declaration's fields, in
                 order, qualified in the declaring module (the IS SOME
                 binders' way); a predeclared exception has none, and
                 that binder stays untyped *)
              xowner := '' ;
              xdecl := NONE ;
              IF part.kids[0] IS SOME hq2 THEN
                IF Text.BLen (hq2.bu) > 0 THEN xdecl := ExcDeclOf (hq2.au, hq2.bu, xowner)
                ELSE xdecl := ExcDeclOf ('', hq2.au, xowner) END
              END ;
              IF part.kids[1] IS SOME hbs THEN
                FOR hk := 0 TO hbs.nkids - 1 DO
                  IF hbs.kids[hk] IS SOME hb THEN
                    IF hb.kind = Ast.NIdent THEN
                      BindName (hb.au, ExcFieldType (xdecl, xowner, hk))
                    END
                  END
                END
              END ;
              WalkSeq (part.kids[2], ctx)
            ELSIF part.kind = Ast.NFinally THEN
              (* the cleanup itself is outside its protected block *)
              finSinceLoop := finSinceLoop - 1 ;
              WalkSeq (part.kids[0], ctx)
            END
          END
        END
    | Ast.NCase :
        WalkQuiet (st.kids[0], ctx) ;          (* the selector's RAISES *)
        CheckCaseLabels (st, ctx) ;
        CheckCaseTotal (st, ctx) ;
        CheckCaseElse (st, ctx) ;
        FOR j := 1 TO st.nkids - 1 DO
          IF st.kids[j] IS SOME arm THEN
            IF arm.kind = Ast.NCaseArm THEN
              BindPats (arm, EscRootOf (st.kids[0])) ;
              WalkSeq (arm.kids[1], ctx)
            ELSE WalkSeq (arm.kids[0], ctx) END
          END
        END
    ELSE
      (* the statements that cannot assign need no walk yet; the
         passes that care about them arrive with their own checks *)
    END
  END
END WalkStmt ;

(* a condition is BOOL or it is a mistake *)
(* every owned candidate in scope starts alive *)
PROCEDURE OwnSeed () =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nscope - 1 DO
    IF OwnedCandKind (scope[i].name) > 0 THEN
      OwnSet (scope[i].name, 'alive')
    END
  END
END OwnSeed ;

(* the walk of an expression that ExprType has already checked: what its
   calls raise is recorded, and nothing is said twice -- the walk types
   the same names again, and `unknown name: x' in a condition came out
   twice on the M9 side the day conditions were first walked (found by
   tools/CheckFuzz.m9, 2026-10-11) *)
PROCEDURE WalkQuiet (k: Ast.Kid ; RO ctx: UTF) =
BEGIN
  quietWalk := quietWalk + 1 ;
  WalkExpr (k, ctx) ;
  quietWalk := quietWalk - 1
END WalkQuiet ;

PROCEDURE CheckCond (k: Ast.Kid ; RO ctx: UTF) =
VAR t : UTF ;
BEGIN
  t := ExprType (k, ctx) ;
  (* and WALKED, which is where a call's RAISES is recorded: typed only,
     `IF Io.Exists (p)' and `WHILE F (x)' raised nothing the checker
     counted -- from 0.14.0 at least until 2026-10-11, when the Pascal
     twin (whose ExprType records them) refused M9c.StaleBeside and
     this one did not *)
  WalkQuiet (k, ctx) ;
  IF Text.BLen (t) > 0 AND NOT Text.Eq (t, 'BOOL') THEN
    IF k IS SOME c THEN
      ErrN (c, ctx, Cat ('condition must be BOOL, not ', TyName (t)))
    END
  END
END CheckCond ;

(* THE LOOP VARIABLE IS A VARIABLE: declared, of a type its bounds
   can count in, and of that type inside the loop.  Until 2026-10-02
   FOR bound the name afresh -- with NO type here, as an I64 in the
   oracle -- over whatever had been declared.  So here every loop
   variable was unknown to the checker: `s := i` with s a string and
   `x := x + i` with x an F64 were passed over, the implicit
   conversion par 2.1 refuses let through by the one name every loop
   has; and both checkers accepted a loop variable nobody declared,
   or one declared F64.  Found by `m9c --review`, whose page for
   Stats listed a dozen passed-over sites that had only `i` in
   common.
     bound -- the bounds' type when they are an enumeration's
     enum  -- whether they are *)
(* FOR x IN s (2026-10-11): s a NAME -- a variable, a field, an element
   -- of a slice, an array or a string; x declared, of the element type
   exactly; no SHARED elements (a copy of a handle counts, the loop's
   assignment would not).  x is a copy: assigning it changes nothing in
   s, as assigning an integer FOR's variable changes no bound. *)
(* FOR c IN u over a UTF, by the type the checker recorded for u *)
PROCEDURE IterUtf (st: PTR Ast.Node) : BOOL =
BEGIN
  IF st.kids[0] IS SOME e THEN RETURN Text.Eq (Ast.TyStrAt (e.id), UtfTy) END ;
  RETURN FALSE
END IterUtf ;

PROCEDURE CheckForIn (KEPT st: PTR Ast.Node ; RO ctx: UTF) : BOOL =
VAR t, elem, vt : UTF ;
  at : I64 ;
  ok : BOOL ;
BEGIN
  elem := '' ;
  ok := TRUE ;
  IF st.kids[0] IS SOME e THEN
    IF e.kind # Ast.NDesignator THEN
      ok := FALSE ;
      ErrN (st, ctx, S3 ('FOR ', st.au,
        ' IN takes a name -- a variable, a field, an element: give the value one first (par 10)'))
    END ;
    t := ExprType (st.kids[0], ctx) ;
    WalkQuiet (st.kids[0], ctx) ;
    IF Text.Eq (t, UtfTy) THEN
      (* FOR c IN u decodes: c is a CHAR (docs/utf8-plan.md, U3) *)
      elem := 'CHAR'
    ELSIF Text.StartsWith (t, 'SLICE OF ') THEN
      elem := SLICE (t, 9, Text.BLen (t) - 9)
    ELSIF Text.StartsWith (t, 'ARRAY ') THEN
      at := Text.Find (t, ' OF ') ;
      IF at > 0 THEN elem := SLICE (t, at + 4, Text.BLen (t) - at - 4) END
    ELSIF Text.BLen (t) > 0 THEN
      ok := FALSE ;
      ErrN (st, ctx, S5 ('FOR ', st.au, ' IN goes over a slice, an array or a string, not ',
        TyName (t), ' (par 10)'))
    END ;
    IF Text.StartsWith (elem, 'SHARED ') OR Text.StartsWith (elem, 'OPT SHARED ') THEN
      ok := FALSE ;
      ErrN (st, ctx, S3 ('FOR ', st.au,
        ' IN over SHARED handles: index the slice -- a copy of a handle is counted, and the loop would copy it uncounted'))
    END
  END ;
  IF ScopeFind (st.au) < 0 THEN
    ok := FALSE ;
    ErrN (st, ctx, S3 ('FOR variable ', st.au, ' is not declared')) ;
    BindName (st.au, NONE)
  ELSE
    vt := CanonT (ScopeType (st.au), 0) ;
    IF Text.BLen (vt) > 0 AND Text.BLen (elem) > 0 AND NOT Text.Eq (vt, elem) THEN
      ok := FALSE ;
      ErrN (st, ctx, S5 ('FOR variable ', st.au, ' is ', TyName (vt),
        Cat (', and the elements it goes over are ', TyName (elem))))
    END
  END ;
  RETURN ok
END CheckForIn ;

PROCEDURE CheckForVar (KEPT st: PTR Ast.Node ; RO ctx: UTF ; RO bound: UTF ;
                       enum: BOOL) =
VAR vt : UTF ;
BEGIN
  IF ScopeFind (st.au) < 0 THEN
    ErrN (st, ctx, S3 ('FOR variable ', st.au, ' is not declared')) ;
    (* bound without a type, so that its uses say nothing more *)
    BindName (st.au, NONE)
  ELSE
    vt := CanonT (ScopeType (st.au), 0) ;
    IF Text.BLen (vt) > 0 THEN
      IF enum THEN
        IF Text.BLen (bound) > 0 AND NOT Text.Eq (vt, bound) THEN
          ErrN (st, ctx, S5 ('FOR variable ', st.au, ' is ', TyName (vt),
            Cat (', and its bounds are ', TyName (bound))))
        END
      ELSIF NOT IsIntStr (vt) THEN
        ErrN (st, ctx, S5 ('FOR variable ', st.au, ' is ', TyName (vt),
          ': a loop over integers counts in an integer variable'))
      END
    END
  END
END CheckForVar ;

(* a FOR step that is a constant: what Ast.ScalarConst folds, or a
   name -- this module's CONST, or an imported Mod.N *)
PROCEDURE StepConst (s: PTR Ast.Node) : BOOL =
VAR
  v : I64 ;
  ch, found : BOOL ;
  t : UTF ;
BEGIN
  IF Ast.ScalarConst (SOME (s), v, ch) THEN RETURN NOT ch END ;
  IF s.kind = Ast.NDesignator THEN
    IF s.nkids = 0 THEN RETURN IsConstHere (s.au) END ;
    IF s.nkids = 1 THEN
      IF s.kids[0] IS SOME sf THEN
        IF sf.kind = Ast.NSelField THEN
          t := ModConstType (s.au, sf.au, found) ;
          RETURN found
        END
      END
    END
  END ;
  RETURN FALSE
END StepConst ;

(* each integer bound held to the loop variable's type, as an
   assignment's right side is: the variable takes both values, and the
   generator compares in its type, so a bound it cannot hold -- an I64
   for an I32, 300 for an I8 -- was truncated in C (2026-10-21, the
   compiler review's G5) *)
PROCEDURE CheckForFit (KEPT st: PTR Ast.Node ; RO ctx: UTF ; RO lo: UTF ;
                       RO hi: UTF) =
VAR
  vt, bt : UTF ;
  k : I64 ;
  lv : I64 ;
BEGIN
  IF ScopeFind (st.au) < 0 THEN RETURN END ;
  vt := CanonT (ScopeType (st.au), 0) ;
  IF Text.BLen (vt) = 0 OR NOT IsIntStr (vt) THEN RETURN END ;
  FOR k := 0 TO 1 DO
    IF k = 0 THEN bt := lo ELSE bt := hi END ;
    IF st.kids[k] IS SOME b THEN
      IF Text.BLen (bt) > 0 AND NOT Compat (vt, bt) THEN
        ErrN (b, ctx, S5 ('cannot bound FOR variable ', st.au, ' of ',
          TyName (vt), Cat (' by ', Cat (TyName (bt),
          ' (no implicit conversions, par 2.1)'))))
      ELSIF LitOut (b, vt, lv) THEN
        ErrN (b, ctx, S4 ('integer literal ', ItoA (lv), ' does not fit ',
          TyName (vt)))
      END
    END
  END
END CheckForFit ;

PROCEDURE CheckForBounds (KEPT st: PTR Ast.Node ; RO ctx: UTF) =
  (* integer bounds, or two bounds of ONE enumeration: FOR c :=
     Colour.Red TO Colour.Blue walks the members in declaration order.
     A step is only for the integer form (docs/enum-plan.md, part 2). *)
VAR
  t, u, lo, hi : UTF ;
  sv : I64 ;
  sch : BOOL ;
BEGIN
  t := ExprType (st.kids[0], ctx) ;
  u := ExprType (st.kids[1], ctx) ;
  lo := t ;
  hi := u ;
  WalkQuiet (st.kids[0], ctx) ;             (* the bounds' RAISES *)
  WalkQuiet (st.kids[1], ctx) ;
  IF IsTagged (t) OR IsTagged (u) THEN
    IF NOT Text.Eq (t, u) THEN
      ErrN (st, ctx, S4 ('FOR over an enumeration needs both bounds of one type, not ',
        TyName (t), ' and ', TyName (u)))
    END ;
    IF st.kids[2] IS SOME estep THEN
      ErrN (st, ctx, 'FOR over an enumeration takes no BY step')
    END ;
    CheckForVar (st, ctx, t, TRUE) ;
    RETURN
  END ;
  IF NOT IsIntish (t) THEN
    ErrN (st, ctx, Cat ('FOR bounds must be integers, not ', TyName (t)))
  END ;
  IF NOT IsIntish (u) THEN
    ErrN (st, ctx, Cat ('FOR bounds must be integers, not ', TyName (u)))
  END ;
  IF st.kids[2] IS SOME step THEN
    t := ExprType (st.kids[2], ctx) ;
    IF NOT IsIntish (t) THEN
      ErrN (st, ctx, Cat ('FOR step must be an integer, not ', TyName (t)))
    ELSIF NOT StepConst (step) THEN
      (* par 10: FOR ... BY ConstExpr.  The step decides which way the
         loop runs, so it is known when the loop is written (refused by
         the generator alone until the typed tree's stage 3) *)
      ErrN (st, ctx,
        'a FOR step is a constant: BY takes a literal, a CONST or an expression of them (par 10)')
    ELSIF Ast.ScalarConst (st.kids[2], sv, sch) THEN
      IF sv = 0 THEN
        ErrN (st, ctx, 'a FOR step of 0 never reaches its bound')
      END
    END
  END ;
  CheckForVar (st, ctx, '', FALSE) ;
  CheckForFit (st, ctx, lo, hi)
END CheckForBounds ;


(* a scalar CASE label must be comparable with the selector.  The
   variant labels of a CASE RECORD are names, not values, and are
   judged by CheckCaseTotal instead. *)
(* a CASE over a CHAR or an integer names some of its values; one no
   label names must have somewhere to go (report par 8: the generator
   refused it, "unmatched-label semantics undecided", until 2026-10-09)
   -- an enumeration or CASE RECORD is held TOTAL instead *)
PROCEDURE CheckCaseElse (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  t : UTF ;
  j : I64 ;
BEGIN
  (* the selector was checked, and said so, by CheckCaseLabels: typed
     again here quietly, or an unknown selector is reported twice (the
     Pascal twin types it once; CheckFuzz, 2026-10-11) *)
  quietWalk := quietWalk + 1 ;
  t := ExprType (st.kids[0], ctx) ;
  quietWalk := quietWalk - 1 ;
  IF NOT (Text.Eq (t, 'CHAR') OR IsIntStr (t) OR Text.Eq (t, 'BYTE')) THEN RETURN END ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind # Ast.NCaseArm THEN RETURN END
    END
  END ;
  ErrN (st, ctx, S3 ('a CASE over ', TyName (t),
    ' needs an ELSE: a value no label names would have nowhere to go (par 8)'))
END CheckCaseElse ;

PROCEDURE CheckCaseLabels (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  selTy, t, lblTxt : UTF ;
  j, k, m, nseen : I64 ;
  seen : ARRAY 256 OF UTF ;
  dup : BOOL ;
BEGIN
  nseen := 0 ;
  selTy := ExprType (st.kids[0], ctx) ;
  FOR j := 1 TO st.nkids - 1 DO
    IF st.kids[j] IS SOME arm THEN
      IF arm.kind = Ast.NCaseArm THEN
        IF arm.kids[0] IS SOME ll THEN
          FOR k := 0 TO ll.nkids - 1 DO
            IF ll.kids[k] IS SOME lbl THEN
              IF lbl.kind = Ast.NLabelRange THEN
                IF NOT IsVariantLabel (lbl) THEN
                  t := ExprType (lbl.kids[0], ctx) ;
                  Agree (StLabel, selTy, t, lbl.line) ;
                  IF NOT (Compat (selTy, t) OR Compat (t, selTy)) THEN
                    ErrN (lbl, ctx, S4 ('CASE label is ', TyName (t),
                      ' but the selector is ', TyName (selTy)))
                  END ;
                  IF lbl.kids[1] IS SOME hi THEN
                    t := ExprType (lbl.kids[1], ctx) ;
                    Agree (StLabel, selTy, t, hi.line) ;
                    IF NOT (Compat (selTy, t) OR Compat (t, selTy)) THEN
                      ErrN (hi, ctx, S4 ('CASE label is ', TyName (t),
                        ' but the selector is ', TyName (selTy)))
                    END
                  ELSE
                    (* a repeated label is decided at compile time, and
                       until now only the C compiler decided it -- which
                       reports against generated code the author never
                       wrote.  Single literal labels only: a range needs
                       interval overlap and a CONST designator needs the
                       value, and guessing at either would be worse than
                       the gap. *)
                    lblTxt := Print.ExprTextUtf (lbl.kids[0]) ;
                    IF NOT Text.Eq (lblTxt, '') THEN
                      dup := FALSE ;
                      FOR m := 0 TO nseen - 1 DO
                        IF Text.Eq (seen[m], lblTxt) THEN dup := TRUE END
                      END ;
                      IF dup THEN
                        ErrN (lbl, ctx, S3 ('CASE label ', lblTxt,
                          ' appears twice'))
                      ELSIF nseen < 256 THEN
                        seen[nseen] := lblTxt ;
                        nseen := nseen + 1
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END CheckCaseLabels ;

(* a bare name that names a variant is a variant label, not a value *)
PROCEDURE IsVariantLabel (lbl: PTR Ast.Node) : BOOL =
VAR
  owner : UTF ;
  fields : Ast.Kid ;
  m, j, v : I64 ;
BEGIN
  IF lbl.kids[1] IS SOME hi THEN RETURN FALSE END ;
  IF lbl.kids[0] IS SOME lo THEN
    IF lo.kind # Ast.NDesignator THEN RETURN FALSE END ;
    IF lo.nkids # 0 THEN RETURN FALSE END ;
    FOR m := 0 TO nmods - 1 DO
      FOR j := 0 TO mods[m].nvts - 1 DO
        FOR v := 0 TO LEN (mods[m].vts[j].variants) - 1 DO
          IF Text.Eq (mods[m].vts[j].variants[v], lo.au) THEN
            RETURN TRUE
          END
        END
      END
    END
  END ;
  RETURN FALSE
END IsVariantLabel ;

PROCEDURE CheckReturn (st: PTR Ast.Node ; RO ctx: UTF) =
VAR
  t, what : UTF ;
  said : BOOL ;
BEGIN
  said := FALSE ;
  IF st.kids[0] IS SOME v THEN
    t := ExprType (st.kids[0], ctx) ;
    IF Text.Eq (curRetTy, '<void>') THEN
      ErrN (st, ctx, 'RETURN with a value in a proper procedure')
    ELSE
      IF Text.Eq (t, '<void>') THEN
        ErrN (v, ctx, 'RETURN of a call that returns no value')
      ELSE
        t := AdaptLit (st.kids[0], curRetTy, t) ;
        Agree (StReturn, curRetTy, t, v.line) ;
        IF NOT Compat (curRetTy, t) THEN
          ErrN (v, ctx, S4 ('cannot RETURN ', TyName (t),
            ' from a function of type ', TyName (curRetTy)))
        END
      END
    END ;
    (* par 4.3: a pool-interior pointer may not escape a pool that
       dies with this frame *)
    IF v.kind = Ast.NDesignator THEN
      IF v.nkids = 0 THEN
        IF ScopeType (v.au) IS SOME dcl THEN
          IF dcl.kind = Ast.NPtrType THEN
            IF dcl.kids[1] IS SOME pn THEN
              IF Text.Eq (ScopeMode (pn.au), ModeLocal) THEN
                ErrN (st, ctx, S5 ('pool-interior pointer escapes its pool: ',
                  v.au, ' lives in ', pn.au,
                  ', which dies with this frame (par 4.3)')) ;
                said := TRUE
              END
            END
          END
        END
      END
    END ;
    (* the same by SHAPE rather than by declaration: an allocation
       made in a local pool and held in a pool-less name, or a view
       of one (FrameWhat's pool kinds) -- except a string, which the
       generator re-homes out of a local pool at exit (par 2.3) *)
    IF NOT said AND NOT StrTyIs (t) THEN
      what := FrameWhat (st.kids[0], t) ;
      IF Text.BLen (KindPool (what)) > 0 THEN
        ErrN (st, ctx, Cat (what, ' escapes its pool, which dies with this frame (par 4.3)'))
      END
    END ;
    (* par 4.1 direction: what is RETURNed reaches the caller *)
    t := EscRootOf (st.kids[0]) ;
    IF Text.BLen (t) > 0 THEN
      IF IsFrameMode (ScopeMode (t)) THEN EscTarget (t, '<return>') END
    END
    (* par 2.3: a string RETURN needs no refusal -- the generator
       re-homes it into the caller's arena, copying a frame-local
       designator's bytes across (m9_strdup). *)
  ELSE
    IF NOT Text.Eq (curRetTy, '<void>') THEN
      ErrN (st, ctx, 'RETURN without a value in a function')
    END
  END
END CheckReturn ;

(* ---- par 3 rule 4: a function answers on every path ----

   Can control pass this statement?  A function whose body can be
   passed reaches its END with nothing to answer, and the emitted C
   would hand back the zero its result was initialised to -- the
   uninitialised-Result class the language was founded to close,
   which until 2026-10-01 was closed for CASE alone: the tutorial's
   own Sign, with its ELSE removed, compiled and answered 0.

   STRUCTURAL and conservative, on purpose, so that the rule is one a
   reader can apply by eye: a WHILE or a FOR can always be passed; a
   LOOP only through an EXIT of its own; an IF when a branch can be
   or there is no ELSE; a CASE when an arm can be (a CASE without
   ELSE is total, CheckCaseTotal holds that); a block when its
   statements or one of its handlers can be.  A call is never an
   ending, whatever the callee does: `Fail (c, msg)` that always
   raises reads, here and to a reviewer, as a statement that returns.
   Measured before it was built: 1 function of 1,167 in the
   repository needed a RAISE of its own.                             *)

PROCEDURE EndsSeq (k: Ast.Kid) : BOOL ;

PROCEDURE HasExit (k: Ast.Kid) : BOOL =
  (* an EXIT that belongs to the LOOP whose body this is: a nested
     LOOP, WHILE or FOR owns its own -- EXIT leaves the innermost of
     them (until 2026-10-09 this counted an EXIT inside a nested WHILE
     or FOR as the LOOP's, which the generator never did) *)
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NExit THEN RETURN TRUE END ;
    IF n.kind = Ast.NLoop OR n.kind = Ast.NWhile OR n.kind = Ast.NFor OR
       n.kind = Ast.NForIn THEN RETURN FALSE END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF HasExit (n.kids[i]) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END HasExit ;

PROCEDURE EndsStmt (n: PTR Ast.Node) : BOOL =
VAR
  i : I64 ;
  hasElse : BOOL ;
BEGIN
  CASE n.kind OF
  | Ast.NReturn, Ast.NRaiseStmt :
      RETURN TRUE
  | Ast.NIf :
      IF NOT EndsSeq (n.kids[1]) THEN RETURN FALSE END ;
      hasElse := FALSE ;
      FOR i := 2 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME e THEN
          IF e.kind = Ast.NElsif THEN
            IF NOT EndsSeq (e.kids[1]) THEN RETURN FALSE END
          ELSIF e.kind = Ast.NElse THEN
            hasElse := TRUE ;
            IF NOT EndsSeq (e.kids[0]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN hasElse
  | Ast.NCase :
      FOR i := 1 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME arm THEN
          IF arm.kind = Ast.NCaseArm THEN
            IF NOT EndsSeq (arm.kids[1]) THEN RETURN FALSE END
          ELSIF arm.kind = Ast.NElse THEN
            IF NOT EndsSeq (arm.kids[0]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN n.nkids > 1
  | Ast.NLoop :
      RETURN NOT HasExit (n.kids[0])
  | Ast.NBlock :
      IF NOT EndsSeq (n.kids[0]) THEN RETURN FALSE END ;
      FOR i := 1 TO n.nkids - 1 DO
        IF n.kids[i] IS SOME h THEN
          IF h.kind = Ast.NHandler THEN
            IF NOT EndsSeq (h.kids[2]) THEN RETURN FALSE END
          END
        END
      END ;
      RETURN TRUE
  ELSE
    RETURN FALSE
  END
END EndsStmt ;

PROCEDURE EndsSeq (k: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    FOR i := 0 TO n.nkids - 1 DO
      IF n.kids[i] IS SOME st THEN
        IF EndsStmt (st) THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END EndsSeq ;

(* ---- THE ONE REGION JUDGEMENT, in shadow (docs/region-plan.md, step
   3; 2026-10-21, Alex: in this checker only, flow-sensitive).  Run only
   when SetRegions (TRUE) was called -- m9c does so under M9_REGIONS=1 --
   after the procedure's ordinary walk; it refuses nothing, and what it
   finds goes to its own list (RegionAt), so that it can be measured
   against the seven analyses it is to replace before it replaces any.

   A value is given a SET of regions where its storage may live, kept
   as the bits of an I64 (no Bits import for a debugging pass): Static,
   Module, Owned, Caller, a local Pool, Frame, then a READ-ONLY flag, and
   one bit per parameter -- Arg (j), storage reachable from parameter j.
   Per tracked name -- a parameter, a local, a binder -- two sets: where
   its value lives (val) and what was stored into its components (cont).
   Flow-sensitive: an assignment replaces val; IF and CASE arms are
   joined by union; a loop's body is walked to its fixpoint; a handler
   starts from what its guarded sequence could have reached.  A store is
   judged by lifetime: what is stored must outlive where it is stored. *)
CONST
  (* where storage lives *)
  RgStatic = 0 ; RgModule = 1 ; RgOwned = 2 ; RgCaller = 3 ; RgPool = 4 ;
  RgFrame = 5 ;
  (* the read-only flag: carried by a slice's, a grid's or a string's
     value only *)
  RgRo = 6 ;
  (* an object MADE IN THIS ACTIVATION and so far reachable only from its
     names, with the region it was allocated in: a store into its
     components is judged when the object escapes, against everything
     stored in it, not when it is filled *)
  RgFrModule = 7 ; RgFrCaller = 8 ; RgFrPool = 9 ; RgFrFrame = 10 ;
  (* storage on the C STACK: an ARRAY held in this frame, viewed through
     SLICE or GRID.  It dies with the frame as the arena does, and unlike
     the arena it is never adopted, so it may not leave through a VAR
     parameter or a KEPT one either (the second review's S1) *)
  RgStack = 11 ;
  RgArg0 = 12 ; RgArgMax = 48 ;

VAR
  rgOn : BOOL ;
  strUtf : BOOL ;               (* SetStrUtf: STR is the UTF type *)
  rgNotes : SLICE OF UTF ;
  nrg : I64 ;
  rgNames : SLICE OF UTF ;
  rgArg : SLICE OF I64 ;          (* the parameter's index, or -1 *)
  rgRef : SLICE OF BOOL ;         (* its value is a reference: a pointer,
                                     a slice, a grid, a binder *)
  rgN, rgCap : I64 ;
  rgOverflow : BOOL ;
  rgKept : SLICE OF BOOL ;        (* parameter j declared KEPT *)
  rgArgNames : SLICE OF UTF ;
  rgNArg : I64 ;
  rgCtx : UTF ;
  rgAlias : SLICE OF I64 ;        (* per name: the name whose component it was
                                     given (`row := rows[0]'), or -1 *)
  rgInCaller : BOOL ;             (* a function answering a pointer-bearing
                                     type: its frame forms build in the
                                     caller's arena (decision 18) *)
  rgPowT : SLICE OF I64 ;
  rgDeepCall : BOOL ;             (* RgDeep asks a call for its contents too *)
  rgSaid : SLICE OF UTF ;         (* one finding per line and kind *)
  nrgSaid : I64 ;
  rgMemoK, rgMemoV : SLICE OF UTF ; (* callee and module-variable marks *)
  nrgMemo : I64 ;

PROCEDURE SetStrUtf (on: BOOL) =
BEGIN
  strUtf := on
END SetStrUtf ;

(* the type a string literal has, and a concatenation of literals, and
   NAME's answer: STR's -- which the rehearsed switch makes the UTF type *)
PROCEDURE StrLitTy () : UTF =
BEGIN
  IF strUtf THEN RETURN UtfTy END ;
  RETURN 'SLICE OF CHAR'
END StrLitTy ;

(* is t the string type the generator re-homes out of a local pool at
   exit (par 2.3) -- STR's, which the rehearsed switch makes UTF *)
PROCEDURE StrTyIs (RO t: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (t, 'SLICE OF CHAR') OR (strUtf AND Text.Eq (t, UtfTy))
END StrTyIs ;

(* under the rehearsed switch a procedure X of module m whose twin
   XUtf m declares IS XUtf: every lookup answers the twin, so the
   analyses that read a callee's body read the body that runs *)
PROCEDURE TwinIx (m, pi: I64) : I64 =
VAR nm : UTF ; n, ti : I64 ;
BEGIN
  IF NOT strUtf OR pi < 0 THEN RETURN pi END ;
  nm := mods[m].procs[pi].name ;
  n := Text.BLen (nm) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (nm, n - 3, 3), 'Utf') THEN RETURN pi END
  END ;
  ti := FindProcIn (m, Cat (nm, 'Utf')) ;
  IF ti >= 0 THEN RETURN ti END ;
  RETURN pi
END TwinIx ;

(* under SetStrUtf: X is collapsed into XUtf when this module declares
   both -- X's body is not checked, a call of X is a call of XUtf *)
PROCEDURE Collapsed (RO nm: UTF) : BOOL =
VAR found : BOOL ; pr : ProcInfo ; n : I64 ;
BEGIN
  IF NOT strUtf THEN RETURN FALSE END ;
  n := Text.BLen (nm) ;
  IF n > 3 THEN
    IF Text.Eq (SLICE (nm, n - 3, 3), 'Utf') THEN RETURN FALSE END
  END ;
  pr := LookupProc (Cat (nm, 'Utf'), found) ;
  RETURN found AND Text.Eq (pr.modName, curMod)
END Collapsed ;

PROCEDURE SetRegions (on: BOOL) =
BEGIN
  rgOn := on ;
  (* PushErr grows a list by doubling it: it needs a first capacity *)
  IF on AND LEN (rgNotes) = 0 THEN rgNotes := NEW (pool, UTF, 64) END
END SetRegions ;

PROCEDURE RegionCount () : I64 =
BEGIN
  RETURN nrg
END RegionCount ;

PROCEDURE RegionAt (i: I64) : UTF RAISES IndexError =
BEGIN
  IF i < 0 OR i >= nrg THEN RAISE IndexError (i, nrg) END ;
  RETURN rgNotes[i]
END RegionAt ;

(* the powers of two, once: every set operation is DIV and MOD on them
   (the walk runs on every procedure, so it must cost little) *)
PROCEDURE RgPow (b: I64) : I64 =
VAR i : I64 ;
BEGIN
  IF LEN (rgPowT) = 0 THEN
    rgPowT := NEW (pool, I64, 62) ;
    rgPowT[0] := 1 ;
    FOR i := 1 TO 61 DO rgPowT[i] := rgPowT[i - 1] * 2 END
  END ;
  RETURN rgPowT[b]
END RgPow ;

PROCEDURE RgHas (s, b: I64) : BOOL =
BEGIN
  RETURN (s DIV RgPow (b)) MOD 2 = 1
END RgHas ;

PROCEDURE RgAdd (s, b: I64) : I64 =
BEGIN
  IF RgHas (s, b) THEN RETURN s END ;
  RETURN s + RgPow (b)
END RgAdd ;

PROCEDURE RgDel (s, b: I64) : I64 =
BEGIN
  IF RgHas (s, b) THEN RETURN s - RgPow (b) END ;
  RETURN s
END RgDel ;

PROCEDURE RgOr (a, b: I64) : I64 =
VAR r, i, rest : I64 ;
BEGIN
  IF b = 0 OR a = b THEN RETURN a END ;
  IF a = 0 THEN RETURN b END ;
  r := a ;
  rest := b ;
  i := 0 ;
  WHILE rest > 0 DO
    IF rest MOD 2 = 1 THEN r := RgAdd (r, i) END ;
    rest := rest DIV 2 ;
    i := i + 1
  END ;
  RETURN r
END RgOr ;

(* a fresh object's storage region, for judging where the object itself
   is stored: the fresh bits become the regions they were allocated in *)
PROCEDURE RgStorage (s: I64) : I64 =
VAR r : I64 ;
BEGIN
  r := s ;
  IF RgHas (r, RgFrModule) THEN r := RgAdd (RgDel (r, RgFrModule), RgModule) END ;
  IF RgHas (r, RgFrCaller) THEN r := RgAdd (RgDel (r, RgFrCaller), RgCaller) END ;
  IF RgHas (r, RgFrPool) THEN r := RgAdd (RgDel (r, RgFrPool), RgPool) END ;
  IF RgHas (r, RgFrFrame) THEN r := RgAdd (RgDel (r, RgFrFrame), RgFrame) END ;
  RETURN r
END RgStorage ;

(* where a store into an object of value s may be read from: the fresh
   ones are reachable only from here *)
PROCEDURE RgReach (s: I64) : I64 =
BEGIN
  RETURN RgDel (RgDel (RgDel (RgDel (s, RgFrModule), RgFrCaller), RgFrPool), RgFrFrame)
END RgReach ;

PROCEDURE RgIsFresh (s: I64) : BOOL =
BEGIN
  RETURN RgHas (s, RgFrModule) OR RgHas (s, RgFrCaller) OR
         RgHas (s, RgFrPool) OR RgHas (s, RgFrFrame)
END RgIsFresh ;

(* has an error already been given at this line? *)
PROCEDURE RgLineRefused (line: I64) : BOOL =
VAR
  i : I64 ;
  pre : UTF ;
BEGIN
  pre := Cat (ItoA (line), ':') ;
  FOR i := 0 TO nerrs - 1 DO
    IF Text.StartsWith (errs[i], pre) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END RgLineRefused ;

PROCEDURE RgNote (n: PTR Ast.Node ; RO kind, msg: UTF) =
VAR
  key : UTF ;
  i : I64 ;
  ns : SLICE OF UTF ;
BEGIN
  key := Text.Keep (pool, Cat (Cat (ItoA (n.line), ' '), kind)) ;
  FOR i := 0 TO nrgSaid - 1 DO
    IF Text.Eq (rgSaid[i], key) THEN RETURN END
  END ;
  IF nrgSaid = LEN (rgSaid) THEN
    ns := NEW (pool, UTF, 2 * nrgSaid + 16) ;
    FOR i := 0 TO nrgSaid - 1 DO ns[i] := rgSaid[i] END ;
    rgSaid := ns
  END ;
  rgSaid[nrgSaid] := key ;
  nrgSaid := nrgSaid + 1 ;
  (* the families switched over (plan, step 5) are refusals -- where no
     older analysis already refused the line, so nothing is said twice;
     the others are listed, under M9_REGIONS=1 *)
  IF Text.Eq (kind, 'frame') AND NOT RgLineRefused (n.line) THEN
    ErrN (n, rgCtx, Cat (msg, ' -- it dies with this frame, and what is stored there outlives it (par 4, regions)'))
  ELSIF Text.Eq (kind, 'readonly') AND NOT RgLineRefused (n.line) THEN
    ErrN (n, rgCtx, Cat (msg, ' -- a literal, a CONST or what an RO parameter lends, which nothing may write (par 2.4, regions)'))
  ELSIF Text.Eq (kind, 'retention') AND NOT RgLineRefused (n.line) THEN
    ErrN (n, rgCtx, Cat (msg, ' -- declare the parameter KEPT, or copy what is kept (par 4.1, regions)'))
  ELSIF Text.Eq (kind, 'caller') AND NOT RgLineRefused (n.line) THEN
    ErrN (n, rgCtx, Cat (msg, ' -- the caller may free it before this is read; declare the pool parameter KEPT, or allocate in a module pool (par 4.3, regions)'))
  ELSIF Text.Eq (kind, 'internal') THEN
    ErrN (n, rgCtx, Cat (msg, ' -- the region judgement could not judge this procedure, so it is refused rather than passed (par 4, regions)'))
  ELSIF Text.Eq (kind, 'return') AND NOT RgLineRefused (n.line) THEN
    ErrN (n, rgCtx, Cat (msg, ' -- it dies with this frame when the caller receives it (par 4.3, regions)'))
  END ;
  IF rgOn THEN
    Diag (rgNotes, nrg, n.line, n.col, rgCtx, Cat (Cat ('regions: ', kind), Cat (': ', msg)))
  END
END RgNote ;

PROCEDURE RgFind (RO nm: UTF) : I64 =
BEGIN
  (* RgEnter adds a name only when it is not there: one entry each *)
  RETURN NxFind (rgIx, nm)
END RgFind ;

(* is a name's value a reference -- does a store through it reach the
   storage it points to, rather than the name's own? *)
(* a type whose value leads to storage, for the region walk: what
   TyBearing says, and a GRID -- which the older analyses (and the twin)
   do not count, so a grid over a literal lost its mark (review2 N23) *)
PROCEDURE RgBearing (RO t: UTF) : BOOL =
BEGIN
  RETURN TyBearing (t) OR Text.StartsWith (t, 'GRID ')
END RgBearing ;

PROCEDURE RgRefTy (t: Ast.Kid) : BOOL =
BEGIN
  IF ResolveType (t) IS SOME r THEN
    RETURN r.kind = Ast.NPtrType OR r.kind = Ast.NSliceType OR
           r.kind = Ast.NGridType OR r.kind = Ast.NSharedType OR
           r.kind = Ast.NOptType
  END ;
  RETURN FALSE
END RgRefTy ;

(* whether the selectors kids[from .. upto] of a designator each reach a
   RECORD or an ARRAY held by value, as the typed tree recorded them: a
   store past them lands in the storage of the tracked field itself, not
   in what it leads to.  `spec.scale.cmap := o.cmap' with spec a local
   Map.Spec and scale a Map.Scale was judged as a store through scale
   into whatever spec's last assignment from a call reached, and refused
   (cp-kernel's DapPreview.MapSvg, 2026-10-25) while `spec.title :=' of
   the same string passed *)
PROCEDURE RgInline (d: PTR Ast.Node ; from, upto: I64) : BOOL =
VAR k : I64 ;
BEGIN
  IF from > upto THEN RETURN FALSE END ;
  FOR k := from TO upto DO
    IF d.kids[k] IS SOME sk THEN
      IF Ast.TypeAt (sk.id) IS SOME tn THEN
        IF ResolveType (SOME (tn)) IS SOME r THEN
          IF r.kind # Ast.NRecordType AND r.kind # Ast.NArrayType THEN RETURN FALSE END
        ELSE
          RETURN FALSE
        END
      ELSE
        RETURN FALSE
      END
    ELSE
      RETURN FALSE
    END
  END ;
  RETURN TRUE
END RgInline ;

(* whether every selector of d from kids[from] on is a subscript: what
   was stored into a tracked field is not told apart by the fields under
   it, so a deeper FIELD (`mods[m].vts[k].variants[i]' after an RO
   string went into `vts[k].typeName') is not judged by them *)
PROCEDURE RgAllIndex (d: PTR Ast.Node ; from: I64) : BOOL =
VAR k : I64 ;
BEGIN
  FOR k := from TO d.nkids - 1 DO
    IF d.kids[k] IS SOME sk THEN
      IF sk.kind # Ast.NSelIndex THEN RETURN FALSE END
    ELSE
      RETURN FALSE
    END
  END ;
  RETURN TRUE
END RgAllIndex ;

(* RgRefTy of a callee's parameter type, resolved in the callee's module *)
PROCEDURE RgRefTyIn (pr: ProcInfo ; t: Ast.Kid) : BOOL =
VAR
  was : UTF ;
  r : BOOL ;
BEGIN
  was := canonCtx ;
  canonCtx := Text.Keep (pool, pr.modName) ;
  r := RgRefTy (t) ;
  canonCtx := was ;
  RETURN r
END RgRefTyIn ;

(* a name entered: a parameter or local in order, a binder or FOR IN
   variable the first time it is bound *)
PROCEDURE RgEnter (RO nm: UTF ; ref: BOOL) : I64 =
VAR i, dot : I64 ;
BEGIN
  i := RgFind (nm) ;
  IF i >= 0 THEN RETURN i END ;
  IF rgN >= rgCap THEN rgOverflow := TRUE ; RETURN -1 END ;
  rgNames[rgN] := Text.Keep (pool, nm) ;
  NxAdd (rgIx, rgNames[rgN], rgN) ;
  (* x.f: x has a tracked field *)
  dot := Text.FindChar (nm, '.') ;
  IF dot > 0 THEN NxAdd (rgFldIx, Text.Keep (pool, SLICE (nm, 0, dot)), 1) END ;
  rgArg[rgN] := -1 ;
  rgRef[rgN] := ref ;
  rgN := rgN + 1 ;
  RETURN rgN - 1
END RgEnter ;

(* the first field of a root, tracked as a name of its own
   (`t.nameOfs'), so that a field given a literal does not make its
   neighbours read-only.  For a VALUE record copies are values, no alias
   can reach the field, and an assignment replaces its set; through a
   REFERENCE another name may reach it, and an assignment only adds.
   -1 when the designator is not of that shape *)
(* a name, tracked: a module variable is entered the first time the
   procedure reaches it, from what the unit gives its paths anywhere *)
PROCEDURE RgTrack (RO nm: UTF ; st: SLICE OF I64) : I64 =
VAR
  x : I64 ;
  marks : UTF ;
BEGIN
  x := RgFind (nm) ;
  IF x >= 0 OR NOT Text.Eq (ScopeMode (nm), ModeModule) THEN RETURN x END ;
  x := RgEnter (nm, RgRefTy (ScopeType (nm))) ;
  IF x >= 0 THEN
    marks := RgModMarks (nm) ;
    st[x] := RgPow (RgModule) ;
    IF Text.Contains (marks, ',*,') THEN st[x] := RgAdd (st[x], RgRo) END ;
    st[rgCap + x] := 0 ;
    IF Text.Contains (marks, ',[],') THEN st[rgCap + x] := RgPow (RgRo) END
  END ;
  RETURN x
END RgTrack ;

(* field f of tracked name x, as a name of its own; made on demand *)
PROCEDURE RgFieldKey (x: I64 ; RO fld: UTF ; st: SLICE OF I64 ; make: BOOL) : I64 ;

(* the same, made by a store into the field itself: what it held before
   matters to nobody, so it starts empty -- `j.p := New (pool, n, n)'
   with j in a local pool is the caller's pool, not j's *)
PROCEDURE RgFieldNew (x: I64 ; RO fld: UTF ; st: SLICE OF I64) : I64 =
VAR f : I64 ;
BEGIN
  f := RgFieldKey (x, fld, st, FALSE) ;
  IF f >= 0 THEN RETURN f END ;
  f := RgFieldKey (x, fld, st, TRUE) ;
  IF f >= 0 THEN st[f] := 0 ; st[rgCap + f] := 0 END ;
  RETURN f
END RgFieldNew ;

PROCEDURE RgFieldKey (x: I64 ; RO fld: UTF ; st: SLICE OF I64 ; make: BOOL) : I64 =
VAR
  f : I64 ;
  key : UTF ;
BEGIN
  key := Cat (Cat (rgNames[x], '.'), fld) ;
  f := RgFind (key) ;
  IF f >= 0 OR NOT make THEN RETURN f END ;
  f := RgEnter (key, TRUE) ;
  (* a field this procedure has not assigned: where the record lives
     -- not what its OTHER fields were given here, which is what made
     `b.store := store' the place `b.gasName[g]' writes into; for a
     module variable, what the unit gives that field *)
  IF f >= 0 THEN
    st[f] := RgDel (RgReach (RgVal (st, x)), RgRo) ;
    IF Text.Eq (ScopeMode (rgNames[x]), ModeModule) AND
       Text.Contains (RgModMarks (rgNames[x]), Cat (Cat (',.', fld), ',')) THEN
      st[f] := RgAdd (st[f], RgRo)
    END ;
    st[rgCap + f] := RgDel (st[f], RgRo)
  END ;
  RETURN f
END RgFieldKey ;

(* the tracked field a designator starts with -- `x.f', or `x[i].f',
   an element's field, as the name `x[].f' -- and in used how many of its
   selectors that took *)
PROCEDURE RgField (d: PTR Ast.Node ; st: SLICE OF I64 ; make: BOOL ; VAR used: I64) : I64 =
VAR x : I64 ;
BEGIN
  used := 0 ;
  IF d.nkids = 0 THEN RETURN -1 END ;
  x := RgTrack (d.au, st) ;
  IF x < 0 THEN RETURN -1 END ;
  IF d.kids[0] IS SOME s0 THEN
    IF s0.kind = Ast.NSelField THEN
      used := 1 ;
      IF make AND d.nkids = 1 THEN RETURN RgFieldNew (x, s0.au, st) END ;
      RETURN RgFieldKey (x, s0.au, st, make)
    END ;
    IF s0.kind = Ast.NSelIndex AND d.nkids > 1 THEN
      IF d.kids[1] IS SOME s1 THEN
        IF s1.kind = Ast.NSelField THEN
          used := 2 ;
          RETURN RgFieldKey (x, Cat ('[].', s1.au), st, make)
        END
      END
    END
  END ;
  RETURN -1
END RgField ;

(* is the expression a literal or a CONST -- read-only storage a mark
   can see without a walk *)
PROCEDURE RgLitRo (k: Ast.Kid) : BOOL =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NString THEN RETURN Text.BLen (e.au) > 0 END ;
    IF e.kind = Ast.NParen THEN RETURN RgLitRo (e.kids[0]) END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN RETURN IsConstHere (e.au) END
  END ;
  RETURN FALSE
END RgLitRo ;

(* the paths under name nm that an assignment in tree k gives a literal:
   `*' the name itself, `[]' an element, `.f' a first field -- each
   between commas in acc *)
(* the marks one name's assignments give it, in one subtree (RgVarMarks) *)
PROCEDURE RgMarkWalk (k: Ast.Kid ; RO nm: UTF ; VAR acc: UTF) =
VAR
  i : I64 ;
  key : UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND Text.Eq (lh.au, nm) AND RgLitRo (e.kids[1]) THEN
          (* only what the assignment says: `x := lit', `x[i] := lit',
             `x.f := lit'; a deeper path marks nothing (an element's
             field given a literal is not every element read-only) *)
          key := '*' ;
          IF lh.nkids = 1 THEN
            IF lh.kids[0] IS SOME s0 THEN
              IF s0.kind = Ast.NSelField THEN key := Cat ('.', s0.au) ELSE key := '[]' END
            END
          ELSIF lh.nkids > 1 THEN
            key := ''
          END ;
          IF Text.BLen (key) > 0 AND NOT Text.Contains (acc, Cat (Cat (',', key), ',')) THEN
            acc := Text.Keep (pool, Cat (Cat (acc, key), ','))
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RgMarkWalk (e.kids[i], nm, acc) END
  END
END RgMarkWalk ;

(* every name's marks, into rgMkAcc by rgMkIx (RgModMarks) *)
PROCEDURE RgMarkAll (k: Ast.Kid) =
VAR
  i, j : I64 ;
  key : UTF ;
  na : SLICE OF UTF ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND RgLitRo (e.kids[1]) THEN
          (* only what the assignment says: `x := lit', `x[i] := lit',
             `x.f := lit'; a deeper path marks nothing (an element's
             field given a literal is not every element read-only) *)
          key := '*' ;
          IF lh.nkids = 1 THEN
            IF lh.kids[0] IS SOME s0 THEN
              IF s0.kind = Ast.NSelField THEN key := Cat ('.', s0.au) ELSE key := '[]' END
            END
          ELSIF lh.nkids > 1 THEN
            key := ''
          END ;
          IF Text.BLen (key) > 0 THEN
            j := NxFind (rgMkIx, lh.au) ;
            IF j < 0 THEN
              IF nrgMk = LEN (rgMkAcc) THEN
                na := NEW (pool, UTF, 2 * nrgMk + 16) ;
                FOR i := 0 TO nrgMk - 1 DO na[i] := rgMkAcc[i] END ;
                rgMkAcc := na
              END ;
              rgMkAcc[nrgMk] := ',' ;
              NxAdd (rgMkIx, Text.Keep (pool, lh.au), nrgMk) ;
              j := nrgMk ;
              nrgMk := nrgMk + 1
            END ;
            IF NOT Text.Contains (rgMkAcc[j], Cat (Cat (',', key), ',')) THEN
              rgMkAcc[j] := Text.Keep (pool, Cat (Cat (rgMkAcc[j], key), ','))
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RgMarkAll (e.kids[i]) END
  END
END RgMarkAll ;

PROCEDURE RgMemo (RO key: UTF ; VAR found: BOOL) : UTF =
VAR i : I64 ;
BEGIN
  i := NxFind (rgMemoIx, key) ;
  found := i >= 0 ;
  IF i < 0 THEN RETURN '' END ;
  RETURN rgMemoV[i]
END RgMemo ;

PROCEDURE RgMemoPut (RO key, v: UTF) =
VAR
  i : I64 ;
  nk, nv : SLICE OF UTF ;
BEGIN
  IF nrgMemo = LEN (rgMemoK) THEN
    nk := NEW (pool, UTF, 2 * nrgMemo + 16) ;
    nv := NEW (pool, UTF, 2 * nrgMemo + 16) ;
    FOR i := 0 TO nrgMemo - 1 DO nk[i] := rgMemoK[i] ; nv[i] := rgMemoV[i] END ;
    rgMemoK := nk ;
    rgMemoV := nv
  END ;
  rgMemoK[nrgMemo] := Text.Keep (pool, key) ;
  rgMemoV[nrgMemo] := Text.Keep (pool, v) ;
  NxAdd (rgMemoIx, rgMemoK[nrgMemo], nrgMemo) ;
  nrgMemo := nrgMemo + 1
END RgMemoPut ;

(* what the file gives module variable nm's paths: a literal anywhere,
   flow-insensitive, as a module variable is reached from anywhere *)
PROCEDURE RgModMarks (RO nm: UTF) : UTF =
VAR i : I64 ;
BEGIN
  (* every name's marks in one walk of the file, once per file: a walk
     per variable was n squared in a module's variables (the review's
     F5), and the memo it went into was keyed by the bare name across
     files -- a second file read the first one's marks *)
  IF curRoot.id # rgMkRoot THEN
    rgMkRoot := curRoot.id ;
    NxClear (rgMkIx) ;
    nrgMk := 0 ;
    RgMarkAll (SOME (curRoot))
  END ;
  i := NxFind (rgMkIx, nm) ;
  IF i < 0 THEN RETURN ',' END ;
  RETURN rgMkAcc[i]
END RgModMarks ;

(* what a callee gives its VAR parameter j's paths, read off its body --
   a SUMMARY (plan, step 4), structural so that it reads a library
   procedure the checker loaded but did not walk *)
PROCEDURE RgVarMarks (pr: ProcInfo ; j: I64) : UTF =
VAR
  found : BOOL ;
  v, key, nm : UTF ;
BEGIN
  key := Cat (Cat ('var ', Qualify (pr.modName, pr.name)), Cat ('#', ItoA (j))) ;
  v := RgMemo (key, found) ;
  IF found THEN RETURN v END ;
  v := ',' ;
  IF pr.body IS SOME d THEN
    nm := ParamNameAt (d, j) ;
    IF Text.BLen (nm) > 0 AND d.nkids > 4 THEN RgMarkWalk (d.kids[4], nm, v) END
  END ;
  RgMemoPut (key, v) ;
  RETURN v
END RgVarMarks ;

PROCEDURE RgCopy (RO s: SLICE OF I64) : SLICE OF I64 =
VAR
  r : SLICE OF I64 ;
  i : I64 ;
BEGIN
  r := NEW (I64, LEN (s)) ;
  FOR i := 0 TO LEN (s) - 1 DO r[i] := s[i] END ;
  RETURN r
END RgCopy ;

(* acc := acc OR b, component by component; answers whether acc grew *)
PROCEDURE RgJoin (acc: SLICE OF I64 ; RO b: SLICE OF I64) : BOOL =
VAR
  i, n : I64 ;
  grew : BOOL ;
BEGIN
  grew := FALSE ;
  FOR i := 0 TO LEN (acc) - 1 DO
    IF acc[i] # b[i] THEN
      n := RgOr (acc[i], b[i]) ;
      IF n # acc[i] THEN acc[i] := n ; grew := TRUE END
    END
  END ;
  RETURN grew
END RgJoin ;

(* the state is val in [0, rgCap) -- where the name's value lives -- and
   cont in [rgCap, 2 rgCap) -- what was stored into its components *)
PROCEDURE RgVal (RO st: SLICE OF I64 ; x: I64) : I64 =
BEGIN
  RETURN st[x]
END RgVal ;

PROCEDURE RgCont (RO st: SLICE OF I64 ; x: I64) : I64 =
BEGIN
  RETURN st[rgCap + x]
END RgCont ;

(* an object escaped: nothing is any longer reachable only from here
   (coarse: every name's fresh object, since the walk does not know which
   names alias which) *)
PROCEDURE RgEscape (st: SLICE OF I64) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO 2 * rgCap - 1 DO
    IF RgIsFresh (st[i]) THEN st[i] := RgStorage (st[i]) END
  END
END RgEscape ;

PROCEDURE RgExpr (k: Ast.Kid ; st: SLICE OF I64) : I64 ;

(* everything a value reaches: the value and, for a bare name or a
   component, what was stored into the object *)
PROCEDURE RgDeep (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR
  r, x, f, used : I64 ;
  t : UTF ;
BEGIN
  r := RgExpr (k, st) ;
  IF k IS SOME e THEN
    (* a scalar reaches nothing, wherever it was read from *)
    t := Ast.TyStrAt (e.id) ;
    IF Text.BLen (t) > 0 AND NOT RgBearing (t) THEN RETURN 0 END ;
    IF e.kind = Ast.NCallExpr THEN
      rgDeepCall := TRUE ;
      r := RgOr (r, RgExpr0 (k, st)) ;
      rgDeepCall := FALSE
    ELSIF e.kind = Ast.NDesignator THEN
      x := RgFind (e.au) ;
      (* what was stored into THIS field, when it is tracked apart --
         `RETURN j.p' does not carry what `j.t' was given *)
      f := RgField (e, st, FALSE, used) ;
      IF f >= 0 AND e.nkids = used THEN r := RgOr (r, RgCont (st, f))
      ELSIF x >= 0 THEN r := RgOr (r, RgCont (st, x)) END
    ELSIF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN
      r := RgOr (r, RgDeep (e.kids[0], st))
    END
  END ;
  RETURN r
END RgDeep ;

(* the frame forms: in a function answering a pointer-bearing type they
   are built in the caller's arena from the first statement *)
PROCEDURE RgFresh () : I64 =
BEGIN
  IF rgInCaller THEN RETURN RgPow (RgCaller) END ;
  RETURN RgPow (RgFrame)
END RgFresh ;

PROCEDURE RgFreshObj () : I64 =
BEGIN
  IF rgInCaller THEN RETURN RgPow (RgFrCaller) END ;
  RETURN RgPow (RgFrFrame)
END RgFreshObj ;

(* the region a POOL designator names, for an object made in it *)
PROCEDURE RgPoolObj (RO nm: UTF) : I64 =
VAR m : UTF ;
BEGIN
  IF Text.Eq (nm, 'HEAP') THEN RETURN RgPow (RgFrModule) END ;
  m := ScopeMode (nm) ;
  IF Text.Eq (m, ModeModule) THEN RETURN RgPow (RgFrModule) END ;
  IF Text.Eq (m, ModeLocal) THEN RETURN RgPow (RgFrPool) END ;
  (* a pool parameter declared KEPT outlives module state: the caller
     promises it (decision (d) of the plan, Alex: "refuse both" -- the
     caller's pool kept in module state, bare or through a field, is
     refused unless the pool says it may be) *)
  IF KeptHas (nm) THEN RETURN RgPow (RgFrModule) END ;
  RETURN RgPow (RgFrCaller)
END RgPoolObj ;

(* the regions a name in scope denotes when it is not tracked *)
PROCEDURE RgUntracked (RO nm: UTF) : I64 =
BEGIN
  IF IsConstHere (nm) THEN RETURN RgAdd (RgPow (RgStatic), RgRo) END ;
  RETURN RgPow (RgModule)
END RgUntracked ;

(* a call's answer: a record or variant constructor holds its
   arguments; a procedure the checker can read answers what its
   summaries say -- storage built in this arena or in a pool it was
   handed, a view of the arguments it views, read-only storage; one it
   cannot read (a procedure value, a foreign procedure) may answer any
   of it *)
(* a callee's parameter type, canonical in the module that wrote it *)
PROCEDURE RgCanonIn (pr: ProcInfo ; t: Ast.Kid) : UTF =
VAR was, r : UTF ;
BEGIN
  was := canonCtx ;
  canonCtx := Text.Keep (pool, pr.modName) ;
  r := CanonT (t, 0) ;
  canonCtx := was ;
  RETURN r
END RgCanonIn ;

(* the regions of the objects a call's VAR pointer arguments lead to: the
   pools rule 2 hands the callee behind them *)
PROCEDURE RgHiddenPools (pr: ProcInfo ; e: PTR Ast.Node ; st: SLICE OF I64) : I64 =
VAR
  r, g, j, k : I64 ;
BEGIN
  r := 0 ;
  k := 0 ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      IF e.kids[1] IS SOME al THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF k < al.nkids AND grp.f1 AND RgRefTyIn (pr, grp.kids[1]) AND
                   NOT Text.StartsWith (RgCanonIn (pr, grp.kids[1]), 'SLICE ') AND
                   NOT Text.StartsWith (RgCanonIn (pr, grp.kids[1]), 'GRID ') THEN
                  r := RgOr (r, RgDel (RgExpr (al.kids[k], st), RgRo))
                END ;
                k := k + 1
              END
            END
          END
        END
      END
    END
  END ;
  RETURN r
END RgHiddenPools ;

(* what a callee's answer HOLDS through its fields: it RETURNs a bare
   local whose fields it gave a concatenation or a frame-answering call
   -- built in the caller's arena, so the answer is this activation's
   storage -- or a string literal -- read-only.  AnswersFrame reads the
   RETURN alone, and `r.s := 'value ' + ... ; RETURN r' answered the
   module's region: `last := Mk (41).s' and `rr := Mk (41) ; last :=
   rr.s' were accepted and read freed storage, `s := Mk ().s ; s[0] :=
   'X'' wrote into a literal (the second review's S2: N04, N21, N27).
   Memoised; 'busy' is nothing *)
(* what a value given to a returned record's field is: frame storage
   (a `+', a frame-answering call, a UTF conversion) or read-only (a
   literal) -- and a record aggregate's fields each, `R ('a' + 'b')',
   which answered a frame string the caller kept (the second review's
   fuzz N4, 2026-10-26: `g := F ().s' read NULs) *)
(* a `+' that is arithmetic by its shape: an operand a number literal,
   through a chain of `+'.  In another module's body nothing is typed,
   so an untyped `+' counts as a string's unless it shows itself a
   number's -- the first cut (RgStrPlus) counted it a string's only when
   a literal string showed, and `R (a + b, 1)' of two STR parameters
   answered a frame string a caller kept (the third review's typing
   CcUse, a heap-use-after-free) *)
(* a name the callee being read declares -- a parameter or a local --
   with a numeric builtin type: `a + b' of two I64 parameters is an
   integer's (the fourth review's H2: `R (Text.Keep (pool, s), a + b)'
   was read as a frame string) *)
PROCEDURE RgDeclType (RO nm: UTF) : Ast.Kid =
VAR
  g, b, c : I64 ;
  cp : ProcInfo ;
  found : BOOL ;
BEGIN
  IF Text.BLen (rgCompName) = 0 THEN RETURN NONE END ;
  cp := ProcNamed (rgCompMod, rgCompName, found) ;
  IF NOT found THEN RETURN NONE END ;
  IF cp.body IS SOME d THEN
    IF d.kids[0] IS SOME ps THEN
      FOR g := 0 TO ps.nkids - 1 DO
        IF ps.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR b := 0 TO ids.nkids - 1 DO
              IF ids.kids[b] IS SOME id THEN
                IF Text.Eq (id.au, nm) THEN RETURN grp.kids[1] END
              END
            END
          END
        END
      END
    END ;
    IF d.kids[4] IS SOME body THEN
      FOR g := 0 TO body.nkids - 1 DO
        IF body.kids[g] IS SOME sect THEN
          IF sect.kind = Ast.NVarSection THEN
            FOR b := 0 TO sect.nkids - 1 DO
              IF sect.kids[b] IS SOME vd THEN
                IF vd.kids[0] IS SOME vids THEN
                  FOR c := 0 TO vids.nkids - 1 DO
                    IF vids.kids[c] IS SOME vid THEN
                      IF Text.Eq (vid.au, nm) THEN RETURN vd.kids[1] END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN NONE
END RgDeclType ;

(* d indexes a string, or a slice or array of a scalar, that the callee
   being read declares: its element holds no reference (Text.Keep's
   `r[i] := s[i]' copies characters, not a view of s).  Since 2026-10-26
   also a FIELD of a record held by value on the way, and a named type at
   the end that holds no reference, each name resolved in the module it
   was written in (cp-kernel's Series.Build: `prods[pi].dl := prods[pi].dl
   + u.dl[x]' stores a number; Portal.CopyPairs copies a record of
   numbers), through a pointer too (`s.head := ix.head').  A name that
   does not resolve says nothing *)
PROCEDURE RgResolveIn (VAR m: UTF ; t: Ast.Kid) : Ast.Kid =
VAR
  was, mm : UTF ;
  r : Ast.Kid ;
BEGIN
  was := canonCtx ;
  canonCtx := Text.Keep (pool, m) ;
  r := ResolveType (t) ;
  mm := ResolvedMod () ;
  canonCtx := was ;
  IF Text.BLen (mm) > 0 THEN m := Text.Keep (pool, mm) END ;
  RETURN r
END RgResolveIn ;

PROCEDURE RgScalarWalk (d: PTR Ast.Node ; num: BOOL) : BOOL =
VAR
  i, k : I64 ;
  t, r : Ast.Kid ;
  el, m : UTF ;
BEGIN
  IF d.nkids = 0 THEN RETURN FALSE END ;
  t := RgDeclType (d.au) ;
  m := Text.Keep (pool, rgCompMod) ;
  FOR i := 0 TO d.nkids - 1 DO
    IF t IS SOME tq THEN
      IF tq.kind = Ast.NQualident AND Text.BLen (tq.bu) = 0 AND
         (Text.Eq (tq.au, 'STR') OR Text.Eq (tq.au, 'UTF')) THEN
        IF d.kids[i] IS SOME s0 THEN
          IF s0.kind # Ast.NSelIndex THEN RETURN FALSE END
        END ;
        (* a character: no reference, but no number for `+' either *)
        RETURN i = d.nkids - 1 AND NOT num
      END
    END ;
    r := RgResolveIn (m, t) ;
    (* through a pointer to what it leads to: a number read or stored
       through `ix.head' moves no reference *)
    k := 0 ;
    LOOP
      IF r IS SOME pn THEN
        IF (pn.kind = Ast.NPtrType OR pn.kind = Ast.NSharedType) AND k < 8 THEN
          r := RgResolveIn (m, pn.kids[0]) ;
          k := k + 1
        ELSE
          EXIT
        END
      ELSE
        EXIT
      END
    END ;
    IF d.kids[i] IS SOME sl THEN
      IF r IS SOME tn THEN
        IF sl.kind = Ast.NSelIndex AND tn.kind = Ast.NSliceType THEN
          t := tn.kids[0]
        ELSIF sl.kind = Ast.NSelIndex AND tn.kind = Ast.NArrayType THEN
          t := tn.kids[1]
        ELSIF sl.kind = Ast.NSelField AND tn.kind = Ast.NRecordType THEN
          t := FieldTypeOf (tn, sl.au)
        ELSE
          RETURN FALSE
        END
      ELSE
        RETURN FALSE
      END
    END
  END ;
  IF t IS SOME e THEN
    IF e.kind = Ast.NQualident AND Text.BLen (e.bu) = 0 THEN
      el := e.au ;
      IF Text.OneOf (STR (el), NumericTys) THEN RETURN TRUE END ;
      IF NOT num AND (Text.Eq (el, 'CHAR') OR Text.Eq (el, 'BOOL')) THEN RETURN TRUE END
    END ;
    (* a named type that holds no reference, read in its module; only a
       name the canon resolved to its module (`Mod.T'): an unknown name
       says nothing *)
    IF e.kind = Ast.NQualident THEN
      el := CanonIn (m, t) ;
      IF num THEN RETURN Text.OneOf (STR (el), NumericTys) END ;
      RETURN Text.ContainsUtf (el, '.') AND NOT RgBearing (el)
    END
  END ;
  RETURN FALSE
END RgScalarWalk ;

PROCEDURE RgScalarElem (d: PTR Ast.Node) : BOOL =
BEGIN
  RETURN RgScalarWalk (d, FALSE)
END RgScalarElem ;

(* d's element or field is a NUMBER by the callee's declarations: an
   operand of an integer `+' (a CHAR joins a string) *)
PROCEDURE RgNumElem (d: PTR Ast.Node) : BOOL =
BEGIN
  RETURN RgScalarWalk (d, TRUE)
END RgNumElem ;

PROCEDURE RgDeclNumeric (RO nm: UTF) : BOOL =
VAR
  g, b, c : I64 ;
  tn : UTF ;
  cp : ProcInfo ;
  found : BOOL ;
BEGIN
  IF Text.BLen (rgCompName) = 0 THEN RETURN FALSE END ;
  cp := ProcNamed (rgCompMod, rgCompName, found) ;
  IF NOT found THEN RETURN FALSE END ;
  IF cp.body IS SOME d THEN
    IF d.kids[0] IS SOME ps THEN
      FOR g := 0 TO ps.nkids - 1 DO
        IF ps.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR b := 0 TO ids.nkids - 1 DO
              IF ids.kids[b] IS SOME id THEN
                IF Text.Eq (id.au, nm) THEN
                  IF grp.kids[1] IS SOME tq THEN
                    tn := tq.au ;
                    RETURN tq.kind = Ast.NQualident AND Text.BLen (tq.bu) = 0 AND
                           Text.OneOf (STR (tn), NumericTys)
                  END ;
                  RETURN FALSE
                END
              END
            END
          END
        END
      END
    END ;
    IF d.kids[4] IS SOME body THEN
      FOR g := 0 TO body.nkids - 1 DO
        IF body.kids[g] IS SOME sect THEN
          IF sect.kind = Ast.NVarSection THEN
            FOR b := 0 TO sect.nkids - 1 DO
              IF sect.kids[b] IS SOME vd THEN
                IF vd.kids[0] IS SOME vids THEN
                  FOR c := 0 TO vids.nkids - 1 DO
                    IF vids.kids[c] IS SOME vid THEN
                      IF Text.Eq (vid.au, nm) THEN
                        IF vd.kids[1] IS SOME vt THEN
                          RETURN vt.kind = Ast.NQualident AND Text.BLen (vt.bu) = 0 AND
                                 Text.OneOf (STR (vt.au), NumericTys)
                        END ;
                        RETURN FALSE
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END RgDeclNumeric ;

PROCEDURE RgNumPlus (e: PTR Ast.Node) : BOOL =
VAR i : I64 ;
BEGIN
  IF e.kind = Ast.NInt OR e.kind = Ast.NReal THEN RETURN TRUE END ;
  IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN RETURN RgDeclNumeric (e.au) END ;
  (* an element or field the callee declares a number: `s.families[i].n
     + u.dl[i]' (GfScalarCopy, refused in five of twelve declaration
     orders -- those that walked Build before it was typed) *)
  IF e.kind = Ast.NDesignator THEN RETURN RgNumElem (e) END ;
  (* an operand that is arithmetic of its own, or a scalar builtin:
     `ip * 10 + d', `ORD (c) - ORD ('0')' (Json's ParseNumber read as a
     string built in the frame, and every parsed node as frame storage) *)
  IF e.kind = Ast.NBin AND NOT Text.Eq (e.au, '+') THEN
    RETURN Text.OneOf (STR (e.au), ArithOps)
  END ;
  IF e.kind = Ast.NCallExpr THEN
    IF e.kids[0] IS SOME cdn THEN
      IF cdn.kind = Ast.NDesignator AND cdn.nkids = 0 THEN
        RETURN Text.OneOf (STR (cdn.au), ScalarFns)
      END
    END
  END ;
  IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') THEN
    FOR i := 0 TO e.nkids - 1 DO
      IF e.kids[i] IS SOME o THEN
        IF RgNumPlus (o) THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END RgNumPlus ;

PROCEDURE RgCompVal (k: Ast.Kid ; VAR fr, ro: BOOL) =
VAR
  i : I64 ;
  pr2 : ProcInfo ;
  found : BOOL ;
  om, canon : UTF ;
BEGIN
  IF k IS SOME rv THEN
    (* a value that reaches no storage says nothing: `c.nent := c.nent +
       1' is an integer `+', and taken as a frame string it made
       zarrm9's Query.BuildCache answer frame storage (a false refusal
       found in Serve.Run, 2026-10-26) *)
    IF Text.BLen (Ast.TyStrAt (rv.id)) > 0 AND NOT RgBearing (Ast.TyStrAt (rv.id)) THEN RETURN END ;
    IF rv.kind = Ast.NString AND Text.BLen (rv.au) > 0 THEN ro := TRUE END ;
    IF rv.kind = Ast.NBin AND Text.Eq (rv.au, '+') THEN
      (* in another module's body nothing is typed (the typed tree is the
         checked unit's): a `+' there is a string's only when it says so *)
      IF Text.BLen (Ast.TyStrAt (rv.id)) > 0 OR NOT RgNumPlus (rv) THEN fr := TRUE END
    END ;
    IF Text.Eq (UtfBuiltin (rv), 'UTF') OR Text.Eq (UtfBuiltin (rv), 'STR') THEN
      fr := TRUE
    ELSIF rv.kind = Ast.NCallExpr THEN
      IF rv.kids[0] IS SOME cd THEN
        IF cd.kind = Ast.NDesignator THEN
          IF RecordNamed (DesigName (cd), om, canon) IS SOME rn THEN
            IF rv.kids[1] IS SOME al THEN
              FOR i := 0 TO al.nkids - 1 DO RgCompVal (al.kids[i], fr, ro) END
            END
          ELSE
            pr2 := LookupProc (DesigName (cd), found) ;
            IF found AND Text.BLen (pr2.foreign) = 0 THEN
              IF AnswersFrame (Qualify (pr2.modName, pr2.name), pr2) THEN fr := TRUE END
            END
          END
        END
      END
    END
  END
END RgCompVal ;

PROCEDURE RgCompWalk (k: Ast.Kid ; RO nm: UTF ; VAR fr, ro: BOOL) =
VAR
  i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND lh.nkids > 0 AND Text.Eq (lh.au, nm) THEN
          RgCompVal (e.kids[1], fr, ro)
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RgCompWalk (e.kids[i], nm, fr, ro) END
  END
END RgCompWalk ;

PROCEDURE RgCompRet (k: Ast.Kid ; body: Ast.Kid ; VAR fr, ro: BOOL) ;

PROCEDURE RgCompOf (RO qual: UTF ; pr: ProcInfo) : I64 =
VAR
  i, r : I64 ;
  key, wasMod : UTF ;
  fr, ro : BOOL ;
  wasCm, wasCn : UTF ;
BEGIN
  key := Text.Keep (pool, Cat ('comp ', qual)) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN
    r := 0 ;
    fr := AnsYes (i) ;
    IF Text.Contains (ansState[i], 'f') THEN r := RgOr (r, RgFreshObj ()) END ;
    IF Text.Contains (ansState[i], 'r') THEN r := RgAdd (r, RgRo) END ;
    RETURN r
  END ;
  AnsSet (key, 'busy') ;
  fr := FALSE ;
  ro := FALSE ;
  (* the callee's body read in the callee's module: its record names and
     bare calls are its own (CcUse: `R (a + b, 1)' in CcDef was looked
     up in the caller and found nothing) *)
  wasMod := curMod ;
  wasCm := rgCompMod ;
  wasCn := rgCompName ;
  curMod := Text.Keep (pool, pr.modName) ;
  rgCompMod := Text.Keep (pool, pr.modName) ;
  rgCompName := Text.Keep (pool, pr.name) ;
  IF pr.body IS SOME d THEN RgCompRet (d.kids[4], d.kids[4], fr, ro) END ;
  curMod := wasMod ;
  rgCompMod := wasCm ;
  rgCompName := wasCn ;
  r := 0 ;
  IF fr AND ro THEN AnsSet (key, 'fr') ELSIF fr THEN AnsSet (key, 'f') ELSIF ro THEN AnsSet (key, 'r') ELSE AnsSet (key, '-') END ;
  IF fr THEN r := RgOr (r, RgFreshObj ()) END ;
  IF ro THEN r := RgAdd (r, RgRo) END ;
  RETURN r
END RgCompOf ;

(* every RETURN of a bare name under k: that name's field stores *)
PROCEDURE RgCompRet (k: Ast.Kid ; body: Ast.Kid ; VAR fr, ro: BOOL) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NReturn AND e.nkids > 0 THEN
      IF e.kids[0] IS SOME rv THEN
        IF rv.kind = Ast.NDesignator AND rv.nkids = 0 THEN
          RgCompWalk (body, rv.au, fr, ro)
        ELSIF rv.kind = Ast.NCallExpr THEN
          RgCompVal (e.kids[0], fr, ro)
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RgCompRet (e.kids[i], body, fr, ro) END
  END
END RgCompRet ;

(* the callee's declared result type *)
PROCEDURE OlResultTy (pr: ProcInfo) : Ast.Kid =
BEGIN
  IF pr.node IS SOME pd THEN RETURN pd.kids[1] END ;
  RETURN NONE
END OlResultTy ;

(* is the callee's parameter i a POOL: what it answers in it is the
   pool's, which the POOL arguments below account for *)
PROCEDURE OlPoolParam (pr: ProcInfo ; i: I64) : BOOL =
VAR g, j, k : I64 ;
BEGIN
  k := 0 ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF k = i THEN RETURN Text.Eq (RgCanonIn (pr, grp.kids[1]), 'POOL') END ;
              k := k + 1
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END OlPoolParam ;

(* the return-flow summaries of the owner walk's section, read here too *)
PROCEDURE OlRetReach (pr: ProcInfo ; j: I64) : BOOL ;
PROCEDURE OlRetFlow (pr: ProcInfo ; seed: I64) : BOOL ;

PROCEDURE RgCall (e: PTR Ast.Node ; st: SLICE OF I64) : I64 =
VAR
  r, i, g, j, k, vw, x0 : I64 ;
  pr : ProcInfo ;
  found : BOOL ;
  om, canon, q, com : UTF ;
  cflat : SLICE OF AKid ;
BEGIN
  r := 0 ;
  (* the UTF builtins: a conversion builds here, a view is its argument's
     storage, read-only *)
  IF Text.Eq (UtfBuiltin (e), 'UTF') OR Text.Eq (UtfBuiltin (e), 'STR') THEN
    IF e.kids[1] IS SOME ual THEN x0 := RgExpr (ual.kids[0], st) END ;
    RETURN RgFresh ()
  END ;
  IF OctetsArg (e) IS SOME roa THEN
    RETURN RgAdd (RgExpr (SOME (roa), st), RgRo)
  END ;
  (* UTF (pool, x): where NEW (pool, ...) would put it *)
  IF Text.BLen (UtfInPool (e)) > 0 THEN
    IF e.kids[1] IS SOME upl THEN
      x0 := RgExpr (upl.kids[1], st) ;
      IF upl.kids[0] IS SOME up0 THEN
        IF up0.kind = Ast.NDesignator AND up0.nkids > 0 THEN RETURN RgPow (RgFrModule) END ;
        IF NOT Text.Eq (ScopeMode (up0.au), '') OR Text.Eq (up0.au, 'HEAP') THEN
          RETURN RgPoolObj (up0.au)
        END
      END
    END ;
    RETURN RgFreshObj ()
  END ;
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator THEN
      IF RecordNamed (DesigName (dn), om, canon) IS SOME rec THEN
        IF e.kids[1] IS SOME al THEN
          FOR i := 0 TO al.nkids - 1 DO r := RgOr (r, RgDeep (al.kids[i], st)) END
        END ;
        RETURN r
      END ;
      pr := LookupProc (DesigName (dn), found) ;
      IF found AND Text.BLen (pr.foreign) = 0 AND ScopeFind (dn.au) < 0 THEN
        q := Qualify (pr.modName, pr.name) ;
        IF AnswersFrame (q, pr) THEN r := RgOr (r, RgFreshObj ()) END ;
        (* a stated effect: [FRESH] builds the answer in this arena *)
        IF Text.Eq (pr.attrib, 'FRESH') THEN r := RgOr (r, RgFreshObj ()) END ;
        r := RgOr (r, RgCompOf (q, pr)) ;
        IF Text.BLen (RoAnswerOf (e)) > 0 THEN r := RgAdd (r, RgRo) END ;
        vw := 0 ;
        IF e.kids[1] IS SOME al2 THEN
          FOR i := 0 TO al2.nkids - 1 DO
            IF AnswersViewAt (q, pr, i) THEN vw := RgOr (vw, RgDeep (al2.kids[i], st)) END
          END ;
          IF AnswersBorrowAny (q, pr) THEN
            FOR i := 0 TO al2.nkids - 1 DO vw := RgOr (vw, RgDeep (al2.kids[i], st)) END
          END ;
          (* any answer a RETURN can reach an argument by, not only the
             slice and pointer answers the summaries above read: a
             record handed back (`Wrap (r: R) : R = RETURN r') carried r's
             frame string into module state (the fourth review's ViewVal) *)
          FOR i := 0 TO al2.nkids - 1 DO
            IF NOT OlPoolParam (pr, i) AND OlRetReach (pr, i) THEN
              vw := RgOr (vw, RgDeep (al2.kids[i], st))
            END
          END ;
          (* a POOL handed to it: the answer may be made there *)
          k := 0 ;
          IF pr.node IS SOME pd THEN
            IF pd.kids[0] IS SOME pl THEN
              FOR g := 0 TO pl.nkids - 1 DO
                IF pl.kids[g] IS SOME grp THEN
                  IF grp.kids[0] IS SOME ids THEN
                    FOR j := 0 TO ids.nkids - 1 DO
                      IF k < al2.nkids AND Text.Eq (RgCanonIn (pr, grp.kids[1]), 'POOL') THEN
                        IF al2.kids[k] IS SOME pa THEN
                          IF pa.kind = Ast.NDesignator AND pa.nkids > 0 THEN
                            r := RgOr (r, RgPow (RgFrModule))
                          ELSIF pa.kind = Ast.NDesignator THEN
                            r := RgOr (r, RgPoolObj (pa.au))
                          END
                        END
                      END ;
                      k := k + 1
                    END
                  END
                END
              END
            END
          END ;
          (* views in a FRESH answer -- made here, or in a pool handed to
             it -- are what it HOLDS, not where it lives: a list split out
             of a literal is writable, its pieces not; GrowF's copy of a
             list holds what the list held.  They are the answer's
             contents, which only RgDeep asks for *)
          IF RgIsFresh (r) OR RgHas (r, RgFrame) OR RgHas (r, RgCaller) THEN
            IF rgDeepCall THEN r := RgOr (r, vw) END
          ELSE
            r := RgOr (r, vw)
          END
        END ;
        (* storage built in the callee's frame, or read-only storage,
           through any chain of locals or callees (OlRetFlow) *)
        IF OlRetFlow (pr, 1) THEN r := RgOr (r, RgFreshObj ()) END ;
        (* read-only: a slice or string answer that IS read-only storage
           (seed 3); a record's field holding some (seed 2) *)
        IF Text.StartsWith (RgCanonIn (pr, OlResultTy (pr)), 'SLICE OF ') OR
           Text.StartsWith (RgCanonIn (pr, OlResultTy (pr)), 'GRID ') OR
           Text.Eq (RgCanonIn (pr, OlResultTy (pr)), UtfTy) THEN
          IF OlRetFlow (pr, 3) THEN r := RgAdd (r, RgRo) END
        ELSIF OlRetFlow (pr, 2) THEN
          r := RgAdd (r, RgRo)
        END ;
        (* nothing of the above: storage the callee did not build here
           and does not view -- made in the pool a VAR pointer argument
           carries (rule 2: `NEW (c, Node)' in Json's ParseValue), where
           that argument's object lives; else a module's, or static *)
        IF r = 0 THEN r := RgHiddenPools (pr, e, st) END ;
        IF r = 0 THEN r := RgPow (RgModule) END ;
        RETURN r
      END
    END
  END ;
  (* a variant constructor, `V.Sl (NEW (o.pool, I64, 4))': it holds its
     arguments and builds nothing, as a record aggregate (the fourth
     review's A16b, refused as frame storage) *)
  IF CtorFields (SOME (e), cflat, com) >= 0 THEN
    IF e.kids[1] IS SOME alc THEN
      FOR i := 0 TO alc.nkids - 1 DO r := RgOr (r, RgDeep (alc.kids[i], st)) END
    END ;
    RETURN r
  END ;
  (* the sound default (plan, decision c): fresh, any argument, read-only *)
  r := RgAdd (RgFresh (), RgRo) ;
  IF e.kids[1] IS SOME al3 THEN
    FOR i := 0 TO al3.nkids - 1 DO r := RgOr (r, RgDeep (al3.kids[i], st)) END
  END ;
  RETURN r
END RgCall ;

PROCEDURE RgExpr0 (k: Ast.Kid ; st: SLICE OF I64) : I64 ;

(* a value whose type holds no reference lives nowhere: an I64 read out
   of a borrowed record is a copy; and only a slice's, a grid's or a
   string's value is read-only (a record HOLDING a literal is not) --
   the checker's recorded type says, and where it recorded none the
   regions stand *)
PROCEDURE RgExpr (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR
  r : I64 ;
  t : UTF ;
BEGIN
  r := RgExpr0 (k, st) ;
  IF k IS SOME e THEN
    t := Ast.TyStrAt (e.id) ;
    IF Text.BLen (t) > 0 THEN
      IF NOT RgBearing (t) THEN RETURN 0 END ;
      IF NOT Text.StartsWith (t, 'SLICE OF ') AND NOT Text.StartsWith (t, 'GRID ') AND
         NOT Text.StartsWith (t, 'RO ') THEN
        r := RgDel (r, RgRo)
      END
    END
  END ;
  RETURN r
END RgExpr ;

(* does k name an ARRAY held in this frame -- a local's or a value
   parameter's, or a field of one through records held by value?  A
   SLICE or GRID over it views the frame: `gs := SLICE (a, 0, 4)' with a
   a local ARRAY was accepted, and gs pointed into the C stack (the second
   review's S1: N06, N07, N13, N14, stack-use-after-scope) *)
PROCEDURE RgFrameArray (k: Ast.Kid) : BOOL =
VAR
  m : UTF ;
  j : I64 ;
BEGIN
  IF k IS SOME d THEN
    IF d.kind # Ast.NDesignator THEN RETURN FALSE END ;
    m := ScopeMode (d.au) ;
    IF NOT (Text.Eq (m, ModeLocal) OR Text.Eq (m, ModeVal) OR Text.Eq (m, ModeRo)) THEN RETURN FALSE END ;
    IF RgRefTy (ScopeType (d.au)) THEN RETURN FALSE END ;
    (* every step a field of a value record, and the end an array *)
    FOR j := 0 TO d.nkids - 1 DO
      IF d.kids[j] IS SOME sj THEN
        IF sj.kind # Ast.NSelField THEN RETURN FALSE END
      END
    END ;
    IF Ast.TypeAt (d.id) IS SOME tn THEN
      IF ResolveType (SOME (tn)) IS SOME r THEN RETURN r.kind = Ast.NArrayType END
    END ;
    IF d.nkids = 0 THEN
      IF ResolveType (ScopeType (d.au)) IS SOME r0 THEN RETURN r0.kind = Ast.NArrayType END
    END
  END ;
  RETURN FALSE
END RgFrameArray ;

PROCEDURE RgExpr0 (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR
  x, r, i, used : I64 ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NString :
        IF Text.BLen (e.au) = 0 THEN RETURN 0 END ;
        RETURN RgAdd (RgPow (RgStatic), RgRo)
    | Ast.NParen, Ast.NSomeExpr, Ast.NSliceOf3, Ast.NGridOf, Ast.NSharedExpr :
        r := RgExpr (e.kids[0], st) ;
        (* a SLICE or GRID over an ARRAY held in this frame views the frame *)
        IF (e.kind = Ast.NSliceOf3 OR e.kind = Ast.NGridOf) AND RgFrameArray (e.kids[0]) THEN
          r := RgOr (r, RgPow (RgStack))
        END ;
        FOR i := 1 TO e.nkids - 1 DO x := RgExpr (e.kids[i], st) END ;
        RETURN r
    | Ast.NBin :
        x := RgExpr (e.kids[0], st) ;
        r := RgExpr (e.kids[1], st) ;
        IF Text.Eq (e.au, '+') AND (Text.Eq (Ast.TyStrAt (e.id), 'SLICE OF CHAR') OR
           Text.Eq (Ast.TyStrAt (e.id), UtfTy)) THEN
          RETURN RgFresh ()
        END ;
        RETURN 0
    | Ast.NNewExpr :
        IF e.kids[0] IS SOME d0 THEN
          (* a pool an object holds (`NEW (o.pool, T)'): it lives as long
             as its owner, which here is taken as the program's -- the old
             analyses do not follow it either *)
          IF d0.kind = Ast.NDesignator AND d0.nkids > 0 THEN RETURN RgPow (RgFrModule) END ;
          IF d0.kind = Ast.NDesignator AND d0.nkids = 0 THEN
            IF Text.Eq (d0.au, 'OWN') THEN RETURN RgPow (RgOwned) END ;
            IF NOT Text.Eq (ScopeMode (d0.au), '') OR Text.Eq (d0.au, 'HEAP') THEN
              RETURN RgPoolObj (d0.au)
            END
          END
        END ;
        RETURN RgFreshObj ()
    | Ast.NCallExpr :
        RETURN RgCall (e, st)
    | Ast.NCallSel :
        (* `F (x).f', `F (x)[i]': a component of the answer reaches what
           the answer reaches -- it had no arm, and the ELSE answered 0:
           `last := Mk (41).s' with s a concatenation was accepted and read
           freed storage (the second review's S2, N04, N21, N27) *)
        FOR i := 1 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME cs THEN
            IF cs.kind = Ast.NSelIndex THEN x := RgExpr (cs.kids[0], st) END
          END
        END ;
        RETURN RgDeep (e.kids[0], st)
    | Ast.NDesignator :
        (* a VIEW is a call-shaped designator: its first argument *)
        IF Text.Eq (e.au, 'VIEW') AND e.nkids > 0 THEN
          IF e.kids[0] IS SOME vs THEN
            IF vs.kind = Ast.NArgList AND vs.nkids > 0 THEN RETURN RgExpr (vs.kids[0], st) END
          END
        END ;
        x := RgTrack (e.au, st) ;
        i := RgField (e, st, FALSE, used) ;
        IF x < 0 THEN
          r := RgUntracked (e.au)
        ELSIF e.nkids = 0 THEN
          r := RgVal (st, x)
        ELSIF i >= 0 AND e.nkids = used THEN
          r := RgVal (st, i)
        ELSIF i >= 0 THEN
          r := RgOr (RgReach (RgVal (st, i)), RgCont (st, i))
        ELSE
          (* a component: where the object lives, and what was put in it *)
          r := RgOr (RgReach (RgVal (st, x)), RgCont (st, x))
        END ;
        IF e.nkids > 0 AND Text.BLen (RoFieldOf (e)) > 0 THEN r := RgAdd (r, RgRo) END ;
        (* the subscripts are expressions of their own *)
        FOR i := 0 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME sel THEN
            IF sel.kind = Ast.NSelIndex THEN x := RgExpr (sel.kids[0], st) END
          END
        END ;
        RETURN r
    ELSE
      FOR i := 0 TO e.nkids - 1 DO x := RgExpr (e.kids[i], st) END ;
      RETURN 0
    END
  END ;
  RETURN 0
END RgExpr0 ;

(* the longest lifetime among the regions of D: 3 the program, 2 the
   call, 1 this activation, 0 none *)
PROCEDURE RgSpan (d: I64) : I64 =
BEGIN
  IF RgHas (d, RgModule) OR RgHas (d, RgStatic) OR RgHas (d, RgOwned) THEN RETURN 3 END ;
  IF RgHas (d, RgCaller) OR d >= RgPow (RgArg0) THEN RETURN 2 END ;
  IF RgHas (d, RgFrame) OR RgHas (d, RgPool) OR RgHas (d, RgStack) THEN RETURN 1 END ;
  RETURN 0
END RgSpan ;

(* is v -- everything a stored value reaches -- outlived by storage of
   regions d? *)
PROCEDURE RgJudge (n: PTR Ast.Node ; v0, d: I64 ; RO where: UTF) =
VAR span, j, v : I64 ;
BEGIN
  span := RgSpan (d) ;
  IF span < 2 THEN RETURN END ;
  v := RgStorage (v0) ;
  IF RgHas (v, RgFrame) OR RgHas (v, RgPool) OR RgHas (v, RgStack) THEN
    RgNote (n, 'frame', Cat ('storage of this activation stored into ', where))
  END ;
  IF span = 3 AND RgHas (v, RgCaller) THEN
    RgNote (n, 'caller', Cat ("the caller's arena stored into ", where))
  END ;
  (* a borrow stored into this activation's storage or the caller's
     arena is HANDED BACK (decision 51: the answer or the VAR target
     carries it); it is kept only where it outlives the call -- module
     state -- or in another parameter's object *)
  FOR j := 0 TO rgNArg - 1 DO
    IF RgHas (v, RgArg0 + j) AND NOT rgKept[j] AND
       (span = 3 OR (d >= RgPow (RgArg0) AND NOT RgHas (d, RgArg0 + j))) THEN
      RgNote (n, 'retention', Cat (Cat ('what parameter ', rgArgNames[j]),
        Cat (' leads to stored into ', Cat (where, ' without KEPT'))))
    END
  END
END RgJudge ;

(* x := Rec (a1, ..., an): field k of x is given ak, read-only flag and
   all (the review's E9: `r := R ("literal", 1) ; r.s[0] := ...') *)
PROCEDURE RgCtorFields (x: I64 ; re: PTR Ast.Node ; st: SLICE OF I64) =
VAR
  om, canon : UTF ;
  g, j, k, f : I64 ;
BEGIN
  IF re.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator THEN
      IF RecordNamed (DesigName (dn), om, canon) IS SOME rec THEN
        IF ResolveType (SOME (rec)) IS SOME rt THEN
          IF rt.kind = Ast.NRecordType AND rt.nkids > 1 THEN
            IF rt.kids[1] IS SOME fs THEN
              IF re.kids[1] IS SOME al THEN
                k := 0 ;
                FOR g := 0 TO fs.nkids - 1 DO
                  IF fs.kids[g] IS SOME grp THEN
                    IF grp.kids[0] IS SOME ids THEN
                      FOR j := 0 TO ids.nkids - 1 DO
                        IF ids.kids[j] IS SOME id THEN
                          IF k < al.nkids THEN
                            f := RgFieldKey (x, id.au, st, TRUE) ;
                            IF f >= 0 THEN
                              st[f] := RgExpr (al.kids[k], st) ;
                              st[rgCap + f] := RgDel (RgDeep (al.kids[k], st), RgRo)
                            END
                          END
                        END ;
                        k := k + 1
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END RgCtorFields ;

(* the store lhs := rhs *)
PROCEDURE RgStore (n: PTR Ast.Node ; lhs: PTR Ast.Node ; rhs: Ast.Kid ; st: SLICE OF I64) =
VAR
  x, d, v, deep, f, i, used, rdFirst : I64 ;
  m, pre, rdKey : UTF ;
  last : Ast.Kid ;
  rdro, ro2 : BOOL ;
BEGIN
  v := RgExpr (rhs, st) ;
  deep := RgDeep (rhs, st) ;
  x := RgTrack (lhs.au, st) ;
  m := ScopeMode (lhs.au) ;
  (* a VAR parameter's target is adopted at exit, the arena with it --
     the stack is not *)
  IF Text.Eq (m, ModeVar) AND RgHas (RgStorage (deep), RgStack) THEN
    RgNote (n, 'frame', Cat ("storage of this activation's stack (a SLICE or GRID of a local ARRAY) stored through VAR parameter ", lhs.au))
  END ;
  IF lhs.nkids = 0 THEN
    IF Text.Eq (m, ModeModule) AND NOT curInBody THEN
      RgJudge (n, deep, RgPow (RgModule), Cat ('module variable ', lhs.au)) ;
      IF RgIsFresh (deep) THEN RgEscape (st) END ;
      (* in a module variable nothing is reachable only from here *)
      v := RgStorage (v) ;
      deep := RgStorage (deep)
    END ;
    IF x >= 0 THEN
      (* a parameter, local or binder takes the value -- a VAR target is
         adopted into its pool at exit, a value parameter is a copy --
         and, from a bare name, what was stored into its object *)
      st[x] := v ;
      st[rgCap + x] := 0 ;
      (* given a component of another name: an alias of that storage, so
         what is stored through x later is stored into it (the fourth
         review's B01: `row := rows[0] ; row[0] := 'abc' ; rows[0][0][0]
         := 'X'' wrote into a literal) *)
      IF rhs IS SOME ra THEN
        IF ra.kind = Ast.NDesignator AND ra.nkids > 0 AND rgRef[x] THEN
          rgAlias[x] := RgFind (ra.au)
        END
      END ;
      (* a record assigned whole: its tracked fields are what came --
         looked for only when it has one (rgFldIx), the walk over every
         name was n squared in a module's variables (the review's F5).
         Read-only when the record is read-only storage by par 2.4 (an
         RO parameter, an RO variable, an RO field): its fields are
         views of the owner's storage.  RgExpr drops the mark from any
         record's value, so `fl := other ; fl.rows[0][0][0] := 'X''
         with RO other wrote into the caller's literal until 2026-10-29
         when fl.rows had been given storage of its own before -- the
         field kept that state, and RoRefreshed, which is not
         flow-sensitive, took the earlier store for a refresh
         (regions/R4FieldRowsAlias) *)
      IF NxFind (rgFldIx, lhs.au) >= 0 THEN
        pre := Cat (lhs.au, '.') ;
        rdro := Text.BLen (RoWhatOf (rhs)) > 0 ;
        FOR i := 0 TO rgN - 1 DO
          IF Text.StartsWith (rgNames[i], pre) THEN
            st[i] := RgDel (deep, RgRo) ;
            IF rdro THEN st[i] := RgAdd (st[i], RgRo) END ;
            st[rgCap + i] := st[i]
          END
        END
      END ;
      IF rhs IS SOME re THEN
        IF re.kind = Ast.NDesignator AND re.nkids = 0 AND RgFind (re.au) >= 0 THEN
          st[rgCap + x] := RgCont (st, RgFind (re.au))
        END ;
        (* a record value built field by field: each field its own;
           a variant's, or any call's, what it holds, read-only flag kept *)
        IF re.kind = Ast.NCallExpr THEN
          st[rgCap + x] := RgOr (RgCont (st, x), RgDel (RgDeep (rhs, st), RgRo)) ;
          rgDeepCall := TRUE ;
          st[rgCap + x] := RgOr (RgCont (st, x), RgExpr0 (rhs, st)) ;
          rgDeepCall := FALSE ;
          RgCtorFields (x, re, st)
        END
      END
    END ;
    RETURN
  END ;
  (* a value record's first field: a name of its own *)
  f := RgField (lhs, st, TRUE, used) ;
  IF f >= 0 THEN
    IF lhs.nkids = used AND (rgRef[x] OR used = 2) THEN
      (* through a reference: the object's field, which an alias may
         also reach -- judged as a store into the object, and added *)
      d := RgReach (RgVal (st, x)) ;
      IF NOT Text.Eq (m, ModeVar) THEN RgJudge (n, deep, d, Cat ('what ', Cat (lhs.au, ' leads to'))) END ;
      IF RgSpan (d) >= 2 AND RgIsFresh (deep) THEN RgEscape (st) END ;
      st[f] := RgOr (RgVal (st, f), v) ;
      st[rgCap + f] := RgOr (RgCont (st, f), deep)
    ELSIF lhs.nkids = used THEN
      (* a value record's field: the record's own storage -- a module
         variable's is the program's *)
      IF Text.Eq (m, ModeModule) AND NOT curInBody THEN
        RgJudge (n, deep, RgPow (RgModule), Cat ('module variable ', lhs.au)) ;
        IF RgIsFresh (deep) THEN RgEscape (st) END
      END ;
      st[f] := v ;
      st[rgCap + f] := 0 ;
      IF rhs IS SOME re2 THEN
        IF re2.kind = Ast.NDesignator AND re2.nkids = 0 AND RgFind (re2.au) >= 0 THEN
          st[rgCap + f] := RgCont (st, RgFind (re2.au))
        END
      END
    ELSIF used = 1 AND NOT rgRef[x] AND RgInline (lhs, 0, lhs.nkids - 2) THEN
      (* a field of the value record's field, through records and arrays
         held by value only: the record's own storage still, as one
         level is -- what the tracked field holds grows by the value *)
      IF Text.Eq (m, ModeModule) AND NOT curInBody THEN
        RgJudge (n, deep, RgPow (RgModule), Cat ('module variable ', lhs.au)) ;
        IF RgIsFresh (deep) THEN RgEscape (st) END
      END ;
      st[f] := RgOr (RgVal (st, f), v) ;
      st[rgCap + f] := RgOr (RgCont (st, f), deep)
    ELSE
      last := lhs.kids[lhs.nkids - 1] ;
      IF last IS SOME lf THEN
        (* an element of the field's own storage, or -- one selector
           deeper -- of what was stored into it, as for a bare name:
           `o.names[0] := Pick ('abc') ; o.names[0][0] := 'X'' wrote
           into a literal and died with SIGBUS (regions/W1.m9) *)
        IF lf.kind = Ast.NSelIndex AND lhs.nkids = used + 1 AND RgHas (RgVal (st, f), RgRo) THEN
          RgNote (n, 'readonly', Cat ('a write through ', Cat (lhs.au, ', which holds read-only storage')))
        ELSIF lf.kind = Ast.NSelIndex AND lhs.nkids > used + 1 AND RgAllIndex (lhs, used) THEN
          (* by depth where the depth scan follows the field path, as for
             a bare name below (oneflux's RoLentRec: fl.rows[0][m-1] :=
             a fresh string, the rows holding lent text) *)
          rdro := RgHas (RgOr (RgVal (st, f), RgCont (st, f)), RgRo) ;
          IF RdKey (lhs, rdKey, rdFirst) AND lhs.nkids - rdFirst >= 2 AND RdAllIndexFrom (lhs, rdFirst) THEN
            IF RdJudged (rdKey, lhs.nkids - rdFirst, ro2) THEN rdro := ro2 END
          END ;
          IF rdro THEN
            RgNote (n, 'readonly', Cat ('a write through ', Cat (lhs.au, ', which holds read-only storage')))
          END
        END
      END ;
      d := RgReach (RgVal (st, f)) ;
      IF NOT Text.Eq (m, ModeVar) THEN RgJudge (n, deep, d, Cat ('what ', Cat (lhs.au, ' leads to'))) END ;
      IF RgSpan (d) >= 2 AND RgIsFresh (deep) THEN RgEscape (st) END ;
      st[rgCap + f] := RgOr (RgCont (st, f), deep)
    END ;
    st[rgCap + x] := RgOr (RgCont (st, x), deep) ;
    IF rgAlias[x] >= 0 THEN st[rgCap + rgAlias[x]] := RgOr (RgCont (st, rgAlias[x]), deep) END ;
    RETURN
  END ;
  (* a write into read-only storage: an element of a slice, grid or
     string that holds one *)
  last := lhs.kids[lhs.nkids - 1] ;
  IF x >= 0 THEN
    IF last IS SOME ls THEN
      IF ls.kind = Ast.NSelIndex THEN
        IF lhs.nkids = 1 THEN d := RgVal (st, x) ELSE d := RgOr (RgVal (st, x), RgCont (st, x)) END ;
        (* by depth, where every store into the name is seen (RdScan):
           authoritative both ways -- it removes the mark a literal at
           another depth left, and it adds the one the flow-sensitive walk
           loses across an alias, `rows[0] := row' with the literal stored
           through row afterwards (R3DepthAlias, R3DepthBack: SIGBUS, and
           accepted by every compiler before this) *)
        IF RdKey (lhs, rdKey, rdFirst) AND lhs.nkids - rdFirst >= 2 AND RdAllIndexFrom (lhs, rdFirst) THEN
          IF RdJudged (rdKey, lhs.nkids - rdFirst, rdro) THEN
            IF rdro THEN d := RgAdd (d, RgRo) ELSE d := RgDel (d, RgRo) END
          END
        END ;
        IF RgHas (d, RgRo) THEN
          RgNote (n, 'readonly', Cat ('a write through ', Cat (lhs.au, ', which holds read-only storage')))
        END
      END
    END ;
    (* where the stored value can be read from: through a reference, the
       storage it points to (a fresh object's only from here); through a
       value record or array, the name's own storage for the first
       selector, then what was stored into it *)
    IF rgRef[x] THEN d := RgReach (RgVal (st, x))
    ELSIF lhs.nkids = 1 THEN d := 0
    ELSE d := RgReach (RgCont (st, x))
    END ;
    IF NOT Text.Eq (m, ModeVar) THEN RgJudge (n, deep, d, Cat ('what ', Cat (lhs.au, ' leads to'))) END ;
    IF RgSpan (d) >= 2 AND RgIsFresh (deep) THEN RgEscape (st) END ;
    st[rgCap + x] := RgOr (RgCont (st, x), deep) ;
    IF rgAlias[x] >= 0 THEN st[rgCap + rgAlias[x]] := RgOr (RgCont (st, rgAlias[x]), deep) END
  ELSIF Text.Eq (m, ModeModule) AND NOT curInBody THEN
    RgJudge (n, deep, RgPow (RgModule), Cat ('module variable ', lhs.au)) ;
    IF RgIsFresh (deep) THEN RgEscape (st) END
  END
END RgStore ;

(* a call's arguments: read-only storage lent to a writable slice or grid
   parameter, and a VAR slice, grid or string filled by the callee with
   storage built in this arena *)
(* each `.f' in marks: field f of x given read-only storage *)
PROCEDURE RgFieldMarks (x: I64 ; RO marks: UTF ; st: SLICE OF I64) =
VAR
  i, j, f : I64 ;
BEGIN
  i := 0 ;
  WHILE i < Text.BLen (marks) DO
    IF B (marks, i) = ORD ('.') THEN
      j := i + 1 ;
      WHILE j < Text.BLen (marks) AND B (marks, j) # ORD (',') DO j := j + 1 END ;
      f := RgFieldKey (x, SLICE (marks, i + 1, j - i - 1), st, TRUE) ;
      IF f >= 0 THEN st[f] := RgAdd (RgVal (st, f), RgRo) END ;
      i := j
    END ;
    i := i + 1
  END
END RgFieldMarks ;

(* a callee that fills its VAR parameter k from its parameter j
   (HandsBackFrom: `dst := src', `t.name := SLICE (s, ...)') makes the
   call the store `arg_k := arg_j' here, and it is judged as one: a
   record copied out of an activation's own pool into a module variable
   through `Carry (pool, st, jobs.job[0].s)' was accepted where `st :=
   jobs.job[0].s' is refused, and `st.date' pointed into the freed pool
   (oneflux's 0.25 report, its C5 and C6, 2026-10-25) *)
(* one hand-back into a module variable: what the source reaches is
   stored in module storage, judged as a store into it is.  Modelled
   first as the assignment `dst := src' for every destination, it read
   Sem.EmitPend's list as holding the literal PushErr was given *)
PROCEDURE RgHandBack (dst: PTR Ast.Node ; src: Ast.Kid ; st: SLICE OF I64) =
VAR deep : I64 ;
BEGIN
  (* only a MODULE variable as the destination: HandsBackFrom answers
     yes where it cannot rule a hand-back out -- it was built to spare a
     KEPT demand, where saying too much is harmless -- and joining its
     answer into a local's state refused three of Gen.EmitHandler's own
     stores (ExcRef's VAR fields) *)
  IF Text.Eq (ScopeMode (dst.au), ModeModule) AND NOT curInBody THEN
    (* judged only: RgStore's escape of every fresh object, taken on
       HandsBackFrom's yes, unmarked Gen.EmitHandler's fresh `blines' and
       refused its stores -- a fresh object handed into module state stays
       fresh here, which is what the walk did before it saw hand-backs *)
    deep := RgDeep (src, st) ;
    RgJudge (dst, deep, RgPow (RgModule), Cat ('module variable ', dst.au))
  END
END RgHandBack ;

PROCEDURE RgHandsBack (pr: ProcInfo ; a: PTR Ast.Node ; st: SLICE OF I64) =
VAR
  g, j, k, n : I64 ;
  isVar : SLICE OF BOOL ;
  qual : UTF ;
BEGIN
  n := a.nkids ;
  IF n < 2 THEN RETURN END ;
  isVar := NEW (BOOL, n) ;
  k := 0 ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF k < n THEN isVar[k] := grp.f1 END ;
              k := k + 1
            END
          END
        END
      END
    END
  END ;
  qual := Qualify (pr.modName, pr.name) ;
  FOR k := 0 TO n - 1 DO
    IF isVar[k] THEN
      IF a.kids[k] IS SOME dst THEN
        IF dst.kind = Ast.NDesignator THEN
          FOR j := 0 TO n - 1 DO
            IF j # k AND HandsBackFrom (qual, pr, k, j) THEN
              RgHandBack (dst, a.kids[j], st)
            END
          END
        END
      END
    END
  END
END RgHandsBack ;

(* ---- does a callee WRITE THROUGH its VAR parameter k -- a subscript
   store `s[i] := ...', a COPY into it, the name lent to a writable value
   slice or grid, or handed on to a VAR parameter that writes through?
   A VAR STR given a literal and written through wrote into read-only
   data: `s := 'abc' ; Up (s)' died with SIGBUS (the second review's
   S5, N39, 2026-10-26).  Memoised as `vw Mod.Proc k'; in progress
   counts as no, as the other summaries do; a callee the checker cannot
   read says nothing ---- *)
PROCEDURE RgVarWrites (pr: ProcInfo ; k: I64) : BOOL ;

PROCEDURE RgParamAt (pr: ProcInfo ; k: I64 ; VAR nm: UTF ; VAR grp0: Ast.Kid) : BOOL =
VAR g, j, n : I64 ;
BEGIN
  n := 0 ;
  IF pr.node IS SOME pd THEN
    IF pd.kids[0] IS SOME pl THEN
      FOR g := 0 TO pl.nkids - 1 DO
        IF pl.kids[g] IS SOME grp THEN
          IF grp.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF n = k THEN
                IF ids.kids[j] IS SOME id THEN nm := id.au ; grp0 := pl.kids[g] ; RETURN TRUE END ;
                RETURN FALSE
              END ;
              n := n + 1
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END RgParamAt ;

PROCEDURE RgWritesWalk (k: Ast.Kid ; RO nm: UTF) : BOOL =
VAR
  i, j : I64 ;
  pr2 : ProcInfo ;
  found : BOOL ;
  pnm, t : UTF ;
  gk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND lh.nkids > 0 AND Text.Eq (lh.au, nm) THEN
          FOR i := 0 TO lh.nkids - 1 DO
            IF lh.kids[i] IS SOME sl THEN
              IF sl.kind = Ast.NSelIndex THEN RETURN TRUE END
            END
          END
        END
      END
    END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[0] IS SOME cd THEN
        IF e.kids[1] IS SOME al THEN
          IF cd.kind = Ast.NDesignator AND cd.nkids = 0 AND Text.Eq (cd.au, 'COPY') AND al.nkids > 0 THEN
            IF al.kids[0] IS SOME a0 THEN
              IF a0.kind = Ast.NDesignator AND Text.Eq (a0.au, nm) THEN RETURN TRUE END
            END
          ELSIF cd.kind = Ast.NDesignator THEN
            found := FALSE ;
            FOR j := 0 TO al.nkids - 1 DO
              IF al.kids[j] IS SOME a THEN
                IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, nm) THEN
                  IF NOT found THEN pr2 := LookupProc (DesigName (cd), found) END ;
                  IF found THEN
                    gk := NONE ;
                    IF RgParamAt (pr2, j, pnm, gk) THEN
                      IF gk IS SOME gg THEN
                        IF gg.f1 THEN
                          IF RgVarWrites (pr2, j) THEN RETURN TRUE END
                        ELSIF NOT gg.f3 THEN
                          t := RgCanonIn (pr2, gg.kids[1]) ;
                          IF Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ') THEN RETURN TRUE END
                        END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF RgWritesWalk (e.kids[i], nm) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RgWritesWalk ;

PROCEDURE RgVarWrites (pr: ProcInfo ; k: I64) : BOOL =
VAR
  i : I64 ;
  key, nm : UTF ;
  gk : Ast.Kid ;
  r : BOOL ;
BEGIN
  IF Text.BLen (pr.foreign) > 0 THEN RETURN FALSE END ;
  key := Text.Keep (pool, Cat (Cat (Cat ('vw ', Qualify (pr.modName, pr.name)), ' '), ItoA (k))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  r := FALSE ;
  IF pr.body IS SOME b THEN
    gk := NONE ;
    IF RgParamAt (pr, k, nm, gk) THEN r := RgWritesWalk (b.kids[4], nm) END
  END ;
  IF r THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN r
END RgVarWrites ;

(* ---- does a callee give its VAR parameter k a NEW VALUE -- assign it
   bare, or hand it on as a VAR argument to a callee that does?  Only
   then does the argument come back holding storage of the arena it was
   called from; a callee that writes its elements, or only reads it,
   leaves the caller's storage where it was (the fourth review's H1:
   `P (entries)' with an empty P, and `Sort.Strs (entries)', made the
   pooled slice a frame value, and its elements' later store into a
   module variable was refused).  Memoised as `vg Mod.Proc k'; a callee
   the checker cannot read gives ---- *)
PROCEDURE RgVarGives (pr: ProcInfo ; k: I64) : BOOL ;

(* does the designator's path pass a slice, grid or pointer before its
   last step, by the types the typed tree recorded: then what it names is
   storage the root's copy does not hold *)
PROCEDURE RgPathRef (d: PTR Ast.Node) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO d.nkids - 2 DO
    IF d.kids[i] IS SOME sl THEN
      IF RgRefTy (Ast.TypeAt (sl.id)) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RgPathRef ;

PROCEDURE RgGivesWalk (k: Ast.Kid ; RO nm: UTF ; RO mod: UTF) : BOOL =
VAR
  i, j : I64 ;
  pr2 : ProcInfo ;
  found, builtin : BOOL ;
  pnm : UTF ;
  gk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND lh.nkids = 0 AND Text.Eq (lh.au, nm) THEN RETURN TRUE END
      END
    END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[1] IS SOME al THEN
        FOR j := 0 TO al.nkids - 1 DO
          IF al.kids[j] IS SOME a THEN
            IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, nm) THEN
              found := FALSE ;
              builtin := FALSE ;
              IF e.kids[0] IS SOME cd THEN
                IF cd.kind = Ast.NDesignator THEN
                  (* LEN (a), I64 (...): a builtin gives nothing *)
                  builtin := cd.nkids = 0 AND Text.OneOf (STR (DesigName (cd)), ScalarFns) ;
                  pr2 := ProcNamed (mod, DesigName (cd), found)
                END
              END ;
              IF NOT found AND NOT builtin THEN RETURN TRUE END ;
              IF builtin THEN found := FALSE END ;
              IF found THEN
                gk := NONE ;
                IF NOT RgParamAt (pr2, j, pnm, gk) THEN RETURN TRUE END ;
                IF gk IS SOME gg THEN
                  IF gg.f2 THEN RETURN TRUE END ;
                  IF gg.f1 THEN
                    IF RgVarGives (pr2, j) THEN RETURN TRUE END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF RgGivesWalk (e.kids[i], nm, mod) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RgGivesWalk ;

PROCEDURE RgVarGives (pr: ProcInfo ; k: I64) : BOOL =
VAR
  i : I64 ;
  key, nm : UTF ;
  gk : Ast.Kid ;
  r : BOOL ;
BEGIN
  IF Text.BLen (pr.foreign) > 0 THEN RETURN FALSE END ;
  key := Text.Keep (pool, Cat (Cat (Cat ('vg ', Qualify (pr.modName, pr.name)), ' '), ItoA (k))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  r := TRUE ;
  IF pr.body IS SOME b THEN
    gk := NONE ;
    IF RgParamAt (pr, k, nm, gk) THEN r := RgGivesWalk (b.kids[4], nm, pr.modName) END
  END ;
  IF r THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN r
END RgVarGives ;

(* is a VAR argument read-only storage, by the state that is its OWN:
   a bare name's value, or a tracked field's (`r.s', after `r.s :=
   'abc'').  A field's value is not the record's contents, which gather
   every field's: through them a read-only string one field was given
   marked its neighbours (zarrm9's Shuttle.Combine, `vctx.bandLo'), and
   the first fix -- bare names only -- let `W (r.s)' write into a
   literal (the third review's RoField, SIGBUS).  A path deeper than one
   field is not judged here (per-field state, owed) *)
PROCEDURE RgVarRo (ar: PTR Ast.Node ; v: I64 ; st: SLICE OF I64) : BOOL =
VAR f, used, x : I64 ;
BEGIN
  IF ar.nkids = 0 THEN RETURN RgHas (v, RgRo) END ;
  f := RgField (ar, st, FALSE, used) ;
  IF f >= 0 AND used = ar.nkids THEN RETURN RgHas (RgVal (st, f), RgRo) END ;
  (* an element, `Up (xs[0])' after `xs[0] := 'abc'': what was stored
     into its name or field (the fourth review's G1) *)
  IF RgAllIndex (ar, 0) THEN
    x := RgFind (ar.au) ;
    IF x >= 0 THEN RETURN RgHas (RgCont (st, x), RgRo) END
  ELSIF f >= 0 AND RgAllIndex (ar, used) THEN
    RETURN RgHas (RgCont (st, f), RgRo)
  END ;
  RETURN FALSE
END RgVarRo ;

(* what is stored INTO a lent argument -- its name's, or its tracked
   field's, contents -- read-only? *)
PROCEDURE RgContRo (ar: PTR Ast.Node ; st: SLICE OF I64) : BOOL =
VAR f, used, x : I64 ;
BEGIN
  f := RgField (ar, st, FALSE, used) ;
  IF f >= 0 AND used = ar.nkids THEN RETURN RgHas (RgCont (st, f), RgRo) END ;
  IF ar.nkids = 0 THEN
    x := RgFind (ar.au) ;
    IF x >= 0 THEN RETURN RgHas (RgCont (st, x), RgRo) END
  END ;
  RETURN FALSE
END RgContRo ;

(* ---- does a callee write TWO levels down through parameter k --
   `s[0][0] := 'X'' -- or hand it to one that does, or hand an element of
   it to one that writes through its parameter?  A slice of strings lent
   with a literal among its elements was written into (G2, G3: SIGBUS).
   Memoised as `vwd Mod.Proc k' ---- *)
PROCEDURE RgDeepWrites (pr: ProcInfo ; k: I64) : BOOL ;

PROCEDURE RgDeepWalk (k: Ast.Kid ; RO nm: UTF ; RO mod: UTF) : BOOL =
VAR
  i, j, idx : I64 ;
  pr2 : ProcInfo ;
  found : BOOL ;
  pnm : UTF ;
  gk : Ast.Kid ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND Text.Eq (lh.au, nm) THEN
          idx := 0 ;
          FOR i := 0 TO lh.nkids - 1 DO
            IF lh.kids[i] IS SOME sl THEN
              IF sl.kind = Ast.NSelIndex THEN idx := idx + 1 END
            END
          END ;
          IF idx >= 2 THEN RETURN TRUE END
        END
      END
    END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      IF e.kids[1] IS SOME al THEN
        FOR j := 0 TO al.nkids - 1 DO
          IF al.kids[j] IS SOME a THEN
            IF a.kind = Ast.NDesignator AND Text.Eq (a.au, nm) AND (a.nkids = 0 OR RgAllIndex (a, 0)) THEN
              found := FALSE ;
              IF e.kids[0] IS SOME cd THEN
                IF cd.kind = Ast.NDesignator THEN pr2 := ProcNamed (mod, DesigName (cd), found) END
              END ;
              IF found THEN
                gk := NONE ;
                IF RgParamAt (pr2, j, pnm, gk) THEN
                  IF gk IS SOME gg THEN
                    IF NOT gg.f3 THEN
                      IF a.nkids = 0 THEN
                        IF RgDeepWrites (pr2, j) THEN RETURN TRUE END
                      ELSE
                        IF RgVarWrites (pr2, j) THEN RETURN TRUE END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF RgDeepWalk (e.kids[i], nm, mod) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RgDeepWalk ;

PROCEDURE RgDeepWrites (pr: ProcInfo ; k: I64) : BOOL =
VAR
  i : I64 ;
  key, nm : UTF ;
  gk : Ast.Kid ;
  r : BOOL ;
BEGIN
  IF Text.BLen (pr.foreign) > 0 THEN RETURN FALSE END ;
  key := Text.Keep (pool, Cat (Cat (Cat ('vwd ', Qualify (pr.modName, pr.name)), ' '), ItoA (k))) ;
  i := AnsFind (key) ;
  IF i >= 0 THEN RETURN AnsYes (i) END ;
  AnsSet (key, 'busy') ;
  r := FALSE ;
  IF pr.body IS SOME b THEN
    gk := NONE ;
    IF RgParamAt (pr, k, nm, gk) THEN r := RgDeepWalk (b.kids[4], nm, pr.modName) END
  END ;
  IF r THEN AnsSet (key, 'yes') ELSE AnsSet (key, 'no') END ;
  RETURN r
END RgDeepWrites ;

PROCEDURE RgArgs (cd: Ast.Kid ; al: Ast.Kid ; st: SLICE OF I64) =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  g, j, k, x, v : I64 ;
  t, marks : UTF ;
BEGIN
  IF al IS SOME a THEN
    found := FALSE ;
    IF cd IS SOME c THEN
      IF c.kind = Ast.NDesignator THEN pr := LookupProc (DesigName (c), found) END
    END ;
    k := 0 ;
    IF found THEN
      IF pr.node IS SOME pd THEN
        IF pd.kids[0] IS SOME pl THEN
          FOR g := 0 TO pl.nkids - 1 DO
            IF pl.kids[g] IS SOME grp THEN
              IF grp.kids[0] IS SOME ids THEN
                t := RgCanonIn (pr, grp.kids[1]) ;
                FOR j := 0 TO ids.nkids - 1 DO
                  IF k < a.nkids THEN
                    IF a.kids[k] IS SOME ar THEN
                      v := RgExpr (a.kids[k], st) ;
                      IF grp.f4 AND RgHas (RgStorage (RgDeep (a.kids[k], st)), RgStack) THEN
                        RgNote (ar, 'frame', Cat ("storage of this activation's stack (a SLICE or GRID of a local ARRAY) handed to KEPT parameter ", ItoA (k + 1)))
                      END ;
                      (* lent by value, as decision 21's rule: a VAR one
                         hands over the variable, which the callee gives
                         a value of its own *)
                      IF RgHas (v, RgRo) AND NOT grp.f3 AND NOT grp.f1 AND
                         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ')) THEN
                        RgNote (ar, 'readonly', Cat ('read-only storage lent to writable parameter ',
                          ItoA (k + 1)))
                      END ;
                      (* and a VAR one the callee writes through (S5) -- a
                         bare name, whose value set is its own: through a
                         field the walk keeps one contents set per record,
                         and a read-only string given to one field marked
                         its neighbours (zarrm9's Shuttle.Combine, vctx.bandLo
                         beside vctx.coordStr) *)
                      IF grp.f1 AND ar.kind = Ast.NDesignator AND RgVarRo (ar, v, st) AND
                         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ')) THEN
                        IF RgVarWrites (pr, k) THEN
                          RgNote (ar, 'readonly', Cat (Cat ('read-only storage lent to VAR parameter ',
                            ItoA (k + 1)), ', which the callee writes through'))
                        END
                      END ;
                      (* read-only storage one level down -- a literal
                         among a slice's strings -- lent to a parameter
                         the callee writes two levels down through *)
                      IF NOT grp.f3 AND ar.kind = Ast.NDesignator AND RgContRo (ar, st) AND
                         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ')) THEN
                        IF RgDeepWrites (pr, k) THEN
                          RgNote (ar, 'readonly', Cat (Cat ('read-only storage in what is lent to parameter ',
                            ItoA (k + 1)), ', which the callee writes into'))
                        END
                      END ;
                      (* a VAR STR, slice or grid takes no pool: the callee
                         gives it a value built in the arena it is called
                         from, this frame -- where the argument is an
                         element of a by-value slice parameter, storage
                         that outlives the frame, that value was read back
                         freed: `Fill (names[0])', where `names[0] :=
                         names[0] + x' is refused (the second review's gen
                         N4, 2026-10-26).  A value pointer's target is
                         refused by CheckArg; a value record's field is
                         the frame's own copy -- unless the path passes a
                         slice or pointer inside the record, `st.instr[0].
                         model' with st a value record: the element is the
                         caller's (soundfuzz on oneflux's PpV1 with VAR
                         dropped from st, a use-after-free; 2026-10-26) *)
                      IF grp.f1 AND ar.kind = Ast.NDesignator AND ar.nkids > 0 AND
                         Text.Eq (ScopeMode (ar.au), ModeVal) AND
                         (RgRefTy (ScopeType (ar.au)) OR (RgPathRef (ar) AND RgVarGives (pr, k))) AND
                         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ') OR
                          Text.Eq (t, UtfTy)) THEN
                        RgNote (ar, 'frame', Cat (Cat ('a VAR argument in the storage value parameter ', ar.au),
                          ' leads to: the callee gives it a value built in this frame'))
                      END ;
                      IF grp.f1 AND ar.kind = Ast.NDesignator AND ar.nkids = 0 AND
                         (Text.StartsWith (t, 'SLICE OF ') OR Text.StartsWith (t, 'GRID ')) THEN
                        x := RgFind (ar.au) ;
                        IF x >= 0 AND RgVarGives (pr, k) THEN st[x] := RgOr (RgVal (st, x), RgFresh ()) END
                      END ;
                      (* what the callee gives the VAR parameter's paths:
                         a literal there is read-only here (E3, E4b) *)
                      IF grp.f1 AND ar.kind = Ast.NDesignator AND ar.nkids = 0 THEN
                        x := RgTrack (ar.au, st) ;
                        IF x >= 0 THEN
                          marks := RgVarMarks (pr, k) ;
                          IF Text.Contains (marks, ',*,') THEN st[x] := RgAdd (RgVal (st, x), RgRo) END ;
                          IF Text.Contains (marks, ',[],') THEN st[rgCap + x] := RgAdd (RgCont (st, x), RgRo) END ;
                          RgFieldMarks (x, marks, st)
                        END
                      END
                    END
                  END ;
                  k := k + 1
                END
              END
            END
          END
        END
      END
    END ;
    WHILE k < a.nkids DO v := RgExpr (a.kids[k], st) ; k := k + 1 END ;
    IF found THEN RgHandsBack (pr, a, st) END
  END
END RgArgs ;

PROCEDURE RgSeq (k: Ast.Kid ; st: SLICE OF I64) : BOOL ;

PROCEDURE RgBindPats (arm: PTR Ast.Node ; v: I64 ; st: SLICE OF I64) =
VAR
  i, j, x : I64 ;
BEGIN
  IF arm.kids[0] IS SOME ll THEN
    FOR i := 0 TO ll.nkids - 1 DO
      IF ll.kids[i] IS SOME lbl THEN
        IF lbl.kind = Ast.NLabelPattern THEN
          IF lbl.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                x := RgEnter (id.au, TRUE) ;
                IF x >= 0 THEN st[x] := v ; st[rgCap + x] := RgDel (v, RgRo) END
              END
            END
          END
        END
      END
    END
  END
END RgBindPats ;

(* the body of a loop to its fixpoint: st becomes the join of every
   state a pass can start from *)
PROCEDURE RgLoop (body: Ast.Kid ; st: SLICE OF I64) =
VAR
  b : SLICE OF I64 ;
  n : I64 ;
  e2 : BOOL ;
BEGIN
  (* to the fixpoint: the join only adds bits, from a finite set, so it
     settles.  It gave up after nine passes and kept the partial join, and
     a copy chain ten names long through a loop body carried frame storage
     past the judgement (the second review's S3: `last := a11' accepted,
     heap-use-after-free; `a7' refused).  The bound below is a guard that
     REFUSES, never reached in the tree *)
  n := 0 ;
  LOOP
    b := RgCopy (st) ;
    e2 := RgSeq (body, b) ;
    n := n + 1 ;
    IF NOT RgJoin (st, b) THEN EXIT END ;
    IF n > 400 THEN
      IF body IS SOME bn THEN
        ErrN (bn, rgCtx, 'the region judgement did not settle over this loop; refused rather than guessed (par 4, regions)')
      END ;
      EXIT
    END
  END
END RgLoop ;

(* a condition, and the binder of `x IS SOME p' -- IF's, ELSIF's and
   WHILE's alike: p is given what x reaches, read in src, set in dst.
   Only IF's first condition entered its binder, so a binder of ELSIF or
   WHILE was untracked and frame storage reached through it escaped
   (the second review's S4, N37 and N38: heap-use-after-free) *)
PROCEDURE RgCondBind (c: Ast.Kid ; src: SLICE OF I64 ; dst: SLICE OF I64) =
VAR x, v : I64 ;
BEGIN
  IF c IS SOME c0 THEN
    IF c0.kind = Ast.NIs AND c0.nkids > 1 THEN
      IF c0.kids[1] IS SOME bs THEN
        IF bs.kind = Ast.NIsSome AND Text.BLen (bs.au) > 0 THEN
          x := RgEnter (bs.au, TRUE) ;
          IF x >= 0 THEN
            dst[x] := RgExpr (c0.kids[0], src) ;
            dst[rgCap + x] := RgDel (RgDeep (c0.kids[0], src), RgRo)
          END
        END
      END
    ELSE
      v := RgExpr (c, src)
    END
  END
END RgCondBind ;

(* WHILE's loop: the binder taken again at the top of every pass, from
   the state the pass starts in -- `WHILE p IS SOME q DO ... p := ...' *)
PROCEDURE RgLoopCond (cond: Ast.Kid ; body: Ast.Kid ; st: SLICE OF I64) =
VAR
  b : SLICE OF I64 ;
  n : I64 ;
  e2 : BOOL ;
BEGIN
  n := 0 ;
  LOOP
    b := RgCopy (st) ;
    RgCondBind (cond, b, b) ;
    e2 := RgSeq (body, b) ;
    n := n + 1 ;
    IF NOT RgJoin (st, b) THEN EXIT END ;
    IF n > 400 THEN
      IF body IS SOME bn THEN
        ErrN (bn, rgCtx, 'the region judgement did not settle over this loop; refused rather than guessed (par 4, regions)')
      END ;
      EXIT
    END
  END
END RgLoopCond ;

PROCEDURE RgStmt (k: Ast.Kid ; st: SLICE OF I64) : BOOL =
VAR
  j, x, v : I64 ;
  acc, b : SLICE OF I64 ;
  e2 : BOOL ;
BEGIN
  IF k IS SOME s THEN
    CASE s.kind OF
    | Ast.NAssign :
        IF s.kids[0] IS SOME lh THEN
          IF lh.kind = Ast.NDesignator THEN RgStore (s, lh, s.kids[1], st) END
        END
    | Ast.NCallStmt :
        RgArgs (s.kids[0], s.kids[1], st)
    | Ast.NReturn :
        IF s.nkids = 0 THEN RETURN TRUE END ;
        IF s.kids[0] IS SOME rv THEN
          v := RgStorage (RgDeep (s.kids[0], st)) ;
          (* a string is re-homed out of the arena, never off the stack *)
          IF ((RgHas (v, RgFrame) OR RgHas (v, RgPool)) AND NOT StrTyIs (curRetTy)) OR
             RgHas (v, RgStack) THEN
            RgNote (s, 'return', 'storage of this activation answered to the caller')
          END
        END ;
        RETURN TRUE
    | Ast.NRaiseStmt :
        FOR j := 0 TO s.nkids - 1 DO v := RgExpr (s.kids[j], st) END ;
        RETURN TRUE
    | Ast.NExit :
        RETURN TRUE
    | Ast.NIf :
        acc := RgCopy (st) ;
        (* the condition's binder, `IF x IS SOME p' *)
        b := RgCopy (st) ;
        RgCondBind (s.kids[0], st, b) ;
        IF NOT RgSeq (s.kids[1], b) THEN e2 := RgJoin (acc, b) END ;
        FOR j := 2 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t THEN
            b := RgCopy (st) ;
            IF t.kind = Ast.NElsif THEN
              RgCondBind (t.kids[0], b, b) ;
              IF NOT RgSeq (t.kids[1], b) THEN e2 := RgJoin (acc, b) END
            ELSE
              IF NOT RgSeq (t.kids[0], b) THEN e2 := RgJoin (acc, b) END
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    | Ast.NCase :
        v := RgExpr (s.kids[0], st) ;
        acc := RgCopy (st) ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t2 THEN
            b := RgCopy (st) ;
            IF t2.kind = Ast.NCaseArm THEN
              (* `| V.Txt (s) :' -- a pattern's binders are given what the
                 selector reaches (the review's B3, E6) *)
              RgBindPats (t2, RgDeep (s.kids[0], st), b) ;
              IF NOT RgSeq (t2.kids[1], b) THEN e2 := RgJoin (acc, b) END
            ELSE
              IF NOT RgSeq (t2.kids[0], b) THEN e2 := RgJoin (acc, b) END
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    | Ast.NWhile :
        RgLoopCond (s.kids[0], s.kids[1], st)
    | Ast.NFor :
        v := RgExpr (s.kids[0], st) ;
        v := RgExpr (s.kids[1], st) ;
        RgLoop (s.kids[3], st)
    | Ast.NForIn :
        (* the variable is given each element: what the iterand's
           storage holds *)
        v := RgDeep (s.kids[0], st) ;
        x := RgEnter (s.au, RgRefTy (ScopeType (s.au))) ;
        IF x >= 0 THEN st[x] := RgReach (v) ; st[rgCap + x] := 0 END ;
        RgLoop (s.kids[1], st)
    | Ast.NLoop :
        RgLoop (s.kids[0], st)
    | Ast.NThread :
        (* a THREAD may outlive this activation: its argument must not
           lead to a local pool (the review's C9 -- the old analysis lets
           it through, the band workers joining before their procedure
           returns); listed, not refused, until a join is tied to it *)
        IF s.nkids > 1 THEN
          v := RgStorage (RgDeep (s.kids[1], st)) ;
          IF RgHas (v, RgPool) THEN
            RgNote (s, 'thread', 'a thread handed what leads to a local pool, which dies with this activation')
          END
        END
    | Ast.NBlock :
        b := RgCopy (st) ;
        e2 := RgSeq (s.kids[0], b) ;
        acc := RgCopy (b) ;
        e2 := RgJoin (acc, st) ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME h THEN
            IF h.kind = Ast.NHandler OR h.kind = Ast.NFinally THEN
              (* from anything its guarded sequence reached *)
              b := RgCopy (acc) ;
              IF h.kind = Ast.NHandler THEN e2 := RgSeq (h.kids[2], b)
              ELSE e2 := RgSeq (h.kids[0], b) END ;
              e2 := RgJoin (acc, b)
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    ELSE
      FOR j := 0 TO s.nkids - 1 DO v := RgExpr (s.kids[j], st) END
    END
  END ;
  RETURN FALSE
END RgStmt ;

PROCEDURE RgSeq (k: Ast.Kid ; st: SLICE OF I64) : BOOL =
VAR j : I64 ;
BEGIN
  IF k IS SOME q THEN
    IF q.kind # Ast.NStmtSeq THEN RETURN RgStmt (k, st) END ;
    FOR j := 0 TO q.nkids - 1 DO
      IF RgStmt (q.kids[j], st) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END RgSeq ;

(* how many names a body can enter beyond the scope: a designator at
   most two -- the module variable it reaches and one field key -- any
   other node at most one, a binder.  The table was nscope + 96, and
   once full a field fell back to its record: Options' hundred fields in
   flexpartm9's Config.Read made one RO default in one field read-only
   storage for the whole record, and 73 writes into NEW storage were
   refused (2026-10-25) *)
PROCEDURE RgCountKey (RO nm: UTF) =
BEGIN
  IF NxFind (rgCntIx, nm) < 0 THEN
    NxAdd (rgCntIx, Text.Keep (pool, nm), 1) ;
    rgCntN := rgCntN + 1
  END
END RgCountKey ;

(* the names the walk can enter for a body, counted once each: every
   name a node carries (a designator's root, a binder, a FOR variable)
   and the field key a designator starts with, `x.f' or `x.[].f' (as
   RgField makes it).  It was the body's NODE count, and every IF arm
   copies and joins the whole table: one procedure of 8,000 scalar IFs
   took 6.0 s where 0.24.0 took 0.12 (review2, a quadratic) *)
PROCEDURE RgNames (k: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    (* a literal's or an operator's text is no name: 8,000 IFs over
       `a > i' are 8,000 distinct literals and one name *)
    IF Text.BLen (e.au) > 0 AND e.kind # Ast.NInt AND e.kind # Ast.NReal AND
       e.kind # Ast.NChar AND e.kind # Ast.NString AND e.kind # Ast.NBin AND
       e.kind # Ast.NUn AND e.kind # Ast.NSelField THEN
      RgCountKey (e.au)
    END ;
    IF e.kind = Ast.NDesignator AND e.nkids > 0 THEN
      IF e.kids[0] IS SOME s0 THEN
        IF s0.kind = Ast.NSelField THEN
          RgCountKey (Cat (Cat (e.au, '.'), s0.au))
        ELSIF s0.kind = Ast.NSelIndex AND e.nkids > 1 THEN
          IF e.kids[1] IS SOME s1 THEN
            IF s1.kind = Ast.NSelField THEN RgCountKey (Cat (Cat (e.au, '.[].'), s1.au)) END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RgNames (e.kids[i]) END
  END
END RgNames ;

PROCEDURE RgCount (k: Ast.Kid) : I64 =
BEGIN
  NxClear (rgCntIx) ;
  rgCntN := 0 ;
  RgNames (k) ;
  RETURN rgCntN
END RgCount ;

(* the procedure's parameters, in order: Arg (j), read-only when RO *)
(* ---- read-only storage BY DEPTH, for names whose every store the walk
   can see (2026-10-26, the third review's typing advice; oneflux's 0.25
   report items 26-27).  The region state keeps one contents set per
   name, so `vut[y][i] := Nan' -- a literal two levels down -- made every
   later `vut[y][i] := x' "a write through vut, which holds read-only
   storage", though that write replaces an element and writes no
   literal.  For a LOCAL whose every assignment is `x := NEW (...)' or an
   element store `x[i]...[j] := v', which no VAR or OWN argument reaches,
   and whose non-leaf storage is copied into no other name (but for
   `rows[r] := row' between two such names, propagated both ways), a bit
   per depth says where read-only storage may lie; a write through k
   subscripts is refused only when depth k-1 may.  Any other name keeps
   the conservative rule, the contents set. ---- *)
VAR
  rdIx : NameIx ;
  rdOk : SLICE OF BOOL ;
  rdBits : SLICE OF I64 ;
  nrd : I64 ;
  rsX, rsK : SLICE OF I64 ;        (* the element stores: name, depth ... *)
  rsV : SLICE OF AKid ;            (* ... and the value stored *)
  nrs : I64 ;

PROCEDURE RdIndex (RO nm: UTF) : I64 =
VAR i, j : I64 ; nb : SLICE OF BOOL ; ni : SLICE OF I64 ;
BEGIN
  i := NxFind (rdIx, nm) ;
  IF i >= 0 THEN RETURN i END ;
  IF nrd = LEN (rdOk) THEN
    nb := NEW (pool, BOOL, 2 * nrd + 16) ;
    ni := NEW (pool, I64, 2 * nrd + 16) ;
    FOR j := 0 TO nrd - 1 DO nb[j] := rdOk[j] ; ni[j] := rdBits[j] END ;
    rdOk := nb ; rdBits := ni
  END ;
  NxAdd (rdIx, Text.Keep (pool, nm), nrd) ;
  rdOk[nrd] := TRUE ;
  rdBits[nrd] := 0 ;
  nrd := nrd + 1 ;
  RETURN nrd - 1
END RdIndex ;

PROCEDURE RdDrop (RO nm: UTF) =
VAR i : I64 ;
BEGIN
  IF NOT Text.Eq (ScopeMode (nm), ModeLocal) THEN RETURN END ;
  i := RdIndex (nm) ;
  rdOk[i] := FALSE
END RdDrop ;

(* a FIELD PATH of a local record held by value is followed as a name of
   its own (2026-10-27, oneflux's RoLentRec: `fl.rows[0][m-1] := ...'
   with the rows in a field of a returned local record): the key is the
   root and its fields, `fl.rows'; first is the index of the first
   selector that is no field.  Answers whether the path can be followed:
   a local root, and each step before a field a RECORD held by value --
   through a pointer the storage is not this frame's to follow *)
PROCEDURE RdKey (d: PTR Ast.Node ; VAR key: UTF ; VAR first: I64) : BOOL =
VAR
  i : I64 ;
  t, r : Ast.Kid ;
BEGIN
  key := d.au ;
  first := 0 ;
  IF NOT Text.Eq (ScopeMode (d.au), ModeLocal) THEN RETURN FALSE END ;
  t := ScopeType (d.au) ;
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME sl THEN
      IF sl.kind # Ast.NSelField THEN first := i ; RETURN TRUE END ;
      r := ResolveType (t) ;
      IF r IS SOME rn THEN
        IF rn.kind # Ast.NRecordType THEN RETURN FALSE END
      ELSE
        RETURN FALSE
      END ;
      key := Cat (Cat (key, '.'), sl.au) ;
      t := Ast.TypeAt (sl.id)
    END
  END ;
  first := d.nkids ;
  RETURN TRUE
END RdKey ;

(* every selector of d from index from on is a subscript *)
PROCEDURE RdAllIndexFrom (d: PTR Ast.Node ; from: I64) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := from TO d.nkids - 1 DO
    IF d.kids[i] IS SOME s THEN
      IF s.kind # Ast.NSelIndex THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END RdAllIndexFrom ;

(* a key no longer followed (the root's mode was checked by RdKey) *)
PROCEDURE RdDropKey (RO key: UTF) =
VAR i : I64 ;
BEGIN
  i := RdIndex (key) ;
  rdOk[i] := FALSE
END RdDropKey ;

(* what a designator handed on or iterated may change: its path's key,
   which drops every key under it at the judgement *)
PROCEDURE RdDropDesig (d: PTR Ast.Node) =
VAR key : UTF ; first : I64 ;
BEGIN
  IF RdKey (d, key, first) THEN RdDropKey (key) ELSE RdDrop (d.au) END
END RdDropDesig ;

(* is the key followed, and every shorter key it extends: `fl := ...'
   drops fl, and with it fl.rows *)
PROCEDURE RdFollowed (RO key: UTF) : BOOL =
VAR
  i, j : I64 ;
BEGIN
  i := NxFind (rdIx, key) ;
  IF i < 0 THEN RETURN FALSE END ;
  IF NOT rdOk[i] THEN RETURN FALSE END ;
  FOR j := Text.BLen (key) - 1 TO 1 BY -1 DO
    IF Text.BIs (key, j, '.') THEN
      i := NxFind (rdIx, SLICE (key, 0, j)) ;
      IF i >= 0 THEN
        IF NOT rdOk[i] THEN RETURN FALSE END
      END
    END
  END ;
  RETURN TRUE
END RdFollowed ;

(* a value of type t aliases storage that can be stored into later: a
   slice, grid or array whose elements hold references, or a reference *)
PROCEDURE RdNonLeaf (RO t: UTF) : BOOL =
VAR e : UTF ; i : I64 ;
BEGIN
  IF Text.BLen (t) = 0 THEN RETURN TRUE END ;
  IF Text.StartsWith (t, 'SLICE OF ') THEN
    RETURN RgBearing (SLICE (t, 9, Text.BLen (t) - 9))
  END ;
  IF Text.StartsWith (t, 'ARRAY ') OR Text.StartsWith (t, 'GRID ') THEN
    i := Text.Find (t, ' OF ') ;
    IF i < 0 THEN RETURN TRUE END ;
    e := SLICE (t, i + 4, Text.BLen (t) - i - 4) ;
    RETURN RgBearing (e)
  END ;
  RETURN RgBearing (t)
END RdNonLeaf ;

PROCEDURE RdAllIndex (d: PTR Ast.Node) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME s THEN
      IF s.kind # Ast.NSelIndex THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END RdAllIndex ;

PROCEDURE RdUses (KEPT k: Ast.Kid) ;

(* a designator READ: its subscripts are uses, and if what it answers
   aliases storage, its root is no longer followed precisely *)
PROCEDURE RdRead (KEPT d: PTR Ast.Node) =
VAR i, j : I64 ;
BEGIN
  FOR i := 0 TO d.nkids - 1 DO
    IF d.kids[i] IS SOME s THEN
      IF s.kind = Ast.NSelIndex THEN
        FOR j := 0 TO s.nkids - 1 DO RdUses (s.kids[j]) END
      END
    END
  END ;
  IF RdNonLeaf (Ast.TyStrAt (d.id)) THEN RdDropDesig (d) END
END RdRead ;

PROCEDURE RdArgs (cd: Ast.Kid ; KEPT al: Ast.Kid) =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  j : I64 ;
  pnm : UTF ;
  gk : Ast.Kid ;
  isLen : BOOL ;
BEGIN
  isLen := FALSE ;
  found := FALSE ;
  IF cd IS SOME c THEN
    IF c.kind = Ast.NDesignator THEN
      IF c.nkids = 0 AND Text.Eq (c.au, 'LEN') THEN isLen := TRUE
      ELSE pr := LookupProc (DesigName (c), found)
      END
    END
  END ;
  IF al IS SOME a THEN
    FOR j := 0 TO a.nkids - 1 DO
      IF a.kids[j] IS SOME ar THEN
        IF ar.kind = Ast.NDesignator AND NOT isLen THEN
          gk := NONE ;
          IF found AND RgParamAt (pr, j, pnm, gk) THEN
            IF gk IS SOME gg THEN
              IF gg.f1 OR gg.f2 THEN RdDropDesig (ar)     (* VAR or OWN: the callee may store *)
              ELSIF NOT gg.f3 THEN RdRead (ar)              (* a value parameter: an alias *)
              ELSE RdRead (ar)
              END
            ELSE
              RdDropDesig (ar)
            END
          ELSE
            RdDropDesig (ar)                               (* a callee not read: anything *)
          END
        ELSIF ar.kind = Ast.NDesignator THEN
          RdRead (ar)
        ELSE
          RdUses (a.kids[j])
        END
      END
    END
  END
END RdArgs ;

PROCEDURE RdUses (KEPT k: Ast.Kid) =
VAR
  i, first : I64 ;
  key : UTF ;
  followable : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN RdRead (e) ; RETURN END ;
    IF e.kind = Ast.NCallExpr OR e.kind = Ast.NCallStmt THEN
      RdArgs (e.kids[0], e.kids[1]) ;
      RETURN
    END ;
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator THEN
          followable := RdKey (lh, key, first) ;
          IF lh.nkids = 0 OR (followable AND first = lh.nkids) THEN
            (* a name or field path given a new value: only NEW keeps it
               followed *)
            IF e.kids[1] IS SOME rv THEN
              IF rv.kind # Ast.NNewExpr THEN
                IF followable THEN RdDropKey (key) ELSE RdDrop (lh.au) END
              END
            END
          ELSIF followable AND RdAllIndexFrom (lh, first) THEN
            (* an element store: recorded; its subscripts are uses *)
            IF nrs = LEN (rsX) THEN
              RdGrowStores ()
            END ;
            rsX[nrs] := RdIndex (key) ;
            rsK[nrs] := lh.nkids - first ;
            rsV[nrs] := e.kids[1] ;
            nrs := nrs + 1 ;
            FOR i := first TO lh.nkids - 1 DO
              IF lh.kids[i] IS SOME s THEN RdUses (s.kids[0]) END
            END ;
            (* the value: a bare name is the alias pair, anything else a use *)
            IF e.kids[1] IS SOME rv2 THEN
              IF rv2.kind = Ast.NDesignator AND rv2.nkids = 0 AND
                 Text.Eq (ScopeMode (rv2.au), ModeLocal) THEN
                i := RdIndex (rv2.au)
              ELSE
                RdUses (e.kids[1])
              END
            END ;
            RETURN
          ELSE
            IF followable THEN RdDropKey (key) ELSE RdDrop (lh.au) END ;
            FOR i := 0 TO lh.nkids - 1 DO
              IF lh.kids[i] IS SOME s2 THEN
                IF s2.kind = Ast.NSelIndex THEN RdUses (s2.kids[0]) END
              END
            END
          END
        END
      END ;
      RdUses (e.kids[1]) ;
      RETURN
    END ;
    (* a RETURN ends the procedure: what it answers aliases the name's
       storage in the CALLER, where nothing of this body writes through
       it -- so a returned name stays followed, only its subscripts are
       uses (oneflux's RoLent: `RETURN rows' dropped rows, and the
       flow-sensitive walk's one contents set judged rows[0][m-1] by
       what a row's elements might view; 2026-10-27) *)
    IF e.kind = Ast.NReturn AND e.nkids > 0 THEN
      IF e.kids[0] IS SOME rv THEN
        IF rv.kind = Ast.NDesignator THEN
          FOR i := 0 TO rv.nkids - 1 DO
            IF rv.kids[i] IS SOME rs THEN
              IF rs.kind = Ast.NSelIndex THEN RdUses (rs.kids[0]) END
            END
          END ;
          RETURN
        END
      END
    END ;
    (* a FOR IN copies its iterand's elements into the variable *)
    IF e.kind = Ast.NForIn THEN
      IF e.kids[0] IS SOME it THEN
        IF it.kind = Ast.NDesignator THEN RdDropDesig (it) END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO RdUses (e.kids[i]) END
  END
END RdUses ;

PROCEDURE RdGrowStores () =
VAR j : I64 ; nx, nk : SLICE OF I64 ; nv : SLICE OF AKid ;
BEGIN
  nx := NEW (pool, I64, 2 * nrs + 16) ;
  nk := NEW (pool, I64, 2 * nrs + 16) ;
  nv := NEW (pool, AKid, 2 * nrs + 16) ;
  FOR j := 0 TO nrs - 1 DO nx[j] := rsX[j] ; nk[j] := rsK[j] ; nv[j] := rsV[j] END ;
  rsX := nx ; rsK := nk ; rsV := nv
END RdGrowStores ;

(* the bits a stored value brings to depth k of its target *)
(* the depths in b moved by k, deeper for k > 0, shallower below 0;
   depths 0 to 40 *)
PROCEDURE RdShift (b, k: I64) : I64 =
VAR i, r : I64 ;
BEGIN
  r := 0 ;
  FOR i := 0 TO 40 DO
    IF RgHas (b, i) AND i + k >= 0 AND i + k <= 40 THEN r := RgOr (r, RgPow (i + k)) END
  END ;
  RETURN r
END RdShift ;

(* may the value's own storage be read-only *)
PROCEDURE RdOwnRo (v: Ast.Kid) : BOOL =
VAR pr : ProcInfo ; found : BOOL ;
BEGIN
  IF Text.BLen (RoWhatOf (v)) > 0 THEN RETURN TRUE END ;
  IF v IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME cd THEN
        IF cd.kind = Ast.NDesignator THEN
          pr := LookupProc (DesigName (cd), found) ;
          IF NOT found OR Text.BLen (pr.foreign) > 0 THEN RETURN TRUE END ;
          IF pr.node IS SOME pn THEN
            IF pn.f3 THEN RETURN TRUE END
          END ;
          RETURN AnswersRo (Qualify (pr.modName, pr.name), pr)
        END
      END ;
      RETURN TRUE
    END ;
    IF e.kind = Ast.NNewExpr OR (e.kind = Ast.NBin AND Text.Eq (e.au, '+')) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END RdOwnRo ;

PROCEDURE RdValBits (v: Ast.Kid ; k: I64) : I64 =
VAR i, j : I64 ;
BEGIN
  IF v IS SOME e THEN
    IF e.kind = Ast.NNewExpr THEN RETURN 0 END ;
    IF e.kind = Ast.NString THEN
      IF Text.BLen (e.au) = 0 THEN RETURN 0 END ;
      RETURN RgPow (k)
    END ;
    IF e.kind = Ast.NBin AND Text.Eq (e.au, '+') THEN RETURN 0 END ;   (* a concatenation is fresh *)
    IF e.kind = Ast.NInt OR e.kind = Ast.NReal OR e.kind = Ast.NChar OR
       e.kind = Ast.NTrue OR e.kind = Ast.NFalse THEN RETURN 0 END ;
    IF e.kind = Ast.NDesignator THEN
      i := NxFind (rdIx, e.au) ;
      IF i >= 0 AND rdOk[i] AND RdAllIndex (e) THEN
        IF e.nkids = 0 THEN
          (* the alias pair: what it holds, k deeper *)
          RETURN RdShift (rdBits[i], k)
        END ;
        (* a leaf read e.nkids deep: read-only where that depth is *)
        IF RgHas (rdBits[i], e.nkids) THEN RETURN RgPow (k) END ;
        RETURN 0
      END ;
      IF Text.BLen (RoWhatOf (v)) = 0 AND NOT RdNonLeaf (Ast.TyStrAt (e.id)) THEN
        (* a leaf value from a name not followed: read-only where its
           own storage may be *)
        RETURN RgPow (k)
      END
    END
  END ;
  (* anything else: read-only at every depth below this one, unknown;
     at this one only where the value's own storage may be -- a literal,
     a CONST, what an RO name views (RoWhatOf), or the answer of a
     function that may answer read-only storage (AnswersRo) -- since
     marking it always refused NbShow.Render's `cells[0][i] := ...' after
     `cells[c] := Cells (...)' *)
  j := 0 ;
  FOR i := k + 1 TO 40 DO j := RgOr (j, RgPow (i)) END ;
  IF RdOwnRo (v) THEN j := RgOr (j, RgPow (k)) END ;
  RETURN j
END RdValBits ;

PROCEDURE RdScan (KEPT body: Ast.Kid) =
VAR i, n, b, x, z, k : I64 ;
  changed : BOOL ;
BEGIN
  NxClear (rdIx) ;
  nrd := 0 ;
  nrs := 0 ;
  RdUses (body) ;
  n := 0 ;
  changed := TRUE ;
  WHILE changed AND n < 64 DO
    changed := FALSE ;
    n := n + 1 ;
    FOR i := 0 TO nrs - 1 DO
      x := rsX[i] ; k := rsK[i] ;
      b := RgOr (rdBits[x], RdValBits (rsV[i], k)) ;
      IF b # rdBits[x] THEN rdBits[x] := b ; changed := TRUE END ;
      (* the alias pair, the other way: what is stored through x at depth
         k and below lies in z's storage too *)
      IF rsV[i] IS SOME e THEN
        IF e.kind = Ast.NDesignator AND e.nkids = 0 THEN
          z := NxFind (rdIx, e.au) ;
          IF z >= 0 THEN
            b := RgOr (rdBits[z], RdShift (rdBits[x], -k)) ;
            IF b # rdBits[z] THEN rdBits[z] := b ; changed := TRUE END ;
            IF NOT rdOk[z] AND rdOk[x] THEN rdOk[x] := FALSE ; changed := TRUE END ;
            IF NOT rdOk[x] AND rdOk[z] THEN rdOk[z] := FALSE ; changed := TRUE END
          END
        END
      END
    END
  END ;
  (* a name whose value is unknown in any store: dropped *)
  IF changed THEN
    FOR i := 0 TO nrd - 1 DO rdOk[i] := FALSE END
  END
END RdScan ;

(* is a write through k subscripts of name nm judged by its depths, and
   then may depth k-1 be read-only? *)
PROCEDURE RdJudged (RO nm: UTF ; k: I64 ; VAR ro: BOOL) : BOOL =
VAR i : I64 ;
BEGIN
  IF NOT RdFollowed (nm) THEN RETURN FALSE END ;
  i := NxFind (rdIx, nm) ;
  ro := RgHas (rdBits[i], k - 1) ;
  RETURN TRUE
END RdJudged ;

PROCEDURE RgProc (d: PTR Ast.Node ; KEPT body: Ast.Kid ; RO ctx: UTF) =
VAR
  i, g, j, x : I64 ;
  st : SLICE OF I64 ;
  e2 : BOOL ;
BEGIN
  rgOverflow := FALSE ;
  rgCap := nscope + RgCount (body) + 8 ;
  rgNames := NEW (pool, UTF, rgCap) ;
  rgArg := NEW (pool, I64, rgCap) ;
  rgRef := NEW (pool, BOOL, rgCap) ;
  rgAlias := NEW (pool, I64, rgCap) ;
  FOR i := 0 TO rgCap - 1 DO rgAlias[i] := -1 END ;
  rgKept := NEW (pool, BOOL, RgArgMax) ;
  rgArgNames := NEW (pool, UTF, RgArgMax) ;
  rgN := 0 ;
  NxClear (rgIx) ;
  NxClear (rgFldIx) ;
  rgNArg := 0 ;
  rgCtx := Text.Keep (pool, ctx) ;
  rgInCaller := FALSE ;
  IF d.kids[1] IS SOME rt THEN
    rgInCaller := NOT StrTyIs (CanonT (d.kids[1], 0)) AND
                  RgBearing (CanonT (d.kids[1], 0))
  END ;
  st := NEW (I64, 2 * rgCap) ;
  IF d.kids[0] IS SOME pl THEN
    FOR g := 0 TO pl.nkids - 1 DO
      IF pl.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF ids.kids[j] IS SOME id THEN
              x := RgEnter (id.au, RgRefTy (grp.kids[1])) ;
              IF RgBearing (CanonT (grp.kids[1], 0)) AND (x < 0 OR rgNArg >= RgArgMax) THEN rgOverflow := TRUE END ;
              IF x >= 0 AND rgNArg < RgArgMax AND RgBearing (CanonT (grp.kids[1], 0)) THEN
                rgArg[x] := rgNArg ;
                rgKept[rgNArg] := grp.f4 ;
                rgArgNames[rgNArg] := Text.Keep (pool, id.au) ;
                st[x] := RgPow (RgArg0 + rgNArg) ;
                st[rgCap + x] := RgPow (RgArg0 + rgNArg) ;
                IF grp.f3 THEN st[x] := RgAdd (st[x], RgRo) END ;
                (* an OWN parameter is owned; a SHARED one is a counted
                   handle, and storing it is a share-copy, not a borrow *)
                IF grp.f2 OR Text.StartsWith (CanonT (grp.kids[1], 0), 'SHARED ') THEN
                  st[x] := RgPow (RgOwned) ;
                  st[rgCap + x] := RgPow (RgOwned)
                END ;
                rgNArg := rgNArg + 1
              END
            END
          END
        END
      END
    END
  END ;
  FOR i := 0 TO nscope - 1 DO
    IF Text.Eq (scope[i].mode, ModeLocal) THEN
      x := RgEnter (scope[i].name, RgRefTy (scope[i].ty))
    END
  END ;
  RdScan (body) ;
  e2 := RgSeq (body, st) ;
  IF rgOverflow THEN RgNote (d, 'internal', 'a name table full or a reference parameter past the 48th') END
EXCEPT
| IndexError (i, n) :
    RgNote (d, 'internal', Cat (Cat ('IndexError ', ItoA (i)), Cat (' of ', ItoA (n))))
END RgProc ;

(* ---- WHAT IS DERIVED FROM AN OWNED OBJECT LIVES AS LONG AS ITS OWNER
   (par 4.2; the third review's ownership advice, option (a); 2026-10-26).
   A move or a DISPOSE killed the owner's NAME and nothing derived from
   it: a view of a field, an allocation in the object's POOL field, a
   call's answer viewing it -- `c := ZarrStore.ReadChunk (a, co) ;
   ZarrStore.CloseArray (a) ; c[0]' read freed storage -- and a lend to a
   KEPT parameter outlived the object it pointed into.  A walk of its own,
   flow-sensitive like the region walk and run only where an owner is (a
   local or OWN parameter of an owned pointer or SHARED type).  Each owner
   has a bit; every name two sets, as the region walk's -- the owners whose
   storage its value may lie in, and what was stored into its components
   -- with OUTER, storage this activation did not make, and DEAD.  A
   DISPOSE, an OWN argument and a THREAD argument KILL an owner: its bit
   becomes DEAD wherever it is, and a read of a name holding DEAD is
   refused; a kill of an owner whose bit was stored where it outlives the
   activation -- a module variable, a KEPT argument, through OUTER storage,
   a THREAD -- is refused at the kill.  A move (`p := o', `h := SHARED
   (o)') renames the bit; each SHARED handle has its own, so a view taken
   through a surviving handle lives.  M9 side only, as the region walk ---- *)
CONST
  OlOuter = 60 ;
  OlDead = 61 ;
  OlMaxOwn = 60 ;

VAR
  olNames : SLICE OF UTF ;
  olDeadOf : SLICE OF UTF ;     (* per name: the kill its DEAD came from *)
  olDeadSeen : UTF ;            (* the kill of the last dead name read: a copy
                                   of it carries the text with the DEAD *)
  olN, olCap : I64 ;
  olOwn : SLICE OF UTF ;        (* the owners, by bit *)
  olNOwn : I64 ;
  olEscLine : SLICE OF I64 ;    (* per owner: where its storage first escaped *)
  olExit : SLICE OF I64 ;       (* the states an EXIT leaves the loop with *)
  olCtx : UTF ;
  olFull : BOOL ;
  olAnsView : I64 ;             (* OlArgs: what the answer views, by the summaries *)
  olPassOK : BOOL ;             (* OlAssign: an owner is given this call's answer *)
  olRetMask : I64 ;             (* the owners a RETURN so far may answer storage of *)
  olInFinally : I64 ;           (* inside a FINALLY: a kill there follows a RETURN *)
  olInBody : BOOL ;             (* walking the module body *)
  olAnyKill : BOOL ;            (* some owner was killed in this walk: only then
                                   can a module variable hold a dead view (the
                                   scan per call was calls times names, and
                                   scale's module-variable shape went past 6) *)
  olOwned : SLICE OF BOOL ;     (* per owner: it really owns an object -- an
                                   OWN parameter, a SHARED handle, NEW (OWN,
                                   T), SHARED (x), an owned call answer *)
  olPassName : UTF ;            (* OlArgs: the OWN argument the callee answers back *)

PROCEDURE OlFind (RO nm: UTF) : I64 =
BEGIN
  RETURN NxFind (olIx, nm)
END OlFind ;

(* does this right side give an owner a really owned object?  A pool
   allocation, and a call that takes a POOL or builds in the frame,
   answers storage some pool frees: a THREAD handed it does not take it,
   and a RETURN of it hands nothing over (IoPar's `j := NEW (pool, Job)',
   Parse's nodes) *)
PROCEDURE OlMakesOwn (k: Ast.Kid) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NSharedExpr THEN RETURN TRUE END ;
    IF e.kind = Ast.NNewExpr THEN
      IF e.kids[0] IS SOME d THEN
        IF d.kind = Ast.NDesignator AND d.nkids = 0 AND Text.Eq (d.au, 'OWN') THEN RETURN TRUE END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO
      IF OlMakesOwn (e.kids[i]) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END OlMakesOwn ;

PROCEDURE OlOwnedBy (k: Ast.Kid) : BOOL =
VAR
  pr : ProcInfo ;
  found : BOOL ;
  g : I64 ;
BEGIN
  IF k IS SOME r THEN
    IF r.kind = Ast.NParen THEN RETURN OlOwnedBy (r.kids[0]) END ;
    IF r.kind = Ast.NSomeExpr THEN RETURN OlOwnedBy (r.kids[0]) END ;
    IF r.kind = Ast.NSharedExpr THEN RETURN TRUE END ;
    IF r.kind = Ast.NNewExpr THEN
      IF r.kids[0] IS SOME d THEN
        RETURN d.kind = Ast.NDesignator AND d.nkids = 0 AND Text.Eq (d.au, 'OWN')
      END ;
      RETURN FALSE
    END ;
    IF r.kind = Ast.NCallExpr AND OwnFedBy (k) THEN
      IF r.kids[0] IS SOME dn THEN
        IF dn.kind = Ast.NDesignator THEN
          pr := LookupProc (DesigName (dn), found) ;
          IF found AND Text.BLen (pr.foreign) = 0 THEN
            IF AnswersFrame (Qualify (pr.modName, pr.name), pr) THEN RETURN FALSE END ;
            IF pr.node IS SOME pd THEN
              IF pd.kids[0] IS SOME pl THEN
                FOR g := 0 TO pl.nkids - 1 DO
                  IF pl.kids[g] IS SOME grp THEN
                    IF Text.Eq (RgCanonIn (pr, grp.kids[1]), 'POOL') THEN RETURN FALSE END
                  END
                END
              END
            END ;
            (* and the callee makes an owned object: a lookup answering a
               table's node (Gen.ScopeNode) owns nothing *)
            IF pr.body IS SOME pb THEN RETURN OlMakesOwn (pb.kids[4]) END ;
            RETURN FALSE
          END
        END
      END
    END
  END ;
  RETURN FALSE
END OlOwnedBy ;

PROCEDURE OlBit (RO nm: UTF) : I64 ;

PROCEDURE OlOwnedScan (k: Ast.Kid) =
VAR i, b : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NAssign THEN
      IF e.kids[0] IS SOME lh THEN
        IF lh.kind = Ast.NDesignator AND lh.nkids = 0 THEN
          b := OlBit (lh.au) ;
          IF b >= 0 THEN
            IF OlOwnedBy (e.kids[1]) THEN olOwned[b] := TRUE END ;
            (* a move of an owner that owns *)
            IF e.kids[1] IS SOME rv THEN
              IF rv.kind = Ast.NDesignator AND rv.nkids = 0 AND OlBit (rv.au) >= 0 THEN
                IF olOwned[OlBit (rv.au)] THEN olOwned[b] := TRUE END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO OlOwnedScan (e.kids[i]) END
  END
END OlOwnedScan ;

(* the SHARED handles known, on every path, to share an object: slot
   2 olCap + 1 + b holds the owners NOT known to share b's, so that the
   join (an OR) keeps what every path knows *)
PROCEDURE OlAll () : I64 =
BEGIN
  RETURN RgPow (OlOuter) - 1
END OlAll ;

PROCEDURE OlNc (b: I64) : I64 =
BEGIN
  RETURN 2 * olCap + 1 + b
END OlNc ;

(* b's relations forgotten: it holds another object now, or none *)
PROCEDURE OlUnshare (b: I64 ; st: SLICE OF I64) =
VAR c : I64 ;
BEGIN
  FOR c := 0 TO olNOwn - 1 DO st[OlNc (c)] := RgAdd (st[OlNc (c)], b) END ;
  st[OlNc (b)] := OlAll ()
END OlUnshare ;

(* a live handle known to share b's object, or -1 *)
PROCEDURE OlCopyOf (b: I64 ; st: SLICE OF I64) : I64 =
VAR c, k : I64 ;
BEGIN
  k := OlAll () - st[OlNc (b)] ;
  FOR c := 0 TO olNOwn - 1 DO
    IF c # b AND RgHas (k, c) THEN RETURN c END
  END ;
  RETURN -1
END OlCopyOf ;

PROCEDURE OlEnter (RO nm: UTF) : I64 =
VAR i : I64 ;
BEGIN
  i := NxFind (olIx, nm) ;
  IF i >= 0 THEN RETURN i END ;
  IF olN >= olCap THEN olFull := TRUE ; RETURN -1 END ;
  olNames[olN] := Text.Keep (pool, nm) ;
  NxAdd (olIx, olNames[olN], olN) ;
  olDeadOf[olN] := '' ;
  olN := olN + 1 ;
  RETURN olN - 1
END OlEnter ;

(* an owner of the walk: OwnedCandKind's, and an OPT over an owned PTR
   or a SHARED handle -- `o : OPT PTR T ; IF o IS SOME p THEN DISPOSE (o)
   ; p.n' read freed storage (the fourth review's C14b) *)
PROCEDURE OlOwnerKind (RO nm: UTF) : I64 =
VAR
  k : I64 ;
  mode : UTF ;
BEGIN
  k := OwnedCandKind (nm) ;
  IF k > 0 THEN RETURN k END ;
  mode := ScopeMode (nm) ;
  IF NOT Text.Eq (mode, ModeLocal) AND NOT Text.Eq (mode, ModeOwn) AND
     NOT (ownModule AND Text.Eq (mode, ModeModule)) THEN
    RETURN 0
  END ;
  IF ResolveType (ScopeType (nm)) IS SOME res THEN
    IF res.kind = Ast.NOptType THEN
      IF ResolveType (res.kids[0]) IS SOME inner THEN
        IF inner.kind = Ast.NPtrType THEN
          IF inner.kids[1] IS SOME inpool THEN RETURN 0 END ;
          RETURN 1
        END ;
        IF inner.kind = Ast.NSharedType THEN RETURN 2 END
      END
    END
  END ;
  RETURN 0
END OlOwnerKind ;

PROCEDURE OlBit (RO nm: UTF) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO olNOwn - 1 DO
    IF Text.Eq (olOwn[i], nm) THEN RETURN i END
  END ;
  RETURN -1
END OlBit ;

(* a read of x, or a write through it: refused when what it reaches died
   with its owner -- its value, and with deep its components' *)
PROCEDURE OlCheck (d: PTR Ast.Node ; x: I64 ; st: SLICE OF I64 ; deep: BOOL) =
BEGIN
  IF (RgHas (st[x], OlDead) OR (deep AND RgHas (st[olCap + x], OlDead))) AND
     NOT RgLineRefused (d.line) THEN
    ErrN (d, olCtx, S4 ('use of ', d.au, Cat (', which reaches storage of ', olDeadOf[x]),
      ' -- what is derived from an owned object lives as long as its owner (par 4.2, regions)'))
  END
END OlCheck ;

(* storage of the owners in m stored where it outlives this activation *)
PROCEDURE OlEscape (m, line: I64 ; st: SLICE OF I64) =
VAR b : I64 ;
BEGIN
  IF m MOD RgPow (OlOuter) = 0 THEN RETURN END ;
  FOR b := 0 TO olNOwn - 1 DO
    IF RgHas (m, b) THEN
      st[2 * olCap] := RgAdd (st[2 * olCap], b) ;
      IF olEscLine[b] = 0 THEN olEscLine[b] := line END
    END
  END
END OlEscape ;

(* the owner d names ends here: DISPOSE, an OWN argument, a THREAD *)
PROCEDURE OlRename (fb, tb: I64 ; st: SLICE OF I64) ;

PROCEDURE OlKillBit (b: I64 ; d: PTR Ast.Node ; RO nm, what: UTF ; st: SLICE OF I64) ;

(* Through a selector -- `Eat (b.p)', `DISPOSE (a[0])' -- the object
   killed is whatever an owner stored into the root's components put
   there: which component holds which owner is not followed, so every
   owner stored into any of them dies, and a copy taken from any of them
   (`r := b.p') is dead with it.  The par 4.2 refusal of the move itself
   is the other checker's (CheckArg); this keeps a copy of the field
   from outliving it on its own (2026-10-28) *)
PROCEDURE OlKill (d: PTR Ast.Node ; RO what: UTF ; st: SLICE OF I64) =
VAR b, x : I64 ;
BEGIN
  IF d.kind # Ast.NDesignator THEN RETURN END ;
  IF d.nkids > 0 THEN
    x := OlFind (d.au) ;
    IF x < 0 THEN RETURN END ;
    FOR b := 0 TO olNOwn - 1 DO
      IF RgHas (st[olCap + x], b) THEN OlKillBit (b, d, DesigName (d), what, st) END
    END ;
    RETURN
  END ;
  b := OlBit (d.au) ;
  IF b < 0 THEN RETURN END ;
  OlKillBit (b, d, d.au, what, st)
END OlKill ;

PROCEDURE OlKillBit (b: I64 ; d: PTR Ast.Node ; RO nm, what: UTF ; st: SLICE OF I64) =
VAR
  i, c : I64 ;
  why : UTF ;
BEGIN
  olAnyKill := TRUE ;
  (* a SHARED handle given up while another handle to its object lives:
     the object lives, and what was taken through this one lives with
     the other *)
  c := OlCopyOf (b, st) ;
  IF c >= 0 THEN
    OlRename (b, c, st) ;
    OlUnshare (b, st) ;
    RETURN
  END ;
  IF RgHas (st[2 * olCap], b) AND NOT RgLineRefused (d.line) THEN
    ErrN (d, olCtx, S4 (nm, Cat (Cat (' is ', what), ' here, and storage derived from it was kept at line '),
      ItoA (olEscLine[b]), ', where it outlives this activation -- what is derived from an owned object lives as long as its owner (par 4.2, regions)'))
  END ;
  (* in a FINALLY, after a RETURN that answered storage of this owner:
     `RETURN o.data FINALLY DISPOSE (o)' handed the caller freed storage
     (the fourth review's A02) *)
  IF olInFinally > 0 AND RgHas (olRetMask, b) AND NOT RgLineRefused (d.line) THEN
    ErrN (d, olCtx, S3 (nm, Cat (Cat (' is ', what), ' in a FINALLY, after a RETURN answered storage derived from it'),
      ' -- what is derived from an owned object lives as long as its owner (par 4.2, regions)'))
  END ;
  st[2 * olCap] := RgDel (st[2 * olCap], b) ;
  why := Text.Keep (pool, S4 (nm, ' after it was ', what, Cat (' at line ', ItoA (d.line)))) ;
  FOR i := 0 TO 2 * olCap - 1 DO
    IF RgHas (st[i], b) THEN
      st[i] := RgAdd (RgDel (st[i], b), OlDead) ;
      IF i < olCap THEN olDeadOf[i] := why ELSE olDeadOf[i - olCap] := why END
    END
  END ;
  OlUnshare (b, st)
END OlKillBit ;

(* an owner handed on -- to an OWN parameter or a THREAD -- takes what
   was stored into it along: the receiver may keep it, so it escapes
   (the fourth review's A15, D1) *)
PROCEDURE OlHandOn (d: PTR Ast.Node ; RO what: UTF ; st: SLICE OF I64) =
VAR x, b, m, c : I64 ;
BEGIN
  IF d.kind = Ast.NDesignator AND d.nkids = 0 THEN
    x := OlFind (d.au) ;
    b := OlBit (d.au) ;
    IF x >= 0 THEN
      m := st[olCap + x] ;
      IF b >= 0 THEN m := RgDel (m, b) END ;
      (* a SHARED handle copied into the object is a count of its own:
         the receiver keeps the shared object alive by it, so what the
         handle's other holders do ends nothing there (ZarrStore's Array
         holds its Store: CloseArray (a) then Close (st)) *)
      FOR c := 0 TO olNOwn - 1 DO
        IF RgHas (m, c) AND OlOwnerKind (olOwn[c]) = 2 THEN m := RgDel (m, c) END
      END ;
      OlEscape (m, d.line, st)
    END
  END ;
  OlKill (d, what, st)
END OlHandOn ;

(* an owner moved: what was derived from the one is derived from the other *)
PROCEDURE OlRename (fb, tb: I64 ; st: SLICE OF I64) =
VAR i : I64 ;
BEGIN
  IF fb < 0 OR tb < 0 OR fb = tb THEN RETURN END ;
  FOR i := 0 TO 2 * olCap DO
    IF RgHas (st[i], fb) THEN st[i] := RgAdd (RgDel (st[i], fb), tb) END
  END ;
  IF olEscLine[tb] = 0 THEN olEscLine[tb] := olEscLine[fb] END
END OlRename ;

(* x := s, two SHARED handles: x now shares s's object, and every handle
   known to share it *)
PROCEDURE OlShareWith (bx, by: I64 ; st: SLICE OF I64) =
VAR c, k : I64 ;
BEGIN
  OlUnshare (bx, st) ;
  k := RgAdd (OlAll () - st[OlNc (by)], by) ;
  FOR c := 0 TO olNOwn - 1 DO
    IF c # bx AND RgHas (k, c) THEN
      st[OlNc (c)] := RgDel (st[OlNc (c)], bx) ;
      st[OlNc (bx)] := RgDel (st[OlNc (bx)], c)
    END
  END
END OlShareWith ;

(* owner x, bit b, is given ANOTHER object.  What was taken from the old
   one stays with it: for a PTR, which nothing else can reach now, it
   lives on (a leak, which par 4.2 allows) and its bit is dropped; for a
   SHARED handle it goes to a handle known to share it, or keeps b,
   which can only refuse more *)
PROCEDURE OlNewObject (x, b: I64 ; st: SLICE OF I64) =
VAR i, c : I64 ;
BEGIN
  IF OlOwnerKind (olNames[x]) = 1 THEN
    FOR i := 0 TO 2 * olCap DO
      IF i # x AND i # olCap + x AND RgHas (st[i], b) THEN st[i] := RgDel (st[i], b) END
    END
  ELSE
    c := OlCopyOf (b, st) ;
    IF c >= 0 THEN OlRename (b, c, st) END
  END ;
  OlUnshare (b, st)
END OlNewObject ;

(* ---- may a callee's ANSWER reach what its argument j lends it?  A
   RETURN whose expression mentions parameter j, or a local or binder
   some assignment gave a value mentioning it, by a route that carries a
   reference: not through a scalar (LEN (s), s[i] of characters), a `+'
   (a fresh string), a conversion (UTF (x)), the extents of a NEW -- only
   its pool -- or a callee whose own answer does not reach that
   argument.  Text.Keep (pool, s) answers in pool and not in s; Pick (o,
   x) answering x does not answer o.  Memoised as `Mod.Proc#j'; a cycle
   and a callee without a body answer yes ---- *)
(* the return-flow memo, settled by rounds: a procedure in progress
   answers the previous round's value (no, at first) and the round is
   redone until no answer moves -- answering yes for a cycle made every
   procedure of Json's recursive parser a frame builder *)
PROCEDURE OlMemoLook (RO key: UTF ; VAR v: BOOL) : BOOL =
VAR m : I64 ;
BEGIN
  m := NxFind (olRetIx, key) ;
  IF m = 0 OR m = 1 THEN v := m = 1 ; RETURN TRUE END ;
  IF m = 2 THEN
    olLean := TRUE ;
    v := NxFind (olPrevIx, key) = 1 ;
    RETURN TRUE
  END ;
  RETURN FALSE
END OlMemoLook ;

PROCEDURE OlMemoBegin (RO KEPT key: UTF) =
VAR ns : SLICE OF UTF ; i : I64 ;
BEGIN
  NxSet (olRetIx, key, 2) ;
  IF nOlProv = LEN (olProv) THEN
    ns := NEW (pool, UTF, 2 * nOlProv + 32) ;
    FOR i := 0 TO nOlProv - 1 DO ns[i] := olProv[i] END ;
    olProv := ns
  END ;
  olProv[nOlProv] := key ;
  nOlProv := nOlProv + 1
END OlMemoBegin ;

(* after a round that read a busy entry: did any answer move?  If so the
   round's answers are cleared to be computed again *)
PROCEDURE OlMemoRound () : BOOL =
VAR
  i, cur, prev : I64 ;
  changed : BOOL ;
BEGIN
  changed := FALSE ;
  FOR i := 0 TO nOlProv - 1 DO
    cur := NxFind (olRetIx, olProv[i]) ;
    prev := NxFind (olPrevIx, olProv[i]) ;
    IF prev < 0 THEN prev := 0 END ;
    IF cur # prev THEN changed := TRUE ; NxSet (olPrevIx, olProv[i], cur) END
  END ;
  IF changed THEN
    FOR i := 0 TO nOlProv - 1 DO NxSet (olRetIx, olProv[i], 3) END
  END ;
  nOlProv := 0 ;
  RETURN changed
END OlMemoRound ;

PROCEDURE OlInSet (RO nm: UTF ; RO fs: SLICE OF UTF ; nf: I64) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nf - 1 DO
    IF Text.Eq (fs[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END OlInSet ;

(* a builtin whose answer holds no reference *)
PROCEDURE OlScalarFn (RO nm: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (nm), ScalarFns)
END OlScalarFn ;

(* seed 0: only the names in fs; 1: also storage built in the frame --
   a string `+', a frame-form NEW, UTF (x), a callee answering such; 2:
   also read-only storage -- a string literal, a callee answering one *)
PROCEDURE OlMentions (k: Ast.Kid ; RO mod: UTF ; RO fs: SLICE OF UTF ; nf: I64 ; seed: I64) : BOOL =
VAR
  i, a : I64 ;
  t, cn : UTF ;
  cp : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    t := Ast.TyStrAt (e.id) ;
    IF Text.BLen (t) > 0 AND NOT RgBearing (t) THEN RETURN FALSE END ;
    CASE e.kind OF
    | Ast.NString :
        RETURN seed >= 2 AND Text.BLen (e.au) > 0
    | Ast.NBin :
        IF seed = 1 AND Text.Eq (e.au, '+') THEN
          IF Text.BLen (t) > 0 THEN RETURN TRUE END ;
          RETURN NOT RgNumPlus (e)
        END ;
        RETURN FALSE
    | Ast.NNewExpr :
        IF seed = 1 AND NewIsFrameIn (e, mod) THEN RETURN TRUE END ;
        RETURN OlMentions (e.kids[0], mod, fs, nf, seed)
    | Ast.NDesignator :
        IF OlInSet (e.au, fs, nf) AND NOT (Text.BLen (t) = 0 AND RgScalarElem (e)) THEN RETURN TRUE END ;
        FOR i := 0 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME sk THEN
            IF sk.kind = Ast.NArgList THEN
              IF OlMentions (e.kids[i], mod, fs, nf, seed) THEN RETURN TRUE END
            END
          END
        END ;
        RETURN FALSE
    | Ast.NCallExpr :
        IF Text.Eq (UtfBuiltin (e), 'UTF') OR Text.Eq (UtfBuiltin (e), 'STR') THEN RETURN seed = 1 END ;
        IF e.kids[1] IS SOME al THEN
          IF Text.BLen (UtfInPool (e)) > 0 THEN RETURN OlMentions (al.kids[0], mod, fs, nf, seed) END ;
          IF e.kids[0] IS SOME dn THEN
            IF dn.kind = Ast.NDesignator THEN
              cn := DesigName (dn) ;
              IF dn.nkids = 0 AND OlScalarFn (cn) THEN RETURN FALSE END ;
              cp := ProcNamed (mod, cn, found) ;
              IF found AND Text.BLen (cp.foreign) = 0 THEN
                IF seed = 1 THEN
                  IF AnswersFrame (Qualify (cp.modName, cp.name), cp) OR OlRetFlow (cp, 1) THEN RETURN TRUE END
                ELSIF seed >= 2 THEN
                  IF OlRetFlow (cp, seed) THEN RETURN TRUE END
                END ;
                FOR a := 0 TO al.nkids - 1 DO
                  IF OlMentions (al.kids[a], mod, fs, nf, seed) THEN
                    IF OlRetReach (cp, a) THEN RETURN TRUE END
                  END
                END ;
                RETURN FALSE
              END
            END
          END ;
          FOR a := 0 TO al.nkids - 1 DO
            IF OlMentions (al.kids[a], mod, fs, nf, seed) THEN RETURN TRUE END
          END
        END ;
        RETURN FALSE
    ELSE
      FOR i := 0 TO e.nkids - 1 DO
        IF OlMentions (e.kids[i], mod, fs, nf, seed) THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END OlMentions ;

(* one pass over a body: names given a value that mentions the set join
   it; a RETURN that mentions it sets ret.  Answers whether the set grew *)
PROCEDURE OlRetWalk (k: Ast.Kid ; RO mod: UTF ; fs: SLICE OF UTF ; VAR nf: I64 ;
                     VAR ret: BOOL ; seed: I64) : BOOL =
VAR
  i, j : I64 ;
  grew : BOOL ;
BEGIN
  grew := FALSE ;
  IF k IS SOME s THEN
    IF s.kind = Ast.NAssign THEN
      IF s.kids[0] IS SOME lh THEN
        (* a store into a component carries too: `r.s := a + b ;
           RETURN r' answers the frame string in r -- but not for seed 3,
           where only the answer ITSELF being read-only counts: a list
           of views of an RO string (Text.Split) is a writable list --
           nor into an element the callee declares a scalar: whatever
           the right side names, `r[i] := s.at[i]' with r a SLICE OF I64
           stores a number (Seq.I64sOf, read untyped in another module,
           answered its argument's storage: cp-kernel's Series.Build) *)
        IF lh.kind = Ast.NDesignator AND (lh.nkids = 0 OR seed # 3) AND NOT OlInSet (lh.au, fs, nf)
           AND NOT RgScalarElem (lh) THEN
          IF OlMentions (s.kids[1], mod, fs, nf, seed) THEN
            IF nf < LEN (fs) THEN fs[nf] := Text.Keep (pool, lh.au) ; nf := nf + 1 ; grew := TRUE ELSE ret := TRUE END
          END
        END
      END
    ELSIF s.kind = Ast.NReturn THEN
      IF s.nkids > 0 THEN
        IF OlMentions (s.kids[0], mod, fs, nf, seed) THEN ret := TRUE END
      END
    ELSIF s.kind = Ast.NIs AND s.nkids > 1 THEN
      IF s.kids[1] IS SOME bs THEN
        IF bs.kind = Ast.NIsSome AND Text.BLen (bs.au) > 0 AND NOT OlInSet (bs.au, fs, nf) THEN
          IF OlMentions (s.kids[0], mod, fs, nf, seed) THEN
            IF nf < LEN (fs) THEN fs[nf] := Text.Keep (pool, bs.au) ; nf := nf + 1 ; grew := TRUE ELSE ret := TRUE END
          END
        END
      END
    ELSIF s.kind = Ast.NForIn AND NOT OlInSet (s.au, fs, nf) THEN
      IF OlMentions (s.kids[0], mod, fs, nf, seed) THEN
        IF nf < LEN (fs) THEN fs[nf] := Text.Keep (pool, s.au) ; nf := nf + 1 ; grew := TRUE ELSE ret := TRUE END
      END
    ELSIF s.kind = Ast.NCase THEN
      (* a pattern's binders reach what the selector does *)
      IF OlMentions (s.kids[0], mod, fs, nf, seed) THEN
        FOR i := 1 TO s.nkids - 1 DO
          IF s.kids[i] IS SOME arm THEN
            IF arm.kind = Ast.NCaseArm THEN
              IF arm.kids[0] IS SOME ll THEN
                FOR j := 0 TO ll.nkids - 1 DO
                  IF ll.kids[j] IS SOME lbl THEN
                    IF lbl.kind = Ast.NLabelPattern THEN
                      IF lbl.kids[0] IS SOME ids THEN
                        IF ids.nkids > 0 THEN ret := TRUE END
                      END
                    END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    FOR i := 0 TO s.nkids - 1 DO
      IF OlRetWalk (s.kids[i], mod, fs, nf, ret, seed) THEN grew := TRUE END
    END
  END ;
  RETURN grew
END OlRetWalk ;

PROCEDURE OlRetReach (pr: ProcInfo ; j: I64) : BOOL =
VAR
  key, nm, wasCm, wasCn : UTF ;
  nf, n : I64 ;
  fs : SLICE OF UTF ;
  ret : BOOL ;
BEGIN
  (* an answer that holds no reference reaches nothing *)
  IF OlResultTy (pr) IS SOME rt0 THEN
    IF NOT RgBearing (RgCanonIn (pr, OlResultTy (pr))) THEN RETURN FALSE END
  ELSE
    RETURN FALSE
  END ;
  IF pr.body IS SOME bd THEN
    key := Text.Keep (pool, Cat (Qualify (pr.modName, pr.name), Cat ('#', ItoA (j)))) ;
    IF OlMemoLook (key, ret) THEN RETURN ret END ;
    IF olDepth = 0 THEN
      (* the outermost question: rounds until the answers settle *)
      n := 0 ;
      LOOP
        olLean := FALSE ;
        olDepth := 1 ;
        ret := OlRetReach (pr, j) ;
        olDepth := 0 ;
        n := n + 1 ;
        IF NOT olLean OR n > 32 THEN EXIT END ;
        IF NOT OlMemoRound () THEN EXIT END
      END ;
      nOlProv := 0 ;
      RETURN ret
    END ;
    OlMemoBegin (key) ;
    nm := ParamNameAt (bd, j) ;
    ret := Text.BLen (nm) = 0 ;
    IF NOT ret THEN
      fs := NEW (UTF, 256) ;
      fs[0] := Text.Keep (pool, nm) ;
      nf := 1 ;
      n := 0 ;
      wasCm := rgCompMod ;
      wasCn := rgCompName ;
      rgCompMod := Text.Keep (pool, pr.modName) ;
      rgCompName := Text.Keep (pool, pr.name) ;
      LOOP
        n := n + 1 ;
        IF NOT OlRetWalk (bd.kids[4], pr.modName, fs, nf, ret, 0) OR ret THEN EXIT END ;
        IF n > 64 THEN ret := TRUE ; EXIT END
      END ;
      rgCompMod := wasCm ;
      rgCompName := wasCn
    END ;
    IF ret THEN NxSet (olRetIx, key, 1) ELSE NxSet (olRetIx, key, 0) END ;
    RETURN ret
  END ;
  RETURN TRUE
END OlRetReach ;

(* may a callee's answer reach storage built in its frame (seed 1) or
   read-only storage (seed 2), through any chain of locals -- the
   summaries' depth caps answered no past four copies (the fourth
   review's Dframe5 and Dro1), and RgCompOf did not follow a local, a
   further callee or a parenthesis (CompVia, CompLocal, RoVia).  The
   read-only seed starts from the RO parameters as well.  Memoised as
   `Mod.Proc#f' and `#l'; a cycle answers yes; a callee without a body
   answers no for a frame (it builds in no frame of ours) and no for a
   literal *)
PROCEDURE OlRetFlow (pr: ProcInfo ; seed: I64) : BOOL =
VAR
  key, wasCm, wasCn : UTF ;
  nf, n, g, b : I64 ;
  fs : SLICE OF UTF ;
  ret : BOOL ;
BEGIN
  IF OlResultTy (pr) IS SOME rt0 THEN
    IF NOT RgBearing (RgCanonIn (pr, OlResultTy (pr))) THEN RETURN FALSE END
  ELSE
    RETURN FALSE
  END ;
  IF pr.body IS SOME bd THEN
    IF seed = 1 THEN
      key := Text.Keep (pool, Cat (Qualify (pr.modName, pr.name), '#f'))
    ELSIF seed = 2 THEN
      key := Text.Keep (pool, Cat (Qualify (pr.modName, pr.name), '#l'))
    ELSE
      key := Text.Keep (pool, Cat (Qualify (pr.modName, pr.name), '#v'))
    END ;
    IF OlMemoLook (key, ret) THEN RETURN ret END ;
    IF olDepth = 0 THEN
      n := 0 ;
      LOOP
        olLean := FALSE ;
        olDepth := 1 ;
        ret := OlRetFlow (pr, seed) ;
        olDepth := 0 ;
        n := n + 1 ;
        IF NOT olLean OR n > 32 THEN EXIT END ;
        IF NOT OlMemoRound () THEN EXIT END
      END ;
      nOlProv := 0 ;
      RETURN ret
    END ;
    OlMemoBegin (key) ;
    fs := NEW (UTF, 256) ;
    nf := 0 ;
    IF seed >= 2 THEN
      IF bd.kids[0] IS SOME ps THEN
        FOR g := 0 TO ps.nkids - 1 DO
          IF ps.kids[g] IS SOME grp THEN
            IF grp.f3 THEN
              IF grp.kids[0] IS SOME ids THEN
                FOR b := 0 TO ids.nkids - 1 DO
                  IF ids.kids[b] IS SOME id THEN
                    IF nf < LEN (fs) THEN fs[nf] := Text.Keep (pool, id.au) ; nf := nf + 1 END
                  END
                END
              END
            END
          END
        END
      END
    END ;
    (* RgNumPlus reads the callee's own declarations *)
    wasCm := rgCompMod ;
    wasCn := rgCompName ;
    rgCompMod := Text.Keep (pool, pr.modName) ;
    rgCompName := Text.Keep (pool, pr.name) ;
    ret := FALSE ;
    n := 0 ;
    LOOP
      n := n + 1 ;
      IF NOT OlRetWalk (bd.kids[4], pr.modName, fs, nf, ret, seed) OR ret THEN EXIT END ;
      IF n > 64 THEN ret := TRUE ; EXIT END
    END ;
    rgCompMod := wasCm ;
    rgCompName := wasCn ;
    IF ret THEN NxSet (olRetIx, key, 1) ELSE NxSet (olRetIx, key, 0) END ;
    RETURN ret
  END ;
  RETURN FALSE
END OlRetFlow ;

(* the callee neither disposes nor hands on its parameter nm -- no
   DISPOSE of it, no THREAD of it, no call it is an argument of *)
PROCEDURE OlKeepsWhole (k: Ast.Kid ; RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME s THEN
    IF s.kind = Ast.NDispose OR s.kind = Ast.NThread OR s.kind = Ast.NCallExpr OR
       s.kind = Ast.NCallStmt THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME a THEN
          IF a.kind = Ast.NDesignator AND a.nkids = 0 AND Text.Eq (a.au, nm) THEN RETURN FALSE END ;
          IF a.kind = Ast.NArgList THEN
            IF NOT OlKeepsWhole (s.kids[i], nm) THEN RETURN FALSE END
          END
        END
      END
    END ;
    IF s.kind = Ast.NArgList THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME b THEN
          IF b.kind = Ast.NDesignator AND b.nkids = 0 AND Text.Eq (b.au, nm) THEN RETURN FALSE END
        END
      END
    END ;
    FOR i := 0 TO s.nkids - 1 DO
      IF NOT OlKeepsWhole (s.kids[i], nm) THEN RETURN FALSE END
    END
  END ;
  RETURN TRUE
END OlKeepsWhole ;

(* the callee answers its OWN parameter j back untouched: `q := Pass
   (o)' moves o into q *)
PROCEDURE OlPassesBack (pr: ProcInfo ; j: I64) : BOOL =
BEGIN
  IF NOT OlRetReach (pr, j) THEN RETURN FALSE END ;
  IF pr.body IS SOME bd THEN RETURN OlKeepsWhole (bd.kids[4], ParamNameAt (bd, j)) END ;
  RETURN FALSE
END OlPassesBack ;

PROCEDURE OlExpr (k: Ast.Kid ; st: SLICE OF I64) : I64 ;
PROCEDURE OlExpr0 (k: Ast.Kid ; st: SLICE OF I64) : I64 ;

(* a SHARED handle stored bare (or as SOME of one) is a share-copy, a
   count of its own: its bit, when k is one, else -1 *)
PROCEDURE OlShareBit (k: Ast.Kid) : I64 =
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NParen OR e.kind = Ast.NSomeExpr THEN RETURN OlShareBit (e.kids[0]) END ;
    IF e.kind = Ast.NDesignator AND e.nkids = 0 AND OlOwnerKind (e.au) = 2 THEN
      RETURN OlBit (e.au)
    END
  END ;
  RETURN -1
END OlShareBit ;

(* a value and what its components hold *)
PROCEDURE OlDeep (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR x, r : I64 ;
BEGIN
  r := OlExpr (k, st) ;
  IF k IS SOME d THEN
    IF d.kind = Ast.NDesignator AND d.nkids = 0 THEN
      x := OlFind (d.au) ;
      IF x >= 0 THEN r := RgOr (r, st[olCap + x]) END
    END
  END ;
  RETURN r
END OlDeep ;

(* a store of a value reaching m, its components mc, into lh: a bare
   name's sets replaced (or, for a hand-back, added to), a component's
   added to; storage that outlives the activation is an escape *)
PROCEDURE OlStore (lh: PTR Ast.Node ; m, mc: I64 ; replace: BOOL ; st: SLICE OF I64) =
VAR
  x, b : I64 ;
BEGIN
  x := OlFind (lh.au) ;
  IF x < 0 THEN
    (* a module variable, an exported one *)
    OlEscape (RgOr (m, mc), lh.line, st) ;
    RETURN
  END ;
  IF lh.nkids = 0 THEN
    IF Text.Eq (ScopeMode (lh.au), ModeVar) THEN OlEscape (RgOr (m, mc), lh.line, st) END ;
    IF replace THEN
      b := OlBit (lh.au) ;
      (* a value that holds the owner's own bit may BE its object --
         `a1 := Id (a1)', `o1 := o1' -- and is not another one: the old
         object's escapes stay with the bit, or `KEEP a1' then `a1 := Id
         (a1) ; DISPOSE (a1)' freed what the module variable held (found
         by the ownership fuzzer, 2026-10-28) *)
      IF b >= 0 AND NOT RgHas (m, b) THEN OlNewObject (x, b, st) END ;
      IF b >= 0 THEN st[x] := RgAdd (RgDel (m, OlDead), b) ELSE st[x] := m END ;
      st[olCap + x] := mc
    ELSE
      st[x] := RgOr (st[x], m) ;
      st[olCap + x] := RgOr (st[olCap + x], mc)
    END
  ELSE
    IF RgHas (st[x], OlOuter) THEN OlEscape (RgOr (m, mc), lh.line, st) END ;
    st[olCap + x] := RgOr (st[olCap + x], RgOr (m, mc))
  END ;
  (* a dead value stored: the kill's text goes with it, or the next use
     of lh named an empty owner (`reaches storage of  --', since the
     owner walk's first day) *)
  IF RgHas (RgOr (m, mc), OlDead) AND Text.BLen (olDeadOf[x]) = 0 THEN
    olDeadOf[x] := olDeadSeen
  END
END OlStore ;

(* a call's arguments by its callee's modes, and its answer: what the
   arguments the callee views reach *)
PROCEDURE OlArgs (e: PTR Ast.Node ; pr: ProcInfo ; st: SLICE OF I64) : I64 =
VAR
  g, j, k, n, r, m, sb : I64 ;
  ms : SLICE OF I64 ;
  isVar, isOwn, isKept : SLICE OF BOOL ;
  q : UTF ;
  pass : BOOL ;
BEGIN
  r := 0 ;
  pass := olPassOK ;
  olPassOK := FALSE ;
  (* in the module body, a procedure of this module may read any module
     variable: one that reaches dead storage is a use *)
  IF olInBody AND olAnyKill AND Text.Eq (pr.modName, curMod) THEN
    FOR k := 0 TO olN - 1 DO
      IF Text.Eq (ScopeMode (olNames[k]), ModeModule) AND OlBit (olNames[k]) < 0 AND
         (RgHas (st[k], OlDead) OR RgHas (st[olCap + k], OlDead)) AND NOT RgLineRefused (e.line) THEN
        ErrN (e, olCtx, S4 (pr.name, Cat (' may read module variable ', olNames[k]),
          Cat (', which reaches storage of ', olDeadOf[k]),
          ' -- what is derived from an owned object lives as long as its owner (par 4.2, regions)'))
      END
    END
  END ;
  IF e.kids[1] IS SOME a THEN
    n := a.nkids ;
    ms := NEW (I64, n + 1) ;
    isVar := NEW (BOOL, n + 1) ;
    isOwn := NEW (BOOL, n + 1) ;
    isKept := NEW (BOOL, n + 1) ;
    k := 0 ;
    IF pr.node IS SOME pd THEN
      IF pd.kids[0] IS SOME pl THEN
        FOR g := 0 TO pl.nkids - 1 DO
          IF pl.kids[g] IS SOME grp THEN
            IF grp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF k < n THEN
                  isVar[k] := grp.f1 ; isOwn[k] := grp.f2 ; isKept[k] := grp.f4
                END ;
                k := k + 1
              END
            END
          END
        END
      END
    END ;
    FOR k := 0 TO n - 1 DO
      (* a POOL argument, `o.pool': what NEW in it would be *)
      ms[k] := OlExpr (a.kids[k], st) ;
      IF a.kids[k] IS SOME ak THEN
        IF Text.Eq (Ast.TyStrAt (ak.id), 'POOL') THEN ms[k] := OlExpr0 (a.kids[k], st) END
      END
    END ;
    q := Qualify (pr.modName, pr.name) ;
    FOR k := 0 TO n - 1 DO
      IF ms[k] # 0 THEN
        IF AnswersViewAt (q, pr, k) THEN r := RgOr (r, RgOr (ms[k], OlDeep (a.kids[k], st))) END
      END
    END ;
    IF AnswersBorrowAny (q, pr) THEN
      FOR k := 0 TO n - 1 DO r := RgOr (r, RgOr (ms[k], OlDeep (a.kids[k], st))) END
    END ;
    olAnsView := r ;
    (* an answer the callee did not build here may lie in any argument's
       storage: the summaries do not see `p := GetChunk (a, c) ; RETURN
       SLICE (p.buf, ...)', ZarrStore.ReadChunk's view of its Array *)
    IF NOT AnswersFrame (q, pr) AND NOT Text.Eq (pr.attrib, 'FRESH') THEN
      FOR k := 0 TO n - 1 DO
        IF ms[k] # 0 THEN
          IF OlRetReach (pr, k) THEN r := RgOr (r, RgOr (ms[k], OlDeep (a.kids[k], st))) END
        END
      END
    END ;
    (* what the callee hands back into a VAR argument *)
    FOR k := 0 TO n - 1 DO
      IF isVar[k] THEN
        IF a.kids[k] IS SOME dst THEN
          IF dst.kind = Ast.NDesignator THEN
            FOR j := 0 TO n - 1 DO
              IF j # k AND ms[j] # 0 THEN
                IF HandsBackFrom (q, pr, k, j) THEN
                  OlStore (dst, ms[j], OlDeep (a.kids[j], st), FALSE, st)
                END
              END
            END
          END
        END
      END
    END ;
    FOR k := 0 TO n - 1 DO
      IF isKept[k] THEN
        IF a.kids[k] IS SOME ka THEN
          m := OlDeep (a.kids[k], st) ;
          sb := OlShareBit (a.kids[k]) ;
          IF sb >= 0 THEN m := RgDel (m, sb) END ;
          OlEscape (m, ka.line, st)
        END
      END
    END ;
    FOR k := 0 TO n - 1 DO
      IF isOwn[k] THEN
        IF a.kids[k] IS SOME oa THEN
          IF pass AND oa.kind = Ast.NDesignator AND oa.nkids = 0 AND OlBit (oa.au) >= 0 AND
             OlPassesBack (pr, k) THEN
            olPassName := Text.Keep (pool, oa.au)
          ELSE
            OlHandOn (oa, 'moved into an OWN parameter', st)
          END
        END
      END
    END
  END ;
  RETURN r
END OlArgs ;

(* a call through a procedure value: a VAR argument may be given what any
   argument reaches, an OWN argument is handed on *)
PROCEDURE OlValueArgs (pt: PTR Ast.Node ; al: PTR Ast.Node ; all: I64 ; st: SLICE OF I64) =
VAR g, j, k : I64 ;
BEGIN
  k := 0 ;
  IF pt.kids[0] IS SOME pl THEN
    FOR g := 0 TO pl.nkids - 1 DO
      IF pl.kids[g] IS SOME grp THEN
        IF grp.kids[0] IS SOME ids THEN
          FOR j := 0 TO ids.nkids - 1 DO
            IF k < al.nkids THEN
              IF al.kids[k] IS SOME a THEN
                IF a.kind = Ast.NDesignator THEN
                  IF grp.f2 THEN OlHandOn (a, 'moved into an OWN parameter', st)
                  ELSIF grp.f1 THEN OlStore (a, all, all, FALSE, st) END
                END
              END
            END ;
            k := k + 1
          END
        END
      END
    END
  END
END OlValueArgs ;

PROCEDURE OlCall (e: PTR Ast.Node ; st: SLICE OF I64) : I64 =
VAR
  r, i, x0 : I64 ;
  pr : ProcInfo ;
  found : BOOL ;
  om, canon : UTF ;
BEGIN
  olAnsView := 0 ;
  IF Text.Eq (UtfBuiltin (e), 'UTF') OR Text.Eq (UtfBuiltin (e), 'STR') THEN
    IF e.kids[1] IS SOME ual THEN x0 := OlExpr (ual.kids[0], st) END ;
    RETURN 0
  END ;
  IF OctetsArg (e) IS SOME roa THEN RETURN OlExpr (SOME (roa), st) END ;
  (* UTF (o.pool, x): in the object's pool *)
  IF Text.BLen (UtfInPool (e)) > 0 THEN
    r := 0 ;
    IF e.kids[1] IS SOME upl THEN
      x0 := OlExpr (upl.kids[1], st) ;
      r := OlExpr0 (upl.kids[0], st)
    END ;
    RETURN r
  END ;
  IF e.kids[0] IS SOME dn THEN
    IF dn.kind = Ast.NDesignator THEN
      IF RecordNamed (DesigName (dn), om, canon) IS SOME rec THEN
        r := 0 ;
        IF e.kids[1] IS SOME al THEN
          FOR i := 0 TO al.nkids - 1 DO r := RgOr (r, OlDeep (al.kids[i], st)) END
        END ;
        RETURN r
      END ;
      pr := LookupProc (DesigName (dn), found) ;
      IF found AND Text.BLen (pr.foreign) = 0 AND ScopeFind (dn.au) < 0 THEN
        RETURN OlArgs (e, pr, st)
      END
    END
  END ;
  (* a procedure value, a foreign procedure: any argument, and a value's
     VAR and OWN parameters by its type (the fourth review's A03, A08) *)
  r := 0 ;
  IF e.kids[1] IS SOME al3 THEN
    FOR i := 0 TO al3.nkids - 1 DO r := RgOr (r, OlDeep (al3.kids[i], st)) END ;
    IF e.kids[0] IS SOME dv THEN
      IF dv.kind = Ast.NDesignator AND dv.nkids = 0 AND ScopeFind (dv.au) >= 0 THEN
        IF ResolveType (ScopeType (dv.au)) IS SOME pt THEN
          IF pt.kind = Ast.NProcType THEN OlValueArgs (pt, al3, r, st) END
        END
      END
    END
  END ;
  RETURN r
END OlCall ;

(* a value whose type holds no reference reaches nothing *)
PROCEDURE OlExpr (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR
  r : I64 ;
  t : UTF ;
BEGIN
  r := OlExpr0 (k, st) ;
  IF k IS SOME e THEN
    t := Ast.TyStrAt (e.id) ;
    IF Text.BLen (t) > 0 AND NOT RgBearing (t) THEN RETURN 0 END
  END ;
  RETURN r
END OlExpr ;

PROCEDURE OlExpr0 (k: Ast.Kid ; st: SLICE OF I64) : I64 =
VAR
  x, r, i : I64 ;
  md : UTF ;
BEGIN
  IF k IS SOME e THEN
    CASE e.kind OF
    | Ast.NString :
        RETURN 0
    | Ast.NParen, Ast.NSomeExpr, Ast.NSliceOf3, Ast.NGridOf, Ast.NSharedExpr :
        r := OlExpr (e.kids[0], st) ;
        FOR i := 1 TO e.nkids - 1 DO x := OlExpr (e.kids[i], st) END ;
        (* SHARED through a selector takes what the root's components
           hold, as OlKill reads a move through one; the handle keeps r *)
        IF e.kind = Ast.NSharedExpr THEN
          IF ParenCore (e.kids[0]) IS SOME shd THEN
            IF shd.kind = Ast.NDesignator AND shd.nkids > 0 THEN
              OlKill (shd, 'consumed by SHARED', st)
            END
          END
        END ;
        RETURN r
    | Ast.NBin :
        x := OlExpr (e.kids[0], st) ;
        x := OlExpr (e.kids[1], st) ;
        RETURN 0
    | Ast.NNewExpr :
        (* NEW (o.pool, T): in the object's pool *)
        IF e.kids[0] IS SOME d0 THEN
          IF d0.kind = Ast.NDesignator AND NOT Text.Eq (d0.au, 'OWN') THEN
            IF OlFind (d0.au) >= 0 THEN RETURN OlExpr0 (e.kids[0], st) END
          END
        END ;
        RETURN 0
    | Ast.NCallExpr :
        RETURN OlCall (e, st)
    | Ast.NCallSel :
        FOR i := 1 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME cs THEN
            IF cs.kind = Ast.NSelIndex THEN x := OlExpr (cs.kids[0], st) END
          END
        END ;
        RETURN OlExpr0 (e.kids[0], st)
    | Ast.NDesignator :
        IF Text.Eq (e.au, 'VIEW') AND e.nkids > 0 THEN
          IF e.kids[0] IS SOME vs THEN
            IF vs.kind = Ast.NArgList AND vs.nkids > 0 THEN
              FOR i := 1 TO vs.nkids - 1 DO x := OlExpr (vs.kids[i], st) END ;
              RETURN OlDeep (vs.kids[0], st)
            END
          END
        END ;
        FOR i := 0 TO e.nkids - 1 DO
          IF e.kids[i] IS SOME sel THEN
            IF sel.kind = Ast.NSelIndex THEN x := OlExpr (sel.kids[0], st) END
          END
        END ;
        x := OlFind (e.au) ;
        IF x >= 0 THEN
          OlCheck (e, x, st, TRUE) ;
          IF RgHas (RgOr (st[x], st[olCap + x]), OlDead) AND Text.BLen (olDeadOf[x]) > 0 THEN
            olDeadSeen := olDeadOf[x]
          END ;
          IF e.nkids = 0 THEN RETURN st[x] END ;
          (* a component: where the object lies, and what was put in it *)
          RETURN RgOr (st[x], st[olCap + x])
        END ;
        md := ScopeMode (e.au) ;
        IF Text.Eq (md, ModeModule) THEN RETURN RgPow (OlOuter) END ;
        RETURN 0
    ELSE
      FOR i := 0 TO e.nkids - 1 DO x := OlExpr (e.kids[i], st) END ;
      RETURN 0
    END
  END ;
  RETURN 0
END OlExpr0 ;

(* an assignment: a bare name copied gives its sets; an owner moved, or
   made SHARED, has its bit renamed; a SHARED handle copied counts apart *)
PROCEDURE OlAssign (s: PTR Ast.Node ; lh: PTR Ast.Node ; st: SLICE OF I64) =
VAR
  m, mc, x, y, bx, by, i : I64 ;
  src : UTF ;
  rename : BOOL ;
BEGIN
  FOR i := 0 TO lh.nkids - 1 DO
    IF lh.kids[i] IS SOME sel THEN
      IF sel.kind = Ast.NSelIndex THEN m := OlExpr (sel.kids[0], st) END
    END
  END ;
  x := OlFind (lh.au) ;
  IF x >= 0 AND lh.nkids > 0 THEN OlCheck (lh, x, st, lh.nkids > 1) END ;
  olPassName := '' ;
  olPassOK := FALSE ;
  IF x >= 0 AND lh.nkids = 0 AND OlBit (lh.au) >= 0 THEN
    IF s.kids[1] IS SOME rc0 THEN olPassOK := rc0.kind = Ast.NCallExpr END
  END ;
  m := OlExpr (s.kids[1], st) ;
  olPassOK := FALSE ;
  mc := m ;
  (* `q := Pass (o)', Pass answering its OWN parameter back: a move *)
  IF Text.BLen (olPassName) > 0 THEN
    y := OlFind (olPassName) ;
    by := OlBit (olPassName) ;
    bx := OlBit (lh.au) ;
    IF y >= 0 AND by >= 0 AND bx >= 0 AND y # x THEN
      OlRename (by, bx, st) ;
      st[x] := st[y] ;
      st[olCap + x] := st[olCap + y] ;
      RETURN
    END
  END ;
  src := '' ;
  rename := FALSE ;
  IF s.kids[1] IS SOME rv THEN
    IF rv.kind = Ast.NDesignator AND rv.nkids = 0 THEN
      src := rv.au
    ELSIF rv.kind = Ast.NSharedExpr THEN
      IF rv.kids[0] IS SOME sv THEN
        IF sv.kind = Ast.NDesignator AND sv.nkids = 0 THEN src := sv.au ; rename := TRUE END
      END
    END
  END ;
  y := -1 ;
  IF Text.BLen (src) > 0 THEN y := OlFind (src) END ;
  IF y >= 0 AND x >= 0 AND x # y AND lh.nkids = 0 THEN
    bx := OlBit (lh.au) ;
    by := OlBit (src) ;
    IF bx >= 0 AND by >= 0 AND (rename OR OlOwnerKind (src) = 1) THEN
      OlRename (by, bx, st) ;
      st[x] := st[y] ;
      st[olCap + x] := st[olCap + y] ;
      RETURN
    END ;
    IF bx >= 0 AND by >= 0 THEN
      (* a SHARED handle copied: what the object holds lives as long as
         this handle too *)
      st[x] := RgAdd (RgDel (st[y], by), bx) ;
      st[olCap + x] := st[olCap + y] ;
      IF RgHas (st[olCap + x], by) THEN st[olCap + x] := RgAdd (RgDel (st[olCap + x], by), bx) END ;
      OlShareWith (bx, by, st) ;
      RETURN
    END ;
    mc := st[olCap + y]
  END ;
  (* an owner given a call's owned answer: an object of its own, holding
     what the summaries say the callee put in it *)
  IF x >= 0 AND lh.nkids = 0 AND OlBit (lh.au) >= 0 THEN
    IF s.kids[1] IS SOME rc THEN
      IF rc.kind = Ast.NCallExpr AND OwnFedBy (s.kids[1]) THEN
        OlNewObject (x, OlBit (lh.au), st) ;
        st[x] := RgPow (OlBit (lh.au)) ;
        st[olCap + x] := RgDel (olAnsView, OlDead) ;
        RETURN
      END
    END
  END ;
  by := OlShareBit (s.kids[1]) ;
  IF by >= 0 THEN m := RgDel (m, by) ; mc := RgDel (mc, by) END ;
  OlStore (lh, m, mc, TRUE, st)
END OlAssign ;

PROCEDURE OlSeq (k: Ast.Kid ; st: SLICE OF I64) : BOOL ;

(* `x IS SOME p': p is given what x reaches *)
PROCEDURE OlCond (c: Ast.Kid ; src: SLICE OF I64 ; dst: SLICE OF I64) =
VAR x, v : I64 ;
BEGIN
  IF c IS SOME c0 THEN
    IF c0.kind = Ast.NIs AND c0.nkids > 1 THEN
      IF c0.kids[1] IS SOME bs THEN
        IF bs.kind = Ast.NIsSome AND Text.BLen (bs.au) > 0 THEN
          v := OlDeep (c0.kids[0], src) ;
          x := OlEnter (bs.au) ;
          IF x >= 0 THEN dst[x] := v ; dst[olCap + x] := RgDel (v, OlOuter) END
        ELSE
          v := OlExpr (c0.kids[0], src)
        END
      END
    ELSE
      v := OlExpr (c, src)
    END
  END
END OlCond ;

(* a loop's body to its fixpoint, the condition's binder taken again at
   the top of every pass, and every EXIT's state joined after it *)
PROCEDURE OlLoop (cond: Ast.Kid ; body: Ast.Kid ; st: SLICE OF I64) =
VAR
  b, saved : SLICE OF I64 ;
  n : I64 ;
  e2 : BOOL ;
BEGIN
  saved := olExit ;
  olExit := NEW (pool, I64, LEN (st)) ;
  n := 0 ;
  LOOP
    b := RgCopy (st) ;
    OlCond (cond, b, b) ;
    e2 := OlSeq (body, b) ;
    n := n + 1 ;
    IF NOT RgJoin (st, b) THEN EXIT END ;
    IF n > 400 THEN
      IF body IS SOME bn THEN RgNote (bn, 'internal', 'the owner walk did not settle over this loop') END ;
      EXIT
    END
  END ;
  e2 := RgJoin (st, olExit) ;
  olExit := saved
END OlLoop ;

PROCEDURE OlBindPats (arm: PTR Ast.Node ; v: I64 ; st: SLICE OF I64) =
VAR i, j, x : I64 ;
BEGIN
  IF arm.kids[0] IS SOME ll THEN
    FOR i := 0 TO ll.nkids - 1 DO
      IF ll.kids[i] IS SOME lbl THEN
        IF lbl.kind = Ast.NLabelPattern THEN
          IF lbl.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                x := OlEnter (id.au) ;
                IF x >= 0 THEN st[x] := v ; st[olCap + x] := v END
              END
            END
          END
        END
      END
    END
  END
END OlBindPats ;

PROCEDURE OlStmt (k: Ast.Kid ; st: SLICE OF I64) : BOOL =
VAR
  j, x, v : I64 ;
  acc, b : SLICE OF I64 ;
  e2, e3 : BOOL ;
BEGIN
  IF k IS SOME s THEN
    CASE s.kind OF
    | Ast.NAssign :
        IF s.kids[0] IS SOME lh THEN
          IF lh.kind = Ast.NDesignator THEN OlAssign (s, lh, st)
          ELSE v := OlExpr (s.kids[1], st) END
        END
    | Ast.NCallStmt :
        v := OlCall (s, st)
    | Ast.NReturn :
        FOR j := 0 TO s.nkids - 1 DO v := OlExpr (s.kids[j], st) END ;
        IF s.nkids > 0 THEN
          v := OlDeep (s.kids[0], st) ;
          olRetMask := RgOr (olRetMask, v MOD RgPow (OlOuter)) ;
          (* an owner answered whose storage was kept where it outlives
             the call: the caller may dispose of it (the fourth review's
             C18) *)
          IF s.kids[0] IS SOME rv THEN
            IF rv.kind = Ast.NDesignator AND rv.nkids = 0 AND OlBit (rv.au) >= 0 AND
               olOwned[OlBit (rv.au)] THEN
              IF RgHas (st[2 * olCap], OlBit (rv.au)) AND NOT RgLineRefused (rv.line) THEN
                ErrN (rv, olCtx, S3 (rv.au, Cat (' is answered here, and storage derived from it was kept at line ',
                  ItoA (olEscLine[OlBit (rv.au)])), ', where the caller may outlive it -- what is derived from an owned object lives as long as its owner (par 4.2, regions)'))
              END
            END
          END
        END ;
        RETURN TRUE
    | Ast.NRaiseStmt :
        FOR j := 0 TO s.nkids - 1 DO v := OlExpr (s.kids[j], st) END ;
        RETURN TRUE
    | Ast.NExit :
        IF LEN (olExit) = LEN (st) THEN e2 := RgJoin (olExit, st) END ;
        RETURN TRUE
    | Ast.NDispose :
        IF s.kids[0] IS SOME dd THEN
          (* every owner whose object the name may hold: after `Swap (a,
             b)' a holds b's (the fourth review's A04) *)
          x := OlFind (dd.au) ;
          IF x >= 0 AND dd.nkids = 0 THEN
            v := st[x] ;
            FOR j := 0 TO olNOwn - 1 DO
              IF RgHas (v, j) AND j # OlBit (dd.au) THEN OlKillBit (j, dd, olOwn[j], 'disposed', st) END
            END
          END ;
          OlKill (dd, 'disposed', st)
        END
    | Ast.NThread :
        IF s.nkids > 1 THEN
          v := OlDeep (s.kids[1], st) ;
          IF ParenCore (s.kids[1]) IS SOME ta THEN
            IF ta.kind = Ast.NDesignator AND ta.nkids = 0 AND OlBit (ta.au) >= 0 AND
               olOwned[OlBit (ta.au)] THEN
              OlHandOn (ta, 'handed to a THREAD', st)
            ELSE
              OlEscape (v, ta.line, st) ;
              (* a target whose parameter is OWN frees what it is handed:
                 through a selector that is every owner the root holds *)
              IF ta.kind = Ast.NDesignator AND ta.nkids > 0 AND ThreadOwnTarget (s) THEN
                OlKill (ta, 'handed to a THREAD', st)
              END
            END
          END
        END
    | Ast.NIf :
        acc := RgCopy (st) ;
        b := RgCopy (st) ;
        OlCond (s.kids[0], st, b) ;
        IF NOT OlSeq (s.kids[1], b) THEN e2 := RgJoin (acc, b) END ;
        FOR j := 2 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t THEN
            b := RgCopy (st) ;
            IF t.kind = Ast.NElsif THEN
              OlCond (t.kids[0], b, b) ;
              IF NOT OlSeq (t.kids[1], b) THEN e2 := RgJoin (acc, b) END
            ELSE
              IF NOT OlSeq (t.kids[0], b) THEN e2 := RgJoin (acc, b) END
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    | Ast.NCase :
        v := OlDeep (s.kids[0], st) ;
        acc := RgCopy (st) ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME t2 THEN
            b := RgCopy (st) ;
            IF t2.kind = Ast.NCaseArm THEN
              OlBindPats (t2, v, b) ;
              IF NOT OlSeq (t2.kids[1], b) THEN e2 := RgJoin (acc, b) END
            ELSE
              IF NOT OlSeq (t2.kids[0], b) THEN e2 := RgJoin (acc, b) END
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    | Ast.NWhile :
        OlLoop (s.kids[0], s.kids[1], st)
    | Ast.NFor :
        v := OlExpr (s.kids[0], st) ;
        v := OlExpr (s.kids[1], st) ;
        OlLoop (NONE, s.kids[3], st)
    | Ast.NForIn :
        v := OlDeep (s.kids[0], st) ;
        x := OlEnter (s.au) ;
        IF x >= 0 THEN st[x] := v ; st[olCap + x] := v END ;
        OlLoop (NONE, s.kids[1], st)
    | Ast.NLoop :
        OlLoop (NONE, s.kids[0], st)
    | Ast.NBlock :
        (* a handler starts from any state the guarded sequence passed
           through: a raise in the middle leaves one that is neither its
           start nor its end (the fourth review's A01) *)
        b := RgCopy (st) ;
        acc := RgCopy (st) ;
        IF s.kids[0] IS SOME gq THEN
          IF gq.kind = Ast.NStmtSeq THEN
            j := 0 ;
            e2 := FALSE ;
            WHILE j < gq.nkids AND NOT e2 DO
              e2 := OlStmt (gq.kids[j], b) ;
              e3 := RgJoin (acc, b) ;
              j := j + 1
            END
          ELSE
            e2 := OlStmt (s.kids[0], b) ;
            e3 := RgJoin (acc, b)
          END
        END ;
        FOR j := 1 TO s.nkids - 1 DO
          IF s.kids[j] IS SOME h THEN
            IF h.kind = Ast.NHandler OR h.kind = Ast.NFinally THEN
              b := RgCopy (acc) ;
              IF h.kind = Ast.NHandler THEN
                e2 := OlSeq (h.kids[2], b)
              ELSE
                olInFinally := olInFinally + 1 ;
                e2 := OlSeq (h.kids[0], b) ;
                olInFinally := olInFinally - 1
              END ;
              e2 := RgJoin (acc, b)
            END
          END
        END ;
        FOR j := 0 TO LEN (st) - 1 DO st[j] := acc[j] END
    ELSE
      FOR j := 0 TO s.nkids - 1 DO v := OlExpr (s.kids[j], st) END
    END
  END ;
  RETURN FALSE
END OlStmt ;

PROCEDURE OlSeq (k: Ast.Kid ; st: SLICE OF I64) : BOOL =
VAR j : I64 ;
BEGIN
  IF k IS SOME q THEN
    IF q.kind # Ast.NStmtSeq THEN RETURN OlStmt (k, st) END ;
    FOR j := 0 TO q.nkids - 1 DO
      IF OlStmt (q.kids[j], st) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END OlSeq ;

PROCEDURE OlUses (k: Ast.Kid) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NDesignator THEN
      IF NxFind (olUseIx, e.au) < 0 THEN NxAdd (olUseIx, Text.Keep (pool, e.au), 1) END
    END ;
    FOR i := 0 TO e.nkids - 1 DO OlUses (e.kids[i]) END
  END
END OlUses ;

PROCEDURE OlProc (d: PTR Ast.Node ; body: Ast.Kid ; RO ctx: UTF) =
VAR
  i, x : I64 ;
  st : SLICE OF I64 ;
  e2, any : BOOL ;
  md : UTF ;
BEGIN
  (* the names the body mentions, first: a name it never names is no
     owner of the walk and need not be entered -- every module variable
     of a unit was looked at for every body, and scale's module-variable
     shape lost its linearity (ratio 2.2 -> 4.3) *)
  NxClear (olUseIx) ;
  OlUses (body) ;
  (* only where an owner is: elsewhere the walk costs nothing *)
  any := FALSE ;
  FOR i := 0 TO nscope - 1 DO
    IF NOT any AND NxFind (olUseIx, scope[i].name) >= 0 AND OlOwnerKind (scope[i].name) > 0 THEN
      any := TRUE
    END
  END ;
  IF NOT any THEN RETURN END ;
  olCap := nscope + RgCount (body) + 8 ;
  olNames := NEW (pool, UTF, olCap) ;
  olDeadOf := NEW (pool, UTF, olCap) ;
  olOwn := NEW (pool, UTF, OlMaxOwn) ;
  olEscLine := NEW (pool, I64, OlMaxOwn) ;
  olOwned := NEW (pool, BOOL, OlMaxOwn) ;
  olExit := NEW (pool, I64, 0) ;
  olN := 0 ;
  olNOwn := 0 ;
  olFull := FALSE ;
  NxClear (olIx) ;
  olCtx := Text.Keep (pool, ctx) ;
  st := NEW (I64, 2 * olCap + 1 + OlMaxOwn) ;
  FOR i := 0 TO OlMaxOwn - 1 DO st[2 * olCap + 1 + i] := RgPow (OlOuter) - 1 END ;
  olPassOK := FALSE ;
  olPassName := '' ;
  olRetMask := 0 ;
  olInFinally := 0 ;
  olAnyKill := FALSE ;
  rgCtx := Text.Keep (pool, ctx) ;
  FOR i := 0 TO nscope - 1 DO
    md := scope[i].mode ;
    IF (Text.Eq (md, ModeLocal) OR Text.Eq (md, ModeOwn) OR Text.Eq (md, ModeVal) OR
        Text.Eq (md, ModeVar) OR Text.Eq (md, ModeRo) OR
        (olInBody AND Text.Eq (md, ModeModule))) AND OlFind (scope[i].name) < 0 AND
       NxFind (olUseIx, scope[i].name) >= 0 THEN
      x := OlEnter (scope[i].name) ;
      IF x >= 0 THEN
        IF OlOwnerKind (scope[i].name) > 0 AND NxFind (olUseIx, scope[i].name) >= 0 THEN
          IF olNOwn < OlMaxOwn THEN
            olOwn[olNOwn] := olNames[x] ;
            olEscLine[olNOwn] := 0 ;
            olOwned[olNOwn] := Text.Eq (md, ModeOwn) OR OlOwnerKind (scope[i].name) = 2 ;
            st[x] := RgPow (olNOwn) ;
            olNOwn := olNOwn + 1
          ELSE
            olFull := TRUE
          END
        ELSIF Text.Eq (md, ModeVar) OR
              ((Text.Eq (md, ModeVal) OR Text.Eq (md, ModeRo)) AND RgRefTy (scope[i].ty)) THEN
          (* a reference parameter: the caller's storage *)
          st[x] := RgPow (OlOuter) ;
          st[olCap + x] := RgPow (OlOuter)
        END
      END
    END
  END ;
  OlOwnedScan (body) ;
  OlOwnedScan (body) ;
  e2 := OlSeq (body, st) ;
  IF olFull THEN RgNote (d, 'internal', 'the owner walk: more than 60 owned names, or a name table full') END
EXCEPT
| IndexError (i, n) :
    RgNote (d, 'internal', Cat (Cat ('the owner walk: IndexError ', ItoA (i)), Cat (' of ', ItoA (n))))
END OlProc ;

PROCEDURE CheckProcBody (u: PTR Ast.Node ; d: PTR Ast.Node ;
                         RO ctx: UTF) =
VAR rk : I64 ;
BEGIN
  IF d.kids[4] IS SOME body THEN
    (* a RAISES clause may only cite an exception the reader can find *)
    IF d.kids[2] IS SOME rsc THEN
      FOR rk := 0 TO rsc.nkids - 1 DO
        IF rsc.kids[rk] IS SOME rxn THEN CheckExcName (rxn, ctx) END
      END
    END ;
    (* a nested procedure parses (par 10 allows a declaration in a
       body) and neither checker nor generator supports one: refused
       by name since 2026-10-08, where it was `unknown procedure' at
       its first call *)
    FOR rk := 0 TO body.nkids - 2 DO
      IF body.kids[rk] IS SOME nd THEN
        IF nd.kind = Ast.NProcDecl THEN
          ErrN (nd, ctx, 'a nested procedure is not supported: ' + nd.au +
                ' is declared inside ' + d.au +
                '; declare it at module level (par 3)')
        END
      END
    END ;
    ScopeClear () ;
    CallsClear () ;
    (* KEPT declarations are read as the params are added, so the
       list resets BEFORE AddParamsOf, not beside the walk state *)
    nkept := 0 ;
    nkeptU := 0 ;
    ncarry := 0 ;
    ncedge := 0 ;
    (* params and locals first: the lookup answers the first hit, so
       they shadow module state of the same name *)
    AddParamsOf (d) ;
    AddVarsOf (body, ModeLocal) ;
    AddModuleVars (curRoot, u) ;
    svConsts := nconsts ;
    AddConstsOf (body, ctx) ;
    RoSeed (body.kids[body.nkids - 1]) ;
    OwnFedSeed (body.kids[body.nkids - 1]) ;
    curRetTy := '<void>' ;
    IF d.kids[1] IS SOME rt THEN curRetTy := Text.Keep (pool, CanonT (d.kids[1], 0)) END ;
    curProcNm := Text.Keep (pool, d.au) ;
    OwnClear () ;
    OwnSeed () ;
    RaisedClear () ;
    (* par 4.1 direction: escape facts and pended stores are per
       procedure, and a module body's stray facts must not leak into
       the next file's first procedure *)
    nesc := 0 ;
    nedge := 0 ;
    npend := 0 ;
    nfval := 0 ;
    npval := 0 ;
    curInBody := FALSE ;
    (* par 3.2: kid 3 is the attribute, if any *)
    curPure := FALSE ;
    curFresh := FALSE ;
    IF d.kids[3] IS SOME at THEN
      IF Text.Eq (at.au, 'PURE') THEN curPure := TRUE
      ELSIF Text.Eq (at.au, 'FRESH') THEN
        (* the answer is built in the caller's arena, as a `+' is: the
           statement a C-filled answer needs (ADR below), made where the
           body cannot show it -- in an UNSAFE implementation only *)
        curFresh := TRUE ;
        IF NOT curUnsafe THEN
          ErrN (at, ctx, '[FRESH] states what an UNSAFE body cannot show; in a safe module the body is the evidence -- drop the attribute (par 7)')
        END
      ELSE
        ErrN (at, ctx, S3 ('a procedure takes the attribute [PURE] or, in an UNSAFE implementation, [FRESH] (par 3.2, par 7), not [', at.au, ']'))
      END
    END ;
    boundMon := Text.Keep (pool, BoundMonitorOf (d)) ;
    boundMonId := MonIdOf (d, curMod) ;
    (* par 3 rule 4, before the walk so that it is the procedure's
       first diagnostic on both sides *)
    IF d.kids[1] IS SOME rtf THEN
      IF body.kids[body.nkids - 1] IS SOME blk0 THEN
        IF NOT EndsStmt (blk0) THEN
          ErrN (d, ctx, 'a function must RETURN or RAISE on every path: '
                        + d.au + ' can reach its END (par 3)')
        END
      END
    END ;
    IF nAgg > 0 THEN
      IF body.kids[body.nkids - 1] IS SOME blk1 THEN
        AggWalk (blk1, Ast.NProcBody, ctx)
      END
    END ;
    DaProc (body.kids[body.nkids - 1], ctx) ;
    WalkStmt (body.kids[body.nkids - 1], ctx) ;
    FlushPend (ctx) ;
    RgProc (d, body.kids[body.nkids - 1], ctx) ;
    OlProc (d, body.kids[body.nkids - 1], ctx) ;
    (* at the BEGIN, as the Pascal twin does: the procedure body's
       node starts at its first declaration (probediff, 2026-10-10 --
       no probe had an unhandled RAISES under a local VAR before) *)
    IF body.kids[body.nkids - 1] IS SOME blk2 THEN
      ReportUnhandled (blk2, ctx, RaisesSpelled (pool, d))
    ELSE
      ReportUnhandled (body, ctx, RaisesSpelled (pool, d))
    END ;
    ReportImpureCalls (body, ctx) ;
    (* the locals go out of scope with the procedure: truncate rather
       than clear, so the module CONSTs registered before them stay *)
    nconsts := svConsts
  END
END CheckProcBody ;



(* ---- RAISES accounting ----

   Every exception a procedure can produce must appear in its RAISES
   clause, or be handled inside it.  Three sources, and the pass is
   only sound because pass 2 made every call RESOLVE: an unknown
   callee would be a blind spot, and a blind spot in this accounting
   is exactly the silence the whole design exists to remove.

     an explicit RAISE;
     a checked conversion -- I8..U64, BYTE, CHR -- which raises
       ValueRange, because Trunc (NaN) crashing FPC and answering
       INT64_MIN in numpy is the museum piece this comes from;
     a resolvable callee's declared set.

   Minus what handlers catch, minus what the clause declares, minus
   the three that are always possible and never declared: Overflow,
   IndexError and OutOfMemory.  Declaring those would put them on
   every signature in the language and so say nothing.             *)

PROCEDURE RaisedClear () =
BEGIN
  nraised := 0
END RaisedClear ;

PROCEDURE RaisedAdd (RO KEPT nm: UTF ; RO KEPT origin: UTF) =
VAR
  nb : SLICE OF Binding ;
  i : I64 ;
BEGIN
  FOR i := 0 TO nraised - 1 DO
    IF Text.Eq (raised[i].name, nm) THEN RETURN END   (* first wins *)
  END ;
  IF nraised = LEN (raised) THEN
    nb := NEW (pool, Binding, 2 * LEN (raised)) ;
    FOR i := 0 TO nraised - 1 DO nb[i] := raised[i] END ;
    raised := nb
  END ;
  raised[nraised].name := nm ;
  raised[nraised].mode := origin ;
  raised[nraised].ty := NONE ;
  nraised := nraised + 1
END RaisedAdd ;

(* what a block's handlers catch, dropped from the raises its guarded
   sequence added: the entries from `from' on whose name is in names,
   ' A B ' *)
PROCEDURE RaisedDrop (from: I64 ; RO names: UTF) =
VAR i, n : I64 ;
BEGIN
  n := from ;
  FOR i := from TO nraised - 1 DO
    IF NOT Text.Contains (names, S3 (' ', raised[i].name, ' ')) AND
       NOT Text.Contains (names, S3 (' ', ExcBare (raised[i].name), ' ')) THEN
      raised[n] := raised[i] ;
      n := n + 1
    END
  END ;
  nraised := n
END RaisedDrop ;

(* the three that are always possible: declaring them would put them
   on every signature and so distinguish nothing *)
PROCEDURE IsUnchecked (RO nm: UTF) : BOOL =
BEGIN
  RETURN Text.Eq (nm, 'Overflow') OR Text.Eq (nm, 'IndexError') OR
         Text.Eq (nm, 'OutOfMemory')
END IsUnchecked ;

PROCEDURE ScalarAlias (RO name: UTF) : UTF =
VAR dot : I64 ; t : UTF ;
BEGIN
  (* An alias for a scalar CONVERTS under its own name.  Aliases
     already chase to structure for conformance -- `TYPE Real = F32`
     makes Real and F32 one type for assignment, arguments and RETURN
     -- so `Real (x)` meaning anything but `F32 (x)` would be the odd
     case.  The name is chased to the builtin it abbreviates and
     every conversion rule then applies unchanged.

     Forced by the port: -fdefault-real-8 is commented out
     in the original's makefile, so single precision is what ships
     and double is what the flag is for.  One source held
     bit-identical to both builds needs the default real kind to have
     a name, and that name has to convert.

     An alias for a record, a slice or anything else chases to
     something that is not a builtin, and the caller reports it as
     the unknown procedure it is. *)
  IF IsBuiltinTy (name) THEN RETURN name END ;
  dot := Text.FindChar (name, '.') ;
  IF dot > 0 THEN
    t := CanonQual (SLICE (name, 0, dot),
                    SLICE (name, dot + 1, Text.BLen (name) - dot - 1), 0)
  ELSE
    (* a bare name is this module's alias: another module's is written
       qualified (the scan found NbCells's `Kind (x)' in Csv; item 12) *)
    t := CanonQual (curMod, name, 0)
  END ;
  IF IsBuiltinTy (t) THEN RETURN t END ;
  RETURN name
END ScalarAlias ;

(* does the C.* conversion NAME take a value of type T without a
   check?  Unknown, literal and C-typed arguments do, as before *)
PROCEDURE CTotal (RO name: UTF ; RO t: UTF) : BOOL =
BEGIN
  IF Text.BLen (t) = 0 OR Text.StartsWith (t, 'C.') OR Text.StartsWith (t, '<') THEN
    RETURN TRUE
  END ;
  IF Text.Eq (name, 'C.Int') THEN
    RETURN Text.OneOf (STR (t), CIntTotal)
  ELSIF Text.Eq (name, 'C.SizeT') THEN
    RETURN Text.OneOf (STR (t), CSizeTotal)
  END ;
  RETURN Text.Eq (t, 'F32')
END CTotal ;

PROCEDURE IsConvVR (RO nm: UTF) : BOOL =
BEGIN
  RETURN Text.OneOf (STR (nm), ConvVR)
END IsConvVR ;

(* I64 of a NARROWER integer is total: every BYTE, I8..I32, U8..U32,
   C.Int and C.SSizeT value is an I64 value.  Requiring RAISES there
   would push an untriggerable ValueRange through every caller of a
   foreign wrapper, and accounting that stops describing what can
   happen is what makes exhaustive RAISES worthless.               *)
PROCEDURE TotalWidening (RO name: UTF ; RO argTy: UTF) : BOOL =
BEGIN
  IF NOT Text.Eq (name, 'I64') THEN RETURN FALSE END ;
  RETURN Text.OneOf (STR (argTy), WidensTo64)
END TotalWidening ;

PROCEDURE WalkExpr (k: Ast.Kid ; RO ctx: UTF) ;

PROCEDURE WalkArgs (k: Ast.Kid ; RO ctx: UTF) =
VAR
  i : I64 ;
  quiet : BOOL ;
BEGIN
  IF k IS SOME al THEN
    quiet := FALSE ;
    FOR i := 0 TO nunkArgs - 1 DO
      IF unkArgs[i] = al.id THEN quiet := TRUE END
    END ;
    IF quiet THEN quietWalk := quietWalk + 1 END ;
    FOR i := 0 TO al.nkids - 1 DO WalkExpr (al.kids[i], ctx) END ;
    IF quiet THEN quietWalk := quietWalk - 1 END
  END
END WalkArgs ;

(* the type of an argument, when it can be known cheaply: a
   designator's declared type, or a resolvable call's return type.
   The second case is not optional -- I64 (ArgC ()) is the shape
   every foreign wrapper uses, and without it the widening rule
   misses and invents a ValueRange nobody can trigger. *)
PROCEDURE ArgCanon (k: Ast.Kid ; RO ctx: UTF) : UTF =
VAR
  pr : ProcInfo ;
  found : BOOL ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME cd THEN
        pr := LookupProc (DesigName (cd), found) ;
        IF found THEN
          IF pr.node IS SOME pn THEN RETURN CanonIn (pr.modName, pn.kids[1]) END
        END
      END ;
      RETURN ''
    END
  END ;
  RETURN DesigCanon (k, ctx)
END ArgCanon ;

(* ArgCanon with its diagnostics off, for NoteCall: CallType has typed
   the arguments and said what is wrong with them, and NoteCall only
   asks for the width twin and for a conversion's totality -- typing an
   argument again reported a missing field twice (checkfuzz, 2026-10-21:
   `Take (j.m)', where the Pascal twin reports it once) *)
PROCEDURE ArgCanonQ (k: Ast.Kid ; RO ctx: UTF) : UTF =
VAR t : UTF ;
BEGIN
  quietWalk := quietWalk + 1 ;
  t := ArgCanon (k, ctx) ;
  quietWalk := quietWalk - 1 ;
  RETURN t
END ArgCanonQ ;

PROCEDURE NoteCall (dn: PTR Ast.Node ; argl: Ast.Kid ; RO ctx: UTF) =
VAR
  name, argTy, tmod : UTF ;
  pr : ProcInfo ;
  found, lenArg : BOOL ;
  j, jj, nf32, nf64, nutf, si : I64 ;
BEGIN
  name := DesigName (dn) ;
  (* the FPC checker chases inside CallType, which is also where it
     attributes ValueRange; this one attributes it here, so it chases
     here as well -- otherwise `TYPE Idx = I32` raises in one checker
     and not in the other, and probediff compares the text *)
  IF argl IS SOME alc THEN
    IF alc.nkids = 1 THEN name := ScalarAlias (name) END ;
    IF alc.nkids >= 1 THEN
      nf32 := 0 ;
      nf64 := 0 ;
      nutf := 0 ;
      FOR jj := 0 TO alc.nkids - 1 DO
        argTy := ArgCanonQ (alc.kids[jj], ctx) ;
        IF Text.Eq (argTy, 'F32') THEN nf32 := nf32 + 1 END ;
        IF Text.Eq (argTy, 'F64') THEN nf64 := nf64 + 1 END ;
        (* in the same loop: typing an argument again would count its
           sites twice on the review page *)
        IF UtfVotes (argTy) THEN nutf := nutf + 1 END
      END ;
      name := WidthTwin (name, nf32 > 0 AND nf64 = 0) ;
      name := UtfTwin (name, nutf > 0)
    END
  END ;
  (* a C.* conversion that NARROWS is checked like I32 (x): C.Int is
     a 32-bit int, C.SizeT has no sign, C.Float is a float.  Until
     2026-10-10 they were casts: C.Int (5000000000) was 705032704 and
     C.SizeT (-1) a size beyond any buffer.  A value that already fits
     -- a narrower or unsigned integer, an F32, a C value, a literal --
     converts totally. *)
  IF Text.Eq (name, 'C.Int') OR Text.Eq (name, 'C.SizeT') OR
     Text.Eq (name, 'C.Float') THEN
    argTy := '' ;
    lenArg := FALSE ;
    IF argl IS SOME al2 THEN
      IF al2.nkids > 0 THEN
        (* the type the check of the call recorded (the typed tree),
           as the FPC checker reads its own: ArgCanon types a call
           only by a declared result, and LEN (s) is none *)
        IF al2.kids[0] IS SOME a0 THEN
          argTy := Ast.TyStrAt (a0.id) ;
          IF a0.kind = Ast.NCallExpr THEN
            IF a0.kids[0] IS SOME lc THEN
              lenArg := lc.kind = Ast.NDesignator AND Text.Eq (DesigName (lc), 'LEN')
            END
          END
        END ;
        IF Text.BLen (argTy) = 0 THEN argTy := ArgCanonQ (al2.kids[0], ctx) END
      END
    END ;
    (* a length is never below zero: C.SizeT (LEN (b)) takes it whole *)
    IF lenArg AND Text.Eq (name, 'C.SizeT') THEN RETURN END ;
    IF NOT CTotal (name, argTy) THEN
      RaisedAdd ('ValueRange', Text.Keep (pool, Cat (name, ' conversion')))
    END ;
    RETURN
  END ;
  (* UTF (b) of octets validates them: ValueRange when they are not
     UTF-8; UTF (s), STR (u) and OCTETS (u) cannot fail *)
  IF Text.Eq (name, 'UTF') AND UtfName (name) THEN
    IF argl IS SOME alu THEN
      IF alu.nkids = 1 OR alu.nkids = 2 THEN
        (* the argument's recorded type first, as the conversion above
           reads it: ArgCanon types a call or a designator only, so a
           SLICE (b, i, n) of octets read as unknown and UTF of it raised
           nothing (Fmt.Short, 2026-10-25; the Pascal twin's ExprType
           types it and refused) *)
        argTy := '' ;
        IF alu.kids[alu.nkids - 1] IS SOME ua THEN argTy := Ast.TyStrAt (ua.id) END ;
        IF Text.BLen (argTy) = 0 THEN argTy := ArgCanonQ (alu.kids[alu.nkids - 1], ctx) END ;
        IF Text.Eq (argTy, 'SLICE OF BYTE') THEN
          RaisedAdd ('ValueRange', 'UTF conversion')
        END ;
        RETURN
      END
    END
  END ;
  IF (Text.Eq (name, 'STR') OR Text.Eq (name, 'OCTETS')) AND UtfName (name) THEN
    IF argl IS SOME als THEN
      IF als.nkids = 1 THEN RETURN END
    END
  END ;
  IF IsConvVR (name) THEN
    argTy := '' ;
    IF argl IS SOME al THEN
      IF al.nkids > 0 THEN argTy := ArgCanonQ (al.kids[0], ctx) END
    END ;
    IF NOT TotalWidening (name, argTy) THEN
      RaisedAdd ('ValueRange', Text.Keep (pool, Cat (name, ' conversion')))
    END ;
    RETURN
  END ;
  (* the integer-to-enumeration conversion raises the same way *)
  IF Text.BLen (EnumConvType (name)) > 0 THEN
    RaisedAdd ('ValueRange', Text.Keep (pool, Cat (name, ' conversion')))
  END ;
  (* a call through a procedure value raises what its TYPE declares
     (par 2.2.3); it names no procedure, so it joins no call graph *)
  si := ScopeFind (name) ;
  IF si >= 0 THEN
    IF ResolveType (scope[si].ty) IS SOME ptn THEN
      IF ptn.kind = Ast.NProcType THEN
        (* the type's RAISES names are the DECLARING module's: keyed in
           the caller's, `RAISES Error' in Pk's type was the caller's own
           Error -- a caller declaring Pk.Error was refused, and one with
           an Error of its own was accepted for an exception its handler
           never catches (zarrm9's 0.25 port, 2026-10-25; probe
           proc-type-raises-module).  An inline type is the caller's. *)
        tmod := ResolvedMod () ;
        IF Text.BLen (tmod) = 0 THEN tmod := curMod END ;
        IF ptn.kids[2] IS SOME rs THEN
          FOR j := 0 TO rs.nkids - 1 DO
            IF rs.kids[j] IS SOME q THEN
              RaisedAdd (ExcKey (tmod, ExcSpelled (q)), Text.Keep (pool, Cat ('call to ', name)))
            END
          END
        END ;
        RETURN
      END
    END
  END ;
  pr := LookupProc (name, found) ;
  IF NOT found THEN RETURN END ;
  CallsAdd (Text.Keep (pool, name)) ;
  FOR j := 0 TO LEN (pr.raises) - 1 DO
    RaisedAdd (ExcKey (pr.modName, pr.raises[j]), Text.Keep (pool, Cat ('call to ', name)))
  END
END NoteCall ;

PROCEDURE WalkExpr (k: Ast.Kid ; RO ctx: UTF) =
VAR i : I64 ;
BEGIN
  IF k IS SOME e THEN
    IF e.kind = Ast.NCallExpr THEN
      IF e.kids[0] IS SOME dn THEN NoteCall (dn, e.kids[1], ctx) END ;
      WalkArgs (e.kids[1], ctx) ;
      RETURN
    END ;
    FOR i := 0 TO e.nkids - 1 DO WalkExpr (e.kids[i], ctx) END
  END
END WalkExpr ;

PROCEDURE ReportUnhandled (body: PTR Ast.Node ; RO ctx: UTF ;
                           declared: SLICE OF UTF) =
VAR
  i, j : I64 ;
  ok : BOOL ;
BEGIN
  FOR i := 0 TO nraised - 1 DO
    IF NOT IsUnchecked (raised[i].name) THEN
      ok := FALSE ;
      FOR j := 0 TO LEN (declared) - 1 DO
        IF ExcCovers (ExcKey (curMod, declared[j]), raised[i].name) THEN ok := TRUE END
      END ;
      IF NOT ok AND Text.BLen (showName) > 0 THEN
        (* m9c --show's probe: its body is the one shown statement,
           and what it raises is what the program around it must
           handle -- recorded, not refused *)
        IF NOT Text.Contains (shownRaises, ' ' + ExcBare (raised[i].name) + ' ') THEN
          shownRaises := Text.Keep (pool, shownRaises + ExcBare (raised[i].name) + ' ')
        END
      ELSIF NOT ok THEN
        (* the edit, said (cp-kernel: the KEPT and RAISES refusals
           were 14 of stage 4b's 32 red runs, each fixed by the one
           line the message could have named) *)
        ErrN (body, ctx, Cat (Cat (Cat (Cat (Cat ('unhandled RAISES ',
          ExcShown (raised[i].name)), ' from '), raised[i].mode),
          " -- add it to this procedure's RAISES, or handle it: EXCEPT | "),
          Cat (ExcShown (raised[i].name), ' : ...')))
      END
    END
  END
END ReportUnhandled ;

(* par 3.2 rule 3: a PURE procedure may call only PURE procedures.

   This is what makes "no I/O" true without the checker knowing what
   I/O is -- a foreign procedure carries [SERIAL] or [REENTRANT] and
   is therefore never PURE, and neither is Io.WriteLine, so neither
   can be reached from a PURE body.  Purity is transitive by
   construction rather than by a second analysis.

   A callee that does not resolve to a declared procedure is a
   builtin -- LEN, ORD, a checked conversion, a variant constructor
   -- and those are pure, so they are skipped. *)
PROCEDURE ReportImpureCalls (body: PTR Ast.Node ; RO ctx: UTF) =
VAR
  i : I64 ;
  found : BOOL ;
  pr : ProcInfo ;
BEGIN
  IF NOT curPure THEN RETURN END ;
  FOR i := 0 TO ncalls - 1 DO
    pr := LookupProc (calls[i], found) ;
    IF found THEN
      IF NOT Text.Eq (pr.attrib, 'PURE') THEN
        ErrN (body, ctx, Cat (Cat ('PURE procedure calls ', calls[i]),
          ', which is not PURE (par 3.2)'))
      END
    END
  END
END ReportImpureCalls ;

PROCEDURE CallsClear () =
BEGIN
  ncalls := 0 ;
  NxClear (callsIx)
END CallsClear ;

PROCEDURE CallsAdd (RO KEPT nm: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF NxFind (callsIx, nm) >= 0 THEN RETURN END ;
  NxAdd (callsIx, nm, ncalls) ;
  IF ncalls = LEN (calls) THEN
    nb := NEW (pool, UTF, 2 * LEN (calls)) ;
    FOR i := 0 TO ncalls - 1 DO nb[i] := calls[i] END ;
    calls := nb
  END ;
  calls[ncalls] := nm ;
  ncalls := ncalls + 1
END CallsAdd ;

(* ---- A MODULE IS NAMED ONLY WHERE IT IS IMPORTED (report par 3,
   rule 5; Alex's decision of 2026-10-02).  The checker is handed the
   whole import closure, and every lookup asks FindMod, which knows
   all of it -- so `Text.Keep' compiled in a program that imported
   only Check, because Check imports Text.  What a module depends on
   was not readable off its IMPORT lines.

   One pass over the unit's tree, the same walk in both checkers.  A
   qualified name -- a qualident `M.T', or a designator `M.x...' --
   whose first part is a module the checker knows must be imported
   by the module that writes it: by its definition or by its
   implementation, either serves both (2,302 sites in 55 files lean
   on that, measured).  A name declared in the enclosing procedure,
   or at the module's own level, is that name and not the module.
   Said ONCE a module and unit: the mistake is one missing line. ---- *)

(* does the module `me' -- any unit of that name in the file --
   import `name', or is it `name' itself? *)
PROCEDURE ModImports (root: PTR Ast.Node ; RO me: UTF ; RO name: UTF) : BOOL =
VAR i, j, k : I64 ;
BEGIN
  IF Text.Eq (me, name) THEN RETURN TRUE END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF Text.Eq (u.au, me) THEN
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME imp THEN
            IF imp.kind = Ast.NFromImport THEN
              IF Text.Eq (imp.au, name) THEN RETURN TRUE END
            ELSIF imp.kind = Ast.NImportList THEN
              IF imp.kids[0] IS SOME ids THEN
                FOR k := 0 TO ids.nkids - 1 DO
                  IF ids.kids[k] IS SOME id THEN
                    IF Text.Eq (id.au, name) THEN RETURN TRUE END
                  END
                END
              END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ModImports ;

(* is `name' declared under k: a variable, parameter, binder, type,
   constant or exception? *)
PROCEDURE DeclaresName (k: Ast.Kid ; RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME n THEN
    IF n.kind = Ast.NIdent OR n.kind = Ast.NIsSome OR n.kind = Ast.NTypeDecl
       OR n.kind = Ast.NConstDecl OR n.kind = Ast.NExcDecl THEN
      IF Text.Eq (n.au, name) THEN RETURN TRUE END
    END ;
    FOR i := 0 TO n.nkids - 1 DO
      IF DeclaresName (n.kids[i], name) THEN RETURN TRUE END
    END
  END ;
  RETURN FALSE
END DeclaresName ;

(* at the level of the module `me': a constant, type, variable or
   exception of its definition or implementation *)
PROCEDURE ModuleDeclares (root: PTR Ast.Node ; RO me: UTF ; RO name: UTF) : BOOL =
VAR i, j : I64 ;
BEGIN
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      IF Text.Eq (u.au, me) THEN
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME d THEN
            IF d.kind # Ast.NProcDecl AND d.kind # Ast.NModBody
               AND d.kind # Ast.NImportList AND d.kind # Ast.NFromImport THEN
              IF DeclaresName (u.kids[j], name) THEN RETURN TRUE END
            END
          END
        END
      END
    END
  END ;
  RETURN FALSE
END ModuleDeclares ;

(* in the procedure or module body `scope' -- anywhere under it, a
   binder in any arm included -- or at the level of the module `me'.
   ExportWalk's test (decision 28); CheckImports has the scoped one
   below since 2026-10-08. *)
PROCEDURE NameShadowed (root: PTR Ast.Node ; RO me: UTF ; scope: Ast.Kid ;
                        RO name: UTF) : BOOL =
BEGIN
  IF DeclaresName (scope, name) THEN RETURN TRUE END ;
  RETURN ModuleDeclares (root, me, name)
END NameShadowed ;

(* the procedure's own declarations -- its parameters and the CONST,
   TYPE, VAR and EXCEPTION sections of its body -- and NOT the
   binders in its statements, which are in scope only where they
   bind (BinderHas) *)
PROCEDURE ProcDeclares (scope: Ast.Kid ; RO name: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  IF scope IS SOME s THEN
    IF s.kind = Ast.NProcDecl THEN
      IF DeclaresName (s.kids[0], name) THEN RETURN TRUE END ;
      IF s.kids[4] IS SOME body THEN
        FOR i := 0 TO body.nkids - 2 DO
          IF DeclaresName (body.kids[i], name) THEN RETURN TRUE END
        END
      END
    END
  END ;
  RETURN FALSE
END ProcDeclares ;

(* the binders in scope during CheckImports' walk: pushed where a
   statement binds them, popped when its statements are done *)
PROCEDURE BinderPush (RO KEPT nm: UTF) =
VAR
  nb : SLICE OF UTF ;
  i : I64 ;
BEGIN
  IF nimpB = LEN (impB) THEN
    nb := NEW (pool, UTF, 2 * LEN (impB) + 16) ;
    FOR i := 0 TO nimpB - 1 DO nb[i] := impB[i] END ;
    impB := nb
  END ;
  impB[nimpB] := nm ;
  nimpB := nimpB + 1
END BinderPush ;

PROCEDURE BinderPop (n: I64) =
BEGIN
  nimpB := nimpB - n ;
  IF nimpB < 0 THEN nimpB := 0 END
END BinderPop ;

PROCEDURE BinderHas (RO nm: UTF) : BOOL =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO nimpB - 1 DO
    IF Text.Eq (impB[i], nm) THEN RETURN TRUE END
  END ;
  RETURN FALSE
END BinderHas ;

(* the name `IS SOME' binds in a condition, or '' *)
PROCEDURE CondBinder (c: Ast.Kid) : UTF =
BEGIN
  IF c IS SOME e THEN
    IF e.kind = Ast.NIs THEN
      IF e.kids[1] IS SOME b THEN
        IF b.kind = Ast.NIsSome THEN RETURN b.au END
      END
    END
  END ;
  RETURN ''
END CondBinder ;

(* push the binders of a CASE arm's label patterns, or of a handler's
   payload list; answer how many *)
PROCEDURE PushBinders (k: Ast.Kid) : I64 =
VAR i, j, n : I64 ;
BEGIN
  n := 0 ;
  IF k IS SOME l THEN
    IF l.kind = Ast.NLabelList THEN
      FOR i := 0 TO l.nkids - 1 DO
        IF l.kids[i] IS SOME lp THEN
          IF lp.kind = Ast.NLabelPattern THEN
            IF lp.kids[0] IS SOME ids THEN
              FOR j := 0 TO ids.nkids - 1 DO
                IF ids.kids[j] IS SOME id THEN
                  BinderPush (id.au) ;
                  n := n + 1
                END
              END
            END
          END
        END
      END
    ELSIF l.kind = Ast.NArgList THEN
      FOR i := 0 TO l.nkids - 1 DO
        IF l.kids[i] IS SOME id THEN
          IF id.kind = Ast.NIdent THEN
            BinderPush (id.au) ;
            n := n + 1
          END
        END
      END
    END
  END ;
  RETURN n
END PushBinders ;

PROCEDURE ImportWalk (root: PTR Ast.Node ; u: PTR Ast.Node ; scope: Ast.Kid ;
                      k: Ast.Kid ; VAR seen: SLICE OF BOOL) =
VAR
  i, m, np : I64 ;
  qualified : BOOL ;
  b : UTF ;
BEGIN
  IF k IS SOME n THEN
    qualified := FALSE ;
    IF n.kind = Ast.NQualident THEN
      qualified := Text.BLen (n.bu) > 0
    ELSIF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
      IF n.kids[0] IS SOME sel THEN qualified := sel.kind = Ast.NSelField END
    END ;
    IF qualified THEN
      m := FindMod (n.au) ;
      IF m >= 0 AND m < LEN (seen) THEN
        IF NOT seen[m] THEN
          IF NOT ModImports (root, u.au, n.au) THEN
            (* shadowed by a declaration of the procedure or the
               module, or by a binder IN SCOPE HERE -- until
               2026-10-08 by a binder anywhere in the procedure, so
               a binder in one arm stood for the module in the next *)
            IF NOT ProcDeclares (scope, n.au) AND NOT BinderHas (n.au) AND
               NOT ModuleDeclares (root, u.au, n.au) THEN
              seen[m] := TRUE ;
              ErrN (n, u.au, 'module ' + n.au +
                    ' is named and not imported: write IMPORT ' + n.au +
                    ' (par 3)')
            END
          END
        END
      END
    END ;
    IF n.kind = Ast.NIf OR n.kind = Ast.NElsif OR n.kind = Ast.NWhile THEN
      (* the binder of `IS SOME' is in scope for the THEN or DO part
         and nowhere else: not the ELSIFs, not the ELSE *)
      ImportWalk (root, u, scope, n.kids[0], seen) ;
      b := CondBinder (n.kids[0]) ;
      IF Text.BLen (b) > 0 THEN BinderPush (b) END ;
      ImportWalk (root, u, scope, n.kids[1], seen) ;
      IF Text.BLen (b) > 0 THEN BinderPop (1) END ;
      FOR i := 2 TO n.nkids - 1 DO
        ImportWalk (root, u, scope, n.kids[i], seen)
      END
    ELSIF n.kind = Ast.NCaseArm THEN
      ImportWalk (root, u, scope, n.kids[0], seen) ;
      np := PushBinders (n.kids[0]) ;
      ImportWalk (root, u, scope, n.kids[1], seen) ;
      BinderPop (np)
    ELSIF n.kind = Ast.NHandler THEN
      ImportWalk (root, u, scope, n.kids[0], seen) ;
      ImportWalk (root, u, scope, n.kids[1], seen) ;
      np := PushBinders (n.kids[1]) ;
      ImportWalk (root, u, scope, n.kids[2], seen) ;
      BinderPop (np)
    ELSE
      FOR i := 0 TO n.nkids - 1 DO
        IF n.kind = Ast.NProcDecl OR n.kind = Ast.NModBody THEN
          ImportWalk (root, u, k, n.kids[i], seen)
        ELSE
          ImportWalk (root, u, scope, n.kids[i], seen)
        END
      END
    END
  END
END ImportWalk ;

(* ---- AN IMPORTED VARIABLE IS ONE NAME (decision 28, 2026-10-04).
   A definition's VARs are the module's exports, read and written by
   an importer as Mod.v (Modula-2's rule; Alex: "rw").  Rather than
   teach every procedure that walks a designator from its root --
   typing, RO, the frame and escape rules, the pool root -- that a
   root can be two names, the designator Mod.v... is REWRITTEN, once,
   to the designator rooted at the single name `Mod.v', which no
   identifier can spell, and that name is in scope as a module
   variable of the definition's type (AddModuleVars).  Every rule
   then applies to it as to any module variable.  After CheckImports,
   so that a module named and not imported is still said so; only
   for a module this one imports, and not where a local or module
   name of the same spelling shadows it (NameShadowed, decision 24's
   test).  The generator makes the same rewrite (Gen.ExportWalk), so
   both ends agree without the generator depending on the checker. *)

(* `a.bu', in the module's own pool and not the node's.  The node's
   pool was the one a binder on CheckFile's VALUE parameter root named
   -- none, so the generator used CheckFile's frame and the name
   dangled once it returned (`unknown name: const vo', 2026-10-04).
   The checker refuses that lend since 2026-10-10 (probe
   pool-root-binder) and CheckFile takes its root VAR; the module pool
   stays because CheckFile's root is itself a binder on a call's answer
   in M9c, whose pool is not traced here.  Gen's twin builds in the
   node's pool: its walk starts from a module table. *)
PROCEDURE DotJoin (RO a, b: UTF) : UTF =
  (* a frame value: its caller stores it through Ast.SetA, which copies *)
BEGIN
  RETURN a + '.' + b
END DotJoin ;

PROCEDURE ExportWalk (VAR n: PTR Ast.Node ; root: PTR Ast.Node ; RO me: UTF ;
                      scope: Ast.Kid) =
VAR
  i, m : I64 ;
BEGIN
  IF n.kind = Ast.NDesignator AND n.nkids > 0 THEN
    IF n.kids[0] IS SOME s THEN
      IF s.kind = Ast.NSelField AND NOT Text.Eq (n.au, me) THEN
        m := FindMod (n.au) ;
        IF ExportsVar (m, s.au) THEN
          IF ModImports (root, me, n.au) AND
             NOT NameShadowed (root, me, scope, n.au) THEN
            Ast.SetA (pool, n, DotJoin (n.au, s.au)) ;
            FOR i := 0 TO n.nkids - 2 DO n.kids[i] := n.kids[i + 1] END ;
            n.nkids := n.nkids - 1
          END
        END
      END
    END
  END ;
  FOR i := 0 TO n.nkids - 1 DO
    IF n.kids[i] IS SOME c THEN
      IF n.kind = Ast.NProcDecl OR n.kind = Ast.NModBody THEN
        ExportWalk (c, root, me, SOME (n))
      ELSE
        ExportWalk (c, root, me, scope)
      END
    END
  END
END ExportWalk ;

(* the module variables a body of unit u sees, after its parameters
   and locals: u's own; its definition's, when u is an implementation
   (until 2026-10-04 an implementation did not see them, and `xs :=
   5' for a SLICE OF F64 xs was passed over as untyped); and every
   other module's exports by their qualified names *)
PROCEDURE AddModuleVars (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  i, m, k : I64 ;
BEGIN
  AddVarsOf (u, ModeModule) ;
  IF u.kind = Ast.NImplementation THEN
    FOR i := 0 TO root.nkids - 1 DO
      IF root.kids[i] IS SOME du THEN
        IF du.kind = Ast.NDefinition AND Text.Eq (du.au, u.au) THEN
          AddVarsOf (du, ModeModule)
        END
      END
    END
  END ;
  FOR m := 0 TO nmods - 1 DO
    IF NOT Text.Eq (mods[m].name, u.au) THEN
      FOR k := 0 TO mods[m].nvrs - 1 DO
        ScopeAdd (Text.Keep (pool, Qualify (mods[m].name, mods[m].vrNames[k])),
                  mods[m].vrTypes[k], ModeModule) ;
        scope[nscope - 1].ro := mods[m].vrRo[k]
      END
    END
  END
END AddModuleVars ;

PROCEDURE CheckImports (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  seen : SLICE OF BOOL ;
  i : I64 ;
BEGIN
  seen := NEW (BOOL, nmods) ;
  IF LEN (impB) = 0 THEN impB := NEW (pool, UTF, 16) END ;
  nimpB := 0 ;
  FOR i := 0 TO u.nkids - 1 DO
    ImportWalk (root, u, NONE, u.kids[i], seen)
  END
END CheckImports ;

(* ---- A NAME IS DECLARED ONCE IN ITS SCOPE (report par 3, rule 6;
   2026-10-03).  Neither checker had a word for a name declared twice:
   a module CONST written a second time, a VAR, a TYPE, a local beside
   a parameter of the same name -- each passed `--check' and was the C
   compiler's to refuse, and a PROCEDURE declared twice was not even
   that: the generator kept the second body and dropped the first,
   and the program built and ran with half its code gone.  Found
   lifting Chart into Plot, whose second `Ink' met the first.

   One pass over the unit, the same in both checkers: the module's
   own level -- every CONST, TYPE, VAR, EXCEPTION and PROCEDURE name,
   across its sections -- and each procedure's parameters and locals
   together.  Refused at the SECOND declaration, naming the line of
   the first.  A local named like a module-level name is a shadow and
   stays legal (decision 20); the two units of a module are two
   scopes, since the implementation re-declares what the definition
   heads.  A FORWARD declaration -- a heading without a body -- is
   closed by the one declaration with a body that follows it (the
   toolchain has 46), and nothing else may close it or follow that.
   Measured over 425 files here and in two applications: the 46
   forwards and TWO real duplicates, both in the shipped library --
   `Csv.ColF64' declared twice with the same body, and the constant
   `NetCDF.ModeNetcdf4'.
   Not covered: an enumeration's members, a binder. ---- *)

CONST
  DeclPlain = 0 ;      (* a constant, type, variable, exception, parameter *)
  DeclForward = 1 ;    (* a procedure heading without a body *)
  DeclBody = 2 ;       (* a procedure with its body *)

(* `id' declares `id.au' in the scope whose names so far are
   names[0 .. n): refuse the second, or add the first *)
PROCEDURE DeclOnce (KEPT id: PTR Ast.Node ; what: I64 ; RO me: UTF ; RO where: UTF ;
                    VAR names: SLICE OF UTF ; VAR lines: SLICE OF I64 ;
                    VAR open: SLICE OF BOOL ; VAR n: I64) =
VAR
  i : I64 ;
  ns : SLICE OF UTF ;
  ls : SLICE OF I64 ;
  os : SLICE OF BOOL ;
BEGIN
  IF n = 0 THEN NxClear (declIx) END ;
  i := NxFind (declIx, id.au) ;
  IF i >= 0 THEN
    IF open[i] AND what = DeclBody THEN
      open[i] := FALSE
    ELSE
      ErrN (id, me, id.au + ' is declared twice in ' + where +
            ': the first is at line ' + ItoA (lines[i]) + ' (par 3)')
    END ;
    RETURN
  END ;
  (* a name entered for the first time -- not the body that closes a
     FORWARD, which returned above *)
  IF Text.Eq (id.au, 'NaN') THEN
    ErrN (id, me, Cat ('NaN is predeclared, the quiet NaN: a declaration may',
          ' not take its name (par 2.1)'))
  END ;
  IF n = LEN (names) THEN
    ns := NEW (pool, UTF, 2 * n + 16) ;
    ls := NEW (pool, I64, 2 * n + 16) ;
    os := NEW (pool, BOOL, 2 * n + 16) ;
    FOR i := 0 TO n - 1 DO
      ns[i] := names[i] ;
      ls[i] := lines[i] ;
      os[i] := open[i]
    END ;
    names := ns ;
    lines := ls ;
    open := os
  END ;
  names[n] := id.au ;
  lines[n] := id.line ;
  open[n] := what = DeclForward ;
  NxAdd (declIx, id.au, n) ;
  n := n + 1
END DeclOnce ;

(* the names a declaration section declares: a CONST, TYPE or
   EXCEPTION declaration is its own name, a VAR declaration the
   identifiers of its list *)
PROCEDURE SectionNames (KEPT sec: Ast.Kid ; RO me: UTF ; RO where: UTF ;
                        VAR names: SLICE OF UTF ; VAR lines: SLICE OF I64 ;
                        VAR open: SLICE OF BOOL ; VAR n: I64) =
VAR i, j : I64 ;
BEGIN
  IF sec IS SOME s THEN
    IF s.kind = Ast.NConstSection OR s.kind = Ast.NTypeSection
       OR s.kind = Ast.NExcSection THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME d THEN
          DeclOnce (d, DeclPlain, me, where, names, lines, open, n)
        END
      END
    ELSIF s.kind = Ast.NVarSection THEN
      FOR i := 0 TO s.nkids - 1 DO
        IF s.kids[i] IS SOME d THEN
          IF d.kids[0] IS SOME ids THEN
            FOR j := 0 TO ids.nkids - 1 DO
              IF ids.kids[j] IS SOME id THEN
                DeclOnce (id, DeclPlain, me, where, names, lines, open, n)
              END
            END
          END
        END
      END
    END
  END
END SectionNames ;

PROCEDURE CheckDeclaredOnce (KEPT u: PTR Ast.Node) =
VAR
  names : SLICE OF UTF ;
  lines : SLICE OF I64 ;
  open : SLICE OF BOOL ;
  n, i, j, k, what : I64 ;
  where : UTF ;
BEGIN
  names := NEW (pool, UTF, 64) ;
  lines := NEW (pool, I64, 64) ;
  open := NEW (pool, BOOL, 64) ;
  n := 0 ;
  where := 'module ' + u.au ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME d THEN
      IF d.kind = Ast.NProcDecl THEN
        what := DeclForward ;
        IF d.nkids > 4 THEN
          IF d.kids[4] IS SOME body THEN what := DeclBody END
        END ;
        DeclOnce (d, what, u.au, where, names, lines, open, n)
      ELSE
        SectionNames (u.kids[i], u.au, where, names, lines, open, n)
      END
    END
  END ;
  (* each procedure: its parameters, then its locals, one scope *)
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME p THEN
      IF p.kind = Ast.NProcDecl THEN
        n := 0 ;
        where := 'procedure ' + p.au ;
        IF p.kids[0] IS SOME params THEN
          FOR j := 0 TO params.nkids - 1 DO
            IF params.kids[j] IS SOME pr THEN
              IF pr.kids[0] IS SOME ids THEN
                FOR k := 0 TO ids.nkids - 1 DO
                  IF ids.kids[k] IS SOME id THEN
                    DeclOnce (id, DeclPlain, u.au, where, names, lines, open, n)
                  END
                END
              END
            END
          END
        END ;
        IF p.nkids > 4 THEN
          IF p.kids[4] IS SOME body THEN
            FOR j := 0 TO body.nkids - 1 DO
              SectionNames (body.kids[j], u.au, where, names, lines, open, n)
            END
          END
        END
      END
    END
  END
END CheckDeclaredOnce ;

(* an IMPLEMENTATION sees the constants of its DEFINITION, the unit of
   the same name in this file.  It saw only its own until 2026-10-02,
   so `n := K` -- K a real constant of the definition, n an I64 --
   passed here, built, and answered 1 for 1.5, while a client's
   `n := Mod.K` was refused.  Found by --review: Http's page listed
   MaxWait as passed over wherever the implementation used it.

   Called AFTER the implementation's own constants are in, and adds
   only a name that is not: a constant the implementation declares
   under the same name is the implementation's. *)
PROCEDURE AddDefConsts (root: PTR Ast.Node ; u: PTR Ast.Node) =
VAR
  i, j, k : I64 ;
  seen : BOOL ;
  ty : UTF ;
BEGIN
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME d THEN
      IF d.kind = Ast.NDefinition AND Text.BLen (d.bu) = 0 AND Text.Eq (d.au, u.au) THEN
        FOR j := 0 TO d.nkids - 1 DO
          IF d.kids[j] IS SOME cs THEN
            IF cs.kind = Ast.NConstSection THEN
              FOR k := 0 TO cs.nkids - 1 DO
                IF cs.kids[k] IS SOME cd THEN
                  ty := ConstType (cd.au, seen) ;
                  IF NOT seen THEN ConstAdd (cd.au, Text.Keep (pool, LitType (cd.kids[0])), cd.kids[0]) END
                END
              END
            END
          END
        END
      END
    END
  END
END AddDefConsts ;

(* an EXCEPTION's fields travel in m9_err's slots -- integers, reals,
   strings -- so each must be an integer, a real, a BOOL, a CHAR, a
   slice or a string, or an enumeration (it goes as its tag).  A record,
   a pointer or a case record with a payload has no slot: the generator
   wrote it into an integer slot and gcc refused (2026-10-10, found
   with an enumeration, which goes as its tag now). *)
PROCEDURE CheckExcFields (u: PTR Ast.Node) =
VAR
  i, j, g : I64 ;
  t : UTF ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME sec THEN
      IF sec.kind = Ast.NExcSection THEN
        FOR j := 0 TO sec.nkids - 1 DO
          IF sec.kids[j] IS SOME xd THEN
            IF xd.kids[0] IS SOME fs THEN
              FOR g := 0 TO fs.nkids - 1 DO
                IF fs.kids[g] IS SOME grp THEN
                  t := CanonT (grp.kids[1], 0) ;
                  IF Text.BLen (t) > 0 AND NOT IsIntish (t) AND
                     NOT Text.Eq (t, 'BOOL') AND NOT Text.Eq (t, 'CHAR') AND
                     NOT Text.Eq (t, 'F64') AND NOT Text.Eq (t, 'F32') AND
                     NOT Text.StartsWith (t, 'SLICE OF ') AND
                     NOT AllPayloadless (ResolveType (grp.kids[1])) THEN
                    ErrN (grp, u.au, S5 ('a field of exception ', xd.au, ' is ',
                      TyName (t), ': a payload is integers, reals, BOOL, CHAR, enumerations and strings -- pass what the handler needs of it'))
                  END
                END
              END
            END
          END
        END
      END
    END
  END
END CheckExcFields ;

(* ---- A TYPE REFERS TO ITSELF ONLY THROUGH A POINTER TO A RECORD
   (2026-10-21, report par 2.2; the compiler review's F2).  `TYPE H =
   PTR H', `A = B ; B = A', an array, slice or grid of itself, a record
   holding itself by value and a procedure type taking itself have no
   size or no end: the checker resolving them looped for ever or ran out
   of stack, and the generator crashed or handed cc an incomplete type.
   Each TYPE of the unit is walked through its parts -- a name to its
   declaration, a pointer's target, an element, a field, a variant's
   fields, a parameter, a result -- and refused when the walk comes back
   to it, except through a pointer to a RECORD, a CASE RECORD or a
   MONITOR, which is the recursion a list or a tree is made of.  Run
   before anything resolves the unit's types; a unit with one is
   checked no further. ---- *)
VAR
  tcSeen : SLICE OF I64 ;
  tcN : I64 ;

(* the declaration of the unit's type nm, and its number in the unit *)
PROCEDURE TcDecl (u: PTR Ast.Node ; RO nm: UTF ; VAR at: I64) : Ast.Kid =
VAR i, j : I64 ;
BEGIN
  (* the unit's TYPE declarations indexed once by name, the first of a
     name kept: a scan per name was n squared in a module's types (the
     review's F5) *)
  IF u.id # tcRoot THEN
    tcRoot := u.id ;
    NxClear (tcIx) ;
    FOR i := 0 TO u.nkids - 1 DO
      IF u.kids[i] IS SOME sec THEN
        IF sec.kind = Ast.NTypeSection THEN
          FOR j := 0 TO sec.nkids - 1 DO
            IF sec.kids[j] IS SOME td0 THEN
              NxAdd (tcIx, Text.Keep (pool, td0.au), i * 100000 + j)
            END
          END
        END
      END
    END
  END ;
  at := NxFind (tcIx, nm) ;
  IF at < 0 THEN RETURN NONE END ;
  IF u.kids[at DIV 100000] IS SOME sec2 THEN
    IF sec2.kids[at MOD 100000] IS SOME td THEN RETURN td.kids[0] END
  END ;
  at := -1 ;
  RETURN NONE
END TcDecl ;

(* is the type a record (by structure, or by a name of this unit that
   is one); another module's name is taken as one, since its own
   check holds its cycles *)
PROCEDURE TcIsRecord (u: PTR Ast.Node ; k: Ast.Kid ; depth: I64) : BOOL =
VAR at : I64 ;
BEGIN
  IF depth > 4096 THEN RETURN FALSE END ;
  IF k IS SOME t THEN
    IF t.kind = Ast.NRecordType OR t.kind = Ast.NCaseRecordType OR
       t.kind = Ast.NMonitorType THEN RETURN TRUE END ;
    IF t.kind = Ast.NQualident THEN
      IF Text.BLen (t.bu) > 0 THEN RETURN TRUE END ;
      RETURN TcIsRecord (u, TcDecl (u, t.au, at), depth + 1)
    END
  END ;
  RETURN FALSE
END TcIsRecord ;

PROCEDURE TcWalk (u: PTR Ast.Node ; k: Ast.Kid ; RO start: UTF ; depth: I64) : BOOL ;

PROCEDURE TcFields (u: PTR Ast.Node ; k: Ast.Kid ; RO start: UTF ; depth: I64) : BOOL =
VAR i : I64 ;
BEGIN
  IF k IS SOME fs THEN
    FOR i := 0 TO fs.nkids - 1 DO
      IF fs.kids[i] IS SOME g THEN
        IF TcWalk (u, g.kids[1], start, depth + 1) THEN RETURN TRUE END
      END
    END
  END ;
  RETURN FALSE
END TcFields ;

PROCEDURE TcWalk (u: PTR Ast.Node ; k: Ast.Kid ; RO start: UTF ; depth: I64) : BOOL =
VAR
  i, at : I64 ;
  d : Ast.Kid ;
  ns : SLICE OF I64 ;
BEGIN
  (* the visited names end the walk; the bound is for the structure
     between them, which the parser bounds per type.  It was 200, and a
     ring of 101 names -- two steps a name -- was no cycle (the second
     review's fuzz N1, 2026-10-26: SIGSEGV in the generator) *)
  IF depth > 100000 THEN RETURN FALSE END ;
  IF k IS SOME t THEN
    CASE t.kind OF
    | Ast.NQualident :
        IF Text.BLen (t.bu) > 0 THEN RETURN FALSE END ;
        IF Text.Eq (t.au, start) THEN RETURN TRUE END ;
        d := TcDecl (u, t.au, at) ;
        IF at < 0 THEN RETURN FALSE END ;
        (* a name walked already for this start did not lead back *)
        FOR i := 0 TO tcN - 1 DO
          IF tcSeen[i] = at THEN RETURN FALSE END
        END ;
        IF tcN >= LEN (tcSeen) THEN
          ns := NEW (pool, I64, 2 * tcN) ;
          FOR i := 0 TO tcN - 1 DO ns[i] := tcSeen[i] END ;
          tcSeen := ns
        END ;
        tcSeen[tcN] := at ;
        tcN := tcN + 1 ;
        RETURN TcWalk (u, d, start, depth + 1)
    | Ast.NPtrType, Ast.NSharedType :
        IF TcIsRecord (u, t.kids[0], 0) THEN RETURN FALSE END ;
        RETURN TcWalk (u, t.kids[0], start, depth + 1)
    | Ast.NOptType, Ast.NSliceType :
        RETURN TcWalk (u, t.kids[0], start, depth + 1)
    | Ast.NArrayType, Ast.NGridType :
        RETURN TcWalk (u, t.kids[1], start, depth + 1)
    | Ast.NRecordType :
        RETURN TcFields (u, t.kids[1], start, depth)
    | Ast.NMonitorType :
        RETURN TcFields (u, t.kids[0], start, depth)
    | Ast.NCaseRecordType :
        FOR i := 0 TO t.nkids - 1 DO
          IF t.kids[i] IS SOME v THEN
            IF TcFields (u, v.kids[0], start, depth) THEN RETURN TRUE END
          END
        END ;
        RETURN FALSE
    | Ast.NProcType :
        IF TcFields (u, t.kids[0], start, depth) THEN RETURN TRUE END ;
        RETURN TcWalk (u, t.kids[1], start, depth + 1)
    ELSE
      RETURN FALSE
    END
  END ;
  RETURN FALSE
END TcWalk ;

PROCEDURE TypeCycles (u: PTR Ast.Node) : BOOL =
VAR
  i, j : I64 ;
  found : BOOL ;
BEGIN
  found := FALSE ;
  tcSeen := NEW (pool, I64, 4096) ;
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME sec THEN
      IF sec.kind = Ast.NTypeSection THEN
        FOR j := 0 TO sec.nkids - 1 DO
          IF sec.kids[j] IS SOME td THEN
            tcN := 0 ;
            IF TcWalk (u, td.kids[0], td.au, 0) THEN
              ErrN (td, u.au, Cat (Cat ('type ', td.au),
                ' refers to itself other than through a pointer to a record: it would have no size or no end -- point to it with PTR from a RECORD field (par 2.2)')) ;
              found := TRUE
            END
          END
        END
      END
    END
  END ;
  RETURN found
END TypeCycles ;

(* ---- A FIELD, A VARIANT ARM'S FIELD, AN ENUMERATION MEMBER: ONCE
   (2026-10-22, the compiler review's F4).  `RECORD a : I64 ; a : I64
   END' passed the checker and cc refused the duplicate member; `(A, B,
   A)' compiled, and the second A was the first.  Every record, monitor,
   variant arm and enumeration of the unit's types, nested ones too,
   is held to one name each. ---- *)
(* the names of one list -- a field sequence, an enumeration -- in the
   scope sc (OnceScope): a scan of the names before was quadratic in a
   record's fields *)
PROCEDURE OnceScope () : I64 =
BEGIN
  onceGen := onceGen + 1 ;
  RETURN onceGen
END OnceScope ;

PROCEDURE OnceNames (n: PTR Ast.Node ; ids: Ast.Kid ; RO what: UTF ;
                     sc: I64 ; RO ctx: UTF) =
VAR
  i : I64 ;
  key : UTF ;
BEGIN
  IF ids IS SOME il THEN
    FOR i := 0 TO il.nkids - 1 DO
      IF il.kids[i] IS SOME id THEN
        key := Cat (Cat (ItoA (sc), ' '), id.au) ;
        IF NxFind (onceIx, key) >= 0 THEN
          ErrN (id, ctx, Cat (Cat (id.au, ' is declared twice in '), Cat (what, ' (par 2.2)')))
        ELSE
          NxAdd (onceIx, Text.Keep (pool, key), 1)
        END
      END
    END
  END
END OnceNames ;

PROCEDURE FieldsOnceIn (k: Ast.Kid ; RO what: UTF ; RO ctx: UTF) ;

(* the fields of one field sequence, and the types inside them *)
PROCEDURE FieldSeqOnce (fsk: Ast.Kid ; RO what: UTF ; RO ctx: UTF) =
VAR
  g, sc : I64 ;
BEGIN
  sc := OnceScope () ;
  IF fsk IS SOME fs THEN
    FOR g := 0 TO fs.nkids - 1 DO
      IF fs.kids[g] IS SOME grp THEN
        OnceNames (grp, grp.kids[0], what, sc, ctx) ;
        FieldsOnceIn (grp.kids[1], what, ctx)
      END
    END
  END
END FieldSeqOnce ;

PROCEDURE FieldsOnceIn (k: Ast.Kid ; RO what: UTF ; RO ctx: UTF) =
VAR
  i : I64 ;
BEGIN
  IF k IS SOME t THEN
    CASE t.kind OF
    | Ast.NRecordType : FieldSeqOnce (t.kids[1], what, ctx)
    | Ast.NMonitorType : FieldSeqOnce (t.kids[0], what, ctx)
    | Ast.NCaseRecordType :
        FOR i := 0 TO t.nkids - 1 DO
          IF t.kids[i] IS SOME v THEN
            FieldSeqOnce (v.kids[0], Cat (Cat (what, ' arm '), v.au), ctx)
          END
        END
    | Ast.NEnumType :
        OnceNames (t, SOME (t), what, OnceScope (), ctx)
    | Ast.NPtrType, Ast.NOptType, Ast.NSharedType, Ast.NSliceType :
        FieldsOnceIn (t.kids[0], what, ctx)
    | Ast.NArrayType, Ast.NGridType :
        FieldsOnceIn (t.kids[1], what, ctx)
    ELSE
    END
  END
END FieldsOnceIn ;

(* ---- A BINDER: ONCE IN ITS LIST (2026-10-25; the case decision 26
   left open).  `| Bad (c, c) :' and `| Pair.Two (x, x) :' passed the
   checker and cc refused the redefinition.  A handler's names are its
   kids[1] (literal patterns are no names), a variant pattern's its
   kids[0]. ---- *)
PROCEDURE BindersOnce (k: Ast.Kid ; RO ctx: UTF) =
VAR
  i, j, nseen : I64 ;
  seen : SLICE OF UTF ;
  dup : BOOL ;
  ids : Ast.Kid ;
  what : UTF ;
BEGIN
  IF k IS SOME e THEN
    ids := NONE ;
    what := '' ;
    IF e.kind = Ast.NHandler AND e.nkids > 1 THEN
      ids := e.kids[1] ;
      what := 'the binders of a handler'
    ELSIF e.kind = Ast.NLabelPattern AND e.nkids > 0 THEN
      ids := e.kids[0] ;
      what := Cat ('the binders of ', e.au)
    END ;
    IF ids IS SOME il THEN
      nseen := 0 ;
      seen := NEW (UTF, il.nkids + 1) ;
      FOR i := 0 TO il.nkids - 1 DO
        IF il.kids[i] IS SOME id THEN
          IF id.kind = Ast.NIdent THEN
            dup := FALSE ;
            FOR j := 0 TO nseen - 1 DO
              IF Text.Eq (seen[j], id.au) THEN dup := TRUE END
            END ;
            IF dup THEN
              ErrN (id, ctx, Cat (Cat (id.au, ' is declared twice in '), Cat (what, ' (par 2.2)')))
            ELSE
              seen[nseen] := id.au ;
              nseen := nseen + 1
            END
          END
        END
      END
    END ;
    FOR i := 0 TO e.nkids - 1 DO BindersOnce (e.kids[i], ctx) END
  END
END BindersOnce ;

PROCEDURE CheckFieldsOnce (u: PTR Ast.Node) =
VAR i, j : I64 ;
BEGIN
  FOR i := 0 TO u.nkids - 1 DO
    IF u.kids[i] IS SOME sec THEN
      IF sec.kind = Ast.NTypeSection THEN
        FOR j := 0 TO sec.nkids - 1 DO
          IF sec.kids[j] IS SOME td THEN
            FieldsOnceIn (td.kids[0], Cat ('type ', td.au), u.au)
          END
        END
      END
    END
  END
END CheckFieldsOnce ;

PROCEDURE CheckFile (VAR KEPT root: PTR Ast.Node) =
VAR i, j, k, fm : I64 ;
BEGIN
  Setup () ;
  curRoot := root ;
  (* a file with no unit -- empty, or comments only -- checked clean and
     failed at the link (the review's F4) *)
  IF root.nkids = 0 THEN
    ErrN (root, 'file', 'the file holds no unit: a MODULE, DEFINITION MODULE or IMPLEMENTATION MODULE (par 3)')
  END ;
  FOR i := 0 TO root.nkids - 1 DO
    IF root.kids[i] IS SOME u THEN
      curMod := u.au ;
      curUnsafe := u.f1 ;
      (* FROM csock IMPORT Read, Write: a bare callee names its
         module through this, and without it the resolution would
         fall back to the current module and miss *)
      FromClear () ;
      FOR j := 0 TO u.nkids - 1 DO
        IF u.kids[j] IS SOME imp THEN
          IF imp.kind = Ast.NFromImport THEN
            (* FROM is for foreign FOR-C units only (there is no
               u.m9 to resolve).  A FROM of a loaded M9 module is a
               Modula-2 habit the generator cannot honour -- catch
               it HERE, at the mistake, not as a gen error later *)
            fm := FindMod (imp.au) ;
            IF fm >= 0 THEN
              IF Text.BLen (mods[fm].foreignLang) = 0 THEN
                ErrN (imp, u.au,
                  'FROM imports from a foreign FOR-C unit; ' + imp.au +
                  ' is an M9 module -- use IMPORT ' + imp.au +
                  ' and write ' + imp.au + '.Name')
              END
            END ;
            IF imp.kids[0] IS SOME ids THEN
              FOR k := 0 TO ids.nkids - 1 DO
                IF ids.kids[k] IS SOME id THEN FromAdd (id.au, imp.au) END
              END
            END
          END
        END
      END ;
      CheckImports (root, u) ;
      ExportWalk (u, root, u.au, NONE) ;
      CheckDeclaredOnce (u) ;
      IF TypeCycles (u) THEN RETURN END ;
      CheckFieldsOnce (u) ;
      BindersOnce (SOME (u), u.au) ;
      CheckExcFields (u) ;
      RecordAttribWalk (SOME (u), u.au) ;
      (* module CONSTs, so a designator naming one has a type *)
      ConstClear () ;
      FOR j := 0 TO u.nkids - 1 DO
        IF u.kids[j] IS SOME cs THEN
          IF cs.kind = Ast.NConstSection THEN
            FOR k := 0 TO cs.nkids - 1 DO
              IF cs.kids[k] IS SOME cd THEN
                IF u.kind = Ast.NDefinition THEN
                  CheckAggregate (cd, u.au, 1)
                ELSE
                  CheckAggregate (cd, u.au, 0)
                END ;
                ConstAdd (cd.au, Text.Keep (pool, LitType (cd.kids[0])), cd.kids[0])
              END
            END
          END
        END
      END ;
      IF u.kind = Ast.NImplementation THEN AddDefConsts (root, u) END ;
      ModRoSeed (root, u) ;
      IF u.kind = Ast.NDefinition AND Text.BLen (u.bu) > 0 THEN
        CheckForeignDef (u)
      ELSE
        (* declarations before bodies: a type spelled wrong is
           reported where it is written, once, ahead of whatever the
           bodies make of a variable that has no type *)
        CheckDeclTypes (u) ;
        IF u.kind = Ast.NImplementation THEN CheckConformance (u) END ;
        FOR j := 0 TO u.nkids - 1 DO
          IF u.kids[j] IS SOME d THEN
            IF d.kind = Ast.NProcDecl THEN
              IF NOT Collapsed (d.au) THEN
                CheckProcBody (u, d, Qualify (u.au, d.au))
              END
            ELSIF d.kind = Ast.NModBody THEN
              (* the module body is a frame too, and the one with no
                 caller: its ctx is 'Mod body', as the oracle says *)
              ScopeClear () ;
              CallsClear () ;
              AddModuleVars (curRoot, u) ;
              curRetTy := '<void>' ;
              curProcNm := '' ;
              RaisedClear () ;
              (* never PURE, and the flag must be CLEARED rather than
                 inherited from whichever procedure was checked last
                 -- it leaked into this frame on the first run of the
                 host side and reported the body writing its own
                 module variables *)
              curPure := FALSE ;
              curFresh := FALSE ;
              nfval := 0 ;
              npval := 0 ;
              curInBody := TRUE ;
              boundMon := '' ;      (* a module body binds no monitor *)
              boundMonId := -1 ;
              IF nAgg > 0 THEN
                AggWalk (d, Ast.NModBody, Cat (u.au, ' body'))
              END ;
              (* the body moves the module's own variables as a
                 procedure moves its locals: `p := NEW (OWN, T) ; Eat
                 (p) ; p.v := 1' was accepted here, and the table still
                 held the last procedure's names *)
              OwnClear () ;
              ownModule := TRUE ;
              OwnSeed () ;
              (* what in the body gives a module variable an owned pointer,
                 as a procedure's locals are seeded (CheckProcBody; the
                 Pascal twin's CheckBody always did): `c := Id (b) ;
                 DISPOSE (c)' in the body was accepted (SanDisposeModVar) *)
              OwnFedSeed (d.kids[0]) ;
              WalkStmt (d.kids[0], Cat (u.au, ' body')) ;
              (* the owner walk over the body too, its module variables
                 the owners (the fourth review's A06) *)
              olInBody := TRUE ;
              OlProc (d, d.kids[0], Cat (u.au, ' body')) ;
              olInBody := FALSE ;
              ownModule := FALSE ;
              (* the module body has no caller to declare RAISES to,
                 and so no clause: whatever it can raise, it must
                 handle.  museum/trunc-nan is exactly this. *)
              ReportUnhandled (d, Cat (u.au, ' body'),
                NEW (pool, UTF, 0))
            END
          END
        END
      END
    END
  END
END CheckFile ;

PROCEDURE ShowType (RO KEPT name: UTF) =
BEGIN
  showName := UTF (pool, name) ;
  shownRaises := ' '
END ShowType ;

PROCEDURE ShownRaises () : UTF =
BEGIN
  RETURN shownRaises
END ShownRaises ;

PROCEDURE ShownType () : UTF =
BEGIN
  RETURN shown
END ShownType ;

END Sem.
