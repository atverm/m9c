(* ---- end of the Unicode tables ---- *)

(* ---- sets of code points ------------------------------------------- *)

PROCEDURE SetNew (VAR sp: POOL ; VAR st: Set) =
BEGIN
  st.lo := NEW (sp, I64, 8) ;
  st.hi := NEW (sp, I64, 8) ;
  st.n := 0
END SetNew ;

PROCEDURE SetAdd (VAR sp: POOL ; VAR st: Set ; lo, hi: I64) =
VAR
  nl, nh : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF st.n = LEN (st.lo) THEN
    nl := NEW (sp, I64, 2 * LEN (st.lo)) ;
    nh := NEW (sp, I64, 2 * LEN (st.lo)) ;
    FOR i := 0 TO st.n - 1 DO nl[i] := st.lo[i] ; nh[i] := st.hi[i] END ;
    st.lo := nl ;
    st.hi := nh
  END ;
  st.lo[st.n] := lo ;
  st.hi[st.n] := hi ;
  st.n := st.n + 1
END SetAdd ;

PROCEDURE SetAddTable (VAR sp: POOL ; VAR st: Set ; RO lo: SLICE OF I64 ;
                       RO hi: SLICE OF I64) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (lo) - 1 DO SetAdd (sp, st, lo[i], hi[i]) END
END SetAddTable ;

PROCEDURE SetNormal (VAR st: Set) =
  (* sorted by start, overlapping and adjacent ranges merged *)
VAR i, j, k, a, b : I64 ;
BEGIN
  FOR i := 1 TO st.n - 1 DO
    a := st.lo[i] ;
    b := st.hi[i] ;
    j := i - 1 ;
    WHILE j >= 0 AND st.lo[j] > a DO
      st.lo[j + 1] := st.lo[j] ;
      st.hi[j + 1] := st.hi[j] ;
      j := j - 1
    END ;
    st.lo[j + 1] := a ;
    st.hi[j + 1] := b
  END ;
  k := 0 ;
  FOR i := 0 TO st.n - 1 DO
    IF k > 0 AND st.lo[i] <= st.hi[k - 1] + 1 THEN
      IF st.hi[i] > st.hi[k - 1] THEN st.hi[k - 1] := st.hi[i] END
    ELSE
      st.lo[k] := st.lo[i] ;
      st.hi[k] := st.hi[i] ;
      k := k + 1
    END
  END ;
  st.n := k
END SetNormal ;

PROCEDURE SetNegate (VAR sp: POOL ; VAR st: Set) =
  (* every code point the normal set does not hold *)
VAR
  out : Set ;
  i, next : I64 ;
BEGIN
  SetNew (sp, out) ;
  next := 0 ;
  FOR i := 0 TO st.n - 1 DO
    IF st.lo[i] > next THEN SetAdd (sp, out, next, st.lo[i] - 1) END ;
    next := st.hi[i] + 1
  END ;
  IF next <= MaxCode THEN SetAdd (sp, out, next, MaxCode) END ;
  st := out
END SetNegate ;

PROCEDURE SetCaseless (VAR sp: POOL ; VAR st: Set) =
  (* the ASCII letters' other case added *)
VAR i, n, a, b : I64 ;
BEGIN
  n := st.n ;
  FOR i := 0 TO n - 1 DO
    a := st.lo[i] ;
    b := st.hi[i] ;
    IF a < 97 THEN a := 97 END ;
    IF b > 122 THEN b := 122 END ;
    IF a <= b THEN SetAdd (sp, st, a - 32, b - 32) END ;
    a := st.lo[i] ;
    b := st.hi[i] ;
    IF a < 65 THEN a := 65 END ;
    IF b > 90 THEN b := 90 END ;
    IF a <= b THEN SetAdd (sp, st, a + 32, b + 32) END
  END
END SetCaseless ;

PROCEDURE InTable (RO lo: SLICE OF I64 ; RO hi: SLICE OF I64 ;
                   at, n, c: I64) : BOOL =
  (* c in one of the n sorted ranges from index at: a binary search *)
VAR a, b, m : I64 ;
BEGIN
  a := at ;
  b := at + n - 1 ;
  WHILE a <= b DO
    m := (a + b) DIV 2 ;
    IF c < lo[m] THEN b := m - 1
    ELSIF c > hi[m] THEN a := m + 1
    ELSE RETURN TRUE
    END
  END ;
  RETURN FALSE
END InTable ;

PROCEDURE IsWord (c: I64 ; uni: BOOL) : BOOL =
BEGIN
  IF c < 128 THEN
    RETURN (c >= 97 AND c <= 122) OR (c >= 65 AND c <= 90) OR
           (c >= 48 AND c <= 57) OR c = 95
  END ;
  IF NOT uni THEN RETURN FALSE END ;
  RETURN InTable (UWordLo, UWordHi, 0, LEN (UWordLo), c)
END IsWord ;

PROCEDURE SetAddEscape (VAR sp: POOL ; VAR st: Set ; e: CHAR ; uni: BOOL) =
  (* \d \D \s \S \w \W *)
VAR one : Set ;
BEGIN
  SetNew (sp, one) ;
  IF e = 'd' OR e = 'D' THEN
    IF uni THEN SetAddTable (sp, one, UDigitLo, UDigitHi)
    ELSE SetAdd (sp, one, 48, 57)
    END
  ELSIF e = 's' OR e = 'S' THEN
    IF uni THEN SetAddTable (sp, one, USpaceLo, USpaceHi)
    ELSE
      SetAdd (sp, one, 9, 13) ;
      SetAdd (sp, one, 32, 32)
    END
  ELSE
    IF uni THEN SetAddTable (sp, one, UWordLo, UWordHi)
    ELSE
      SetAdd (sp, one, 48, 57) ;
      SetAdd (sp, one, 65, 90) ;
      SetAdd (sp, one, 95, 95) ;
      SetAdd (sp, one, 97, 122)
    END
  END ;
  SetNormal (one) ;
  IF e = 'D' OR e = 'S' OR e = 'W' THEN SetNegate (sp, one) END ;
  SetAddTable (sp, st, SLICE (one.lo, 0, one.n), SLICE (one.hi, 0, one.n))
END SetAddEscape ;

(* ---- the compiled pattern ------------------------------------------ *)

PROCEDURE NewRe (VAR pool: POOL) : PTR Re IN pool =
VAR re : PTR Re IN pool ;
BEGIN
  re := NEW (pool, Re) ;
  re.op := NEW (pool, I64, 64) ;
  re.x := NEW (pool, I64, 64) ;
  re.y := NEW (pool, I64, 64) ;
  re.n := 0 ;
  re.lo := NEW (pool, I64, 16) ;
  re.hi := NEW (pool, I64, 16) ;
  re.nr := 0 ;
  re.clsAt := NEW (pool, I64, 8) ;
  re.clsLen := NEW (pool, I64, 8) ;
  re.nc := 0 ;
  re.ngroups := 0 ;
  re.nslots := 0 ;
  re.names := NEW (pool, STR, 4) ;
  re.nameGroup := NEW (pool, I64, 4) ;
  re.nnames := 0 ;
  re.uni := FALSE ;
  RETURN re
END NewRe ;

PROCEDURE AddClass (VAR re: PTR Re ; RO st: Set) : I64 =
  (* a normal set kept as the pattern's next class *)
VAR
  nl, nh : SLICE OF I64 ;
  na, nn : SLICE OF I64 ;
  i, cap : I64 ;
BEGIN
  IF re.nr + st.n > LEN (re.lo) THEN
    cap := 2 * LEN (re.lo) ;
    WHILE cap < re.nr + st.n DO cap := 2 * cap END ;
    nl := NEW (re, I64, cap) ;
    nh := NEW (re, I64, cap) ;
    FOR i := 0 TO re.nr - 1 DO nl[i] := re.lo[i] ; nh[i] := re.hi[i] END ;
    re.lo := nl ;
    re.hi := nh
  END ;
  IF re.nc = LEN (re.clsAt) THEN
    na := NEW (re, I64, 2 * re.nc) ;
    nn := NEW (re, I64, 2 * re.nc) ;
    FOR i := 0 TO re.nc - 1 DO na[i] := re.clsAt[i] ; nn[i] := re.clsLen[i] END ;
    re.clsAt := na ;
    re.clsLen := nn
  END ;
  re.clsAt[re.nc] := re.nr ;
  re.clsLen[re.nc] := st.n ;
  FOR i := 0 TO st.n - 1 DO
    re.lo[re.nr + i] := st.lo[i] ;
    re.hi[re.nr + i] := st.hi[i]
  END ;
  re.nr := re.nr + st.n ;
  re.nc := re.nc + 1 ;
  RETURN re.nc - 1
END AddClass ;

PROCEDURE AddName (VAR re: PTR Re ; RO name: STR ; group: I64) =
VAR
  nn : SLICE OF STR ;
  ng : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF re.nnames = LEN (re.names) THEN
    nn := NEW (re, STR, 2 * re.nnames) ;
    ng := NEW (re, I64, 2 * re.nnames) ;
    FOR i := 0 TO re.nnames - 1 DO nn[i] := re.names[i] ; ng[i] := re.nameGroup[i] END ;
    re.names := nn ;
    re.nameGroup := ng
  END ;
  re.names[re.nnames] := NEW (re, CHAR, LEN (name)) ;
  FOR i := 0 TO LEN (name) - 1 DO re.names[re.nnames][i] := name[i] END ;
  re.nameGroup[re.nnames] := group ;
  re.nnames := re.nnames + 1
END AddName ;

PROCEDURE Emit (VAR re: PTR Re ; op, x, y: I64) : I64 RAISES BadPattern =
VAR
  no, nx, ny : SLICE OF I64 ;
  i : I64 ;
BEGIN
  IF re.n >= MaxInst THEN
    RAISE BadPattern ('the pattern is too large: more than 100000 instructions', 0)
  END ;
  IF re.n = LEN (re.op) THEN
    no := NEW (re, I64, 2 * re.n) ;
    nx := NEW (re, I64, 2 * re.n) ;
    ny := NEW (re, I64, 2 * re.n) ;
    FOR i := 0 TO re.n - 1 DO no[i] := re.op[i] ; nx[i] := re.x[i] ; ny[i] := re.y[i] END ;
    re.op := no ;
    re.x := nx ;
    re.y := ny
  END ;
  re.op[re.n] := op ;
  re.x[re.n] := x ;
  re.y[re.n] := y ;
  re.n := re.n + 1 ;
  RETURN re.n - 1
END Emit ;

(* ---- the parser --------------------------------------------------- *)

PROCEDURE Mk (VAR sp: POOL ; kind, v: I64) : PTR Node IN sp =
VAR nd : PTR Node IN sp ;
BEGIN
  nd := NEW (sp, Node) ;
  nd.kind := kind ;
  nd.v := v ;
  nd.min := 0 ;
  nd.max := 0 ;
  nd.greedy := TRUE ;
  nd.kids := NEW (sp, NodeP, 2) ;
  nd.nk := 0 ;
  RETURN nd
END Mk ;

PROCEDURE AddKid (VAR sp: POOL ; VAR nd: PTR Node ; KEPT kid: PTR Node) =
VAR
  nk : SLICE OF PTR Node ;
  i : I64 ;
BEGIN
  IF nd.nk = LEN (nd.kids) THEN
    nk := NEW (sp, NodeP, 2 * nd.nk) ;
    FOR i := 0 TO nd.nk - 1 DO nk[i] := nd.kids[i] END ;
    nd.kids := nk
  END ;
  nd.kids[nd.nk] := kid ;
  nd.nk := nd.nk + 1
END AddKid ;

PROCEDURE Fail (VAR ps: Parser ; RO msg: STR ; at: I64) RAISES BadPattern =
BEGIN
  RAISE BadPattern (msg, at)
END Fail ;

PROCEDURE AtEnd (VAR ps: Parser) : BOOL =
BEGIN
  RETURN ps.pos >= LEN (ps.p)
END AtEnd ;

PROCEDURE Cur (VAR ps: Parser) : CHAR =
  (* the character at pos, NUL past the end *)
BEGIN
  IF ps.pos >= LEN (ps.p) THEN RETURN 00C END ;
  RETURN ps.p[ps.pos]
END Cur ;

PROCEDURE At (VAR ps: Parser ; k: I64) : CHAR =
BEGIN
  IF ps.pos + k >= LEN (ps.p) THEN RETURN 00C END ;
  RETURN ps.p[ps.pos + k]
END At ;

PROCEDURE IsDigit (c: CHAR) : BOOL =
BEGIN
  RETURN c >= '0' AND c <= '9'
END IsDigit ;

PROCEDURE IsOct (c: CHAR) : BOOL =
BEGIN
  RETURN c >= '0' AND c <= '7'
END IsOct ;

PROCEDURE HexVal (c: CHAR) : I64 =
  (* the digit's value, -1 for no hex digit *)
BEGIN
  IF c >= '0' AND c <= '9' THEN RETURN ORD (c) - 48 END ;
  IF c >= 'a' AND c <= 'f' THEN RETURN ORD (c) - 87 END ;
  IF c >= 'A' AND c <= 'F' THEN RETURN ORD (c) - 55 END ;
  RETURN -1
END HexVal ;

PROCEDURE IsAsciiLetter (c: CHAR) : BOOL =
BEGIN
  RETURN (c >= 'a' AND c <= 'z') OR (c >= 'A' AND c <= 'Z')
END IsAsciiLetter ;

PROCEDURE Hex (VAR ps: Parser ; n, at: I64) : I64 RAISES BadPattern =
  (* exactly n hex digits at pos *)
VAR i, v, d : I64 ;
BEGIN
  v := 0 ;
  FOR i := 1 TO n DO
    d := HexVal (Cur (ps)) ;
    IF d < 0 THEN Fail (ps, 'incomplete escape', at) END ;
    v := v * 16 + d ;
    ps.pos := ps.pos + 1
  END ;
  IF v > MaxCode THEN Fail (ps, 'bad escape: past U+10FFFF', at) END ;
  IF v >= 0xD800 AND v <= 0xDFFF THEN
    Fail (ps, 'a surrogate escape: a CHAR is a code point, never half of one', at)
  END ;
  RETURN v
END Hex ;

PROCEDURE CharEscape (VAR ps: Parser ; c: CHAR ; at: I64 ; VAR code: I64)
  : BOOL RAISES BadPattern =
  (* the escapes that name one character, in a class and out of one;
     pos is past the letter.  FALSE: c is not one of them *)
VAR v : I64 ;
BEGIN
  IF c = 'a' THEN code := 7
  ELSIF c = 'f' THEN code := 12
  ELSIF c = 'n' THEN code := 10
  ELSIF c = 'r' THEN code := 13
  ELSIF c = 't' THEN code := 9
  ELSIF c = 'v' THEN code := 11
  ELSIF c = 'x' THEN code := Hex (ps, 2, at)
  ELSIF c = 'u' THEN code := Hex (ps, 4, at)
  ELSIF c = 'U' THEN code := Hex (ps, 8, at)
  ELSIF c = 'N' THEN
    Fail (ps, 'a \N{...} name: write the character, or \u with its code', at)
  ELSIF c = '0' THEN
    (* \0 and up to two more octal digits *)
    v := 0 ;
    IF IsOct (Cur (ps)) THEN
      v := ORD (Cur (ps)) - 48 ;
      ps.pos := ps.pos + 1 ;
      IF IsOct (Cur (ps)) THEN
        v := v * 8 + ORD (Cur (ps)) - 48 ;
        ps.pos := ps.pos + 1
      END
    END ;
    code := v
  ELSE
    RETURN FALSE
  END ;
  RETURN TRUE
END CharEscape ;

PROCEDURE CharNode (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re ; code: I64)
  : PTR Node IN sp =
  (* one character: a class of its two cases under i *)
VAR st : Set ;
BEGIN
  IF ps.ci AND ((code >= 65 AND code <= 90) OR (code >= 97 AND code <= 122)) THEN
    SetNew (sp, st) ;
    SetAdd (sp, st, code, code) ;
    SetCaseless (sp, st) ;
    SetNormal (st) ;
    RETURN Mk (sp, NClass, AddClass (re, st))
  END ;
  RETURN Mk (sp, NChar, code)
END CharNode ;

PROCEDURE Escape (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re)
  : PTR Node IN sp RAISES BadPattern =
  (* at a backslash outside a class *)
VAR
  at, code, v : I64 ;
  c : CHAR ;
  st : Set ;
BEGIN
  at := ps.pos ;
  ps.pos := ps.pos + 1 ;
  IF AtEnd (ps) THEN Fail (ps, 'bad escape (end of pattern)', at) END ;
  c := Cur (ps) ;
  ps.pos := ps.pos + 1 ;
  IF c = 'A' THEN RETURN Mk (sp, NAssert, ABot) END ;
  IF c = 'Z' THEN RETURN Mk (sp, NAssert, AEot) END ;
  IF c = 'b' THEN RETURN Mk (sp, NAssert, AWord) END ;
  IF c = 'B' THEN RETURN Mk (sp, NAssert, ANotWord) END ;
  IF c = 'd' OR c = 'D' OR c = 's' OR c = 'S' OR c = 'w' OR c = 'W' THEN
    SetNew (sp, st) ;
    SetAddEscape (sp, st, c, ps.uni) ;
    SetNormal (st) ;
    RETURN Mk (sp, NClass, AddClass (re, st))
  END ;
  IF CharEscape (ps, c, at, code) THEN RETURN CharNode (sp, ps, re, code) END ;
  IF c >= '1' AND c <= '9' THEN
    (* three octal digits are a character; anything else a group *)
    IF IsOct (c) AND IsOct (Cur (ps)) AND IsOct (At (ps, 1)) THEN
      v := (ORD (c) - 48) * 64 + (ORD (Cur (ps)) - 48) * 8 + ORD (At (ps, 1)) - 48 ;
      ps.pos := ps.pos + 2 ;
      IF v > 255 THEN Fail (ps, 'octal escape value outside of range 0-0o377', at) END ;
      RETURN CharNode (sp, ps, re, v)
    END ;
    Fail (ps, 'a backreference: it needs backtracking, which this engine does not do', at)
  END ;
  IF IsAsciiLetter (c) THEN Fail (ps, 'bad escape \' + c, at) END ;
  RETURN CharNode (sp, ps, re, ORD (c))
END Escape ;

PROCEDURE ClassItem (VAR sp: POOL ; VAR ps: Parser ; VAR one: Set ;
                     VAR code: I64) : BOOL RAISES BadPattern =
  (* one item of a class at pos: TRUE and its code for one character,
     FALSE and the set in one for \d \w \s and their negations *)
VAR
  at : I64 ;
  c : CHAR ;
BEGIN
  at := ps.pos ;
  c := Cur (ps) ;
  ps.pos := ps.pos + 1 ;
  IF c # '\' THEN code := ORD (c) ; RETURN TRUE END ;
  IF AtEnd (ps) THEN Fail (ps, 'bad escape (end of pattern)', at) END ;
  c := Cur (ps) ;
  ps.pos := ps.pos + 1 ;
  IF c = 'd' OR c = 'D' OR c = 's' OR c = 'S' OR c = 'w' OR c = 'W' THEN
    SetNew (sp, one) ;
    SetAddEscape (sp, one, c, ps.uni) ;
    RETURN FALSE
  END ;
  IF c = 'b' THEN code := 8 ; RETURN TRUE END ;
  IF c >= '1' AND c <= '7' THEN
    (* up to three octal digits in all *)
    code := ORD (c) - 48 ;
    IF IsOct (Cur (ps)) THEN
      code := code * 8 + ORD (Cur (ps)) - 48 ;
      ps.pos := ps.pos + 1 ;
      IF IsOct (Cur (ps)) THEN
        code := code * 8 + ORD (Cur (ps)) - 48 ;
        ps.pos := ps.pos + 1
      END
    END ;
    IF code > 255 THEN Fail (ps, 'octal escape value outside of range 0-0o377', at) END ;
    RETURN TRUE
  END ;
  IF CharEscape (ps, c, at, code) THEN RETURN TRUE END ;
  IF IsAsciiLetter (c) OR IsDigit (c) THEN Fail (ps, 'bad escape \' + c, at) END ;
  code := ORD (c) ;
  RETURN TRUE
END ClassItem ;

PROCEDURE ParseClass (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re)
  : PTR Node IN sp RAISES BadPattern =
  (* at [ -- Python's own loop: a ] first is a character, a - next to
     ] or after a range is a character *)
VAR
  st, one, two : Set ;
  at, a, b : I64 ;
  neg, single1, single2 : BOOL ;
BEGIN
  at := ps.pos ;
  ps.pos := ps.pos + 1 ;
  neg := FALSE ;
  IF Cur (ps) = '^' THEN neg := TRUE ; ps.pos := ps.pos + 1 END ;
  SetNew (sp, st) ;
  LOOP
    IF AtEnd (ps) THEN Fail (ps, 'unterminated character set', at) END ;
    (* a ] closes the set once it holds something: every item adds *)
    IF Cur (ps) = ']' AND st.n > 0 THEN ps.pos := ps.pos + 1 ; EXIT END ;
    single1 := ClassItem (sp, ps, one, a) ;
    IF Cur (ps) = '-' THEN
      ps.pos := ps.pos + 1 ;
      IF AtEnd (ps) THEN Fail (ps, 'unterminated character set', at) END ;
      IF Cur (ps) = ']' THEN
        IF single1 THEN SetAdd (sp, st, a, a)
        ELSE SetAddTable (sp, st, SLICE (one.lo, 0, one.n), SLICE (one.hi, 0, one.n))
        END ;
        SetAdd (sp, st, 45, 45) ;
        ps.pos := ps.pos + 1 ;
        EXIT
      END ;
      single2 := ClassItem (sp, ps, two, b) ;
      IF NOT single1 OR NOT single2 THEN Fail (ps, 'bad character range', at) END ;
      IF b < a THEN Fail (ps, 'bad character range', at) END ;
      SetAdd (sp, st, a, b)
    ELSIF single1 THEN
      SetAdd (sp, st, a, a)
    ELSE
      SetAddTable (sp, st, SLICE (one.lo, 0, one.n), SLICE (one.hi, 0, one.n))
    END
  END ;
  IF ps.ci THEN SetCaseless (sp, st) END ;
  SetNormal (st) ;
  IF neg THEN SetNegate (sp, st) END ;
  RETURN Mk (sp, NClass, AddClass (re, st))
END ParseClass ;

PROCEDURE Flags (VAR ps: Parser ; c: CHAR ; on: BOOL ; at: I64 ; scoped: BOOL)
  RAISES BadPattern =
  (* one inline flag letter *)
BEGIN
  IF c = 'i' THEN
    IF on AND ps.uni THEN
      Fail (ps, 'case-insensitive Unicode matching is not built: drop u, or spell both cases', at)
    END ;
    ps.ci := on
  ELSIF c = 'm' THEN ps.ml := on
  ELSIF c = 's' THEN ps.da := on
  ELSIF c = 'a' OR c = 'u' THEN
    IF scoped OR NOT on THEN Fail (ps, 'a scoped or negated a or u flag: give it to the whole pattern', at) END ;
    ps.uni := c = 'u' ;
    IF ps.uni AND ps.ci THEN
      Fail (ps, 'case-insensitive Unicode matching is not built: drop u, or spell both cases', at)
    END
  ELSIF c = 'x' THEN
    Fail (ps, 'a verbose pattern: write it without the blanks and comments', at)
  ELSE
    Fail (ps, 'unknown flag', at)
  END
END Flags ;

PROCEDURE GroupName (VAR ps: Parser ; at: I64) : STR RAISES BadPattern =
  (* at the name's first character; pos past the closing > *)
VAR
  s : STR ;
  c : CHAR ;
BEGIN
  s := '' ;
  LOOP
    IF AtEnd (ps) THEN Fail (ps, 'missing >, unterminated name', at) END ;
    c := Cur (ps) ;
    ps.pos := ps.pos + 1 ;
    IF c = '>' THEN EXIT END ;
    IF NOT (IsAsciiLetter (c) OR c = '_' OR (IsDigit (c) AND LEN (s) > 0)) THEN
      IF ORD (c) > 127 THEN
        Fail (ps, 'a group name outside ASCII: letters, digits and _ only', at)
      END ;
      Fail (ps, 'bad character in group name', at)
    END ;
    s := s + c
  END ;
  IF LEN (s) = 0 THEN Fail (ps, 'missing group name', at) END ;
  RETURN s
END GroupName ;

PROCEDURE ParseGroup (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re ; first: BOOL ;
                 VAR some: BOOL) : PTR Node IN sp RAISES BadPattern =
  (* at (; some FALSE for a group that is no item: flags, a comment *)
VAR
  at, k, i : I64 ;
  c : CHAR ;
  name : STR ;
  save : Parser ;
  body, g : PTR Node IN sp ;
  off : BOOL ;
BEGIN
  at := ps.pos ;
  ps.pos := ps.pos + 1 ;
  some := TRUE ;
  k := -1 ;
  IF Cur (ps) = '?' THEN
    ps.pos := ps.pos + 1 ;
    c := Cur (ps) ;
    IF c = ':' THEN
      ps.pos := ps.pos + 1
    ELSIF c = 'P' AND At (ps, 1) = '<' THEN
      ps.pos := ps.pos + 2 ;
      name := GroupName (ps, at) ;
      FOR i := 0 TO re.nnames - 1 DO
        IF Text.Eq (re.names[i], name) THEN Fail (ps, 'redefinition of group name', at) END
      END ;
      re.ngroups := re.ngroups + 1 ;
      k := re.ngroups ;
      AddName (re, name, k)
    ELSIF c = 'P' AND At (ps, 1) = '=' THEN
      Fail (ps, 'a backreference: it needs backtracking, which this engine does not do', at)
    ELSIF c = '=' OR c = '!' THEN
      Fail (ps, 'a lookahead: it needs backtracking, which this engine does not do', at)
    ELSIF c = '<' AND (At (ps, 1) = '=' OR At (ps, 1) = '!') THEN
      Fail (ps, 'a lookbehind: it needs backtracking, which this engine does not do', at)
    ELSIF c = '>' THEN
      Fail (ps, 'an atomic group: it needs backtracking, which this engine does not do', at)
    ELSIF c = '(' THEN
      Fail (ps, 'a conditional group: it needs backtracking, which this engine does not do', at)
    ELSIF c = '#' THEN
      WHILE NOT AtEnd (ps) AND Cur (ps) # ')' DO ps.pos := ps.pos + 1 END ;
      IF AtEnd (ps) THEN Fail (ps, 'missing ), unterminated comment', at) END ;
      ps.pos := ps.pos + 1 ;
      some := FALSE ;
      RETURN Mk (sp, NEmpty, 0)
    ELSIF IsAsciiLetter (c) OR c = '-' THEN
      (* flags: global (?ims) at the start, or scoped (?i-s:...) *)
      (* the letters read first, applied once it is known whether
         the group is global -- (?u) -- or scoped -- (?i:...) *)
      save := ps ;
      off := FALSE ;
      LOOP
        IF AtEnd (ps) THEN Fail (ps, 'missing -, : or )', at) END ;
        c := Cur (ps) ;
        ps.pos := ps.pos + 1 ;
        IF c = ')' OR c = ':' THEN EXIT END ;
        IF c = '-' THEN
          IF off THEN Fail (ps, 'unknown flag', at) END ;
          off := TRUE
        ELSIF NOT IsAsciiLetter (c) THEN
          Fail (ps, 'unknown flag', at)
        END
      END ;
      IF c = ')' AND off THEN Fail (ps, 'missing :', at) END ;
      IF c = ')' AND NOT first THEN
        Fail (ps, 'global flags not at the start of the expression', at)
      END ;
      off := FALSE ;
      FOR i := at + 2 TO ps.pos - 2 DO
        IF ps.p[i] = '-' THEN off := TRUE
        ELSE Flags (ps, ps.p[i], NOT off, at, c = ':')
        END
      END ;
      IF c = ')' THEN
        some := FALSE ;
        RETURN Mk (sp, NEmpty, 0)
      END ;
      body := Alt (sp, ps, re, FALSE) ;
      IF Cur (ps) # ')' THEN Fail (ps, 'missing ), unterminated subpattern', at) END ;
      ps.pos := ps.pos + 1 ;
      ps.ci := save.ci ; ps.ml := save.ml ; ps.da := save.da ; ps.uni := save.uni ;
      g := Mk (sp, NGroup, -1) ;
      AddKid (sp, g, body) ;
      RETURN g
    ELSE
      Fail (ps, 'unknown extension ?' + c, at)
    END
  ELSE
    re.ngroups := re.ngroups + 1 ;
    k := re.ngroups
  END ;
  body := Alt (sp, ps, re, FALSE) ;
  IF Cur (ps) # ')' OR AtEnd (ps) THEN Fail (ps, 'missing ), unterminated subpattern', at) END ;
  ps.pos := ps.pos + 1 ;
  g := Mk (sp, NGroup, k) ;
  AddKid (sp, g, body) ;
  RETURN g
END ParseGroup ;

PROCEDURE Quant (VAR ps: Parser ; VAR min, max, width: I64) : BOOL =
  (* a quantifier at pos, not consumed: * + ? or a {..} Python reads as
     one (any other { is a character) *)
VAR
  c : CHAR ;
  i, lo, hi : I64 ;
  hasLo, hasHi, comma : BOOL ;
BEGIN
  c := Cur (ps) ;
  IF AtEnd (ps) THEN RETURN FALSE END ;
  IF c = '*' THEN min := 0 ; max := -1 ; width := 1 ; RETURN TRUE END ;
  IF c = '+' THEN min := 1 ; max := -1 ; width := 1 ; RETURN TRUE END ;
  IF c = '?' THEN min := 0 ; max := 1 ; width := 1 ; RETURN TRUE END ;
  IF c # '{' THEN RETURN FALSE END ;
  i := ps.pos + 1 ;
  lo := 0 ;
  hi := 0 ;
  hasLo := FALSE ;
  hasHi := FALSE ;
  comma := FALSE ;
  WHILE i < LEN (ps.p) AND IsDigit (ps.p[i]) DO
    IF lo < 100000000 THEN lo := lo * 10 + ORD (ps.p[i]) - 48 END ;
    hasLo := TRUE ;
    i := i + 1
  END ;
  IF i < LEN (ps.p) AND ps.p[i] = ',' THEN
    comma := TRUE ;
    i := i + 1 ;
    WHILE i < LEN (ps.p) AND IsDigit (ps.p[i]) DO
      IF hi < 100000000 THEN hi := hi * 10 + ORD (ps.p[i]) - 48 END ;
      hasHi := TRUE ;
      i := i + 1
    END
  END ;
  IF i >= LEN (ps.p) OR ps.p[i] # '}' THEN RETURN FALSE END ;
  IF i = ps.pos + 1 THEN RETURN FALSE END ;          (* {} *)
  min := 0 ;
  IF hasLo THEN min := lo END ;
  IF comma THEN
    max := -1 ;
    IF hasHi THEN max := hi END
  ELSE
    max := min
  END ;
  width := i - ps.pos + 1 ;
  RETURN TRUE
END Quant ;

PROCEDURE Seq (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re ; top: BOOL)
  : PTR Node IN sp RAISES BadPattern =
  (* items up to | or ) or the end; top: the pattern's first branch,
     where global flags may stand *)
VAR
  cat, item, rep : PTR Node IN sp ;
  at, min, max, width : I64 ;
  c : CHAR ;
  some, lazy : BOOL ;
BEGIN
  cat := Mk (sp, NCat, 0) ;
  LOOP
    IF AtEnd (ps) THEN EXIT END ;
    c := Cur (ps) ;
    IF c = '|' OR c = ')' THEN EXIT END ;
    at := ps.pos ;
    some := TRUE ;
    IF c = '(' THEN
      item := ParseGroup (sp, ps, re, top AND cat.nk = 0, some)
    ELSIF c = '[' THEN
      item := ParseClass (sp, ps, re)
    ELSIF c = '.' THEN
      ps.pos := ps.pos + 1 ;
      item := Mk (sp, NAny, 0) ;
      IF ps.da THEN item.v := 1 END
    ELSIF c = '^' THEN
      ps.pos := ps.pos + 1 ;
      IF ps.ml THEN item := Mk (sp, NAssert, ABol) ELSE item := Mk (sp, NAssert, ABot) END
    ELSIF c = '$' THEN
      ps.pos := ps.pos + 1 ;
      IF ps.ml THEN item := Mk (sp, NAssert, AEol) ELSE item := Mk (sp, NAssert, AEotNl) END
    ELSIF c = '\' THEN
      item := Escape (sp, ps, re)
    ELSIF Quant (ps, min, max, width) THEN
      Fail (ps, 'nothing to repeat', at)
    ELSE
      ps.pos := ps.pos + 1 ;
      item := CharNode (sp, ps, re, ORD (c))
    END ;
    IF Quant (ps, min, max, width) THEN
      IF NOT some OR item.kind = NAssert THEN Fail (ps, 'nothing to repeat', ps.pos) END ;
      at := ps.pos ;
      ps.pos := ps.pos + width ;
      IF max >= 0 AND max < min THEN Fail (ps, 'min repeat greater than max repeat', at + 1) END ;
      IF min > MaxRepeat OR max > MaxRepeat THEN
        Fail (ps, 'a repetition count above 1000', at + 1)
      END ;
      lazy := FALSE ;
      IF Cur (ps) = '?' AND NOT AtEnd (ps) THEN lazy := TRUE ; ps.pos := ps.pos + 1
      ELSIF Cur (ps) = '+' AND NOT AtEnd (ps) THEN
        Fail (ps, 'a possessive quantifier: it needs backtracking, which this engine does not do', at)
      END ;
      IF Quant (ps, min, max, width) THEN Fail (ps, 'multiple repeat', ps.pos) END ;
      rep := Mk (sp, NRep, 0) ;
      rep.min := min ;
      rep.max := max ;
      rep.greedy := NOT lazy ;
      AddKid (sp, rep, item) ;
      item := rep
    END ;
    IF some THEN AddKid (sp, cat, item) END
  END ;
  IF cat.nk = 0 THEN RETURN Mk (sp, NEmpty, 0) END ;
  IF cat.nk = 1 THEN RETURN cat.kids[0] END ;
  RETURN cat
END Seq ;

PROCEDURE Alt (VAR sp: POOL ; VAR ps: Parser ; VAR re: PTR Re ; top: BOOL)
  : PTR Node IN sp RAISES BadPattern =
VAR
  first, alt : PTR Node IN sp ;
BEGIN
  first := Seq (sp, ps, re, top) ;
  IF Cur (ps) # '|' OR AtEnd (ps) THEN RETURN first END ;
  alt := Mk (sp, NAlt, 0) ;
  AddKid (sp, alt, first) ;
  WHILE Cur (ps) = '|' AND NOT AtEnd (ps) DO
    ps.pos := ps.pos + 1 ;
    AddKid (sp, alt, Seq (sp, ps, re, FALSE))
  END ;
  RETURN alt
END Alt ;

(* ---- the compiler ------------------------------------------------- *)

PROCEDURE Nullable (nd: PTR Node) : BOOL =
  (* the node can match the empty string *)
VAR i : I64 ;
BEGIN
  IF nd.kind = NEmpty OR nd.kind = NAssert THEN RETURN TRUE END ;
  IF nd.kind = NChar OR nd.kind = NAny OR nd.kind = NClass THEN RETURN FALSE END ;
  IF nd.kind = NCat THEN
    FOR i := 0 TO nd.nk - 1 DO
      IF NOT Nullable (nd.kids[i]) THEN RETURN FALSE END
    END ;
    RETURN TRUE
  END ;
  IF nd.kind = NAlt THEN
    FOR i := 0 TO nd.nk - 1 DO
      IF Nullable (nd.kids[i]) THEN RETURN TRUE END
    END ;
    RETURN FALSE
  END ;
  IF nd.kind = NGroup THEN RETURN Nullable (nd.kids[0]) END ;
  RETURN nd.min = 0 OR Nullable (nd.kids[0])
END Nullable ;

PROCEDURE Gen (VAR re: PTR Re ; nd: PTR Node) RAISES BadPattern =
VAR
  i, j, sp, last : I64 ;
  jumps : SLICE OF I64 ;
BEGIN
  IF nd.kind = NEmpty THEN RETURN END ;
  IF nd.kind = NChar THEN j := Emit (re, OChar, nd.v, 0) ; RETURN END ;
  IF nd.kind = NAny THEN
    IF nd.v = 1 THEN j := Emit (re, OAnyNl, 0, 0) ELSE j := Emit (re, OAny, 0, 0) END ;
    RETURN
  END ;
  IF nd.kind = NClass THEN j := Emit (re, OClass, nd.v, 0) ; RETURN END ;
  IF nd.kind = NAssert THEN j := Emit (re, OAssert, nd.v, 0) ; RETURN END ;
  IF nd.kind = NCat THEN
    FOR i := 0 TO nd.nk - 1 DO Gen (re, nd.kids[i]) END ;
    RETURN
  END ;
  IF nd.kind = NAlt THEN
    (* split to each branch in order, every branch but the last jumping
       past the rest *)
    jumps := NEW (I64, nd.nk) ;
    FOR i := 0 TO nd.nk - 2 DO
      sp := Emit (re, OSplit, 0, 0) ;
      re.x[sp] := re.n ;
      Gen (re, nd.kids[i]) ;
      jumps[i] := Emit (re, OJmp, 0, 0) ;
      re.y[sp] := re.n
    END ;
    Gen (re, nd.kids[nd.nk - 1]) ;
    last := re.n ;
    FOR i := 0 TO nd.nk - 2 DO re.x[jumps[i]] := last END ;
    RETURN
  END ;
  IF nd.kind = NGroup THEN
    IF nd.v >= 0 THEN j := Emit (re, OSave, 2 * nd.v, 0) END ;
    Gen (re, nd.kids[0]) ;
    IF nd.v >= 0 THEN j := Emit (re, OSave, 2 * nd.v + 1, 0) END ;
    RETURN
  END ;
  GenRep (re, nd)
END Gen ;

PROCEDURE GenRep (VAR re: PTR Re ; nd: PTR Node) RAISES BadPattern =
  (* the mandatory passes written out, then the optional ones.  A body
     that can match nothing gets sre's guard, the way Python's
     MAX_UNTIL and MIN_UNTIL keep it: a pass that ended where it began
     is kept, and the loop ends there -- straight to the exit.

     An unbounded loop with such a body is written TWICE, the passes
     taking the two copies in turn.  Python tries one more pass where a
     pass ended, and keeps it when it matches nothing: a starred group
     of a starred a, on aaa, leaves the group at 3..3.  That pass runs through the instructions
     the ending pass has just visited at the same place, and a Pike VM
     drops a second visit; in the other copy it is a first one *)
VAR
  i, j, slot, sp, body, exit, k, copies : I64 ;
  splits, checks, tops : SLICE OF I64 ;
  null : BOOL ;
BEGIN
  FOR i := 1 TO nd.min DO Gen (re, nd.kids[0]) END ;
  IF nd.max = nd.min THEN RETURN END ;
  null := Nullable (nd.kids[0]) ;
  slot := -1 ;
  IF null THEN
    slot := re.nslots ;
    re.nslots := re.nslots + 1
  END ;
  IF nd.max > 0 THEN k := nd.max - nd.min
  ELSIF null THEN k := 2
  ELSE k := 1
  END ;
  splits := NEW (I64, k) ;
  checks := NEW (I64, k) ;
  tops := NEW (I64, k) ;
  FOR i := 0 TO k - 1 DO
    checks[i] := -1 ;
    tops[i] := re.n ;
    splits[i] := Emit (re, OSplit, 0, 0) ;
    body := re.n ;
    IF null THEN j := Emit (re, OMark, slot, 0) END ;
    Gen (re, nd.kids[0]) ;
    IF null THEN checks[i] := Emit (re, OCheck, slot, 0) END ;
    (* unbounded: on to the other copy's top, the last back to the first *)
    IF nd.max < 0 AND i = k - 1 THEN j := Emit (re, OJmp, tops[0], 0) END ;
    (* the split's body arm, until the exit is known *)
    re.y[splits[i]] := body
  END ;
  exit := re.n ;
  FOR i := 0 TO k - 1 DO
    body := re.y[splits[i]] ;
    IF nd.greedy THEN re.x[splits[i]] := body ; re.y[splits[i]] := exit
    ELSE re.x[splits[i]] := exit ; re.y[splits[i]] := body
    END ;
    IF checks[i] >= 0 THEN re.y[checks[i]] := exit END
  END
END GenRep ;

PROCEDURE Compile (VAR pool: POOL ; RO pattern: STR ; RO flags: STR)
  : PTR Re IN pool RAISES BadPattern =
VAR
  scratch : POOL ;
  re : PTR Re IN pool ;
  ps : Parser ;
  root : PTR Node IN scratch ;
  i, j : I64 ;
  c : CHAR ;
BEGIN
  re := NewRe (pool) ;
  ps.p := pattern ;
  ps.pos := 0 ;
  ps.ci := FALSE ;
  ps.ml := FALSE ;
  ps.da := FALSE ;
  ps.uni := FALSE ;
  FOR i := 0 TO LEN (flags) - 1 DO
    c := flags[i] ;
    IF c = 'u' THEN ps.uni := TRUE
    ELSIF c = 'i' THEN ps.ci := TRUE
    ELSIF c = 'm' THEN ps.ml := TRUE
    ELSIF c = 's' THEN ps.da := TRUE
    ELSE RAISE BadPattern ('an unknown flag: ' + c + ', where imsu are the flags', -1)
    END
  END ;
  IF ps.ci AND ps.uni THEN
    RAISE BadPattern ('case-insensitive Unicode matching is not built: drop u, or spell both cases', -1)
  END ;
  root := Alt (scratch, ps, re, TRUE) ;
  IF NOT AtEnd (ps) THEN
    RAISE BadPattern ('unbalanced parenthesis', ps.pos)
  END ;
  re.uni := ps.uni ;
  re.nslots := 2 * (re.ngroups + 1) ;
  j := Emit (re, OSave, 0, 0) ;
  Gen (re, root) ;
  j := Emit (re, OSave, 1, 0) ;
  j := Emit (re, OMatch, 0, 0) ;
  RETURN re
END Compile ;

PROCEDURE Groups (re: PTR Re) : I64 =
BEGIN
  RETURN re.ngroups
END Groups ;

PROCEDURE GroupIndex (re: PTR Re ; RO name: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO re.nnames - 1 DO
    IF Text.Eq (re.names[i], name) THEN RETURN re.nameGroup[i] END
  END ;
  RETURN -1
END GroupIndex ;

(* ---- the machine -------------------------------------------------- *)

TYPE
  (* a thread list: the program counters of one position's threads in
     priority order, and each one's slots *)
  List = RECORD
    pc : SLICE OF I64 ;
    caps : SLICE OF I64 ;      (* n threads times nslots *)
    n : I64 ;
    stamp : I64 ;              (* seen[pc] = stamp: pc is on this list *)
  END ;

  Vm = RECORD
    seen : SLICE OF I64 ;
    stamps : I64 ;
    work : SLICE OF I64 ;      (* the slots of the thread being added *)
    jobPc, jobSlot, jobVal : SLICE OF I64 ;
  END ;

PROCEDURE Holds (re: PTR Re ; RO s: STR ; pos, kind: I64) : BOOL =
VAR
  n : I64 ;
  a, b : BOOL ;
BEGIN
  n := LEN (s) ;
  IF kind = ABot THEN RETURN pos = 0 END ;
  IF kind = ABol THEN RETURN pos = 0 OR s[pos - 1] = 0AC END ;
  IF kind = AEot THEN RETURN pos = n END ;
  IF kind = AEotNl THEN RETURN pos = n OR (pos = n - 1 AND s[pos] = 0AC) END ;
  IF kind = AEol THEN RETURN pos = n OR s[pos] = 0AC END ;
  a := pos > 0 AND IsWord (ORD (s[pos - 1]), re.uni) ;
  b := pos < n AND IsWord (ORD (s[pos]), re.uni) ;
  IF kind = AWord THEN RETURN a # b END ;
  RETURN a = b
END Holds ;

PROCEDURE AddThread (re: PTR Re ; RO s: STR ; VAR vm: Vm ; VAR l: List ;
                     pc0, pos: I64) =
  (* the threads pc0 leads to without consuming a character, onto l
     in priority order; vm.work holds the slots on the way.  A job is a
     program counter, or (pc -1) a slot to put back *)
VAR
  sp, pc, slot, k, ns : I64 ;
BEGIN
  ns := re.nslots ;
  sp := 0 ;
  vm.jobPc[0] := pc0 ;
  sp := 1 ;
  WHILE sp > 0 DO
    sp := sp - 1 ;
    pc := vm.jobPc[sp] ;
    IF pc < 0 THEN
      vm.work[vm.jobSlot[sp]] := vm.jobVal[sp]
    ELSE
      LOOP
        IF vm.seen[pc] = l.stamp THEN EXIT END ;
        vm.seen[pc] := l.stamp ;
        k := re.op[pc] ;
        IF k = OJmp THEN
          pc := re.x[pc]
        ELSIF k = OSplit THEN
          vm.jobPc[sp] := re.y[pc] ;
          sp := sp + 1 ;
          pc := re.x[pc]
        ELSIF k = OSave OR k = OMark THEN
          slot := re.x[pc] ;
          vm.jobPc[sp] := -1 ;
          vm.jobSlot[sp] := slot ;
          vm.jobVal[sp] := vm.work[slot] ;
          sp := sp + 1 ;
          vm.work[slot] := pos ;
          pc := pc + 1
        ELSIF k = OCheck THEN
          IF vm.work[re.x[pc]] = pos THEN pc := re.y[pc] ELSE pc := pc + 1 END
        ELSIF k = OAssert THEN
          IF NOT Holds (re, s, pos, re.x[pc]) THEN EXIT END ;
          pc := pc + 1
        ELSE
          l.pc[l.n] := pc ;
          FOR slot := 0 TO ns - 1 DO l.caps[l.n * ns + slot] := vm.work[slot] END ;
          l.n := l.n + 1 ;
          EXIT
        END
      END
    END
  END
END AddThread ;

PROCEDURE Step (re: PTR Re ; pc: I64 ; c: I64) : BOOL =
  (* the thread at pc takes the character c *)
VAR k, at : I64 ;
BEGIN
  k := re.op[pc] ;
  IF k = OChar THEN RETURN c = re.x[pc] END ;
  IF k = OAny THEN RETURN c # 10 END ;
  IF k = OAnyNl THEN RETURN TRUE END ;
  IF k = OClass THEN
    at := re.x[pc] ;
    RETURN InTable (re.lo, re.hi, re.clsAt[at], re.clsLen[at], c)
  END ;
  RETURN FALSE
END Step ;

PROCEDURE Run (re: PTR Re ; RO s: STR ; from: I64 ; anchored, full, advance: BOOL)
  : OPT PTR Found =
  (* the leftmost-first match from from, as sre finds it: anchored, a
     match must start there; full, it must end at the end of s;
     advance, it must not end where it started (finditer after an empty
     match) *)
VAR
  scratch : POOL ;
  vm : Vm ;
  cl, nl, tl : List ;
  pos, i, j, ns, n, c, pc, f : I64 ;
  best : SLICE OF I64 ;
  matched : BOOL ;
  m : PTR Found ;
BEGIN
  n := LEN (s) ;
  f := from ;
  IF f < 0 THEN f := 0 END ;
  IF f > n THEN f := n END ;
  ns := re.nslots ;
  vm.seen := NEW (scratch, I64, re.n) ;
  vm.stamps := 0 ;
  vm.work := NEW (scratch, I64, ns) ;
  vm.jobPc := NEW (scratch, I64, 2 * re.n + 2) ;
  vm.jobSlot := NEW (scratch, I64, 2 * re.n + 2) ;
  vm.jobVal := NEW (scratch, I64, 2 * re.n + 2) ;
  cl.pc := NEW (scratch, I64, re.n) ;
  cl.caps := NEW (scratch, I64, re.n * ns) ;
  nl.pc := NEW (scratch, I64, re.n) ;
  nl.caps := NEW (scratch, I64, re.n * ns) ;
  best := NEW (scratch, I64, ns) ;
  FOR i := 0 TO re.n - 1 DO vm.seen[i] := 0 END ;
  cl.n := 0 ;
  vm.stamps := 1 ;
  cl.stamp := 1 ;
  matched := FALSE ;
  pos := f ;
  LOOP
    IF NOT matched AND (pos = f OR NOT anchored) THEN
      FOR j := 0 TO ns - 1 DO vm.work[j] := -1 END ;
      AddThread (re, s, vm, cl, 0, pos)
    END ;
    (* no thread here: an unanchored search goes on to the next place *)
    IF cl.n = 0 AND (matched OR anchored) THEN EXIT END ;
    vm.stamps := vm.stamps + 1 ;
    nl.n := 0 ;
    nl.stamp := vm.stamps ;
    c := -1 ;
    IF pos < n THEN c := ORD (s[pos]) END ;
    i := 0 ;
    WHILE i < cl.n DO
      pc := cl.pc[i] ;
      IF re.op[pc] = OMatch THEN
        IF (full AND pos # n) OR (advance AND pos = f) THEN
          (* not this one; lower threads may still do *)
        ELSE
          matched := TRUE ;
          FOR j := 0 TO ns - 1 DO best[j] := cl.caps[i * ns + j] END ;
          i := cl.n               (* the threads below this one are cut *)
        END
      ELSIF c >= 0 AND Step (re, pc, c) THEN
        FOR j := 0 TO ns - 1 DO vm.work[j] := cl.caps[i * ns + j] END ;
        AddThread (re, s, vm, nl, pc + 1, pos + 1)
      END ;
      i := i + 1
    END ;
    IF pos >= n THEN EXIT END ;
    tl := cl ;
    cl := nl ;
    nl := tl ;
    pos := pos + 1
  END ;
  IF NOT matched THEN RETURN NONE END ;
  m := NEW (Found) ;
  m.span := NEW (I64, 2 * (re.ngroups + 1)) ;
  FOR j := 0 TO 2 * re.ngroups + 1 DO m.span[j] := best[j] END ;
  FOR j := 0 TO re.ngroups DO
    (* a group whose end was never written took no part *)
    IF m.span[2 * j] < 0 OR m.span[2 * j + 1] < 0 THEN
      m.span[2 * j] := -1 ;
      m.span[2 * j + 1] := -1
    END
  END ;
  RETURN SOME (m)
END Run ;

PROCEDURE Search (re: PTR Re ; RO s: STR ; from: I64) : OPT PTR Found =
BEGIN
  RETURN Run (re, s, from, FALSE, FALSE, FALSE)
END Search ;

PROCEDURE Match (re: PTR Re ; RO s: STR ; from: I64) : OPT PTR Found =
BEGIN
  RETURN Run (re, s, from, TRUE, FALSE, FALSE)
END Match ;

PROCEDURE FullMatch (re: PTR Re ; RO s: STR) : OPT PTR Found =
BEGIN
  RETURN Run (re, s, 0, TRUE, TRUE, FALSE)
END FullMatch ;

PROCEDURE Start (m: PTR Found ; k: I64) : I64 RAISES IndexError =
BEGIN
  RETURN m.span[2 * k]
END Start ;

PROCEDURE End (m: PTR Found ; k: I64) : I64 RAISES IndexError =
BEGIN
  RETURN m.span[2 * k + 1]
END End ;

PROCEDURE Took (m: PTR Found ; k: I64) : BOOL RAISES IndexError =
BEGIN
  RETURN m.span[2 * k] >= 0
END Took ;

PROCEDURE Group (RO s: STR ; m: PTR Found ; k: I64) : STR RAISES IndexError =
VAR a, b : I64 ;
BEGIN
  a := m.span[2 * k] ;
  b := m.span[2 * k + 1] ;
  IF a < 0 THEN RETURN '' END ;
  RETURN SLICE (s, a, b - a)
END Group ;

PROCEDURE FindAll (re: PTR Re ; RO s: STR) : SLICE OF PTR Found =
VAR
  all, more : SLICE OF PTR Found ;
  n, i, pos : I64 ;
  advance : BOOL ;
  r : OPT PTR Found ;
BEGIN
  all := NEW (FoundP, 4) ;
  n := 0 ;
  pos := 0 ;
  advance := FALSE ;
  LOOP
    r := Run (re, s, pos, FALSE, FALSE, advance) ;
    IF r IS SOME m THEN
      IF n = LEN (all) THEN
        more := NEW (FoundP, 2 * n) ;
        FOR i := 0 TO n - 1 DO more[i] := all[i] END ;
        all := more
      END ;
      all[n] := m ;
      n := n + 1 ;
      advance := m.span[1] = m.span[0] ;
      pos := m.span[1]
    ELSE
      EXIT
    END
  END ;
  RETURN SLICE (all, 0, n)
END FindAll ;

(* ---- replacement templates ------------------------------------------ *)

PROCEDURE Expand (re: PTR Re ; RO s: STR ; RO repl: STR ; m: PTR Found ;
                  VAR d: PTR DynStr.DString) RAISES BadPattern =
  (* repl with its group references filled in from m, onto d *)
VAR
  i, k, g : I64 ;
  c : CHAR ;
  name : STR ;
BEGIN
  i := 0 ;
  WHILE i < LEN (repl) DO
    c := repl[i] ;
    i := i + 1 ;
    IF c # '\' THEN
      DynStr.AppendChar (d, c)
    ELSIF i >= LEN (repl) THEN
      RAISE BadPattern ('bad escape (end of pattern) in the replacement', -1)
    ELSE
      c := repl[i] ;
      i := i + 1 ;
      g := -1 ;
      IF c = 'g' THEN
        IF i >= LEN (repl) OR repl[i] # '<' THEN
          RAISE BadPattern ('missing < in the replacement', -1)
        END ;
        i := i + 1 ;
        name := '' ;
        WHILE i < LEN (repl) AND repl[i] # '>' DO name := name + repl[i] ; i := i + 1 END ;
        IF i >= LEN (repl) THEN RAISE BadPattern ('missing > in the replacement', -1) END ;
        i := i + 1 ;
        IF LEN (name) = 0 THEN RAISE BadPattern ('missing group name in the replacement', -1) END ;
        IF IsDigit (name[0]) THEN
          g := 0 ;
          FOR k := 0 TO LEN (name) - 1 DO
            IF NOT IsDigit (name[k]) THEN
              RAISE BadPattern ('bad character in group name ' + name, -1)
            END ;
            IF g < 100000 THEN g := g * 10 + ORD (name[k]) - 48 END
          END
        ELSE
          g := GroupIndex (re, name) ;
          IF g < 0 THEN RAISE BadPattern ('unknown group name ' + name, -1) END
        END
      ELSIF IsDigit (c) AND c # '0' THEN
        g := ORD (c) - 48 ;
        IF i < LEN (repl) AND IsDigit (repl[i]) THEN
          g := g * 10 + ORD (repl[i]) - 48 ;
          i := i + 1
        END
      ELSIF c = 'n' THEN DynStr.AppendChar (d, 0AC)
      ELSIF c = 't' THEN DynStr.AppendChar (d, 09C)
      ELSIF c = 'r' THEN DynStr.AppendChar (d, 0DC)
      ELSIF c = '\' THEN DynStr.AppendChar (d, '\')
      ELSIF IsAsciiLetter (c) OR c = '0' THEN
        RAISE BadPattern ('bad escape \' + c + ' in the replacement', -1)
      ELSE
        DynStr.AppendChar (d, '\') ;
        DynStr.AppendChar (d, c)
      END ;
      IF g >= 0 THEN
        IF g > re.ngroups THEN RAISE BadPattern ('invalid group reference in the replacement', -1) END ;
        IF m.span[2 * g] >= 0 THEN
          DynStr.Append (d, SLICE (s, m.span[2 * g], m.span[2 * g + 1] - m.span[2 * g]))
        END
      END
    END
  END
END Expand ;

PROCEDURE Sub (re: PTR Re ; RO s: STR ; RO repl: STR ; count: I64) : STR
  RAISES BadPattern =
VAR
  scratch : POOL ;
  d : PTR DynStr.DString IN scratch ;
  pos, last, done : I64 ;
  advance : BOOL ;
  r : OPT PTR Found ;
BEGIN
  d := DynStr.New (scratch) ;
  pos := 0 ;
  last := 0 ;
  done := 0 ;
  advance := FALSE ;
  LOOP
    IF count > 0 AND done >= count THEN EXIT END ;
    r := Run (re, s, pos, FALSE, FALSE, advance) ;
    IF r IS SOME m THEN
      DynStr.Append (d, SLICE (s, last, m.span[0] - last)) ;
      Expand (re, s, repl, m, d) ;
      last := m.span[1] ;
      done := done + 1 ;
      advance := m.span[1] = m.span[0] ;
      pos := m.span[1]
    ELSE
      EXIT
    END
  END ;
  DynStr.Append (d, SLICE (s, last, LEN (s) - last)) ;
  RETURN DynStr.View (d)
END Sub ;

PROCEDURE Split (re: PTR Re ; RO s: STR ; maxsplit: I64) : SLICE OF STR =
VAR
  out, more : SLICE OF STR ;
  n, i, g, pos, last, done : I64 ;
  advance : BOOL ;
  r : OPT PTR Found ;
BEGIN
  out := NEW (STR, 8) ;
  n := 0 ;
  pos := 0 ;
  last := 0 ;
  done := 0 ;
  advance := FALSE ;
  LOOP
    IF maxsplit > 0 AND done >= maxsplit THEN EXIT END ;
    r := Run (re, s, pos, FALSE, FALSE, advance) ;
    IF r IS SOME m THEN
      IF n + re.ngroups + 2 > LEN (out) THEN
        more := NEW (STR, 2 * (n + re.ngroups + 2)) ;
        FOR i := 0 TO n - 1 DO more[i] := out[i] END ;
        out := more
      END ;
      out[n] := SLICE (s, last, m.span[0] - last) ;
      n := n + 1 ;
      FOR g := 1 TO re.ngroups DO
        out[n] := '' ;
        IF m.span[2 * g] >= 0 THEN
          out[n] := SLICE (s, m.span[2 * g], m.span[2 * g + 1] - m.span[2 * g])
        END ;
        n := n + 1
      END ;
      last := m.span[1] ;
      done := done + 1 ;
      advance := m.span[1] = m.span[0] ;
      pos := m.span[1]
    ELSE
      EXIT
    END
  END ;
  IF n + 1 > LEN (out) THEN
    more := NEW (STR, n + 1) ;
    FOR i := 0 TO n - 1 DO more[i] := out[i] END ;
    out := more
  END ;
  out[n] := SLICE (s, last, LEN (s) - last) ;
  RETURN SLICE (out, 0, n + 1)
END Split ;

END Regex.
