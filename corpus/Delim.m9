DEFINITION MODULE Delim ;

(* A ROW CURSOR over a delimited text file, in bounded memory.

   WHY THIS AND NOT Csv.  `Csv` reads a whole file and hands out
   finished columns, which is right for the tables it was built for
   and impossible for the one this exists for: SOCAT's synthesis
   product is a 9 GB tab-separated table of 44 million observations,
   and the store builder walks it once, accumulating into zarr chunks
   as it goes.  Nothing may hold the file, and nothing may hold the
   rows.

   AND M9 POOLS DO NOT RESET, which decides the interface.  A reader
   answering a fresh STR per row would allocate 44 million of them
   and never give one back -- roughly 35 GB for this file, since a
   CHAR is four bytes.  So a field is a SLICE OF BYTE VIEWING the
   reader's own buffer, valid only until the next `Next`, and the
   caller converts the few fields it wants.  Comparing a field
   against a literal (`Is`) and reading a number out of it allocate
   NOTHING, which is what a 44-million-row walk needs; `Text` copies,
   and is for the fields a row does not have many of.

   THE PREAMBLE IS JUST ROWS, which is worth saying because the
   reference could not do it: SOCAT's file carries a dataset listing
   before the data header, and Python must read it with `readline()`
   rather than iterating the file, because a text iterator's
   read-ahead swallows data rows.  A cursor has no read-ahead to
   swallow anything -- read lines until the header, then keep going.

   NOT A CSV PARSER.  There are no quotes, no escapes and no embedded
   newlines: a line ends at LF and a field ends at the delimiter.
   That is what the scientific tab-separated products are, and a
   reader that pretended otherwise would be slower and no more
   correct for them.  A trailing CR is dropped, so a CRLF file reads
   the same as an LF one.                                           *)

IMPORT Io ;

TYPE
  Reader ;                       (* opaque; lives in a POOL *)

EXCEPTION Error (RO msg: STR) ;

CONST
  DefaultBlock = 1048576 ;       (* 1 MiB; SOCAT's own is 256 MiB *)
  (* 1024, because the ICOS ecosystem store's METEOSENS product has
     588 columns and the old 512 cut it silently.  A row past this is
     refused by name. *)
  MaxFields = 1024 ;

PROCEDURE Open (VAR pool: POOL ; RO KEPT path: STR ; delim: BYTE ;
                block: I64) : PTR Reader IN pool
  RAISES Error, Io.IOError, ValueRange ;
  (* `block` is the read size AND the longest line the reader will
     accept: a line that does not fit raises rather than being cut,
     because a silently truncated row is a wrong measurement.  Pass
     0 for DefaultBlock. *)

PROCEDURE OpenPush (VAR pool: POOL ; delim: BYTE ; block: I64)
  : PTR Reader IN pool
  RAISES Error ;
  (* the same cursor over bytes the CALLER supplies, for a source
     that is not a seekable file.  SOCAT's table is the case: it
     lives inside a zip, and `Zip.Read` hands out inflated blocks.

     THIS IS WHY Delim DOES NOT IMPORT Zip.  M9 has no procedure
     types, so a source cannot be passed as a function; the choice
     was between this module importing the zip reader -- putting
     zlib in the link of every program that reads a plain CSV -- and
     letting the caller push.  Pushing costs the caller a loop and
     costs everyone else nothing.

     The loop is:

       LOOP
         WHILE Next (r) DO ... END ;
         IF NOT Hungry (r) THEN EXIT END ;
         got := <read some bytes> ;
         IF got = 0 THEN Finish (r) ELSE Feed (r, ...) END
       END                                                        *)

PROCEDURE Feed (VAR r: PTR Reader ; RO src: SLICE OF BYTE) : I64
  RAISES Error, ValueRange ;
  (* copy as much of `src` as fits, answering how much was taken.
     Zero means the buffer is full while no line has been consumed,
     which for a well-formed file means the line is longer than the
     block -- the same refusal the file reader makes. *)

PROCEDURE Finish (VAR r: PTR Reader) ;
  (* no more bytes are coming.  The last partial line, if there is
     one, becomes a line -- a final row without a newline is a row. *)

PROCEDURE Hungry (r: PTR Reader) : BOOL ;
  (* TRUE when the reader cannot produce a line without more bytes --
     which a FRESH push reader can not, so it starts hungry.  A
     file-backed reader never answers TRUE: it refills itself. *)

PROCEDURE Next (VAR r: PTR Reader) : BOOL
  RAISES Error, Io.IOError, ValueRange ;
  (* advance to the next line, FALSE at end of file.  A final line
     without a newline is a line. *)

PROCEDURE Count (r: PTR Reader) : I64 ;
  (* fields in the current line.  An empty line has one field, which
     is empty -- str.split's answer, not str.split()'s. *)

PROCEDURE Field (r: PTR Reader ; i: I64) : SLICE OF BYTE
  RAISES IndexError ;
  (* a VIEW into the reader's buffer, valid until the next Next. *)

PROCEDURE Line (r: PTR Reader) : SLICE OF BYTE ;
  (* the whole current line, newline and any trailing CR removed. *)

PROCEDURE LineNo (r: PTR Reader) : I64 ;
PROCEDURE Offset (r: PTR Reader) : I64 ;
  (* bytes consumed, for a progress line over a 9 GB file. *)

PROCEDURE Is (r: PTR Reader ; i: I64 ; RO s: STR) : BOOL
  RAISES IndexError ;
  (* field i equals the ASCII literal s, comparing OCTETS and
     allocating nothing.  A scalar in s above 127 answers FALSE
     rather than raising: this is a fast path, and a non-ASCII
     literal is a caller's mistake that Text would show. *)

PROCEDURE Text (VAR pool: POOL ; r: PTR Reader ; i: I64) : STR
  RAISES IndexError, ValueRange ;
  (* field i decoded from UTF-8 into pool.  This ALLOCATES; on a hot
     row loop use Is or the number readers instead. *)

PROCEDURE F32At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : F32
  RAISES IndexError, ValueRange ;
  (* the field as float32, `ok` FALSE when it is empty or not a
     number -- which is how a missing value arrives, and not an
     error: SOCAT writes NaN, others write nothing at all. *)

PROCEDURE F64At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : F64
  RAISES IndexError, ValueRange ;
  (* the field at FULL precision, through strtod.

     NOT the same as widening F32At, and the difference is a real one:
     F32At parses with strtof, so a value that is then ARITHMETIC-ed
     before being stored has already lost the bits the arithmetic
     needed.  Found by differential -- SOCAT's longitude is wrapped
     from 0..360 into -180..180 and only then narrowed, and parsing to
     float32 first put 19,150 of 20,000 values one ulp out.  Parse
     wide, compute wide, narrow once. *)

PROCEDURE I64At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : I64
  RAISES IndexError, ValueRange ;

END Delim.


UNSAFE DEFINITION MODULE FOR "C" cdelim ;

(* the two libc converters m9rt already wraps for Csv and Json: the
   shortest-round-trip float parse, and strtoll *)
PROCEDURE StrToF = "m9_strtof" (s: C.ConstPtr) : C.Double  [REENTRANT] ;
PROCEDURE StrToD = "m9_strtod" (s: C.ConstPtr) : C.Double  [REENTRANT] ;

END cdelim.


UNSAFE IMPLEMENTATION MODULE Delim ;

IMPORT DynStr ;
FROM cdelim IMPORT StrToF, StrToD ;

TYPE
  Reader = RECORD
    RO path : STR ;
    delim : BYTE ;
    block : I64 ;
    buf : SLICE OF BYTE ;        (* block * 2: a line may span a read *)
    len : I64 ;                  (* live bytes in buf *)
    pos : I64 ;                  (* start of the NEXT line *)
    fsBase : I64 ;               (* start of the current line *)
    endl : I64 ;                 (* one past its last byte *)
    off : I64 ;                  (* file offset of buf[0] *)
    eof : BOOL ;
    push : BOOL ;                (* the caller feeds, we do not read *)
    hungry : BOOL ;
    lineNo : I64 ;
    nf : I64 ;
    fs : ARRAY MaxFields OF I64 ;   (* field starts, absolute in buf *)
    fe : ARRAY MaxFields OF I64 ;   (* field ends *)
  END ;

PROCEDURE New (VAR pool: POOL ; delim: BYTE ; block: I64)
  : PTR Reader IN pool
  RAISES Error =
VAR r : PTR Reader IN pool ;
BEGIN
  IF block <= 0 THEN block := DefaultBlock END ;
  IF block < 4096 THEN
    RAISE Error ('a block under 4096 bytes is not worth a syscall')
  END ;
  r := NEW (pool, Reader) ;
  r.path := '' ;
  r.delim := delim ;
  r.block := block ;
  (* twice the block, so a line straddling a read still fits after the
     tail is moved down *)
  r.buf := NEW (pool, BYTE, block * 2) ;
  r.len := 0 ;
  r.pos := 0 ;
  r.endl := 0 ;
  r.off := 0 ;
  r.eof := FALSE ;
  r.push := FALSE ;
  r.hungry := FALSE ;
  r.lineNo := 0 ;
  r.nf := 0 ;
  RETURN r
END New ;

PROCEDURE Open (VAR pool: POOL ; RO KEPT path: STR ; delim: BYTE ;
                block: I64) : PTR Reader IN pool
  RAISES Error, Io.IOError, ValueRange =
VAR r : PTR Reader IN pool ;
BEGIN
  r := New (pool, delim, block) ;
  r.path := path ;
  RETURN r
END Open ;

PROCEDURE OpenPush (VAR pool: POOL ; delim: BYTE ; block: I64)
  : PTR Reader IN pool
  RAISES Error =
VAR r : PTR Reader IN pool ;
BEGIN
  r := New (pool, delim, block) ;
  r.push := TRUE ;
  (* a fresh push reader IS hungry: the predicate means "cannot
     produce a line without more bytes", which is true of an empty
     one.  The alternative -- hungry only after Next has asked --
     makes a caller that feeds before reading loop forever. *)
  r.hungry := TRUE ;
  RETURN r
END OpenPush ;

(* move what is unread to the front, so a Feed has room *)
PROCEDURE Compact (VAR r: PTR Reader) =
VAR keep, i : I64 ;
BEGIN
  keep := r.len - r.pos ;
  FOR i := 0 TO keep - 1 DO r.buf[i] := r.buf[r.pos + i] END ;
  r.off := r.off + r.pos ;
  r.len := keep ;
  r.pos := 0
END Compact ;

PROCEDURE Feed (VAR r: PTR Reader ; RO src: SLICE OF BYTE) : I64
  RAISES Error, ValueRange =
VAR room, take, i : I64 ;
BEGIN
  IF NOT r.push THEN
    RAISE Error ('Feed on a file-backed reader')
  END ;
  Compact (r) ;
  room := LEN (r.buf) - r.len ;
  take := LEN (src) ;
  IF take > room THEN take := room END ;
  FOR i := 0 TO take - 1 DO r.buf[r.len + i] := src[i] END ;
  r.len := r.len + take ;
  IF take > 0 THEN r.hungry := FALSE END ;
  RETURN take
END Feed ;

PROCEDURE Finish (VAR r: PTR Reader) =
BEGIN
  r.eof := TRUE ;
  r.hungry := FALSE
END Finish ;

PROCEDURE Hungry (r: PTR Reader) : BOOL =
BEGIN
  RETURN r.hungry
END Hungry ;

(* move what is unread to the front and read one more block *)
PROCEDURE Refill (VAR r: PTR Reader)
  RAISES Io.IOError, ValueRange =
VAR
  scratch : POOL ;
  got : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  Compact (r) ;
  IF r.eof THEN RETURN END ;
  got := Io.ReadFileAt (scratch, r.path, r.off + r.len,
                        LEN (r.buf) - r.len) ;
  IF LEN (got) = 0 THEN
    r.eof := TRUE ;
    RETURN
  END ;
  FOR i := 0 TO LEN (got) - 1 DO r.buf[r.len + i] := got[i] END ;
  r.len := r.len + LEN (got)
END Refill ;

PROCEDURE Next (VAR r: PTR Reader) : BOOL
  RAISES Error, Io.IOError, ValueRange =
VAR
  i, e, s : I64 ;
  found : BOOL ;
BEGIN
  LOOP
    (* the newline that ends the next line, if it is already here *)
    found := FALSE ;
    s := r.len ;
    i := r.pos ;
    WHILE i < r.len AND NOT found DO
      IF I64 (r.buf[i]) = 10 THEN found := TRUE ; s := i END ;
      i := i + 1
    END ;
    IF found THEN
      e := s ;
      IF e > r.pos AND I64 (r.buf[e - 1]) = 13 THEN e := e - 1 END ;
      r.fsBase := r.pos ;
      r.endl := e ;
      IF NOT SplitLine (r) THEN
        RAISE Error ('a row with more fields than the reader accepts')
      END ;
      r.lineNo := r.lineNo + 1 ;
      r.pos := s + 1 ;
      RETURN TRUE
    END ;
    IF r.eof THEN
      (* a last line with no newline is still a line *)
      IF r.pos < r.len THEN
        e := r.len ;
        IF e > r.pos AND I64 (r.buf[e - 1]) = 13 THEN e := e - 1 END ;
        r.fsBase := r.pos ;
        r.endl := e ;
        IF NOT SplitLine (r) THEN
          RAISE Error ('a row with more fields than the reader accepts')
        END ;
        r.lineNo := r.lineNo + 1 ;
        r.pos := r.len ;
        RETURN TRUE
      END ;
      RETURN FALSE
    END ;
    IF r.pos = 0 AND r.len = LEN (r.buf) THEN
      RAISE Error ('a line longer than the block, in ' + r.path)
    END ;
    IF r.push THEN
      (* nothing to read from: make room and ask the caller *)
      Compact (r) ;
      r.hungry := TRUE ;
      RETURN FALSE
    END ;
    Refill (r)
  END
END Next ;

(* A ROW WITH MORE FIELDS THAN THE CAP IS REFUSED, NOT CUT, which is
   the same rule this module already applies to a line longer than the
   block and for the same reason: a silently truncated row is a wrong
   measurement.  It used to stop recording at MaxFields and answer a
   short Count, so every column past the cap read as ABSENT -- found
   by a differential over ICOS METEOSENS, whose 588 columns put three
   soil-moisture sensors past the old 512 and made them read empty. *)
PROCEDURE SplitLine (VAR r: PTR Reader) : BOOL =
VAR i, a : I64 ;
BEGIN
  r.nf := 0 ;
  a := r.fsBase ;
  i := r.fsBase ;
  WHILE i < r.endl DO
    IF r.buf[i] = r.delim THEN
      IF r.nf >= MaxFields THEN RETURN FALSE END ;
      r.fs[r.nf] := a ;
      r.fe[r.nf] := i ;
      r.nf := r.nf + 1 ;
      a := i + 1
    END ;
    i := i + 1
  END ;
  IF r.nf >= MaxFields THEN RETURN FALSE END ;
  r.fs[r.nf] := a ;
  r.fe[r.nf] := r.endl ;
  r.nf := r.nf + 1 ;
  RETURN TRUE
END SplitLine ;

PROCEDURE Count (r: PTR Reader) : I64 =
BEGIN
  RETURN r.nf
END Count ;

PROCEDURE Field (r: PTR Reader ; i: I64) : SLICE OF BYTE
  RAISES IndexError =
BEGIN
  IF i < 0 OR i >= r.nf THEN RAISE IndexError END ;
  RETURN SLICE (r.buf, r.fs[i], r.fe[i] - r.fs[i])
END Field ;

PROCEDURE Line (r: PTR Reader) : SLICE OF BYTE =
BEGIN
  RETURN SLICE (r.buf, r.fsBase, r.endl - r.fsBase)
END Line ;

PROCEDURE LineNo (r: PTR Reader) : I64 =
BEGIN
  RETURN r.lineNo
END LineNo ;

PROCEDURE Offset (r: PTR Reader) : I64 =
BEGIN
  RETURN r.off + r.pos
END Offset ;

PROCEDURE Is (r: PTR Reader ; i: I64 ; RO s: STR) : BOOL
  RAISES IndexError =
VAR
  f : SLICE OF BYTE ;
  k : I64 ;
BEGIN
  f := Field (r, i) ;
  IF LEN (f) # LEN (s) THEN RETURN FALSE END ;
  FOR k := 0 TO LEN (s) - 1 DO
    IF ORD (s[k]) > 127 THEN RETURN FALSE END ;
    IF I64 (f[k]) # ORD (s[k]) THEN RETURN FALSE END
  END ;
  RETURN TRUE
END Is ;

PROCEDURE Text (VAR pool: POOL ; r: PTR Reader ; i: I64) : STR
  RAISES IndexError, ValueRange =
BEGIN
  RETURN DynStr.FromUtf8 (pool, Field (r, i))
END Text ;

PROCEDURE F32At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : F32
  RAISES IndexError, ValueRange =
VAR
  scratch : POOL ;
  f, z : SLICE OF BYTE ;
  k : I64 ;
BEGIN
  f := Field (r, i) ;
  ok := FALSE ;
  IF LEN (f) = 0 THEN RETURN F32 (0.0) END ;
  (* strtof wants a terminated string, and the field is a view into a
     buffer whose next byte is a delimiter -- so it is copied, into a
     scratch pool that dies with this call *)
  z := NEW (scratch, BYTE, LEN (f) + 1) ;
  FOR k := 0 TO LEN (f) - 1 DO z[k] := f[k] END ;
  ok := TRUE ;
  RETURN F32 (F64 (StrToF (ADR (z))))
END F32At ;

PROCEDURE F64At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : F64
  RAISES IndexError, ValueRange =
VAR
  scratch : POOL ;
  f, z : SLICE OF BYTE ;
  k : I64 ;
BEGIN
  f := Field (r, i) ;
  ok := FALSE ;
  IF LEN (f) = 0 THEN RETURN 0.0 END ;
  z := NEW (scratch, BYTE, LEN (f) + 1) ;
  FOR k := 0 TO LEN (f) - 1 DO z[k] := f[k] END ;
  ok := TRUE ;
  RETURN F64 (StrToD (ADR (z)))
END F64At ;

PROCEDURE I64At (r: PTR Reader ; i: I64 ; VAR ok: BOOL) : I64
  RAISES IndexError, ValueRange =
VAR
  f : SLICE OF BYTE ;
  k, v, sign : I64 ;
BEGIN
  f := Field (r, i) ;
  ok := FALSE ;
  v := 0 ;
  sign := 1 ;
  k := 0 ;
  IF LEN (f) = 0 THEN RETURN 0 END ;
  IF I64 (f[0]) = 45 THEN sign := -1 ; k := 1
  ELSIF I64 (f[0]) = 43 THEN k := 1 END ;
  IF k >= LEN (f) THEN RETURN 0 END ;
  WHILE k < LEN (f) DO
    IF I64 (f[k]) < 48 OR I64 (f[k]) > 57 THEN RETURN 0 END ;
    v := v * 10 + (I64 (f[k]) - 48) ;
    k := k + 1
  END ;
  ok := TRUE ;
  RETURN sign * v
END I64At ;

END Delim .
