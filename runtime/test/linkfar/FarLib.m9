DEFINITION MODULE FarLib ;

(* m9c.sh's fixture for a FOR "C" unit whose LINK names a library that
   is on no machine (m9nosuchlib).  Answer never calls into it; the
   private Calls does, and nothing calls Calls -- the shape of Frame
   and NetCDF: a program that never reaches the foreign calls links
   without the library, when the unit is reached through another
   module's implementation (FarMid), and fails by name when imported
   directly (FarDirect). *)

PROCEDURE Answer () : I64 ;

END FarLib.


UNSAFE DEFINITION MODULE FOR "C" cfar LINK "m9nosuchlib" ;

PROCEDURE Nothing = "m9_nosuch_nothing" () : C.Int  [REENTRANT] ;

END cfar.


UNSAFE IMPLEMENTATION MODULE FarLib ;

FROM cfar IMPORT Nothing ;

PROCEDURE Calls () : I64 =
BEGIN
  RETURN I64 (Nothing ())
END Calls ;

PROCEDURE Answer () : I64 =
BEGIN
  RETURN 42
END Answer ;

END FarLib.
