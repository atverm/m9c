DEFINITION MODULE Obs ;

(* Obs is the module runtime/test/llmtools.sh makes answers of with
   tools/M9Tools.m9 (docs/ml-plan.md, stage A3): a record of every
   kind of field, an enumeration, and a record holding a list of
   records.  Count is left out as a tool: it takes a record. *)

TYPE
  Flag = (Good, Suspect, Bad) ;

  Reading = RECORD
    station : STR ;       (* the station's name *)
    co2 : F64 ;           (* ppm *)
    height : I16 ;        (* metres above ground *)
    flag : Flag ;
    checked : BOOL ;
  END ;

  Batch = RECORD
    readings : SLICE OF Reading ;
    note : STR ;
  END ;

PROCEDURE Count (RO b: Batch) : I64 ;

END Obs.

IMPLEMENTATION MODULE Obs ;

PROCEDURE Count (RO b: Batch) : I64 =
BEGIN
  RETURN LEN (b.readings)
END Count ;

END Obs.
