PROCEDURE BatchSchemaText () : STR ;
  (* BatchSchemaText answers the JSON schema AskBatch asks with. *)

END ObsTools.


IMPLEMENTATION MODULE ObsTools ;

IMPORT Obs ;
IMPORT Http ;
IMPORT Json ;
IMPORT Llm ;
IMPORT Text ;

EXCEPTION
  Bad (RO why: STR) ;

CONST
  NoArgs = [''] ;

(* Err answers why as the tool result {"error": why}. *)
PROCEDURE Err (RO why: STR) : STR =
BEGIN
  RETURN '{"error":' + Json.Quote (why) + '}'
END Err ;

(* Only raises Bad for an argument that names is without, and for
   arguments that are not an object. *)
PROCEDURE Only (a: PTR Json.Node ; RO names: SLICE OF STR) RAISES Bad =
VAR i : I64 ; nm : STR ;
BEGIN
  FOR i := 0 TO Json.MemberCount (a) - 1 DO
    nm := Json.NameAt (a, i) ;
    IF NOT Text.OneOf (nm, names) OR Text.BLen (nm) = 0 THEN RAISE Bad ('unknown argument ' + nm) END
  END
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad ('the arguments are not a JSON object')
| IndexError : RAISE Bad ('the arguments are shorter than they say')
END Only ;

(* Arg answers argument name, or raises Bad for a missing one. *)
PROCEDURE Arg (a: PTR Json.Node ; RO name: STR) : PTR Json.Node RAISES Bad =
BEGIN
  IF Json.Field (a, name) IS SOME v THEN RETURN v END ;
  RAISE Bad ('missing argument ' + name)
END Arg ;

(* Int answers integer argument name, refused outside lo to hi. *)
PROCEDURE Int (a: PTR Json.Node ; RO name: STR ; lo, hi: I64) : I64 RAISES Bad =
VAR v : PTR Json.Node ; x : I64 ;
BEGIN
  v := Arg (a, name) ;
  x := Json.AsI64 (v) ;
  IF Json.AsF64 (v) # F64 (x) THEN RAISE Bad (name + ' is not an integer') END ;
  IF x < lo OR x > hi THEN RAISE Bad ($'${name} is out of range ${lo} to ${hi}') END ;
  RETURN x
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a number')
| ValueRange : RAISE Bad ($'${name} is out of range ${lo} to ${hi}')
END Int ;

PROCEDURE Real (a: PTR Json.Node ; RO name: STR) : F64 RAISES Bad =
BEGIN
  RETURN Json.AsF64 (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a number')
END Real ;

PROCEDURE Bool (a: PTR Json.Node ; RO name: STR) : BOOL RAISES Bad =
BEGIN
  RETURN Json.AsBool (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not true or false')
END Bool ;

PROCEDURE Str (a: PTR Json.Node ; RO name: STR) : STR RAISES Bad =
BEGIN
  RETURN Json.Text (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a string')
| ValueRange : RAISE Bad (name + ' is not UTF-8')
END Str ;

(* The readers of answers read a value node, not an argument. *)
PROCEDURE IntOf (v: PTR Json.Node ; RO what: STR ; lo, hi: I64) : I64 RAISES Bad =
VAR x : I64 ;
BEGIN
  x := Json.AsI64 (v) ;
  IF Json.AsF64 (v) # F64 (x) THEN RAISE Bad (what + ' is not an integer') END ;
  IF x < lo OR x > hi THEN RAISE Bad ($'${what} is out of range ${lo} to ${hi}') END ;
  RETURN x
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (what + ' is not a number')
| ValueRange : RAISE Bad ($'${what} is out of range ${lo} to ${hi}')
END IntOf ;

PROCEDURE RealOf (v: PTR Json.Node ; RO what: STR) : F64 RAISES Bad =
BEGIN
  RETURN Json.AsF64 (v)
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (what + ' is not a number')
END RealOf ;

PROCEDURE BoolOf (v: PTR Json.Node ; RO what: STR) : BOOL RAISES Bad =
BEGIN
  RETURN Json.AsBool (v)
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (what + ' is not true or false')
END BoolOf ;

PROCEDURE StrOf (v: PTR Json.Node ; RO what: STR) : STR RAISES Bad =
BEGIN
  RETURN Json.Text (v)
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (what + ' is not a string')
| ValueRange : RAISE Bad (what + ' is not UTF-8')
END StrOf ;

PROCEDURE ReadFlag (v: PTR Json.Node ; RO what: STR) : Obs.Flag RAISES Bad ;
PROCEDURE ReadReadingIn (VAR pool: POOL ; v: PTR Json.Node ; VAR r: Obs.Reading) RAISES Bad ;
PROCEDURE ReadBatchIn (VAR pool: POOL ; v: PTR Json.Node ; VAR r: Obs.Batch) RAISES Bad ;

PROCEDURE ReadFlag (v: PTR Json.Node ; RO what: STR) : Obs.Flag RAISES Bad =
VAR s : STR ;
BEGIN
  s := StrOf (v, what) ;
  IF Text.Eq (s, 'Good') THEN RETURN Obs.Flag.Good END ;
  IF Text.Eq (s, 'Suspect') THEN RETURN Obs.Flag.Suspect END ;
  IF Text.Eq (s, 'Bad') THEN RETURN Obs.Flag.Bad END ;
  RAISE Bad (what + ' is not one of Good, Suspect, Bad')
END ReadFlag ;

CONST
  ReadingSchema = '{"type":"object","properties":{"station":{"description":"the station' + "'" + 's name","type":"string"},"co2":{"description":"ppm","type":"number"},"height":{"description":"metres above ground","type":"integer","minimum":-32768,"maximum":32767},"flag":{"type":"string","enum":["Good","Suspect","Bad"]},"checked":{"type":"boolean"}},"required":["station","co2","height","flag","checked"],"additionalProperties":false}' ;
  ReadingFields = ['station', 'co2', 'height', 'flag', 'checked'] ;

PROCEDURE ReadReadingIn (VAR pool: POOL ; v: PTR Json.Node ; VAR r: Obs.Reading) RAISES Bad =
BEGIN
  Only (v, ReadingFields) ;
  r.station := Text.Keep (pool, StrOf (Arg (v, 'station'), 'station')) ;
  r.co2 := RealOf (Arg (v, 'co2'), 'co2') ;
  r.height := I16 (IntOf (Arg (v, 'height'), 'height', -32768, 32767)) ;
  r.flag := ReadFlag (Arg (v, 'flag'), 'flag') ;
  r.checked := BoolOf (Arg (v, 'checked'), 'checked') ;
  RETURN
EXCEPT
| ValueRange : RAISE Bad ('a field of Reading is out of range')
END ReadReadingIn ;

PROCEDURE ParseReading (VAR pool: POOL ; RO text: STR ; VAR r: Obs.Reading)
  RAISES Llm.FormatError =
BEGIN
  ReadReadingIn (pool, Json.Parse (text), r)
EXCEPT
| Json.ParseError (m, line, col) : RAISE Llm.FormatError ($'the answer is not JSON (${line}:${col}: ${m})')
| Bad (why) : RAISE Llm.FormatError ('the answer does not fit Obs.Reading: ' + why)
END ParseReading ;

PROCEDURE AskReading (VAR pool: POOL ; VAR c: Llm.Chat ; VAR r: Obs.Reading)
  RAISES Http.TransportError, Llm.ServerError, Llm.FormatError, Llm.Truncated, ValueRange =
VAR reply : Llm.Reply ;
BEGIN
  Llm.Expect (pool, c, 'Reading', ReadingSchema) ;
  BEGIN
    Llm.Send (pool, c, reply)
  FINALLY
    Llm.Free (c)
  END ;
  ParseReading (pool, reply.content, r)
END AskReading ;

PROCEDURE ReadingSchemaText () : STR =
BEGIN
  RETURN ReadingSchema
END ReadingSchemaText ;

CONST
  BatchSchema = '{"type":"object","properties":{"readings":{"type":"array","items":{"type":"object","properties":{"station":{"description":"the station' + "'" + 's name","type":"string"},"co2":{"description":"ppm","type":"number"},"height":{"description":"metres above ground","type":"integer","minimum":-32768,"maximum":32767},"flag":{"type":"string","enum":["Good","Suspect","Bad"]},"checked":{"type":"boolean"}},"required":["station","co2","height","flag","checked"],"additionalProperties":false}},"note":{"type":"string"}},"required":["readings","note"],"additionalProperties":false}' ;
  BatchFields = ['readings', 'note'] ;

PROCEDURE ReadBatchIn (VAR pool: POOL ; v: PTR Json.Node ; VAR r: Obs.Batch) RAISES Bad =
VAR s : PTR Json.Node ; n, i : I64 ;
BEGIN
  Only (v, BatchFields) ;
  s := Arg (v, 'readings') ;
  n := Json.Count (s) ;
  r.readings := NEW (pool, Obs.Reading, n) ;
  FOR i := 0 TO n - 1 DO
    ReadReadingIn (pool, Json.Item (s, i), r.readings[i])
  END ;
  r.note := Text.Keep (pool, StrOf (Arg (v, 'note'), 'note')) ;
  RETURN
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad ('a list of Batch is not a list')
| IndexError : RAISE Bad ('a list of Batch is shorter than it says')
END ReadBatchIn ;

PROCEDURE ParseBatch (VAR pool: POOL ; RO text: STR ; VAR r: Obs.Batch)
  RAISES Llm.FormatError =
BEGIN
  ReadBatchIn (pool, Json.Parse (text), r)
EXCEPT
| Json.ParseError (m, line, col) : RAISE Llm.FormatError ($'the answer is not JSON (${line}:${col}: ${m})')
| Bad (why) : RAISE Llm.FormatError ('the answer does not fit Obs.Batch: ' + why)
END ParseBatch ;

PROCEDURE AskBatch (VAR pool: POOL ; VAR c: Llm.Chat ; VAR r: Obs.Batch)
  RAISES Http.TransportError, Llm.ServerError, Llm.FormatError, Llm.Truncated, ValueRange =
VAR reply : Llm.Reply ;
BEGIN
  Llm.Expect (pool, c, 'Batch', BatchSchema) ;
  BEGIN
    Llm.Send (pool, c, reply)
  FINALLY
    Llm.Free (c)
  END ;
  ParseBatch (pool, reply.content, r)
END AskBatch ;

PROCEDURE BatchSchemaText () : STR =
BEGIN
  RETURN BatchSchema
END BatchSchemaText ;

PROCEDURE Offer (VAR pool: POOL ; VAR c: Llm.Chat) RAISES Llm.FormatError =
BEGIN
END Offer ;

PROCEDURE Run (RO call: Llm.Call) : STR =
VAR a : PTR Json.Node ;
BEGIN
  a := Json.Parse (call.arguments) ;
  RETURN Err ('no tool named ' + call.name)
EXCEPT
| Json.ParseError (m, line, col) : RETURN Err ($'the arguments are not JSON (${line}:${col}: ${m})')
END Run ;

PROCEDURE Answer (VAR pool: POOL ; VAR c: Llm.Chat ; RO r: Llm.Reply) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (r.calls) - 1 DO
    Llm.ToolResult (pool, c, r.calls[i].id, Run (r.calls[i]))
  END
END Answer ;

END ObsTools.
