  (* Run runs call and answers its result as text, or {"error": ...}. *)

PROCEDURE Answer (VAR pool: POOL ; VAR c: Llm.Chat ; RO r: Llm.Reply) ;
  (* Answer runs every call of r and adds each result to c. *)

