(* Generated by tools/M9Tools.m9 from Calc.json: do not edit, make it again. *)
DEFINITION MODULE CalcTools ;

(* CalcTools offers the procedures of Calc to a chat model as tools
   and runs the calls it makes (tools/M9Tools.m9 says how).

   offered: Mul
   offered: Div
   offered: Shrink
   offered: Mean
   offered: Greet
   offered: Note
   left out: Fill: a VAR parameter
   left out: Sum: a parameter of type SLICE OF I64
*)

IMPORT Llm ;

PROCEDURE Offer (VAR pool: POOL ; VAR c: Llm.Chat) RAISES Llm.FormatError ;
  (* Offer adds every procedure offered to c as a tool. *)

PROCEDURE Run (RO call: Llm.Call) : STR ;
  (* Run runs call and answers its result as text, or {"error": ...}. *)

PROCEDURE Answer (VAR pool: POOL ; VAR c: Llm.Chat ; RO r: Llm.Reply) ;
  (* Answer runs every call of r and adds each result to c. *)

END CalcTools.


IMPLEMENTATION MODULE CalcTools ;

IMPORT Calc ;
IMPORT Json ;
IMPORT Llm ;
IMPORT Text ;

EXCEPTION
  Bad (RO why: STR) ;

CONST
  NoArgs = [''] ;

(* Err answers why as the tool result {"error": why}. *)
PROCEDURE Err (RO why: STR) : STR =
BEGIN
  RETURN '{"error":' + Json.Quote (why) + '}'
END Err ;

(* Only raises Bad for an argument that names is without, and for
   arguments that are not an object. *)
PROCEDURE Only (a: PTR Json.Node ; RO names: SLICE OF STR) RAISES Bad =
VAR i : I64 ; nm : STR ;
BEGIN
  FOR i := 0 TO Json.MemberCount (a) - 1 DO
    nm := Json.NameAt (a, i) ;
    IF NOT Text.OneOf (nm, names) OR Text.BLen (nm) = 0 THEN RAISE Bad ('unknown argument ' + nm) END
  END
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad ('the arguments are not a JSON object')
| IndexError : RAISE Bad ('the arguments are shorter than they say')
END Only ;

(* Arg answers argument name, or raises Bad for a missing one. *)
PROCEDURE Arg (a: PTR Json.Node ; RO name: STR) : PTR Json.Node RAISES Bad =
BEGIN
  IF Json.Field (a, name) IS SOME v THEN RETURN v END ;
  RAISE Bad ('missing argument ' + name)
END Arg ;

(* Int answers integer argument name, refused outside lo to hi. *)
PROCEDURE Int (a: PTR Json.Node ; RO name: STR ; lo, hi: I64) : I64 RAISES Bad =
VAR v : PTR Json.Node ; x : I64 ;
BEGIN
  v := Arg (a, name) ;
  x := Json.AsI64 (v) ;
  IF Json.AsF64 (v) # F64 (x) THEN RAISE Bad (name + ' is not an integer') END ;
  IF x < lo OR x > hi THEN RAISE Bad ($'${name} is out of range ${lo} to ${hi}') END ;
  RETURN x
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a number')
| ValueRange : RAISE Bad ($'${name} is out of range ${lo} to ${hi}')
END Int ;

PROCEDURE Real (a: PTR Json.Node ; RO name: STR) : F64 RAISES Bad =
BEGIN
  RETURN Json.AsF64 (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a number')
END Real ;

PROCEDURE Bool (a: PTR Json.Node ; RO name: STR) : BOOL RAISES Bad =
BEGIN
  RETURN Json.AsBool (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not true or false')
END Bool ;

PROCEDURE Str (a: PTR Json.Node ; RO name: STR) : STR RAISES Bad =
BEGIN
  RETURN Json.Text (Arg (a, name))
EXCEPT
| Json.TypeMismatch (m) : RAISE Bad (name + ' is not a string')
| ValueRange : RAISE Bad (name + ' is not UTF-8')
END Str ;

CONST
  MulSchema = '{"type":"object","properties":{"a":{"type":"integer"},"b":{"type":"integer"}},"required":["a","b"],"additionalProperties":false}' ;
  MulArgs = ['a', 'b'] ;

PROCEDURE RunMul (a: PTR Json.Node) : STR =
VAR
  x0 : I64 ;
  x1 : I64 ;
  r : I64 ;
BEGIN
  Only (a, MulArgs) ;
  x0 := Int (a, 'a', -MAX (I64) - 1, MAX (I64)) ;
  x1 := Int (a, 'b', -MAX (I64) - 1, MAX (I64)) ;
  r := Calc.Mul (x0, x1) ;
  RETURN $'${r}'
EXCEPT
| Bad (why) : RETURN Err (why)
| Overflow : RETURN Err ('Overflow')
END RunMul ;

CONST
  DivSchema = '{"type":"object","properties":{"a":{"type":"integer"},"b":{"type":"integer"}},"required":["a","b"],"additionalProperties":false}' ;
  DivArgs = ['a', 'b'] ;

PROCEDURE RunDiv (a: PTR Json.Node) : STR =
VAR
  x0 : I64 ;
  x1 : I64 ;
  r : I64 ;
BEGIN
  Only (a, DivArgs) ;
  x0 := Int (a, 'a', -MAX (I64) - 1, MAX (I64)) ;
  x1 := Int (a, 'b', -MAX (I64) - 1, MAX (I64)) ;
  r := Calc.Div (x0, x1) ;
  RETURN $'${r}'
EXCEPT
| Bad (why) : RETURN Err (why)
| Calc.DivZero (f0, f1) : RETURN Err ($'Calc.DivZero (what ${f0}, n ${f1})')
END RunDiv ;

CONST
  ShrinkSchema = '{"type":"object","properties":{"n":{"type":"integer","minimum":-128,"maximum":127}},"required":["n"],"additionalProperties":false}' ;
  ShrinkArgs = ['n'] ;

PROCEDURE RunShrink (a: PTR Json.Node) : STR =
VAR
  x0 : I8 ;
  r : I8 ;
BEGIN
  Only (a, ShrinkArgs) ;
  x0 := I8 (Int (a, 'n', -128, 127)) ;
  r := Calc.Shrink (x0) ;
  RETURN $'${r}'
EXCEPT
| Bad (why) : RETURN Err (why)
| ValueRange : RETURN Err ('ValueRange')
END RunShrink ;

CONST
  MeanSchema = '{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"}},"required":["x","y"],"additionalProperties":false}' ;
  MeanArgs = ['x', 'y'] ;

PROCEDURE RunMean (a: PTR Json.Node) : STR =
VAR
  x0 : F64 ;
  x1 : F64 ;
  r : F64 ;
BEGIN
  Only (a, MeanArgs) ;
  x0 := Real (a, 'x') ;
  x1 := Real (a, 'y') ;
  r := Calc.Mean (x0, x1) ;
  RETURN $'${r}'
EXCEPT
| Bad (why) : RETURN Err (why)
END RunMean ;

CONST
  GreetSchema = '{"type":"object","properties":{"name":{"type":"string"},"loud":{"type":"boolean"}},"required":["name","loud"],"additionalProperties":false}' ;
  GreetArgs = ['name', 'loud'] ;

PROCEDURE RunGreet (a: PTR Json.Node) : STR =
VAR
  x0 : STR ;
  x1 : BOOL ;
  r : STR ;
BEGIN
  Only (a, GreetArgs) ;
  x0 := Str (a, 'name') ;
  x1 := Bool (a, 'loud') ;
  r := Calc.Greet (x0, x1) ;
  RETURN r
EXCEPT
| Bad (why) : RETURN Err (why)
END RunGreet ;

CONST
  NoteSchema = '{"type":"object","properties":{"line":{"type":"string"}},"required":["line"],"additionalProperties":false}' ;
  NoteArgs = ['line'] ;

PROCEDURE RunNote (a: PTR Json.Node) : STR =
VAR
  x0 : STR ;
BEGIN
  Only (a, NoteArgs) ;
  x0 := Str (a, 'line') ;
  Calc.Note (x0) ;
  RETURN 'done'
EXCEPT
| Bad (why) : RETURN Err (why)
END RunNote ;

PROCEDURE Offer (VAR pool: POOL ; VAR c: Llm.Chat) RAISES Llm.FormatError =
BEGIN
  Llm.Tool (pool, c, 'Mul',
    'Mul answers a times b.',
    MulSchema) ;
  Llm.Tool (pool, c, 'Div',
    'Div answers a divided by b, the fraction dropped: -7 by 2 is -3.',
    DivSchema) ;
  Llm.Tool (pool, c, 'Shrink',
    'Shrink answers n halved: an I8, so -128 to 127.',
    ShrinkSchema) ;
  Llm.Tool (pool, c, 'Mean',
    'Mean (x, y: F64) : F64',
    MeanSchema) ;
  Llm.Tool (pool, c, 'Greet',
    'Greet says "hello" to name; it' + "'" + 's loud when asked.',
    GreetSchema) ;
  Llm.Tool (pool, c, 'Note',
    'Note takes a line and answers nothing.',
    NoteSchema) ;
END Offer ;

PROCEDURE Run (RO call: Llm.Call) : STR =
VAR a : PTR Json.Node ;
BEGIN
  a := Json.Parse (call.arguments) ;
  IF Text.Eq (call.name, 'Mul') THEN RETURN RunMul (a) END ;
  IF Text.Eq (call.name, 'Div') THEN RETURN RunDiv (a) END ;
  IF Text.Eq (call.name, 'Shrink') THEN RETURN RunShrink (a) END ;
  IF Text.Eq (call.name, 'Mean') THEN RETURN RunMean (a) END ;
  IF Text.Eq (call.name, 'Greet') THEN RETURN RunGreet (a) END ;
  IF Text.Eq (call.name, 'Note') THEN RETURN RunNote (a) END ;
  RETURN Err ('no tool named ' + call.name)
EXCEPT
| Json.ParseError (m, line, col) : RETURN Err ($'the arguments are not JSON (${line}:${col}: ${m})')
END Run ;

PROCEDURE Answer (VAR pool: POOL ; VAR c: Llm.Chat ; RO r: Llm.Reply) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (r.calls) - 1 DO
    Llm.ToolResult (pool, c, r.calls[i].id, Run (r.calls[i]))
  END
END Answer ;

END CalcTools.
