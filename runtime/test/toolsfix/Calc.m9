DEFINITION MODULE Calc ;

(* Calc is the module runtime/test/llmtools.sh makes tools of with
   tools/M9Tools.m9.  Its procedures hold each kind of heading the
   generator takes, and two it leaves out. *)

EXCEPTION
  DivZero (RO what: STR ; n: I64) ;
    (* DivZero names the division and its numerator. *)

PROCEDURE Mul (a, b: I64) : I64 RAISES Overflow ;
  (* Mul answers a times b. *)

PROCEDURE Div (a, b: I64) : I64 RAISES DivZero ;
  (* Div answers a divided by b, the fraction dropped: -7 by 2 is -3. *)

PROCEDURE Shrink (n: I8) : I8 ;
  (* Shrink answers n halved: an I8, so -128 to 127. *)

PROCEDURE Mean (x, y: F64) : F64 ;

PROCEDURE Greet (RO name: STR ; loud: BOOL) : STR ;
  (* Greet says "hello" to name; it's loud when asked. *)

PROCEDURE Note (RO line: STR) ;
  (* Note takes a line and answers nothing. *)

PROCEDURE Fill (VAR s: SLICE OF I64) ;
  (* Fill is left out: a tool cannot hand back a VAR. *)

PROCEDURE Sum (RO xs: SLICE OF I64) : I64 RAISES Overflow ;
  (* Sum is left out: a slice has no schema yet. *)

END Calc.


IMPLEMENTATION MODULE Calc ;

PROCEDURE Mul (a, b: I64) : I64 RAISES Overflow =
BEGIN
  RETURN a * b
END Mul ;

PROCEDURE Div (a, b: I64) : I64 RAISES DivZero =
BEGIN
  IF b = 0 THEN RAISE DivZero ('Div', a) END ;
  RETURN a DIV b
END Div ;

PROCEDURE Shrink (n: I8) : I8 =
BEGIN
  RETURN n DIV 2
END Shrink ;

PROCEDURE Mean (x, y: F64) : F64 =
BEGIN
  RETURN (x + y) / 2.0
END Mean ;

PROCEDURE Greet (RO name: STR ; loud: BOOL) : STR =
BEGIN
  IF loud THEN RETURN 'HELLO ' + name END ;
  RETURN 'hello ' + name
END Greet ;

PROCEDURE Note (RO line: STR) =
BEGIN
END Note ;

PROCEDURE Fill (VAR s: SLICE OF I64) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO s[i] := i END
END Fill ;

PROCEDURE Sum (RO xs: SLICE OF I64) : I64 RAISES Overflow =
VAR i, t : I64 ;
BEGIN
  t := 0 ;
  FOR i := 0 TO LEN (xs) - 1 DO t := t + xs[i] END ;
  RETURN t
END Sum ;

END Calc.
