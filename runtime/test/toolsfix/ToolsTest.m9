MODULE ToolsTest ;

(* ToolsTest runs CalcTools, made by tools/M9Tools.m9 from Calc, on
   calls a model could make: right ones, and ones each reader must
   refuse.  It prints one line a call, `NAME ARGUMENTS -> RESULT',
   and then the request Offer makes, `BODY ...'.  runtime/test/
   llmtools.sh holds the lines to a recorded list, and has Python check
   the schemas in the body against what Run took and refused. *)

IMPORT CalcTools ;
IMPORT Io ;
IMPORT Llm ;

CONST
  Names = ['Mul', 'Mul', 'Mul', 'Mul', 'Mul', 'Mul',
           'Div', 'Div', 'Div',
           'Shrink', 'Shrink', 'Shrink',
           'Mean',
           'Greet', 'Greet',
           'Note',
           'Nope', 'Mul', 'Mul', 'Fill'] ;
  Args = ['{"a":17,"b":23}', '{"a":17}', '{"a":17,"b":23,"c":1}',
          '{"a":"17","b":23}', '{"a":2.5,"b":2}', '{"a":4611686018427387904,"b":2}',
          '{"a":7,"b":2}', '{"a":-7,"b":2}', '{"a":7,"b":0}',
          '{"n":100}', '{"n":200}', '{"n":-128}',
          '{"x":1,"y":2.5}',
          '{"name":"Ann \"A\" \\ ₂","loud":true}', '{"name":"x","loud":"yes"}',
          '{"line":"x"}',
          '{}', 'not json', '[1,2]', '{}'] ;

VAR
  pool : POOL ;
  c : Llm.Chat ;
  i : I64 ;

BEGIN
  FOR i := 0 TO LEN (Names) - 1 DO
    Io.WriteLine (Names[i] + ' ' + Args[i] + ' -> '
                  + CalcTools.Run (Llm.Call ('call' + $'${i}', Names[i], Args[i])))
  END ;
  Llm.Init (pool, c, 'http://127.0.0.1:1/v1', 'm') ;
  CalcTools.Offer (pool, c) ;
  Io.WriteLine ('BODY ' + Llm.Body (c))
EXCEPT
| Llm.FormatError (m) : Io.ErrLine ('ToolsTest: a schema was refused: ' + m) ; Io.Halt (1)
END ToolsTest.
