DEFINITION MODULE BndMid ;

(* a second level: bounds that name BndDef's CONSTs, one of its own in
   an expression with BndDef's, and an exported VAR whose type is
   written in place *)

IMPORT BndDef ;

CONST K = 5 ;
TYPE
  W = ARRAY BndDef.N OF F64 ;
  Ks = ARRAY K OF I64 ;
  Kk = ARRAY K * BndDef.M OF I64 ;
VAR
  tw : ARRAY 2 * K OF I32 ;

PROCEDURE Total (RO k: Ks) : I64 ;

END BndMid.


IMPLEMENTATION MODULE BndMid ;

PROCEDURE Total (RO k: Ks) : I64 =
VAR i, s : I64 ;
BEGIN
  s := 0 ;
  FOR i := 0 TO K - 1 DO s := s + k[i] END ;
  RETURN s
END Total ;

BEGIN
  tw[9] := 99
END BndMid.
