DEFINITION MODULE Parse ;

IMPORT Ast ;

IMPORT Lex ;

CONST
  MaxErr = 64 ;
  MaxDepth = 1000 ;
  MaxTypeDepth = 100 ;

TYPE
  Perr = RECORD
    line, col : I64 ;
    msg : UTF ;
  END ;
  Parser = RECORD
    lx : Lex.Lexer ;
    cur, peekTok : Lex.Token ;
    peeked : BOOL ;
    nerr : I64 ;
    nkept : I64 ;
    errs : ARRAY MaxErr OF Perr ;
    depth : I64 ;
    tdepth : I64 ;
    deep : BOOL ;
  END ;

PROCEDURE Init (VAR p: Parser ; RO src: STR) ;

PROCEDURE InitUtf (VAR p: Parser ; RO src: UTF) ;

PROCEDURE File (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

END Parse.


IMPLEMENTATION MODULE Parse ;

IMPORT Ast ;

IMPORT Lex ;

IMPORT Text ;

CONST
  TkEOF = 0 ;
  TkError = 1 ;
  TkIdent = 2 ;
  TkInt = 3 ;
  TkReal = 4 ;
  TkChar = 5 ;
  TkStr = 6 ;
  TkAND = 7 ;
  TkARRAY = 8 ;
  TkBEGIN = 9 ;
  TkBY = 10 ;
  TkCASE = 11 ;
  TkCONST = 12 ;
  TkDEFINITION = 13 ;
  TkDISPOSE = 14 ;
  TkDIV = 15 ;
  TkDO = 16 ;
  TkELSE = 17 ;
  TkELSIF = 18 ;
  TkEND = 19 ;
  TkEXCEPT = 20 ;
  TkEXCEPTION = 21 ;
  TkEXIT = 22 ;
  TkFALSE = 23 ;
  TkFINALLY = 24 ;
  TkFOR = 25 ;
  TkFROM = 26 ;
  TkIF = 27 ;
  TkIMPLEMENTATION = 28 ;
  TkIMPORT = 29 ;
  TkIN = 30 ;
  TkIS = 31 ;
  TkLOOP = 32 ;
  TkMOD = 33 ;
  TkMODULE = 34 ;
  TkMONITOR = 35 ;
  TkNEW = 36 ;
  TkNONE = 37 ;
  TkNOT = 38 ;
  TkOF = 39 ;
  TkOPT = 40 ;
  TkOR = 41 ;
  TkOWN = 42 ;
  TkPOOL = 43 ;
  TkPROCEDURE = 44 ;
  TkPTR = 45 ;
  TkRAISE = 46 ;
  TkRAISES = 47 ;
  TkRECORD = 48 ;
  TkRETURN = 49 ;
  TkSHARED = 50 ;
  TkSIGNAL = 51 ;
  TkSLICE = 52 ;
  TkSOME = 53 ;
  TkSTATEFUL = 54 ;
  TkTHEN = 55 ;
  TkTHREAD = 56 ;
  TkTO = 57 ;
  TkTRANSFER = 58 ;
  TkTRUE = 59 ;
  TkTYPE = 60 ;
  TkUNSAFE = 61 ;
  TkVAR = 62 ;
  TkWAIT = 63 ;
  TkWHILE = 64 ;
  TkRO = 65 ;
  TkGRID = 66 ;
  TkKEPT = 67 ;
  TkLINK = 68 ;
  TkTASK = 69 ;
  TkAssign = 200 ;
  TkEq = 201 ;
  TkNeq = 202 ;
  TkLt = 203 ;
  TkLe = 204 ;
  TkGt = 205 ;
  TkGe = 206 ;
  TkPlus = 207 ;
  TkMinus = 208 ;
  TkStar = 209 ;
  TkSlash = 210 ;
  TkPlusW = 211 ;
  TkMinusW = 212 ;
  TkStarW = 213 ;
  TkLParen = 214 ;
  TkRParen = 215 ;
  TkLBrack = 216 ;
  TkRBrack = 217 ;
  TkComma = 218 ;
  TkSemi = 219 ;
  TkColon = 220 ;
  TkDot = 221 ;
  TkDotDot = 222 ;
  TkBar = 223 ;
  TkCaret = 224 ;
  SEnd = 0 ;
  SBlock = 1 ;
  SIf = 2 ;
  SHandler = 3 ;
  SArm = 4 ;
  SRParen = 5 ;
  SVariantF = 6 ;

PROCEDURE InStops (sid, k: I64) : BOOL =
BEGIN
  IF k = TkEND THEN
    RETURN sid # SRParen
  END ;
  CASE sid OF
  | SEnd :
      RETURN FALSE
  | SBlock :
      RETURN k = TkEXCEPT OR k = TkFINALLY
  | SIf :
      RETURN k = TkELSIF OR k = TkELSE
  | SHandler :
      RETURN k = TkBar OR k = TkFINALLY
  | SArm :
      RETURN k = TkBar OR k = TkELSE
  | SRParen :
      RETURN k = TkRParen
  | SVariantF :
      RETURN k = TkBar
  ELSE
      RETURN FALSE
  END
END InStops ;

PROCEDURE IsDeclStart (k: I64) : BOOL =
BEGIN
  RETURN k = TkCONST OR k = TkTYPE OR k = TkVAR OR k = TkEXCEPTION OR k = TkPROCEDURE
END IsDeclStart ;

PROCEDURE IsRelOp (k: I64) : BOOL =
BEGIN
  RETURN k >= TkEq AND k <= TkGe
END IsRelOp ;

PROCEDURE IsAddOp (k: I64) : BOOL =
BEGIN
  RETURN k = TkPlus OR k = TkMinus OR k = TkPlusW OR k = TkMinusW
END IsAddOp ;

PROCEDURE IsMulOp (k: I64) : BOOL =
BEGIN
  RETURN k = TkStar OR k = TkSlash OR k = TkStarW OR k = TkDIV OR k = TkMOD
END IsMulOp ;

PROCEDURE OpText (k: I64) : STR =
BEGIN
  CASE k OF
  | TkEq :
      RETURN '='
  | TkNeq :
      RETURN '#'
  | TkLt :
      RETURN '<'
  | TkLe :
      RETURN '<='
  | TkGt :
      RETURN '>'
  | TkGe :
      RETURN '>='
  | TkPlus :
      RETURN '+'
  | TkMinus :
      RETURN '-'
  | TkStar :
      RETURN '*'
  | TkSlash :
      RETURN '/'
  | TkPlusW :
      RETURN '+%'
  | TkMinusW :
      RETURN '-%'
  | TkStarW :
      RETURN '*%'
  | TkDIV :
      RETURN 'DIV'
  | TkMOD :
      RETURN 'MOD'
  | TkOR :
      RETURN 'OR'
  | TkAND :
      RETURN 'AND'
  ELSE
      RETURN '?'
  END
END OpText ;

PROCEDURE Spell (k: I64) : UTF =
BEGIN
  CASE k OF
  | TkAssign :
      RETURN ':='
  | TkEq :
      RETURN '='
  | TkLParen :
      RETURN '('
  | TkRParen :
      RETURN ')'
  | TkLBrack :
      RETURN '['
  | TkRBrack :
      RETURN ']'
  | TkComma :
      RETURN ','
  | TkSemi :
      RETURN ';'
  | TkColon :
      RETURN ':'
  | TkDot :
      RETURN '.'
  | TkDotDot :
      RETURN '..'
  | TkBar :
      RETURN '|'
  | TkIdent :
      RETURN 'identifier'
  ELSE
      RETURN UTF (Lex.KindName (k))
  END
END Spell ;

PROCEDURE ErrAt (VAR p: Parser ; ln: I64 ; cl: I64 ; RO msg: UTF) =
BEGIN
  IF p.deep THEN
    RETURN
  END ;
  IF p.nerr < MaxErr THEN
    p.errs[p.nerr].line := ln ;
    p.errs[p.nerr].col := cl ;
    p.errs[p.nerr].msg := UTF (HEAP, msg) ;
    p.nkept := p.nerr + 1
  END ;
  p.nerr := p.nerr + 1
END ErrAt ;

PROCEDURE Rerr (VAR p: Parser ; RO msg: UTF) =
BEGIN
  ErrAt (p, p.cur.line, p.cur.col, msg)
END Rerr ;

PROCEDURE Bump (VAR p: Parser) =
BEGIN
  IF p.deep THEN
    p.cur.kind := TkEOF ;
    RETURN
  END ;
  LOOP
    IF p.peeked THEN
      p.cur := p.peekTok ;
      p.peeked := FALSE
    ELSE
      Lex.Next (p.lx, p.cur)
    END ;
    IF p.cur.kind # TkError THEN
      EXIT
    END ;
    ErrAt (p, p.cur.line, p.cur.col, 'lex: ' + p.cur.text)
  END
END Bump ;

PROCEDURE NxtKind (VAR p: Parser) : I64 =
BEGIN
  IF p.deep THEN
    RETURN TkEOF
  END ;
  IF NOT p.peeked THEN
    LOOP
      Lex.Next (p.lx, p.peekTok) ;
      IF p.peekTok.kind # TkError THEN
        EXIT
      END ;
      ErrAt (p, p.peekTok.line, p.peekTok.col, 'lex: ' + p.peekTok.text)
    END ;
    p.peeked := TRUE
  END ;
  RETURN p.peekTok.kind
END NxtKind ;

PROCEDURE Expect (VAR p: Parser ; k: I64) =
BEGIN
  IF p.cur.kind = k THEN
    Bump (p)
  ELSE
    Rerr (p, Spell (k) + ' expected, found ' + UTF (Lex.KindName (p.cur.kind)) + " '" + p.cur.text + "'")
  END
END Expect ;

PROCEDURE TakeIdent (VAR p: Parser ; RO what: UTF) : UTF =
VAR
  s : UTF ;
BEGIN
  IF p.cur.kind = TkIdent THEN
    s := p.cur.text ;
    Bump (p) ;
    RETURN s
  END ;
  Rerr (p, what + ' (identifier) expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
  RETURN ''
END TakeIdent ;

PROCEDURE Deeper (VAR p: Parser ; by: I64) =
BEGIN
  p.depth := p.depth + by ;
  IF p.depth > MaxDepth AND NOT p.deep THEN
    Rerr (p, 'nesting deeper than 1000 levels: the expression, statement or type here is too deep to compile -- give a part a name of its own, a local, a procedure or a TYPE') ;
    p.deep := TRUE ;
    p.cur.kind := TkEOF
  END
END Deeper ;

PROCEDURE Nn (VAR pool: POOL ; VAR p: Parser ; kind: I64) : PTR Ast.Node =
BEGIN
  RETURN Ast.NewNode (pool, kind, p.cur.line, p.cur.col)
END Nn ;

PROCEDURE Started (VAR p: Parser) =
BEGIN
  p.peeked := FALSE ;
  p.nerr := 0 ;
  p.depth := 0 ;
  p.tdepth := 0 ;
  p.deep := FALSE ;
  Bump (p)
END Started ;

PROCEDURE Init (VAR p: Parser ; RO src: STR) =
BEGIN
  Lex.Init (p.lx, src) ;
  Started (p)
END Init ;

PROCEDURE InitUtf (VAR p: Parser ; RO src: UTF) =
BEGIN
  Lex.InitUtf (p.lx, src) ;
  Started (p)
END InitUtf ;

PROCEDURE PExpr (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

PROCEDURE PType (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

PROCEDURE PStmtSeq (VAR pool: POOL ; VAR KEPT p: Parser ; sid: I64) : PTR Ast.Node ;

PROCEDURE PDeclaration (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

PROCEDURE PBlock (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

PROCEDURE PDesignator (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node ;

PROCEDURE PQualident (VAR pool: POOL ; VAR p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NQualident) ;
  Ast.SetA (pool, n, TakeIdent (p, 'name')) ;
  IF p.cur.kind = TkDot THEN
    Bump (p) ;
    Ast.SetB (pool, n, TakeIdent (p, 'name after .'))
  END ;
  RETURN n
END PQualident ;

PROCEDURE PIdentList (VAR pool: POOL ; VAR p: Parser) : PTR Ast.Node =
VAR
  n, id : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NIdentList) ;
  id := Nn (pool, p, Ast.NIdent) ;
  Ast.SetA (pool, id, TakeIdent (p, 'name')) ;
  Ast.Add (pool, n, SOME (id)) ;
  WHILE p.cur.kind = TkComma DO
    Bump (p) ;
    id := Nn (pool, p, Ast.NIdent) ;
    Ast.SetA (pool, id, TakeIdent (p, 'name')) ;
    Ast.Add (pool, n, SOME (id))
  END ;
  RETURN n
END PIdentList ;

PROCEDURE PArgList (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NArgList) ;
  Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
  WHILE p.cur.kind = TkComma DO
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p)))
  END ;
  RETURN n
END PArgList ;

PROCEDURE DesigToQual (VAR pool: POOL ; VAR p: Parser ; d: PTR Ast.Node) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NQualident) ;
  Ast.SetA (pool, n, d.au) ;
  IF d.nkids = 0 THEN
    RETURN n
  END ;
  IF d.nkids = 1 THEN
    IF d.kids[0] IS SOME sel THEN
      IF sel.kind = Ast.NSelField THEN
        Ast.SetB (pool, n, sel.au) ;
        RETURN n
      END
    END
  END ;
  Rerr (p, 'a qualified name is Module.Name, no further selectors') ;
  RETURN n
END DesigToQual ;

PROCEDURE PNew (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, d1, d2 : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NNewExpr) ;
  Expect (p, TkNEW) ;
  Expect (p, TkLParen) ;
  IF p.cur.kind = TkOWN THEN
    d1 := Nn (pool, p, Ast.NDesignator) ;
    Ast.SetA (pool, d1, 'OWN') ;
    Bump (p) ;
    Expect (p, TkComma) ;
    d2 := PDesignator (pool, p) ;
    Ast.Add (pool, n, SOME (d1)) ;
    Ast.Add (pool, n, SOME (DesigToQual (pool, p, d2))) ;
    Ast.Add (pool, n, NONE)
  ELSE
    d1 := PDesignator (pool, p) ;
    IF p.cur.kind = TkComma THEN
      Bump (p) ;
      Ast.Add (pool, n, SOME (d1)) ;
      Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
      IF p.cur.kind = TkComma THEN
        Bump (p) ;
        Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
        WHILE p.cur.kind = TkComma DO
          Bump (p) ;
          Ast.Add (pool, n, SOME (PExpr (pool, p)))
        END
      ELSE
        Ast.Add (pool, n, NONE)
      END
    ELSE
      Ast.Add (pool, n, NONE) ;
      Ast.Add (pool, n, SOME (DesigToQual (pool, p, d1))) ;
      Ast.Add (pool, n, NONE)
    END
  END ;
  Expect (p, TkRParen) ;
  RETURN n
END PNew ;

PROCEDURE Closes (k: I64) : BOOL =
BEGIN
  RETURN k = TkSemi OR k = TkEND OR k = TkELSE OR k = TkELSIF OR k = TkTHEN OR k = TkDO OR k = TkOF OR k = TkRParen OR k = TkRBrack OR k = TkComma OR k = TkBar OR k = TkEXCEPT OR k = TkFINALLY OR k = TkTO OR k = TkBY OR k = TkEOF
END Closes ;

PROCEDURE PFactor (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, d, cs : PTR Ast.Node ;
BEGIN
  Deeper (p, 1) ;
  IF p.cur.kind = TkInt THEN
    n := Nn (pool, p, Ast.NInt) ;
    Ast.SetA (pool, n, p.cur.text) ;
    Bump (p)
  ELSIF p.cur.kind = TkReal THEN
    n := Nn (pool, p, Ast.NReal) ;
    Ast.SetA (pool, n, p.cur.text) ;
    Bump (p)
  ELSIF p.cur.kind = TkChar THEN
    n := Nn (pool, p, Ast.NChar) ;
    Ast.SetA (pool, n, p.cur.text) ;
    Bump (p)
  ELSIF p.cur.kind = TkStr THEN
    n := Nn (pool, p, Ast.NString) ;
    Ast.SetA (pool, n, p.cur.text) ;
    Bump (p)
  ELSIF p.cur.kind = TkTRUE THEN
    n := Nn (pool, p, Ast.NTrue) ;
    Bump (p)
  ELSIF p.cur.kind = TkFALSE THEN
    n := Nn (pool, p, Ast.NFalse) ;
    Bump (p)
  ELSIF p.cur.kind = TkNONE THEN
    n := Nn (pool, p, Ast.NNoneLit) ;
    Bump (p)
  ELSIF p.cur.kind = TkSOME THEN
    n := Nn (pool, p, Ast.NSomeExpr) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen)
  ELSIF p.cur.kind = TkSHARED THEN
    n := Nn (pool, p, Ast.NSharedExpr) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen)
  ELSIF p.cur.kind = TkNEW THEN
    n := PNew (pool, p)
  ELSIF p.cur.kind = TkGRID THEN
    n := Nn (pool, p, Ast.NGridOf) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    WHILE p.cur.kind = TkComma DO
      Bump (p) ;
      Ast.Add (pool, n, SOME (PExpr (pool, p)))
    END ;
    Expect (p, TkRParen)
  ELSIF p.cur.kind = TkSLICE THEN
    n := Nn (pool, p, Ast.NSliceOf3) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkComma) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkComma) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen)
  ELSIF p.cur.kind = TkNOT THEN
    n := Nn (pool, p, Ast.NUn) ;
    Ast.SetA (pool, n, 'NOT') ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PFactor (pool, p)))
  ELSIF p.cur.kind = TkLParen THEN
    n := Nn (pool, p, Ast.NParen) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen)
  ELSIF p.cur.kind = TkIdent THEN
    d := PDesignator (pool, p) ;
    IF p.cur.kind = TkLParen THEN
      n := Nn (pool, p, Ast.NCallExpr) ;
      Ast.Add (pool, n, SOME (d)) ;
      Bump (p) ;
      IF p.cur.kind = TkRParen THEN
        Ast.Add (pool, n, SOME (Nn (pool, p, Ast.NArgList)))
      ELSE
        Ast.Add (pool, n, SOME (PArgList (pool, p)))
      END ;
      Expect (p, TkRParen) ;
      IF p.cur.kind = TkDot OR p.cur.kind = TkLBrack THEN
        cs := Nn (pool, p, Ast.NCallSel) ;
        Ast.Add (pool, cs, SOME (n)) ;
        PSels (pool, p, cs) ;
        n := cs
      END
    ELSE
      n := d
    END
  ELSE
    Rerr (p, 'expression expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
    n := Nn (pool, p, Ast.NInt) ;
    Ast.SetA (pool, n, '0') ;
    IF NOT Closes (p.cur.kind) THEN
      Bump (p)
    END
  END ;
  p.depth := p.depth - 1 ;
  RETURN n
END PFactor ;

PROCEDURE PTerm (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, r : PTR Ast.Node ;
  k : I64 ;
BEGIN
  r := PFactor (pool, p) ;
  k := 0 ;
  WHILE IsMulOp (p.cur.kind) DO
    Deeper (p, 1) ;
    k := k + 1 ;
    n := Nn (pool, p, Ast.NBin) ;
    Ast.SetA (pool, n, OpText (p.cur.kind)) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (r)) ;
    Ast.Add (pool, n, SOME (PFactor (pool, p))) ;
    r := n
  END ;
  p.depth := p.depth - k ;
  RETURN r
END PTerm ;

PROCEDURE PSimple (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, r, sgn : PTR Ast.Node ;
  k : I64 ;
BEGIN
  IF p.cur.kind = TkPlus OR p.cur.kind = TkMinus THEN
    sgn := Nn (pool, p, Ast.NUn) ;
    Ast.SetA (pool, sgn, OpText (p.cur.kind)) ;
    Bump (p) ;
    r := PTerm (pool, p) ;
    Ast.Add (pool, sgn, SOME (r)) ;
    r := sgn
  ELSE
    r := PTerm (pool, p)
  END ;
  k := 0 ;
  WHILE IsAddOp (p.cur.kind) DO
    Deeper (p, 1) ;
    k := k + 1 ;
    n := Nn (pool, p, Ast.NBin) ;
    Ast.SetA (pool, n, OpText (p.cur.kind)) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (r)) ;
    Ast.Add (pool, n, SOME (PTerm (pool, p))) ;
    r := n
  END ;
  p.depth := p.depth - k ;
  RETURN r
END PSimple ;

PROCEDURE PRel (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, r : PTR Ast.Node ;
BEGIN
  r := PSimple (pool, p) ;
  IF IsRelOp (p.cur.kind) THEN
    n := Nn (pool, p, Ast.NBin) ;
    Ast.SetA (pool, n, OpText (p.cur.kind)) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (r)) ;
    Ast.Add (pool, n, SOME (PSimple (pool, p))) ;
    r := n
  END ;
  RETURN r
END PRel ;

PROCEDURE PConj (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, r : PTR Ast.Node ;
  k : I64 ;
BEGIN
  r := PRel (pool, p) ;
  k := 0 ;
  WHILE p.cur.kind = TkAND DO
    Deeper (p, 1) ;
    k := k + 1 ;
    n := Nn (pool, p, Ast.NBin) ;
    Ast.SetA (pool, n, 'AND') ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (r)) ;
    Ast.Add (pool, n, SOME (PRel (pool, p))) ;
    r := n
  END ;
  p.depth := p.depth - k ;
  RETURN r
END PConj ;

PROCEDURE PDisj (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, r : PTR Ast.Node ;
  k : I64 ;
BEGIN
  r := PConj (pool, p) ;
  k := 0 ;
  WHILE p.cur.kind = TkOR DO
    Deeper (p, 1) ;
    k := k + 1 ;
    n := Nn (pool, p, Ast.NBin) ;
    Ast.SetA (pool, n, 'OR') ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (r)) ;
    Ast.Add (pool, n, SOME (PConj (pool, p))) ;
    r := n
  END ;
  p.depth := p.depth - k ;
  RETURN r
END PDisj ;

PROCEDURE PExpr (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, e, t : PTR Ast.Node ;
BEGIN
  e := PDisj (pool, p) ;
  IF p.cur.kind = TkIS THEN
    n := Nn (pool, p, Ast.NIs) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (e)) ;
    IF p.cur.kind = TkSOME THEN
      t := Nn (pool, p, Ast.NIsSome) ;
      Bump (p) ;
      IF p.cur.kind = TkIdent THEN
        Ast.SetA (pool, t, TakeIdent (p, 'binding name'))
      END ;
      Ast.Add (pool, n, SOME (t))
    ELSIF p.cur.kind = TkNONE THEN
      t := Nn (pool, p, Ast.NIsSome) ;
      t.f1 := TRUE ;
      Bump (p) ;
      Ast.Add (pool, n, SOME (t))
    ELSE
      Ast.Add (pool, n, SOME (PQualident (pool, p)))
    END ;
    RETURN n
  END ;
  RETURN e
END PExpr ;

PROCEDURE PDesignator (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NDesignator) ;
  Ast.SetA (pool, n, TakeIdent (p, 'name')) ;
  PSels (pool, p, n) ;
  RETURN n
END PDesignator ;

PROCEDURE PSels (VAR pool: POOL ; VAR KEPT p: Parser ; VAR n: PTR Ast.Node) =
VAR
  sel : PTR Ast.Node ;
BEGIN
  WHILE p.cur.kind = TkDot OR p.cur.kind = TkLBrack DO
    IF p.cur.kind = TkDot THEN
      Bump (p) ;
      sel := Nn (pool, p, Ast.NSelField) ;
      Ast.SetA (pool, sel, TakeIdent (p, 'field name')) ;
      Ast.Add (pool, n, SOME (sel))
    ELSE
      Bump (p) ;
      sel := Nn (pool, p, Ast.NSelIndex) ;
      Ast.Add (pool, sel, SOME (PExpr (pool, p))) ;
      WHILE p.cur.kind = TkComma DO
        Bump (p) ;
        Ast.Add (pool, sel, SOME (PExpr (pool, p)))
      END ;
      Expect (p, TkRBrack) ;
      Ast.Add (pool, n, SOME (sel))
    END
  END
END PSels ;

PROCEDURE PAttribOpt (VAR pool: POOL ; VAR p: Parser) : Ast.Kid =
VAR
  n : PTR Ast.Node ;
BEGIN
  IF p.cur.kind = TkLBrack THEN
    n := Nn (pool, p, Ast.NAttrib) ;
    Bump (p) ;
    Ast.SetA (pool, n, TakeIdent (p, 'attribute name')) ;
    IF p.cur.kind = TkStr THEN
      Ast.SetB (pool, n, p.cur.text) ;
      Bump (p)
    END ;
    Expect (p, TkRBrack) ;
    RETURN SOME (n)
  END ;
  RETURN NONE
END PAttribOpt ;

PROCEDURE PFieldSeq (VAR pool: POOL ; VAR KEPT p: Parser ; sid: I64) : PTR Ast.Node =
VAR
  n, g : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NFieldSeq) ;
  IF InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF THEN
    RETURN n
  END ;
  LOOP
    g := Nn (pool, p, Ast.NFieldGroup) ;
    IF p.cur.kind = TkRO THEN
      g.f3 := TRUE ;
      Bump (p)
    END ;
    Ast.Add (pool, g, SOME (PIdentList (pool, p))) ;
    Expect (p, TkColon) ;
    Ast.Add (pool, g, SOME (PType (pool, p))) ;
    Ast.Add (pool, n, SOME (g)) ;
    IF p.cur.kind = TkSemi THEN
      Bump (p) ;
      IF InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF THEN
        n.f1 := TRUE ;
        EXIT
      END
    ELSE
      EXIT
    END
  END ;
  IF NOT (InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF) THEN
    Rerr (p, 'field list does not end where it should')
  END ;
  RETURN n
END PFieldSeq ;

PROCEDURE PVariant (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NVariant) ;
  Expect (p, TkBar) ;
  Ast.SetA (pool, n, TakeIdent (p, 'variant name')) ;
  IF p.cur.kind = TkColon THEN
    Bump (p) ;
    Ast.Add (pool, n, SOME (PFieldSeq (pool, p, SVariantF)))
  ELSE
    Ast.Add (pool, n, NONE)
  END ;
  RETURN n
END PVariant ;

PROCEDURE PType0 (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, n2 : PTR Ast.Node ;
BEGIN
  IF p.cur.kind = TkIdent THEN
    RETURN PQualident (pool, p)
  ELSIF p.cur.kind = TkPOOL THEN
    n := Nn (pool, p, Ast.NQualident) ;
    Ast.SetA (pool, n, 'POOL') ;
    Bump (p) ;
    RETURN n
  ELSIF p.cur.kind = TkARRAY THEN
    n := Nn (pool, p, Ast.NArrayType) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkOF) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    RETURN n
  ELSIF p.cur.kind = TkGRID THEN
    n := Nn (pool, p, Ast.NGridType) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkOF) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    RETURN n
  ELSIF p.cur.kind = TkSLICE THEN
    n := Nn (pool, p, Ast.NSliceType) ;
    Bump (p) ;
    Expect (p, TkOF) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    Ast.Add (pool, n, NONE) ;
    RETURN n
  ELSIF p.cur.kind = TkRECORD THEN
    n := Nn (pool, p, Ast.NRecordType) ;
    Bump (p) ;
    IF p.cur.kind = TkLParen THEN
      Bump (p) ;
      Ast.Add (pool, n, SOME (PQualident (pool, p))) ;
      Expect (p, TkRParen)
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    Ast.Add (pool, n, SOME (PFieldSeq (pool, p, SEnd))) ;
    Expect (p, TkEND) ;
    Ast.Add (pool, n, PAttribOpt (pool, p)) ;
    RETURN n
  ELSIF p.cur.kind = TkCASE THEN
    n := Nn (pool, p, Ast.NCaseRecordType) ;
    Bump (p) ;
    Expect (p, TkRECORD) ;
    IF p.cur.kind # TkBar THEN
      Rerr (p, 'variant | expected')
    END ;
    WHILE p.cur.kind = TkBar DO
      Ast.Add (pool, n, SOME (PVariant (pool, p)))
    END ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkMONITOR THEN
    n := Nn (pool, p, Ast.NMonitorType) ;
    Bump (p) ;
    Expect (p, TkRECORD) ;
    Ast.Add (pool, n, SOME (PFieldSeq (pool, p, SEnd))) ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkPTR THEN
    n := Nn (pool, p, Ast.NPtrType) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    IF p.cur.kind = TkIN THEN
      Bump (p) ;
      Ast.Add (pool, n, SOME (PDesignator (pool, p)))
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    RETURN n
  ELSIF p.cur.kind = TkOPT THEN
    n := Nn (pool, p, Ast.NOptType) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    RETURN n
  ELSIF p.cur.kind = TkSHARED THEN
    n := Nn (pool, p, Ast.NSharedType) ;
    Bump (p) ;
    Expect (p, TkPTR) ;
    Ast.Add (pool, n, SOME (PType (pool, p))) ;
    RETURN n
  ELSIF p.cur.kind = TkLParen THEN
    n := Nn (pool, p, Ast.NEnumType) ;
    Bump (p) ;
    n2 := Nn (pool, p, Ast.NIdent) ;
    Ast.SetA (pool, n2, TakeIdent (p, 'enumeration member')) ;
    Ast.Add (pool, n, SOME (n2)) ;
    WHILE p.cur.kind = TkComma DO
      Bump (p) ;
      n2 := Nn (pool, p, Ast.NIdent) ;
      Ast.SetA (pool, n2, TakeIdent (p, 'enumeration member')) ;
      Ast.Add (pool, n, SOME (n2))
    END ;
    Expect (p, TkRParen) ;
    RETURN n
  ELSIF p.cur.kind = TkPROCEDURE THEN
    n := Nn (pool, p, Ast.NProcType) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PParamList (pool, p))) ;
    Expect (p, TkRParen) ;
    IF p.cur.kind = TkColon THEN
      Bump (p) ;
      IF p.cur.kind = TkRO THEN
        n.f3 := TRUE ;
        Bump (p)
      END ;
      Ast.Add (pool, n, SOME (PType (pool, p)))
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    IF p.cur.kind = TkRAISES THEN
      Ast.Add (pool, n, SOME (PRaises (pool, p)))
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    RETURN n
  END ;
  Rerr (p, 'type expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
  n := Nn (pool, p, Ast.NQualident) ;
  Ast.SetA (pool, n, '?') ;
  Bump (p) ;
  RETURN n
END PType0 ;

PROCEDURE PType (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  Deeper (p, 1) ;
  p.tdepth := p.tdepth + 1 ;
  IF p.tdepth > MaxTypeDepth AND NOT p.deep THEN
    Rerr (p, 'a type nested deeper than 100 levels: give a part a TYPE name of its own') ;
    p.deep := TRUE ;
    p.cur.kind := TkEOF
  END ;
  n := PType0 (pool, p) ;
  p.tdepth := p.tdepth - 1 ;
  p.depth := p.depth - 1 ;
  RETURN n
END PType ;

PROCEDURE QualPattern (VAR pool: POOL ; VAR KEPT p: Parser ; e: PTR Ast.Node) : Ast.Kid =
VAR
  n, ids, id : PTR Ast.Node ;
  i : I64 ;
  pre : UTF ;
BEGIN
  IF e.kind # Ast.NCallExpr OR e.nkids < 2 THEN
    RETURN NONE
  END ;
  IF e.kids[0] IS SOME d THEN
    IF d.kind # Ast.NDesignator OR d.nkids = 0 THEN
      RETURN NONE
    END ;
    FOR i := 0 TO d.nkids - 1 DO
      IF d.kids[i] IS SOME sf THEN
        IF sf.kind # Ast.NSelField THEN
          RETURN NONE
        END
      ELSE
        RETURN NONE
      END
    END ;
    IF e.kids[1] IS SOME al THEN
      IF al.nkids = 0 THEN
        RETURN NONE
      END ;
      FOR i := 0 TO al.nkids - 1 DO
        IF al.kids[i] IS SOME a THEN
          IF a.kind # Ast.NDesignator OR a.nkids # 0 THEN
            RETURN NONE
          END
        ELSE
          RETURN NONE
        END
      END ;
      n := Nn (pool, p, Ast.NLabelPattern) ;
      n.line := e.line ;
      n.col := e.col ;
      IF d.kids[d.nkids - 1] IS SOME last THEN
        Ast.SetA (pool, n, last.au)
      END ;
      pre := d.au ;
      FOR i := 0 TO d.nkids - 2 DO
        IF d.kids[i] IS SOME q THEN
          pre := pre + '.' + q.au
        END
      END ;
      Ast.SetB (pool, n, pre) ;
      ids := Nn (pool, p, Ast.NIdentList) ;
      ids.line := al.line ;
      ids.col := al.col ;
      FOR i := 0 TO al.nkids - 1 DO
        IF al.kids[i] IS SOME a2 THEN
          id := Nn (pool, p, Ast.NIdent) ;
          id.line := a2.line ;
          id.col := a2.col ;
          Ast.SetA (pool, id, a2.au) ;
          Ast.Add (pool, ids, SOME (id))
        END
      END ;
      Ast.Add (pool, n, SOME (ids)) ;
      RETURN SOME (n)
    END
  END ;
  RETURN NONE
END QualPattern ;

PROCEDURE PCaseLabel (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, e : PTR Ast.Node ;
BEGIN
  IF p.cur.kind = TkIdent THEN
    IF NxtKind (p) = TkLParen THEN
      n := Nn (pool, p, Ast.NLabelPattern) ;
      Ast.SetA (pool, n, TakeIdent (p, 'variant name')) ;
      Expect (p, TkLParen) ;
      Ast.Add (pool, n, SOME (PIdentList (pool, p))) ;
      Expect (p, TkRParen) ;
      RETURN n
    END
  END ;
  n := Nn (pool, p, Ast.NLabelRange) ;
  e := PExpr (pool, p) ;
  IF p.cur.kind # TkDotDot THEN
    IF QualPattern (pool, p, e) IS SOME qp THEN
      RETURN qp
    END
  END ;
  Ast.Add (pool, n, SOME (e)) ;
  IF p.cur.kind = TkDotDot THEN
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p)))
  ELSE
    Ast.Add (pool, n, NONE)
  END ;
  RETURN n
END PCaseLabel ;

PROCEDURE PCaseArm (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, lbls : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NCaseArm) ;
  Expect (p, TkBar) ;
  lbls := Nn (pool, p, Ast.NLabelList) ;
  Ast.Add (pool, lbls, SOME (PCaseLabel (pool, p))) ;
  WHILE p.cur.kind = TkComma DO
    Bump (p) ;
    Ast.Add (pool, lbls, SOME (PCaseLabel (pool, p)))
  END ;
  Ast.Add (pool, n, SOME (lbls)) ;
  Expect (p, TkColon) ;
  Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SArm))) ;
  RETURN n
END PCaseArm ;

PROCEDURE IsStmtEndK (k: I64) : BOOL =
BEGIN
  RETURN k = TkSemi OR k = TkEND OR k = TkELSE OR k = TkELSIF OR k = TkEXCEPT OR k = TkFINALLY OR k = TkBar OR k = TkEOF
END IsStmtEndK ;

PROCEDURE PStatement0 (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, d, e : PTR Ast.Node ;
  claim : Ast.Kid ;
BEGIN
  IF p.cur.kind = TkIdent THEN
    d := PDesignator (pool, p) ;
    IF p.cur.kind = TkAssign THEN
      n := Nn (pool, p, Ast.NAssign) ;
      Bump (p) ;
      Ast.Add (pool, n, SOME (d)) ;
      Ast.Add (pool, n, SOME (PExpr (pool, p)))
    ELSE
      n := Nn (pool, p, Ast.NCallStmt) ;
      Ast.Add (pool, n, SOME (d)) ;
      IF p.cur.kind = TkLParen THEN
        n.f1 := TRUE ;
        Bump (p) ;
        IF p.cur.kind = TkRParen THEN
          Ast.Add (pool, n, SOME (Nn (pool, p, Ast.NArgList)))
        ELSE
          Ast.Add (pool, n, SOME (PArgList (pool, p)))
        END ;
        Expect (p, TkRParen)
      ELSE
        Ast.Add (pool, n, NONE)
      END
    END ;
    RETURN n
  ELSIF p.cur.kind = TkIF THEN
    n := Nn (pool, p, Ast.NIf) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkTHEN) ;
    Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SIf))) ;
    WHILE p.cur.kind = TkELSIF DO
      e := Nn (pool, p, Ast.NElsif) ;
      Bump (p) ;
      Ast.Add (pool, e, SOME (PExpr (pool, p))) ;
      Expect (p, TkTHEN) ;
      Ast.Add (pool, e, SOME (PStmtSeq (pool, p, SIf))) ;
      Ast.Add (pool, n, SOME (e))
    END ;
    IF p.cur.kind = TkELSE THEN
      e := Nn (pool, p, Ast.NElse) ;
      Bump (p) ;
      Ast.Add (pool, e, SOME (PStmtSeq (pool, p, SEnd))) ;
      Ast.Add (pool, n, SOME (e))
    END ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkWHILE THEN
    n := Nn (pool, p, Ast.NWhile) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkDO) ;
    Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SEnd))) ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkFOR THEN
    n := Nn (pool, p, Ast.NFor) ;
    Bump (p) ;
    claim := NONE ;
    IF p.cur.kind = TkLBrack THEN
      Bump (p) ;
      IF NOT Text.Eq (TakeIdent (p, 'INRANGE'), 'INRANGE') THEN
        Rerr (p, 'a FOR takes one attribute: [INRANGE b]')
      END ;
      claim := SOME (PExpr (pool, p)) ;
      Expect (p, TkRBrack)
    END ;
    Ast.SetA (pool, n, TakeIdent (p, 'loop variable')) ;
    IF p.cur.kind = TkIN THEN
      IF claim IS SOME cl THEN
        Rerr (p, 'INRANGE stands on FOR v := lo TO hi, whose range is fixed before it starts, not on FOR IN')
      END ;
      n.kind := Ast.NForIn ;
      Bump (p) ;
      Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
      Expect (p, TkDO) ;
      Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SEnd))) ;
      Expect (p, TkEND) ;
      RETURN n
    END ;
    Expect (p, TkAssign) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkTO) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    IF p.cur.kind = TkBY THEN
      Bump (p) ;
      Ast.Add (pool, n, SOME (PExpr (pool, p)))
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    Expect (p, TkDO) ;
    Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SEnd))) ;
    Expect (p, TkEND) ;
    IF claim IS SOME cl2 THEN
      Ast.Add (pool, n, claim)
    END ;
    RETURN n
  ELSIF p.cur.kind = TkLOOP THEN
    n := Nn (pool, p, Ast.NLoop) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SEnd))) ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkEXIT THEN
    n := Nn (pool, p, Ast.NExit) ;
    Bump (p) ;
    RETURN n
  ELSIF p.cur.kind = TkCASE THEN
    n := Nn (pool, p, Ast.NCase) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkOF) ;
    IF p.cur.kind # TkBar THEN
      Rerr (p, 'case arm | expected')
    END ;
    WHILE p.cur.kind = TkBar DO
      Ast.Add (pool, n, SOME (PCaseArm (pool, p)))
    END ;
    IF p.cur.kind = TkELSE THEN
      e := Nn (pool, p, Ast.NElse) ;
      Bump (p) ;
      Ast.Add (pool, e, SOME (PStmtSeq (pool, p, SEnd))) ;
      Ast.Add (pool, n, SOME (e))
    END ;
    Expect (p, TkEND) ;
    RETURN n
  ELSIF p.cur.kind = TkRETURN THEN
    n := Nn (pool, p, Ast.NReturn) ;
    Bump (p) ;
    IF IsStmtEndK (p.cur.kind) THEN
      Ast.Add (pool, n, NONE)
    ELSE
      Ast.Add (pool, n, SOME (PExpr (pool, p)))
    END ;
    RETURN n
  ELSIF p.cur.kind = TkRAISE THEN
    n := Nn (pool, p, Ast.NRaiseStmt) ;
    Bump (p) ;
    Ast.Add (pool, n, SOME (PQualident (pool, p))) ;
    IF p.cur.kind = TkLParen THEN
      Bump (p) ;
      Ast.Add (pool, n, SOME (PArgList (pool, p))) ;
      Expect (p, TkRParen)
    ELSE
      Ast.Add (pool, n, NONE)
    END ;
    RETURN n
  ELSIF p.cur.kind = TkDISPOSE THEN
    n := Nn (pool, p, Ast.NDispose) ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PDesignator (pool, p))) ;
    Expect (p, TkRParen) ;
    RETURN n
  ELSIF p.cur.kind = TkBEGIN THEN
    RETURN PBlock (pool, p)
  ELSIF p.cur.kind = TkTHREAD OR p.cur.kind = TkTASK OR p.cur.kind = TkTRANSFER THEN
    IF p.cur.kind = TkTHREAD THEN
      n := Nn (pool, p, Ast.NThread)
    ELSIF p.cur.kind = TkTASK THEN
      n := Nn (pool, p, Ast.NThread) ;
      Ast.SetA (pool, n, 'TASK')
    ELSE
      n := Nn (pool, p, Ast.NTransfer)
    END ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkComma) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen) ;
    RETURN n
  ELSIF p.cur.kind = TkWAIT OR p.cur.kind = TkSIGNAL THEN
    IF p.cur.kind = TkWAIT THEN
      n := Nn (pool, p, Ast.NWait)
    ELSE
      n := Nn (pool, p, Ast.NSignal)
    END ;
    Bump (p) ;
    Expect (p, TkLParen) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
    Expect (p, TkRParen) ;
    RETURN n
  END ;
  Rerr (p, 'statement expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
  n := Nn (pool, p, Ast.NStmtSeq) ;
  Bump (p) ;
  RETURN n
END PStatement0 ;

PROCEDURE PStatement (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  Deeper (p, 1) ;
  n := PStatement0 (pool, p) ;
  p.depth := p.depth - 1 ;
  RETURN n
END PStatement ;

PROCEDURE PStmtSeq (VAR pool: POOL ; VAR KEPT p: Parser ; sid: I64) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NStmtSeq) ;
  WHILE NOT (InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF) DO
    Ast.Add (pool, n, SOME (PStatement (pool, p))) ;
    IF p.cur.kind = TkSemi THEN
      Bump (p) ;
      IF InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF THEN
        n.f1 := TRUE ;
        RETURN n
      END
    ELSE
      IF NOT (InStops (sid, p.cur.kind) OR p.cur.kind = TkEOF) THEN
        Rerr (p, '; or end of statement list expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
        WHILE NOT (InStops (sid, p.cur.kind) OR p.cur.kind = TkSemi OR p.cur.kind = TkEOF) DO
          Bump (p)
        END ;
        IF p.cur.kind = TkSemi THEN
          Bump (p)
        ELSE
          RETURN n
        END
      ELSE
        RETURN n
      END
    END
  END ;
  RETURN n
END PStmtSeq ;

PROCEDURE PHandler (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, args, h : PTR Ast.Node ;
  had : BOOL ;
  more : SLICE OF Ast.Kid ;
  nmore, i : I64 ;
BEGIN
  n := Nn (pool, p, Ast.NHandler) ;
  Expect (p, TkBar) ;
  Ast.Add (pool, n, SOME (PQualident (pool, p))) ;
  nmore := 0 ;
  more := NEW (pool, Ast.Kid, 8) ;
  WHILE p.cur.kind = TkComma AND nmore < 8 DO
    Bump (p) ;
    more[nmore] := SOME (PQualident (pool, p)) ;
    nmore := nmore + 1
  END ;
  IF p.cur.kind = TkComma THEN
    Rerr (p, 'at most 9 exceptions in one handler arm')
  END ;
  had := FALSE ;
  IF p.cur.kind = TkLParen THEN
    had := TRUE ;
    Bump (p) ;
    args := Nn (pool, p, Ast.NArgList) ;
    LOOP
      IF p.cur.kind = TkIdent THEN
        h := Nn (pool, p, Ast.NIdent) ;
        Ast.SetA (pool, h, p.cur.text) ;
        Bump (p)
      ELSIF p.cur.kind = TkInt THEN
        h := Nn (pool, p, Ast.NInt) ;
        Ast.SetA (pool, h, p.cur.text) ;
        Bump (p)
      ELSIF p.cur.kind = TkReal THEN
        h := Nn (pool, p, Ast.NReal) ;
        Ast.SetA (pool, h, p.cur.text) ;
        Bump (p)
      ELSIF p.cur.kind = TkChar THEN
        h := Nn (pool, p, Ast.NChar) ;
        Ast.SetA (pool, h, p.cur.text) ;
        Bump (p)
      ELSIF p.cur.kind = TkStr THEN
        h := Nn (pool, p, Ast.NString) ;
        Ast.SetA (pool, h, p.cur.text) ;
        Bump (p)
      ELSE
        Rerr (p, 'case label expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
        h := Nn (pool, p, Ast.NIdent) ;
        Ast.SetA (pool, h, '?') ;
        Bump (p)
      END ;
      Ast.Add (pool, args, SOME (h)) ;
      IF p.cur.kind = TkComma THEN
        Bump (p)
      ELSE
        EXIT
      END
    END ;
    Expect (p, TkRParen) ;
    Ast.Add (pool, n, SOME (args))
  END ;
  IF NOT had THEN
    Ast.Add (pool, n, NONE)
  END ;
  Expect (p, TkColon) ;
  Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SHandler))) ;
  FOR i := 0 TO nmore - 1 DO
    Ast.Add (pool, n, more[i])
  END ;
  RETURN n
END PHandler ;

PROCEDURE PBlock (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, fin : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NBlock) ;
  Expect (p, TkBEGIN) ;
  Ast.Add (pool, n, SOME (PStmtSeq (pool, p, SBlock))) ;
  IF p.cur.kind = TkEXCEPT THEN
    Bump (p) ;
    IF p.cur.kind # TkBar THEN
      Rerr (p, 'handler | expected after EXCEPT')
    END ;
    WHILE p.cur.kind = TkBar DO
      Ast.Add (pool, n, SOME (PHandler (pool, p)))
    END
  END ;
  IF p.cur.kind = TkFINALLY THEN
    Bump (p) ;
    fin := Nn (pool, p, Ast.NFinally) ;
    Ast.Add (pool, fin, SOME (PStmtSeq (pool, p, SEnd))) ;
    Ast.Add (pool, n, SOME (fin))
  END ;
  Expect (p, TkEND) ;
  RETURN n
END PBlock ;

PROCEDURE PParamList (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, pr : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NParamList) ;
  IF p.cur.kind = TkRParen THEN
    RETURN n
  END ;
  LOOP
    pr := Nn (pool, p, Ast.NParam) ;
    IF p.cur.kind = TkVAR THEN
      pr.f1 := TRUE ;
      Bump (p)
    ELSIF p.cur.kind = TkOWN THEN
      pr.f2 := TRUE ;
      Bump (p)
    ELSIF p.cur.kind = TkRO THEN
      pr.f3 := TRUE ;
      Bump (p)
    END ;
    IF p.cur.kind = TkKEPT THEN
      pr.f4 := TRUE ;
      Bump (p)
    END ;
    Ast.Add (pool, pr, SOME (PIdentList (pool, p))) ;
    Expect (p, TkColon) ;
    Ast.Add (pool, pr, SOME (PType (pool, p))) ;
    Ast.Add (pool, n, SOME (pr)) ;
    IF p.cur.kind = TkSemi THEN
      Bump (p)
    ELSE
      EXIT
    END ;
    IF p.cur.kind = TkRParen OR p.cur.kind = TkEOF THEN
      EXIT
    END
  END ;
  RETURN n
END PParamList ;

PROCEDURE PRaises (VAR pool: POOL ; VAR p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NRaises) ;
  Expect (p, TkRAISES) ;
  Ast.Add (pool, n, SOME (PQualident (pool, p))) ;
  WHILE p.cur.kind = TkComma DO
    Bump (p) ;
    Ast.Add (pool, n, SOME (PQualident (pool, p)))
  END ;
  RETURN n
END PRaises ;

PROCEDURE PProcBody (VAR pool: POOL ; VAR KEPT p: Parser ; RO name: UTF) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NProcBody) ;
  WHILE IsDeclStart (p.cur.kind) DO
    Ast.Add (pool, n, SOME (PDeclaration (pool, p)))
  END ;
  Ast.Add (pool, n, SOME (PBlock (pool, p))) ;
  IF p.cur.kind = TkIdent THEN
    IF NOT Text.Eq (p.cur.text, name) THEN
      Rerr (p, 'END ' + p.cur.text + ' does not match PROCEDURE ' + name)
    END ;
    Bump (p)
  ELSE
    Rerr (p, 'procedure name expected after END')
  END ;
  RETURN n
END PProcBody ;

PROCEDURE PProcDecl (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NProcDecl) ;
  Expect (p, TkPROCEDURE) ;
  Ast.SetA (pool, n, TakeIdent (p, 'procedure name')) ;
  IF p.cur.kind = TkEq THEN
    Bump (p) ;
    IF p.cur.kind = TkStr THEN
      Ast.SetB (pool, n, p.cur.text) ;
      Bump (p)
    ELSE
      Rerr (p, 'handler argument expected')
    END
  END ;
  Expect (p, TkLParen) ;
  Ast.Add (pool, n, SOME (PParamList (pool, p))) ;
  Expect (p, TkRParen) ;
  IF p.cur.kind = TkColon THEN
    Bump (p) ;
    IF p.cur.kind = TkRO THEN
      n.f3 := TRUE ;
      Bump (p)
    END ;
    Ast.Add (pool, n, SOME (PType (pool, p)))
  ELSE
    Ast.Add (pool, n, NONE)
  END ;
  IF p.cur.kind = TkRAISES THEN
    Ast.Add (pool, n, SOME (PRaises (pool, p)))
  ELSE
    Ast.Add (pool, n, NONE)
  END ;
  Ast.Add (pool, n, PAttribOpt (pool, p)) ;
  IF p.cur.kind = TkEq THEN
    Bump (p) ;
    Ast.Add (pool, n, SOME (PProcBody (pool, p, n.au)))
  ELSE
    Ast.Add (pool, n, NONE)
  END ;
  Expect (p, TkSemi) ;
  RETURN n
END PProcDecl ;

PROCEDURE PAggregate (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n : PTR Ast.Node ;
BEGIN
  n := Nn (pool, p, Ast.NAggregate) ;
  Bump (p) ;
  Ast.Add (pool, n, SOME (PExpr (pool, p))) ;
  WHILE p.cur.kind = TkComma DO
    Bump (p) ;
    Ast.Add (pool, n, SOME (PExpr (pool, p)))
  END ;
  Expect (p, TkRBrack) ;
  RETURN n
END PAggregate ;

PROCEDURE PDeclaration (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, d : PTR Ast.Node ;
  at : Ast.Kid ;
BEGIN
  IF p.cur.kind = TkCONST THEN
    n := Nn (pool, p, Ast.NConstSection) ;
    Bump (p) ;
    WHILE p.cur.kind = TkIdent DO
      d := Nn (pool, p, Ast.NConstDecl) ;
      Ast.SetA (pool, d, TakeIdent (p, 'constant name')) ;
      at := PAttribOpt (pool, p) ;
      Expect (p, TkEq) ;
      IF p.cur.kind = TkLBrack THEN
        Ast.Add (pool, d, SOME (PAggregate (pool, p)))
      ELSE
        Ast.Add (pool, d, SOME (PExpr (pool, p)))
      END ;
      IF at IS SOME THEN
        Ast.Add (pool, d, at)
      END ;
      Expect (p, TkSemi) ;
      Ast.Add (pool, n, SOME (d))
    END ;
    RETURN n
  ELSIF p.cur.kind = TkTYPE THEN
    n := Nn (pool, p, Ast.NTypeSection) ;
    Bump (p) ;
    WHILE p.cur.kind = TkIdent DO
      d := Nn (pool, p, Ast.NTypeDecl) ;
      Ast.SetA (pool, d, TakeIdent (p, 'type name')) ;
      IF p.cur.kind = TkEq THEN
        Bump (p) ;
        Ast.Add (pool, d, SOME (PType (pool, p)))
      ELSE
        Ast.Add (pool, d, NONE)
      END ;
      Expect (p, TkSemi) ;
      Ast.Add (pool, n, SOME (d))
    END ;
    RETURN n
  ELSIF p.cur.kind = TkVAR THEN
    n := Nn (pool, p, Ast.NVarSection) ;
    Bump (p) ;
    WHILE p.cur.kind = TkIdent OR p.cur.kind = TkRO DO
      d := Nn (pool, p, Ast.NVarDecl) ;
      IF p.cur.kind = TkRO THEN
        d.f3 := TRUE ;
        Bump (p)
      END ;
      Ast.Add (pool, d, SOME (PIdentList (pool, p))) ;
      Expect (p, TkColon) ;
      Ast.Add (pool, d, SOME (PType (pool, p))) ;
      Expect (p, TkSemi) ;
      Ast.Add (pool, n, SOME (d))
    END ;
    RETURN n
  ELSIF p.cur.kind = TkEXCEPTION THEN
    n := Nn (pool, p, Ast.NExcSection) ;
    Bump (p) ;
    WHILE p.cur.kind = TkIdent DO
      d := Nn (pool, p, Ast.NExcDecl) ;
      Ast.SetA (pool, d, TakeIdent (p, 'exception name')) ;
      IF p.cur.kind = TkLParen THEN
        Bump (p) ;
        Ast.Add (pool, d, SOME (PFieldSeq (pool, p, SRParen))) ;
        Expect (p, TkRParen)
      ELSE
        Ast.Add (pool, d, NONE)
      END ;
      Expect (p, TkSemi) ;
      Ast.Add (pool, n, SOME (d))
    END ;
    RETURN n
  ELSIF p.cur.kind = TkPROCEDURE THEN
    RETURN PProcDecl (pool, p)
  END ;
  Rerr (p, 'declaration expected') ;
  n := Nn (pool, p, Ast.NConstSection) ;
  Bump (p) ;
  RETURN n
END PDeclaration ;

PROCEDURE PImports (VAR pool: POOL ; VAR KEPT p: Parser ; VAR parent: PTR Ast.Node) =
VAR
  n : PTR Ast.Node ;
BEGIN
  WHILE p.cur.kind = TkFROM OR p.cur.kind = TkIMPORT DO
    IF p.cur.kind = TkFROM THEN
      n := Nn (pool, p, Ast.NFromImport) ;
      Bump (p) ;
      Ast.SetA (pool, n, TakeIdent (p, 'module name')) ;
      Expect (p, TkIMPORT)
    ELSE
      n := Nn (pool, p, Ast.NImportList) ;
      Bump (p)
    END ;
    Ast.Add (pool, n, SOME (PIdentList (pool, p))) ;
    Expect (p, TkSemi) ;
    Ast.Add (pool, parent, SOME (n))
  END
END PImports ;

PROCEDURE PDecls (VAR pool: POOL ; VAR KEPT p: Parser ; VAR parent: PTR Ast.Node) =
BEGIN
  WHILE IsDeclStart (p.cur.kind) DO
    Ast.Add (pool, parent, SOME (PDeclaration (pool, p)))
  END
END PDecls ;

PROCEDURE PUnit (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, body, links, ws : PTR Ast.Node ;
  uns, stf, hasLinks : BOOL ;
BEGIN
  uns := FALSE ;
  stf := FALSE ;
  hasLinks := FALSE ;
  IF p.cur.kind = TkUNSAFE THEN
    uns := TRUE ;
    Bump (p)
  END ;
  IF p.cur.kind = TkSTATEFUL THEN
    stf := TRUE ;
    Bump (p)
  END ;
  IF p.cur.kind = TkDEFINITION THEN
    n := Nn (pool, p, Ast.NDefinition) ;
    n.f1 := uns ;
    n.f2 := stf ;
    Bump (p) ;
    Expect (p, TkMODULE) ;
    IF p.cur.kind = TkFOR THEN
      Bump (p) ;
      IF p.cur.kind = TkStr THEN
        Ast.SetB (pool, n, p.cur.text) ;
        Bump (p)
      ELSE
        Rerr (p, 'foreign language string expected after FOR')
      END
    END ;
    Ast.SetA (pool, n, TakeIdent (p, 'module name')) ;
    links := Nn (pool, p, Ast.NLinkList) ;
    IF p.cur.kind = TkLINK THEN
      IF Text.BLen (n.bu) = 0 THEN
        Rerr (p, 'LINK belongs to a FOR "C" unit')
      END ;
      Bump (p) ;
      links := Nn (pool, p, Ast.NLinkList) ;
      hasLinks := TRUE ;
      LOOP
        IF p.cur.kind = TkStr THEN
          ws := Nn (pool, p, Ast.NString) ;
          Ast.SetA (pool, ws, p.cur.text) ;
          Ast.Add (pool, links, SOME (ws)) ;
          Bump (p)
        ELSE
          Rerr (p, 'a string expected after LINK')
        END ;
        IF p.cur.kind = TkComma THEN
          Bump (p)
        ELSE
          EXIT
        END
      END
    END ;
    Expect (p, TkSemi) ;
    PImports (pool, p, n) ;
    PDecls (pool, p, n) ;
    IF hasLinks THEN
      Ast.Add (pool, n, SOME (links))
    END ;
    Expect (p, TkEND) ;
    IF NOT Text.Eq (TakeIdent (p, 'module name after END'), n.au) THEN
      Rerr (p, 'END name does not match MODULE ' + n.au)
    END ;
    Expect (p, TkDot) ;
    RETURN n
  END ;
  IF p.cur.kind = TkIMPLEMENTATION THEN
    n := Nn (pool, p, Ast.NImplementation) ;
    n.f1 := uns ;
    IF stf THEN
      Rerr (p, 'STATEFUL belongs on the definition')
    END ;
    Bump (p) ;
    Expect (p, TkMODULE) ;
    Ast.SetA (pool, n, TakeIdent (p, 'module name')) ;
    Expect (p, TkSemi) ;
    PImports (pool, p, n) ;
    PDecls (pool, p, n) ;
    IF p.cur.kind = TkBEGIN THEN
      body := Nn (pool, p, Ast.NModBody) ;
      Ast.Add (pool, body, SOME (PBlock (pool, p))) ;
      Ast.Add (pool, n, SOME (body))
    ELSE
      Expect (p, TkEND)
    END ;
    IF NOT Text.Eq (TakeIdent (p, 'module name after END'), n.au) THEN
      Rerr (p, 'END name does not match MODULE ' + n.au)
    END ;
    Expect (p, TkDot) ;
    RETURN n
  END ;
  IF p.cur.kind = TkMODULE THEN
    n := Nn (pool, p, Ast.NProgram) ;
    IF uns THEN
      Rerr (p, 'UNSAFE program modules are not a thing')
    END ;
    IF stf THEN
      Rerr (p, 'STATEFUL belongs on definitions')
    END ;
    Bump (p) ;
    Ast.SetA (pool, n, TakeIdent (p, 'module name')) ;
    Expect (p, TkSemi) ;
    PImports (pool, p, n) ;
    PDecls (pool, p, n) ;
    IF p.cur.kind = TkBEGIN THEN
      body := Nn (pool, p, Ast.NModBody) ;
      Ast.Add (pool, body, SOME (PBlock (pool, p))) ;
      Ast.Add (pool, n, SOME (body))
    ELSE
      Expect (p, TkEND)
    END ;
    IF NOT Text.Eq (TakeIdent (p, 'module name after END'), n.au) THEN
      Rerr (p, 'END name does not match MODULE ' + n.au)
    END ;
    Expect (p, TkDot) ;
    RETURN n
  END ;
  Rerr (p, 'DEFINITION, IMPLEMENTATION, or MODULE expected, found ' + UTF (Lex.KindName (p.cur.kind))) ;
  n := Nn (pool, p, Ast.NProgram) ;
  Ast.SetA (pool, n, '?') ;
  Bump (p) ;
  RETURN n
END PUnit ;

PROCEDURE File (VAR pool: POOL ; VAR KEPT p: Parser) : PTR Ast.Node =
VAR
  n, u : PTR Ast.Node ;
  before : I64 ;
BEGIN
  n := Nn (pool, p, Ast.NFile) ;
  WHILE p.cur.kind # TkEOF DO
    before := p.nerr ;
    u := PUnit (pool, p) ;
    Ast.Add (pool, n, SOME (u)) ;
    IF u.kind = Ast.NProgram AND p.cur.kind = TkMODULE THEN
      Rerr (p, 'a second program module: a file may have only one') ;
      RETURN n
    END ;
    IF p.cur.kind # TkEOF THEN
      IF p.nerr > before + 50 THEN
        RETURN n
      END
    END
  END ;
  RETURN n
END File ;

END Parse.
