MODULE Canvas ;

TYPE
  Canvas = RECORD
    w, h : I64 ;
    pix : SLICE OF BYTE
  END ;

VAR
  out : SLICE OF BYTE ;

PROCEDURE Raster (w, h: I64) : SLICE OF BYTE
  RAISES ValueRange =
VAR
  scratch : POOL ;
  c : Canvas ;
  i : I64 ;
BEGIN
  c.w := w ;
  c.h := h ;
  c.pix := NEW (scratch, BYTE, w * h * 3) ;
  FOR i := 0 TO LEN (c.pix) - 1 DO
    c.pix[i] := BYTE (255)
  END ;
  RETURN c.pix
END Raster ;

BEGIN
  out := Raster (4, 3)
END Canvas.
