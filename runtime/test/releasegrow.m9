MODULE ReleaseGrow ;
(* The statement release must not free what the callee grew for the
   caller.  `d` is a frame-form pointer (no IN clause), so the pool
   that rides behind it into Append is this frame's arena; Append's
   Grow doubles the buffer there, inside a statement whose `+` is
   released with the statement -- and before 2026-10-18 the release
   took the doubled buffer with it, and the text came back as NUL
   bytes (cp-kernel's Cs.Canonical, 48,847 of 48,867).  Two shapes:
   a module variable in the module body (the arena is &m9mframe) and
   a local in a procedure (err->res), each appended 25 times with a
   nine-character piece, so the buffer doubles from 16 to 256.  And
   a third, OneFlux's (2026-10-19): the module body calls a PROCEDURE
   with a concatenation, and the procedure appends to a module
   variable without IN -- whose hidden pool is the module frame, the
   arena the body's statement had marked.  And a fourth, OneFlux's
   Va.m9 (2026-10-19): `Add (a, x + y)` where Add does `line := line
   + datum` on a VAR STR -- the new string is adopted into the
   caller's frame arena at Add's exit, above the statement's mark;
   the gate compares it with the same text built through a local.
   The gate reads the four lines. *)
IMPORT DynStr ;
IMPORT Fmt ;
IMPORT Io ;
IMPORT Text ;
VAR
  pool : POOL ;
  d : PTR DynStr.DString ;
  out : PTR DynStr.DString ;

PROCEDURE Line (RO s: STR) =
BEGIN
  DynStr.Append (out, s)
END Line ;

PROCEDURE Add (VAR line: STR ; RO datum: STR) =
BEGIN
  line := line + datum + ','
END Add ;

PROCEDURE Viaarg () : STR RAISES ValueRange =
VAR a, b, t : STR ;
  j : I64 ;
BEGIN
  a := '' ; b := '' ;
  FOR j := 1 TO 3 DO Add (a, 'cov(w_' + Fmt.I64Str (j) + ')') END ;
  FOR j := 1 TO 3 DO t := 'cov(w_' + Fmt.I64Str (j) + ')' ; Add (b, t) END ;
  FOR j := 1 TO 50 DO t := Fmt.I64Str (j * 123456789) + Fmt.I64Str (j) END ;
  IF Text.Eq (a, b) THEN RETURN 'same' END ;
  RETURN 'DIFFERENT: ' + a
END Viaarg ;

PROCEDURE Nuls (RO s: STR) : I64 =
VAR i, n : I64 ;
BEGIN
  n := 0 ;
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = 0C THEN n := n + 1 END
  END ;
  RETURN n
END Nuls ;

PROCEDURE Say (RO tag: STR ; RO s: STR) =
BEGIN
  Io.WriteLine (tag + ' length ' + Fmt.I64Str (LEN (s))
                + ' nul ' + Fmt.I64Str (Nuls (s)))
END Say ;

PROCEDURE InProc (VAR pool: POOL) =
VAR
  d : PTR DynStr.DString ;
  i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  FOR i := 0 TO 24 DO
    DynStr.Append (d, 'prev ' + 'abc' + 0AC)
  END ;
  Say ('local', DynStr.View (d))
END InProc ;

VAR i : I64 ;
BEGIN
  d := DynStr.New (pool) ;
  FOR i := 0 TO 24 DO
    DynStr.Append (d, 'prev ' + 'abc' + 0AC)
  END ;
  Say ('module', DynStr.View (d)) ;
  InProc (pool) ;
  out := DynStr.New (pool) ;
  FOR i := 0 TO 24 DO
    Line ('prev ' + 'abc' + 0AC)
  END ;
  Say ('callee', DynStr.View (out)) ;
  Io.WriteLine ('varstr ' + Viaarg ())
EXCEPT
| ValueRange : Io.WriteLine ('range')
END ReleaseGrow.
