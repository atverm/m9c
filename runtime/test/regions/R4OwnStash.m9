MODULE R4OwnStash ;
(* a view of o stored into q; q moved into an OWN parameter that keeps it in module state; o disposed *)
IMPORT Io, Fmt ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
VAR gq : PTR Store ;
PROCEDURE Stash (OWN p : PTR Store) =
BEGIN
  gq := p
END Stash ;
PROCEDURE Go () =
VAR o, q : PTR Store ;
BEGIN
  o := Mk () ;
  q := Mk () ;
  q.data := o.data ;
  Stash (q) ;
  DISPOSE (o)
END Go ;
BEGIN
  Go () ;
  Churn () ;
  Io.WriteLine (Fmt.I64Str (gq.data[0]))
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END R4OwnStash.
