(* oneflux's 0.25 report, item 28, its C5.m9 (2026-10-25): a record copied out of an activation's own pool into a module variable THROUGH a callee's VAR parameter -- `Carry (pool, st, jobs.job[0].s)' with `dst := src' -- was accepted where `st := jobs.job[0].s' is refused; the string itself kept in the module's pool.  held by regions.sh *)
MODULE O1 ;
IMPORT Io, Fmt, Text ;
TYPE
  Stats = RECORD
    n : I64 ;
    date : STR ;
  END ;
  Job = RECORD
    s : Stats ;
  END ;
  Jobs = RECORD
    job : SLICE OF Job ;
  END ;
VAR
  pool : POOL ;
  st : Stats ;
PROCEDURE Carry (VAR p: POOL ; VAR dst: Stats ; RO src: Stats) =
BEGIN
  dst := src
END Carry ;
PROCEDURE Chunk () RAISES IndexError =
VAR
  cpool : POOL ;
  jobs : PTR Jobs IN cpool ;
BEGIN
  jobs := NEW (cpool, Jobs) ;
  jobs.job := NEW (cpool, Job, 1) ;
  jobs.job[0].s.n := st.n + 1 ;
  jobs.job[0].s.date := Text.Keep (pool, '2023-07-02') ;
  Carry (pool, st, jobs.job[0].s)
END Chunk ;
BEGIN
  Chunk () ;
  Io.WriteLine (Fmt.I64Str (st.n) + ' ' + st.date)
EXCEPT
| IndexError : Io.WriteLine ('index')
END O1.
