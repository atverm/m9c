MODULE R3Cyc3 ;
IMPORT Io, Fmt ;
VAR last : STR ;
PROCEDURE G (n: I64) : STR ;
PROCEDURE F (n: I64) : STR ;
PROCEDURE H (n: I64) : STR ;
PROCEDURE Warm () =
VAR t : STR ;
BEGIN
  t := F (1) ;
  Io.WriteLine (t)
END Warm ;
PROCEDURE Fill () =
BEGIN
  last := G (1)
END Fill ;
PROCEDURE F (n: I64) : STR =
BEGIN
  IF n > 0 THEN RETURN G (n - 1) END ;
  RETURN 'frame string number ' + Fmt.I64Str (n)
END F ;
PROCEDURE G (n: I64) : STR =
BEGIN
  RETURN H (n)
END G ;
PROCEDURE H (n: I64) : STR =
BEGIN
  RETURN F (n)
END H ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
BEGIN
  Warm () ;
  Fill () ;
  Churn () ;
  Io.WriteLine (last)
END R3Cyc3.
