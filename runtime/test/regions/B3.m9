(* the compiler review of 2026-10-21, checker repro B3 (docs/review-2026-10-21/checker): held by regions.sh *)
MODULE B3 ;
IMPORT Io, Fmt ;
TYPE V = CASE RECORD
  | Txt : s : STR
  | Num : n : I64
  END ;
TYPE Node = RECORD s : STR END ;
VAR last : STR ;
VAR lastp : OPT PTR Node ;
PROCEDURE Fill () =
VAR v : V ; o : OPT PTR Node ; p : PTR Node ;
BEGIN
  v := V.Txt ('text ' + Fmt.I64Str (5)) ;
  CASE v OF
  | V.Txt (s) : last := s
  | V.Num (n) : last := 'n'
  END
END Fill ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
BEGIN
  Fill () ;
  Churn () ;
  Io.WriteLine (last)
END B3.
