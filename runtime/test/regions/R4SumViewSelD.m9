MODULE R4SumViewSelD ;
IMPORT Io, Fmt ;
TYPE R = RECORD s : STR ; n : I64 END ;
VAR last : STR ;
PROCEDURE Wrap (VAR r: R) : R =
BEGIN
  RETURN r
END Wrap ;
PROCEDURE Via (VAR r: R) : STR =
BEGIN
  RETURN Wrap (r).s
END Via ;
PROCEDURE Fill () =
VAR r : R ;
BEGIN
  r.s := 'frame string number ' + Fmt.I64Str (3) ;
  last := Wrap (r).s
END Fill ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
BEGIN
  Fill () ;
  Churn () ;
  Io.WriteLine (last)
END R4SumViewSelD.
