MODULE R5OwnProcValParam ;
(* R5OwnProcVal with the procedure value a PARAMETER, called bare:
   `r := fn (h) ; DISPOSE (h) ; Rd (r)' (2026-10-28), accepted by
   0.25.1, a heap-use-after-free. *)
IMPORT Io, Fmt ;
TYPE
  Cell = RECORD v : I64 END ;
  Holder = RECORD pool : POOL ; c : OPT PTR Cell END ;
  GetT = PROCEDURE (h: PTR Holder) : OPT PTR Cell ;
PROCEDURE Rd (r: OPT PTR Cell) : I64 =
BEGIN
  IF r IS SOME c THEN RETURN c.v END ;
  RETURN 0
END Rd ;
PROCEDURE GetC (h: PTR Holder) : OPT PTR Cell =
BEGIN
  RETURN h.c
END GetC ;
PROCEDURE Go (fn: GetT) : I64 =
VAR h : PTR Holder ; c : PTR Cell ; r : OPT PTR Cell ;
BEGIN
  h := NEW (OWN, Holder) ;
  c := NEW (h.pool, Cell) ;
  c.v := 42 ;
  h.c := SOME (c) ;
  r := fn (h) ;
  DISPOSE (h) ;
  RETURN Rd (r)
END Go ;
BEGIN
  Io.WriteLine (Fmt.I64Str (Go (GetC)))
EXCEPT
| Io.IOError (m) : RETURN
END R5OwnProcValParam.
