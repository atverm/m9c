MODULE R4OwnThread ;
(* a THREAD handed a view of an owner, the owner disposed after *)
IMPORT Io, Fmt, Time ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
TYPE Job = RECORD s : SLICE OF I64 END [SHARABLE] ;
PROCEDURE Work (j : PTR Job) =
BEGIN
  Time.Sleep (200) ;
  Io.WriteLine (Fmt.I64Str (j.s[0]))
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END Work ;
PROCEDURE Go () RAISES IndexError =
VAR o : PTR Store ; j : PTR Job ;
BEGIN
  o := Mk () ;
  j := NEW (OWN, Job) ;
  j.s := o.data ;
  THREAD (Work, j) ;
  DISPOSE (o) ;
  Time.Sleep (500)
END Go ;
BEGIN
  Go ()
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END R4OwnThread.
