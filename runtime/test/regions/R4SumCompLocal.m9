MODULE R4SumCompLocal ;
IMPORT Io, Fmt ;
TYPE R = RECORD s : STR ; n : I64 END ;
VAR last : STR ;
PROCEDURE Mk (n: I64) : R =
VAR r : R ; t : STR ;
BEGIN
  r.n := n ;
  t := 'frame string number ' + Fmt.I64Str (n) ;
  r.s := t ;
  RETURN r
END Mk ;
PROCEDURE Mk2 (n: I64) : R =
VAR q : R ;
BEGIN
  q := Mk (n) ;
  RETURN q
END Mk2 ;
PROCEDURE Fill () =
BEGIN
  last := Mk (1).s
END Fill ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
BEGIN
  Fill () ;
  Churn () ;
  Io.WriteLine (last)
END R4SumCompLocal.
