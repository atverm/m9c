(* the compiler review of 2026-10-21, checker repro K1a (docs/review-2026-10-21/checker): held by regions.sh *)
MODULE R3K48 ;
IMPORT Io, Fmt ;
TYPE Node = RECORD s : STR ; next : OPT PTR Node END ;
VAR gs : SLICE OF STR ;
VAR mp : POOL ;
VAR root : PTR Node IN mp ;
PROCEDURE Keep (RO d0: STR ; RO d1: STR ; RO d2: STR ; RO d3: STR ; RO d4: STR ; RO d5: STR ; RO d6: STR ; RO d7: STR ; RO d8: STR ; RO d9: STR ; RO d10: STR ; RO d11: STR ; RO d12: STR ; RO d13: STR ; RO d14: STR ; RO d15: STR ; RO d16: STR ; RO d17: STR ; RO d18: STR ; RO d19: STR ; RO d20: STR ; RO d21: STR ; RO d22: STR ; RO d23: STR ; RO d24: STR ; RO d25: STR ; RO d26: STR ; RO d27: STR ; RO d28: STR ; RO d29: STR ; RO d30: STR ; RO d31: STR ; RO d32: STR ; RO d33: STR ; RO d34: STR ; RO d35: STR ; RO d36: STR ; RO d37: STR ; RO d38: STR ; RO d39: STR ; RO d40: STR ; RO d41: STR ; RO d42: STR ; RO d43: STR ; RO d44: STR ; RO d45: STR ; RO d46: STR ; RO d47: STR ; RO s: STR) =
VAR t : SLICE OF STR ;
BEGIN
  t := gs ;
  t[0] := s
END Keep ;
PROCEDURE KeepB (h: PTR Node ; RO s: STR) =
BEGIN

END KeepB ;
PROCEDURE Caller () =
VAR m : STR ;
BEGIN
  m := 'frame text ' + Fmt.I64Str (11) ;
  Keep ('x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', m) ;
  Io.WriteLine (m)
END Caller ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
VAR k : PTR Node IN mp ;
BEGIN
  gs := NEW (mp, STR, 2) ;
  root := NEW (mp, Node) ;
  k := NEW (mp, Node) ;
  root.next := SOME (k) ;
  Caller () ;
  Churn () ;
  Io.WriteLine (gs[0])

END R3K48.
