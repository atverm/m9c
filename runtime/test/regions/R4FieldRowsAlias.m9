MODULE R4FieldRowsAlias ;
(* the field path dropped: fl is given another table's value (its rows
   the caller's, lent read-only) before the write through fl.rows *)
IMPORT Io, Fmt ;
TYPE
  Strs = SLICE OF STR ;
  Table = RECORD head : Strs ; rows : SLICE OF Strs END ;
PROCEDURE Fill (VAR pool: POOL ; RO stamps: Strs ; m: I64 ; RO other: Table) : Table RAISES IndexError =
VAR
  fl : Table ;
  row : Strs ;
  r, i : I64 ;
BEGIN
  fl.head := NEW (pool, STR, 1) ;
  fl.head[0] := 'TIMESTAMP' ;
  fl.rows := NEW (pool, Strs, LEN (stamps)) ;
  FOR r := 0 TO LEN (stamps) - 1 DO
    row := NEW (pool, STR, m) ;
    FOR i := 0 TO m - 1 DO row[i] := stamps[r] END ;
    fl.rows[r] := row
  END ;
  fl := other ;
  fl.rows[0][0][0] := 'X' ;
  RETURN fl
END Fill ;
VAR
  pool : POOL ;
  s : Strs ;
  t : Table ;
BEGIN
  s := NEW (pool, STR, 2) ;
  s[0] := 'a' ; s[1] := 'b' ;
  t.rows := NEW (pool, Strs, 1) ;
  t.rows[0] := s ;
  t := Fill (pool, s, 3, t) ;
  Io.WriteLine (t.rows[0][2] + t.rows[1][0])
EXCEPT
| IndexError : Io.WriteLine ('index')
END R4FieldRowsAlias.
