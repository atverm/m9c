MODULE R4RoVarDeep ;
(* a slice of strings holding a literal handed whole to a VAR parameter; the callee writes a character *)
IMPORT Io ;
PROCEDURE Up (VAR s : SLICE OF STR) =
BEGIN
  s[0][0] := 'X'
END Up ;
PROCEDURE Fill () =
VAR xs : SLICE OF STR ;
BEGIN
  xs := NEW (STR, 2) ;
  xs[0] := 'abc' ;
  Up (xs) ;
  Io.WriteLine (xs[0])
END Fill ;
BEGIN
  Fill ()
END R4RoVarDeep.
