MODULE R4ReturnRowsRo ;
(* GfReturnRows with the write one level deeper: rows[0][0][0] is a
   character of the text the RO parameter lends -- refused, with the
   rows RETURNed as before *)
IMPORT Io, Fmt ;
TYPE
  Strs = SLICE OF STR ;
PROCEDURE Fill (VAR pool: POOL ; RO stamps: Strs ; m: I64) : SLICE OF Strs RAISES IndexError =
VAR
  rows : SLICE OF Strs ;
  row : Strs ;
  r, i : I64 ;
BEGIN
  rows := NEW (pool, Strs, LEN (stamps)) ;
  FOR r := 0 TO LEN (stamps) - 1 DO
    row := NEW (pool, STR, m) ;
    FOR i := 0 TO m - 1 DO row[i] := stamps[r] END ;
    rows[r] := row
  END ;
  rows[0][m - 1] := Fmt.I64Str (m) ;
  rows[0][0][0] := 'X' ;
  RETURN rows
END Fill ;
VAR
  pool : POOL ;
  s : Strs ;
  t : SLICE OF Strs ;
BEGIN
  s := NEW (pool, STR, 2) ;
  s[0] := 'a' ; s[1] := 'b' ;
  t := Fill (pool, s, 3) ;
  Io.WriteLine (t[0][2] + t[1][0])
EXCEPT
| IndexError : Io.WriteLine ('index')
END R4ReturnRowsRo.
