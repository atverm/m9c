(* the compiler review of 2026-10-21, checker repro D3n (docs/review-2026-10-21/checker): held by regions.sh *)
MODULE D3n ;
IMPORT Io, Fmt ;
VAR last : STR ;
PROCEDURE G (n: I64) : STR ;
PROCEDURE F (n: I64) : STR =
BEGIN
  IF n > 0 THEN RETURN G (n - 1) END ;
  RETURN 'frame string number ' + Fmt.I64Str (n)
END F ;
PROCEDURE G (n: I64) : STR =
BEGIN
  RETURN F (n)
END G ;
PROCEDURE Warm () =
VAR t : STR ;
BEGIN
  t := "w" ;
  Io.WriteLine (t)
END Warm ;
PROCEDURE Fill () =
BEGIN
  last := G (1)
END Fill ;
PROCEDURE Churn () =
VAR i : I64 ; t : STR ;
BEGIN
  FOR i := 1 TO 50 DO t := 'zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz' + Fmt.I64Str (i) END ;
  Io.WriteLine (t)
END Churn ;
BEGIN
  Warm () ;
  Fill () ;
  Churn () ;
  Io.WriteLine (last)
END D3n.
