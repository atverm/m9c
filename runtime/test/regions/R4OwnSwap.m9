MODULE R4OwnSwap ;
(* two owners exchanged through VAR parameters; a view of b's object read
   after a (which now holds it) is disposed *)
IMPORT Io, Fmt ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
PROCEDURE Swap (VAR a, b : PTR Store) =
VAR t : PTR Store ;
BEGIN
  t := a ;
  a := b ;
  b := t
END Swap ;
PROCEDURE Go () RAISES IndexError =
VAR a, b : PTR Store ; s : SLICE OF I64 ;
BEGIN
  a := Mk () ;
  b := Mk () ;
  s := b.data ;
  Swap (a, b) ;
  DISPOSE (a) ;
  Churn () ;
  Io.WriteLine (Fmt.I64Str (s[0])) ;
  DISPOSE (b)
END Go ;
BEGIN
  Go ()
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END R4OwnSwap.
