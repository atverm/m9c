MODULE R4OwnBlock ;
(* a view taken in a guarded block, replaced later in the block; a raise
   between leaves the view in s; the object disposed after the block *)
IMPORT Io, Fmt ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 END ;
EXCEPTION Bad ;
PROCEDURE Risky (n : I64) RAISES Bad =
BEGIN
  IF n > 0 THEN RAISE Bad END
END Risky ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Go (n : I64) RAISES IndexError =
VAR o : PTR Store ; s : SLICE OF I64 ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  BEGIN
    s := o.data ;
    Risky (n) ;
    s := NEW (I64, 4)
  EXCEPT
  | Bad : Io.WriteLine ('raised')
  END ;
  DISPOSE (o) ;
  Churn () ;
  Io.WriteLine (Fmt.I64Str (s[0]))
END Go ;
BEGIN
  Go (1)
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END R4OwnBlock.
