MODULE R5OwnFieldCopy ;
(* A pointer is copied out of a field, then the field is moved into an
   OWN parameter, which frees it, and the copy is read.  0.25.1 accepted
   it: a heap-use-after-free under ASan (2026-10-28, the ownership
   probe's P2).  Par 4.2's OWN rule refuses the move itself; the owner
   walk refuses the read of the copy on its own: a move through a
   selector kills every owner stored into the root's components. *)
IMPORT Io, Fmt ;
TYPE
  T = RECORD v : I64 END ;
  B = RECORD p : PTR T END ;
PROCEDURE Eat (OWN p: PTR T) =
BEGIN
  DISPOSE (p)
END Eat ;
PROCEDURE Go () : I64 =
VAR q, r : PTR T ; b : B ;
BEGIN
  q := NEW (OWN, T) ;
  q.v := 7 ;
  b.p := q ;
  r := b.p ;
  Eat (b.p) ;
  RETURN r.v
END Go ;
BEGIN
  Io.WriteLine (Fmt.I64Str (Go ()))
EXCEPT
| Io.IOError (m) : RETURN
END R5OwnFieldCopy.
