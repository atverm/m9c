+(* The pattern is read as Rdf's reader reads its text: POSITIONED BY
+   BYTE, READ BY CHARACTER.  Cur decodes the code point at pos, At (k)
+   the one k whole characters on, Advance moves pos past one -- so a
+   literal `é' in a pattern is one node, and a BadPattern's pos is a
+   byte offset, as every position in Text is. *)
 PROCEDURE Cur (VAR ps: Parser) : CHAR =
   (* the character at pos, NUL past the end *)
+VAR at : I64 ;
 BEGIN
   IF ps.pos >= Text.BLen (ps.p) THEN RETURN 00C END ;
-  RETURN Text.BChar (ps.p, ps.pos)
+  at := ps.pos ;
+  RETURN Text.NextCp (ps.p, at)
 END Cur ;
 
 PROCEDURE At (VAR ps: Parser ; k: I64) : CHAR =
+VAR
+  at, j : I64 ;
+  c : CHAR ;
 BEGIN
-  IF ps.pos + k >= Text.BLen (ps.p) THEN RETURN 00C END ;
-  RETURN Text.BChar (ps.p, ps.pos + k)
+  at := ps.pos ;
+  c := 00C ;
+  FOR j := 0 TO k DO
+    IF at >= Text.BLen (ps.p) THEN RETURN 00C END ;
+    c := Text.NextCp (ps.p, at)
+  END ;
+  RETURN c
+EXCEPT
+| IndexError : RETURN 00C
 END At ;
+
+PROCEDURE Advance (VAR ps: Parser) =
+  (* pos past one character, one to four octets *)
+VAR
+  at : I64 ;
+  c : CHAR ;
+BEGIN
+  IF ps.pos < Text.BLen (ps.p) THEN
+    at := ps.pos ;
+    c := Text.NextCp (ps.p, at) ;
+    ps.pos := at
+  END
+END Advance ;
+
+(* the code point that ENDS at byte offset pos (for \b: the character
+   before the position), -1 at the start *)
+PROCEDURE CpBefore (RO s: STR ; pos: I64) : I64 =
+VAR at : I64 ;
+BEGIN
+  IF pos <= 0 THEN RETURN -1 END ;
+  at := pos - 1 ;
+  (* back over continuation octets, 10xxxxxx, to the character's start *)
+  WHILE at > 0 AND I64 (Text.BAt (s, at)) >= 128 AND I64 (Text.BAt (s, at)) < 192 DO at := at - 1 END ;
+  RETURN ORD (Text.NextCp (s, at))
+END CpBefore ;
 
+(* the code point that starts at byte offset pos, its end in next; -1
+   at the end *)
+PROCEDURE CpAt (RO s: STR ; pos: I64 ; VAR next: I64) : I64 =
+BEGIN
+  next := pos ;
+  IF pos >= Text.BLen (s) THEN RETURN -1 END ;
+  RETURN ORD (Text.NextCp (s, next))
+END CpAt ;
