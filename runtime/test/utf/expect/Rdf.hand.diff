 PROCEDURE LocalStart (RO iri: STR) : I64 =
-VAR i, best : I64 ;
+  (* forward over CODE POINTS (a backward walk cannot step octets):
+     the last run of name characters that reaches the end, and in it
+     the first that may start a name *)
