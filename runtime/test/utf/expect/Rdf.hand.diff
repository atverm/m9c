+(* The reader is positioned by BYTE and reads by CHARACTER: Peek and
+   PeekAt decode the code point at pos (and k whole characters on),
+   Advance moves pos past one -- the three primitives every step of
+   the Turtle, N-Triples and JSON-LD readers goes through, so a name
+   or a literal with a letter past ASCII is one character to them, as
+   it was when a STR was an array of scalars. *)
 PROCEDURE Peek (VAR r: Reader) : CHAR RAISES IndexError =
+VAR at : I64 ;
 BEGIN
-  RETURN Text.BChar (r.src, r.pos)
+  at := r.pos ;
+  RETURN Text.NextCp (r.src, at)
 END Peek ;
 
 PROCEDURE PeekAt (VAR r: Reader ; k: I64) : CHAR =
   (* the character k ahead, or a NUL past the end *)
+VAR
+  at, j : I64 ;
+  c : CHAR ;
 BEGIN
-  IF r.pos + k >= Text.BLen (r.src) THEN RETURN 00C END ;
-  RETURN Text.BChar (r.src, r.pos + k)
+  at := r.pos ;
+  c := 00C ;
+  FOR j := 0 TO k DO
+    IF at >= Text.BLen (r.src) THEN RETURN 00C END ;
+    c := Text.NextCp (r.src, at)
+  END ;
+  RETURN c
+EXCEPT
+| IndexError : RETURN 00C
 END PeekAt ;
 
 PROCEDURE Advance (VAR r: Reader) =
+  (* past one CHARACTER: one to four octets *)
+VAR
+  at : I64 ;
+  c : CHAR ;
 BEGIN
   IF r.pos < Text.BLen (r.src) THEN
     IF Text.BIs (r.src, r.pos, 0AC) THEN
       r.line := r.line + 1 ;
       r.lineStart := r.pos + 1
     END ;
-    r.pos := r.pos + 1
+    at := r.pos ;
+    c := Text.NextCp (r.src, at) ;
+    r.pos := at
   END
 END Advance ;
 
