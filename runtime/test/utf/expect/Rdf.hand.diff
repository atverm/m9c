-    IF NcStart (Text.BChar (iri, i)) THEN best := i END ;
-    i := i - 1
+  n := Text.BLen (iri) ;
+  best := n ;
+  at := 0 ;
+  WHILE at < n DO
+    p := at ;
+    c := Text.NextCp (iri, at) ;
+    IF NcChar (c) THEN
+      IF best = n AND NcStart (c) THEN best := p END
