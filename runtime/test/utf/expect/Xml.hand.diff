 PROCEDURE Cur (VAR r: PTR Reader) : CHAR =
+  (* the OCTET at pos as a character: what the parser's ASCII structure
+     is matched against; a character past ASCII is read whole by
+     CpAtPos where it matters, in a name *)
 BEGIN
   IF r.pos >= Text.BLen (r.src) THEN RETURN 00C END ;
   RETURN Text.BChar (r.src, r.pos)
 END Cur ;
 
+PROCEDURE CpAtPos (VAR r: PTR Reader ; p: I64) : I64 =
+  (* the code point that starts at byte p, -1 at the end *)
+VAR at : I64 ;
+BEGIN
+  IF p >= Text.BLen (r.src) THEN RETURN -1 END ;
+  at := p ;
+  RETURN ORD (Text.NextCp (r.src, at))
+END CpAtPos ;
+
+PROCEDURE Step (VAR r: PTR Reader ; VAR p: I64) =
+  (* p moved past the character that starts at it *)
+VAR c : CHAR ;
+BEGIN
+  c := Text.NextCp (r.src, p)
+END Step ;
