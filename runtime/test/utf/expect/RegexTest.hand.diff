-PROCEDURE Want (RO v: SLICE OF I64 ; at, n: I64) : STR =
+(* the BYTE offset of character k of s: re's spans and `from' count
+   characters, and Regex's, like every position in Text, count bytes
+   under the UTF switch; -1 stays -1 *)
+PROCEDURE Bo (RO s: STR ; k: I64) : I64 =
+VAR
+  at, i : I64 ;
+  c : CHAR ;
+BEGIN
+  IF k < 0 THEN RETURN k END ;
+  at := 0 ;
+  FOR i := 1 TO k DO
+    IF at >= Text.BLen (s) THEN RETURN at END ;
+    c := Text.NextCp (s, at)
+  END ;
+  RETURN at
+END Bo ;
+
+PROCEDURE Want (RO s: STR ; RO v: SLICE OF I64 ; at, n: I64) : STR =
 VAR
   scratch : POOL ;
   d : PTR DynStr.DString IN scratch ;
