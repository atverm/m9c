MODULE SmtpFix ;

(* The driver of runtime/test/smtp.sh sends what smtpfix.py's four
   servers should receive and prints a line per message, `sent TAG N
   FROM RCPTS | SUBJECT | BODY | ATTACH | AUTH`, which the judge holds
   the arrived .eml files to; and a line `refused NAME CODE` for each
   dialogue that must fail, which the gate holds to its list.

     smtpfix PLAIN_PORT LOGIN_PORT TLS_PORT STARTTLS_PORT

   The servers are on localhost, the TLS ones with the gate's
   self-signed certificate, trusted through SSL_CERT_FILE.  *)

IMPORT DynStr ;
IMPORT Fmt ;
IMPORT Io ;
IMPORT Smtp ;
IMPORT Text ;

CONST
  Host = 'localhost' ;
  From = 'a@test.org' ;

VAR
  pool : POOL ;
  plain, login, tls, starttls : I64 ;
  np, nl, nt, ns : I64 ;

PROCEDURE Int (RO s: STR) : I64 =
VAR i, v : I64 ;
BEGIN
  v := 0 ;
  FOR i := 0 TO Text.BLen (s) - 1 DO v := v * 10 + I64 (Text.BAt (s, i)) - 48 END ;
  RETURN v
END Int ;

PROCEDURE Pattern (n: I64) : SLICE OF BYTE RAISES ValueRange =
  (* Pattern answers the octets the judge expects of an attachment of
   n. *)
VAR
  b : SLICE OF BYTE ;
  i : I64 ;
BEGIN
  b := NEW (BYTE, n) ;
  FOR i := 0 TO n - 1 DO b[i] := BYTE ((i * 7 + 3) MOD 256) END ;
  RETURN b
END Pattern ;

PROCEDURE Shown (RO body: STR) : STR =
BEGIN
  RETURN Text.Replace (body, '' + 0AC, '\n')
END Shown ;

PROCEDURE Try (RO name: STR ; port: I64 ; security: I64 ; RO user: STR ;
               RO pass: STR ; m: PTR Smtp.Message) : BOOL =
  (* Try answers TRUE when sent; else it prints the refusal line. *)
VAR
  why : STR ;
  c : I64 ;
BEGIN
  Smtp.Send (Host, port, security, user, pass, m) ;
  RETURN TRUE
EXCEPT
| Smtp.Error (msg, code) :
    why := msg ;
    c := code ;
    Io.WriteLine ('refused ' + name + ' ' + Fmt.I64Str (c) + ' -- ' + why) ;
    RETURN FALSE
| ValueRange :
    Io.WriteLine ('FAIL ' + name + ': ValueRange') ;
    RETURN FALSE
END Try ;

PROCEDURE OctetsBody () : STR =
BEGIN
  RETURN 'octets line one' + 0AC + '.a dot line' + 0AC + 'last line without a line end'
END OctetsBody ;

PROCEDURE Octets () : SLICE OF BYTE RAISES IndexError =
  (* Octets answers a whole message, LF line ends throughout, no final
     line end, in the program's pool: a local pool dies with the
     frame.  The message is ASCII, so its UTF-8 octets are its
     characters. *)
BEGIN
  RETURN DynStr.Wire (pool,
           'From: Alice <alice@test.org>' + 0AC + 'To: list@test.org' + 0AC +
           'Subject: composed' + 0AC + 'Date: Wed, 15 Oct 2026 12:00:00 +0000' + 0AC +
           'Message-ID: <composed@test.org>' + 0AC + 'Content-Type: text/plain; charset=us-ascii' + 0AC +
           0AC + OctetsBody (), FALSE)
END Octets ;

PROCEDURE TryOctets (RO name: STR ; port: I64 ; security: I64 ; RO user: STR ;
                     RO pass: STR ; RO from: STR ; RO to: STR ; RO octets: SLICE OF BYTE) : BOOL =
  (* TryOctets calls SendOctets with one recipient, or none when to is
     empty. *)
VAR
  scratch : POOL ;
  rcpts : SLICE OF STR ;
  why : STR ;
  c : I64 ;
BEGIN
  IF Text.BLen (to) = 0 THEN rcpts := NEW (scratch, STR, 0)
  ELSE rcpts := NEW (scratch, STR, 1) ; rcpts[0] := to
  END ;
  Smtp.SendOctets (Host, port, security, user, pass, from, rcpts, octets) ;
  RETURN TRUE
EXCEPT
| Smtp.Error (msg, code) :
    why := msg ;
    c := code ;
    Io.WriteLine ('refused ' + name + ' ' + Fmt.I64Str (c) + ' -- ' + why) ;
    RETURN FALSE
| ValueRange :
    Io.WriteLine ('FAIL ' + name + ': ValueRange') ;
    RETURN FALSE
END TryOctets ;

PROCEDURE Sent (RO tag: STR ; n: I64 ; RO rcpts: STR ; RO subject: STR ;
                RO body: STR ; RO attach: STR ; auth: BOOL) =
BEGIN
  Io.WriteLine ('sent ' + tag + ' ' + Fmt.I64Str (n) + ' ' + From + ' ' + rcpts + ' | ' +
              subject + ' | ' + Shown (body) + ' | ' + attach + ' | ' + Auth (auth))
END Sent ;

PROCEDURE Auth (b: BOOL) : STR =
BEGIN
  IF b THEN RETURN 'auth' ELSE RETURN 'noauth' END
END Auth ;

PROCEDURE Ete () : STR =
  (* the generator takes ASCII literals only: this is 'été' *)
BEGIN
  RETURN '' + 0E9C + 't' + 0E9C
END Ete ;

PROCEDURE Text1 () : STR =
BEGIN
  RETURN 'line one' + 0AC + '.a line that begins with a dot' + 0AC + Ete () + 0AC
END Text1 ;

PROCEDURE Simple (RO subject: STR ; RO to: STR) : PTR Smtp.Message IN pool =
VAR m : PTR Smtp.Message IN pool ;
BEGIN
  m := Smtp.New (pool, From, subject) ;
  Smtp.AddTo (m, to) ;
  Smtp.SetText (m, Text1 ()) ;
  RETURN m
END Simple ;

PROCEDURE Snow () : STR =
  (* Snow answers text past U+00FF: a snowman and a euro sign. *)
BEGIN
  RETURN 'Schnee ' + 2603C + ' ' + 20ACC
END Snow ;

PROCEDURE Snow1 () : PTR Smtp.Message IN pool RAISES ValueRange =
VAR m : PTR Smtp.Message IN pool ;
BEGIN
  m := Smtp.New (pool, From, Snow ()) ;
  Smtp.AddTo (m, 'b@test.org') ;
  Smtp.SetText (m, Snow () + 0AC + 'zwei') ;
  Smtp.Attach (m, SnowName (), 'application/octet-stream', Pattern (30)) ;
  RETURN m
END Snow1 ;

PROCEDURE SnowName () : STR =
  (* SnowName answers a file name past U+00FF.  Smtp writes it raw, as
     UTF-8 octets in the header (RFC 6532), and Python reads it so. *)
BEGIN
  RETURN 'Schnee ' + 2603C + ' ' + 0E9C + '.bin'
END SnowName ;

PROCEDURE UtfRcpt () : STR =
  (* UtfRcpt answers an address past ASCII: a snowman before the @.
     The judge holds an address that begins bcc to the envelope. *)
BEGIN
  RETURN 'bcc' + 2603C + '@test.org'
END UtfRcpt ;

PROCEDURE UtfBcc () : PTR Smtp.Message IN pool =
  (* UtfBcc answers an ASCII message with UtfRcpt as its Bcc. *)
VAR m : PTR Smtp.Message IN pool ;
BEGIN
  m := Simple ('utf address', 'b@test.org') ;
  Smtp.AddBcc (m, UtfRcpt ()) ;
  RETURN m
END UtfBcc ;

PROCEDURE TryReply (RO name: STR ; RO rcpt: STR ; RO want: STR) =
  (* TryReply sends to a recipient the plain server refuses with a 550
     beyond ASCII.  It prints the refusal line.  It prints a FAIL line
     unless the reply reads as want. *)
VAR
  why : STR ;
  c : I64 ;
BEGIN
  Smtp.Send (Host, plain, Smtp.Plain, '', '', Simple ('x', rcpt)) ;
  Io.WriteLine ('FAIL ' + name + ': sent')
EXCEPT
| Smtp.Error (msg, code) :
    why := msg ;
    c := code ;
    Io.WriteLine ('refused ' + name + ' ' + Fmt.I64Str (c) + ' -- ' + why) ;
    IF NOT Text.Eq (why, 'smtp: RCPT TO ' + rcpt + ': 550 Postfach ' + want + ' unbekannt') THEN
      Io.WriteLine ('FAIL ' + name + ': the reply read as ' + why)
    END
| ValueRange :
    Io.WriteLine ('FAIL ' + name + ': ValueRange')
END TryReply ;

PROCEDURE Run () RAISES ValueRange, IndexError =
VAR
  m : PTR Smtp.Message IN pool ;
  longSubject : STR ;
BEGIN
  (* p 1: plain, no AUTH, one recipient, a dot line and UTF-8 *)
  IF Try ('plain', plain, Smtp.Plain, '', '', Simple ('hello', 'b@test.org')) THEN
    np := np + 1 ;
    Sent ('p', np, 'b@test.org', 'hello', Text1 (), '-', FALSE)
  END ;
  (* p 2: AUTH PLAIN (the server offers it), To + Cc + Bcc, a folded
     subject, an attachment *)
  longSubject := 'Rapport ' + Ete () + ' 2026, rapport ' + Ete () + ' 2027, rapport ' + Ete () + ' 2028' ;
  m := Smtp.New (pool, From, longSubject) ;
  Smtp.AddTo (m, 'b@test.org') ;
  Smtp.AddCc (m, 'c@test.org') ;
  Smtp.AddBcc (m, 'bcc@test.org') ;
  Smtp.SetText (m, 'see the file') ;
  Smtp.Attach (m, 'data.bin', 'application/octet-stream', Pattern (300)) ;
  IF Try ('plainauth', plain, Smtp.Plain, 'm9', 'secret', m) THEN
    np := np + 1 ;
    Sent ('p', np, 'b@test.org,c@test.org,bcc@test.org', longSubject, 'see the file',
          'data.bin:application/octet-stream:300', TRUE)
  END ;
  (* The plain server does not offer SMTPUTF8.  A message that needs
     it is refused by name, before MAIL FROM: one for its address, one
     for its raw UTF-8 file name. *)
  IF Try ('noutfaddr', plain, Smtp.Plain, '', '', UtfBcc ()) THEN
    Io.WriteLine ('FAIL noutfaddr: sent')
  END ;
  IF Try ('noutfdata', plain, Smtp.Plain, '', '', Snow1 ()) THEN
    Io.WriteLine ('FAIL noutfdata: sent')
  END ;
  (* refusals on the plain server: a wrong password, a recipient the
     server rejects, a sender it defers, STARTTLS it does not offer *)
  IF Try ('badpass', plain, Smtp.Plain, 'm9', 'wrong', Simple ('x', 'b@test.org')) THEN
    Io.WriteLine ('FAIL badpass: sent')
  END ;
  IF Try ('rcpt', plain, Smtp.Plain, '', '', Simple ('x', 'reject@test.org')) THEN
    Io.WriteLine ('FAIL rcpt: sent')
  END ;
  m := Smtp.New (pool, 'temp@test.org', 'x') ;
  Smtp.AddTo (m, 'b@test.org') ;
  Smtp.SetText (m, 'x') ;
  IF Try ('mail', plain, Smtp.Plain, '', '', m) THEN
    Io.WriteLine ('FAIL mail: sent')
  END ;
  IF Try ('nostarttls', plain, Smtp.StartTls, '', '', Simple ('x', 'b@test.org')) THEN
    Io.WriteLine ('FAIL nostarttls: sent')
  END ;
  IF Try ('tlsplain', plain, Smtp.Tls, '', '', Simple ('x', 'b@test.org')) THEN
    Io.WriteLine ('FAIL tlsplain: sent')
  END ;
  (* p 4: SendOctets -- a message the driver composed, LF line ends
     and a dot line, under an envelope that differs from its headers
     (a list's VERP sender, the member alone as recipient) *)
  IF TryOctets ('octets', plain, Smtp.Plain, '', '', 'list+bounce+b=test.org@test.org',
                'b@test.org', Octets ()) THEN
    np := np + 1 ;
    Io.WriteLine ('octets p ' + Fmt.I64Str (np) + ' list+bounce+b=test.org@test.org b@test.org | ' +
                  'Alice <alice@test.org> | composed | ' + Shown (OctetsBody ()) + ' | noauth')
  END ;
  (* refusal: no recipient, before any connection *)
  IF TryOctets ('octetsnorcpt', plain, Smtp.Plain, '', '', From, '', Octets ()) THEN
    Io.WriteLine ('FAIL octetsnorcpt: sent')
  END ;
  (* l 1: a server offering LOGIN only *)
  IF Try ('login', login, Smtp.Plain, 'm9', 'secret', Simple ('by LOGIN', 'b@test.org')) THEN
    nl := nl + 1 ;
    Sent ('l', nl, 'b@test.org', 'by LOGIN', Text1 (), '-', TRUE)
  END ;
  (* l 2: the LOGIN server offers SMTPUTF8.  A subject, a body and a
     file name past U+00FF arrive as UTF-8, under SMTPUTF8. *)
  IF Try ('snow', login, Smtp.Plain, '', '', Snow1 ()) THEN
    nl := nl + 1 ;
    Sent ('l', nl, 'b@test.org', Snow (), Snow () + 0AC + 'zwei',
          SnowName () + ':application/octet-stream:30', FALSE)
  END ;
  (* l 3: a Bcc address past ASCII arrives as UTF-8, under SMTPUTF8.
     Only the envelope holds it, so the message octets stay ASCII. *)
  IF Try ('utfaddr', login, Smtp.Plain, '', '', UtfBcc ()) THEN
    nl := nl + 1 ;
    Sent ('l', nl, 'b@test.org,' + UtfRcpt (), 'utf address', Text1 (), '-', FALSE)
  END ;
  (* t 1: implicit TLS *)
  IF Try ('tls', tls, Smtp.Tls, 'm9', 'secret', Simple ('over TLS', 'b@test.org')) THEN
    nt := nt + 1 ;
    Sent ('t', nt, 'b@test.org', 'over TLS', Text1 (), '-', TRUE)
  END ;
  (* s 1: STARTTLS, which that server requires; then plain against it *)
  IF Try ('starttls', starttls, Smtp.StartTls, 'm9', 'secret', Simple ('after STARTTLS', 'b@test.org')) THEN
    ns := ns + 1 ;
    Sent ('s', ns, 'b@test.org', 'after STARTTLS', Text1 (), '-', TRUE)
  END ;
  IF Try ('needstarttls', starttls, Smtp.Plain, '', '', Simple ('x', 'b@test.org')) THEN
    Io.WriteLine ('FAIL needstarttls: sent')
  END ;
  (* replies beyond ASCII: UTF-8 octets read as UTF-8, Latin-1 octets
     one character per octet; both read as the server's text *)
  TryReply ('utfreply', 'utf8@test.org', '' + 2603C + ' ' + 0E9C) ;
  TryReply ('latinreply', 'latin1@test.org', '' + 0E9C)
END Run ;

BEGIN
  IF Io.ArgCount () < 5 THEN
    Io.WriteLine ('usage: smtpfix PLAIN LOGIN TLS STARTTLS') ;
    Io.Halt (2)
  END ;
  np := 0 ; nl := 0 ; nt := 0 ; ns := 0 ;
  (* the arguments inside the block: Io.Arg raises ValueRange, and the
     handler covers only its own block (2026-10-21; the flat handled
     set had counted this one caught) *)
  BEGIN
    plain := Int (Io.Arg (pool, 1)) ;
    login := Int (Io.Arg (pool, 2)) ;
    tls := Int (Io.Arg (pool, 3)) ;
    starttls := Int (Io.Arg (pool, 4)) ;
    Run ()
  EXCEPT
  | ValueRange, IndexError :
      Io.WriteLine ('FAIL ValueRange or IndexError')
  END ;
  Io.WriteLine ('done')
END SmtpFix.
