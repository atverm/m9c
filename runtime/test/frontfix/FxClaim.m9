(* FxClaim is a front-end fixture (docs/fpc-removal-plan.md): a FOR
   with a claim, FOR [INRANGE b].  The Pascal parser does not have the
   form, so this file's record is the M9 side's own.  It is parsed and
   printed, never checked. *)

MODULE FxClaim ;

BEGIN
  FOR [INRANGE ok] i := 0 TO n - 1 DO a[i] := 0 END ;
  FOR [INRANGE TRUE] i := 0 TO 7 DO END ;
  FOR [INRANGE lo >= 0 AND hi < LEN (a)] i := lo TO hi BY 2 DO
    s := s + a[i]
  END ;
  FOR [INRANGE Fits (g, 0, n)] i := n - 1 TO 0 BY -1 DO
    FOR j := 0 TO m - 1 DO g[i, j] := g[i, j] + 1.0 END
  END ;
  FOR [INRANGE t[0]] i := 0 TO 1 DO
    FOR [INRANGE r.ok OR NOT p] j := 0 TO 1 DO END
  END
END FxClaim.
