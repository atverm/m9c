MODULE GfOwnerManyNames ;

(* WANT: 41 *)

(* 61 owned locals of which one is used: the owner walk gives a bit only
  to the owners a body names, so it no longer fails closed at the 60th
  (the fourth review's F6) *)
(* 61 owners, nothing unsafe *)
IMPORT Io, Fmt ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
PROCEDURE Go () RAISES IndexError =
VAR o1, o2, o3, o4, o5, o6, o7, o8, o9, o10, o11, o12, o13, o14, o15, o16, o17, o18, o19, o20, o21, o22, o23, o24, o25, o26, o27, o28, o29, o30, o31, o32, o33, o34, o35, o36, o37, o38, o39, o40, o41, o42, o43, o44, o45, o46, o47, o48, o49, o50, o51, o52, o53, o54, o55, o56, o57, o58, o59, o60, o : PTR Store ;
BEGIN
  o := Mk () ;
  Io.WriteLine (Fmt.I64Str (o.data[0])) ;
  DISPOSE (o)
END Go ;
BEGIN
  Go ()
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END GfOwnerManyNames.
