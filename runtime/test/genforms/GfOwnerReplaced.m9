MODULE GfOwnerReplaced ;

(* WANT: 41 *)

(* an owner given a new object: views of the old one, which leaks, stay
  readable (F5) *)
(* SAFE: the owner given a second object (the first leaks); the second disposed; a view of the first read *)
IMPORT Io, Fmt, Text ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 ; name : STR END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
PROCEDURE Go () RAISES IndexError =
VAR o : PTR Store ; s : SLICE OF I64 ;
BEGIN
  o := Mk () ;
  s := o.data ;
  o := Mk () ;
  DISPOSE (o) ;
  Io.WriteLine (Fmt.I64Str (s[0]))
END Go ;
BEGIN
  Go ()
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END GfOwnerReplaced.
