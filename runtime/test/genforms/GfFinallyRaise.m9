MODULE GfFinallyRaise ;

(* WANT: finally: 132 Bad first message, 4 Bad second wins, 56 none, 78 none *)

(* A FINALLY runs on the raise path as on the others (report par 5),
   and the exception it runs for goes on afterwards (2026-10-21, the
   compiler review's G1).  Until then the cleanup ran with the raise
   still pending: every checked statement and call in it stopped at
   its first test -- Cleaned's log read 0, not 132 -- and a cleanup
   calling a procedure that handled an exception of its own cleared
   the pending one, so Cleaned returned normally.  Quiet's payload is
   300 characters, more than the in-flight buffer's first 256 octets,
   so the buffer holding 'first message' is reallocated under the
   cleanup: the saved copy is what keeps the text.  A raise in the
   cleanup wins; a RETURN through a FINALLY runs it; so does the
   ordinary end. *)

IMPORT Io, Fmt ;

EXCEPTION
  Bad (RO msg : STR) ;
  Other (RO msg : STR) ;

VAR
  log : I64 ;
  out : STR ;

PROCEDURE Note (d: I64) =
BEGIN
  log := log * 10 + d
END Note ;

PROCEDURE Long () : STR =
VAR
  s : STR ;
  i : I64 ;
BEGIN
  s := '' ;
  FOR i := 1 TO 30 DO s := s + 'abcdefghij' END ;
  RETURN s
END Long ;

(* handles an exception of its own: the cleanup's callee *)
PROCEDURE Quiet () =
BEGIN
  BEGIN
    RAISE Other (Long ())
  EXCEPT
  | Other (m) : Note (LEN (m) DIV 100)
  END
END Quiet ;

PROCEDURE Cleaned () RAISES Bad =
BEGIN
  BEGIN
    RAISE Bad ('first message')
  FINALLY
    Note (1) ;
    Quiet () ;
    Note (2)
  END
END Cleaned ;

PROCEDURE Replaced () RAISES Bad =
BEGIN
  BEGIN
    RAISE Bad ('lost')
  FINALLY
    Note (4) ;
    RAISE Bad ('second wins')
  END
END Replaced ;

PROCEDURE Returned () =
BEGIN
  BEGIN
    Note (5) ;
    RETURN
  FINALLY
    Note (6)
  END ;
  Note (9)
END Returned ;

PROCEDURE Normal () =
BEGIN
  BEGIN
    Note (7)
  FINALLY
    Note (8)
  END
END Normal ;

PROCEDURE Try (k: I64) : STR =
BEGIN
  log := 0 ;
  IF k = 1 THEN Cleaned ()
  ELSIF k = 2 THEN Replaced ()
  ELSIF k = 3 THEN Returned ()
  ELSE Normal ()
  END ;
  RETURN ' ' + Fmt.I64Str (log) + ' none'
EXCEPT
| Bad (m) : RETURN ' ' + Fmt.I64Str (log) + ' Bad ' + m
END Try ;

BEGIN
  out := 'finally:' + Try (1) + ',' + Try (2) + ',' + Try (3) + ',' + Try (4) ;
  Io.WriteLine (out)
END GfFinallyRaise.
