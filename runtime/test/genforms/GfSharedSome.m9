MODULE GfSharedSome ;

(* WANT: kept 41 *)

(* `g := SOME (p)' into an OPT SHARED PTR is a copy of a SHARED handle
   and counts as one, as `g := p' does: it was emitted as a plain copy,
   so the kept handle did not count and died with the caller's DISPOSE
   of its own handle (the third review's ownership O4; heap-use-after-
   free under ASan, a churned value in a plain run). *)

IMPORT Io, Fmt ;

TYPE Store = RECORD n : I64 END ;

VAR g : OPT SHARED PTR Store ;

PROCEDURE Keep (KEPT p: SHARED PTR Store) =
BEGIN
  g := SOME (p)
END Keep ;

PROCEDURE Go () =
VAR o : PTR Store ; h : SHARED PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.n := 41 ;
  h := SHARED (o) ;
  Keep (h) ;
  DISPOSE (h)
END Go ;

PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END
END Churn ;

BEGIN
  Go () ;
  Churn () ;
  IF g IS SOME r THEN Io.WriteLine ('kept ' + Fmt.I64Str (r.n)) END
END GfSharedSome.
