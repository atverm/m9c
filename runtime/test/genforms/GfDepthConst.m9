MODULE GfDepthConst ;

(* WANT: 5 *)

(* a CONST string stored two levels down, then elements replaced: the write through two subscripts replaces an element and writes no literal (oneflux 0.25 item 26).  Refused as "a write through ..., which holds read-only
   storage" until the region judgement kept read-only storage by depth
   for names whose every store it sees (2026-10-26, the third review). *)
(* a CONST string stored into a fresh slice of slices, two levels deep *)
IMPORT Io, Fmt ;
CONST
  Nan = '-9999' ;
TYPE
  Strs = SLICE OF STR ;
PROCEDURE Fill (n, m: I64) : I64 RAISES IndexError =
VAR
  scratch : POOL ;
  vut : SLICE OF Strs ;
  y, i : I64 ;
BEGIN
  vut := NEW (scratch, Strs, n) ;
  FOR y := 0 TO n - 1 DO vut[y] := NEW (scratch, STR, m) END ;
  FOR y := 0 TO n - 1 DO FOR i := 0 TO m - 1 DO vut[y][i] := Nan END END ;
  RETURN LEN (vut[n - 1][m - 1])
END Fill ;
BEGIN
  Io.WriteLine (Fmt.I64Str (Fill (2, 3)))
EXCEPT
| IndexError : Io.WriteLine ('index')
END GfDepthConst.
