MODULE GfStrAlias ;

(* WANT: alias y 2 z 3 *)

(* A name for STR is a STR (2026-10-24, found writing the review
   gate's fixture for the UTF switch's row): `TYPE Name = STR' then
   `nm[1]' passed the checker and the generator said `selector form
   unsupported yet' -- Gen.Resolve expanded the predeclared STR to its
   slice only at the START of the chain of names, not after following
   an alias to it, so the subscript met a name where it wanted a
   slice.  Through a second alias too, and a write through one. *)

IMPORT Fmt, Io ;

TYPE
  Name = STR ;
  Label = Name ;

VAR
  nm : Name ;
  lb : Label ;
  c : CHAR ;
  s : STR ;

BEGIN
  nm := 'xy' ;
  lb := NEW (CHAR, 3) ;
  lb[0] := 'a' ;
  lb[1] := 'b' ;
  lb[2] := 'z' ;
  c := nm[1] ;
  s := 'alias ' ;
  s := s + c + ' ' + Fmt.I64Str (LEN (nm)) + ' ' + lb[2] + ' ' + Fmt.I64Str (LEN (lb)) ;
  Io.WriteLine (s)
END GfStrAlias.
