MODULE GfStrAlias ;

IMPORT Text ;

(* WANT: alias y 2 z 3 *)

(* A name for STR is a STR (2026-10-24, found writing the review
   gate's fixture for the UTF switch's row): `TYPE Name = STR' then
   `nm[1]' passed the checker and the generator said `selector form
   unsupported yet' -- Gen.Resolve expanded the predeclared STR to its
   slice only at the START of the chain of names, not after following
   an alias to it, so the subscript met a name where it wanted a
   slice.  It covers a second alias too, and a write through one.
   STR is the UTF-8 type since 2026-10-31 and has no subscript, so the
   subscript and the write go through a name for SLICE OF CHAR; Name
   stays a name for STR, read by its octets. *)

IMPORT Fmt, Io ;

TYPE
  Name = STR ;
  Chars = SLICE OF CHAR ;
  Label = Chars ;

VAR
  nm : Name ;
  lb : Label ;
  c : CHAR ;
  s : STR ;

BEGIN
  nm := 'xy' ;
  lb := NEW (CHAR, 3) ;
  lb[0] := 'a' ;
  lb[1] := 'b' ;
  lb[2] := 'z' ;
  c := Text.BChar (nm, 1) ;
  s := 'alias ' ;
  s := s + c + ' ' + Fmt.I64Str (Text.BLen (nm)) + ' ' + lb[2] + ' ' + Fmt.I64Str (LEN (lb)) ;
  Io.WriteLine (s)
END GfStrAlias.
