MODULE GfOwnerPick ;

(* WANT: 7 *)

(* a callee answering one argument does not answer the other (F2) *)
(* SAFE: a call answering its second argument, not the owner *)
IMPORT Io, Fmt, Text ;
TYPE Store = RECORD n : I64 ; pool : POOL ; data : SLICE OF I64 ; name : STR END ;
PROCEDURE Churn () =
VAR i : I64 ; xs : SLICE OF I64 ;
BEGIN
  xs := NEW (I64, 100) ;
  FOR i := 0 TO 99 DO xs[i] := 77777777 END ;
  Io.WriteLine (Fmt.I64Str (xs[3]))
END Churn ;
PROCEDURE Mk () : PTR Store =
VAR o : PTR Store ;
BEGIN
  o := NEW (OWN, Store) ;
  o.data := NEW (o.pool, I64, 4) ;
  o.data[0] := 41 ;
  RETURN o
END Mk ;
PROCEDURE Pick (p : PTR Store ; x : SLICE OF I64) : SLICE OF I64 =
BEGIN
  IF p.n > 100 THEN x[0] := 8 END ;
  RETURN x
END Pick ;
PROCEDURE Go () RAISES IndexError =
VAR o : PTR Store ; x, t : SLICE OF I64 ;
BEGIN
  o := Mk () ;
  x := NEW (I64, 1) ;
  x[0] := 7 ;
  t := Pick (o, x) ;
  DISPOSE (o) ;
  Io.WriteLine (Fmt.I64Str (t[0]))
END Go ;
BEGIN
  Go ()
EXCEPT
| IndexError (i, n) : Io.WriteLine ('IndexError')
END GfOwnerPick.
