MODULE GfMultiArm ;

(* WANT: one arm: Bad 3 Worse 4 either ValueRange other *)

(* One handler arm for several exceptions, `| A, B :' (2026-10-11,
   cp-kernel's proposal): any of them enters the arm; a binder is
   allowed when every one has the same fields, and binds them alike.
   Without a binder the names may differ in their fields. *)

IMPORT Io, Fmt ;

EXCEPTION
  Bad (n : I64) ;
  Worse (n : I64) ;
  Other (s : STR) ;

VAR
  out : STR ;

PROCEDURE Fire (k: I64) RAISES Bad, Worse, Other, ValueRange =
BEGIN
  IF k = 1 THEN RAISE Bad (3) END ;
  IF k = 2 THEN RAISE Worse (4) END ;
  IF k = 3 THEN RAISE ValueRange END ;
  RAISE Other ('x')
END Fire ;

PROCEDURE Inner (k: I64) : STR RAISES ValueRange, Other =
BEGIN
  Fire (k) ;
  RETURN ''
EXCEPT
| Bad, Worse (n) :
    IF k = 1 THEN RETURN ' Bad ' + Fmt.I64Str (n) END ;
    RETURN ' Worse ' + Fmt.I64Str (n)
END Inner ;

PROCEDURE Try (k: I64) : STR =
BEGIN
  RETURN Inner (k)
EXCEPT
| ValueRange, Other :
    IF k = 3 THEN RETURN ' either ValueRange' END ;
    RETURN ' other'
END Try ;

BEGIN
  out := 'one arm:' + Try (1) + Try (2) + Try (3) + Try (4) ;
  Io.WriteLine (out)
END GfMultiArm.
