(* EXPECT: cannot concatenate a string with SLICE OF CHAR -- UTF (s) converts a SLICE OF CHAR *)
MODULE m ;
(* Legal forms come first: a UTF joins a UTF, a literal and a CHAR. *)
VAR
  u, v : UTF ;
  s : SLICE OF CHAR ;
BEGIN
  u := 'a' ;
  v := u + u ;
  v := u + 'b' ;
  v := 'c' + u ;
  v := u + 0041C ;
  s := 'd' ;
  v := u + UTF (s) ;
  v := u + s
END m.
