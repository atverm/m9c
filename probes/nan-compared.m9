(* EXPECT: no '=' with NaN: no comparison with NaN is ever TRUE *)
MODULE m ;
VAR
  x : F64 ;
  y : F32 ;
  b : BOOL ;
BEGIN
  (* legal: NaN is a real, of either width, in arithmetic too, and a
     value is NaN exactly when it differs from itself *)
  x := NaN ;
  y := NaN ;
  x := 2.0 * NaN + x ;
  b := x # x ;
  (* refused: never TRUE, whatever x is *)
  b := x = NaN
END m.
