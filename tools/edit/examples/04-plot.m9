MODULE Wave ;

(* Plot renders SVG as a STRING -- deterministic bytes.  Press Run
   and the figure appears on the right. *)
IMPORT Io ;

IMPORT Math ;

IMPORT Plot ;

CONST
  N = 120 ;

VAR
  pool : POOL ;
  xs, ys : ARRAY 120 OF F64 ;
  i : I64 ;
  t, svg : STR ;

BEGIN
  FOR i := 0 TO N - 1 DO
    xs[i] := F64 (i) * 0.1 ;
    ys[i] := Math.Sin (xs[i])
  END ;
  Plot.ClearFigure () ;
  Plot.AddLine (xs, ys, 0, 'sin') ;
  svg := Plot.Render (pool, 'a sine wave', 'x', 'sin x') ;
  Io.WriteFile ('/tmp/wave.svg', svg) ;
  Io.WriteLine ('wrote wave.svg')
EXCEPT
| ValueRange :
    Io.ErrLine ('range') ;
    Io.Halt (1)
| Io.IOError (p) :
    Io.ErrLine ('write failed') ;
    Io.Halt (1)
END Wave.
