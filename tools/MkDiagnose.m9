    'hand a C.ConstPtr parameter, or copy the bytes into a writable slice first',
    'name every member, or give the CASE an ELSE',
    'state [FRESH] on the procedure (its answer is built in the caller arena), or hand C a slice it fills instead of a variable',
    'drop the attribute: the checker reads the body',
    'spell it [PURE] or [FRESH], or drop it',
    'WAIT and SIGNAL on the procedure first parameter, the monitor it is bound to; to wait on another monitor, call a procedure bound to it',
    'take the locks in one order everywhere: take what is needed out of the first monitor, leave it, then enter the second',
    'hand each thread its own record (an element of a slice of jobs), or give each worker a POOL of its own',
    'mark the record [SHARABLE] if the threads write disjoint parts of it, make it a MONITOR, or hand the worker a copy',
    'hand the procedure value only what is read out of the record, or give the worker a POOL of its own',
    'wait from a procedure that is not bound: leave the first monitor, then wait on the second'
  ] ;

VAR
  pool : POOL ;
  root : STR ;

(* the file's octets, one CHAR each *)
(* a file as TEXT: Io.ReadFile decodes UTF-8 and Io.WriteFile encodes
   it (since 2026-10-09).  Read as octets, one CHAR a byte, as until
   2026-10-23, a probe's first character past ASCII came out of
   WriteFile encoded twice ('Grüße' as 'GrÃ¼Ãe') and --check never
   matched -- no probe had one until the UTF probes *)
PROCEDURE Octets (RO path: STR) : STR RAISES Io.IOError, ValueRange =
BEGIN
  RETURN Io.ReadFile (pool, path)
END Octets ;

(* the index of probe n in the tables, or -1 *)
PROCEDURE Entry (RO n: STR) : I64 =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (Probe) - 1 DO
    IF DynStr.Eq (Probe[i], n) THEN RETURN i END
  END ;
  RETURN -1
END Entry ;

(* the probe's first line: `(* EXPECT: msg *)` or `(* LEDGER: msg *)`;
   kind and msg answered, FALSE for anything else *)
PROCEDURE Expect (RO text: STR ; VAR kind, msg: STR) : BOOL =
VAR
  k : I64 ;
  first : STR ;
BEGIN
  k := Text.FindChar (text, 0AC) ;
  IF k < 0 THEN first := text ELSE first := SLICE (text, 0, k) END ;
  IF NOT Text.EndsWith (first, ' *)') THEN RETURN FALSE END ;
  IF Text.StartsWith (first, '(* EXPECT: ') THEN
    kind := 'EXPECT'
  ELSIF Text.StartsWith (first, '(* LEDGER: ') THEN
    kind := 'LEDGER'
  ELSE
    RETURN FALSE
  END ;
  IF LEN (first) < 14 THEN RETURN FALSE END ;
  msg := SLICE (first, 11, LEN (first) - 14) ;
  RETURN TRUE
END Expect ;

(* everything after the first line, less the line feeds at its end *)
PROCEDURE Body (RO text: STR) : STR =
VAR k, n : I64 ;
BEGIN
  k := Text.FindChar (text, 0AC) ;
  IF k < 0 THEN RETURN '' END ;
  n := LEN (text) ;
  WHILE (n > k + 1) AND (text[n - 1] = 0AC) DO n := n - 1 END ;
  RETURN SLICE (text, k + 1, n - k - 1)
END Body ;

(* the message as a table cell: a bar escaped *)
PROCEDURE Cell (VAR d: PTR DynStr.DString ; RO s: STR) =
VAR i : I64 ;
BEGIN
  FOR i := 0 TO LEN (s) - 1 DO
    IF s[i] = '|' THEN DynStr.AppendChar (d, 05CC) END ;
    DynStr.AppendChar (d, s[i])
  END
END Cell ;

PROCEDURE Line (VAR d: PTR DynStr.DString ; RO s: STR) =
BEGIN
  DynStr.Append (d, s) ;
  DynStr.AppendChar (d, 0AC)
END Line ;

VAR
  names, files : SLICE OF STR ;
  i, k, n, bad : I64 ;
  d : PTR DynStr.DString IN pool ;
  kind, msg, text, page, cur, path, out : STR ;
  check : BOOL ;

BEGIN
  check := (Io.ArgCount () > 1) AND DynStr.Eq (Io.Arg (pool, 1), '--check') ;
  root := Text.Keep (pool, Io.Arg (pool, 0)) ;
  k := Text.LastChar (root, '/') ;
  IF k < 0 THEN
    root := '..'
  ELSE
    root := SLICE (root, 0, k) ;
    k := Text.LastChar (root, '/') ;
    IF k < 0 THEN root := '.' ELSE root := SLICE (root, 0, k) END
  END ;
  out := Text.Keep (pool, root + '/docs/diagnose.md') ;

  (* the probes, in name order *)
  files := Io.ListDir (pool, root + '/probes') ;
  n := 0 ;
  FOR i := 0 TO LEN (files) - 1 DO
    IF Text.EndsWith (files[i], '.m9') THEN n := n + 1 END
  END ;
  names := NEW (pool, STR, n) ;
  n := 0 ;
  FOR i := 0 TO LEN (files) - 1 DO
    IF Text.EndsWith (files[i], '.m9') THEN
      names[n] := SLICE (files[i], 0, LEN (files[i]) - 3) ;
      n := n + 1
    END
  END ;
  Sort.Strs (names) ;

  (* every probe explained, every explanation a probe *)
  bad := 0 ;
  FOR i := 0 TO LEN (names) - 1 DO
    IF Entry (names[i]) < 0 THEN
      Io.ErrLine ('mkdiagnose: probe ' + names[i] + ' has no explanation') ;
      bad := bad + 1
    END
  END ;
  FOR i := 0 TO LEN (Probe) - 1 DO
    k := 0 ;
    WHILE (k < LEN (names)) AND NOT DynStr.Eq (names[k], Probe[i]) DO k := k + 1 END ;
    IF k = LEN (names) THEN
      Io.ErrLine ('mkdiagnose: explanation ' + Probe[i] + ' has no probe') ;
      bad := bad + 1
    END
  END ;
  IF bad > 0 THEN Io.Halt (1) END ;

  (* the page *)
  d := DynStr.New (pool) ;
  Line (d, '# M9 diagnostics: message, cause, fix' + 0AC) ;
  Line (d, '*GENERATED by `tools/MkDiagnose.m9` from `probes/` -- do not edit.*' + 0AC) ;
  Line (d, 'Every entry is one checker refusal.  The **message** is read from the') ;
  Line (d, "probe's first line, and `probediff.sh` holds both checkers to it, so") ;
  Line (d, 'this column cannot drift from what `m9c` prints.  The cause and the') ;
  Line (d, 'fix are curated in the generator, keyed by probe name; a probe without') ;
  Line (d, 'an entry fails the build.  `runtime/test/diagdiff.sh` is the gate.' + 0AC) ;
  Line (d, 'A checker message is printed as `LINE:COL Module.Proc: MESSAGE`, then') ;
  Line (d, '`m9c: N errors in FILE`.  A PARSE error is still a bare count with no') ;
  Line (d, 'line (`m9c: 4 parse errors in FILE`): run `host/fpc/g1 FILE` for') ;
  Line (d, '`LINE:COL message`.  A GENERATOR error is `FILE:LINE: gen: MESSAGE`.' + 0AC) ;
  Line (d, '| message | cause | fix | probe |') ;
  Line (d, '|---|---|---|---|') ;
  FOR i := 0 TO LEN (names) - 1 DO
    path := Text.Keep (pool, root + '/probes/' + names[i] + '.m9') ;
    text := Octets (path) ;
    IF NOT Expect (text, kind, msg) THEN
      Io.ErrLine (path + ': first line is not an EXPECT/LEDGER comment') ;
      Io.Halt (1)
    END ;
    k := Entry (names[i]) ;
    DynStr.Append (d, '| `') ;
    Cell (d, msg) ;
    DynStr.Append (d, '`') ;
    IF NOT Text.Eq (kind, 'EXPECT') THEN DynStr.Append (d, ' *(ledger, not an error)*') END ;
    Line (d, ' | ' + Cause[k] + ' | ' + Fix[k] + ' | `' + names[i] + '` |')
  END ;
  Line (d, '') ;
  Line (d, '## The programs' + 0AC) ;
  Line (d, 'Each is the smallest program that earns its message.  Reading one is') ;
  Line (d, 'faster than reading the rule.' + 0AC) ;
  FOR i := 0 TO LEN (names) - 1 DO
    text := Octets (root + '/probes/' + names[i] + '.m9') ;
    IF Expect (text, kind, msg) THEN END ;
    Line (d, '### ' + names[i] + 0AC) ;
    Line (d, '`' + msg + '`' + 0AC) ;
    Line (d, '```') ;
    Line (d, Body (text)) ;
    DynStr.Append (d, '```' + 0AC) ;
    IF i < LEN (names) - 1 THEN DynStr.AppendChar (d, 0AC) END
  END ;
  page := DynStr.View (d) ;

  IF check THEN
    cur := '' ;
    IF Io.Exists (out) THEN cur := Octets (out) END ;
    IF NOT DynStr.Eq (cur, page) THEN
      Io.ErrLine ('diagdiff: docs/diagnose.md is stale; run tools/MkDiagnose.m9') ;
      Io.Halt (1)
    END ;
    Io.WriteLine ('diagdiff: docs/diagnose.md matches probes/ ('
                  + Fmt.I64Str (LEN (Probe)) + ' entries)')
  ELSE
    Io.WriteFile (out, page) ;
    Io.WriteLine ('docs/diagnose.md: ' + Fmt.I64Str (LEN (Probe)) + ' entries from probes/')
  END
EXCEPT
| Io.IOError (p) :
    msg := p ;
    Io.ErrLine ('mkdiagnose: cannot read or write ' + msg) ; Io.Halt (1)
| IndexError :
    Io.ErrLine ('mkdiagnose: an IndexError -- the Probe, Cause and Fix tables are out of step, or there is no program name to find the repository by') ; Io.Halt (1)
| ValueRange :
    Io.ErrLine ('mkdiagnose: a character past one byte') ; Io.Halt (1)
END MkDiagnose.
