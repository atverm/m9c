#!/usr/bin/env -S m9c --run
MODULE MkDiagnose ;

(* The M9 diagnostics table, GENERATED from probes/.

   Each file in probes/ is the smallest program that earns one checker
   refusal, with the expected message on its first line -- and
   probediff.sh holds both checkers to that message.  So the message
   column of docs/diagnose.md cannot drift: it is read from the probe,
   never typed here.

   What IS typed here is the cause and the fix, one line each, keyed by
   probe name.  A probe without an entry makes this script FAIL, so a
   new refusal cannot be added to the checker without also being
   explained -- the same shape as docdiff's drift gate, applied to the
   explanation instead of the signature.

       tools/MkDiagnose.m9            regenerate docs/diagnose.md
       tools/MkDiagnose.m9 --check    exit 1 if it would change

   runtime/test/diagdiff.sh is the gate and calls --check.  This
   replaced tools/mkdiagnose.py on 2026-10-04: the two wrote the same
   page but for the line naming its generator, and refused the same
   drifts.  Probes are read as UTF-8 text and written back as text.

   Report sections are cited as "par N.M".  Probe, Cause and Fix are
   three tables in step, in the order the explanations were written;
   the page lists the probes in name order.                            *)

IMPORT Io ;
IMPORT Text ;
IMPORT DynStr ;
IMPORT Fmt ;
IMPORT Sort ;

CONST
  Probe = [
    'adr-outside-unsafe',
    'alias-nonscalar-conversion',
    'all-outside-a-view',
    'arity-mismatch',
    'byte-arithmetic',
    'case-label-mismatch',
    'case-record-selected',
    'compare-mismatch',
    'concat-non-string',
    'is-some-call-binder',
    'cond-not-bool',
    'conditional-move',
    'def-not-implemented',
    'dispose-a-borrow',
    'dispose-pool-interior',
    'div-on-float',
    'grid-len-axis-exists',
    'grid-len-needs-an-axis',
    'grid-rank-is-part-of-the-type',
    'grid-subscript-arity',
    'implicit-widening',
    'int-literal-to-float',
    'int-slash-division',
    'proc-var-must-be-opt',
    'proc-field-must-be-opt',
    'proc-value-signature-differs',
    'proc-value-raises-more',
    'proc-value-call-raises',
    'proc-value-call-in-pure',
    'thread-argument-type',
    'thread-moves-its-argument',
    'literal-does-not-fit',
    'is-some-on-non-opt',
    'lend-value-ptr-as-var',
    'module-state-without-stateful',
    'move-borrow-into-own',
    'kept-borrow-arg',
    'kept-concat-arg',
    'kept-via-local',
    'kept-undeclared',
    'local-const-shadow',
    'undefined-name',
    'unknown-exception',
    'unknown-type-in-known-module',
    'name-needs-enum',
    'array-enum-index-int',
    'for-enum-bounds-differ',
    'for-enum-takes-no-step',
    'enum-conversion-no-raises',
    'variant-in-named-module',
    'function-falls-off-end',
    'pool-where-a-value-is-wanted',
    'aggregate-mixed-types',
    'aggregate-not-a-literal',
    'aggregate-local',
    'aggregate-exported',
    'const-table-aliased',
    'const-table-lent-writable',
    'write-to-const',
    'const-as-var-argument',
    'literal-to-writable-slice',
    'ro-relent-writable',
    'const-string-to-writable',
    'ro-lend-allowed-forms',
    'compare-strings',
    'compare-composite',
    'for-variable-keeps-its-type',
    'for-variable-undeclared',
    'for-variable-not-integer',
    'for-variable-enum-mismatch',
    'module-named-not-imported',
    'write-through-ro-variable',
    'ro-variable-lent-writable',
    'pool-escape-by-component',
    'declared-twice',
    'definition-const-in-implementation',
    'definition-const-string-in-implementation',
    'module-import-allowed-forms',
    'param-shadows-const',
    'from-m9-module',
    'concat-escapes-modvar',
    'concat-escapes-param',
    'bytesize-not-slice',
    'new-reversed',
    'frame-ptr-to-modvar',
    'frame-ptr-via-var-component',
    'frame-ptr-in-pooled-local',
    'frame-ptr-record-copy',
    'frame-ptr-pooled-component',
    'pool-clause-disagrees',
    'pool-view-via-var',
    'pool-ptr-via-var',
    'pool-escape-by-shape',
    'pool-escape-via-callee',
    'assign-to-undeclared',
    'module-member-unknown',
    'new-type-unknown',
    'handler-binder-typed',
    'ro-copy-written',
    'ro-copy-lent-writable',
    'ro-copy-module-variable',
    'ro-answer-copied',
    'ro-field-copied',
    'ro-record-copy-written',
    'ro-field-lent-writable',
    'ro-answer-lent-writable',
    'is-some-binder-through-alias',
    'grid-of-slice',
    'grid-of-expression',
    'grid-of-ro-written',
    'adr-typed',
    'index-error-binder-typed',
    'for-nested-same-variable',
    'is-some-expression',
    'case-qualified-label-total',
    'const-expression-overflow',
    'exit-outside-loop',
    'exit-across-finally',
    'opt-over-value',
    'case-scalar-without-else',
    'for-step-not-constant',
    'raise-payload-mismatch',
    'call-select-not-composite',
    'kept-via-record',
    'kept-via-constructor',
    'kept-record-value',
    'module-shadow-by-scope',
    'kept-constructor-arg',
    'nested-procedure',
    'thread-target-elsewhere',
    'pool-root-own',
    'pool-root-value',
    'pool-root-local-no-in',
    'frame-ptr-to-thread',
    'frame-ptr-dispose',
    'frame-ptr-kept-arg',
    'frame-answer-to-modvar',
    'frame-answer-conversion',
    'frame-answer-kept-arg',
    'frame-ptr-shared',
    'no-such-field',
    'opaque-not-defined',
    'opt-through-field',
    'pool-escape-on-return',
    'result-discarded',
    'retention-ledgered',
    'return-mismatch',
    'return-value-in-proper-proc',
    'signature-differs-from-definition',
    'totality-uses-selector-type',
    'unknown-callee',
    'use-after-dispose',
    'use-after-move-assign',
    'use-after-shared',
    'var-arg-not-designator',
    'view-axis-count',
    'view-keeps-nothing',
    'view-of-a-slice',
    'write-through-readonly-field',
    'write-through-readonly-record',
    'case-label-twice',
    'monitor-outside',
    'pure-allocates',
    'pure-writes-var',
    'pure-calls-impure',
    'write-through-readonly-slice',
    'write-through-readonly-str',
    'write-through-value-ptr',
    'wrong-arg-type',
    'export-var-typed',
    'export-var-ro-write',
    'export-var-frame-ptr',
    'nan-compared',
    'nan-declared',
    'record-aggregate-arity',
    'record-aggregate-field-type',
    'record-const-not-literal',
    'record-const-written',
    'record-aggregate-extended',
    'record-const-exported',
    'unknown-procedure-case',
    'slice-of-call-array',
    'pool-root-binder',
    'ro-answer-inferred',
    'exception-field-record',
    'c-conversion-narrows',
    'use-after-move-loop',
    'dispose-not-owned',
    'dispose-through-field',
    'module-body-use-after-move',
    'pool-param-into-module',
    'frame-view-stored',
    'raises-in-condition',
    'use-after-move-paren',
    'handler-arm-fields-differ',
    'for-in-not-a-name',
    'for-in-not-a-sequence',
    'for-in-variable-type',
    'for-in-shared',
    'for-in-ro-written',
    'for-in-borrow-kept',
    'thread-not-sharable',
    'record-attribute-unknown',
    'kept-via-answer',
    'kept-via-var',
    'retention-module-view',
    'frame-view-kept-arg',
    'for-bound-wider',
    'for-bound-literal-out',
    'literal-beyond-i64',
    'handled-only-inside',
    'handled-reraise',
    'own-overflow-checked',
    'own-and-lent',
    'read-before-assigned',
    'type-refers-to-itself',
    'type-alias-cycle',
    'dispose-borrowed-answer',
    'unknown-procedure-near',
    'field-declared-twice',
    'enum-member-twice',
    'file-without-unit',
    'enum-member-unknown',
    'assign-to-procedure',
    'exception-as-type',
    'index-not-indexable',
    'field-of-scalar',
    'len-of-type',
    'array-count-not-positive',
    'handler-qualified-by-variable',
    'type-unknown-bare',
    'type-in-procedure',
    'copy-not-slice',
    'copy-element-mismatch',
    'copy-pointer-elements',
    'copy-into-readonly',
    'utf-subscript',
    'utf-len',
    'utf-from-str',
    'utf-compared',
    'utf-convert-wrong',
    'utf-octets-written',
    'utf-concat-str',
    'utf-from-bytes-raises',
    'utf-for-in-element',
    'utf-const-adapts',
    'utf-pool-first',
    'utf-from-slice-raises',
    'region-inline-field',
    'frame-str-via-var-slice-element',
    'binder-declared-twice',
    'dispose-borrowed-via-call',
    'for-variable-assigned',
    'for-variable-var-arg',
    'monitor-bound-calls-bound',
    'lend-value-ptr-field-as-var',
    'var-arg-not-given',
    'type-ring-long',
    'thread-allocs-shared-pool',
    'monitor-reaches-own-type',
    'dispose-module-variable',
    'own-module-variable',
    'adr-ro-to-mutptr',
    'case-many-members',
    'adr-descriptor-unstated',
    'fresh-in-safe-module',
    'procedure-attribute-unknown',
    'wait-not-bound',
    'monitor-lock-order',
    'thread-pool-field-in-loop',
    'thread-moved-shared-field',
    'thread-alloc-through-value',
    'monitor-wait-while-held'
  ] ;
  Cause = [
    'ADR takes the address of a value, which is the one thing the memory rules cannot check',
    'a record type named like a call with one value: since 2026-10-05 Pair (...) is the record AGGREGATE, every field in order, and one value does not fill a record of two -- there is no conversion to a record',
    'ALL is the axis-keeping marker for VIEW and has no value outside one',
    'the call passes a different number of arguments from the declaration',
    'BYTE is a raw octet, not a number: no +, -, comparison as magnitude',
    "the CASE label's type is not the selector's type",
    'the variant payload of a CASE RECORD is reached only through a CASE arm that binds it',
    'the two sides of a comparison have different types and nothing converts implicitly',
    '+ on strings takes strings on both sides (a CHAR joins as one code point); an integer literal is not one',
    "the binder of IS SOME over a CALL result carries the callee's declared payload type (PTR Point here), and the parameter wants something else",
    'IF/WHILE/ELSIF take a BOOL; an integer is not implicitly a truth value',
    'SHARED (s) consumed s on one arm, so after the join s may be gone (moved in ANY arm = moved after)',
    'the DEFINITION declares a procedure the IMPLEMENTATION never defines',
    'the value came in as a value/VAR/RO parameter -- a borrow -- and a borrow is not yours to free',
    'PTR T IN pool is carved from a pool and the pool frees it as a whole',
    'DIV and MOD are integer operators',
    "LEN (g, k) names an axis the grid's rank does not have (axes are 0-based)",
    'a GRID has one extent per axis, so LEN needs to be told which',
    'GRID 3 OF F64 and GRID 2 OF F64 are different types; rank is in the type, shape in the value',
    'every axis must be subscripted; a GRID is not a nested array',
    'there is no implicit conversion between any two numeric types, widening included',
    'an integer literal fits any integer type but not a float',
    '/ is float division',
    'a procedure value has no zero: a zeroed variable of procedure type would be a call into nothing',
    'a record field of procedure type starts zeroed like every field, and a zero procedure value cannot be called',
    'a procedure fits a procedure type only when its head renders the same text -- modes, types and result, to the letter -- and it raises no more than the type allows',
    'the procedure may raise an exception the procedure type does not declare; a caller of the value handles what the TYPE says, so this one could arrive unhandled.  The probe holds what must stay LEGAL before it: since 2026-10-02 a procedure that raises LESS than the type allows fits it, a quiet one included',
    'a call through a procedure value raises what the TYPE declares, since nothing is known about which procedure runs',
    'a PURE body may call only PURE procedures, and a procedure value names no procedure the checker could look at',
    "THREAD hands its argument to the target's first parameter, and this one is not of that type -- until 2026-09-27 neither checker looked at the argument (only the generator refused a non-pointer shape)",
    'a bare owned pointer handed to a THREAD is MOVED: the thread owns it now, and reading or writing it in the caller is a race the language refuses by construction',
    "an integer literal adapts to the width it is stored into, and this one is outside that width's range -- until 2026-09-27 it compiled and the C conversion wrapped it (I16 := 40000 stored -25536)",
    'IS SOME is the guard for OPT; the operand is not OPT (a cross-module PTR T IN pool may type as unknown and NOT be diagnosed -- check the declaration)',
    'a value PTR parameter is a shared borrow; passing it on as VAR would launder it into a mutable one',
    'a module-level VAR is state, and a module with state must say so',
    'an OWN parameter takes ownership, and a borrow has none to give',
    'a borrowed parameter is passed to a parameter the callee declares KEPT, so the caller is retaining it too',
    "a + result lives in the frame's arena and dies at RETURN, but the callee declares it will keep the argument",
    'a borrowed parameter was copied into a local (or bound by IS SOME or a CASE pattern) and the copy was stored somewhere that outlives the call -- the local carried the borrow',
    "a borrowed parameter is stored somewhere that outlives the call -- module state, the caller's storage, or the answer -- and the signature does not say so",
    'a procedure declares a CONST with the same name as one the module already declares',
    'a bare name used as a value is declared nowhere -- not a local, parameter, IS SOME binder, CONST, type, or module',
    'a RAISE, a RAISES clause or a handler cites an exception name found nowhere -- not declared locally, not predeclared (Overflow/IndexError/OutOfMemory/ValueRange), and not declared in any loaded module',
    'a declaration names a type as Module.Name, the module is imported and loaded, and it declares no type or opaque of that name -- a typo, most often in case (DynStr.Dstring for DynStr.DString), since names are case-sensitive',
    'NAME turns an enumeration member -- or a case-record variant -- into its identifier text; applied to anything else (a number, a record, a slice) it has nothing to name',
    'an ARRAY indexed by an enumeration is indexed BY THE TYPE -- its subscript is a member of that enumeration, and its length is the member count -- so an integer subscript (or a value of some other type) is refused; the compiler proves a[Colour.Red] is in range precisely because a Colour is always one of the members',
    'a FOR loop over an enumeration walks the members of ONE enumeration in declaration order, so its two bounds must name that same type; giving Colour.Red as the low bound and a member of a different enumeration as the high bound has no meaning, since members of unrelated enumerations are not comparable',
    "BY names an integer stride and an enumeration's members are not numbers to step over -- the loop already visits every member from the low bound to the high one, with nothing between them to skip -- so BY on an enumeration bound is refused",
    'an integer-to-enumeration conversion, Colour (i) or Mod.Type (i), can turn an integer that names no member into a value, so it RAISES ValueRange -- and a procedure that converts without declaring or handling that failure is refused, the same as I64 (x) on a value that might not fit',
    "a three-part constructor Mod.Type.Variant (args) names a module, a type in it, and a variant that is not there -- reported as `unknown procedure: Mod.Type.Variant', because a name that is neither a procedure nor a known variant is, to the caller, an unknown callee",
    'the function has a path that reaches its END without a RETURN or a RAISE -- an IF with no ELSE, a WHILE or FOR as its last statement, a LOOP left by EXIT, a CASE arm or a handler that does not answer; the emitted C would hand back the zero the result started as',
    'a POOL is passed where the parameter is some other type (or the other way round); POOL is a type like any other to an argument and its parameter -- until 2026-10-01 it had no canonical form and such a call was accepted',
    "the elements of a constant table CONST X = [ ... ] do not have one type: the table's element type is read off its FIRST element (an integer literal is an I64, a real an F64, a string a STR, a character a CHAR, TRUE and FALSE a BOOL) and nothing adapts, so [1, 2.5] is refused at the 2.5",
    'an element of a constant table is an expression or a name, and a table holds literals (a minus sign in front of a number is one); a CONST over an expression is refused everywhere, and a table is no exception',
    'a constant table is declared inside a procedure; it is data with one copy, and it belongs to the module',
    'a constant table is declared in a DEFINITION; exporting one is not built yet (an importer would need the data, not a #define)',
    'a constant table is named bare where its value would be aliased -- assigned to a slice, cut with SLICE, RETURNed -- and whatever held the alias could write the constant',
    'a constant table is passed to a parameter that is not RO; a slice parameter can be written through, and the table is read-only data',
    'an assignment whose left side is a CONST (or an element of a constant table); until 2026-10-01 the checker passed it and the C compiler refused the generated code',
    'a CONST is passed to a VAR or OWN parameter, which exists to be written through; there is nothing to write',
    'a string literal is passed to a by-value STR (or SLICE) parameter that is not RO; such a parameter can be written through, a literal is read-only data, and until 2026-10-01 this was accepted and a callee that wrote died with SIGSEGV (museum/write-through-literal.m9)',
    'an RO parameter, or something reached through one, is passed on to a parameter that is not RO; the callee could write what this procedure promised its own caller not to',
    'a string CONST, or an element of a constant table, is passed to a by-value slice parameter that is not RO; a constant is read-only data',
    'the same refusal as const-string-to-writable, at the end of a program whose other calls are everything the rule must leave alone: read-only storage to an RO parameter, a variable to a writable one, a one-character literal to a CHAR, a concatenation (frame storage, writable) and a by-value slice parameter lent onward',
    'two strings are compared with = or #, or ordered with < and its kin; a STR is a slice (a pointer and a length), no operator compares two of them, and until 2026-10-02 the checker passed this on to a C compiler that refused it',
    'two arrays, records, slices or grids are compared with an operator; an operator compares scalars -- numbers, characters, booleans, enumeration values, pointers -- and the generated C has no == for a struct',
    'a loop variable is used where another type is wanted -- assigned to an F64, added to one -- and that is an implicit conversion like any other; the refusal is the ordinary one.  Until 2026-10-02 the checker held a loop variable to no type at all inside its loop, so `x := x + i` with x an F64 compiled and ran (museum/implicit-through-loop-variable.m9)',
    'the variable of a FOR loop is not declared; a loop does not declare its variable, and until 2026-10-02 the checker passed this and the generator said `unknown name`',
    'the variable of a FOR loop over integer bounds is declared with a type that is not an integer -- an F64, a STR; a loop counts in an integer',
    'a FOR loop over an enumeration (FOR c := Colour.Red TO Colour.Blue) has a variable of another type; the variable takes each member in turn, so it is that enumeration',
    "a qualified name's module is known to the compiler -- something imported imports it -- and this module does not import it; until 2026-10-02 any module in the import closure could be named, so a program's IMPORT lines did not say what it depended on (museum/named-not-imported.m9)",
    'an element or field is written through a variable declared VAR RO; until 2026-10-03 the RO on a variable was parsed and never read',
    'a VAR RO variable is handed to a SLICE or GRID parameter that is not RO, where the callee could write through it',
    "a component of a local record was itself given storage from a local pool (c.pix := NEW (scratch, BYTE, n)) and is answered or stored where it outlives the frame; until 2026-10-03 only the whole record was refused and the field passed (museum/escape-by-component.m9, Png.Raster's crash)",
    "a CONST, TYPE, VAR, EXCEPTION or PROCEDURE name is declared a second time at the module's level, or a local beside a parameter of its name; until 2026-10-03 the C compiler refused most of these and a PROCEDURE declared twice it never saw -- the generator emitted the second body and dropped the first, and the program ran (museum/declared-twice.m9: Csv.ColF64 had shipped twice for five releases)",
    "a real constant declared in a module's DEFINITION is assigned to an integer in its IMPLEMENTATION; the refusal is the ordinary one, and the probe holds what must stay legal before it -- the constant used as the integer, real or string it is.  Until 2026-10-02 an implementation was given no type for a constant of its own definition, so this compiled and 1.5 became 1 (museum/implicit-through-definition-const.m9)",
    'the same gap for a string constant of the definition: assigned to an I64 in the implementation, it passed the checker until 2026-10-02 and failed in the C compiler',
    "the same refusal; the probe holds what must stay LEGAL before it -- an implementation naming a module only its definition imports, a module naming itself, a local variable that has a module's name",
    'a parameter (or a local) has the name of a module CONST and is used as the parameter it is; the refusal shown is an ordinary type error, and the point is that the checker now reads the name as the PARAMETER -- until 2026-10-01 it read it as the constant, so the type error went unseen and the generated C used the parameter',
    'FROM ... IMPORT names an M9 module; FROM is for foreign FOR-C units only (there is no Module.m9 the generator can honour that way)',
    "a string concatenation (+) is built in the procedure's frame arena and dies when the frame returns; storing it in a module variable, which outlives the frame, leaves the variable pointing at freed storage (par 2.3)",
    "a string concatenation is frame-scoped; a bare VAR/OWN STR parameter is re-homed into the caller's arena at exit, but a COMPONENT reached through a reference parameter (a record field, an element, a value pointer's target) is not, so the caller would hold freed storage (par 2.3)",
    "ByteSize answers the bytes a slice's elements occupy, so its argument must be a slice",
    "NEW's arguments are the wrong way round: the pool comes first, then the type",
    "NEW (T) with no pool allocates from the procedure's frame, which dies when the frame returns; a module variable outlives it and would point at freed storage (par 4.3, docs/pool-elision-plan.md)",
    "a frame allocation stored into a COMPONENT reached through a reference parameter (a field, an element, a pointer's target) is not seen by the exit adoption, which looks at the parameter itself, so the caller would hold freed storage (par 4.3)",
    "a local declared IN a pool claims that pool's lifetime, and rule 2 of the pool elision plan hands that pool to every callee that grows the object -- a frame value held there would have its growth outlive its head (par 4.3)",
    "a frame value stored into a COMPONENT of a local (a record field, a pointer's target) taints the local as a whole, so copying that local into a module variable would hand the module storage that dies with the frame (par 2.3)",
    'a local declared IN a pool has a target that outlives the frame, so a component of it may not hold a frame value (par 4.3)',
    'the IN clause of a declaration is the pool rule 2 hands to every callee that grows the object, so it must be the pool the object was allocated in; a buffer grown in the declared pool while the head lives in another dies at the wrong time (par 4.3)',
    'a view answered by a procedure that takes no pool and answers RO (DynStr.View) lives where its argument does; an argument in a LOCAL pool makes the view die with the frame, neither re-homed nor adopted at exit, so it may not be stored through a reference parameter, in a module variable, or through KEPT -- the zarr proxy read freed memory back as variable ids once a scratch pool had replaced a pool parameter (par 4.3)',
    'an allocation in a LOCAL pool, or a name declared IN one, dies with the frame and is neither re-homed nor adopted at exit, so it may not be stored through a reference parameter, in a module variable, through KEPT, or in a name declared IN a pool that outlives the frame (par 4.3)',
    'the RETURN rule for a name declared IN a local pool, applied by SHAPE: a pool-less name holding an allocation made in a local pool, or a view of one, answers storage that is freed when the frame exits; a STR alone is re-homed at exit (par 4.3)',
    "a call whose callee takes a POOL and answers a pointer-bearing value (a slice, a pointer, a record holding one) answers INTO that pool, as the parameter promises; handed a LOCAL pool, the answer dies with the frame, and here it is returned or stored where the frame's end would be read -- a string answer is exempt, being copied out at exit",
    "a bare name on the left of := is declared nowhere -- not a local, parameter, module variable, or a CONST (writing a CONST is its own refusal); until 2026-10-08 only the generator said so, as `gen: unknown name'",
    "a qualified name Mod.X names a module the checker has loaded and a member it does not declare -- no procedure, type, constant, exception or exported variable X; a module NOT loaded stays soft (that is a missing import, said elsewhere)",
    "the type position of a NEW names a type no module declares -- a bare name declared nowhere, or Mod.T where the loaded module Mod has no T; until 2026-10-08 the checker passed it and the generator refused the C",
    "a handler's payload binder (the names in `| Err (m, c) :') has the type of the EXCEPTION declaration's field it stands for, in order -- since 2026-10-08; until then a binder had no type and `s := c' with s a STR and c an I64 payload compiled",
    "a local or parameter of slice or grid type was given read-only storage by an assignment somewhere in the procedure -- a string literal, a CONST, what an RO parameter or RO variable views, a SLICE of one, or a name so marked -- and is written through; the mark holds for the whole procedure (par 2.4, since 2026-10-08; `t := 'abc' ; t[0] := 'X'` died with SIGSEGV until then, museum/write-through-copy.m9)",
    "a name given read-only storage by an assignment (see ro-copy-written) is handed to a SLICE or GRID parameter that is not RO, where the callee could write through it",
    "a MODULE VARIABLE of slice or grid type was given read-only storage -- a string literal, a CONST, a SLICE of a marked module variable -- by an assignment anywhere in the unit (another procedure, the module body) and is written through here; since 2026-10-08 a prepass over the unit marks it before the bodies are checked (what an RO parameter views marks it for that procedure only)",
    "a local, parameter or module variable was given the answer of a function declared `: RO T' -- read-only storage lent onward -- and is written through; since 2026-10-08 decision 33 follows the call as it follows a literal",
    "a local or parameter was given the value of an RO FIELD (`t := r.s' with `RO s: STR' in the record), which holds a view of storage someone else owns, and is written through; since 2026-10-08 decision 33 follows the field, resolved as a write is",
    "a RECORD (or pointer) copied from read-only storage -- an RO parameter, an RO answer, an RO field -- is written THROUGH: through a slice or a pointer one of its fields holds; since 2026-10-08 the copy carries the mark, and the refusal is for a write that lands beyond the copy (writing a field of the copy itself stays legal)",
    "an RO FIELD of a record -- a view of storage someone else owns -- is lent to a SLICE or GRID parameter that is not RO (since 2026-10-08; the write through it and the copy of it were refused before)",
    "the answer of a function declared `: RO T' is lent to a SLICE or GRID parameter that is not RO (since 2026-10-08)",
    "an IS SOME binder on a call whose result type is another module's alias of an OPT (`Mk () : Lib.Kid') is typed in the module that declared the OPT since 2026-10-08, so what was passed over before is examined: here a pointer assigned to an integer",
    "GRID (s, n0, ..., nR) was given something that is not a SLICE OF T as its storage (par 2.2.1): the grid's element type is the slice's",
    "GRID's storage argument is an expression -- a SLICE (...), a call -- where a designator is needed: the element type is read off the named declaration, by the checker and by the generator (as VIEW does)",
    "a grid laid over read-only storage (an RO parameter, a literal, a CONST, a marked name) is a VIEW of it and carries decision 33's mark: a write through the grid writes the read-only storage",
    "ADR (x) is a C pointer (C.Ptr, since 2026-10-09) and was handed where a foreign procedure wants something else -- a C.Int, a C.SizeT: the wrong argument, or the arguments in the wrong order",
    "a handler of the predeclared IndexError binds (index, length : I64) since 2026-10-09, and a binder was used at another type",
    "a FOR inside a FOR over the SAME control variable: the inner loop assigns the outer count (cp-kernel's Shacl.m9 ran its outer loop once, 2026-10-09)",
    "`x IS SOME` or `x IS NONE` (no binder, a BOOL since 2026-10-09) was asked of a value that is not an OPT -- only an OPT can be absent",
    "a CASE over an enumeration or CASE RECORD has no arm for a member and no ELSE -- the labels may be bare (Fs) or qualified (Store.Fs), and both are counted",
    "an integer CONST expression is folded with the run-time arithmetic, and this one overflows I64 or divides by zero (or a CONST is a form no generator writes: a name, a call, a comparison)",
    "EXIT leaves the innermost LOOP, WHILE or FOR, and this one is in none of them",
    "EXIT would leave its loop from inside a block with a FINALLY that the loop is outside of, skipping the cleanup",
    "OPT holds what can be absent -- a pointer or a procedure value, a C pointer that may be NULL -- and the type named is a value",
    "a CASE over a CHAR or an integer has labels for some values and no ELSE for the others",
    'the FOR names its BY step by a variable (or anything else that is no constant); the grammar takes a ConstExpr there, because the step decides which way the loop runs',
    "a RAISE gives its EXCEPTION a value of another type than the field declares (or, with `expects N argument(s)', another number of values) -- the payload is held to the declaration as a record aggregate's arguments are",
    "a call's answer is selected from -- F (x).f, F (x)[i] -- and its declared type has no such field or subscript (an I64, a pointer to a non-record); or (`a procedure value') the call goes through a variable, which has no declaration to read the answer's type from",
    "a borrowed slice or pointer was put into a FIELD of a local record (c.data := v) and the record stored where it outlives the call -- through a VAR parameter, in module state, or answered; since 2026-10-08 a record value that holds a reference is stored as the reference would be, and a local record carries what its fields were given (Frame.AddF64 kept its callers' buffers without KEPT until then)",
    "a borrowed slice or pointer is an argument of a variant or record CONSTRUCTOR on the right of a store that outlives the call (f.cell := Data.F64s (v, 0.0)); since 2026-10-08 each reference-typed argument of a constructor is stored as the argument itself would be",
    "a RECORD handed by value whose fields hold references (a STR, a slice, a pointer) is stored in module state, through a VAR parameter or into the answer; since 2026-10-08 a record value counts as the references it holds",
    "a borrowed slice or pointer is an argument of a variant or record CONSTRUCTOR handed to a KEPT parameter (Keep (f, Data.F64s (v, 0.0))); since 2026-10-08 the call check reads through the constructor, as it reads a record value's fields",
    "a PROCEDURE is declared inside another procedure's body; the grammar parses it (par 10) and neither checker nor generator supports it -- until 2026-10-08 the first call of it was `unknown procedure'",
    "a THREAD names a procedure of another module as its target; the generator makes the thread's thunk in the module that starts it, so this was a link error naming a C symbol until 2026-10-08",
    "the same refusal where a BINDER of the module's name exists elsewhere in the procedure -- an IS SOME, a CASE arm, a handler -- and the qualified name is outside the statements that binder covers; until 2026-10-08 the shadow test was by subtree and such a name passed as the binder's",
    "a VAR parameter of a pointer-bearing type carries the pool its object lives in, named from the ROOT of the argument (rule 2 of the pool elision plan); an OWN parameter's object is heap storage with no pool to name (par 4.3)",
    'the same hidden pool cannot be named for a component reached through a value parameter: the object is a borrow whose pool nobody stated (par 4.1, 4.3)',
    "a local declared without IN lends the FRAME as its object's pool (rule 2); for a local that holds a POOL allocation the callee's growth would die with the frame while the object lives on in its pool (par 4.3)",
    'a frame allocation dies when this frame returns, and a thread does not wait for that',
    'the frame owns its allocations and frees them as a unit at exit; there is nothing for DISPOSE to free',
    'a KEPT parameter is retained past the call, and a frame allocation dies with the frame that made it (par 4.1)',
    "a function that takes no pool and answers a pointer built in its body (a NEW with no pool, a `+`, a local POOL for a string) answers storage that lives in ITS CALLER's frame (par 4.3, rule 1); a module variable outlives that frame",
    "a function whose RETURN is a UTF builtin -- UTF (x), UTF (b), STR (u) -- or a `+` of UTFs builds its answer in its caller's frame, as a STR function answering `s + t` does (par 2.3, 4.3); DynUtf.View answers `UTF (...)`, so a builder's view is such an answer",
    "a string a function built with `+` is re-homed into its caller's frame and dies with it; a KEPT parameter would retain it past that frame (par 2.3, 4.1)",
    'SHARED needs the rc header only NEW (OWN, T) carries; a frame allocation has none and dies with the frame (par 4.2)',
    'the record has no field of that name',
    'the DEFINITION declares an opaque TYPE the IMPLEMENTATION never completes',
    'an OPT field was read without IS SOME; OPT is traced through fields, not only names',
    'PTR T IN pool cannot outlive its pool, and this pool dies with the frame',
    "a function's result was not used; M9 does not let a value fall on the floor",
    'NOT an error: the P3 ledger noting that a borrowed parameter was stored beyond the frame',
    "the RETURN's type is not the function's declared result type",
    "a proper procedure (no ': T') cannot RETURN a value",
    "the IMPLEMENTATION's procedure heading is not the DEFINITION's, printed canonically (modes, types, RAISES all count)",
    "CASE over a CASE RECORD must name every variant of the selector's own type",
    'no procedure of that name is visible -- MOST OFTEN a real name whose module is not IMPORTed in THIS module (an IMPLEMENTATION has its own IMPORT list), otherwise a guessed name',
    'the name was DISPOSEd on an earlier line and is dead',
    'assigning a bare owned pointer to another name MOVES it; the source is dead',
    'SHARED (s) consumed s; the handle is what lives on',
    'a VAR or OWN argument must be something that can be written to -- a variable, field or element',
    'VIEW takes exactly one argument per axis of the grid: an index (drops it) or ALL (keeps it)',
    'a VIEW with an index on every axis is a single element, not a view',
    'VIEW is a GRID operation; a slice has no strides to keep',
    'the record came in RO, so its fields are read-only too',
    'RO is a read-only borrow',
    'the same scalar label appears in two arms; the second is dead and one of the two is a typo -- decided at compile time',
    'a monitor serialises access by letting only its BOUND procedures reach its fields, and the binding is the FIRST parameter (par 6)',
    "NEW from a pool the CALLER owns consumes the caller's storage and answers a slice into the caller's arena -- an effect (par 3.2)",
    "a PURE procedure has no observable effect (par 3.2), and writing through a caller's VAR binding is precisely what the caller observes",
    "a PURE procedure may call only PURE procedures -- which is what makes 'no I/O' true without the checker knowing what I/O is, since a foreign procedure is [SERIAL] or [REENTRANT] and never [PURE]",
    'the slice came in RO ([READONLY]); its elements cannot be assigned',
    'STR is SLICE OF CHAR and an RO one is read-only like any slice',
    'a value PTR parameter is a SHARED borrow: readable, not writable (par 4.1)',
    "the argument's type is not the parameter's, and nothing converts implicitly",
    "another module's exported variable Mod.v has the type its definition declares, and nothing converts implicitly (decision 28, par 3)",
    'a VAR RO export is read-only storage to every module, its importers included (par 2.4, decision 28)',
    "another module's variable outlives this procedure as the module's own do: a frame value stored there would dangle (par 4.3, decision 28)",
    'a comparison operator has NaN on one side; NaN compares unequal to everything, itself included, so = < <= > >= are never TRUE and # always is -- the test a reader takes for one and the machine does not',
    'a CONST, TYPE, VAR, EXCEPTION, PROCEDURE, parameter or local is named NaN, the predeclared quiet NaN; until 2026-10-05 the library had four private procedures of that name, because there was no constant',
    'a record aggregate Row (...) gives fewer or more values than the record has fields; it is positional and every field must be given (report par 2.2.4, 2026-10-05)',
    'a value of a record aggregate does not have its field type -- often two fields given in the wrong order, which is what a positional aggregate cannot otherwise notice when the types differ',
    'a field of a record CONST is not a literal: a CONST record is read-only data in the program, so its fields are literals (or NaN), as the elements of a constant table are',
    'a field of a record CONST, or the whole of it, is assigned: it is read-only data',
    'a record aggregate names an extended record (RECORD (Base) ...): its base fields would have to come first, which the first cut of the aggregate does not do',
    'a record CONST is declared in a DEFINITION: like a constant table it is not exported yet',
    'a procedure is called by a name that differs from a declared one only in CASE (Writeline for WriteLine); names are case-sensitive, and since 2026-10-05 the refusal names the procedure that was meant',
    'SLICE over an ARRAY that a call answers (or a field of one): an array is a value, held in a temporary that is gone at the end of the statement, and the slice would point into it (par 2.2.1)',
    'a binder bound from a VALUE parameter (IF h.next IS SOME u) is handed to a VAR pointer parameter: the callee may allocate in the binder pool, which is the value parameter pool, and nobody named that one (par 4.3)',
    'the answer of a function that may RETURN a string literal, a CONST or a view of one of its RO parameters is written through, or lent to a writable parameter: read-only storage, though the result type does not say RO (par 2.4)',
    'an EXCEPTION field is a record, a pointer or a case record with a payload: the payload travels in slots for integers, reals and strings, and an enumeration goes as its tag (par 5)',
    'a C.* conversion that narrows -- C.Int of an I64, C.SizeT of a signed integer, C.Float of an F64 -- raises ValueRange like I32 (x), and nothing declares or handles it (par 2.1)',
    'an owned pointer moved inside a loop body (handed to an OWN parameter, DISPOSEd) is used again in the next turn, with no fresh value given before it (par 4.2)',
    'DISPOSE of a local that nothing in the procedure gives an owned pointer -- only a copy of a field, a pool or a frame allocation reaches it -- so freeing it may free what another name still owns (par 4.2)',
    'DISPOSE through a selector: ownership moved into a record field is not followed there, so the checker cannot see a second DISPOSE of the same object (par 4.2)',
    'a module variable moved in the module body (handed to an OWN parameter or a THREAD, DISPOSEd) is used again -- the body tracks ownership as a procedure does (par 4.2)',
    "an allocation in a POOL parameter -- the caller's pool, perhaps a local that dies when the caller returns -- is kept in a module variable (par 4.3)",
    "a VIEW of frame storage -- a SLICE over a concatenation, or the answer of a function that answers a view of its argument (Text.Trim's shape) -- is kept in a module variable, which outlives the frame (par 2.3)",
    'a call that can raise stands in an IF, ELSIF or WHILE condition, a CASE selector or a FOR bound, and nothing declares or handles what it raises -- counted there since 2026-10-11, as everywhere else (par 5)',
    'an owned pointer moved in parentheses -- t := (s) -- is moved as t := s is, and s is used after it (par 4.2); the M9 checker missed the parenthesised form until 2026-10-11',
    'one handler arm names several exceptions and binds a payload, but their fields differ, so a binder would mean a different thing for each (par 5)',
    'FOR x IN goes over what a NAME holds -- a variable, a field, an element, a constant table -- and here it is handed a literal or a call (par 10)',
    'FOR x IN goes over a slice, an array or a string (STR is a slice of CHAR), and this is none of them (par 10)',
    'the loop variable is held to the element type exactly, as an assignment is: no conversion happens in the head of the loop (par 2.1)',
    'a SHARED handle is counted, and the copy FOR x IN would make into x is a share the count never sees (par 4.1)',
    "x holds each element as x := s[i] would, so over read-only storage -- a constant table, an RO parameter -- x holds read-only storage, and the write lands in it (par 2.4)",
    "x holds each element as x := s[i] would, so over a borrowed slice of pointers x carries the borrow, and keeping it is a retention the heading does not declare (par 4.1)",
    'a THREAD is handed a record it does not own -- a pool pointer, a VAR parameter, a module variable -- so both threads hold it, and the record is neither a MONITOR nor marked [SHARABLE] (par 6)',
    'a RECORD takes one attribute, [SHARABLE]; another name is a typo, not an attribute anything reads (par 6)',
    'a callee answers a VIEW of its argument (the splitter shape, parts[n] := SLICE (s, a, b) ; RETURN parts) and the caller stores that answer where it outlives the frame; since 2026-10-18 the answer CARRIES the borrow, so the retention is the caller to declare and the callee says no KEPT (par 4.1)',
    "a callee fills a VAR parameter's own storage with a view of another argument (res := SLICE (out, 0, n) in Pick (pool, items, res)) and the caller handed it a module variable; since 2026-10-18 the argument CARRIES the borrow -- a hand-back, not a retention of the callee's -- and storing it durably is the caller's retention (par 4.1)",
    'a VIEW of a retaining local -- SLICE (out, 0, n) over a slice holding the borrowed elements -- is stored in module state; until 2026-10-18 the view escaped unrooted, because the root finder looked for a call named SLICE and the parser makes a node of its own (par 4.1)',
    "a VIEW of frame storage -- a SLICE of a concatenation, or a callee's answer that views one -- is handed to a KEPT parameter, which keeps it past the frame it dies with; followed here too since 2026-10-18, not only where the view is stored (par 4.1)",
    'a FOR bound is of a wider type than the loop variable -- an I64 for an I32; the variable takes the bounds and the loop compares in its type, so until 2026-10-21 C truncated the bound (an I64 3e9 gave 2 passes at -O2, 1001 at -O1)',
    'a FOR bound is a literal the loop variable cannot hold -- 300 for an I8, -1 for a U8; until 2026-10-21 C truncated it (300 became 44)',
    'a decimal literal past MAX (I64) is a U64 literal, and is given to an I64 (or compared with one); until 2026-10-21 it reached C as INT64_C of a value past 2^63 and printed its wrapped self',
    'a call raising an exception comes AFTER the block whose handler names it; a block catches only for its own guarded sequence, and until 2026-10-21 the checker counted a handler anywhere in the procedure as catching everywhere (par 5)',
    "a handler's own body raises the exception it handles, or another; the body is outside the block it handles for, and until 2026-10-21 the flat handled set counted the re-raise as caught (par 5)",
    'the module declares an EXCEPTION named like a predeclared one -- Overflow, IndexError, OutOfMemory -- and raises it undeclared; until 2026-10-21 the exemption of the predeclared three was by bare name and covered it (par 5)',
    'one call hands the same object to an OWN parameter, which may DISPOSE it, and as another argument the callee reads; until 2026-10-21 it compiled and was a use after free (par 4.2)',
    'a local of a pointer type that is not OPT is read on a path where nothing gave it a value -- an IF without the assignment in every arm, a loop that may not run, a handler reached before the assignment, a flag the checker cannot follow; until 2026-10-21 it was NULL and the read a SIGSEGV (par 4)',
    'a record, array, slice, grid or procedure type holds itself -- by value, as an element, as a parameter -- with no pointer to a record between: it would have no size, and until 2026-10-21 it reached cc as an incomplete type (par 2.2)',
    'a type is a pointer to itself, or two names are each other: there is no record for the recursion to stop at, and until 2026-10-21 --check followed the names until it ran out of stack or for ever (par 2.2)',
    "the name was given the answer of a call whose callee answers a pointer it was lent -- a parameter that is not OWN, or part of one -- so the answer is a borrow of the caller's own object; until 2026-10-21 a call's answer counted as owned and this freed it twice, or freed pool storage (par 4.2)",
    'the name is one or two edits from a procedure the module declares -- a typo; the checker names the nearest, case aside, the first so near in declaration order',
    'a record, monitor or variant arm declares one field name twice; until 2026-10-22 the checker passed it and the C compiler refused the duplicate member (par 2.2)',
    "an enumeration lists one member twice; until 2026-10-22 it compiled, and the second was the first (par 2.2)",
    'the file has no MODULE, DEFINITION MODULE or IMPLEMENTATION MODULE -- it is empty, or holds only comments; until 2026-10-22 it was checked clean and failed at the link (par 3)',
    'the name after the type is none of its members -- a typo, or a member of another enumeration; until 2026-10-22 the checker passed it and the C compiler refused an undeclared identifier (par 3 rule 7)',
    "the target of := names a procedure; a procedure is a declaration, not storage -- until 2026-10-22 a bare one was refused as an unknown name and a qualified one reached the C compiler (par 3 rule 7)",
    'an EXCEPTION names something raised and handled, and has no values; until 2026-10-22 a variable, field or result of one compiled to C that declared it of the exception descriptor (par 5)',
    "a subscript applied to a value that has no elements -- a record, a monitor, an enumeration or a scalar; until 2026-10-22 the checker passed it and the generator refused it as `index into a non-array unsupported yet' (par 2.2.1)",
    "a field selected from a value that has no fields -- a scalar, a slice, a string, an array or an enumeration; until 2026-10-22 the checker passed it and the generator refused it as `selection through a non-record unsupported yet' (par 2.2)",
    'LEN measures a value: an array, a slice, a grid or a string; it was handed a type name or a scalar, which until 2026-10-22 passed the checker and reached the generator as an unknown name (par 2.2.1)',
    "an ARRAY's count folds to a constant below 1; until 2026-10-22 the generator refused it as `array count form unsupported yet' (par 2.2.1)",
    'a handler names an exception qualified by a variable; only the module that declares an exception qualifies it, and a name in scope is never a module (par 3 rule 5); until 2026-10-22 the checker said only that the exception was unhandled',
    'a bare type name that no module the checker loaded declares: a typo, or a type of another module written without its module; until 2026-10-22 it was left soft and the generator refused it (par 3 rule 7)',
    "a TYPE among a procedure's declarations: the grammar allows it and nothing implements it; until 2026-10-22 the generator refused its first use as an unsupported selector (par 3 rule 7)",
    'COPY copies between slices and arrays; it was given a scalar or a record (par 2.2.y)',
    'COPY copies one element type into the same: the two arguments differ (par 2.2.y)',
    'COPY copies elements of a scalar type; a pointer element is a store the ownership rules follow one by one (par 2.2.y, par 4)',
    'COPY writes into its first argument, and that is read-only storage -- an RO parameter, a literal, a CONST (par 2.4)',
    'a UTF is subscripted; UTF-8 has no O(1) i-th character, so a subscript would either be a byte (a trap for every character past ASCII) or a scan hidden in brackets, and M9 has neither',
    "LEN is asked of a UTF; a UTF's length has two meanings, its bytes and its characters, at two costs, and LEN would hide which",
    'a STR is assigned to a UTF (or passed, or answered); STR is SLICE OF CHAR, a different type, and nothing converts silently -- only a string LITERAL adapts to a UTF',
    'two UTF values are compared with = or #, or ordered with < and its kin; a UTF is a slice, as a STR is, and no operator compares two of them',
    'UTF (x) was given what is neither a STR nor a SLICE OF BYTE; a UTF is text, and only a sequence of characters or of octets becomes one',
    'the octets of a UTF, OCTETS (u), are lent to a parameter that may write them, or written through a name holding them; a UTF holds valid UTF-8, and its octets are read-only so that it stays so (par 2.4)',
    'a STR is concatenated with a UTF; the two are different types and nothing converts silently -- only a literal adapts',
    'UTF (b) validates octets and raises ValueRange when they are not UTF-8, and the procedure neither declares nor handles it',
    'FOR IN over a UTF decodes it, so the loop variable is a CHAR, one code point a pass; it was declared as something else',
    'a STR is assigned to a UTF (or passed, or answered); a string literal adapts to a UTF, and so does a CONST naming one (decision 66) -- a STR variable does not, nothing converts silently',
    'the two-argument UTF places its answer in a pool, as NEW (pool, T) does, and its first argument is not a POOL',
    'UTF of a SLICE of octets -- of a byte slice or of an ARRAY OF BYTE -- validates them as UTF (b) does, and the procedure neither declares nor handles ValueRange (the M9 checker read a SLICE argument as unknown until 2026-10-25)',
    'a borrowed parameter reaches module state through a record that carries it -- here a field of a field of a local record, stored whole in a module variable; storing the borrow into the local alone, at any depth through records held by value, is legal',
    "a string built in this frame -- a concatenation, a builder's view, a UTF conversion -- stored into a field of an element of a VAR slice: the slice's storage is the caller's, nothing adopts an element, and the frame is freed when the procedure returns",
    'a name given twice in one binder list -- a CASE arm over a variant, or a handler -- where each binder is a variable of the arm; the second would hide the first, and the C compiler refused the redefinition',
    "the answer of a call whose callee answers what a further callee answers of its argument -- RETURN Id (a) -- is that argument, a borrow; disposing it frees what the caller's owner still names",
    "an assignment to the control variable of an enclosing FOR, inside that loop: the loop alone writes it, and what the loop then does depended on the generator's exit test -- 0.24 ended it, 0.25 ran on",
    'the control variable of an enclosing FOR handed to a VAR or OWN parameter inside the loop: the callee may write it, which is the assignment the rule refuses',
    'a call, from a procedure bound to a monitor, of another procedure bound to the same monitor: the caller holds the monitor lock for its whole body and the lock is not recursive, so the callee waits on it for ever',
    'what a value pointer parameter points to -- a field or element through it -- handed to a VAR parameter: the same write as the assignment through it, which a shared borrow forbids; and no pool comes with a value pointer, so a new string the callee gives it would be re-homed into this frame',
    'a PTR local handed to a VAR parameter of a callee that never gives the parameter a value, then read: the call left it NULL, and nothing after it is tested',
    'a ring of type names too long for the walk that looks for one: a cycle of more than a hundred names was taken for none, and the generator crashed on it',
    'a THREAD target that allocates through its parameter -- a NEW on it, a callee growing a builder in it -- while the record it was handed is shared: both threads carve the one pool at once, and the pool takes no lock',
    'a procedure bound to a monitor calls something that may enter a monitor of the same type: on the same monitor the lock is never given, on another of its type two threads can take the two in opposite orders',
    'a procedure DISPOSEs a module variable: the module owns it, and nothing in the procedure shows that no other name still holds what it points to',
    'a procedure moves a module variable into an OWN parameter, which may free it, while the module body reads it after the call',
    'ADR of read-only storage or of a UTF handed to a C parameter that writes (C.MutPtr): a literal written by C, or octets that stop being UTF-8',
    'a CASE over an enumeration or a case record that leaves a member out (this probe holds that twenty members named are accepted, which a sixteen-label limit refused)',
    'ADR of a variable whose type holds a reference -- a record with a UTF, a slice or a pointer -- in a procedure that does not state where its answer lives: C can write a reference no assignment shows',
    '[FRESH] on a procedure of a safe module: the statement is for an UNSAFE body whose C the checker cannot read, and beside a body it reads it could only disagree',
    'a procedure attribute that is neither [PURE] nor [FRESH]: it was ignored, and what the author meant by it was never checked',
    'WAIT or SIGNAL on a monitor the procedure is not bound to: WAIT releases the lock its procedure holds, and on another monitor there is none to release',
    'two monitor types taken in opposite orders: a procedure bound to one may enter the other, and a procedure bound to the other may enter the first, so two threads can each hold one lock and wait for the other',
    'one record handed to several threads in a loop, and the target allocates in its POOL field: the field is shared, not the worker own, and the pool takes no lock',
    'a value moved into a THREAD holds a SHARED handle to a record that is neither a MONITOR nor [SHARABLE]: the starting thread may still hold the other handle and write the same record',
    'a THREAD target calls a procedure value and hands it the shared record or a part of it: what the value does there is unseen, and it may allocate in the record pool both threads use',
    'a procedure bound to a monitor calls one that WAITs on another monitor: the wait releases only that one, and the thread that would SIGNAL it may first need the lock still held'
  ] ;
  Fix = [
    'put the procedure in an UNSAFE module, or pass a SLICE/VAR instead of an address (par 7)',
    'give every field (Pair (x, y)); conversions are for numeric widths and CHAR',
    'use ALL only as a VIEW argument; a whole-axis loop is FOR i := 0 TO LEN (g, k) - 1',
    'read the signature in docs/modules/<M>.md; every parameter is positional and required',
    'convert with U8 (b) or I64 (b) first, and back with BYTE (x), each of which RAISES ValueRange',
    "labels must be literals or CONSTs of the selector's type; a CHAR selector takes 'x' or 41C",
    'write CASE v OF | Kind.Str (s) : ... END; never v.field on the variant part',
    'convert one side explicitly; for strings use DynStr.Eq / Text.Eq, not = (par 2.1)',
    'format first: Fmt.I64Str (n) or DynStr.AppendI64',
    'pass what the parameter asks for: read p.x for a record parameter, or declare the parameter as the pointer',
    'write the comparison out: IF n # 0 THEN',
    'share on every path, or share before the branch; see par 4.2',
    'implement it, or remove it from the definition; the signature is the contract (par 3)',
    'only OWN parameters and locals holding owned PTRs may be DISPOSEd; move ownership with OWN',
    'never DISPOSE a pool-interior pointer; free the pool (par 4.3, docs/pools.md)',
    'use / for floats; Math.Fmod for a float remainder',
    'a GRID 2 has axes 0 and 1',
    'LEN (g, 0); LEN (s) without an axis is for slices',
    'declare the matching rank, or take a VIEW that drops an axis',
    'g[i, j, k] for a GRID 3; VIEW (g, i, ALL, ALL) to select a plane',
    'I64 (x) explicitly; the conversion RAISES ValueRange, which your RAISES set must carry (par 2.1)',
    'write 0.0, 1.0E-6; a <real> literal adapts to F32 or F64',
    'DIV for integers',
    'declare it OPT Less and take the value through IS SOME; a PARAMETER of procedure type needs no OPT (par 2.2.3)',
    'declare the field OPT and read it through IS SOME (par 2.2.3)',
    'assign a procedure with exactly the declared parameters and result, or change the type (par 2.2.3)',
    "handle the extra exception inside the procedure, or declare it in the type's RAISES (par 2.2.3)",
    "handle it, or add the exception to the caller's own RAISES (par 2.2.3, par 5)",
    'take the value out of the PURE procedure, or make the computation a named PURE procedure (par 3.2)',
    'pass what the target declares: a PTR T or SHARED PTR T for a `VAR r: T` or `p: PTR T` parameter, or a monitor by name (par 6)',
    'hand the thread a record it may share -- a MONITOR, or a pool value both sides may read -- or do not touch the owned value again after the THREAD (par 6, par 4.2)',
    'use a wider type, or the value you meant; a computed value that may not fit converts explicitly with I16 (x) RAISES ValueRange (par 2.1)',
    'declare the type OPT PTR T, or drop the guard if it cannot be absent',
    'take the parameter as VAR yourself if you need to pass it as VAR (par 4.1)',
    'add [STATEFUL] to the DEFINITION MODULE, or move the state into a record the caller owns (par 6)',
    'pass something you own -- a local, an OWN parameter -- or take the argument as VAR instead',
    "declare the caller's own parameter KEPT as well -- the declaration composes upward, exactly as RAISES does (par 4.1, docs/retention.md)",
    'build the string in a pool that outlives the retention (DynStr into a caller-supplied pool, or HEAP) and pass that (par 2.3, par 4.1)',
    'the retention is real even though indirect: declare the parameter KEPT, or copy the bytes instead of the reference (par 4.1, docs/retention.md)',
    'declare the parameter KEPT so every caller can see the retention, or copy the bytes instead of keeping the borrow (par 4.1, docs/retention.md)',
    'rename one of them.  Which would win depends on lookup order, and the map answers the first hit, so the shadow is refused rather than resolved (docs/frame-pools.md)',
    'declare it, import the module it comes from, or fix the typo; the checker now names it rather than leaving it to the generator (par: the checker refuses what the generator cannot see)',
    'declare the EXCEPTION, or qualify it into the module that owns it (Json.ParseError); an imported exception is reached as Module.Name, never bare -- the checker now refuses what the generator could not emit',
    "spell it as the module declares it (m9c --json Module lists every name); an unknown type is otherwise SOFT and never diagnosed, because a bare name found nowhere may only be a missing IMPORT -- but a known module lacking the name is not softness, and until 2026-09-15 this rode through --check to surface as cc's `unknown type name Module_Name', the M9 line gone",
    "pass an enumeration or case-record value; NAME (Colour.Red) is 'Red', and it reads the identifier from a table the generator emits per type, so it retires a hand-written code-to-name CASE",
    'write the member: a[Colour.Red], not a[0]; that is what makes the array bounds-checked at compile time, with no runtime check and no ordinal to keep in step with the type',
    'make both bounds members of the one type -- FOR c := Colour.Red TO Colour.Blue; a loop that must cross two enumerations is two loops, or a conversion through ORD if the ordinals really are meant to line up',
    'drop the BY: FOR c := Colour.Red TO Colour.Blue visits Red, Green, Blue in order; if you need to skip members, guard the body with an IF or CASE rather than striding the loop',
    'add RAISES ValueRange to the signature, or handle it with EXCEPT; the conversion is the checked inverse of ORD, and the exhaustive RAISES accounting reaches it like every other narrowing',
    "spell the variant as the type declares it (m9c --json Mod lists them); the three-part form is how an imported variant with a payload is built from another module, Mod.Type.Variant, and it looks nowhere but Mod -- before 2026-09-15 it was refused outright as `unknown procedure: Mod' because the callee was split at its first dot",
    'answer on every path: add the ELSE, or a RETURN after the loop; a call does not count as an ending whatever the callee does, so write RAISE X (...) rather than a helper that always raises (par 3 rule 4)',
    'pass what the parameter declares; a pool goes to a VAR pool: POOL parameter and nowhere else (par 4.3)',
    "write every element in the first one's type -- [1.0, 2.5] for reals; the refusal names the element by number (par 2.2.4)",
    'write the value out; if the element must be computed, the table is not a constant -- make it a module variable filled in the module body (par 2.2.4)',
    'move the CONST to module level, above the procedure (par 2.2.4)',
    'declare it in the IMPLEMENTATION and export a procedure that indexes it (par 2.2.4)',
    'index it (X[i]), measure it (LEN (X)), or lend it whole to an RO parameter; those three are everything a table does (par 2.2.4)',
    'declare the parameter RO if the callee only reads; if it writes, it needs a variable, not a constant (par 2.2.4)',
    'a constant has one value; use a variable for what changes',
    'pass a variable holding the value, or make the parameter by-value or RO if the callee only reads',
    'declare the parameter RO if the procedure only reads it -- every STR parameter that is not written should say so; if it does write, pass a variable (par 2.4)',
    "declare the callee's parameter RO if it only reads; otherwise this procedure is a mutator too, and its own parameter is not RO (par 2.4)",
    'declare the parameter RO, or copy the constant into a variable first (par 2.4)',
    "nothing to change in those forms; the probe holds the rule's edge, so that a later change that refuses one of them shows as a second diagnostic here",
    "Text.Eq (a, b) for equality (IF Text.Eq (name, 'cancel') THEN ...); a CHAR against a one-character literal is still =; there is no ordering operator for strings -- Sort.Strs sorts, and a comparison of two strings is written out or taken from a library (par 2.3)",
    "compare what is inside: the fields by name, the elements in a loop; for arrays of reals the question is usually 'near', not 'equal' (Check.NearF64s in a test) (par 2.3)",
    'write the conversion: x := x + F64 (i).  NOT SOURCE COMPATIBLE for a program that leaned on the gap; none was found in this repository or the FLEXPART port',
    "declare it in the procedure's VAR section: VAR i : I64 ;",
    'declare the loop variable I64 (or another integer width), and convert inside the body where a real is wanted: F64 (i)',
    'declare it of the enumeration: VAR c : Colour ;',
    "add the line: IMPORT Lib ;  An implementation may lean on its definition's IMPORT and the other way round.  NOT SOURCE COMPATIBLE for a program that leaned on the gap: 5 sites in 386 files (par 3)",
    'give the variable a new view instead (view := s), or drop RO from its declaration if it is meant to write (par 2.4)',
    'make the parameter RO, or hand over a writable copy (par 2.4)',
    "allocate the component in the caller's pool, or build the answer in the frame (NEW (BYTE, n)) so that it is re-homed; a value READ out of a slice that merely lives in a local pool is not this case and stays legal (par 4.3)",
    'delete or rename the second declaration; the message names the line of the first.  A forward heading -- a heading without a body, its body later -- is legal and stays so (par 3)',
    'write the conversion the assignment means: n := I64 (Math.Round (K)), or declare the variable F64.  NOT SOURCE COMPATIBLE for a program that leaned on the gap; none was found in 430 files here and in four applications',
    'assign it to a STR; a number written in a string is read with a parser, not by assignment',
    'IMPORT the module the last procedure names',
    'nothing to change in a correct program; give the parameter another name if the shadowing confuses the reader',
    'use IMPORT Module and write Module.Name; a Modula-2 unqualified FROM of an M9 module is caught here, at the import, instead of as a generator error later',
    'copy it into a durable pool -- DynStr.Append (HEAP, ...), or a pool the caller owns; the module init body is exempt, because there frame and module variable share a lifetime',
