{
  "name": "m9-lang",
  "displayName": "M9 Language",
  "description": "Syntax highlighting, hover documentation, completion and m9c's diagnostics for M9 and its .m9f notation (grammar kept in sync with host/fpc/M9Lex.pas; docstrings come from `m9c --doc` and diagnostics from `m9c --check`, never from a second scanner)",
  "version": "0.3.0",
  "publisher": "atverm",
  "icon": "images/m9-icon.png",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "m9",
        "aliases": [
          "M9",
          "m9"
        ],
        "extensions": [
          ".m9"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/m9.svg",
          "dark": "./images/m9.svg"
        }
      },
      {
        "id": "m9f",
        "aliases": [
          "M9f",
          "m9f"
        ],
        "extensions": [
          ".m9f"
        ],
        "configuration": "./language-configuration-m9f.json",
        "icon": {
          "light": "./images/m9.svg",
          "dark": "./images/m9.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "m9",
        "scopeName": "source.m9",
        "path": "./syntaxes/m9.tmLanguage.json"
      },
      {
        "language": "m9f",
        "scopeName": "source.m9f",
        "path": "./syntaxes/m9f.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "M9",
      "properties": {
        "m9.compilerPath": {
          "type": "string",
          "default": "",
          "description": "m9c binary for --doc; empty resolves <workspace>/runtime/test/m9c, then <workspace>/out/m9c, then m9c on PATH"
        },
        "m9.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "-I directories for m9c --doc.  Add a build directory holding Kind.m9 (e.g. ~/m9build) to document a port's modules, whose Kind is selected at build time"
        },
        "m9.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "$M9LIBRARY for m9c --doc; <workspace>/corpus is always appended"
        },
        "m9.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run m9c --check on a .m9 or .m9f file when it is opened or saved, and show what it says"
        }
      }
    },
    "commands": [
      {
        "command": "m9.showOther",
        "title": "M9: Show in the Other Notation",
        "enablement": "editorLangId == m9f || editorLangId == m9"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "m9.showOther",
          "when": "editorLangId == m9f || editorLangId == m9"
        }
      ]
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:m9",
    "onLanguage:m9f"
  ]
}
